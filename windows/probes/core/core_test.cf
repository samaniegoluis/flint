package main

import "core:os"
import "core:net"
import "core:fs"
import "core:str"

fn helper() -> str {
    return os.getenv("ARGV_ECHO", "argv_echo.exe")
}

test "net: TCP listen, connect, write and read back on loopback" {
    mut ln := try net.listen_tcp_addr("127.0.0.1", 0)
    port := ln.port()
    assert(port > 0)
    mut c := try net.connect_tcp("127.0.0.1", port)
    mut s := try ln.accept()
    try c.write_text("ping\n")
    line := s.read_line() or ""
    assert_eq(line, "ping")
    try s.write_text("pong\n")
    back := c.read_line() or ""
    assert_eq(back, "pong")
    c.close()
    s.close()
}

test "net: socketpair is full duplex (CF-010.g)" {
    (mut a, mut b) := try net.socketpair()
    try a.write_text("a->b\n")
    assert_eq(b.read_line() or "", "a->b")
    try b.write_text("b->a\n")
    assert_eq(a.read_line() or "", "b->a")
    a.close()
    b.close()
}

test "os.command: arguments with spaces and quotes arrive intact (CF-010.d)" {
    args := ["plain", "two words", "say \"hi\"", "trailing\\", "a&b|c", ""]
    r := try os.command(helper(), args)
    want := "[plain]\n[two words]\n[say \"hi\"]\n[trailing\\]\n[a&b|c]\n[]\n"
    assert_eq(str.replace(r.stdout, "\r\n", "\n"), want)
}

test "os.args: a UTF-8 argument arrives as UTF-8, not in the ANSI code page (W-11)" {
    r := try os.command(helper(), ["año-ñ ✓.txt"])
    assert_eq(str.replace(r.stdout, "\r\n", "\n"), "[año-ñ ✓.txt]\n")
}

test "os.command: a child writing 300 KB to stdout and stderr does not deadlock (CF-010.e)" {
    r := try os.command(helper(), ["big"])
    // 3000 lines of 99 x's + newline. Windows' CRT writes "\r\n" (docs/cfire-windows.md, W-05).
    assert_eq(str.replace(r.stdout, "\r\n", "\n").len(), 300000)
    assert_eq(str.replace(r.stderr, "\r\n", "\n").len(), 300000)
}

test "os.exec_output runs a shell command" {
    output := try os.exec_output("echo hello")
    assert_eq(str.trim(output), "hello")
}

test "os.pipe: write then read" {
    (mut r, mut w) := try os.pipe()
    try w.write_text("through the pipe\n")
    w.close()
    assert_eq(r.read_line() or "", "through the pipe")
    r.close()
}

test "os: env, cwd, pid" {
    os.setenv("FLINT_PROBE", "ñandú ✓")
    assert_eq(os.getenv("FLINT_PROBE"), "ñandú ✓")
    here: str = os.cwd()
    assert(here.len() > 0)
    assert(os.getpid() > 0)
}

test "fs: a UTF-8 path round-trips (CF-010.a)" {
    dir := "probe-ñ-✓"
    try fs.mkdir_all(dir)
    p := "{dir}/archivo-ü.txt"
    try fs.write_text(p, "contenido ✓")
    assert_eq(try fs.read_text(p), "contenido ✓")
    try fs.remove(dir)
}
