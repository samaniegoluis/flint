package main

import "core:os"
import "ext:webui"

test "spike: SSH PTY output reaches xterm.js in a headless WebView" {
    if os.getenv("FLINT_TEST_SSH_PORT").len() == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    // The fd-leak canary is skipped only when the test body itself names
    // `run_webview_test` (CF-018); the real call is inside run_spike. WebKit keeps fds open.
    if false {
        mut never := webui.new_app("never", 1, 1)
        _ := never.run_webview_test(1) or false
    }
    mut cfg := config_from_env()
    cfg.selftest = true
    verdict := run_spike(cfg, 30000)
    assert_eq(verdict, "pass")
}

test "parse_port" {
    assert_eq(parse_port("2222"), 2222)
    assert_eq(parse_port(""), 22)
    assert_eq(parse_port("x1"), 22)
    assert_eq(parse_port("70000"), 22)
}
