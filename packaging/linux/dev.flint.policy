<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Flint's presence check for the caller approval window (milestone 12). Install to
     /usr/share/polkit-1/actions/. auth_self: the person logged in proves they are at
     the machine (password or fingerprint); no admin rights are involved. -->
<policyconfig>
  <vendor>Flint</vendor>
  <action id="dev.flint.approve">
    <description>Allow a program to use your Flint vault</description>
    <message>Flint needs you to confirm it is you before a program may use your vault</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
