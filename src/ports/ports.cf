package ports

// Ports: what the core needs from the outside world. Adapters implement them;
// the domain and application layers depend only on these interfaces.
//
// cfire interfaces lower to C++20 concepts (static dispatch), so use cases take
// their dependencies as generic parameters constrained by these interfaces.
//
// Method names are prefixed by their port (`vault_`, `keychain_`, ...), so an
// adapter that serves several ports reads unambiguously.

import "../domain"

// Key derivation and authenticated encryption (adapters/crypto, libsodium).
type Crypto interface {
    random_bytes(n: usize) -> []byte
    derive_key(password: str, salt: []byte, ops: u64, mem_bytes: usize) -> []byte!
    derive_subkey(master: []byte, id: u64, kdf_context: str) -> []byte!
    seal(key: []byte, plaintext: []byte, aad: []byte) -> []byte!
    unseal(key: []byte, sealed: []byte, aad: []byte) -> []byte!
    digest(data: []byte, out_len: usize) -> []byte!
    // Compares two byte strings in constant time (false when the lengths differ).
    equal(a: []byte, b: []byte) -> bool
    // Overwrite with zeros, in place, a buffer or a text that held key material or a
    // secret, once it has been used (milestone 36, D-085). The caller's value IS
    // changed although the parameter reads as a borrow: an interface method cannot
    // declare `mut` (CF-124). Best effort: copies cfire made on the way stay.
    wipe(buf: []byte)
    wipe_text(text: str)
}

// The encrypted vault file (adapters/vault, SQLCipher). One vault is open at a time.
// Rows go in and out as domain types; secret fields are already sealed.
type VaultStore interface {
    vault_file_exists(path: str) -> bool
    vault_read_salt(path: str) -> []byte!
    vault_create(path: str, page_key: []byte, salt: []byte) -> void!
    vault_attach(path: str, page_key: []byte, salt: []byte) -> void!
    vault_detach()
    vault_format() -> i64!
    vault_get_meta(key: str) -> str!
    vault_set_meta(key: str, value: str) -> void!
    vault_begin() -> void!
    vault_commit() -> void!
    vault_rollback()
    groups_all() -> []Group!
    group_put(g: Group) -> void!
    group_drop(id: str) -> void!
    hosts_all() -> []Host!
    host_put(h: Host) -> void!
    host_drop(id: str) -> void!
    keys_all() -> []SshKey!
    key_put(k: SshKey) -> void!
    key_drop(id: str) -> void!
    creds_all() -> []Credential!
    cred_put(c: Credential) -> void!
    cred_drop(id: str) -> void!
    known_hosts_all() -> []KnownHost!
    known_host_put(k: KnownHost) -> void!
    known_host_drop(addr: str) -> void!
    // Milestone 39 (D-094): opens this machine's activity file for the open vault,
    // named by its id and encrypted with `key` (VAULT_SUBKEY_ACTIVITY); a new file
    // takes `new_salt`. Moves in, once, the log an older vault still holds.
    // `vault_detach` closes it with the vault.
    activity_attach(vault_id: str, key: []byte, new_salt: []byte) -> void!
}

// Tokens, in the open vault (adapters/vault, migration 004, milestone 12b), and the
// activity log, in this machine's activity file (milestone 39, D-094). Served by the
// same store as `VaultStore`. Tokens are revoked, never deleted. `activity_add` drops
// the oldest entries beyond `keep`; `activity_page` returns the newest entries with an
// id below `before_id` (0: from the newest). The retention is this machine's.
type TokenStore interface {
    tokens_all() -> []Token!
    token_put(t: Token) -> void!
    // Appends `e` and prunes to `keep` in one savepoint.
    activity_add(e: ActivityEntry, keep: ActivityKeep) -> void!
    activity_page(before_id: i64, limit: i64) -> []ActivityEntry!
    // Prunes to `keep`; the number of entries removed (milestone 15).
    activity_prune(keep: ActivityKeep) -> i64!
    // How many entries are older than `since_at` (Unix seconds).
    activity_count_before(since_at: i64) -> i64!
    // The retention in days (0: no limit; -1: never set).
    activity_retention() -> i64!
    set_activity_retention(days: i64) -> void!
    // Copies the activity file, still encrypted, to `dest` (replaced if there).
    activity_backup(dest: str) -> void!
}

// Tunnels saved in hosts, in the open vault (adapters/vault, migration 007, milestone
// 22). Served by the same store as `VaultStore`; removing a host removes its tunnels.
type TunnelStore interface {
    tunnels_all() -> []Tunnel!
    tunnel_put(t: Tunnel) -> void!
    tunnel_drop(id: str) -> void!
}

// The OS keychain (adapters/keychain). Holds one master key per vault, by account.
// `keychain_load` returns an empty slice when there is no entry.
type Keychain interface {
    keychain_save(account: str, secret: []byte) -> void!
    keychain_load(account: str) -> []byte!
    keychain_forget(account: str) -> void!
}

// The local list of recent vaults (adapters/config), most recent first.
type RecentStore interface {
    recents_load() -> []RecentVault!
    recents_save(list: []RecentVault) -> void!
}

// The desktop app's per-machine settings (adapters/config). `settings_load`
// returns the defaults when nothing has been saved yet.
type SettingsStore interface {
    settings_load() -> Settings!
    settings_save(s: Settings) -> void!
}

// The monospaced font families installed on this machine (adapters/fonts).
type FontCatalog interface {
    mono_font_families() -> []str!
}

// Parses a private key to validate it and read its public half (adapters/ssh).
type KeyInspector interface {
    inspect_private_key(private_key: str, passphrase: str) -> KeyInfo!
}

// An interactive remote shell (adapters/ssh, libssh).
type ShellSession interface {
    write(data: str) -> void!
    read(timeout_ms: i32) -> str!
    resize(cols: i32, rows: i32) -> void!
}

// Out-of-band delivery of terminal bytes to a driver (webui events, stdio).
type EventSink interface {
    terminal_output(session_id: str, data: str)
    terminal_closed(session_id: str, reason: str)
}

// An SSH connection chain (adapters/ssh, libssh). `link_dial` opens the first hop
// directly and every later hop through a tunnel over the previous one; the other
// calls act on the last hop. Each blocking call is bounded by the dial timeout
// (Principle 8). Errors carry `network`, `auth` or `host_key` codes.
// `host_key_algos` ("" for the library defaults) is the domain's
// `preferred_host_key_algos` for the hop being dialled.
// One channel at a time: a shell (PTY) or an exec. `link_shell_open` with a
// `command` runs that command on the PTY instead of the login shell ("" for none).
type SshTransport interface {
    link_dial(hostname: str, port: i64, user: str, timeout_secs: i64, host_key_algos: str) -> void!
    link_server_key() -> ServerKey!
    link_auth_key(private_key: str, passphrase: str) -> void!
    link_auth_password(password: str) -> void!
    link_auth_agent() -> void!
    link_shell_open(term: str, cols: i32, rows: i32, command: str) -> void!
    link_exec_start(command: str) -> void!
    // Like `link_exec_start`, with stdin left open until `link_channel_eof`.
    link_exec_open(command: str) -> void!
    link_channel_eof() -> void!
    link_channel_read(timeout_ms: i32) -> ExecChunk!
    link_channel_write(data: str) -> void!
    link_channel_resize(cols: i32, rows: i32) -> void!
    // Sends a keepalive request on the last hop without waiting for the answer.
    link_keepalive() -> void!
    // Lends the logged-in session to the Files view with no channel of its own (the
    // app's second Files pane, milestone 19). Only a GUI tab's link can; any other
    // fails with `internal`.
    link_lend() -> void!
    // Gives the logged-in session to the tunnel runner under `key` (milestone 22): the
    // runner owns it from then on and hangs it up; this link is left with no hop. Only
    // a plain link can; any other fails with `internal`.
    link_hand_over(key: str) -> void!
    link_hangup()
}

// Asking the person (adapters/process on a terminal, adapters/gui in a window).
// `prompt_available` is false when nobody can answer; the prompts then fail.
// `prompt_host_key` asks whether to trust a new server key; `host_key_changed` only
// tells the person about a changed key, which the core refuses either way (D-019).
// `prompt_password` returns "" when the person cancels.
type Prompter interface {
    prompt_available() -> bool
    prompt_host_key(q: HostKeyQuestion) -> bool!
    host_key_changed(q: HostKeyQuestion)
    prompt_password(user: str, alias: str) -> str!
}

// The local terminal of an interactive session (adapters/process): raw mode,
// keystrokes in, remote bytes out, and window resizes.
type Terminal interface {
    term_size() -> TerminalSize
    term_raw_enter() -> void!
    term_raw_leave()
    term_input(timeout_ms: i32) -> str!
    term_output(data: str)
    term_take_resize() -> bool
}

// Where a streaming exec writes the remote stdout and stderr (adapters/process).
type ExecSink interface {
    exec_stdout(data: str)
    exec_stderr(data: str)
}

// The system clipboard (adapters/uievents, the desktop app). `clipboard_copy_secret`
// puts a secret on it, marked so clipboard managers skip it where the OS allows, and
// clears it after `clear_after_ms` unless something else was copied since (D-029).
type Clipboard interface {
    clipboard_copy_secret(text: str, clear_after_ms: i64) -> void!
    // Plain text a remote program copied (OSC 52): not concealed, never cleared.
    clipboard_copy_text(text: str) -> void!
    // What a paste would take: the text, else an image as PNG (milestone 25 on Linux).
    clipboard_read() -> ClipboardContent!
    // A number that changes whenever anything is copied (macOS' changeCount, GTK's
    // owner changes), -1 where the system has none. Cheap: an RDP tab checks it a few
    // times a second (milestone 31).
    clipboard_change_count() -> i64
}

// A presence check before the owner's Allow takes effect (adapters/uievents,
// milestone 12). `presence_method` is "touchid", "device" (the Mac's password),
// "polkit" or "password" (the window asks for the vault's master password, which the
// core checks itself). `presence_confirm` asks the OS and blocks until answered.
type Presence interface {
    presence_method() -> str
    presence_confirm(reason: str) -> bool!
}

// The desktop app's layout state (adapters/config, ui-state.json, D-030).
// `ui_state_load` returns the defaults when nothing has been saved yet or the file
// is damaged; writes are atomic.
type UiStateStore interface {
    ui_state_load() -> UiState!
    ui_state_save(s: UiState) -> void!
}

// Monotonic milliseconds, for timeouts and durations (adapters/process).
type Clock interface {
    clock_now_ms() -> i64
}

// Files on a host over SFTP (adapters/ssh/sftp.cf, milestone 16), on the last hop of
// an `SshTransport` link that is already logged in. One SFTP channel per link and
// one open file at a time. Every request is bounded by the link's dial timeout
// (Principle 8). Errors carry `not_found`, `permission_denied`, `exists`,
// `not_a_directory`, `io` or `network`.
type SftpTransport interface {
    sftp_open() -> void!
    // Follows links.
    sftp_stat(path: str) -> FileEntry!
    // A folder's entries without `.` and `..`; links are not followed.
    sftp_list(path: str) -> []FileEntry!
    // For reading (`write` false) or writing: created or truncated, refused with
    // `exists` when `exclusive` and the file is there.
    sftp_file_open(path: str, write: bool, exclusive: bool) -> void!
    // The next bytes of the open file; "" at its end.
    sftp_file_read() -> str!
    sftp_file_write(data: str) -> void!
    sftp_file_close() -> void!
    sftp_rename(from: str, to: str) -> void!
    // A file, or an empty folder when `folder`.
    sftp_remove(path: str, folder: bool) -> void!
    sftp_mkdir(path: str) -> void!
    // Sets `path`'s permission bits, as `chmod` (milestone 25).
    sftp_chmod(path: str, mode: i64) -> void!
    // The absolute form of `path` ("." is the login folder).
    sftp_realpath(path: str) -> str!
    sftp_close()
    // How errors name this host ("on db1"); "the host" until set. A copy between two
    // hosts (milestone 18) names each.
    sftp_label(name: str)
}

// Files on this machine (adapters/process/local_fs.cf; over the socket, the CLI's own,
// adapters/ipc/relay_files.cf). The same shape as `SftpTransport`, so a copy reads one
// and writes the other. A relative path is the CLI's current folder's.
type LocalFiles interface {
    local_stat(path: str) -> FileEntry!
    local_list(path: str) -> []FileEntry!
    local_file_open(path: str, write: bool, exclusive: bool) -> void!
    local_file_read() -> str!
    local_file_write(data: str) -> void!
    local_file_close() -> void!
    // Replaces `to` if it exists.
    local_rename(from: str, to: str) -> void!
    local_remove(path: str) -> void!
    local_mkdir(path: str) -> void!
}

// Files dragged into the window from the OS (milestone 17): the webview hands the
// page their bytes, not their paths (CF-004), so the page sends them here in chunks
// and the upload reads them from this machine. One folder per drop, readable only
// by the person (adapters/process/drop_stage.cf); discarded once uploaded.
type DropStage interface {
    // The drop's folder, absolute.
    stage_folder(drop_id: str) -> str
    // Appends `data` to `rel` (a relative path, already checked) in the drop's folder.
    stage_append(drop_id: str, rel: str, data: str) -> void!
    stage_discard(drop_id: str)
}

// Where a copy reports its progress, and how it learns it was cancelled (stderr in
// the CLI, frames to the CLI from the app, events to the window in milestone 17).
type TransferSink interface {
    transfer_progress(p: TransferProgress)
    transfer_cancelled() -> bool
}

// Running tunnels (adapters/ssh/tunnels.cf, milestone 22, D-062). A host's tunnels
// share one SSH session with no terminal, handed over by `link_hand_over` under the
// host's id; each tunnel is a listener on 127.0.0.1 whose every connection opens its
// own forward channel. A lost session closes every listener of its host and stays
// reported until released; nothing redials on its own.
type TunnelRunner interface {
    // 0: no session for the host; 1: up; 2: lost.
    tunnel_host_state(host_id: str) -> i64
    // Listens on 127.0.0.1:local_port (already listening: nothing changes) and returns
    // the port. Errors: `port_in_use`, `permission_denied`, `network` (no session).
    tunnel_listen(host_id: str, tunnel_id: str, local_port: i64, dest_host: str, dest_port: i64) -> i64!
    // Closes the tunnel and its connections; false when it was not running.
    tunnel_unlisten(host_id: str, tunnel_id: str) -> bool
    // Closes every tunnel of the host and hangs its session up.
    tunnel_release(host_id: str)
    tunnel_live() -> []TunnelLive
    // Starts on one host take turns (milestone 23): held while a start logs in and
    // listens, so a second start finds the first's session.
    tunnel_gate_enter(host_id: str)
    tunnel_gate_leave(host_id: str)
    // Whether 127.0.0.1:port cannot be bound now (the approval window says so first).
    tunnel_port_taken(port: i64) -> bool
    // Who listens on that port, when this user may see it (design 16h2).
    tunnel_port_owner(port: i64) -> PortOwner
}

// A remote desktop engine (adapters/rdp, FreeRDP 3, milestone 30, D-070). One
// connection per tab, keyed by the tab's id; nothing above the adapters knows the
// engine. Input arrives as Flint's own events (a key's `code` as the W3C UI Events
// name it, "KeyA", "ControlLeft"; pointer events in desktop pixels) and frames leave
// through the tab's local frame channel (D-071), which outlives a reconnect.
type RemoteDesktop interface {
    // Connects the tab, replacing its connection if it has one, and logs in (NLA when
    // the server asks). Only `t.trusted_fingerprint` is accepted; any other
    // certificate fails `host_key` and is kept for `rd_presented_cert`. Bounded by
    // `timeout_ms` (Principle 8). Errors: `auth`, `network`, `refused`, `timeout`,
    // `host_key`.
    rd_open(tab: str, t: RdpTarget, timeout_ms: i64) -> RdpDesktop!
    // The certificate the server presented on the tab's last `rd_open`.
    rd_presented_cert(tab: str) -> RdpCert
    // Asks for a new desktop size. With Display Control the server resizes in place;
    // without it the size is kept and `rd_wait` reports a `resize`.
    rd_resize(tab: str, width: i64, height: i64) -> void!
    // Milestone 38 (D-089): the desktop across several monitors, `monitors` a layout
    // check_rdp_layout accepts (the primary first, at 0,0). With Display Control the
    // server rearranges in place, the session kept; without it `rd_wait` reports a
    // `resize` carrying the layout, which a reconnect gives. From here on the frame
    // channel serves one view per monitor (layout_crops' order), and `rd_resize` goes
    // back to one monitor.
    rd_set_layout(tab: str, monitors: []RdpMonitor) -> void!
    // Waits up to `wait_ms` for the session to end or to need a reconnect.
    rd_wait(tab: str, wait_ms: i64) -> RdpEvent
    rd_key(tab: str, code: str, down: bool) -> void!
    rd_pointer(tab: str, p: RdpPointer) -> void!
    // Milestone 31 (D-074): tells the server whether this machine's clipboard holds
    // text, without sending it; the server asks for it when someone pastes there, as
    // an `rd_wait` event of kind `clip_request`, answered with `rd_clip_answer` (the
    // text, or a refusal when `ok` is false). The remote's copies arrive as
    // `clip_text` events.
    rd_clip_announce(tab: str, has_text: bool) -> void!
    rd_clip_answer(tab: str, ok: bool, text: str) -> void!
    // Milestone 34: the tab's counters since it opened (RdpStats); fails `network`
    // when the tab is closed.
    rd_stats(tab: str) -> RdpStats!
    // Milestone 35: asks for the tab in another graphics mode (RDP_GRAPHICS). Nothing
    // changes on the wire: `rd_wait` reports a `graphics` event and the core
    // reconnects. Fails `network` when the tab is closed.
    rd_set_graphics(tab: str, graphics: str) -> void!
    // Milestone 35: the round trip of a TCP dial to `host:port`, in ms (the best of a
    // few), or -1 when it does not answer within `timeout_ms`. Opens and closes plain
    // TCP connections; sends nothing.
    rd_probe_rtt(host: str, port: i64, timeout_ms: i64) -> i64
    // Ends the tab's connection (an `rd_open` in progress is cancelled) and its frame
    // channel. A tab with nothing open is left as it is.
    rd_close(tab: str)
}

// This computer's monitors (milestone 38, D-089): native per system in the desktop app
// (CF-126); the CLI has none.
type Screens interface {
    // "" when a desktop can span monitors on this system, else why not, in the words
    // the page shows ("Not supported on this system yet").
    screens_unsupported() -> str
    screens_list() -> []LocalMonitor
    // The monitor Flint's main window is on ("" when unknown).
    screens_main() -> str
}

// Where a remote desktop tells its driver that it is up (webui events in the app).
type DesktopSink interface {
    desktop_ready(tab: str, d: RdpDesktop)
    // Whether someone may act through the window now: a locked window answers no
    // clipboard request (milestone 31).
    desktop_window_open() -> bool
    // Milestone 35: the tab's graphics mode is now `graphics` (RDP_GRAPHICS), run by the
    // engine as `sw.graphics` (`sw.why` ""), or it stayed as it was and `sw.why` says why.
    desktop_graphics(tab: str, graphics: str, sw: RdpModeSwitch)
}
