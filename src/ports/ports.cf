package ports

// Ports: what the core needs from the outside world. Adapters implement them;
// the domain and application layers depend only on these interfaces.
//
// cfire interfaces lower to C++20 concepts (static dispatch), so use cases take
// their dependencies as generic parameters constrained by these interfaces.
//
// Method names are prefixed by their port (`vault_`, `keychain_`, ...): packages
// share one C++ namespace, so a method called `open` or `get` would capture every
// stdlib call of that name in the program (CF-017).

import "../domain"

// Key derivation and authenticated encryption (adapters/crypto, libsodium).
type Crypto interface {
    random_bytes(n: usize) -> []byte
    derive_key(password: str, salt: []byte, ops: u64, mem_bytes: usize) -> []byte!
    derive_subkey(master: []byte, id: u64, kdf_context: str) -> []byte!
    seal(key: []byte, plaintext: []byte, aad: []byte) -> []byte!
    unseal(key: []byte, sealed: []byte, aad: []byte) -> []byte!
}

// The encrypted vault file (adapters/vault, SQLCipher). One vault is open at a time.
// Rows go in and out as domain types; secret fields are already sealed.
type VaultStore interface {
    vault_file_exists(path: str) -> bool
    vault_read_salt(path: str) -> []byte!
    vault_create(path: str, page_key: []byte, salt: []byte) -> void!
    vault_attach(path: str, page_key: []byte, salt: []byte) -> void!
    vault_detach()
    vault_format() -> i64!
    vault_get_meta(key: str) -> str!
    vault_set_meta(key: str, value: str) -> void!
    vault_begin() -> void!
    vault_commit() -> void!
    vault_rollback()
    groups_all() -> []Group!
    group_put(g: Group) -> void!
    group_drop(id: str) -> void!
    hosts_all() -> []Host!
    host_put(h: Host) -> void!
    host_drop(id: str) -> void!
    keys_all() -> []SshKey!
    key_put(k: SshKey) -> void!
    key_drop(id: str) -> void!
    creds_all() -> []Credential!
    cred_put(c: Credential) -> void!
    cred_drop(id: str) -> void!
    known_hosts_all() -> []KnownHost!
    known_host_put(k: KnownHost) -> void!
    known_host_drop(addr: str) -> void!
}

// The OS keychain (adapters/keychain). Holds one master key per vault, by account.
// `keychain_load` returns an empty slice when there is no entry.
type Keychain interface {
    keychain_save(account: str, secret: []byte) -> void!
    keychain_load(account: str) -> []byte!
    keychain_forget(account: str) -> void!
}

// The local list of recent vaults (adapters/config), most recent first.
type RecentStore interface {
    recents_load() -> []RecentVault!
    recents_save(list: []RecentVault) -> void!
}

// The desktop app's per-machine settings (adapters/config). `settings_load`
// returns the defaults when nothing has been saved yet.
type SettingsStore interface {
    settings_load() -> Settings!
    settings_save(s: Settings) -> void!
}

// The monospaced font families installed on this machine (adapters/fonts).
type FontCatalog interface {
    mono_font_families() -> []str!
}

// Parses a private key to validate it and read its public half (adapters/ssh).
type KeyInspector interface {
    inspect_private_key(private_key: str, passphrase: str) -> KeyInfo!
}

// An interactive remote shell (adapters/ssh, libssh).
type ShellSession interface {
    write(data: str) -> void!
    read(timeout_ms: i32) -> str!
    resize(cols: i32, rows: i32) -> void!
}

// Out-of-band delivery of terminal bytes to a driver (webui events, stdio).
type EventSink interface {
    terminal_output(session_id: str, data: str)
    terminal_closed(session_id: str, reason: str)
}

// An SSH connection chain (adapters/ssh, libssh). `link_dial` opens the first hop
// directly and every later hop through a tunnel over the previous one; the other
// calls act on the last hop. Each blocking call is bounded by the dial timeout
// (Principle 8). Errors carry `network`, `auth` or `host_key` codes.
// `host_key_algos` ("" for the library defaults) is the domain's
// `preferred_host_key_algos` for the hop being dialled.
// One channel at a time: a shell (PTY) or an exec. `link_shell_open` with a
// `command` runs that command on the PTY instead of the login shell ("" for none).
type SshTransport interface {
    link_dial(hostname: str, port: i64, user: str, timeout_secs: i64, host_key_algos: str) -> void!
    link_server_key() -> ServerKey!
    link_auth_key(private_key: str, passphrase: str) -> void!
    link_auth_password(password: str) -> void!
    link_auth_agent() -> void!
    link_shell_open(term: str, cols: i32, rows: i32, command: str) -> void!
    link_exec_start(command: str) -> void!
    link_channel_read(timeout_ms: i32) -> ExecChunk!
    link_channel_write(data: str) -> void!
    link_channel_resize(cols: i32, rows: i32) -> void!
    link_hangup()
}

// Asking the person (adapters/process on a terminal, adapters/gui in a window).
// `prompt_available` is false when nobody can answer; the prompts then fail.
// `prompt_host_key` asks whether to trust a new server key; `host_key_changed` only
// tells the person about a changed key, which the core refuses either way (D-019).
// `prompt_password` returns "" when the person cancels.
type Prompter interface {
    prompt_available() -> bool
    prompt_host_key(q: HostKeyQuestion) -> bool!
    host_key_changed(q: HostKeyQuestion)
    prompt_password(user: str, alias: str) -> str!
}

// The local terminal of an interactive session (adapters/process): raw mode,
// keystrokes in, remote bytes out, and window resizes.
type Terminal interface {
    term_size() -> TerminalSize
    term_raw_enter() -> void!
    term_raw_leave()
    term_input(timeout_ms: i32) -> str!
    term_output(data: str)
    term_take_resize() -> bool
}

// Where a streaming exec writes the remote stdout and stderr (adapters/process).
type ExecSink interface {
    exec_stdout(data: str)
    exec_stderr(data: str)
}

// The system clipboard (adapters/uievents, the desktop app). `clipboard_copy_secret`
// puts a secret on it, marked so clipboard managers skip it where the OS allows, and
// clears it after `clear_after_ms` unless something else was copied since (D-029).
type Clipboard interface {
    clipboard_copy_secret(text: str, clear_after_ms: i64) -> void!
}

// Monotonic milliseconds, for timeouts and durations (adapters/process).
type Clock interface {
    clock_now_ms() -> i64
}
