package application

import "../domain"

fn yes_prompter() -> FakePrompter {
    return FakePrompter{ available: true, confirm: true, password: "" }
}

// A vault with key `k1` ("PRIVATE one"), credential `ops` (user "deploy", key k1,
// password "cred-pw"), bastion (user "jump", password "host-pw") and web (credential
// ops, jump bastion).
fn ssh_fixture(crypto: FakeCrypto, mut store: FakeStore) -> VaultSession {
    s := fresh_session(crypto, mut store)
    inspector := FakeInspector{ strict: false }
    _ := add_key(crypto, mut store, inspector, s, "k1", "PRIVATE one", "") or KeyView{ name: "", key_type: "", public_key: "", fingerprint: "", has_passphrase: false }
    mut cp := empty_cred_patch()
    cp.name = "ops"
    cp.set_name = true
    cp.user = "deploy"
    cp.set_user = true
    cp.key = "k1"
    cp.set_key = true
    cp.password = "cred-pw"
    cp.set_password = true
    _ := add_cred(crypto, mut store, s, cp) or CredView{ name: "", user: "", key: "", has_password: false }
    mut b := host_patch("bastion", "Bastion.Example.org")
    b.user = "jump"
    b.set_user = true
    b.password = "host-pw"
    b.set_password = true
    _ := add_host(crypto, mut store, s, b) or empty_host_view()
    mut w := host_patch("web", "10.0.0.5")
    w.port = 2222
    w.set_port = true
    w.credential = "ops"
    w.set_credential = true
    w.jump = "bastion"
    w.set_jump = true
    _ := add_host(crypto, mut store, s, w) or empty_host_view()
    return s
}

fn empty_host_view() -> HostView {
    return HostView{ alias: "", label: "", hostname: "", port: 0, user: "", group: "", tags: [], color: "", notes: "", jump: "", credential: "", key: "", has_password: false, has_sudo_password: false, command: "", keep_shell: true }
}

fn accept_opts() -> ConnectOptions {
    mut o := default_connect_options()
    o.accept_new_host_key = true
    return o
}

test "the jump chain is outermost first and the users resolve" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    _ := ssh_fixture(crypto, mut store)
    cat := try load_catalog(store)
    web := try require_host(cat.hosts, "web")
    chain := try jump_chain(cat, web)
    assert_eq(chain.len(), 2)
    assert_eq(chain[0].alias, "bastion")
    assert_eq(chain[1].alias, "web")
    assert_eq(try auth_user(cat, chain[0]), "jump")
    assert_eq(try auth_user(cat, chain[1]), "deploy")
}

test "auth steps: host key, host password, credential key, credential password, agent" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    cat := try load_catalog(store)
    web := try require_host(cat.hosts, "web")
    steps := auth_steps(cat, web)
    assert_eq(steps.len(), 3)
    assert_eq(steps[0].kind, "key")
    assert_eq(steps[0].source, "credential")
    assert_eq(steps[1].kind, "password")
    assert_eq(steps[2].kind, "agent")
    assert_eq(step_label(cat, steps[0]), "key 'k1'")
    assert_eq(step_label(cat, steps[1]), "credential 'ops' password")

    // A host key equal to the credential key is tried once.
    mut p := empty_host_patch()
    p.key = "k1"
    p.set_key = true
    p.password = "own-pw"
    p.set_password = true
    _ := try edit_host(crypto, mut store, s, "web", p)
    cat2 := try load_catalog(store)
    steps2 := auth_steps(cat2, try require_host(cat2.hosts, "web"))
    assert_eq(steps2.len(), 4)
    assert_eq(steps2[0].source, "host")
    assert_eq(steps2[1].kind, "password")
    assert_eq(steps2[1].source, "host")
    assert_eq(steps2[2].source, "credential")
}

test "a host with no user anywhere is refused before dialling" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    _ := try add_host(crypto, mut store, s, host_patch("bare", "bare.example.org"))
    mut link := new_fake_link()
    mut r := ""
    open_link(crypto, mut store, s, mut link, no_prompter(), "bare", accept_opts()) or err { r = "{err.message()}" }
    assert_eq(err_code(r), "invalid")
    assert_eq(link.calls.len(), 0)
}

test "connecting through a jump host dials and authenticates every hop with vault secrets" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut link := new_fake_link()
    link.good_password = "host-pw"
    link.good_key = "PRIVATE one"
    target := try open_link(crypto, mut store, s, mut link, no_prompter(), "web", accept_opts())
    assert_eq(target.alias, "web")
    assert_eq(link.calls.len(), 4)
    assert_eq(link.calls[0], "dial jump@Bastion.Example.org:22")
    assert_eq(link.calls[1], "password host-pw")
    assert_eq(link.calls[2], "dial deploy@10.0.0.5:2222")
    assert_eq(link.calls[3], "key PRIVATE one/")
    known := try store.known_hosts_all()
    assert_eq(known.len(), 2)
    assert_eq(known[0].addr, "bastion.example.org")
    assert_eq(known[1].addr, "[10.0.0.5]:2222")
    assert(!link.hung_up)
}

test "rejected methods fall through to the next, then fail with auth naming them" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut link := new_fake_link()
    link.good_password = "host-pw"
    _ := try open_link(crypto, mut store, s, mut link, no_prompter(), "bastion", accept_opts())

    mut link2 := new_fake_link()
    link2.good_password = "host-pw"
    // web: key rejected, credential password rejected, agent rejected.
    mut r := ""
    open_link(crypto, mut store, s, mut link2, no_prompter(), "web", accept_opts()) or err { r = "{err.message()}" }
    assert_eq(err_code(r), "auth")
    msg := "{r}"
    assert(msg.contains("key 'k1'"))
    assert(msg.contains("credential 'ops' password"))
    assert(msg.contains("SSH agent"))
    assert(!msg.contains("cred-pw"), "a secret must never appear in an error")
    assert(!msg.contains("PRIVATE"), "a key must never appear in an error")
    assert(link2.hung_up)
}

test "the agent is tried last and a terminal password prompt follows" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    _ := try add_host(crypto, mut store, s, host_patch_user("lone", "lone.example.org", "me"))
    mut agent_link := new_fake_link()
    agent_link.agent_ok = true
    _ := try open_link(crypto, mut store, s, mut agent_link, no_prompter(), "lone", accept_opts())
    assert_eq(agent_link.calls[agent_link.calls.len() - 1], "agent")

    mut typed_link := new_fake_link()
    typed_link.good_password = "typed"
    prompter := FakePrompter{ available: true, confirm: true, password: "typed" }
    _ := try open_link(crypto, mut store, s, mut typed_link, prompter, "lone", accept_opts())
    assert_eq(typed_link.calls[typed_link.calls.len() - 1], "password typed")
}

fn host_patch_user(alias: str, hostname: str, user: str) -> HostPatch {
    mut p := host_patch(alias, hostname)
    p.user = user
    p.set_user = true
    return p
}

test "a network failure stops at once" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut link := new_fake_link()
    link.fail_dial = true
    mut r := ""
    open_link(crypto, mut store, s, mut link, no_prompter(), "web", accept_opts()) or err { r = "{err.message()}" }
    assert_eq(err_code(r), "network")
    assert_eq(link.calls.len(), 1)
    assert(link.hung_up)
}

test "an unknown host key needs a terminal or --accept-new-host-key" {
    mut got_code := "ok"
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut link := new_fake_link()
    link.good_password = "host-pw"
    mut r := ""
    open_link(crypto, mut store, s, mut link, no_prompter(), "bastion", default_connect_options()) or err { r = "{err.message()}" }
    assert_eq(err_code(r), "host_key")
    assert_eq((try store.known_hosts_all()).len(), 0)

    refuse := FakePrompter{ available: true, confirm: false, password: "" }
    mut link2 := new_fake_link()
    link2.good_password = "host-pw"
    got_code = "ok"
    open_link(crypto, mut store, s, mut link2, refuse, "bastion", default_connect_options()) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "host_key")
    assert_eq((try store.known_hosts_all()).len(), 0)

    mut link3 := new_fake_link()
    link3.good_password = "host-pw"
    _ := try open_link(crypto, mut store, s, mut link3, yes_prompter(), "bastion", default_connect_options())
    assert_eq((try store.known_hosts_all()).len(), 1)
    // Nothing was recorded yet, so the library defaults were used.
    assert_eq(link3.dial_algos, [""])

    // Known now: no prompt, no flag needed, and the recorded type is asked for first.
    mut link4 := new_fake_link()
    link4.good_password = "host-pw"
    _ := try open_link(crypto, mut store, s, mut link4, no_prompter(), "bastion", default_connect_options())
    assert_eq(link4.dial_algos, ["^ssh-ed25519"])
}

test "a changed host key is refused even with --accept-new-host-key, until forgotten" {
    mut got_code := "ok"
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut link := new_fake_link()
    link.good_password = "host-pw"
    _ := try open_link(crypto, mut store, s, mut link, no_prompter(), "bastion", accept_opts())

    mut evil := new_fake_link()
    evil.good_password = "host-pw"
    evil.server_fp = "SHA256:other"
    mut r := ""
    open_link(crypto, mut store, s, mut evil, yes_prompter(), "bastion", accept_opts()) or err { r = "{err.message()}" }
    assert_eq(err_code(r), "host_key")
    assert("{r}".contains("CHANGED"))
    assert_eq(evil.calls.len(), 1, "no credential may be sent to a changed key")

    views := try list_known_hosts(store)
    assert_eq(views.len(), 1)
    assert_eq(views[0].host, "bastion")
    gone := try remove_known_host(mut store, "bastion")
    assert_eq(gone.addr, "bastion.example.org")
    got_code = "ok"
    remove_known_host(mut store, "bastion") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "not_found")

    mut again := new_fake_link()
    again.good_password = "host-pw"
    again.server_fp = "SHA256:other"
    _ := try open_link(crypto, mut store, s, mut again, no_prompter(), "bastion", accept_opts())
    assert_eq((try store.known_hosts_all())[0].fingerprint, "SHA256:other")
}

test "exec streams or captures output and reports the exit code" {
    mut link := new_fake_link()
    link.chunks = [out_chunk("hello "), err_chunk("warn"), out_chunk("world"), done_chunk(3)]
    mut sink := FakeSink{ out_text: "", err_text: "" }
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    res := try run_exec(mut link, mut sink, mut clock, "web", "echo hi", 60, false)
    assert_eq(sink.out_text, "hello world")
    assert_eq(sink.err_text, "warn")
    assert_eq(res.exit_code, 3)
    assert_eq(res.stdout, "")
    assert_eq(link.calls[0], "exec echo hi")

    mut link2 := new_fake_link()
    link2.chunks = [out_chunk("a"), err_chunk("b"), done_chunk(0)]
    mut sink2 := FakeSink{ out_text: "", err_text: "" }
    res2 := try run_exec(mut link2, mut sink2, mut clock, "web", "x", 60, true)
    assert_eq(res2.stdout, "a")
    assert_eq(res2.stderr, "b")
    assert_eq(sink2.out_text, "")
    assert(res2.duration_ms > 0)
}

test "exec times out and refuses an empty command" {
    mut got_code := "ok"
    mut link := new_fake_link()
    mut many: []ExecChunk = []
    for _ in 0..100 {
        many.push(out_chunk("."))
    }
    link.chunks = many
    mut sink := FakeSink{ out_text: "", err_text: "" }
    mut clock := FakeClock{ now_ms: 0, step_ms: 500 }
    mut r := ""
    run_exec(mut link, mut sink, mut clock, "web", "sleep 99", 2, false) or err { r = "{err.message()}" }
    assert_eq(err_code(r), "timeout")
    got_code = "ok"
    run_exec(mut link, mut sink, mut clock, "web", "", 2, false) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "usage")
    got_code = "ok"
    run_exec(mut link, mut sink, mut clock, "web", "x", 0, false) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "invalid")
}

test "a shell relays both ways, follows resizes and leaves raw mode" {
    mut link := new_fake_link()
    link.chunks = [out_chunk("$ "), out_chunk(""), out_chunk("hi\r\n"), out_chunk(""), done_chunk(0)]
    mut term := new_fake_terminal(["echo hi\r", "", "exit\r"])
    term.resize_at = 2
    mut clock := idle_clock()
    code := try run_shell(mut link, mut term, mut clock, "xterm-256color", "")
    assert_eq(code, 0)
    assert_eq(link.calls[0], "shell xterm-256color 120x40")
    assert_eq(term.output, "$ hi\r\n")
    assert_eq(link.written, "echo hi\rexit\r")
    assert_eq(link.resized, "100x30")
    assert(!term.raw)
    assert_eq(term.raw_entered, 1)
    assert_eq(link.keepalives, 0)
}

// A clock that barely moves: no keepalive is ever due.
fn idle_clock() -> FakeClock {
    return FakeClock{ now_ms: 0, step_ms: 1 }
}

fn quiet_chunk() -> ExecChunk {
    return out_chunk("")
}

test "a quiet shell sends a keepalive every interval, and output resets the wait" {
    mut link := new_fake_link()
    // Each read advances the clock 10 s: reads 1-3 hear nothing (30 s), read 4 is
    // output, reads 5-7 are quiet again, then the shell ends.
    link.chunks = [quiet_chunk(), quiet_chunk(), quiet_chunk(), out_chunk("$ "), quiet_chunk(), quiet_chunk(), quiet_chunk(), done_chunk(0)]
    mut term := new_fake_terminal([])
    mut clock := FakeClock{ now_ms: 0, step_ms: 10000 }
    code := try run_shell(mut link, mut term, mut clock, "xterm-256color", "")
    assert_eq(code, 0)
    assert_eq(link.keepalives, 2)
    assert_eq(term.output, "$ ")
}

test "a keepalive that cannot be sent ends the session with a network error" {
    mut link := new_fake_link()
    link.fail_keepalive = true
    link.chunks = [quiet_chunk(), quiet_chunk(), quiet_chunk(), quiet_chunk(), done_chunk(0)]
    mut term := new_fake_terminal([])
    mut clock := FakeClock{ now_ms: 0, step_ms: 10000 }
    mut r := ""
    run_shell(mut link, mut term, mut clock, "xterm-256color", "") or err { r = "{err.message()}" }
    assert(r.len() > 0)
    assert_eq(error_code_of("{r}"), ERR_NETWORK)
    assert_eq(link.keepalives, 1)
    assert(!term.raw, "raw mode is left on the way out")
}

// ---- Initial command (D-031, D-032) ---------------------------------------------

fn web_link() -> FakeLink {
    mut link := new_fake_link()
    link.good_password = "host-pw"
    link.good_key = "PRIVATE one"
    return link
}

test "a host's initial command is stored, shown and run on the PTY" {
    mut got_code := "ok"
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut p := empty_host_patch()
    p.command = "herdr"
    p.set_command = true
    v := try edit_host(crypto, mut store, s, "web", p)
    assert_eq(v.command, "herdr")
    assert(v.keep_shell, "a login shell follows by default")

    mut link := web_link()
    mut term := new_fake_terminal(["exit\r"])
    mut clock1 := idle_clock()
    _ := try connect_host(crypto, mut store, s, mut link, no_prompter(), mut term, mut clock1, "web", "xterm-256color", accept_opts())
    assert_eq(link.calls[link.calls.len() - 1], "shell xterm-256color 120x40 \"$SHELL\" -ilc 'herdr'; exec \"$SHELL\" -l")

    mut q := empty_host_patch()
    q.keep_shell = false
    q.set_keep_shell = true
    _ := try edit_host(crypto, mut store, s, "web", q)
    mut link2 := web_link()
    mut term2 := new_fake_terminal([])
    mut clock2 := idle_clock()
    _ := try connect_host(crypto, mut store, s, mut link2, no_prompter(), mut term2, mut clock2, "web", "xterm-256color", accept_opts())
    assert_eq(link2.calls[link2.calls.len() - 1], "shell xterm-256color 120x40 exec \"$SHELL\" -ilc 'herdr'")

    // --no-command: a plain shell.
    mut plain := accept_opts()
    plain.run_initial_command = false
    mut link3 := web_link()
    mut term3 := new_fake_terminal([])
    mut clock3 := idle_clock()
    _ := try connect_host(crypto, mut store, s, mut link3, no_prompter(), mut term3, mut clock3, "web", "xterm-256color", plain)
    assert_eq(link3.calls[link3.calls.len() - 1], "shell xterm-256color 120x40")

    // exec ignores it.
    mut link4 := web_link()
    mut sink := FakeSink{ out_text: "", err_text: "" }
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    _ := try exec_on_host(crypto, mut store, s, mut link4, no_prompter(), mut sink, mut clock, "web", "uptime", accept_opts(), 60, true)
    assert_eq(link4.calls[link4.calls.len() - 1], "exec uptime")

    // An empty command clears it; a multi-line one is refused.
    mut c := empty_host_patch()
    c.command = "a\nb"
    c.set_command = true
    got_code = "ok"
    edit_host(crypto, mut store, s, "web", c) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "invalid")
    c.command = ""
    assert_eq((try edit_host(crypto, mut store, s, "web", c)).command, "")
}

// ---- Testing a host ----------------------------------------------------------------

test "host test connects every hop, hangs up and runs nothing" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut link := web_link()
    mut clock := FakeClock{ now_ms: 0, step_ms: 7 }
    r := try test_host(crypto, mut store, s, mut link, no_prompter(), mut clock, "web", accept_opts())
    assert_eq(r.host, "web")
    assert_eq(r.target, "deploy@10.0.0.5:2222")
    assert_eq(r.hops, 2)
    assert(r.duration_ms > 0)
    assert(link.hung_up)
    for call in link.calls {
        assert(!call.starts_with("shell") && !call.starts_with("exec"), "a test opens no channel")
    }
    assert_eq((try store.known_hosts_all()).len(), 2)
}

test "host test reports a failed method without asking for a password" {
    mut got_code := "ok"
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    _ := try add_host(crypto, mut store, s, host_patch_user("lone", "lone.example.org", "me"))
    mut link := new_fake_link()
    asks := FakePrompter{ available: true, confirm: true, password: "typed" }
    link.good_password = "typed"
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    mut r := ""
    test_host(crypto, mut store, s, mut link, asks, mut clock, "lone", accept_opts()) or err { r = "{err.message()}" }
    assert_eq(err_code(r), "auth")
    for call in link.calls {
        assert(call != "password typed", "a test never prompts for a password")
    }
    // A changed key is still refused.
    mut evil := web_link()
    evil.server_fp = "SHA256:other"
    mut first := web_link()
    _ := try test_host(crypto, mut store, s, mut first, no_prompter(), mut clock, "bastion", accept_opts())
    got_code = "ok"
    test_host(crypto, mut store, s, mut evil, yes_prompter(), mut clock, "bastion", accept_opts()) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "host_key")
}

test "a draft host is tested without saving it, and keeps a trusted key once added" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut p := host_patch_user("fresh", "Fresh.Example.org", "me")
    p.password = "draft-pw"
    p.set_password = true
    p.jump = "bastion"
    p.set_jump = true
    p.group = "never/created"
    p.set_group = true
    mut link := new_fake_link()
    link.good_password = "host-pw"
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    // The bastion's password is "host-pw"; the draft's own is "draft-pw".
    mut both := new_fake_link()
    both.good_password = "host-pw"
    mut r := ""
    test_host_draft(crypto, mut store, s, mut both, yes_prompter(), mut clock, "", p, default_connect_options()) or err { r = "{err.message()}" }
    assert_eq(err_code(r), "auth")
    mut used_draft_pw := false
    for call in both.calls {
        if call == "password draft-pw" {
            used_draft_pw = true
        }
    }
    assert(used_draft_pw, "the draft's typed password is used")
    assert_eq((try load_catalog(store)).hosts.len(), 2, "nothing is saved")
    assert_eq((try store.groups_all()).len(), 0, "no folder is created")

    mut ok := new_fake_link()
    ok.good_password = "draft-pw"
    // bastion is reached with its own password first: accept either.
    ok.agent_ok = true
    v := try test_host_draft(crypto, mut store, s, mut ok, yes_prompter(), mut clock, "", p, default_connect_options())
    assert_eq(v.host, "fresh")
    assert_eq(v.hops, 2)
    known := try store.known_hosts_all()
    mut fresh_key_host := "?"
    for k in known {
        if k.addr == "fresh.example.org" {
            fresh_key_host = k.host_id
        }
    }
    assert_eq(fresh_key_host, "", "a draft's key is recorded with no host")
    assert_eq((try load_catalog(store)).hosts.len(), 2)

    _ := try add_host(crypto, mut store, s, p)
    views := try list_known_hosts(store)
    mut owner := ""
    for k in views {
        if k.addr == "fresh.example.org" {
            owner = k.host
        }
    }
    assert_eq(owner, "fresh", "adding the host adopts the key its test trusted")
}

test "an edited draft overrides the saved host for the test only" {
    mut got_code := "ok"
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut p := empty_host_patch()
    p.port = 2200
    p.set_port = true
    mut link := new_fake_link()
    link.good_password = "host-pw"
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    v := try test_host_draft(crypto, mut store, s, mut link, yes_prompter(), mut clock, "bastion", p, default_connect_options())
    assert_eq(v.target, "jump@Bastion.Example.org:2200")
    assert_eq(link.calls[0], "dial jump@Bastion.Example.org:2200")
    assert_eq((try show_host(store, "bastion")).port, 22)
    got_code = "ok"
    test_host_draft(crypto, mut store, s, mut link, yes_prompter(), mut clock, "", empty_host_patch(), default_connect_options()) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "usage")
}

// ---- Reveal and copy (D-029) -------------------------------------------------------

test "a saved password is revealed or copied only by name, and the copy is cleared later" {
    mut got_code := "ok"
    mut refused := 0
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    assert_eq(try reveal_password(crypto, store, s, "host", "bastion"), "host-pw")
    assert_eq(try reveal_password(crypto, store, s, "credential", "ops"), "cred-pw")
    mut no_pw := ""
    reveal_password(crypto, store, s, "host", "web") or err { no_pw = "{err.message()}" }
    assert_eq(err_code(no_pw), "not_found")
    assert(!"{no_pw}".contains("pw"))
    got_code = "ok"
    reveal_password(crypto, store, s, "host", "nope") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "not_found")
    got_code = "ok"
    reveal_password(crypto, store, s, "key", "k1") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "invalid")

    mut clip := FakeClipboard{ text: "", clear_after_ms: 0, copies: 0 }
    try copy_password(crypto, store, s, mut clip, "credential", "ops")
    assert_eq(clip.text, "cred-pw")
    assert_eq(clip.clear_after_ms, 30000)
    got_code = "ok"
    copy_password(crypto, store, s, mut clip, "host", "web") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "not_found")
    assert_eq(clip.copies, 1)

    // A session with the wrong secrets key cannot open it. The key is derived from a
    // random salt, so a fixed "wrong" byte could be the right one (1 run in 256).
    wrong := VaultSession{ path: s.path, name: s.name, secrets_key: [byte(u8(s.secrets_key[0]) ^ u8(1)), byte(9), byte(9)], cached: false }
    reveal_password(crypto, store, wrong, "host", "bastion") or { refused += 1 }
    assert_eq(refused, 1)
}

// ---- A Files pane's session with no terminal (milestone 19) ---------------------

test "a Files pane's session logs in, opens no shell, lends the session and ends when the pane closes" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut link := web_link()
    mut term := new_fake_terminal(["", "", ""])
    term.closed_at_end = true
    mut clock := idle_clock()
    code := try hold_files_session(crypto, mut store, s, mut link, no_prompter(), mut term, mut clock, "web", accept_opts())
    assert_eq(code, 0)
    assert_eq(link.calls[link.calls.len() - 1], "lend")
    for c in link.calls {
        assert(!c.starts_with("shell"), "no PTY: {c}")
    }
    assert_eq(term.raw_entered, 1)
    assert(link.hung_up)
}

test "a Files pane's session ends with a network error when a keepalive cannot be sent" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut link := web_link()
    link.fail_keepalive = true
    mut term := new_fake_terminal(["", "", "", ""])
    mut clock := FakeClock{ now_ms: 0, step_ms: 20000 }
    mut r := ""
    hold_files_session(crypto, mut store, s, mut link, no_prompter(), mut term, mut clock, "web", accept_opts()) or err { r = "{err.message()}" }
    assert_eq(error_code_of("{r}"), ERR_NETWORK)
    assert_eq(link.keepalives, 1)
    assert(link.hung_up)
}

test "a Files pane's session that fails to log in never lends it" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := ssh_fixture(crypto, mut store)
    mut link := web_link()
    link.fail_dial = true
    mut term := new_fake_terminal([])
    mut clock := idle_clock()
    mut r := ""
    hold_files_session(crypto, mut store, s, mut link, no_prompter(), mut term, mut clock, "web", accept_opts()) or err { r = "{err.message()}" }
    assert_eq(error_code_of("{r}"), ERR_NETWORK)
    for c in link.calls {
        assert(c != "lend")
    }
    assert_eq(term.raw_entered, 0)
}
