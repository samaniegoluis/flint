package application

// In-memory and temp-file fakes of the ports, so the use cases are tested without
// any adapter (Principle 1). The fake crypto is NOT cryptography: it only has to be
// deterministic, key-sensitive and AAD-sensitive.

import "core:str"
import "core:fs"
import "core:rand"
import "core:encoding/hex"
import "core:crypto/sha256"
import "../domain"
import "../ports"

// ---- Crypto --------------------------------------------------------------------

type FakeCrypto struct {
    derive_calls: i64
}

fn (self: FakeCrypto) random_bytes(n: usize) -> []byte {
    return rand.bytes(n)
}

fn (self: FakeCrypto) derive_key(password: str, salt: []byte, ops: u64, mem_bytes: usize) -> []byte! {
    mut k := make([]byte, 32)
    pw := password.bytes()
    for i in 0..32 {
        mut v := u8(salt[i % salt.len()]) ^ u8(i)
        if password.len() > 0 {
            v = v ^ u8(pw[i % password.len()]) ^ u8(password.len())
        }
        k[i] = byte(v)
    }
    return k
}

fn (self: FakeCrypto) derive_subkey(master: []byte, id: u64, kdf_context: str) -> []byte! {
    mut k := make([]byte, 32)
    for i in 0..32 {
        k[i] = master[i] ^ byte(u8(id * 31 + 7))
    }
    return k
}

// Not a real hash: distinct inputs of the tests give distinct outputs.
fn (self: FakeCrypto) digest(data: []byte, out_len: usize) -> []byte! {
    mut res := make([]byte, out_len)
    for i, b in data {
        j := i % out_len
        res[j] = byte(u8(u8(res[j]) * 31 + u8(b) + u8(i)))
    }
    return res
}

fn (self: FakeCrypto) equal(a: []byte, b: []byte) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// sealed = [aad_len] aad [key0] (plaintext xor key0)
fn (self: FakeCrypto) seal(key: []byte, plaintext: []byte, aad: []byte) -> []byte! {
    mut s: []byte = [byte(u8(aad.len()))]
    for b in aad {
        s.push(b)
    }
    s.push(key[0])
    for b in plaintext {
        s.push(b ^ key[0])
    }
    return s
}

fn (self: FakeCrypto) unseal(key: []byte, sealed: []byte, aad: []byte) -> []byte! {
    n := usize(sealed[0])
    if n != aad.len() || sealed[n + 1] != key[0] {
        return error("invalid: fake open failed")
    }
    for i in 0..n {
        if sealed[i + 1] != aad[i] {
            return error("invalid: fake open failed")
        }
    }
    mut p: []byte = []
    for i in (n + 2)..sealed.len() {
        p.push(sealed[i] ^ key[0])
    }
    return p
}

// ---- Vault store ---------------------------------------------------------------

type FakeStore struct {
    file_path: str
    file_salt: []byte
    file_key: []byte
    attached: bool
    meta_keys: []str
    meta_values: []str
    groups: []Group
    hosts: []Host
    keys: []SshKey
    creds: []Credential
    known: []KnownHost
    snap_groups: []Group
    snap_hosts: []Host
    snap_keys: []SshKey
    snap_creds: []Credential
    snap_known: []KnownHost
}

fn new_fake_store() -> FakeStore {
    return FakeStore{ file_path: "", file_salt: [], file_key: [], attached: false, meta_keys: [], meta_values: [], groups: [], hosts: [], keys: [], creds: [], known: [], snap_groups: [], snap_hosts: [], snap_keys: [], snap_creds: [], snap_known: [] }
}

fn (self: FakeStore) vault_file_exists(path: str) -> bool {
    return self.file_path.len() > 0 && path == self.file_path
}

fn (self: FakeStore) vault_read_salt(path: str) -> []byte! {
    if !self.vault_file_exists(path) {
        return error(coded(ERR_NOT_FOUND, "no vault file at {path}"))
    }
    return self.file_salt
}

fn (mut self: FakeStore) vault_create(path: str, page_key: []byte, salt: []byte) -> void! {
    if self.file_path.len() > 0 {
        return error(coded(ERR_CONFLICT, "fake holds one file"))
    }
    self.file_path = path
    self.file_salt = salt
    self.file_key = page_key
    self.attached = true
    self.meta_keys = ["format"]
    self.meta_values = ["1"]
}

fn (mut self: FakeStore) vault_attach(path: str, page_key: []byte, salt: []byte) -> void! {
    if !self.vault_file_exists(path) {
        return error(coded(ERR_NOT_FOUND, "no vault file at {path}"))
    }
    if page_key != self.file_key || salt != self.file_salt {
        return error(coded(ERR_WRONG_PASSWORD, "the password is wrong"))
    }
    self.attached = true
}

fn (mut self: FakeStore) vault_detach() {
    self.attached = false
}

fn (self: FakeStore) need_attached() -> void! {
    if !self.attached {
        return error(coded(ERR_LOCKED, "no vault is unlocked"))
    }
}

fn (self: FakeStore) vault_format() -> i64! {
    try self.need_attached()
    return 1
}

fn (self: FakeStore) vault_get_meta(key: str) -> str! {
    try self.need_attached()
    for i, k in self.meta_keys {
        if k == key {
            return self.meta_values[i]
        }
    }
    return ""
}

fn (mut self: FakeStore) vault_set_meta(key: str, value: str) -> void! {
    try self.need_attached()
    for i, k in self.meta_keys {
        if k == key {
            self.meta_values[i] = value
            return
        }
    }
    self.meta_keys.push(key)
    self.meta_values.push(value)
}

fn (mut self: FakeStore) vault_begin() -> void! {
    try self.need_attached()
    self.snap_groups = self.groups
    self.snap_hosts = self.hosts
    self.snap_keys = self.keys
    self.snap_creds = self.creds
    self.snap_known = self.known
}

fn (mut self: FakeStore) vault_commit() -> void! {
}

fn (mut self: FakeStore) vault_rollback() {
    self.groups = self.snap_groups
    self.hosts = self.snap_hosts
    self.keys = self.snap_keys
    self.creds = self.snap_creds
    self.known = self.snap_known
}

fn (self: FakeStore) groups_all() -> []Group! {
    try self.need_attached()
    return self.groups
}

fn (mut self: FakeStore) group_put(g: Group) -> void! {
    try self.need_attached()
    for i, o in self.groups {
        if o.id == g.id {
            self.groups[i] = g
            return
        }
    }
    self.groups.push(g)
}

fn (mut self: FakeStore) group_drop(id: str) -> void! {
    mut next: []Group = []
    for g in self.groups {
        if g.id != id {
            next.push(g)
        }
    }
    self.groups = next
}

fn (self: FakeStore) hosts_all() -> []Host! {
    try self.need_attached()
    return self.hosts
}

fn (mut self: FakeStore) host_put(h: Host) -> void! {
    try self.need_attached()
    for i, o in self.hosts {
        if o.id == h.id {
            self.hosts[i] = h
            return
        }
    }
    self.hosts.push(h)
}

fn (mut self: FakeStore) host_drop(id: str) -> void! {
    mut next: []Host = []
    for h in self.hosts {
        if h.id != id {
            next.push(h)
        }
    }
    self.hosts = next
}

fn (self: FakeStore) keys_all() -> []SshKey! {
    try self.need_attached()
    return self.keys
}

fn (mut self: FakeStore) key_put(k: SshKey) -> void! {
    try self.need_attached()
    for i, o in self.keys {
        if o.id == k.id {
            self.keys[i] = k
            return
        }
    }
    self.keys.push(k)
}

fn (mut self: FakeStore) key_drop(id: str) -> void! {
    mut next: []SshKey = []
    for k in self.keys {
        if k.id != id {
            next.push(k)
        }
    }
    self.keys = next
}

fn (self: FakeStore) creds_all() -> []Credential! {
    try self.need_attached()
    return self.creds
}

fn (mut self: FakeStore) cred_put(c: Credential) -> void! {
    try self.need_attached()
    for i, o in self.creds {
        if o.id == c.id {
            self.creds[i] = c
            return
        }
    }
    self.creds.push(c)
}

fn (mut self: FakeStore) cred_drop(id: str) -> void! {
    mut next: []Credential = []
    for c in self.creds {
        if c.id != id {
            next.push(c)
        }
    }
    self.creds = next
}

fn (self: FakeStore) known_hosts_all() -> []KnownHost! {
    try self.need_attached()
    return self.known
}

fn (mut self: FakeStore) known_host_put(k: KnownHost) -> void! {
    try self.need_attached()
    for i, o in self.known {
        if o.addr == k.addr {
            self.known[i] = k
            return
        }
    }
    self.known.push(k)
}

fn (mut self: FakeStore) known_host_drop(addr: str) -> void! {
    mut next: []KnownHost = []
    for k in self.known {
        if k.addr != addr {
            next.push(k)
        }
    }
    self.known = next
}

// ---- Keychain and recents: temp files, since their methods are not `mut` -------

type FakeKeychain struct {
    dir: str
    enabled: bool
}

fn new_fake_keychain() -> FakeKeychain {
    dir := "/tmp/flint-fake-kc-" + sha256.random_hex(8)
    _ := fs.mkdir_all(dir)
    return FakeKeychain{ dir: dir, enabled: true }
}

fn (self: FakeKeychain) keychain_save(account: str, secret: []byte) -> void! {
    if !self.enabled {
        return error(coded(ERR_KEYCHAIN, "off"))
    }
    try fs.write_text(self.dir + "/" + account, hex.encode(secret))
}

fn (self: FakeKeychain) keychain_load(account: str) -> []byte! {
    p := self.dir + "/" + account
    if !self.enabled || !fs.exists(p) {
        return []
    }
    text := try fs.read_text(p)
    return hex.decode(text)
}

fn (self: FakeKeychain) keychain_forget(account: str) -> void! {
    p := self.dir + "/" + account
    if fs.exists(p) {
        try fs.remove(p)
    }
}

type FakeRecents struct {
    path: str
}

fn new_fake_recents() -> FakeRecents {
    dir := "/tmp/flint-fake-recents-" + sha256.random_hex(8)
    _ := fs.mkdir_all(dir)
    return FakeRecents{ path: dir + "/list" }
}

fn (self: FakeRecents) recents_load() -> []RecentVault! {
    mut list: []RecentVault = []
    if !fs.exists(self.path) {
        return list
    }
    text := try fs.read_text(self.path)
    for line in str_split_lines(text) {
        tab := str.index_of(line, "\t")
        if tab >= 0 {
            rest := line.substr(usize(tab) + 1)
            tab2 := str.index_of(rest, "\t")
            if tab2 >= 0 {
                list.push(RecentVault{ path: line.substr(0, usize(tab)), name: rest.substr(0, usize(tab2)), id: rest.substr(usize(tab2) + 1) })
            } else {
                list.push(RecentVault{ path: line.substr(0, usize(tab)), name: rest, id: "" })
            }
        }
    }
    return list
}

fn (self: FakeRecents) recents_save(list: []RecentVault) -> void! {
    mut text := ""
    for v in list {
        text = text + v.path + "\t" + v.name + "\t" + v.id + "\n"
    }
    try fs.write_text(self.path, text)
}

fn str_split_lines(s: str) -> []str {
    mut lines: []str = []
    mut cur := ""
    for b in s.bytes() {
        if u8(b) == 10 {
            lines.push(cur)
            cur = ""
        } else {
            cur = cur + byte_to_str(u8(b))
        }
    }
    if cur.len() > 0 {
        lines.push(cur)
    }
    return lines
}

// ---- Key inspector -------------------------------------------------------------

// Accepts "PRIVATE <name>" and, when it also says "ENCRYPTED", only with
// passphrase "pp".
type FakeInspector struct {
    strict: bool
}

fn (self: FakeInspector) inspect_private_key(private_key: str, passphrase: str) -> KeyInfo! {
    if !private_key.starts_with("PRIVATE ") {
        return error(coded(ERR_INVALID, "the private key could not be read"))
    }
    if private_key.contains("ENCRYPTED") && passphrase != "pp" {
        return error(coded(ERR_INVALID, "wrong passphrase"))
    }
    return KeyInfo{ key_type: "ssh-ed25519", public_key: "ssh-ed25519 AAAAfake", fingerprint: "SHA256:fake" }
}

// ---- Fixture -------------------------------------------------------------------

fn fresh_session(crypto: FakeCrypto, mut store: FakeStore) -> VaultSession {
    return create_vault(crypto, mut store, new_fake_keychain(), new_fake_recents(), "/v/test.flint", "", "correct horse") or VaultSession{ path: "", name: "", secrets_key: [], cached: false }
}

// ---- SSH transport, prompter, terminal, sink, clock -----------------------------

// A scripted SSH link. It accepts the private key text `good_key`, the password
// `good_password`, and the agent when `agent_ok`. Every auth attempt and dial is
// recorded in `calls`; channel reads replay `chunks`, then report done.
type FakeLink struct {
    good_key: str
    good_password: str
    agent_ok: bool
    server_fp: str
    calls: []str
    chunks: []ExecChunk
    read_pos: usize
    written: str
    resized: str
    hung_up: bool
    fail_dial: bool
    dial_algos: []str
    keepalives: i64
    fail_keepalive: bool
}

fn new_fake_link() -> FakeLink {
    return FakeLink{ good_key: "", good_password: "", agent_ok: false, server_fp: "SHA256:server", calls: [], chunks: [], read_pos: 0, written: "", resized: "", hung_up: false, fail_dial: false, dial_algos: [], keepalives: 0, fail_keepalive: false }
}

fn (mut self: FakeLink) link_dial(hostname: str, port: i64, user: str, timeout_secs: i64, host_key_algos: str) -> void! {
    self.calls.push("dial {user}@{hostname}:{port}")
    self.dial_algos.push(host_key_algos)
    if self.fail_dial {
        return error(coded(ERR_NETWORK, "connect to {hostname}:{port} failed"))
    }
}

fn (self: FakeLink) link_server_key() -> ServerKey! {
    return ServerKey{ key_type: "ssh-ed25519", fingerprint: self.server_fp }
}

fn (mut self: FakeLink) link_auth_key(private_key: str, passphrase: str) -> void! {
    self.calls.push("key " + private_key + "/" + passphrase)
    if self.good_key.len() == 0 || private_key != self.good_key {
        return error(coded(ERR_AUTH, "public-key authentication was rejected"))
    }
}

fn (mut self: FakeLink) link_auth_password(password: str) -> void! {
    self.calls.push("password " + password)
    if self.good_password.len() == 0 || password != self.good_password {
        return error(coded(ERR_AUTH, "password authentication was rejected"))
    }
}

fn (mut self: FakeLink) link_auth_agent() -> void! {
    self.calls.push("agent")
    if !self.agent_ok {
        return error(coded(ERR_AUTH, "the SSH agent offered no accepted key"))
    }
}

fn (mut self: FakeLink) link_shell_open(term: str, cols: i32, rows: i32, command: str) -> void! {
    if command.len() > 0 {
        self.calls.push("shell {term} {cols}x{rows} " + command)
    } else {
        self.calls.push("shell {term} {cols}x{rows}")
    }
}

fn (mut self: FakeLink) link_exec_start(command: str) -> void! {
    self.calls.push("exec " + command)
}

fn (mut self: FakeLink) link_channel_read(timeout_ms: i32) -> ExecChunk! {
    if self.read_pos < self.chunks.len() {
        c := self.chunks[self.read_pos]
        self.read_pos += 1
        return c
    }
    return ExecChunk{ stdout: "", stderr: "", done: true, exit_code: 0, signal: "" }
}

fn (mut self: FakeLink) link_channel_write(data: str) -> void! {
    self.written = self.written + data
}

fn (mut self: FakeLink) link_channel_resize(cols: i32, rows: i32) -> void! {
    self.resized = "{cols}x{rows}"
}

fn (mut self: FakeLink) link_keepalive() -> void! {
    self.keepalives += 1
    if self.fail_keepalive {
        return error(coded(ERR_NETWORK, "the connection was lost"))
    }
}

fn (mut self: FakeLink) link_hangup() {
    self.hung_up = true
}

fn out_chunk(text: str) -> ExecChunk {
    return ExecChunk{ stdout: text, stderr: "", done: false, exit_code: 0, signal: "" }
}

fn err_chunk(text: str) -> ExecChunk {
    return ExecChunk{ stdout: "", stderr: text, done: false, exit_code: 0, signal: "" }
}

fn done_chunk(code: i64) -> ExecChunk {
    return ExecChunk{ stdout: "", stderr: "", done: true, exit_code: code, signal: "" }
}

// Answers prompts from fixed values. `available` false behaves like no terminal.
type FakePrompter struct {
    available: bool
    confirm: bool
    password: str
}

fn (self: FakePrompter) prompt_available() -> bool {
    return self.available
}

fn (self: FakePrompter) prompt_host_key(q: HostKeyQuestion) -> bool! {
    if !self.available {
        return error(coded(ERR_USAGE, "no terminal"))
    }
    return self.confirm
}

fn (self: FakePrompter) host_key_changed(q: HostKeyQuestion) {
}

fn (self: FakePrompter) prompt_password(user: str, alias: str) -> str! {
    if !self.available {
        return error(coded(ERR_USAGE, "no terminal"))
    }
    return self.password
}

fn no_prompter() -> FakePrompter {
    return FakePrompter{ available: false, confirm: false, password: "" }
}

// Replays `inputs` one per poll, then reports local EOF when `eof_at_end`.
type FakeTerminal struct {
    cols: i32
    rows: i32
    inputs: []str
    input_pos: usize
    resize_at: usize
    output: str
    raw: bool
    raw_entered: i64
}

fn new_fake_terminal(inputs: []str) -> FakeTerminal {
    return FakeTerminal{ cols: 120, rows: 40, inputs: inputs, input_pos: 0, resize_at: 999, output: "", raw: false, raw_entered: 0 }
}

fn (self: FakeTerminal) term_size() -> TerminalSize {
    return TerminalSize{ cols: self.cols, rows: self.rows }
}

fn (mut self: FakeTerminal) term_raw_enter() -> void! {
    self.raw = true
    self.raw_entered += 1
}

fn (mut self: FakeTerminal) term_raw_leave() {
    self.raw = false
}

fn (mut self: FakeTerminal) term_input(timeout_ms: i32) -> str! {
    if self.input_pos < self.inputs.len() {
        s := self.inputs[self.input_pos]
        self.input_pos += 1
        if self.input_pos == self.resize_at {
            self.cols = 100
            self.rows = 30
        }
        return s
    }
    return ""
}

fn (mut self: FakeTerminal) term_output(data: str) {
    self.output = self.output + data
}

fn (mut self: FakeTerminal) term_take_resize() -> bool {
    if self.input_pos == self.resize_at {
        self.resize_at = 999
        return true
    }
    return false
}

type FakeSink struct {
    out_text: str
    err_text: str
}

fn (mut self: FakeSink) exec_stdout(data: str) {
    self.out_text = self.out_text + data
}

fn (mut self: FakeSink) exec_stderr(data: str) {
    self.err_text = self.err_text + data
}

// Advances `step_ms` on every read.
type FakeClock struct {
    now_ms: i64
    step_ms: i64
}

fn (mut self: FakeClock) clock_now_ms() -> i64 {
    self.now_ms += self.step_ms
    return self.now_ms
}

// Records what was copied and the clear delay asked for.
type FakeClipboard struct {
    text: str
    clear_after_ms: i64
    copies: i64
}

fn (mut self: FakeClipboard) clipboard_copy_secret(text: str, clear_after_ms: i64) -> void! {
    self.text = text
    self.clear_after_ms = clear_after_ms
    self.copies += 1
}

fn (mut self: FakeClipboard) clipboard_copy_text(text: str) -> void! {
    self.text = text
    self.clear_after_ms = 0
    self.copies += 1
}

// ---- Settings and fonts -------------------------------------------------------------

type FakeSettingsStore struct {
    saved: Settings
}

fn (self: FakeSettingsStore) settings_load() -> Settings! {
    return self.saved
}

fn (mut self: FakeSettingsStore) settings_save(s: Settings) -> void! {
    self.saved = s
}

type FakeUiStateStore struct {
    saved: UiState
    saves: i64
}

fn (self: FakeUiStateStore) ui_state_load() -> UiState! {
    return self.saved
}

fn (mut self: FakeUiStateStore) ui_state_save(s: UiState) -> void! {
    self.saved = s
    self.saves += 1
}

type FakeFonts struct {
    names: []str
}

fn (self: FakeFonts) mono_font_families() -> []str! {
    return self.names
}
