package application

type FakeShell struct {
    chunks: []str
    pos: usize
}

fn (self: FakeShell) write(data: str) -> void! {}

fn (mut self: FakeShell) read(timeout_ms: i32) -> str! {
    if self.pos >= self.chunks.len() {
        return error("channel closed")
    }
    c := self.chunks[self.pos]
    self.pos += 1
    return c
}

fn (self: FakeShell) resize(cols: i32, rows: i32) -> void! {}

type RecordingSink struct {
    output: str
    closed_reason: str
    events: i64
}

fn (mut self: RecordingSink) terminal_output(session_id: str, data: str) {
    self.output = self.output + data
    self.events += 1
}

fn (mut self: RecordingSink) terminal_closed(session_id: str, reason: str) {
    self.closed_reason = reason
}

test "pump forwards every non-empty chunk and reports the close" {
    mut shell := FakeShell{ chunks: ["he", "", "llo"], pos: 0 }
    mut sink := RecordingSink{ output: "", closed_reason: "", events: 0 }
    r := pump_shell_output(mut shell, mut sink, "s1", 10, 100)
    assert_eq(r.bytes, 5)
    assert(r.closed)
    assert_eq(sink.output, "hello")
    assert_eq(sink.events, 2)
    assert_eq(sink.closed_reason, "channel closed")
}

test "pump stops after max_reads while the shell stays open" {
    mut shell := FakeShell{ chunks: ["a", "b", "c", "d"], pos: 0 }
    mut sink := RecordingSink{ output: "", closed_reason: "", events: 0 }
    r := pump_shell_output(mut shell, mut sink, "s1", 10, 2)
    assert_eq(r.bytes, 2)
    assert(!r.closed)
    assert_eq(sink.closed_reason, "")
}

// ---- OSC 52 -------------------------------------------------------------------------

test "osc 52: a clipboard write is decoded and copied as plain text" {
    mut clip := FakeClipboard{ text: "", clear_after_ms: 99, copies: 0, held: ClipboardContent{ text: "", mime: "", image: "" } }
    r := try osc52_copy(mut clip, "c;aGVsbG8gd29ybGQ=")
    assert_eq(r.outcome, "copied")
    assert_eq(r.bytes, 11)
    assert_eq(clip.text, "hello world")
    assert_eq(clip.clear_after_ms, 0)
    assert_eq(clip.copies, 1)
}

test "osc 52: an empty selection list means the clipboard, utf-8 survives" {
    mut clip := FakeClipboard{ text: "", clear_after_ms: 0, copies: 0, held: ClipboardContent{ text: "", mime: "", image: "" } }
    // "héllo ✓" in base64
    r := try osc52_copy(mut clip, ";aMOpbGxvIOKckw==")
    assert_eq(r.outcome, "copied")
    assert_eq(clip.text, "héllo ✓")
}

test "osc 52: tmux's 'pc' list copies, primary only is ignored" {
    mut clip := FakeClipboard{ text: "", clear_after_ms: 0, copies: 0, held: ClipboardContent{ text: "", mime: "", image: "" } }
    a := try osc52_copy(mut clip, "pc;YQ==")
    assert_eq(a.outcome, "copied")
    b := try osc52_copy(mut clip, "p;Yg==")
    assert_eq(b.outcome, "ignored")
    assert_eq(clip.text, "a")
    assert_eq(clip.copies, 1)
}

test "osc 52: a clipboard query is ignored, never answered" {
    mut clip := FakeClipboard{ text: "", clear_after_ms: 0, copies: 0, held: ClipboardContent{ text: "", mime: "", image: "" } }
    r := try osc52_copy(mut clip, "c;?")
    assert_eq(r.outcome, "ignored")
    assert_eq(clip.copies, 0)
}

test "osc 52: bad input is refused with a stable code" {
    mut got_code := "ok"
    mut clip := FakeClipboard{ text: "", clear_after_ms: 0, copies: 0, held: ClipboardContent{ text: "", mime: "", image: "" } }
    got_code = "ok"
    osc52_copy(mut clip, "no-separator") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "invalid")
    got_code = "ok"
    osc52_copy(mut clip, "c;!!!not base64!!!") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "invalid")
    assert_eq(clip.copies, 0)
}
