package application

import "core:json"
import "../domain"

PKG_HOME: str = "/home/ana"
LIB: str = "/usr/lib/flint"

fn pkg_paths() -> domain.UpdatePaths {
    return domain.update_package_paths(PKG_HOME, domain.PACKAGE_DEB, LIB)
}

fn deb_manifest_json(version: str, sha: str) -> str {
    base := "https://github.com/samaniegoluis/flint/releases/download/v{version}/"
    m := domain.UpdateManifest{
        version: version, date: "2026-11-21", summary: "New things.",
        page: "https://github.com/samaniegoluis/flint/releases/tag/v{version}",
        assets: [domain.UpdateAsset{ key: domain.UPDATE_ASSET_DEB, name: "flint_{version}_amd64.deb", url: base + "flint_{version}_amd64.deb", size: 5000, sha256: sha }],
    }
    return json.stringify(m)
}

fn deb_offer(version: str) -> domain.UpdateStatus {
    mut s := domain.update_status_idle("0.20.0", true, 1)
    s.state = domain.UPDATE_AVAILABLE
    s.version = version
    s.action = domain.UPDATE_ACTION_DOWNLOAD
    return s
}

fn deb_src() -> UpdateSource {
    return UpdateSource{ manifest_url: UPDATE_TEST_URL, public_key: update_key(7) }
}

type FakeProbe struct {
    text: str
}

fn (self: FakeProbe) package_source_text(_format: str) -> str {
    return self.text
}

test "a package's source is asked of its package manager" {
    file := FakeProbe{ text: "flint:\n Version table:\n *** 0.20.0 100\n        100 /var/lib/dpkg/status\n" }
    assert_eq(package_source(file, "package:deb"), domain.INSTALL_FROM_FILE)
    repo := FakeProbe{ text: "From repository : flint-stable\n" }
    assert_eq(package_source(repo, "package:rpm"), domain.INSTALL_FROM_REPOSITORY)
    assert_eq(package_source(repo, domain.INSTALL_PORTABLE), "")
}

test "a package download stages the package with the manifest root verifies" {
    body := deb_manifest_json("0.21.0", "d".repeat(64))
    feed := signed_feed(body, 7)
    mut files := fake_files([])
    mut dl := FakeDownloader{ fail: "", urls: [] }
    try download_package_update(feed, FakeUpdateVerifier{}, mut dl, FakeHasher{ sha: "d".repeat(64) }, mut files, deb_src(), deb_offer("0.21.0"), "package:deb", pkg_paths())
    assert(dl.urls[0].ends_with("flint_0.21.0_amd64.deb"))
    // The manifest's exact bytes and its signature, beside the package.
    assert_eq(try files.upd_read(PKG_HOME + "/.cache/flint/update/manifest.json"), body)
    assert((try files.upd_read(PKG_HOME + "/.cache/flint/update/manifest.json.sig")).trim() == fake_sign(body, 7))
    // The fake download writes nothing: the package lands where the real one would.
    files.paths.push(pkg_paths().zip)
    assert_eq(staged_update_at(mut files, pkg_paths(), "0.20.0"), "0.21.0")
}

test "a package download whose SHA-256 or manifest is wrong leaves nothing" {
    body := deb_manifest_json("0.21.0", "d".repeat(64))
    mut files := fake_files([])
    mut dl := FakeDownloader{ fail: "", urls: [] }
    mut r := ""
    download_package_update(signed_feed(body, 7), FakeUpdateVerifier{}, mut dl, FakeHasher{ sha: "e".repeat(64) }, mut files, deb_src(), deb_offer("0.21.0"), "package:deb", pkg_paths()) or err { r = "{err.message()}" }
    assert(r.contains("SHA-256"))
    assert(!files.upd_exists(PKG_HOME + "/.cache/flint/update"))
    // Signed by another key: nothing downloaded.
    r = ""
    download_package_update(signed_feed(body, 9), FakeUpdateVerifier{}, mut dl, FakeHasher{ sha: "d".repeat(64) }, mut files, deb_src(), deb_offer("0.21.0"), "package:deb", pkg_paths()) or err { r = "{err.message()}" }
    assert(r.starts_with("invalid:"))
    assert_eq(dl.urls.len(), 1)
    // A newer release than the one offered: check again first.
    r = ""
    download_package_update(signed_feed(deb_manifest_json("0.22.0", "d".repeat(64)), 7), FakeUpdateVerifier{}, mut dl, FakeHasher{ sha: "d".repeat(64) }, mut files, deb_src(), deb_offer("0.21.0"), "package:deb", pkg_paths()) or err { r = "{err.message()}" }
    assert(r.starts_with("conflict:"))
    // No .rpm in the release.
    r = ""
    download_package_update(signed_feed(body, 7), FakeUpdateVerifier{}, mut dl, FakeHasher{ sha: "d".repeat(64) }, mut files, deb_src(), deb_offer("0.21.0"), "package:rpm", domain.update_package_paths(PKG_HOME, domain.PACKAGE_RPM, LIB)) or err { r = "{err.message()}" }
    assert(r.starts_with("not_found:"))
    assert_eq(dl.urls.len(), 1)
}

type FakeRootRunner struct {
    run:  domain.RootRun
    fail: str
    runs: i64
}

fn (mut self: FakeRootRunner) run_root_helper(_helper: str) -> domain.RootRun! {
    self.runs += 1
    if self.fail.len() > 0 {
        return error(domain.coded(self.fail, "pkexec is not installed"))
    }
    return self.run
}

fn staged_package() -> FakeUpdateFiles {
    body := deb_manifest_json("0.21.0", "d".repeat(64))
    mut files := fake_files([LIB + "/Flint", LIB + "/flint"])
    mut dl := FakeDownloader{ fail: "", urls: [] }
    download_package_update(signed_feed(body, 7), FakeUpdateVerifier{}, mut dl, FakeHasher{ sha: "d".repeat(64) }, mut files, deb_src(), deb_offer("0.21.0"), "package:deb", pkg_paths()) or {}
    files.paths.push(pkg_paths().zip)
    return files
}

test "Relaunch: root installs, then the new CLI restarts Flint" {
    mut files := staged_package()
    mut procs := fake_procs()
    done := domain.RootOutcome{ installed: true, version: "0.21.0", code: "", message: "", discard: false }
    mut runner := FakeRootRunner{ run: domain.RootRun{ exit_code: 0, stdout: json.stringify(done) + "\n" }, fail: "", runs: 0 }
    r := relaunch_package_update(mut files, mut procs, mut runner, pkg_paths(), LIB + "/flint-update-root", "0.20.0", 42, "")
    assert(r.installed)
    assert_eq(procs.spawned.len(), 1)
    assert_eq(procs.spawned[0], "/usr/lib/flint/flint update-apply --wait 42 --start --to /usr/lib/flint --staging /home/ana/.cache/flint/update")
    // The package is gone, the staging stays for the new app's word.
    assert(!files.upd_exists(PKG_HOME + "/.cache/flint/update/package.deb"))
    assert(!files.upd_exists(PKG_HOME + "/.cache/flint/update/ready"))
    assert(files.upd_exists(PKG_HOME + "/.cache/flint/update"))
}

test "Relaunch: a dismissed password keeps the package, a failed check discards it" {
    mut files := staged_package()
    mut procs := fake_procs()
    mut runner := FakeRootRunner{ run: domain.RootRun{ exit_code: 126, stdout: "" }, fail: "", runs: 0 }
    r := relaunch_package_update(mut files, mut procs, mut runner, pkg_paths(), LIB + "/flint-update-root", "0.20.0", 42, "")
    assert(!r.installed && !r.discard)
    assert(r.message.contains("password"))
    assert_eq(procs.spawned.len(), 0)
    assert_eq(staged_update_at(mut files, pkg_paths(), "0.20.0"), "0.21.0")

    refused := domain.RootOutcome{ installed: false, version: "0.21.0", code: domain.ERR_INVALID, message: "the package did not match the release's SHA-256", discard: true }
    runner.run = domain.RootRun{ exit_code: 3, stdout: json.stringify(refused) }
    d := relaunch_package_update(mut files, mut procs, mut runner, pkg_paths(), LIB + "/flint-update-root", "0.20.0", 42, "")
    assert(d.discard)
    assert(d.message.contains("SHA-256"))
    assert(!files.upd_exists(PKG_HOME + "/.cache/flint/update"))
    assert_eq(procs.spawned.len(), 0)

    // Nothing staged now: pkexec is not even asked.
    n := relaunch_package_update(mut files, mut procs, mut runner, pkg_paths(), LIB + "/flint-update-root", "0.20.0", 42, "")
    assert_eq(n.code, domain.ERR_NOT_FOUND)
    assert_eq(runner.runs, 2)
}

test "Relaunch: apt failing keeps the package for another try" {
    mut files := staged_package()
    mut procs := fake_procs()
    busy := domain.RootOutcome{ installed: false, version: "0.21.0", code: domain.ERR_IO, message: "apt-get could not install it: Could not get lock /var/lib/dpkg/lock-frontend", discard: false }
    mut runner := FakeRootRunner{ run: domain.RootRun{ exit_code: 4, stdout: json.stringify(busy) }, fail: "", runs: 0 }
    r := relaunch_package_update(mut files, mut procs, mut runner, pkg_paths(), LIB + "/flint-update-root", "0.20.0", 42, "")
    assert(!r.installed && !r.discard)
    assert(r.message.contains("lock"))
    assert_eq(staged_update_at(mut files, pkg_paths(), "0.20.0"), "0.21.0")
}

fn start_request() -> domain.ApplyRequest {
    return domain.ApplyRequest{ wait_pid: 42, from: "", to: LIB, os: "linux", app_log: "", start_only: true, staging: PKG_HOME + "/.cache/flint/update" }
}

test "update-apply --start waits for the old app and starts the new one" {
    mut files := fake_files([LIB + "/Flint", PKG_HOME + "/.cache/flint/update"])
    mut procs := fake_procs()
    o := apply_package_start(mut files, mut procs, start_request())
    assert(o.applied)
    assert_eq(procs.spawned[0], "/usr/lib/flint/Flint")
    assert(procs.polls >= 2)
    assert(!files.upd_exists(PKG_HOME + "/.cache/flint/update"))
}

test "update-apply --start says at the next launch that the new app did not start" {
    mut files := fake_files([LIB + "/Flint", PKG_HOME + "/.cache/flint/update"])
    files.new_app_starts = false
    mut procs := fake_procs()
    procs.child_dies = true
    o := apply_package_start(mut files, mut procs, start_request())
    assert(!o.applied)
    assert_eq(o.step, domain.APPLY_STEP_PACKAGE_START)
    assert(o.message.contains("quit as soon as"))
    assert(files.upd_exists(PKG_HOME + "/.cache/flint/update/outcome.json"))
    assert(domain.apply_outcome_text(o).contains("was installed"))
    // Nothing to put back: no rename was ever made.
    assert_eq(files.log.len(), 0)
    // --start never takes --from.
    mut bad := start_request()
    bad.from = "/tmp/x"
    assert_eq(apply_package_start(mut files, mut procs, bad).step, domain.APPLY_STEP_ARGS)
}

// ---- flint-update-root -------------------------------------------------------------

// The caller's staging and root's copies: `staged` holds name=content for what the
// caller left; a copy records its content at the moment it was copied, so a file the
// caller changes afterwards (`swap_after_copy`) never reaches what root verifies.
type FakeRootStage struct {
    staged:          []str
    copies:          []str
    refuse:          str
    swap_after_copy: str
    done:            bool
}

fn root_stage(manifest: str, sig: str, pkg: str) -> FakeRootStage {
    return FakeRootStage{ staged: ["manifest.json=" + manifest, "manifest.json.sig=" + sig, "package.deb=" + pkg], copies: [], refuse: "", swap_after_copy: "", done: false }
}

fn (mut self: FakeRootStage) stage_copy(_uid: i64, name: str, max_bytes: i64) -> str! {
    if name == self.refuse {
        return error(domain.coded(domain.ERR_INVALID, "{name} is a link"))
    }
    for i, x in self.staged {
        if x.starts_with(name + "=") {
            content := "{x[name.len() + 1..]}"
            if i64(content.len()) > max_bytes {
                return error(domain.coded(domain.ERR_INVALID, "{name} is too large"))
            }
            path := "/var/tmp/root/" + name
            self.copies.push(path + "=" + content)
            if name == self.swap_after_copy {
                self.staged[i] = name + "=EVIL"
            }
            return path
        }
    }
    return error(domain.coded(domain.ERR_NOT_FOUND, "no {name}"))
}

fn (self: FakeRootStage) copy_of(path: str) -> str {
    for x in self.copies {
        if x.starts_with(path + "=") {
            return "{x[path.len() + 1..]}"
        }
    }
    return ""
}

fn (self: FakeRootStage) stage_read(path: str, _max_bytes: i64) -> []byte! {
    mut out: []byte = []
    for b in self.copy_of(path).bytes() {
        out.push(b)
    }
    return out
}

fn (self: FakeRootStage) stage_size(path: str) -> i64! {
    return i64(self.copy_of(path).len())
}

fn (mut self: FakeRootStage) stage_done() {
    self.done = true
}

type FakeInstaller struct {
    installed: []str
    fail:      str
}

fn (mut self: FakeInstaller) pkg_install(format: str, path: str) -> void! {
    if self.fail.len() > 0 {
        return error(domain.coded(domain.ERR_IO, self.fail))
    }
    self.installed.push(format + " " + path)
}

// The SHA-256 the hasher gives root's copy of the package.
type ContentHasher struct {
    good: str
}

fn (self: ContentHasher) update_file_sha256(_path: str) -> str! {
    return self.good
}

fn root_req(installed: str) -> RootUpdateRequest {
    return RootUpdateRequest{ uid: 1000, format: domain.PACKAGE_DEB, installed: installed, public_key: update_key(7), download_prefix: domain.UPDATE_DOWNLOAD_PREFIX }
}

fn pkg_content() -> str {
    return "P".repeat(5000)
}

test "root installs a package that passes its own checks" {
    body := deb_manifest_json("0.21.0", "d".repeat(64))
    mut stage := root_stage(body, fake_sign(body, 7), pkg_content())
    mut inst := FakeInstaller{ installed: [], fail: "" }
    o := root_install_update(mut stage, FakeUpdateVerifier{}, ContentHasher{ good: "d".repeat(64) }, mut inst, root_req("0.20.0"))
    assert(o.installed)
    assert_eq(o.version, "0.21.0")
    assert_eq(inst.installed[0], "deb /var/tmp/root/package.deb")
    assert(stage.done)
}

fn refused_by_root(mut stage: FakeRootStage, sha: str, installed: str) -> domain.RootOutcome {
    mut inst := FakeInstaller{ installed: [], fail: "" }
    o := root_install_update(mut stage, FakeUpdateVerifier{}, ContentHasher{ good: sha }, mut inst, root_req(installed))
    assert_eq(inst.installed.len(), 0)
    assert(stage.done)
    return o
}

test "root refuses what fails its checks, and installs nothing" {
    body := deb_manifest_json("0.21.0", "d".repeat(64))
    // A package that is not the release's.
    mut s1 := root_stage(body, fake_sign(body, 7), pkg_content())
    o1 := refused_by_root(mut s1, "e".repeat(64), "0.20.0")
    assert(o1.discard && o1.message.contains("SHA-256"))
    // Signed by another key.
    mut s2 := root_stage(body, fake_sign(body, 9), pkg_content())
    o2 := refused_by_root(mut s2, "d".repeat(64), "0.20.0")
    assert(o2.discard && o2.code == domain.ERR_INVALID)
    // A manifest changed after it was signed.
    mut s3 := root_stage(body + " ", fake_sign(body, 7), pkg_content())
    assert(refused_by_root(mut s3, "d".repeat(64), "0.20.0").discard)
    // Not newer than what is installed: no downgrade, no reinstall.
    mut s4 := root_stage(body, fake_sign(body, 7), pkg_content())
    assert(refused_by_root(mut s4, "d".repeat(64), "0.21.0").message.contains("not newer"))
    // A package of another size.
    mut s5 := root_stage(body, fake_sign(body, 7), "P".repeat(4999))
    assert(refused_by_root(mut s5, "d".repeat(64), "0.20.0").message.contains("size"))
    // A staged file that is a link, or larger than the manifest says.
    mut s6 := root_stage(body, fake_sign(body, 7), pkg_content())
    s6.refuse = "package.deb"
    assert(refused_by_root(mut s6, "d".repeat(64), "0.20.0").message.contains("link"))
    mut s7 := root_stage(body, fake_sign(body, 7), "P".repeat(6000))
    assert(refused_by_root(mut s7, "d".repeat(64), "0.20.0").message.contains("too large"))
}

test "root verifies its own copy: a file swapped after the copy changes nothing" {
    // The caller swaps the manifest right after root copied it: root reads its copy,
    // which still holds the signed bytes, so the check and the install stand on what
    // was verified. (A swap before the copy is a bad signature, above.)
    body := deb_manifest_json("0.21.0", "d".repeat(64))
    mut stage := root_stage(body, fake_sign(body, 7), pkg_content())
    stage.swap_after_copy = "manifest.json"
    mut inst := FakeInstaller{ installed: [], fail: "" }
    o := root_install_update(mut stage, FakeUpdateVerifier{}, ContentHasher{ good: "d".repeat(64) }, mut inst, root_req("0.20.0"))
    assert(o.installed)
    assert_eq(stage.copy_of("/var/tmp/root/manifest.json"), body)
}

test "root: nothing staged, a bad caller, apt failing" {
    mut empty := FakeRootStage{ staged: [], copies: [], refuse: "", swap_after_copy: "", done: false }
    mut inst := FakeInstaller{ installed: [], fail: "" }
    n := root_install_update(mut empty, FakeUpdateVerifier{}, ContentHasher{ good: "" }, mut inst, root_req("0.20.0"))
    assert_eq(n.code, domain.ERR_NOT_FOUND)
    assert(!n.discard)
    assert_eq(domain.root_exit_code(n), domain.ROOT_EXIT_NOTHING)

    mut nobody := root_req("0.20.0")
    nobody.uid = 0
    assert_eq(root_install_update(mut empty, FakeUpdateVerifier{}, ContentHasher{ good: "" }, mut inst, nobody).code, domain.ERR_USAGE)

    body := deb_manifest_json("0.21.0", "d".repeat(64))
    mut stage := root_stage(body, fake_sign(body, 7), pkg_content())
    mut busy := FakeInstaller{ installed: [], fail: "apt-get could not install it: dpkg is locked" }
    o := root_install_update(mut stage, FakeUpdateVerifier{}, ContentHasher{ good: "d".repeat(64) }, mut busy, root_req("0.20.0"))
    assert(!o.installed && !o.discard)
    assert_eq(domain.root_exit_code(o), domain.ROOT_EXIT_INSTALL)
    assert(stage.done)
}
