package application

import "../domain"

// ---- Token store ---------------------------------------------------------------

type FakeTokenStore struct {
    tokens:   []Token
    activity: []ActivityEntry
    next_id:  i64
    retention: i64
}

fn new_fake_token_store() -> FakeTokenStore {
    return FakeTokenStore{ tokens: [], activity: [], next_id: 1, retention: -1 }
}

fn (self: FakeTokenStore) tokens_all() -> []Token! {
    return self.tokens
}

fn (mut self: FakeTokenStore) token_put(t: Token) -> void! {
    for i, o in self.tokens {
        if o.id == t.id {
            self.tokens[i] = t
            return
        }
    }
    self.tokens.push(t)
}

fn (mut self: FakeTokenStore) activity_add(e: ActivityEntry, keep: ActivityKeep) -> void! {
    mut row := e
    row.id = self.next_id
    self.next_id = self.next_id + 1
    self.activity.push(row)
    _ := try self.activity_prune(keep)
}

// By age only: the size cap is the store's, tested with SQLCipher.
fn (mut self: FakeTokenStore) activity_prune(keep: ActivityKeep) -> i64! {
    mut kept: []ActivityEntry = []
    n := self.activity.len()
    for i, a in self.activity {
        if a.at >= keep.since_at || i == n - 1 {
            kept.push(a)
        }
    }
    removed := i64(n) - i64(kept.len())
    self.activity = kept
    return removed
}

fn (self: FakeTokenStore) activity_count_before(since_at: i64) -> i64! {
    mut c := i64(0)
    for a in self.activity {
        if a.at < since_at {
            c = c + 1
        }
    }
    return c
}

fn (self: FakeTokenStore) activity_retention() -> i64! {
    return self.retention
}

fn (mut self: FakeTokenStore) set_activity_retention(days: i64) -> void! {
    self.retention = days
}

fn (self: FakeTokenStore) activity_page(before_id: i64, limit: i64) -> []ActivityEntry! {
    mut page: []ActivityEntry = []
    n := self.activity.len()
    for k in 0..n {
        a := self.activity[n - 1 - k]
        if i64(page.len()) < limit && (before_id <= 0 || a.id < before_id) {
            page.push(a)
        }
    }
    return page
}

fn token_req(name: str, hosts: []str, read: bool, exec: bool, write: bool) -> TokenRequest {
    return TokenRequest{ name: name, scope: ScopeByName{ all: false, groups: [], hosts: hosts }, read: read, exec: exec, write: write, ttl: "1d" }
}

fn token_vault(mut store: FakeStore) -> void! {
    crypto := FakeCrypto{ derive_calls: 0 }
    s := try create_vault(crypto, mut store, new_fake_keychain(), new_fake_recents(), "/v/t.flint", "", "correct horse", false)
    _ := try add_group(crypto, mut store, "lab")
    mut p := host_patch("codebox", "10.0.0.5")
    p.group = "lab"
    p.set_group = true
    _ := try add_host(crypto, mut store, s, p)
}

test "a token is created once, stored hashed, and checked by its text" {
    mut refused := 0
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    try token_vault(mut store)
    mut tokens := new_fake_token_store()
    made := try create_token(crypto, store, mut tokens, token_req("nightly", ["codebox"], true, true, false), 1000)
    assert(made.secret.starts_with("flint_"))
    assert_eq(made.token.name, "nightly")
    assert_eq(made.token.hosts[0], "codebox")
    assert_eq(made.token.expires_at, 1000 + 86400)
    assert_eq(made.token.status, TOKEN_ACTIVE)
    // The store holds a hash, never the text or its secret.
    stored := tokens.tokens[0]
    assert(stored.hash.len() == 64)
    assert(!made.secret.contains(stored.hash))
    assert(!stored.hash.contains(split_token_text(made.secret).secret))

    t := try check_token(crypto, tokens, made.secret, 2000)
    assert_eq(t.id, made.token.id)
    // A changed secret, an unknown id, garbage: all denied.
    parts := split_token_text(made.secret)
    mut flipped := parts.secret.substr(1) + "0"
    if flipped == parts.secret {
        flipped = parts.secret.substr(1) + "1"
    }
    mut bad := ""
    check_token(crypto, tokens, token_text(parts.id, flipped), 2000) or err { bad = "{err.message()}" }
    assert_eq(error_code_of("{bad}"), ERR_DENIED)
    check_token(crypto, tokens, token_text("ffffffffffffffff", parts.secret), 2000) or { refused += 1 }
    assert_eq(refused, 1)
    mut junk := ""
    check_token(crypto, tokens, "hunter2", 2000) or err { junk = "{err.message()}" }
    assert_eq(error_code_of("{junk}"), ERR_DENIED)
    assert(!"{junk}".contains("hunter2"))
    // Expired.
    mut late := ""
    check_token(crypto, tokens, made.secret, 1000 + 86400) or err { late = "{err.message()}" }
    assert("{late}".contains("expired"))
}

test "a revoked token is refused and its name can be used again" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    try token_vault(mut store)
    mut tokens := new_fake_token_store()
    made := try create_token(crypto, store, mut tokens, token_req("ci", [], true, false, false), 1000)
    mut clash := ""
    create_token(crypto, store, mut tokens, token_req("CI", [], true, false, false), 1001) or err { clash = "{err.message()}" }
    assert_eq(error_code_of("{clash}"), ERR_CONFLICT)
    v := try revoke_token(store, mut tokens, "ci", 1100)
    assert_eq(v.status, TOKEN_REVOKED)
    assert_eq(v.revoked_at, 1100)
    again := try revoke_token(store, mut tokens, made.token.id, 1200)
    assert_eq(again.revoked_at, 1100)
    mut refused := ""
    check_token(crypto, tokens, made.secret, 1300) or err { refused = "{err.message()}" }
    assert("{refused}".contains("revoked"))
    // Still matched by its secret, so the log can name it.
    assert_eq((try match_token(crypto, tokens.tokens, made.secret)).name, "ci")
    _ := try create_token(crypto, store, mut tokens, token_req("ci", [], true, false, false), 1400)
    list := try list_tokens(store, tokens, 1500)
    assert_eq(list.len(), 2)
    assert_eq(list[0].status, TOKEN_REVOKED)
    assert_eq(list[1].status, TOKEN_ACTIVE)
    mut missing := ""
    revoke_token(store, mut tokens, "nope", 1500) or err { missing = "{err.message()}" }
    assert_eq(error_code_of("{missing}"), ERR_NOT_FOUND)
}

test "a token request says what it allows and where" {
    mut refused := 0
    mut store := new_fake_store()
    try token_vault(mut store)
    mut none_allowed := ""
    check_token_request(store, token_req("x", ["codebox"], false, false, false)) or err { none_allowed = "{err.message()}" }
    assert_eq(error_code_of("{none_allowed}"), ERR_USAGE)
    mut no_hosts := ""
    check_token_request(store, token_req("x", [], false, true, false)) or err { no_hosts = "{err.message()}" }
    assert_eq(error_code_of("{no_hosts}"), ERR_USAGE)
    // Reading alone needs no hosts: it is vault-wide.
    reader := try check_token_request(store, token_req("x", [], true, false, false))
    assert(reader.all)
    mut narrow_write := ""
    check_token_request(store, token_req("x", ["codebox"], true, false, true)) or err { narrow_write = "{err.message()}" }
    assert_eq(error_code_of("{narrow_write}"), ERR_INVALID)
    mut ghost := ""
    check_token_request(store, token_req("x", ["ghost"], false, true, false)) or err { ghost = "{err.message()}" }
    assert_eq(error_code_of("{ghost}"), ERR_NOT_FOUND)
    mut bad_ttl := token_req("x", ["codebox"], false, true, false)
    bad_ttl.ttl = "never"
    check_token_request(store, bad_ttl) or { refused += 1 }
    assert_eq(refused, 1)
    mut by_group := token_req("x", [], false, true, false)
    by_group.scope.groups = ["lab"]
    s := try check_token_request(store, by_group)
    assert_eq(s.groups.len(), 1)
}

fn day_entry(day: i64) -> ActivityEntry {
    return ActivityEntry{ id: 0, at: day * 86400, caller: "c", via: ACTIVITY_VIA_GRANT, token: "", action: ACCESS_EXEC, host: "h", command: "flint exec h -- true", outcome: ACTIVITY_ALLOWED, cut: 0 }
}

test "the activity log keeps 90 days by default and pages back" {
    mut tokens := new_fake_token_store()
    for day in [10, 50, 100, 120, 130] {
        try record_activity(mut tokens, day_entry(day), 130 * 86400)
    }
    page := try list_activity(tokens, 0, 2)
    assert_eq(page.len(), 2)
    assert_eq(page[0].at, 130 * 86400)
    rest := try list_activity(tokens, page[1].id, 10)
    // Day 10 was past 90 days when day 130 was written.
    assert_eq(rest.len(), 2)
    assert_eq(rest[1].at, 50 * 86400)
}

test "retention is set per vault, counted before and pruned at once" {
    mut refused := 0
    mut tokens := new_fake_token_store()
    tokens.retention = 0
    for day in [1, 200, 300, 395, 400] {
        try record_activity(mut tokens, day_entry(day), 400 * 86400)
    }
    assert_eq(try activity_retention_days(tokens), 0)
    now := 400 * 86400
    assert_eq(try retention_would_remove(tokens, 365, now), 1)
    assert_eq(try retention_would_remove(tokens, 30, now), 3)
    assert_eq(try retention_would_remove(tokens, 0, now), 0)
    retention_would_remove(tokens, 7, now) or { refused += 1 }
    assert_eq(refused, 1)
    assert_eq(try set_activity_retention_days(mut tokens, 30, now), 3)
    assert_eq(try activity_retention_days(tokens), 30)
    assert_eq((try list_activity(tokens, 0, 10)).len(), 2)
    // Days later, an unlock prunes what aged out meanwhile.
    assert_eq(try prune_activity(mut tokens, 426 * 86400), 1)
    set_activity_retention_days(mut tokens, 45, now) or { refused += 1 }
    assert_eq(refused, 2)
}
