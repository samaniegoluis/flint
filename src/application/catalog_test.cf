package application

import "../domain"
import "core:json"

fn host_patch(alias: str, hostname: str) -> HostPatch {
    mut p := empty_host_patch()
    p.alias = alias
    p.set_alias = true
    p.hostname = hostname
    p.set_hostname = true
    return p
}

// The error code in an error message caught with `or err`, or "ok" for none (the empty
// message a test keeps when the call succeeded).
fn err_code(msg: str) -> str {
    if msg.len() == 0 {
        return "ok"
    }
    return error_code_of(msg)
}

test "groups nest, list by path and refuse removal while in use" {
    mut got_code := "ok"
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    g := try add_group(crypto, mut store, "homelab/proxmox")
    assert_eq(g.path, "homelab/proxmox")
    got_code = "ok"
    add_group(crypto, mut store, "HomeLab/Proxmox") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "conflict")
    _ := try add_group(crypto, mut store, "homelab/nas")
    views := try list_groups(store)
    assert_eq(views.len(), 3)
    assert_eq(views[0].path, "homelab")
    assert_eq(views[0].subgroups, 2)
    assert_eq(views[1].path, "homelab/nas")

    mut p := host_patch("pve1", "10.0.0.2")
    p.group = "homelab/proxmox"
    p.set_group = true
    _ := try add_host(crypto, mut store, s, p)
    got_code = "ok"
    remove_group(mut store, "homelab/proxmox") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "conflict")
    got_code = "ok"
    remove_group(mut store, "homelab") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "conflict")
    _ := try remove_group(mut store, "homelab/nas")
    renamed := try rename_group(mut store, "homelab", "lab")
    assert_eq(renamed.path, "lab")
    assert_eq((try show_host(store, "pve1")).group, "lab/proxmox")
    got_code = "ok"
    remove_group(mut store, "nope") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "not_found")
}

test "hosts: add, edit, filter, references and removal" {
    mut got_code := "ok"
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)

    mut bastion := host_patch("bastion", "bastion.example.org")
    bastion.tags = ["edge", "prod", "edge"]
    bastion.set_tags = true
    b := try add_host(crypto, mut store, s, bastion)
    assert_eq(b.port, 22)
    assert_eq(b.tags.len(), 2)

    mut web := host_patch("web", "10.0.0.5")
    web.jump = "bastion"
    web.set_jump = true
    web.group = "prod/web"
    web.set_group = true
    web.password = "hunter2!"
    web.set_password = true
    w := try add_host(crypto, mut store, s, web)
    assert_eq(w.jump, "bastion")
    assert_eq(w.group, "prod/web")
    assert(w.has_password)

    // The password is sealed, not stored in clear.
    hosts := try store.hosts_all()
    for h in hosts {
        if h.alias == "web" {
            assert_eq(try open_secret(crypto, s, "hosts", h.id, "password", h.password), "hunter2!")
        }
    }

    got_code = "ok"
    add_host(crypto, mut store, s, host_patch("WEB", "x")) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "conflict")
    got_code = "ok"
    add_host(crypto, mut store, s, host_patch("bad alias", "x")) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "invalid")
    mut no_host := empty_host_patch()
    no_host.alias = "x"
    no_host.set_alias = true
    got_code = "ok"
    add_host(crypto, mut store, s, no_host) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "usage")
    mut bad_ref := host_patch("x", "x")
    bad_ref.credential = "nope"
    bad_ref.set_credential = true
    got_code = "ok"
    add_host(crypto, mut store, s, bad_ref) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "not_found")
    assert_eq((try list_hosts(store, "", "")).len(), 2, "a failed add must leave nothing behind")

    // Jump loops are refused.
    mut loop := empty_host_patch()
    loop.jump = "web"
    loop.set_jump = true
    got_code = "ok"
    edit_host(crypto, mut store, s, "bastion", loop) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "invalid")

    // Edit changes only what is given.
    mut e := empty_host_patch()
    e.port = 2222
    e.set_port = true
    e.password = ""
    e.set_password = true
    edited := try edit_host(crypto, mut store, s, "web", e)
    assert_eq(edited.port, 2222)
    assert_eq(edited.hostname, "10.0.0.5")
    assert(!edited.has_password)

    assert_eq((try list_hosts(store, "prod", "")).len(), 1)
    assert_eq((try list_hosts(store, "", "EDGE")).len(), 1)
    got_code = "ok"
    list_hosts(store, "nope", "") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "not_found")

    got_code = "ok"
    remove_host(mut store, "bastion") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "conflict")
    _ := try remove_host(mut store, "web")
    _ := try remove_host(mut store, "bastion")
    assert_eq((try list_hosts(store, "", "")).len(), 0)
}

test "keys are stored by content and refused while in use" {
    mut got_code := "ok"
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    ins := FakeInspector{ strict: true }
    k := try add_key(crypto, mut store, ins, s, "laptop", "PRIVATE laptop", "")
    assert_eq(k.fingerprint, "SHA256:fake")
    assert(!k.has_passphrase)
    got_code = "ok"
    add_key(crypto, mut store, ins, s, "LAPTOP", "PRIVATE x", "") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "conflict")
    got_code = "ok"
    add_key(crypto, mut store, ins, s, "enc", "PRIVATE ENCRYPTED", "") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "invalid")
    enc := try add_key(crypto, mut store, ins, s, "enc", "PRIVATE ENCRYPTED", "pp")
    assert(enc.has_passphrase)
    keys := try store.keys_all()
    assert_eq(try open_secret(crypto, s, "ssh_keys", keys[0].id, "private_key", keys[0].private_key), "PRIVATE laptop")

    mut p := host_patch("web", "10.0.0.5")
    p.key = "laptop"
    p.set_key = true
    _ := try add_host(crypto, mut store, s, p)
    got_code = "ok"
    remove_key(mut store, "laptop") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "conflict")
    renamed := try rename_key(mut store, "laptop", "work-laptop")
    assert_eq(renamed.name, "work-laptop")
    assert_eq((try show_host(store, "web")).key, "work-laptop")
    _ := try remove_key(mut store, "enc")
    assert_eq((try list_keys(store)).len(), 1)
}

test "credentials link a user, a password and a key" {
    mut got_code := "ok"
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    _ := try add_key(crypto, mut store, FakeInspector{ strict: true }, s, "deploy", "PRIVATE d", "")
    mut c := empty_cred_patch()
    c.name = "domain"
    c.set_name = true
    c.user = "CORP\\luis"
    c.set_user = true
    c.password = "p@ss"
    c.set_password = true
    c.key = "deploy"
    c.set_key = true
    v := try add_cred(crypto, mut store, s, c)
    assert(v.has_password)
    assert_eq(v.key, "deploy")
    got_code = "ok"
    add_cred(crypto, mut store, s, c) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "conflict")

    mut p := host_patch("dc1", "dc1.corp")
    p.credential = "domain"
    p.set_credential = true
    _ := try add_host(crypto, mut store, s, p)
    assert_eq((try show_host(store, "dc1")).credential, "domain")
    got_code = "ok"
    remove_cred(mut store, "domain") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "conflict")
    got_code = "ok"
    remove_key(mut store, "deploy") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "conflict")

    mut e := empty_cred_patch()
    e.name = "corp"
    e.set_name = true
    e.key = ""
    e.set_key = true
    edited := try edit_cred(crypto, mut store, s, "domain", e)
    assert_eq(edited.name, "corp")
    assert_eq(edited.key, "")
    assert(edited.has_password)
    assert_eq((try show_host(store, "dc1")).credential, "corp")
    assert_eq((try list_creds(store)).len(), 1)
}

test "the catalog view gathers every list and shows no secret" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    _ := try add_group(crypto, mut store, "homelab")
    mut p := empty_host_patch()
    p.alias = "web"
    p.set_alias = true
    p.hostname = "10.0.0.5"
    p.set_hostname = true
    p.group = "homelab"
    p.set_group = true
    p.password = "hunter2-marker"
    p.set_password = true
    _ := try add_host(crypto, mut store, s, p)
    view := try catalog_view(store)
    assert_eq(view.groups.len(), usize(1))
    assert_eq(view.hosts.len(), usize(1))
    assert(view.hosts[0].has_password)
    assert_eq(view.hosts[0].group, "homelab")
    assert(!json.stringify(view).contains("hunter2-marker"))
    close_vault(mut store)
}

test "RDP hosts: type, default port, fixed type, password-only logins, refused for SSH work" {
    mut got_code := "ok"
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    _ := try add_key(crypto, mut store, FakeInspector{ strict: true }, s, "deploy", "PRIVATE d", "")
    mut keyonly := empty_cred_patch()
    keyonly.name = "keyonly"
    keyonly.set_name = true
    keyonly.user = "u"
    keyonly.set_user = true
    keyonly.key = "deploy"
    keyonly.set_key = true
    _ := try add_cred(crypto, mut store, s, keyonly)
    mut withpw := keyonly
    withpw.name = "domain"
    withpw.set_key = false
    withpw.password = "p@ss"
    withpw.set_password = true
    _ := try add_cred(crypto, mut store, s, withpw)

    mut p := host_patch("win", "10.0.0.9")
    p.host_type = "rdp"
    p.set_host_type = true
    p.domain = "CORP"
    p.set_domain = true
    v := try add_host(crypto, mut store, s, p)
    assert_eq(v.host_type, "rdp")
    assert_eq(v.port, 3389)
    assert_eq(v.domain, "CORP")
    sv := try add_host(crypto, mut store, s, host_patch("web", "10.0.0.5"))
    assert_eq(sv.host_type, "ssh")
    assert_eq(sv.port, 22)

    // The type is chosen once.
    mut flip := empty_host_patch()
    flip.host_type = "ssh"
    flip.set_host_type = true
    got_code = "ok"
    edit_host(crypto, mut store, s, "win", flip) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "invalid")

    // A credential with only a key cannot log in to an RDP host.
    mut cred := empty_host_patch()
    cred.credential = "keyonly"
    cred.set_credential = true
    got_code = "ok"
    edit_host(crypto, mut store, s, "win", cred) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "invalid")
    cred.credential = "domain"
    assert_eq((try edit_host(crypto, mut store, s, "win", cred)).credential, "domain")

    // Work only SSH does is refused with its own code, before anything else runs.
    got_code = "ok"
    sudo_ask_for(store, "win", ["true"]) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "wrong_host_type")
    got_code = "ok"
    require_ssh_alias(store, "win", "a tunnel") or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "wrong_host_type")
    try require_ssh_alias(store, "web", "a tunnel")
    mut jump := empty_host_patch()
    jump.jump = "win"
    jump.set_jump = true
    got_code = "ok"
    edit_host(crypto, mut store, s, "web", jump) or err { got_code = error_code_of("{err.message()}") }
    assert_eq(got_code, "wrong_host_type")
}
