package application

import "../domain"

fn code_of_err(msg: str) -> str {
    return error_code_of(msg)
}

test "create, lock and unlock a vault through the keychain" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    kc := new_fake_keychain()
    recents := new_fake_recents()
    s := try create_vault(crypto, mut store, kc, recents, "/v/Home Lab.flint", "", "correct horse", true)
    assert_eq(s.name, "Home Lab")
    assert(s.cached)
    assert_eq((try list_recents(recents)).len(), 1)

    // Cached: unlock with no password.
    store.vault_detach()
    again := try unlock_vault(crypto, mut store, kc, recents, "/v/Home Lab.flint", "", true)
    assert(again.secrets_key == s.secrets_key)

    // Locked: no password is no longer enough.
    try lock_vault(mut store, kc, "/v/Home Lab.flint")
    locked := unlock_vault(crypto, mut store, kc, recents, "/v/Home Lab.flint", "", true)
    assert_eq(code_of_err("{locked.error().message()}"), "locked")

    wrong := unlock_vault(crypto, mut store, kc, recents, "/v/Home Lab.flint", "wrong horse", true)
    assert_eq(code_of_err("{wrong.error().message()}"), "wrong_password")

    back := try unlock_vault(crypto, mut store, kc, recents, "/v/Home Lab.flint", "correct horse", true)
    assert(back.cached, "a password unlock caches the key again")
    assert(back.secrets_key == s.secrets_key)
}

test "create validates its input" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    too_short := create_vault(crypto, mut store, new_fake_keychain(), new_fake_recents(), "/v/a.flint", "", "short", true)
    assert_eq(code_of_err("{too_short.error().message()}"), "invalid")
    rel := create_vault(crypto, mut store, new_fake_keychain(), new_fake_recents(), "a.flint", "", "correct horse", true)
    assert_eq(code_of_err("{rel.error().message()}"), "invalid")
}

test "a disabled keychain still unlocks with the password" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    mut kc := new_fake_keychain()
    kc.enabled = false
    recents := new_fake_recents()
    s := try create_vault(crypto, mut store, kc, recents, "/v/x.flint", "X", "correct horse", true)
    assert(!s.cached)
    store.vault_detach()
    locked := unlock_vault(crypto, mut store, kc, recents, "/v/x.flint", "", true)
    assert_eq(code_of_err("{locked.error().message()}"), "locked")
    _ := try unlock_vault(crypto, mut store, kc, recents, "/v/x.flint", "correct horse", true)
}

test "a stale cached key is dropped and reported as locked" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    kc := new_fake_keychain()
    recents := new_fake_recents()
    _ := try create_vault(crypto, mut store, kc, recents, "/v/x.flint", "X", "correct horse", true)
    salt := try store.vault_read_salt("/v/x.flint")
    try kc.keychain_save(vault_account(salt), crypto.random_bytes(32))
    store.vault_detach()
    stale := unlock_vault(crypto, mut store, kc, recents, "/v/x.flint", "", true)
    assert_eq(code_of_err("{stale.error().message()}"), "locked")
    assert_eq((try kc.keychain_load(vault_account(salt))).len(), 0)
}

test "recent vaults resolve by name, path or recency, and can be forgotten" {
    recents := new_fake_recents()
    try touch_recent(recents, RecentVault{ path: "/a/one.flint", name: "One", id: "" })
    try touch_recent(recents, RecentVault{ path: "/a/two.flint", name: "Two", id: "" })
    try touch_recent(recents, RecentVault{ path: "/a/one.flint", name: "One", id: "" })
    list := try list_recents(recents)
    assert_eq(list.len(), 2)
    assert_eq(list[0].name, "One")
    assert_eq((try resolve_vault(recents, "")).name, "One")
    assert_eq((try resolve_vault(recents, "two")).path, "/a/two.flint")
    assert_eq((try resolve_vault(recents, "/a/two.flint")).name, "Two")
    assert_eq((try resolve_vault(recents, "/b/new.flint")).name, "new")
    missing := resolve_vault(recents, "nope")
    assert_eq(code_of_err("{missing.error().message()}"), "not_found")
    mut store := new_fake_store()
    _ := try forget_recent(mut store, new_fake_keychain(), recents, "Two")
    assert_eq((try list_recents(recents)).len(), 1)
}

test "status reports counts only when the key is cached" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    kc := new_fake_keychain()
    recents := new_fake_recents()
    s := try create_vault(crypto, mut store, kc, recents, "/v/x.flint", "X", "correct horse", true)
    mut p := empty_host_patch()
    p.alias = "web"
    p.set_alias = true
    p.hostname = "10.0.0.1"
    p.set_hostname = true
    _ := try add_host(crypto, mut store, s, p)
    st := try vault_status(crypto, mut store, kc, recents, "/v/x.flint", "X")
    assert(st.cached)
    assert_eq(st.hosts, 1)
    try lock_vault(mut store, kc, "/v/x.flint")
    st2 := try vault_status(crypto, mut store, kc, recents, "/v/x.flint", "X")
    assert(!st2.cached)
    assert_eq(st2.hosts, 0)
    assert(st2.exists)
}

test "secrets are sealed with an AAD bound to row and field" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    sealed := try seal_secret(crypto, s, "hosts", "id1", "password", "hunter2!")
    assert(sealed.len() > 0)
    assert_eq(try open_secret(crypto, s, "hosts", "id1", "password", sealed), "hunter2!")
    assert(!open_secret(crypto, s, "hosts", "id2", "password", sealed).has_value())
    assert(!open_secret(crypto, s, "credentials", "id1", "password", sealed).has_value())
    assert_eq((try seal_secret(crypto, s, "hosts", "id1", "password", "")).len(), 0)
}

test "a vault has a stable id and a moved vault replaces its recent entry" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    kc := new_fake_keychain()
    recents := new_fake_recents()
    s := try create_vault(crypto, mut store, kc, recents, "/v/Lab.flint", "", "correct horse", true)
    assert(is_hex_id(s.id))
    assert_eq((try list_recents(recents))[0].id, s.id)
    store.vault_detach()
    again := try unlock_vault(crypto, mut store, kc, recents, "/v/Lab.flint", "", true)
    assert_eq(again.id, s.id)

    // Another vault, then the first one opened from its new place.
    try touch_recent(recents, RecentVault{ path: "/v/Other.flint", name: "Other", id: "" })
    try touch_recent(recents, RecentVault{ path: "/moved/Lab.flint", name: "Lab", id: s.id })
    list := try list_recents(recents)
    assert_eq(list.len(), usize(2))
    assert_eq(list[0].path, "/moved/Lab.flint")
    assert_eq(list[1].path, "/v/Other.flint")

    // `vault use` by path carries no id: the recorded one is kept.
    try touch_recent(recents, RecentVault{ path: "/moved/Lab.flint", name: "Lab", id: "" })
    assert_eq((try list_recents(recents))[0].id, s.id)
}

test "renaming a vault updates its meta and its recent entry in place" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    kc := new_fake_keychain()
    recents := new_fake_recents()
    s := try create_vault(crypto, mut store, kc, recents, "/v/Test.flint", "", "correct horse", true)
    try touch_recent(recents, RecentVault{ path: "/v/Work.flint", name: "Work", id: "" })

    renamed := try rename_vault(mut store, recents, s, "Home Lab")
    assert_eq(renamed.name, "Home Lab")
    assert_eq(try store.vault_get_meta("name"), "Home Lab")
    list := try list_recents(recents)
    assert_eq(list[0].path, "/v/Work.flint", "the entry keeps its place")
    assert_eq(list[1].name, "Home Lab")
    assert_eq(list[1].id, s.id)

    taken := rename_vault(mut store, recents, renamed, "work")
    assert_eq(code_of_err("{taken.error().message()}"), "conflict")
    empty := rename_vault(mut store, recents, renamed, "")
    assert_eq(code_of_err("{empty.error().message()}"), "invalid")
    // The same name in another case is a rename of itself, not a conflict.
    same := try rename_vault(mut store, recents, renamed, "home lab")
    assert_eq(same.name, "home lab")
}

test "the master password is checked against the key in memory" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := try create_vault(crypto, mut store, new_fake_keychain(), new_fake_recents(), "/v/p.flint", "", "correct horse", true)
    assert(try verify_master_password(crypto, store, s, "correct horse"))
    assert(!(try verify_master_password(crypto, store, s, "wrong horse")))
    assert(!(try verify_master_password(crypto, store, s, "")))
}

test "a key reaches the keychain only with Remember on this computer" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    kc := new_fake_keychain()
    recents := new_fake_recents()
    s := try create_vault(crypto, mut store, kc, recents, "/v/r.flint", "", "correct horse", false)
    assert(!s.cached, "created without Remember: nothing cached")
    store.vault_detach()
    locked := unlock_vault(crypto, mut store, kc, recents, "/v/r.flint", "", false)
    assert_eq(code_of_err("{locked.error().message()}"), "locked")

    plain := try unlock_vault(crypto, mut store, kc, recents, "/v/r.flint", "correct horse", false)
    assert(!plain.cached)
    store.vault_detach()
    assert(!unlock_vault(crypto, mut store, kc, recents, "/v/r.flint", "", false).has_value())

    kept := try unlock_vault(crypto, mut store, kc, recents, "/v/r.flint", "correct horse", true)
    assert(kept.cached, "ticked: the key is cached")
    store.vault_detach()
    // Without Remember, a password unlock leaves a remembered key where it is.
    _ := try unlock_vault(crypto, mut store, kc, recents, "/v/r.flint", "correct horse", false)
    store.vault_detach()
    again := try unlock_vault(crypto, mut store, kc, recents, "/v/r.flint", "", false)
    assert(again.cached)

    // Forgetting the key leaves the vault open.
    try forget_vault_key(store, kc, "/v/r.flint")
    assert(store.attached)
    store.vault_detach()
    assert(!unlock_vault(crypto, mut store, kc, recents, "/v/r.flint", "", false).has_value())
}

test "the keys earlier Flints cached are removed once per machine" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    kc := new_fake_keychain()
    recents := new_fake_recents()
    _ := try create_vault(crypto, mut store, kc, recents, "/v/a.flint", "", "correct horse", true)
    store.vault_detach()
    // A recent vault whose file is gone is skipped.
    try touch_recent(recents, RecentVault{ path: "/v/gone.flint", name: "gone", id: "" })
    mut settings := FakeSettingsStore{ saved: default_settings() }
    assert_eq(try forget_cached_keys_once(mut settings, store, kc, recents), i64(1))
    assert(settings.saved.keys_cleared)
    assert(!unlock_vault(crypto, mut store, kc, recents, "/v/a.flint", "", false).has_value())

    // Remembered after that: a later start leaves it alone.
    _ := try unlock_vault(crypto, mut store, kc, recents, "/v/a.flint", "correct horse", true)
    store.vault_detach()
    assert_eq(try forget_cached_keys_once(mut settings, store, kc, recents), i64(0))
    assert((try unlock_vault(crypto, mut store, kc, recents, "/v/a.flint", "", false)).cached)

    // The page cannot reset the record.
    mut page := default_settings()
    page.theme = "dark"
    saved := try save_settings(mut settings, page)
    assert(saved.keys_cleared)
}
