package application

// Import a Tether vault into the open Flint vault (milestone 08): a one-shot move for
// people leaving Tether, the Go client Flint replaces.
//
// The Tether file is read through the TetherSource port with every secret still
// sealed. The master password derives Tether's key (Argon2id, 4 lanes, D-034), its
// verifier says whether the password is right, and each secret is opened with
// libsodium (Crypto.unseal) only to be sealed again under the Flint vault's own key.
// No secret is returned: the report carries names and counts (Principle 6).
//
// Everything is written in one transaction. Running it again adds only what is not
// there yet: a group path, a key fingerprint, a credential name + user or a host
// (label, hostname, port, user) already in the vault is reused, not duplicated.

import "../domain"
import "../ports"

// Something carried over with a change, or not carried over at all.
type ImportNote struct {
    kind: str `json:"kind"`
    name: str `json:"name"`
    detail: str `json:"detail"`
}

type ImportCounts struct {
    groups: i64 `json:"groups"`
    hosts: i64 `json:"hosts"`
    keys: i64 `json:"keys"`
    credentials: i64 `json:"credentials"`
    known_hosts: i64 `json:"known_hosts"`
}

type TetherImportReport struct {
    file: str `json:"file"`
    format: i64 `json:"format"`
    dry_run: bool `json:"dry_run"`
    added: ImportCounts `json:"added"`
    already_present: ImportCounts `json:"already_present"`
    changed: []ImportNote `json:"changed"`
    not_imported: []ImportNote `json:"not_imported"`
}

fn zero_counts() -> ImportCounts {
    return ImportCounts{ groups: 0, hosts: 0, keys: 0, credentials: 0, known_hosts: 0 }
}

fn note(kind: str, name: str, detail: str) -> ImportNote {
    return ImportNote{ kind: kind, name: name, detail: detail }
}

// ---- Names ------------------------------------------------------------------------

// The ASCII letter a Latin-1 letter (the second byte of a UTF-8 0xC3 pair) reads as,
// lower case, or 0 when it has none.
fn latin1_ascii(b: u8) -> u8 {
    c := b | 32
    if c >= 160 && c <= 165 {
        return 97
    }
    if c == 167 {
        return 99
    }
    if c >= 168 && c <= 171 {
        return 101
    }
    if c >= 172 && c <= 175 {
        return 105
    }
    if c == 177 {
        return 110
    }
    if c >= 178 && c <= 182 {
        return 111
    }
    if c >= 185 && c <= 188 {
        return 117
    }
    if c == 189 || c == 191 {
        return 121
    }
    return 0
}

// A Flint name (alias, key or credential name, tag: [a-z0-9._-], 1-64, not starting
// with '-' or '.') from free text: lower case, accents dropped ("Ñandú" → "nandu"),
// anything else a single '-'. "" when nothing is left.
fn import_slug(text: str) -> str {
    mut s := ""
    mut dash := false
    bytes := text.bytes()
    mut i: usize = 0
    for i < bytes.len() {
        b := u8(bytes[i])
        mut c: u8 = 0
        if (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 46 || b == 95 {
            c = b
        } else if b >= 65 && b <= 90 {
            c = b + 32
        } else if b == 195 && i + 1 < bytes.len() {
            c = latin1_ascii(u8(bytes[i + 1]))
            i += 1
        } else if b >= 192 {
            // Another multi-byte character: skip its continuation bytes.
            for i + 1 < bytes.len() && (u8(bytes[i + 1]) & 192) == 128 {
                i += 1
            }
        }
        if c == 0 {
            dash = s.len() > 0
        } else {
            if dash {
                s = s + "-"
                dash = false
            }
            if s.len() < 64 {
                s = s + byte_to_str(c)
            }
        }
        i += 1
    }
    // No leading '.' (a hidden-file look); '-' cannot lead by construction.
    mut start: usize = 0
    sb := s.bytes()
    for start < sb.len() && u8(sb[start]) == 46 {
        start += 1
    }
    mut out_s := ""
    for j in start..sb.len() {
        if out_s.len() < 64 {
            out_s = out_s + byte_to_str(u8(sb[j]))
        }
    }
    // A cut at 64 may leave a trailing '-' or '.'.
    for out_s.len() > 0 && (out_s.ends_with("-") || out_s.ends_with(".")) {
        ob := out_s.bytes()
        mut trimmed := ""
        for k in 0..ob.len() - 1 {
            trimmed = trimmed + byte_to_str(u8(ob[k]))
        }
        out_s = trimmed
    }
    return out_s
}

// `base` with "-2", "-3"... appended until `taken` (lower case) does not hold it.
fn unique_name(base: str, taken: []str) -> str {
    mut candidate := base
    mut n := 2
    for name_taken(candidate, taken) {
        suffix := "-{n}"
        mut stem := base
        if stem.len() + suffix.len() > 64 {
            sb := base.bytes()
            mut cut := ""
            for k in 0..64 - suffix.len() {
                cut = cut + byte_to_str(u8(sb[k]))
            }
            stem = cut
        }
        candidate = stem + suffix
        n += 1
    }
    return candidate
}

fn name_taken(name: str, taken: []str) -> bool {
    lower := lower_ascii(name)
    for t in taken {
        if lower_ascii(t) == lower {
            return true
        }
    }
    return false
}

// A group name Flint accepts: no '/', no surrounding spaces, at most 64 bytes (cut on
// a character boundary).
fn import_group_name(name: str) -> str {
    mut s := ""
    for b in name.bytes() {
        c := u8(b)
        if c == 47 {
            s = s + "-"
        } else if c >= 32 && c != 127 {
            s = s + byte_to_str(c)
        }
    }
    s = str_trim_spaces(s)
    if s.len() > 64 {
        sb := s.bytes()
        mut end: usize = 64
        for end > 0 && (u8(sb[end]) & 192) == 128 {
            end -= 1
        }
        mut cut := ""
        for k in 0..end {
            cut = cut + byte_to_str(u8(sb[k]))
        }
        s = str_trim_spaces(cut)
    }
    if s.len() == 0 {
        return "group"
    }
    return s
}

// Free text cut to `max_len` bytes on a character boundary, with control bytes
// dropped (newlines and tabs kept when `multiline`).
fn import_text(value: str, max_len: usize, multiline: bool) -> str {
    mut s := ""
    for b in value.bytes() {
        c := u8(b)
        keep := c >= 32 && c != 127 || (multiline && (c == 10 || c == 9))
        if keep {
            s = s + byte_to_str(c)
        }
    }
    if s.len() <= max_len {
        return s
    }
    sb := s.bytes()
    mut end := max_len
    for end > 0 && (u8(sb[end]) & 192) == 128 {
        end -= 1
    }
    mut cut := ""
    for k in 0..end {
        cut = cut + byte_to_str(u8(sb[k]))
    }
    return cut
}

fn file_base_name(path: str) -> str {
    mut base := ""
    for b in path.bytes() {
        if u8(b) == 47 {
            base = ""
        } else {
            base = base + byte_to_str(u8(b))
        }
    }
    return base
}

// ---- Secrets ----------------------------------------------------------------------

// Opens one Tether secret column ("" stays ""). Tether seals with no AAD.
// open_tether_secret for a caller that goes on either way: the secret lands in
// `plain`; false when it would not open.
fn open_tether_secret_into[C: Crypto](crypto: C, key: []byte, enc: str, mut plain: str) -> bool {
    plain = open_tether_secret(crypto, key, enc) or {
        return false
    }
    return true
}

fn open_tether_secret[C: Crypto](crypto: C, key: []byte, enc: str) -> str! {
    if enc.len() == 0 {
        return ""
    }
    sealed := try tether_b64(enc)
    plain := crypto.unseal(key, sealed, []) or err {
        return error(coded(ERR_INVALID, "a Tether secret failed to open"))
    }
    return bytes_to_str(plain)
}

// Tether's key for `password`, checked against the vault's verifier.
fn tether_key[C: Crypto, T: TetherSource](crypto: C, src: T, f: TetherFile, password: str) -> []byte! {
    salt := try tether_b64(f.salt_b64)
    key := try src.tether_derive_key(password, salt)
    check := open_tether_secret(crypto, key, f.verifier_enc) or err {
        return error(coded(ERR_WRONG_PASSWORD, "the Tether master password is wrong"))
    }
    if check != TETHER_VERIFIER {
        return error(coded(ERR_WRONG_PASSWORD, "the Tether master password is wrong"))
    }
    return key
}

// ---- The import -------------------------------------------------------------------

fn tether_group_path(groups: []TetherGroup, id: str) -> str {
    mut path := ""
    mut cur := id
    mut depth := 0
    for cur.len() > 0 && depth < 64 {
        mut found := false
        for g in groups {
            if g.id == cur {
                seg := import_group_name(g.name)
                if path.len() == 0 {
                    path = seg
                } else {
                    path = seg + "/" + path
                }
                cur = g.parent_id
                found = true
                break
            }
        }
        if !found {
            break
        }
        depth += 1
    }
    return path
}

fn tether_host_name(h: TetherHost) -> str {
    if h.label.len() > 0 {
        return h.label
    }
    return h.hostname
}

fn import_tether[C: Crypto, S: VaultStore, I: KeyInspector, T: TetherSource](crypto: C, mut store: S, inspector: I, src: T, session: VaultSession, path: str, password: str, dry_run: bool) -> TetherImportReport! {
    f := try src.tether_read(path)
    key := try tether_key(crypto, src, f, password)
    try store.vault_begin()
    report := import_tether_rows(crypto, mut store, inspector, src, session, f, key, path, dry_run) or err {
        store.vault_rollback()
        return error("{err.message()}")
    }
    if dry_run {
        store.vault_rollback()
    } else {
        try store.vault_commit()
    }
    return report
}

fn import_tether_rows[C: Crypto, S: VaultStore, I: KeyInspector, T: TetherSource](crypto: C, mut store: S, inspector: I, src: T, session: VaultSession, f: TetherFile, key: []byte, path: str, dry_run: bool) -> TetherImportReport! {
    mut r := TetherImportReport{ file: path, format: f.format, dry_run: dry_run, added: zero_counts(), already_present: zero_counts(), changed: [], not_imported: [] }

    // Groups: Tether id → Flint group id, merged by path.
    mut group_ids: map[str]str = {}
    groups_before := i64((try store.groups_all()).len())
    for g in f.groups {
        gpath := tether_group_path(f.groups, g.id)
        if import_group_name(g.name) != g.name {
            r.changed.push(note("group", g.name, "renamed '{import_group_name(g.name)}' (a Flint group name has no '/' and at most 64 characters)"))
        }
        if split_group_path(gpath).len() > 16 {
            r.not_imported.push(note("group", gpath, "nested deeper than Flint's 16 levels; its hosts are imported without a group"))
            continue
        }
        group_ids[g.id] = try ensure_group_path(crypto, mut store, gpath)
    }
    // A child listed before its parent creates both, so count rows, not calls.
    r.added.groups = i64((try store.groups_all()).len()) - groups_before
    r.already_present.groups = i64(f.groups.len()) - r.added.groups
    if r.already_present.groups < 0 {
        r.already_present.groups = 0
    }

    // Stored keys: Tether id → Flint key id, reused by fingerprint.
    mut key_ids: map[str]str = {}
    mut keys := try store.keys_all()
    for k in f.keys {
        priv_r := open_tether_secret(crypto, key, k.private_key_enc) or err {
            r.not_imported.push(note("key", k.name, "its private key could not be decrypted"))
            continue
        }
        priv := priv_r
        pass_r := open_tether_secret(crypto, key, k.passphrase_enc) or err {
            r.not_imported.push(note("key", k.name, "its passphrase could not be decrypted"))
            continue
        }
        pass := pass_r
        info_r := inspector.inspect_private_key(priv, pass) or err {
            r.not_imported.push(note("key", k.name, "Flint cannot read this private key"))
            continue
        }
        info := info_r
        existing := key_by_fingerprint(keys, info.fingerprint)
        if existing.len() > 0 {
            key_ids[k.id] = existing
            r.already_present.keys += 1
            continue
        }
        kid := try put_imported_key(crypto, mut store, session, mut keys, mut r, k.name, priv, pass, info)
        key_ids[k.id] = kid
    }

    // Credentials: reused by name and user.
    mut cred_ids: map[str]str = {}
    mut creds := try store.creds_all()
    for c in f.creds {
        mut reuse := ""
        for e in creds {
            if lower_ascii(e.name) == lower_ascii(import_slug(c.name)) && e.username == c.username {
                reuse = e.id
            }
        }
        if reuse.len() > 0 {
            cred_ids[c.id] = reuse
            r.already_present.credentials += 1
            continue
        }
        pw_r := open_tether_secret(crypto, key, c.password_enc) or err {
            r.not_imported.push(note("credential", c.name, "its password could not be decrypted"))
            continue
        }
        pw := pw_r
        mut cname := import_slug(c.name)
        if cname.len() == 0 {
            cname = "credential"
        }
        cname = unique_name(cname, cred_names(creds))
        if cname != c.name {
            r.changed.push(note("credential", c.name, "named '{cname}'"))
        }
        id := new_row_id(crypto)
        mut cred := Credential{ id: id, name: cname, username: import_text(c.username, 128, false), key_id: "", password: [] }
        if c.auth_type == "key" && key_ids.contains(c.key_id) {
            cred.key_id = key_ids[c.key_id]
        }
        if c.auth_type == "password" && pw.len() > 0 {
            cred.password = try seal_secret(crypto, session, "credentials", id, "password", pw)
        }
        try store.cred_put(cred)
        creds.push(cred)
        cred_ids[c.id] = id
        r.added.credentials += 1
    }

    // Key files that hosts point to: read once each, stored by content.
    mut file_key_ids: map[str]str = {}
    for h in f.hosts {
        if h.key_path.len() == 0 || file_key_ids.contains(h.key_path) {
            continue
        }
        if h.auth_type != "key" || h.key_id.len() > 0 || h.credential_id.len() > 0 {
            continue
        }
        file_key_ids[h.key_path] = ""
        text_r := src.tether_read_key_file(h.key_path) or err {
            why := error_text_of("{err.message()}")
            r.not_imported.push(note("key file", h.key_path, "cannot be read ({why}); add it with `flint key add` and set it on the host"))
            continue
        }
        text := text_r
        info_r := inspector.inspect_private_key(text, "") or err {
            r.not_imported.push(note("key file", h.key_path, "is passphrase-protected or not a key Flint reads; add it with `flint key add` and set it on the host"))
            continue
        }
        info := info_r
        existing := key_by_fingerprint(keys, info.fingerprint)
        if existing.len() > 0 {
            file_key_ids[h.key_path] = existing
            r.already_present.keys += 1
            continue
        }
        file_key_ids[h.key_path] = try put_imported_key(crypto, mut store, session, mut keys, mut r, file_base_name(h.key_path), text, "", info)
    }

    // Hosts, first without jump hosts (they may point forward).
    mut hosts := try store.hosts_all()
    mut host_ids: map[str]str = {}
    mut new_hosts: []str = []
    for th in f.hosts {
        name := tether_host_name(th)
        // A host linked to a credential takes its login from it, as in Tether.
        linked := th.credential_id.len() > 0 && cred_ids.contains(th.credential_id)
        mut user := th.username
        if linked {
            user = ""
        }
        dup := find_same_host(hosts, th.label, th.hostname, th.port, user)
        if dup.len() > 0 {
            host_ids[th.id] = dup
            r.already_present.hosts += 1
            continue
        }
        mut base := import_slug(th.label)
        if base.len() == 0 {
            base = import_slug(th.hostname)
        }
        if base.len() == 0 {
            base = "host"
        }
        alias := unique_name(base, host_aliases(hosts))
        if alias != base {
            r.changed.push(note("host", name, "alias '{alias}' ('{base}' is taken)"))
        }
        id := new_row_id(crypto)
        mut h := Host{ id: id, alias: alias, label: import_text(th.label, 128, false), hostname: th.hostname, port: th.port, username: import_text(user, 128, false), group_id: "", tags: [], color: "", notes: import_text(th.notes, 8192, true), jump_host_id: "", credential_id: "", key_id: "", password: [], initial_command: th.initial_command, keep_shell: false, sudo_password: [] }
        if th.notes.len() > 8192 {
            r.changed.push(note("host", alias, "notes cut to 8192 characters"))
        }
        if th.group_id.len() > 0 && group_ids.contains(th.group_id) {
            h.group_id = group_ids[th.group_id]
        }
        mut tags: []str = []
        for t in th.tags {
            slug := import_slug(t)
            if slug.len() == 0 {
                r.changed.push(note("host", alias, "tag '{t}' dropped"))
            } else {
                if slug != t {
                    r.changed.push(note("host", alias, "tag '{t}' is now '{slug}'"))
                }
                tags.push(slug)
            }
        }
        h.tags = dedup_tags(tags)
        if th.color.len() > 0 {
            if color_valid(th.color) {
                h.color = th.color
            } else {
                r.changed.push(note("host", alias, "colour '{th.color}' dropped (Flint keeps '#rrggbb' colours)"))
            }
        }
        if linked {
            h.credential_id = cred_ids[th.credential_id]
        } else {
            if th.credential_id.len() > 0 {
                r.changed.push(note("host", alias, "its credential was not imported; it logs in with its own settings"))
            }
            if th.auth_type == "key" {
                if th.key_id.len() > 0 && key_ids.contains(th.key_id) {
                    h.key_id = key_ids[th.key_id]
                } else if th.key_path.len() > 0 && file_key_ids.contains(th.key_path) && file_key_ids[th.key_path].len() > 0 {
                    h.key_id = file_key_ids[th.key_path]
                } else {
                    r.changed.push(note("host", alias, "its key was not imported; Flint tries the SSH agent and asks for a password"))
                }
            }
            if th.auth_type == "password" && th.password_enc.len() > 0 {
                mut pw := ""
                if open_tether_secret_into(crypto, key, th.password_enc, mut pw) {
                    h.password = try seal_secret(crypto, session, "hosts", id, "password", pw)
                } else {
                    r.changed.push(note("host", alias, "its saved password could not be decrypted; Flint will ask for it"))
                }
            }
        }
        check_host(h) or err {
            r.not_imported.push(note("host", name, error_text_of("{err.message()}")))
            continue
        }
        try store.host_put(h)
        hosts.push(h)
        host_ids[th.id] = id
        new_hosts.push(id)
        r.added.hosts += 1
    }

    // Jump hosts, now that every host has its Flint id.
    for th in f.hosts {
        if th.jump_host_id.len() == 0 || !host_ids.contains(th.id) {
            continue
        }
        id := host_ids[th.id]
        if !id_in(new_hosts, id) {
            continue
        }
        idx := host_index_by_id(hosts, id)
        mut h := hosts[usize(idx)]
        if !host_ids.contains(th.jump_host_id) {
            r.changed.push(note("host", h.alias, "its jump host was not imported; it connects directly"))
            continue
        }
        target := host_ids[th.jump_host_id]
        if target == id || jump_chain_reaches(hosts, target, id) {
            r.changed.push(note("host", h.alias, "its jump host would make a loop; it connects directly"))
            continue
        }
        h.jump_host_id = target
        try store.host_put(h)
        hosts[usize(idx)] = h
    }

    // Known host keys: Flint keeps one per address, the most recent Tether one.
    mut known := try store.known_hosts_all()
    mut seen: []str = []
    mut i := i64(f.known_hosts.len()) - 1
    for i >= 0 {
        k := f.known_hosts[usize(i)]
        i -= 1
        addr := tether_addr_to_flint(k.addr)
        if addr.len() == 0 {
            r.not_imported.push(note("known host", k.addr, "is not an address Flint reads"))
            continue
        }
        if id_in(seen, addr) {
            r.changed.push(note("known host", addr, "Tether had another key type for it; Flint keeps the most recent"))
            continue
        }
        seen.push(addr)
        mut have := false
        for e in known {
            if e.addr == addr {
                have = true
                if e.key_type == k.key_type && e.fingerprint == k.fingerprint {
                    r.already_present.known_hosts += 1
                } else {
                    r.not_imported.push(note("known host", addr, "this vault already trusts another key for it; Flint's is kept"))
                }
            }
        }
        if have {
            continue
        }
        mut owner := ""
        if k.host_id.len() > 0 && host_ids.contains(k.host_id) {
            owner = host_ids[k.host_id]
        } else {
            for h in hosts {
                if known_host_addr(h.hostname, h.port) == addr {
                    owner = h.id
                }
            }
        }
        kh := KnownHost{ addr: addr, key_type: k.key_type, fingerprint: k.fingerprint, host_id: owner, added_at: k.created_at }
        try store.known_host_put(kh)
        known.push(kh)
        r.added.known_hosts += 1
    }

    // Tunnels: Flint has none yet (roadmap).
    for t in f.tunnels {
        mut owner := t.host_id
        for th in f.hosts {
            if th.id == t.host_id {
                owner = tether_host_name(th)
            }
        }
        r.not_imported.push(note("tunnel", "{owner}: {t.name}", "localhost:{t.local_port} → {t.remote_host}:{t.remote_port}; Tether's tunnels are not imported: add it with `flint tunnel add`"))
    }
    return r
}

fn put_imported_key[C: Crypto, S: VaultStore](crypto: C, mut store: S, session: VaultSession, mut keys: []SshKey, mut r: TetherImportReport, name: str, priv: str, pass: str, info: KeyInfo) -> str! {
    mut base := import_slug(name)
    if base.len() == 0 {
        base = "key"
    }
    mut taken: []str = []
    for k in keys {
        taken.push(k.name)
    }
    kname := unique_name(base, taken)
    if kname != name {
        r.changed.push(note("key", name, "named '{kname}'"))
    }
    id := new_row_id(crypto)
    k := SshKey{
        id: id,
        name: kname,
        key_type: info.key_type,
        public_key: info.public_key,
        fingerprint: info.fingerprint,
        private_key: try seal_secret(crypto, session, "ssh_keys", id, "private_key", priv),
        passphrase: try seal_secret(crypto, session, "ssh_keys", id, "passphrase", pass),
    }
    try store.key_put(k)
    keys.push(k)
    r.added.keys += 1
    return id
}

fn key_by_fingerprint(keys: []SshKey, fingerprint: str) -> str {
    for k in keys {
        if k.fingerprint == fingerprint {
            return k.id
        }
    }
    return ""
}

fn cred_names(creds: []Credential) -> []str {
    mut names: []str = []
    for c in creds {
        names.push(c.name)
    }
    return names
}

fn host_aliases(hosts: []Host) -> []str {
    mut names: []str = []
    for h in hosts {
        names.push(h.alias)
    }
    return names
}

fn find_same_host(hosts: []Host, label: str, hostname: str, port: i64, user: str) -> str {
    for h in hosts {
        if h.label == label && lower_ascii(h.hostname) == lower_ascii(hostname) && h.port == port && h.username == user {
            return h.id
        }
    }
    return ""
}

fn id_in(ids: []str, id: str) -> bool {
    for x in ids {
        if x == id {
            return true
        }
    }
    return false
}
