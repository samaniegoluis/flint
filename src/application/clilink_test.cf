package application

// A file system of links: path → target ("" for a plain file), plus the files that
// exist and the folders this process may write.
type FakeCliLinks struct {
    links:    map[str]str
    files:    map[str]bool
    writable: map[str]bool
    admin_calls: i64
}

fn new_fake_cli_links() -> FakeCliLinks {
    mut l := FakeCliLinks{ links: {}, files: {}, writable: {}, admin_calls: 0 }
    l.writable["/Users/me/.local/bin"] = true
    return l
}

fn (self: FakeCliLinks) cli_link_exists(path: str) -> bool {
    return self.files.contains(path)
}

fn (self: FakeCliLinks) cli_link_probe(path: str) -> domain.LinkProbe {
    dir := path[0..path.len() - 6]   // without "/flint"
    w := self.writable.contains(dir)
    if self.links.contains(path) {
        t := self.links[path]
        if t.len() == 0 {
            return domain.LinkProbe{ exists: true, is_link: false, target: "", target_exists: false, dir_writable: w }
        }
        te := self.files.contains(t)
        return domain.LinkProbe{ exists: te, is_link: true, target: t, target_exists: te, dir_writable: w }
    }
    return domain.LinkProbe{ exists: false, is_link: false, target: "", target_exists: false, dir_writable: w }
}

fn (mut self: FakeCliLinks) cli_link_make(target: str, path: str, admin: bool) -> void! {
    if admin {
        self.admin_calls += 1
    }
    self.links[path] = target
}

fn (mut self: FakeCliLinks) cli_link_remove(path: str, admin: bool) -> void! {
    if admin {
        self.admin_calls += 1
    }
    self.links.remove(path)
}

CLI_A: str = "/Applications/Flint.app/Contents/Helpers/flint"
CLI_B: str = "/Users/me/Downloads/Flint.app/Contents/Helpers/flint"
HOME: str = "/Users/me"

test "the command is offered once, linked on request, and the admin path used only where needed" {
    mut links := new_fake_cli_links()
    links.files[CLI_A] = true
    mut settings := FakeSettingsStore{ saved: domain.default_settings() }
    st := try cli_link_first_launch(links, mut settings, CLI_A, CLI_SYSTEM_DIR, HOME)
    assert_eq(st.offer, "install")
    assert(settings.saved.cli_offer_shown)
    again := try cli_link_first_launch(links, mut settings, CLI_A, CLI_SYSTEM_DIR, HOME)
    assert_eq(again.offer, "")
    after := try install_cli_link(mut links, CLI_A, CLI_SYSTEM_DIR, HOME, "/usr/local/bin/flint")
    assert_eq(after.spots[0].state, "installed")
    assert_eq(links.admin_calls, 1)
    _ = try install_cli_link(mut links, CLI_A, CLI_SYSTEM_DIR, HOME, "/Users/me/.local/bin/flint")
    assert_eq(links.admin_calls, 1)
    gone := try remove_cli_link(mut links, CLI_A, CLI_SYSTEM_DIR, HOME, "/usr/local/bin/flint")
    assert_eq(gone.spots[0].state, "missing")
    assert_eq(links.admin_calls, 2)
}

test "a moved app is offered a fix, and a foreign flint is never touched" {
    mut links := new_fake_cli_links()
    links.files[CLI_B] = true
    links.links["/Users/me/.local/bin/flint"] = CLI_A   // A was moved to B: the link dangles
    mut settings := FakeSettingsStore{ saved: domain.default_settings() }
    settings.saved.cli_offer_shown = true
    st := try cli_link_first_launch(links, mut settings, CLI_B, CLI_SYSTEM_DIR, HOME)
    assert_eq(st.spots[1].state, "broken")
    assert_eq(st.offer, "fix")
    fixed := try install_cli_link(mut links, CLI_B, CLI_SYSTEM_DIR, HOME, "/Users/me/.local/bin/flint")
    assert_eq(fixed.spots[1].state, "installed")
    links.links["/usr/local/bin/flint"] = ""   // a copied file, as scripts/install.sh leaves
    mut refused := 0
    install_cli_link(mut links, CLI_B, CLI_SYSTEM_DIR, HOME, "/usr/local/bin/flint") or { refused += 1 }
    remove_cli_link(mut links, CLI_B, CLI_SYSTEM_DIR, HOME, "/usr/local/bin/flint") or { refused += 1 }
    install_cli_link(mut links, CLI_B, CLI_SYSTEM_DIR, HOME, "/tmp/flint") or { refused += 1 }
    assert_eq(refused, 3)
    assert_eq(links.links["/usr/local/bin/flint"], "")
}

test "a copy with no CLI inside offers nothing and links nothing" {
    mut links := new_fake_cli_links()
    mut settings := FakeSettingsStore{ saved: domain.default_settings() }
    st := try cli_link_first_launch(links, mut settings, "", CLI_SYSTEM_DIR, HOME)
    assert(!st.available)
    assert_eq(st.offer, "")
    assert(!settings.saved.cli_offer_shown)
    mut refused := 0
    install_cli_link(mut links, "", CLI_SYSTEM_DIR, HOME, "/usr/local/bin/flint") or { refused += 1 }
    assert_eq(refused, 1)
}

test "the page cannot set the app's own records" {
    mut store := FakeSettingsStore{ saved: domain.default_settings() }
    store.saved.cli_offer_shown = true
    mut s := domain.default_settings()
    s.cli_offer_shown = false
    saved := try save_settings(mut store, s)
    assert(saved.cli_offer_shown)
}

// The user's Path as a string, plus the files that exist (Windows, milestone 50).
type FakeCliPath struct {
    value:  str
    files:  map[str]bool
    writes: i64
}

fn (self: FakeCliPath) cli_path_read() -> str! {
    return self.value
}

fn (mut self: FakeCliPath) cli_path_write(value: str) -> void! {
    self.value = value
    self.writes += 1
}

fn (self: FakeCliPath) cli_path_file_exists(path: str) -> bool {
    return self.files.contains(path.replace_all("\\", "/").to_lower())
}

fn (self: FakeCliPath) cli_path_probe(entry: str) -> domain.PathEntryProbe {
    e := entry.replace_all("\\", "/").to_lower()
    return domain.PathEntryProbe{ entry: entry, has_cli: self.files.contains(e + "/flint.exe"), has_app: self.files.contains(e + "_app") }
}

fn fake_path_with(value: str, copies: []str) -> FakeCliPath {
    mut env := FakeCliPath{ value: value, files: {}, writes: 0 }
    for c in copies {
        k := c.to_lower()
        env.files[k + "/bin/flint.exe"] = true
        env.files[k + "/bin_app"] = true
    }
    return env
}

WIN_A: str = "C:/Users/me/Apps/Flint"
WIN_B: str = "C:/Users/me/Downloads/Flint"

test "Windows: the folder is offered once, added first on request and taken off again" {
    mut env := fake_path_with("C:\\Tools;%USERPROFILE%\\go\\bin", [WIN_A])
    mut settings := FakeSettingsStore{ saved: domain.default_settings() }
    cli := WIN_A + "/bin/flint.exe"
    bin := WIN_A + "/bin"
    st := try cli_path_first_launch(env, mut settings, cli, bin)
    assert_eq(st.kind, "path")
    assert_eq(st.offer, "install")
    assert_eq(st.spots[0].state, "missing")
    assert(settings.saved.cli_offer_shown)
    again := try cli_path_first_launch(env, mut settings, cli, bin)
    assert_eq(again.offer, "")
    done := try install_cli_path(mut env, cli, bin, bin)
    assert_eq(done.spots[0].state, "installed")
    assert_eq(env.value, "C:\\Users\\me\\Apps\\Flint\\bin;C:\\Tools;%USERPROFILE%\\go\\bin")
    _ = try install_cli_path(mut env, cli, bin, bin)
    assert_eq(env.writes, 1)
    off := try remove_cli_path(mut env, cli, bin, bin)
    assert_eq(off.spots[0].state, "missing")
    assert_eq(env.value, "C:\\Tools;%USERPROFILE%\\go\\bin")
}

test "Windows: a moved folder is offered again and replaced, a foreign folder is never added" {
    // The Path still names the folder before it was moved (now gone) and another copy.
    mut env := fake_path_with("D:\\Old\\Flint\\bin;C:\\Tools", [WIN_A])
    mut settings := FakeSettingsStore{ saved: domain.default_settings() }
    settings.saved.cli_offer_shown = true
    cli := WIN_A + "/bin/flint.exe"
    bin := WIN_A + "/bin"
    st := try cli_path_first_launch(env, mut settings, cli, bin)
    assert_eq(st.spots[0].state, "broken")
    assert_eq(st.offer, "fix")
    _ = try install_cli_path(mut env, cli, bin, bin)
    assert_eq(env.value, "C:\\Users\\me\\Apps\\Flint\\bin;C:\\Tools")
    mut two := fake_path_with("C:\\Users\\me\\Downloads\\Flint\\bin", [WIN_A, WIN_B])
    assert_eq(cli_path_status(two, cli, bin, true).spots[0].state, "other-copy")
    mut refused := 0
    install_cli_path(mut two, cli, bin, "C:\\Windows") or { refused += 1 }
    // A build from source carries no bin\flint.exe: nothing to offer.
    mut none_here := fake_path_with("", [])
    assert(!cli_path_status(none_here, cli, bin, false).available)
    install_cli_path(mut none_here, cli, bin, bin) or { refused += 1 }
    assert_eq(refused, 2)
    assert_eq(none_here.writes, 0)
}
