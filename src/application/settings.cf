package application

// Desktop app settings: per machine, validated before they are stored.

import "../domain"
import "../ports"

// Stored settings that no longer validate (an edited file, a field from a newer
// version) fall back to the defaults field by field rather than failing the app.
fn load_settings[T: SettingsStore](store: T) -> Settings! {
    s := try store.settings_load()
    if settings_valid(s) {
        return s
    }
    d := default_settings()
    mut fixed := d
    fixed.follow_motion = s.follow_motion
    fixed.reopen_last_vault = s.reopen_last_vault
    fixed.term_cursor_blink = s.term_cursor_blink
    fixed.keys_cleared = s.keys_cleared
    fixed.webview_cleared = s.webview_cleared
    fixed.cli_offer_shown = s.cli_offer_shown
    fixed.update_check = s.update_check
    fixed.update_toast_version = s.update_toast_version
    fixed.last_seen_version = s.last_seen_version
    fixed.server_stats = s.server_stats
    fixed.server_stats_colour = s.server_stats_colour
    fixed.notify_grants = s.notify_grants
    fixed.sudo_periods = s.sudo_periods
    if approval_wait_valid(s.approval_wait) {
        fixed.approval_wait = s.approval_wait
    }
    fixed.ntfy_on = s.ntfy_on
    if one_of(s.ntfy_phone, NTFY_PHONES) {
        fixed.ntfy_phone = s.ntfy_phone
    }
    if one_of(s.close_action, CLOSE_ACTIONS) {
        fixed.close_action = s.close_action
    }
    if one_of(s.language, LANGUAGES) {
        fixed.language = s.language
    }
    mut probe := d
    probe.ntfy_server = s.ntfy_server
    if settings_valid(probe) {
        fixed.ntfy_server = s.ntfy_server
    }
    probe = d
    probe.ntfy_topic = s.ntfy_topic
    if settings_valid(probe) {
        fixed.ntfy_topic = s.ntfy_topic
    }
    probe = d
    probe.theme = s.theme
    if settings_valid(probe) {
        fixed.theme = s.theme
    }
    probe = d
    probe.accent = s.accent
    if settings_valid(probe) {
        fixed.accent = s.accent
    }
    probe = d
    probe.density = s.density
    if settings_valid(probe) {
        fixed.density = s.density
    }
    probe = d
    probe.term_font = s.term_font
    if settings_valid(probe) {
        fixed.term_font = s.term_font
    }
    probe = d
    probe.term_font_size = s.term_font_size
    if settings_valid(probe) {
        fixed.term_font_size = s.term_font_size
    }
    probe = d
    probe.term_line_height = s.term_line_height
    if settings_valid(probe) {
        fixed.term_line_height = s.term_line_height
    }
    probe = d
    probe.term_cursor = s.term_cursor
    if settings_valid(probe) {
        fixed.term_cursor = s.term_cursor
    }
    probe = d
    probe.term_theme = s.term_theme
    if settings_valid(probe) {
        fixed.term_theme = s.term_theme
    }
    probe = d
    probe.lock_after = s.lock_after
    if settings_valid(probe) {
        fixed.lock_after = s.lock_after
    }
    probe = d
    probe.paste_limit_mb = s.paste_limit_mb
    if settings_valid(probe) {
        fixed.paste_limit_mb = s.paste_limit_mb
    }
    probe = d
    probe.rdp_graphics = s.rdp_graphics
    if settings_valid(probe) {
        fixed.rdp_graphics = s.rdp_graphics
    }
    probe = d
    probe.sync_interval = s.sync_interval
    if settings_valid(probe) {
        fixed.sync_interval = s.sync_interval
    }
    probe = d
    probe.toast_corner = s.toast_corner
    if settings_valid(probe) {
        fixed.toast_corner = s.toast_corner
    }
    return fixed
}

// `keys_cleared`, `webview_cleared`, `cli_offer_shown`, `update_toast_version` and `last_seen_version`
// are the app's own records, not preferences:
// the stored values are kept whatever the page sends.
fn save_settings[T: SettingsStore](mut store: T, s: Settings) -> Settings! {
    try check_settings(s)
    mut saved := s
    stored := try load_settings(store)
    saved.keys_cleared = stored.keys_cleared
    saved.webview_cleared = stored.webview_cleared
    saved.cli_offer_shown = stored.cli_offer_shown
    saved.update_toast_version = stored.update_toast_version
    saved.last_seen_version = stored.last_seen_version
    // The topic is the app's (milestone 63): ensure_alert_topic and new_alert_topic.
    saved.ntfy_topic = stored.ntfy_topic
    try store.settings_save(saved)
    return saved
}

// Runs forget_cached_keys the first time a milestone-14 Flint starts on this
// machine, and records that it did. Returns how many keys it removed (0 when it had
// already run). A keychain that cannot be reached leaves it for the next start.
fn forget_cached_keys_once[T: SettingsStore, S: VaultStore, K: Keychain, R: RecentStore](mut settings: T, store: S, keychain: K, recents: R) -> i64! {
    mut s := try load_settings(settings)
    if s.keys_cleared {
        return 0
    }
    n := try forget_cached_keys(store, keychain, recents)
    s.keys_cleared = true
    try settings.settings_save(s)
    return n
}

// Removes what the webview stored from the page's fields (milestone 64, Principle 20)
// the first time a Flint that turns autofill off starts on this machine, and records
// that it did. Returns how many files it removed (0 when it had already run). A file it
// cannot remove leaves it for the next start.
fn clear_webview_autofill_once[T: SettingsStore, W: WebviewData](mut settings: T, mut webview: W) -> i64! {
    mut s := try load_settings(settings)
    if s.webview_cleared {
        return 0
    }
    n := try webview.webview_autofill_clear()
    s.webview_cleared = true
    try settings.settings_save(s)
    return n
}

// Installed monospaced families, sorted and without duplicates.
fn list_mono_fonts[F: FontCatalog](fonts: F) -> []str! {
    raw := try fonts.mono_font_families()
    mut names: []str = []
    for name in raw {
        if name.len() == 0 || !text_valid("font", name, 128, false) {
            continue
        }
        mut seen := false
        for o in names {
            if o == name {
                seen = true
            }
        }
        if !seen {
            names.push(name)
        }
    }
    // Insertion sort: the list is short.
    for i in 1..names.len() {
        mut j := i
        for j > 0 && names[j - 1] > names[j] {
            tmp := names[j - 1]
            names[j - 1] = names[j]
            names[j] = tmp
            j -= 1
        }
    }
    return names
}

// What ✕ does now (milestone 65, D-138 (3)): CLOSE_HIDE, CLOSE_QUIT or CLOSE_ASK, by
// the tray and the person's answer kept in this machine's settings.
fn window_close_action[T: SettingsStore](store: T, has_tray: bool) -> str {
    s := load_settings(store) or default_settings()
    return close_decision(has_tray, s.close_action)
}
