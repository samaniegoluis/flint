package application

// Desktop app settings: per machine, validated before they are stored.

import "../domain"
import "../ports"

// Stored settings that no longer validate (an edited file, a field from a newer
// version) fall back to the defaults field by field rather than failing the app.
fn load_settings[T: SettingsStore](store: T) -> Settings! {
    s := try store.settings_load()
    if settings_valid(s) {
        return s
    }
    d := default_settings()
    mut fixed := d
    fixed.follow_motion = s.follow_motion
    fixed.reopen_last_vault = s.reopen_last_vault
    fixed.term_cursor_blink = s.term_cursor_blink
    fixed.keys_cleared = s.keys_cleared
    mut probe := d
    probe.theme = s.theme
    if settings_valid(probe) {
        fixed.theme = s.theme
    }
    probe = d
    probe.accent = s.accent
    if settings_valid(probe) {
        fixed.accent = s.accent
    }
    probe = d
    probe.density = s.density
    if settings_valid(probe) {
        fixed.density = s.density
    }
    probe = d
    probe.term_font = s.term_font
    if settings_valid(probe) {
        fixed.term_font = s.term_font
    }
    probe = d
    probe.term_font_size = s.term_font_size
    if settings_valid(probe) {
        fixed.term_font_size = s.term_font_size
    }
    probe = d
    probe.term_line_height = s.term_line_height
    if settings_valid(probe) {
        fixed.term_line_height = s.term_line_height
    }
    probe = d
    probe.term_cursor = s.term_cursor
    if settings_valid(probe) {
        fixed.term_cursor = s.term_cursor
    }
    probe = d
    probe.term_theme = s.term_theme
    if settings_valid(probe) {
        fixed.term_theme = s.term_theme
    }
    probe = d
    probe.lock_after = s.lock_after
    if settings_valid(probe) {
        fixed.lock_after = s.lock_after
    }
    probe = d
    probe.paste_limit_mb = s.paste_limit_mb
    if settings_valid(probe) {
        fixed.paste_limit_mb = s.paste_limit_mb
    }
    probe = d
    probe.rdp_graphics = s.rdp_graphics
    if settings_valid(probe) {
        fixed.rdp_graphics = s.rdp_graphics
    }
    return fixed
}

// `keys_cleared` is the app's own record, not a preference: the stored value is
// kept whatever the page sends.
fn save_settings[T: SettingsStore](mut store: T, s: Settings) -> Settings! {
    try check_settings(s)
    mut saved := s
    saved.keys_cleared = (try load_settings(store)).keys_cleared
    try store.settings_save(saved)
    return saved
}

// Runs forget_cached_keys the first time a milestone-14 Flint starts on this
// machine, and records that it did. Returns how many keys it removed (0 when it had
// already run). A keychain that cannot be reached leaves it for the next start.
fn forget_cached_keys_once[T: SettingsStore, S: VaultStore, K: Keychain, R: RecentStore](mut settings: T, store: S, keychain: K, recents: R) -> i64! {
    mut s := try load_settings(settings)
    if s.keys_cleared {
        return 0
    }
    n := try forget_cached_keys(store, keychain, recents)
    s.keys_cleared = true
    try settings.settings_save(s)
    return n
}

// Installed monospaced families, sorted and without duplicates.
fn list_mono_fonts[F: FontCatalog](fonts: F) -> []str! {
    raw := try fonts.mono_font_families()
    mut names: []str = []
    for name in raw {
        if name.len() == 0 || !text_valid("font", name, 128, false) {
            continue
        }
        mut seen := false
        for o in names {
            if o == name {
                seen = true
            }
        }
        if !seen {
            names.push(name)
        }
    }
    // Insertion sort: the list is short.
    for i in 1..names.len() {
        mut j := i
        for j > 0 && names[j - 1] > names[j] {
            tmp := names[j - 1]
            names[j - 1] = names[j]
            names[j] = tmp
            j -= 1
        }
    }
    return names
}
