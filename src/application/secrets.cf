package application

// Secret values (passwords, private keys, passphrases) are sealed with
// XChaCha20-Poly1305 under the vault's secrets key before they reach the store
// (D-016). The AAD names the row and field, so a sealed value copied to another row
// or field fails to open.

import "core:encoding/hex"
import "../domain"
import "../ports"

fn secret_aad(table: str, id: str, field: str) -> []byte {
    return []byte("flint:v1:" + table + ":" + id + ":" + field)
}

fn str_to_bytes(s: str) -> []byte {
    return []byte(s)
}

fn bytes_to_str(b: []byte) -> str {
    return str(b)
}

fn seal_secret[C: Crypto](crypto: C, session: VaultSession, table: str, id: str, field: str, plaintext: str) -> []byte! {
    if plaintext.len() == 0 {
        return []
    }
    return crypto.seal(session.secrets_key, str_to_bytes(plaintext), secret_aad(table, id, field))
}

// Opens a sealed secret. Only the SSH transport path (milestone 03), the GUI's
// explicit reveal and copy (reveal_password, D-029) and tests call this: no other
// plaintext goes back to a driver (Principle 6).
fn open_secret[C: Crypto](crypto: C, session: VaultSession, table: str, id: str, field: str, sealed: []byte) -> str! {
    if sealed.len() == 0 {
        return ""
    }
    plain := try crypto.unseal(session.secrets_key, sealed, secret_aad(table, id, field))
    return bytes_to_str(plain)
}

// A random 128-bit row id.
fn new_row_id[C: Crypto](crypto: C) -> str {
    return hex.encode(crypto.random_bytes(16))
}

// ---- Reveal and copy (D-029) -----------------------------------------------------

// How long a copied password stays on the clipboard.
CLIPBOARD_CLEAR_MS: i64 = 30000

// The saved password of a host (`kind` "host") or a credential ("credential"), for the
// desktop app's explicit reveal: the one exception to Principle 6 (D-029). The CLI
// has no reveal. Never log or embed the value in an error.
fn reveal_password[C: Crypto, S: VaultStore](crypto: C, store: S, session: VaultSession, kind: str, name: str) -> str! {
    if kind == "host" {
        hosts := try store.hosts_all()
        h := try require_host(hosts, name)
        if h.password.len() == 0 {
            return error(coded(ERR_NOT_FOUND, "host '{h.alias}' has no saved password"))
        }
        return open_secret(crypto, session, "hosts", h.id, "password", h.password)
    }
    if kind == "credential" {
        creds := try store.creds_all()
        idx := cred_index_by_name(creds, name)
        if idx < 0 {
            return error(coded(ERR_NOT_FOUND, "no credential '{name}'"))
        }
        c := creds[usize(idx)]
        if c.password.len() == 0 {
            return error(coded(ERR_NOT_FOUND, "credential '{c.name}' has no saved password"))
        }
        return open_secret(crypto, session, "credentials", c.id, "password", c.password)
    }
    return error(coded(ERR_INVALID, "a password belongs to a host or a credential, not '{kind}'"))
}

// Copies a saved password to the clipboard without returning it to the driver; the
// clipboard is cleared after CLIPBOARD_CLEAR_MS unless something else was copied
// since (D-029).
fn copy_password[C: Crypto, S: VaultStore, B: Clipboard](crypto: C, store: S, session: VaultSession, mut clip: B, kind: str, name: str) -> void! {
    value := try reveal_password(crypto, store, session, kind, name)
    try clip.clipboard_copy_secret(value, CLIPBOARD_CLEAR_MS)
}
