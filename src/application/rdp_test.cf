    type_into_desktop(mut rd, "t1", "") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "invalid")
    msg = ""
    type_into_desktop(mut rd, "t1", "a".repeat(usize(RDP_TYPE_MAX_CHARS + 1))) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "invalid")
    assert_eq(rd.typed.len(), 0)
    rd.klid = 0
    msg = ""
    type_into_desktop(mut rd, "t1", "a") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "network")
    rd.klid = 0x0409
    rd.closed = 1
    msg = ""
    type_into_desktop(mut rd, "t1", "ab") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "network")
}

