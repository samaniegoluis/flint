package application

import "../domain"

// A RemoteDesktop that plays a server: it presents the certificate `fp`, accepts the
// password `password`, and replays `events` to rd_wait (then reports the session
// closed). It records every connection and what reached it.
type FakeDesktop struct {
    fp: str
    password: str
    opens: []RdpTarget
    closed: i64
    events: []RdpEvent
    waits: i64
    keys: []str
    pointers: []RdpPointer
    resizes: []DesktopSize
    announces: []bool
    answers: []str
    modes: []str
    // From this connection on (1-based; 0: never) the server cannot be reached.
    fail_from: i64
    // What rd_probe_rtt answers, and how often it was asked.
    rtt: i64
    probes: i64
}

fn new_fake_desktop(fp: str, password: str) -> FakeDesktop {
    return FakeDesktop{ fp: fp, password: password, opens: [], closed: 0, events: [], waits: 0, keys: [], pointers: [], resizes: [], announces: [], answers: [], modes: [], fail_from: 0, rtt: 20, probes: 0 }
}

fn (mut self: FakeDesktop) rd_clip_announce(tab: str, has_text: bool) -> void! {
    self.announces.push(has_text)
}

// Each answer as "ok <text>" or "fail".
fn (mut self: FakeDesktop) rd_clip_answer(tab: str, ok: bool, text: str) -> void! {
    if ok {
        self.answers.push("ok {text}")
    } else {
        self.answers.push("fail")
    }
}

fn (mut self: FakeDesktop) rd_open(tab: str, t: RdpTarget, timeout_ms: i64) -> RdpDesktop! {
    self.opens.push(t)
    if self.fail_from > 0 && i64(self.opens.len()) >= self.fail_from {
        return error(coded(ERR_NETWORK, "could not reach the server"))
    }
    if t.trusted_fingerprint != self.fp {
        return error(coded(ERR_HOST_KEY, "the certificate is not the trusted one"))
    }
    if t.password != self.password {
        return error(coded(ERR_AUTH, "the server refused the user or password"))
    }
    return RdpDesktop{ width: t.width, height: t.height, frame_port: 4100, frame_token: "tok", graphics: t.graphics, rtt_ms: t.rtt_ms }
}

fn (self: FakeDesktop) rd_presented_cert(tab: str) -> RdpCert {
    return RdpCert{ subject: "CN=WIN11", issuer: "CN=WIN11", fingerprint: self.fp, valid_from: "", valid_to: "" }
}

fn (mut self: FakeDesktop) rd_resize(tab: str, width: i64, height: i64) -> void! {
    self.resizes.push(DesktopSize{ width: width, height: height })
}

fn (mut self: FakeDesktop) rd_wait(tab: str, wait_ms: i64) -> RdpEvent {
    self.waits += 1
    if i64(self.events.len()) >= self.waits {
        return self.events[usize(self.waits - 1)]
    }
    return RdpEvent{ kind: RDP_EVENT_ENDED, message: "", width: 0, height: 0 }
}

fn (mut self: FakeDesktop) rd_key(tab: str, code: str, down: bool) -> void! {
    mut d := "up"
    if down {
        d = "down"
    }
    self.keys.push("{code} {d}")
}

fn (mut self: FakeDesktop) rd_pointer(tab: str, p: RdpPointer) -> void! {
    self.pointers.push(p)
}

fn (self: FakeDesktop) rd_stats(tab: str) -> RdpStats! {
    return RdpStats{ updates: 30, bytes_in: 1000, commands: 12, decode_us: 600, frames_read: 25, pipeline: "gfx", codec: "progressive", h264: false, rereads: 2, stale_px: 0, link_kbps: 0, link_rtt_ms: 0, mode: "auto" }
}

fn (mut self: FakeDesktop) rd_set_graphics(tab: str, graphics: str) -> void! {
    self.modes.push(graphics)
}

// The round trip the first desktop reported to the sink.
fn (self: FakeDesktop) ready_rtt(sink: FakeDesktopSink) -> i64 {
    return sink.ready[0].rtt_ms
}

fn (mut self: FakeDesktop) rd_probe_rtt(host: str, port: i64, timeout_ms: i64) -> i64 {
    self.probes += 1
    return self.rtt
}

fn (mut self: FakeDesktop) rd_close(tab: str) {
    self.closed += 1
}

type FakeDesktopSink struct {
    ready: []RdpDesktop
    locked: bool
    // Each graphics report as "<mode>" or "<mode>: <why>".
    graphics: []str
}

fn (mut self: FakeDesktopSink) desktop_graphics(tab: str, graphics: str, sw: RdpModeSwitch) {
    if sw.why.len() == 0 {
        self.graphics.push("{graphics} as {sw.graphics}")
    } else {
        self.graphics.push("{graphics}: {sw.why}")
    }
}

fn (mut self: FakeDesktopSink) desktop_ready(tab: str, d: RdpDesktop) {
    self.ready.push(d)
}

fn (self: FakeDesktopSink) desktop_window_open() -> bool {
    return !self.locked
}

fn no_clipboard() -> FakeClipboard {
    return FakeClipboard{ text: "", clear_after_ms: 0, copies: 0, held: ClipboardContent{ text: "", mime: "", image: "" } }
}

fn trusting() -> FakePrompter {
    return FakePrompter{ available: true, confirm: true, password: "typed" }
}

fn rdp_fake(crypto: FakeCrypto, mut store: FakeStore, s: VaultSession, password: str) -> void! {
    mut p := host_patch("win", "Win11.lan")
    p.host_type = "rdp"
    p.set_host_type = true
    p.user = "luis"
    p.set_user = true
    p.domain = "CORP"
    p.set_domain = true
    if password.len() > 0 {
        p.password = password
        p.set_password = true
    }
    _ := try add_host(crypto, mut store, s, p)
}

fn rdp_req(alias: str) -> RdpOpenRequest {
    return RdpOpenRequest{ tab: "t1", alias: alias, width: 1601, height: 900, timeout_ms: 5000, graphics: "" }
}

test "the graphics choice reaches the engine, empty reads auto (resolved by the round trip) and an unknown one is refused" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    mut rd := new_fake_desktop("ab:cd", "s3cret")
    _ := try open_remote_desktop(crypto, mut store, s, mut rd, trusting(), rdp_req("win"))
    // A 20 ms link: not a local network, so the pipeline.
    assert_eq(rd.opens[1].graphics, "pipeline")
    assert_eq(rd.opens[1].rtt_ms, 20)
    mut req := rdp_req("win")
    req.graphics = "compatible"
    mut again := new_fake_desktop("ab:cd", "s3cret")
    _ := try open_remote_desktop(crypto, mut store, s, mut again, no_prompter(), req)
    assert_eq(again.opens[0].graphics, "compatible")
    assert_eq(again.probes, 0)
    req.graphics = "pipeline"
    mut forced := new_fake_desktop("ab:cd", "s3cret")
    forced.rtt = 1
    _ := try open_remote_desktop(crypto, mut store, s, mut forced, no_prompter(), req)
    assert_eq(forced.opens[0].graphics, "pipeline")
    assert_eq(forced.probes, 0)
    req.graphics = "h264"
    mut msg := ""
    mut refused := new_fake_desktop("ab:cd", "s3cret")
    open_remote_desktop(crypto, mut store, s, mut refused, no_prompter(), req) or err { msg = "{err.message()}" }
    assert(msg.contains("graphics"))
    assert_eq(refused.opens.len(), 0)
}

test "a tab's statistics come from the engine" {
    rd := new_fake_desktop("ab:cd", "s3cret")
    st := try remote_desktop_stats(rd, "t1")
    assert_eq(st.pipeline, "gfx")
    assert_eq(st.codec, "progressive")
    mut msg := ""
    remote_desktop_stats(rd, "") or err { msg = "{err.message()}" }
    assert(msg.contains("tab id"))
}

test "a first RDP connection asks for the certificate, keeps it, and connects with the vault's password" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    mut rd := new_fake_desktop("ab:cd", "s3cret")
    d := try open_remote_desktop(crypto, mut store, s, mut rd, trusting(), rdp_req("win"))
    assert_eq(d.width, 1600)
    assert_eq(d.height, 900)
    assert_eq(rd.opens.len(), 2)
    assert_eq(rd.opens[0].trusted_fingerprint, "")
    assert_eq(rd.opens[1].trusted_fingerprint, "ab:cd")
    assert_eq(rd.opens[1].user, "luis")
    assert_eq(rd.opens[1].domain, "CORP")
    assert_eq(rd.opens[1].password, "s3cret")
    assert_eq(rd.opens[1].port, 3389)
    known := try store.known_hosts_all()
    assert_eq(known.len(), 1)
    assert_eq(known[0].addr, "rdp://win11.lan:3389")
    assert_eq(known[0].key_type, "x509")
    assert_eq(known[0].fingerprint, "ab:cd")

    // The next connection trusts it at once.
    mut again := new_fake_desktop("ab:cd", "s3cret")
    _ := try open_remote_desktop(crypto, mut store, s, mut again, no_prompter(), rdp_req("win"))
    assert_eq(again.opens.len(), 1)
}

test "an RDP certificate not trusted, or with nobody to ask, does not connect" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    mut rd := new_fake_desktop("ab:cd", "s3cret")
    mut msg := ""
    open_remote_desktop(crypto, mut store, s, mut rd, FakePrompter{ available: true, confirm: false, password: "" }, rdp_req("win")) or err { msg = "{err.message()}" }
    assert_eq(msg, "host_key: the certificate of 'win' was not trusted")
    assert_eq((try store.known_hosts_all()).len(), 0)
    msg = ""
    open_remote_desktop(crypto, mut store, s, mut rd, no_prompter(), rdp_req("win")) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "host_key")
}

test "a changed RDP certificate is refused with the reason and nothing is trusted" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    try store.known_host_put(KnownHost{ addr: "rdp://win11.lan:3389", key_type: "x509", fingerprint: "11:22", host_id: "", added_at: "" })
    mut rd := new_fake_desktop("ab:cd", "s3cret")
    mut msg := ""
    open_remote_desktop(crypto, mut store, s, mut rd, trusting(), rdp_req("win")) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "host_key")
    assert(msg.contains("CHANGED"))
    assert(msg.contains("ab:cd"))
    assert(!msg.contains("s3cret"))
    assert_eq(rd.opens.len(), 1)
    assert_eq(rd.opens[0].trusted_fingerprint, "11:22")
    known := try store.known_hosts_all()
    assert_eq(known[0].fingerprint, "11:22")
}

test "an RDP login uses the credential's password, or asks for one, and failures keep their code" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    mut cp := empty_cred_patch()
    cp.name = "corp"
    cp.set_name = true
    cp.user = "CORP\\admin"
    cp.set_user = true
    cp.password = "fromcred"
    cp.set_password = true
    _ := try add_cred(crypto, mut store, s, cp)
    mut p := host_patch("srv", "srv.lan")
    p.host_type = "rdp"
    p.set_host_type = true
    p.credential = "corp"
    p.set_credential = true
    _ := try add_host(crypto, mut store, s, p)
    try rdp_fake(crypto, mut store, s, "")
    try store.known_host_put(KnownHost{ addr: "rdp://srv.lan:3389", key_type: "x509", fingerprint: "ab:cd", host_id: "", added_at: "" })
    try store.known_host_put(KnownHost{ addr: "rdp://win11.lan:3389", key_type: "x509", fingerprint: "ab:cd", host_id: "", added_at: "" })

    mut rd := new_fake_desktop("ab:cd", "fromcred")
    _ := try open_remote_desktop(crypto, mut store, s, mut rd, no_prompter(), rdp_req("srv"))
    assert_eq(rd.opens[0].user, "CORP\\admin")
    assert_eq(rd.opens[0].password, "fromcred")

    // No saved password: asked for, or refused with nobody to ask.
    mut typed := new_fake_desktop("ab:cd", "typed")
    _ := try open_remote_desktop(crypto, mut store, s, mut typed, trusting(), rdp_req("win"))
    assert_eq(typed.opens[0].password, "typed")
    mut msg := ""
    open_remote_desktop(crypto, mut store, s, mut typed, no_prompter(), rdp_req("win")) or err { msg = "{err.message()}" }
    assert_eq(msg, "auth: 'win' has no saved password")

    // A wrong password is `auth`, and never named.
    mut wrong := new_fake_desktop("ab:cd", "other")
    msg = ""
    open_remote_desktop(crypto, mut store, s, mut wrong, no_prompter(), rdp_req("srv")) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "auth")
    assert(!msg.contains("fromcred"))
}

test "only an RDP host opens a remote desktop" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    _ := try add_host(crypto, mut store, s, host_patch("web", "10.0.0.5"))
    mut rd := new_fake_desktop("ab:cd", "x")
    mut msg := ""
    open_remote_desktop(crypto, mut store, s, mut rd, trusting(), rdp_req("web")) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "wrong_host_type")
    assert_eq(rd.opens.len(), 0)
    msg = ""
    open_remote_desktop(crypto, mut store, s, mut rd, trusting(), rdp_req("nope")) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "not_found")
}

test "a watched desktop reconnects at a new size without Display Control and reports how it ended" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    try store.known_host_put(KnownHost{ addr: "rdp://win11.lan:3389", key_type: "x509", fingerprint: "ab:cd", host_id: "", added_at: "" })
    mut rd := new_fake_desktop("ab:cd", "s3cret")
    rd.events = [
        RdpEvent{ kind: RDP_EVENT_RUNNING, message: "", width: 0, height: 0 },
        RdpEvent{ kind: RDP_EVENT_RESIZE, message: "", width: 1025, height: 700 },
        RdpEvent{ kind: RDP_EVENT_ENDED, message: coded(ERR_NETWORK, "the connection was lost"), width: 0, height: 0 },
    ]
    mut sink := FakeDesktopSink{ ready: [], locked: false, graphics: [] }
    mut clip0 := no_clipboard()
    mut msg := ""
    run_remote_desktop(crypto, mut store, s, mut rd, no_prompter(), mut sink, mut clip0, rdp_req("win")) or err { msg = "{err.message()}" }
    assert_eq(msg, "network: the connection was lost")
    assert_eq(sink.ready.len(), 1)
    assert_eq(rd.opens.len(), 2)
    assert_eq(rd.opens[1].width, 1024)
    assert_eq(rd.opens[1].height, 700)
    assert_eq(rd.opens[1].password, "s3cret")
    assert_eq(rd.closed, 1)

    // Closed on purpose: no error.
    mut quiet := new_fake_desktop("ab:cd", "s3cret")
    mut sink2 := FakeDesktopSink{ ready: [], locked: false, graphics: [] }
    try run_remote_desktop(crypto, mut store, s, mut quiet, no_prompter(), mut sink2, mut clip0, rdp_req("win"))
    assert_eq(quiet.closed, 1)

    // A failed open closes the tab and reports why.
    mut bad := new_fake_desktop("ab:cd", "other")
    msg = ""
    run_remote_desktop(crypto, mut store, s, mut bad, no_prompter(), mut sink2, mut clip0, rdp_req("win")) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "auth")
    assert_eq(bad.closed, 1)
}

test "a reconnect for a new size is skipped when the vault cannot give the password" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "")
    try store.known_host_put(KnownHost{ addr: "rdp://win11.lan:3389", key_type: "x509", fingerprint: "ab:cd", host_id: "", added_at: "" })
    mut rd := new_fake_desktop("ab:cd", "typed")
    rd.events = [RdpEvent{ kind: RDP_EVENT_RESIZE, message: "", width: 800, height: 600 }]
    mut sink := FakeDesktopSink{ ready: [], locked: false, graphics: [] }
    mut clip0 := no_clipboard()
    try run_remote_desktop(crypto, mut store, s, mut rd, trusting(), mut sink, mut clip0, rdp_req("win"))
    // The typed password is not kept for a reconnect.
    assert_eq(rd.opens.len(), 1)
}

test "input and resizes reach the engine once checked" {
    mut rd := new_fake_desktop("", "")
    try send_desktop_key(mut rd, "t1", "KeyA", true)
    try send_desktop_key(mut rd, "t1", "KeyA", false)
    mut refused := 0
    send_desktop_key(mut rd, "t1", "", true) or { refused += 1 }
    try send_desktop_pointer(mut rd, "t1", RdpPointer{ kind: "down", button: 2, x: 5, y: 6, delta: 0 })
    send_desktop_pointer(mut rd, "t1", RdpPointer{ kind: "fly", button: 0, x: 5, y: 6, delta: 0 }) or { refused += 1 }
    try resize_remote_desktop(mut rd, "t1", 99, 5000)
    close_remote_desktop(mut rd, "t1")
    assert_eq(refused, 2)
    assert_eq(rd.keys.len(), 2)
    assert_eq(rd.keys[0], "KeyA down")
    assert_eq(rd.pointers.len(), 1)
    assert_eq(rd.resizes[0].width, 200)
    assert_eq(rd.resizes[0].height, 5000)
    assert_eq(rd.closed, 1)
}

test "the remote's copies reach this machine's clipboard and its pastes get this machine's text" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    try store.known_host_put(KnownHost{ addr: "rdp://win11.lan:3389", key_type: "x509", fingerprint: "ab:cd", host_id: "", added_at: "" })
    mut rd := new_fake_desktop("ab:cd", "s3cret")
    rd.events = [
        RdpEvent{ kind: RDP_EVENT_CLIP_TEXT, message: "from windows\nline 2", width: 0, height: 0 },
        RdpEvent{ kind: RDP_EVENT_CLIP_TEXT, message: "", width: 0, height: 0 },
        RdpEvent{ kind: RDP_EVENT_CLIP_REQUEST, message: "", width: 0, height: 0 },
    ]
    mut sink := FakeDesktopSink{ ready: [], locked: false, graphics: [] }
    mut clip := no_clipboard()
    try run_remote_desktop(crypto, mut store, s, mut rd, no_prompter(), mut sink, mut clip, rdp_req("win"))
    // The empty copy left the first one in place, and the paste got it back.
    assert_eq(clip.text, "from windows\nline 2")
    assert_eq(clip.copies, 1)
    assert_eq(clip.clear_after_ms, 0)
    assert_eq(rd.answers.len(), 1)
    assert_eq(rd.answers[0], "ok from windows\nline 2")
}

test "a locked window or a clipboard without text answers no paste" {
    mut rd := new_fake_desktop("", "")
    mut clip := no_clipboard()
    clip.text = "secret-ish"
    answer_remote_paste(mut rd, mut clip, "t1", false)
    mut empty := no_clipboard()
    empty.held = ClipboardContent{ text: "", mime: "image/png", image: "PNG" }
    answer_remote_paste(mut rd, mut empty, "t1", true)
    assert_eq(rd.answers.len(), 2)
    assert_eq(rd.answers[0], "fail")
    assert_eq(rd.answers[1], "fail")
}

test "the tab announces whether this machine's clipboard holds text, never the text" {
    mut rd := new_fake_desktop("", "")
    mut clip := no_clipboard()
    try announce_desktop_clipboard(mut rd, mut clip, "t1")
    clip.text = "hello"
    try announce_desktop_clipboard(mut rd, mut clip, "t1")
    assert_eq(rd.announces.len(), 2)
    assert(!rd.announces[0])
    assert(rd.announces[1])
    assert_eq(rd.answers.len(), 0)
}

// A FakeDesktop whose session copies this machine's clipboard partway through: each
// wait bumps the fake clipboard, as a person copying in another app.
test "a copy on this machine is announced to the server, and the remote's own copy is not echoed back" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    try store.known_host_put(KnownHost{ addr: "rdp://win11.lan:3389", key_type: "x509", fingerprint: "ab:cd", host_id: "", added_at: "" })
    mut rd := new_fake_desktop("ab:cd", "s3cret")
    // The remote's copy lands here (a change we made), then nothing new happens.
    rd.events = [
        RdpEvent{ kind: RDP_EVENT_CLIP_TEXT, message: "from windows", width: 0, height: 0 },
        RdpEvent{ kind: RDP_EVENT_RUNNING, message: "", width: 0, height: 0 },
    ]
    mut sink := FakeDesktopSink{ ready: [], locked: false, graphics: [] }
    mut clip := no_clipboard()
    try run_remote_desktop(crypto, mut store, s, mut rd, no_prompter(), mut sink, mut clip, rdp_req("win"))
    assert_eq(rd.announces.len(), 0)

    // A copy made here before the session opened is not new; one made after is.
    mut rd2 := new_fake_desktop("ab:cd", "s3cret")
    rd2.events = [
        RdpEvent{ kind: RDP_EVENT_RUNNING, message: "", width: 0, height: 0 },
        RdpEvent{ kind: RDP_EVENT_RUNNING, message: "", width: 0, height: 0 },
    ]
    mut clip2 := no_clipboard()
    clip2.text = "old"
    clip2.copies = 5
    mut ticking := TickingClipboard{ inner: clip2, at_wait: 1, reads: 0 }
    try run_remote_desktop(crypto, mut store, s, mut rd2, no_prompter(), mut sink, mut ticking, rdp_req("win"))
    assert_eq(rd2.announces.len(), 1)
    assert(rd2.announces[0])
    assert_eq(rd2.answers.len(), 0)
}

// A clipboard whose count moves once, after `at_wait` reads of it: a copy made in
// another app while the session runs.
type TickingClipboard struct {
    inner: FakeClipboard
    at_wait: i64
    reads: i64
}

fn (mut self: TickingClipboard) clipboard_copy_secret(text: str, clear_after_ms: i64) -> void! {
    try self.inner.clipboard_copy_secret(text, clear_after_ms)
}

fn (mut self: TickingClipboard) clipboard_copy_text(text: str) -> void! {
    try self.inner.clipboard_copy_text(text)
}

fn (mut self: TickingClipboard) clipboard_read() -> ClipboardContent! {
    return try self.inner.clipboard_read()
}

fn (mut self: TickingClipboard) clipboard_change_count() -> i64 {
    self.reads += 1
    if self.reads > self.at_wait {
        return self.inner.copies + 1
    }
    return self.inner.copies
}

test "a graphics switch reconnects the tab in the new mode and later reconnects keep it" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    try store.known_host_put(KnownHost{ addr: "rdp://win11.lan:3389", key_type: "x509", fingerprint: "ab:cd", host_id: "", added_at: "" })
    mut rd := new_fake_desktop("ab:cd", "s3cret")
    rd.events = [
        RdpEvent{ kind: RDP_EVENT_GRAPHICS, message: "compatible", width: 1600, height: 900 },
        RdpEvent{ kind: RDP_EVENT_RESIZE, message: "", width: 1280, height: 720 },
    ]
    mut sink := FakeDesktopSink{ ready: [], locked: false, graphics: [] }
    mut clip0 := no_clipboard()
    try run_remote_desktop(crypto, mut store, s, mut rd, no_prompter(), mut sink, mut clip0, rdp_req("win"))
    assert_eq(rd.opens.len(), 3)
    assert_eq(rd.opens[0].graphics, "pipeline")
    assert_eq(rd.opens[1].graphics, "compatible")
    assert_eq(rd.opens[1].width, 1600)
    assert_eq(rd.opens[1].height, 900)
    assert_eq(rd.opens[1].password, "s3cret")
    assert_eq(rd.opens[2].graphics, "compatible")
    assert_eq(sink.graphics.len(), 1)
    assert_eq(sink.graphics[0], "compatible as compatible")
    // One desktop_ready: the page keeps reading the same frame channel.
    assert_eq(sink.ready.len(), 1)
}

test "a graphics switch is refused, the mode kept, when the vault has no saved password" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "")
    try store.known_host_put(KnownHost{ addr: "rdp://win11.lan:3389", key_type: "x509", fingerprint: "ab:cd", host_id: "", added_at: "" })
    mut rd := new_fake_desktop("ab:cd", "typed")
    rd.events = [RdpEvent{ kind: RDP_EVENT_GRAPHICS, message: "compatible", width: 1600, height: 900 }]
    mut sink := FakeDesktopSink{ ready: [], locked: false, graphics: [] }
    mut clip0 := no_clipboard()
    try run_remote_desktop(crypto, mut store, s, mut rd, trusting(), mut sink, mut clip0, rdp_req("win"))
    assert_eq(rd.opens.len(), 1)
    assert_eq(sink.graphics.len(), 1)
    assert(sink.graphics[0].starts_with("auto: the password is not saved"))
}

test "a graphics switch whose reconnect fails closes the tab with the reason" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    try store.known_host_put(KnownHost{ addr: "rdp://win11.lan:3389", key_type: "x509", fingerprint: "ab:cd", host_id: "", added_at: "" })
    mut rd := new_fake_desktop("ab:cd", "s3cret")
    rd.events = [RdpEvent{ kind: RDP_EVENT_GRAPHICS, message: "compatible", width: 1600, height: 900 }]
    // The server cannot be reached when the tab reconnects.
    rd.fail_from = 2
    mut sink := FakeDesktopSink{ ready: [], locked: false, graphics: [] }
    mut clip0 := no_clipboard()
    mut msg := ""
    run_remote_desktop(crypto, mut store, s, mut rd, no_prompter(), mut sink, mut clip0, rdp_req("win")) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "network")
    assert(rd.closed >= 1)
    assert_eq(sink.graphics.len(), 0)
}

test "switching graphics checks the mode before it reaches the engine" {
    mut rd := new_fake_desktop("ab:cd", "x")
    try switch_desktop_graphics(mut rd, "t1", "compatible")
    assert_eq(rd.modes.len(), 1)
    assert_eq(rd.modes[0], "compatible")
    mut msg := ""
    switch_desktop_graphics(mut rd, "t1", "h264") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), "invalid")
    assert_eq(rd.modes.len(), 1)
}

test "auto picks bitmaps on a local network, keeps its choice on a resize and measures again when chosen" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    try store.known_host_put(KnownHost{ addr: "rdp://win11.lan:3389", key_type: "x509", fingerprint: "ab:cd", host_id: "", added_at: "" })
    mut rd := new_fake_desktop("ab:cd", "s3cret")
    rd.rtt = 1
    rd.events = [
        RdpEvent{ kind: RDP_EVENT_RESIZE, message: "", width: 1280, height: 720 },
        RdpEvent{ kind: RDP_EVENT_GRAPHICS, message: "pipeline", width: 1280, height: 720 },
        RdpEvent{ kind: RDP_EVENT_GRAPHICS, message: "auto", width: 1280, height: 720 },
    ]
    mut sink := FakeDesktopSink{ ready: [], locked: false, graphics: [] }
    mut clip0 := no_clipboard()
    try run_remote_desktop(crypto, mut store, s, mut rd, no_prompter(), mut sink, mut clip0, rdp_req("win"))
    assert_eq(rd.opens.len(), 4)
    assert_eq(rd.opens[0].graphics, "compatible")
    assert_eq(rd.ready_rtt(sink), 1)
    // The resize keeps what auto chose, without measuring again.
    assert_eq(rd.opens[1].graphics, "compatible")
    assert_eq(rd.opens[2].graphics, "pipeline")
    assert_eq(rd.opens[3].graphics, "compatible")
    assert_eq(rd.probes, 2)
    assert_eq(sink.graphics.len(), 2)
    assert_eq(sink.graphics[0], "pipeline as pipeline")
    assert_eq(sink.graphics[1], "auto as compatible")
}
