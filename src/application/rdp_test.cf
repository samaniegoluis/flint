        RdpEvent{ kind: RDP_EVENT_POINTER, message: "", width: 0, height: 0, cursor: RdpCursor{ action: RDP_CURSOR_SET, id: 3, width: 0, height: 0, hot_x: 0, hot_y: 0, rgba: "" } },
        RdpEvent{ kind: RDP_EVENT_POINTER, message: "", width: 0, height: 0, cursor: RdpCursor{ action: RDP_CURSOR_HIDDEN, id: 0, width: 0, height: 0, hot_x: 0, hot_y: 0, rgba: "" } },
    ]
