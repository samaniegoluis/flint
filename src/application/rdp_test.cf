    try rdp_fake_named(crypto, mut store, s, "bare", "Bare.lan")
    mut clip := no_clipboard()
    i0 := try desktop_type_info(store, mut clip, "win")
    assert_eq(i0.clipboard_chars, 0)
    assert(i0.has_password)
    clip.text = "año"
    i1 := try desktop_type_info(store, mut clip, "bare")
    assert_eq(i1.clipboard_chars, 3)
    assert(!i1.has_password)
}

fn rdp_fake_named(crypto: FakeCrypto, mut store: FakeStore, s: VaultSession, alias: str, hostname: str) -> void! {
    mut p := host_patch(alias, hostname)
    p.host_type = "rdp"
    p.set_host_type = true
    p.user = "luis"
    p.set_user = true
    _ = try add_host(crypto, mut store, s, p)
}

// Milestone 59: the host's row id, as the vault holds it.
fn rdp_host_id(store: FakeStore, alias: str) -> str! {
    cat := try load_catalog(store)
    h := try require_host(cat.hosts, alias)
    return h.id
}

test "Automatic falls back to the pipeline once when the server closes during setup in Compatible, and remembers the host" {
    crypto := FakeCrypto{}
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    id := try rdp_host_id(store, "win")
    mut ui0 := no_ui()
    // A local network: "auto" picks Compatible, the server closes, the pipeline opens.
    mut rd := new_fake_desktop("ab:cd", "s3cret")
    rd.rtt = 1
    rd.setup_closes = "compatible"
    d := try open_remote_desktop(crypto, mut store, s, mut rd, trusting(), mut ui0, rdp_req("win"))
    // The certificate first (open 1), then Compatible (2), then the pipeline (3).
    assert_eq(rd.opens.len(), 3)
    assert_eq(rd.opens[1].graphics, "compatible")
    assert_eq(rd.opens[2].graphics, "pipeline")
    assert_eq(rd.opens[2].password, "s3cret")
    assert_eq(d.graphics, "pipeline")
    assert_eq(ui0.saves, 1)
    assert(rdp_pipeline_remembered(ui0.saved, id))
    // Next time "auto" goes straight to the pipeline, with no probe.
    mut next := new_fake_desktop("ab:cd", "s3cret")
    next.rtt = 1
    next.setup_closes = "compatible"
    _ = try open_remote_desktop(crypto, mut store, s, mut next, no_prompter(), mut ui0, rdp_req("win"))
    assert_eq(next.opens.len(), 1)
    assert_eq(next.opens[0].graphics, "pipeline")
    assert_eq(next.probes, 0)
    assert_eq(ui0.saves, 1)
}

test "a mode the person chose, a pipeline that closes, or another failure is never retried" {
    crypto := FakeCrypto{}
    mut store := new_fake_store()
    s := fresh_session(crypto, mut store)
    try rdp_fake(crypto, mut store, s, "s3cret")
    mut ui0 := no_ui()
    mut msg := ""
    // Compatible chosen in Settings: one attempt, its own error, nothing remembered.
    mut req := rdp_req("win")
    req.graphics = "compatible"
    mut chosen := new_fake_desktop("ab:cd", "s3cret")
    _ = try open_remote_desktop(crypto, mut store, s, mut chosen, trusting(), mut ui0, rdp_req("win"))
    chosen.opens = []
    chosen.setup_closes = "compatible"
    open_remote_desktop(crypto, mut store, s, mut chosen, no_prompter(), mut ui0, req) or err { msg = "{err.message()}" }
    assert_eq(chosen.opens.len(), 1)
    assert(rdp_server_closed_setup(msg))
    // "auto" on a slow link picks the pipeline: when it closes there is nothing to fall to.
    mut slow := new_fake_desktop("ab:cd", "s3cret")
    slow.setup_closes = "all"
    msg = ""
    open_remote_desktop(crypto, mut store, s, mut slow, no_prompter(), mut ui0, rdp_req("win")) or err { msg = "{err.message()}" }
    assert_eq(slow.opens.len(), 1)
    assert(rdp_server_closed_setup(msg))
    // Compatible, then the pipeline closes too: two attempts, the error said, nothing kept.
    mut both := new_fake_desktop("ab:cd", "s3cret")
    both.rtt = 1
    both.setup_closes = "all"
    msg = ""
    open_remote_desktop(crypto, mut store, s, mut both, no_prompter(), mut ui0, rdp_req("win")) or err { msg = "{err.message()}" }
    assert_eq(both.opens.len(), 2)
    assert_eq(both.opens[1].graphics, "pipeline")
    assert(rdp_server_closed_setup(msg))
    // A server that cannot be reached is not a setup close.
    mut gone := new_fake_desktop("ab:cd", "s3cret")
    gone.rtt = 1
    gone.fail_from = 1
    msg = ""
    open_remote_desktop(crypto, mut store, s, mut gone, no_prompter(), mut ui0, rdp_req("win")) or err { msg = "{err.message()}" }
    assert_eq(gone.opens.len(), 1)
    assert_eq(error_code_of(msg), ERR_NETWORK)
    assert_eq(ui0.saves, 0)
    assert_eq(ui0.saved.rdp_pipeline_hosts.len(), 0)
}
