package application

// SSH use cases: resolve a host's jump chain and auth plan from the vault, verify
// every server key against the known hosts, authenticate each hop, then run an
// interactive shell or a command.
//
// Secrets are opened here, just before they are handed to the transport, and go
// nowhere else (Principle 6). Every network step is bounded (Principle 8).

import "../domain"
import "../ports"

// `run_initial_command` false starts a plain shell even when the host has an initial
// command (`connect --no-command`). `ask_password` false never asks for a password
// when the stored methods fail (a connection test reports the failure instead).
type ConnectOptions struct {
    timeout_secs: i64
    accept_new_host_key: bool
    run_initial_command: bool
    ask_password: bool
}

fn default_connect_options() -> ConnectOptions {
    return ConnectOptions{ timeout_secs: SSH_CONNECT_TIMEOUT_SECS, accept_new_host_key: false, run_initial_command: true, ask_password: true }
}

fn key_index_by_id(keys: []SshKey, id: str) -> i64 {
    for i, k in keys {
        if k.id == id {
            return i64(i)
        }
    }
    return -1
}

fn cred_index_by_id(creds: []Credential, id: str) -> i64 {
    for i, c in creds {
        if c.id == id {
            return i64(i)
        }
    }
    return -1
}

// ---- Planning (pure) -------------------------------------------------------------

// The hops to dial, outermost jump host first and `target` last.
fn jump_chain(cat: Catalog, target: Host) -> []Host! {
    mut rev: []Host = [target]
    mut cur := target.jump_host_id
    for cur.len() > 0 {
        if rev.len() > cat.hosts.len() {
            return error(coded(ERR_INVALID, "the jump hosts of '{target.alias}' make a loop"))
        }
        idx := host_index_by_id(cat.hosts, cur)
        if idx < 0 {
            return error(coded(ERR_NOT_FOUND, "a jump host of '{target.alias}' no longer exists"))
        }
        hop := cat.hosts[usize(idx)]
        rev.push(hop)
        cur = hop.jump_host_id
    }
    mut chain: []Host = []
    mut i := rev.len()
    for i > 0 {
        i -= 1
        chain.push(rev[i])
    }
    return chain
}

// The login user: the host's own, else its credential's.
fn auth_user(cat: Catalog, h: Host) -> str! {
    if h.username.len() > 0 {
        return h.username
    }
    if h.credential_id.len() > 0 {
        idx := cred_index_by_id(cat.creds, h.credential_id)
        if idx >= 0 && cat.creds[usize(idx)].username.len() > 0 {
            return cat.creds[usize(idx)].username
        }
    }
    return error(coded(ERR_INVALID, "host '{h.alias}' has no user; set one with `flint host edit {h.alias} --user <user>` or link a credential"))
}

// The auth methods to try, in order: the host's key, the host's password, the
// credential's key, the credential's password, then the SSH agent. The host's own
// settings come first because they are the more specific ones.
fn auth_steps(cat: Catalog, h: Host) -> []AuthStep {
    mut steps: []AuthStep = []
    if h.key_id.len() > 0 {
        steps.push(AuthStep{ kind: "key", source: "host", ref_id: h.key_id })
    }
    if h.password.len() > 0 {
        steps.push(AuthStep{ kind: "password", source: "host", ref_id: h.id })
    }
    if h.credential_id.len() > 0 {
        idx := cred_index_by_id(cat.creds, h.credential_id)
        if idx >= 0 {
            c := cat.creds[usize(idx)]
            if c.key_id.len() > 0 && c.key_id != h.key_id {
                steps.push(AuthStep{ kind: "key", source: "credential", ref_id: c.key_id })
            }
            if c.password.len() > 0 {
                steps.push(AuthStep{ kind: "password", source: "credential", ref_id: c.id })
            }
        }
    }
    steps.push(AuthStep{ kind: "agent", source: "", ref_id: "" })
    return steps
}

// How a step is named in an error. Names only, never a secret.
fn step_label(cat: Catalog, s: AuthStep) -> str {
    if s.kind == "key" {
        return "key '" + key_name_of(cat.keys, s.ref_id) + "'"
    }
    if s.kind == "password" {
        if s.source == "host" {
            return "host password"
        }
        return "credential '" + cred_name_of(cat.creds, s.ref_id) + "' password"
    }
    return "SSH agent"
}

fn join_labels(list: []str) -> str {
    mut out_text := ""
    for i, s in list {
        if i > 0 {
            out_text = out_text + ", "
        }
        out_text = out_text + s
    }
    return out_text
}

// ---- Host keys -------------------------------------------------------------------

// Checks a server key against the known hosts. A new key is recorded when the
// person confirms it (or `accept_new_host_key` is set); a changed key is always
// refused. Returns "known" or "new".
fn verify_host_key[S: VaultStore, P: Prompter](mut store: S, prompter: P, h: Host, key: ServerKey, opts: ConnectOptions) -> str! {
    addr := known_host_addr(h.hostname, h.port)
    known := try store.known_hosts_all()
    status := check_server_key(known, addr, key)
    if status == HOST_KEY_KNOWN {
        return status
    }
    if status == HOST_KEY_CHANGED {
        mut q := HostKeyQuestion{ alias: h.alias, addr: addr, key_type: key.key_type, fingerprint: key.fingerprint, known_key_type: "", known_fingerprint: "" }
        for k in known {
            if k.addr == addr {
                q.known_key_type = k.key_type
                q.known_fingerprint = k.fingerprint
            }
        }
        prompter.host_key_changed(q)
        return error(coded(ERR_HOST_KEY, "the host key of '{h.alias}' ({addr}) has CHANGED; it is now {key.key_type} {key.fingerprint}. Someone may be intercepting the connection. If the server was reinstalled, run `flint known-host rm {h.alias}` and connect again"))
    }
    mut trusted := opts.accept_new_host_key
    if !trusted {
        if !prompter.prompt_available() {
            return error(coded(ERR_HOST_KEY, "'{h.alias}' ({addr}) is not a known host and there is no terminal to confirm its key ({key.key_type} {key.fingerprint}); connect once from a terminal, or pass --accept-new-host-key"))
        }
        trusted = try prompter.prompt_host_key(HostKeyQuestion{ alias: h.alias, addr: addr, key_type: key.key_type, fingerprint: key.fingerprint, known_key_type: "", known_fingerprint: "" })
    }
    if !trusted {
        return error(coded(ERR_HOST_KEY, "the host key of '{h.alias}' was not trusted"))
    }
    try store.known_host_put(KnownHost{ addr: addr, key_type: key.key_type, fingerprint: key.fingerprint, host_id: h.id, added_at: "" })
    return status
}

// ---- Authentication --------------------------------------------------------------

fn try_auth_step[C: Crypto, T: SshTransport](crypto: C, session: VaultSession, cat: Catalog, mut link: T, s: AuthStep) -> void! {
    if s.kind == "key" {
        idx := key_index_by_id(cat.keys, s.ref_id)
        if idx < 0 {
            return error(coded(ERR_NOT_FOUND, "a linked key no longer exists"))
        }
        k := cat.keys[usize(idx)]
        // Each opened secret is wiped once the transport has it (milestone 36, D-085).
        private_key := try open_secret(crypto, session, "ssh_keys", k.id, "private_key", k.private_key)
        defer crypto.wipe_text(private_key)
        passphrase := try open_secret(crypto, session, "ssh_keys", k.id, "passphrase", k.passphrase)
        defer crypto.wipe_text(passphrase)
        try link.link_auth_key(private_key, passphrase)
        return
    }
    if s.kind == "password" {
        mut table := "hosts"
        mut sealed: []byte = []
        if s.source == "host" {
            idx := host_index_by_id(cat.hosts, s.ref_id)
            if idx >= 0 {
                sealed = cat.hosts[usize(idx)].password
            }
        } else {
            table = "credentials"
            idx := cred_index_by_id(cat.creds, s.ref_id)
            if idx >= 0 {
                sealed = cat.creds[usize(idx)].password
            }
        }
        password := try open_secret(crypto, session, table, s.ref_id, "password", sealed)
        defer crypto.wipe_text(password)
        try link.link_auth_password(password)
        return
    }
    try link.link_auth_agent()
}

// Tries each auth step until one is accepted. A rejected step moves on; a network
// failure stops at once. When every step fails and there is a terminal, the
// password is asked for once.
fn authenticate_hop[C: Crypto, T: SshTransport, P: Prompter](crypto: C, session: VaultSession, cat: Catalog, mut link: T, prompter: P, h: Host, user: str, ask_password: bool) -> void! {
    mut tried: []str = []
    for s in auth_steps(cat, h) {
        try_auth_step(crypto, session, cat, mut link, s) or err {
            msg := "{err.message()}"
            if error_code_of(msg) != ERR_AUTH {
                return error(msg)
            }
            tried.push(step_label(cat, s))
            continue
        }
        return
    }
    if ask_password && prompter.prompt_available() {
        typed := try prompter.prompt_password(user, h.alias)
        defer crypto.wipe_text(typed)
        if typed.len() > 0 {
            mut accepted := true
            link.link_auth_password(typed) or err {
                accepted = false
                msg := "{err.message()}"
                if error_code_of(msg) != ERR_AUTH {
                    return error(msg)
                }
                tried.push("typed password")
            }
            if accepted {
                return
            }
        }
    }
    return error(coded(ERR_AUTH, "{user}@{h.alias}: no auth method was accepted (tried: {join_labels(tried)})"))
}

// ---- Connecting ------------------------------------------------------------------

// Dials every hop of `alias`, verifying and authenticating each one. On failure the
// link is hung up. Returns the target host.
fn open_link[C: Crypto, S: VaultStore, T: SshTransport, P: Prompter](crypto: C, mut store: S, session: VaultSession, mut link: T, prompter: P, alias: str, opts: ConnectOptions) -> Host! {
    cat := try load_catalog(store)
    target := try require_host(cat.hosts, alias)
    _ := try open_link_in(crypto, mut store, session, cat, mut link, prompter, target, opts)
    return target
}

// Dials every hop of `target`, a host of `cat` (which may hold an unsaved draft).
// Returns the number of hops.
fn open_link_in[C: Crypto, S: VaultStore, T: SshTransport, P: Prompter](crypto: C, mut store: S, session: VaultSession, cat: Catalog, mut link: T, prompter: P, target: Host, opts: ConnectOptions) -> i64! {
    if opts.timeout_secs <= 0 {
        return error(coded(ERR_INVALID, "the connect timeout must be positive"))
    }
    try require_ssh_host(target, "an SSH session")
    chain := try jump_chain(cat, target)
    // Resolve every user before dialling anything.
    mut users: []str = []
    for hop in chain {
        users.push(try auth_user(cat, hop))
    }
    for i, hop in chain {
        open_hop(crypto, mut store, session, cat, mut link, prompter, hop, users[i], opts) or err {
            link.link_hangup()
            return error("{err.message()}")
        }
    }
    return i64(chain.len())
}

fn open_hop[C: Crypto, S: VaultStore, T: SshTransport, P: Prompter](crypto: C, mut store: S, session: VaultSession, cat: Catalog, mut link: T, prompter: P, hop: Host, user: str, opts: ConnectOptions) -> void! {
    algos := preferred_host_key_algos(try store.known_hosts_all(), known_host_addr(hop.hostname, hop.port))
    try link.link_dial(hop.hostname, hop.port, user, opts.timeout_secs, algos)
    key := try link.link_server_key()
    _ := try verify_host_key(mut store, prompter, hop, key, opts)
    try authenticate_hop(crypto, session, cat, mut link, prompter, hop, user, opts.ask_password)
}

// Runs an interactive shell (or `command` on the PTY, "" for the login shell) until
// the remote side closes it or local input ends. Returns the remote exit status (-1
// when the shell died by a signal). After SSH_KEEPALIVE_SECS with nothing heard from
// the server it sends a keepalive; one that cannot be sent ends the session.
fn run_shell[T: SshTransport, M: Terminal, K: Clock](mut link: T, mut term: M, mut clock: K, term_name: str, command: str) -> i64! {
    mut size := term.term_size()
    if !size.is_valid() {
        size = default_terminal_size()
    }
    try link.link_shell_open(term_name, size.cols, size.rows, command)
    try term.term_raw_enter()
    mut code: i64 = 0
    mut failure := ""
    mut running := true
    keepalive_ms := SSH_KEEPALIVE_SECS * 1000
    mut last_heard := clock.clock_now_ms()
    for running {
        // `continue` with `running` false ends the loop, skipping the steps below as
        // their `running` checks did.
        chunk := link.link_channel_read(10) or err {
            failure = "{err.message()}"
            running = false
            continue
        }
        now := clock.clock_now_ms()
        if chunk.stdout.len() > 0 {
            term.term_output(chunk.stdout)
            last_heard = now
        }
        if chunk.stderr.len() > 0 {
            term.term_output(chunk.stderr)
            last_heard = now
        }
        if chunk.done {
            code = chunk.exit_code
            running = false
        } else if now - last_heard >= keepalive_ms {
            link.link_keepalive() or err {
                failure = "{err.message()}"
                running = false
            }
            last_heard = now
        }
        if running {
            typed := term.term_input(10) or {
                // Local input ended (stdin closed): end the session.
                running = false
                continue
            }
            if typed.len() > 0 {
                link.link_channel_write(typed) or err {
                    failure = "{err.message()}"
                    running = false
                }
            }
        }
        if running && term.term_take_resize() {
            now := term.term_size()
            if now.is_valid() {
                _ := link.link_channel_resize(now.cols, now.rows)
            }
        }
    }
    term.term_raw_leave()
    if failure.len() > 0 {
        return error(failure)
    }
    return code
}

// Runs one command. With `capture`, stdout and stderr are collected into the
// result (for --json); otherwise they stream to `sink` as they arrive.
fn run_exec[T: SshTransport, O: ExecSink, K: Clock](mut link: T, mut sink: O, mut clock: K, alias: str, command: str, timeout_secs: i64, capture: bool) -> ExecResult! {
    if command.len() == 0 {
        return error(coded(ERR_USAGE, "no command given; use `flint exec <alias> -- <command>`"))
    }
    if timeout_secs <= 0 {
        return error(coded(ERR_INVALID, "the exec timeout must be positive"))
    }
    start := clock.clock_now_ms()
    deadline := start + timeout_secs * 1000
    try link.link_exec_start(command)
    mut res := ExecResult{ host: alias, exit_code: 0, signal: "", stdout: "", stderr: "", duration_ms: 0 }
    mut running := true
    for running {
        if clock.clock_now_ms() > deadline {
            return error(coded(ERR_TIMEOUT, "the command on '{alias}' did not finish within {timeout_secs}s"))
        }
        chunk := try link.link_channel_read(100)
        if capture {
            res.stdout = res.stdout + chunk.stdout
            res.stderr = res.stderr + chunk.stderr
        } else {
            if chunk.stdout.len() > 0 {
                sink.exec_stdout(chunk.stdout)
            }
            if chunk.stderr.len() > 0 {
                sink.exec_stderr(chunk.stderr)
            }
        }
        if chunk.done {
            res.exit_code = chunk.exit_code
            res.signal = chunk.signal
            running = false
        }
    }
    res.duration_ms = clock.clock_now_ms() - start
    return res
}

// Connects to `alias` and runs one command on it.
fn exec_on_host[C: Crypto, S: VaultStore, T: SshTransport, P: Prompter, O: ExecSink, K: Clock](crypto: C, mut store: S, session: VaultSession, mut link: T, prompter: P, mut sink: O, mut clock: K, alias: str, command: str, opts: ConnectOptions, exec_timeout_secs: i64, capture: bool) -> ExecResult! {
    if command.len() == 0 {
        return error(coded(ERR_USAGE, "no command given; use `flint exec <alias> -- <command>`"))
    }
    try require_ssh_alias(store, alias, "flint exec")
    target := try open_link(crypto, mut store, session, mut link, prompter, alias, opts)
    defer link.link_hangup()
    return run_exec(mut link, mut sink, mut clock, target.alias, command, exec_timeout_secs, capture)
}

// The PTY command of a session on `h`: its initial command (D-031), unless the
// options turn it off.
fn session_command(h: Host, opts: ConnectOptions) -> str {
    if !opts.run_initial_command {
        return ""
    }
    return initial_command_line(h.initial_command, h.keep_shell)
}

// Connects to `alias` and runs an interactive shell on the local terminal, or the
// host's initial command.
fn connect_host[C: Crypto, S: VaultStore, T: SshTransport, P: Prompter, M: Terminal, K: Clock](crypto: C, mut store: S, session: VaultSession, mut link: T, prompter: P, mut term: M, mut clock: K, alias: str, term_name: str, opts: ConnectOptions) -> i64! {
    target := try open_link(crypto, mut store, session, mut link, prompter, alias, opts)
    defer link.link_hangup()
    return run_shell(mut link, mut term, mut clock, term_name, session_command(target, opts))
}

// The app's second Files pane on a host with no open tab (milestone 19, D-056):
// connects to `alias` as a session does (host key, login, prompts, jump hosts),
// opens no PTY, and lends the session to the Files view until the pane closes
// (`term` input ends: returns 0) or the connection is lost (a keepalive that cannot
// be sent). `term` carries no bytes; it is only the pane's mailbox, and
// `term_raw_enter` tells the page the session is ready. Hangs up either way.
fn hold_files_session[C: Crypto, S: VaultStore, T: SshTransport, P: Prompter, M: Terminal, K: Clock](crypto: C, mut store: S, session: VaultSession, mut link: T, prompter: P, mut term: M, mut clock: K, alias: str, opts: ConnectOptions) -> i64! {
    _ := try open_link(crypto, mut store, session, mut link, prompter, alias, opts)
    link.link_lend() or err {
        link.link_hangup()
        return error("{err.message()}")
    }
    term.term_raw_enter() or err {
        link.link_hangup()
        return error("{err.message()}")
    }
    keepalive_ms := SSH_KEEPALIVE_SECS * 1000
    mut last := clock.clock_now_ms()
    mut failure := ""
    mut running := true
    for running {
        term.term_input(250) or {
            running = false
            continue
        }
        now := clock.clock_now_ms()
        if now - last >= keepalive_ms {
            link.link_keepalive() or err {
                failure = "{err.message()}"
                running = false
            }
            last = now
        }
    }
    term.term_raw_leave()
    link.link_hangup()
    if failure.len() > 0 {
        return error(failure)
    }
    return 0
}

// ---- Testing a host ---------------------------------------------------------------

// Connects to `target` through its jump hosts, verifying every host key and
// authenticating every hop, then hangs up. No shell, no command, no password prompt:
// a method that fails is reported (D-019 codes). A new host key is recorded as on a
// real connect, once the person trusts it.
fn test_link[C: Crypto, S: VaultStore, T: SshTransport, P: Prompter, K: Clock](crypto: C, mut store: S, session: VaultSession, cat: Catalog, mut link: T, prompter: P, mut clock: K, target: Host, opts: ConnectOptions) -> HostTestView! {
    mut o := opts
    o.ask_password = false
    start := clock.clock_now_ms()
    hops := try open_link_in(crypto, mut store, session, cat, mut link, prompter, target, o)
    link.link_hangup()
    mut t := target.hostname
    user := auth_user(cat, target) or ""
    if user.len() > 0 {
        t = user + "@" + t
    }
    if target.port != 22 {
        t = t + ":{target.port}"
    }
    return HostTestView{ host: target.alias, target: t, hops: hops, duration_ms: clock.clock_now_ms() - start }
}

// `flint host test <alias>`: tests a saved host.
fn test_host[C: Crypto, S: VaultStore, T: SshTransport, P: Prompter, K: Clock](crypto: C, mut store: S, session: VaultSession, mut link: T, prompter: P, mut clock: K, alias: str, opts: ConnectOptions) -> HostTestView! {
    cat := try load_catalog(store)
    target := try require_host(cat.hosts, alias)
    return test_link(crypto, mut store, session, cat, mut link, prompter, mut clock, target, opts)
}

// Tests the host editor's unsaved form: `p` applied to the host `alias` ("" for a new
// host), without writing it. The folder is ignored (it never affects a connection
// and setting it could create groups). A new host has no id yet, so a key trusted
// during the test is recorded with no host; add_host links it once the host is
// saved.
fn test_host_draft[C: Crypto, S: VaultStore, T: SshTransport, P: Prompter, K: Clock](crypto: C, mut store: S, session: VaultSession, mut link: T, prompter: P, mut clock: K, alias: str, p: HostPatch, opts: ConnectOptions) -> HostTestView! {
    cat := try load_catalog(store)
    mut base := Host{ id: "", alias: "", label: "", hostname: "", port: 22, username: "", group_id: "", tags: [], color: "", notes: "", jump_host_id: "", credential_id: "", key_id: "", password: [], initial_command: "", keep_shell: true, sudo_password: [] }
    if alias.len() > 0 {
        base = try require_host(cat.hosts, alias)
    }
    if !p.set_hostname && base.hostname.len() == 0 {
        return error(coded(ERR_USAGE, "a host needs a hostname to be tested"))
    }
    mut q := p
    q.set_group = false
    draft := try apply_host_patch(crypto, mut store, session, cat, base, q)
    mut hosts: []Host = []
    for h in cat.hosts {
        if h.id != draft.id {
            hosts.push(h)
        }
    }
    hosts.push(draft)
    with_draft := Catalog{ groups: cat.groups, hosts: hosts, keys: cat.keys, creds: cat.creds }
    return test_link(crypto, mut store, session, with_draft, mut link, prompter, mut clock, draft, opts)
}

// ---- Known hosts -----------------------------------------------------------------

fn known_host_view(cat: Catalog, k: KnownHost) -> KnownHostView {
    return KnownHostView{ addr: k.addr, host: host_alias_of(cat.hosts, k.host_id), key_type: k.key_type, fingerprint: k.fingerprint, added_at: k.added_at }
}

fn list_known_hosts[S: VaultStore](store: S) -> []KnownHostView! {
    cat := try load_catalog(store)
    mut views: []KnownHostView = []
    for k in try store.known_hosts_all() {
        views.push(known_host_view(cat, k))
    }
    return views
}

// Forgets a recorded key, by host alias or by address, so the next connect asks
// again.
fn remove_known_host[S: VaultStore](mut store: S, selector: str) -> KnownHostView! {
    cat := try load_catalog(store)
    mut addr := selector
    idx := host_index_by_alias(cat.hosts, selector)
    if idx >= 0 {
        h := cat.hosts[usize(idx)]
        addr = known_host_addr(h.hostname, h.port)
    }
    for k in try store.known_hosts_all() {
        if lower_ascii(k.addr) == lower_ascii(addr) {
            try store.known_host_drop(k.addr)
            return known_host_view(cat, k)
        }
    }
    return error(coded(ERR_NOT_FOUND, "no known host key for '{selector}'"))
}
