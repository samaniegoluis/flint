package application

// File use cases over SFTP (milestone 16): list, stat, rename, remove and mkdir on a
// host, and copying files and folders between this machine and the host, in either
// direction, for `flint cp` and the Files view (milestone 17).
//
// A copy is written once for both directions: each primitive picks the side it acts
// on (`side_*`), the host's (`SftpTransport`) or this machine's (`LocalFiles`).
// Every file lands under a temporary name in its folder (`.<name>.flint-part`) and
// is renamed only once complete; a failure or a cancel removes the partial file.

import "../domain"
import "../ports"

// What `copy_files` copies: `local` and `remote` paths, the direction, `-r` and
// `--force`. A copy between two hosts (`COPY_RELAY`, milestone 18) reads `remote` on
// `alias` and writes `local`, which is then a path on `to_alias`.
type CopyRequest struct {
    id:        str
    alias:     str
    direction: str
    local:     str
    remote:    str
    recursive: bool
    force:     bool
    to_alias:  str
}

// ---- Thin use cases (the Files view) ----------------------------------------------

fn list_dir[T: ports.SftpTransport](sftp: T, path: str) -> []domain.FileEntry! {
    return try sftp.sftp_list(path)
}

// The absolute form of `path` on the host: "." is the login folder, where the Files
// view starts.
fn real_path[T: ports.SftpTransport](sftp: T, path: str) -> str! {
    return try sftp.sftp_realpath(path)
}

fn stat_path[T: ports.SftpTransport](sftp: T, path: str) -> domain.FileEntry! {
    return try sftp.sftp_stat(path)
}

fn rename_path[T: ports.SftpTransport](mut sftp: T, from: str, to: str) -> void! {
    if remote_base(to).len() == 0 || remote_base(to) == "." || remote_base(to) == ".." {
        return error(coded(ERR_INVALID, "'{to}' is not a name a file can have"))
    }
    mut taken := true
    sftp.sftp_stat(to) or {
        taken = false
    }
    if taken {
        return error(coded(ERR_EXISTS, "{to} already exists on the host"))
    }
    try sftp.sftp_rename(from, to)
}

// Removes a file, or a folder with everything in it: the tree is walked breadth
// first, its files removed on the way, then its folders deepest first.
fn remove_remote[T: ports.SftpTransport](mut sftp: T, path: str) -> void! {
    entry := try sftp.sftp_stat(path)
    if !entry.is_dir() {
        try sftp.sftp_remove(path, false)
        return
    }
    mut folders: []str = [path]
    mut i: usize = 0
    for i < folders.len() {
        dir := folders[i]
        i += 1
        for e in try sftp.sftp_list(dir) {
            if e.is_dir() {
                folders.push(e.path)
            } else {
                try sftp.sftp_remove(e.path, false)
            }
        }
    }
    mut k := folders.len()
    for k > 0 {
        k -= 1
        try sftp.sftp_remove(folders[k], true)
    }
}

fn make_dir[T: ports.SftpTransport](mut sftp: T, path: str) -> void! {
    try sftp.sftp_mkdir(path)
}

// ---- One primitive, either side ----------------------------------------------------

// side_stat for a caller that goes on either way: the entry lands in `entry`, and the
// result is the error message, "" when the path was found.
fn side_stat_into[T: ports.SftpTransport, L: ports.LocalFiles](remote: bool, sftp: T, local: L, path: str, mut entry: domain.FileEntry) -> str {
    entry = side_stat(remote, sftp, local, path) or err {
        return "{err.message()}"
    }
    return ""
}

fn side_stat[T: ports.SftpTransport, L: ports.LocalFiles](remote: bool, sftp: T, local: L, path: str) -> domain.FileEntry! {
    if remote {
        return try sftp.sftp_stat(path)
    }
    return try local.local_stat(path)
}

fn side_list[T: ports.SftpTransport, L: ports.LocalFiles](remote: bool, sftp: T, local: L, path: str) -> []domain.FileEntry! {
    if remote {
        return try sftp.sftp_list(path)
    }
    return try local.local_list(path)
}

fn side_open[T: ports.SftpTransport, L: ports.LocalFiles](remote: bool, mut sftp: T, mut local: L, path: str, write: bool) -> void! {
    if remote {
        try sftp.sftp_file_open(path, write, false)
        return
    }
    try local.local_file_open(path, write, false)
    return
}

fn side_read[T: ports.SftpTransport, L: ports.LocalFiles](remote: bool, mut sftp: T, mut local: L) -> str! {
    if remote {
        return try sftp.sftp_file_read()
    }
    return try local.local_file_read()
}

fn side_write[T: ports.SftpTransport, L: ports.LocalFiles](remote: bool, mut sftp: T, mut local: L, data: str) -> void! {
    if remote {
        try sftp.sftp_file_write(data)
        return
    }
    try local.local_file_write(data)
    return
}

fn side_close[T: ports.SftpTransport, L: ports.LocalFiles](remote: bool, mut sftp: T, mut local: L) -> void! {
    if remote {
        try sftp.sftp_file_close()
        return
    }
    try local.local_file_close()
    return
}

fn side_rename[T: ports.SftpTransport, L: ports.LocalFiles](remote: bool, mut sftp: T, mut local: L, from: str, to: str) -> void! {
    if remote {
        try sftp.sftp_rename(from, to)
        return
    }
    try local.local_rename(from, to)
    return
}

// Removes a file; "" when it went, else why not.
fn side_remove[T: ports.SftpTransport, L: ports.LocalFiles](remote: bool, mut sftp: T, mut local: L, path: str) -> str {
    if remote {
        sftp.sftp_remove(path, false) or err {
            return "{err.message()}"
        }
        return ""
    }
    local.local_remove(path) or err {
        return "{err.message()}"
    }
    return ""
}

fn side_mkdir[T: ports.SftpTransport, L: ports.LocalFiles](remote: bool, mut sftp: T, mut local: L, path: str) -> void! {
    if remote {
        try sftp.sftp_mkdir(path)
        return
    }
    try local.local_mkdir(path)
    return
}

// How messages name a side: " on the host" and "" (this machine); in a copy between
// two hosts, each by its alias.
fn side_name(req: CopyRequest, remote: bool) -> str {
    if req.direction == COPY_RELAY {
        if remote {
            return " on {req.alias}"
        }
        return " on {req.to_alias}"
    }
    if remote {
        return " on the host"
    }
    return ""
}

// ---- Copying ------------------------------------------------------------------------

// Where `src` (named `name`) lands when copied to `dst`, as cp and scp place it: into
// `dst` when it is a folder, else at `dst` itself, whose folder must exist. A folder
// is never copied over a file.
fn copy_target[T: ports.SftpTransport, L: ports.LocalFiles](remote: bool, sftp: T, local: L, dst: str, name: str, src_is_dir: bool, on: str) -> str! {
    mut st := domain.FileEntry{ name: "", path: "", kind: "", size: 0, mtime: 0, mode: 0, uid: 0 }
    msg := side_stat_into(remote, sftp, local, dst, mut st)
    if msg.len() == 0 {
        if st.is_dir() {
            return remote_join(trim_slashes(dst), name)
        }
        if src_is_dir {
            return error(coded(ERR_NOT_DIR, "{dst}{on} is a file, not a folder"))
        }
        return dst
    }
    if error_code_of(msg) != ERR_NOT_FOUND {
        return error(msg)
    }
    if dst.ends_with("/") {
        return error(coded(ERR_NOT_FOUND, "{dst}{on}: no such folder"))
    }
    parent := remote_dir(dst)
    up := side_stat(remote, sftp, local, parent) or err {
        pmsg := "{err.message()}"
        if error_code_of(pmsg) == ERR_NOT_FOUND {
            return error(coded(ERR_NOT_FOUND, "{parent}{on}: no such folder"))
        }
        return error(pmsg)
    }
    if !up.is_dir() {
        return error(coded(ERR_NOT_DIR, "{parent}{on} is not a folder"))
    }
    return dst
}

fn copy_cancelled() -> str {
    return coded(ERR_IO, "the copy was cancelled")
}

// Copies one regular file `src` (of `size` bytes) to `target`, through its part file.
fn copy_one[T: ports.SftpTransport, L: ports.LocalFiles, K: ports.TransferSink](upload: bool, mut sftp: T, mut local: L, mut sink: K, req: CopyRequest, src: str, size: i64, target: str, mut res: domain.CopyResult, mut prog: domain.TransferProgress) -> void! {
    dst_remote := upload
    src_remote := !upload
    mut existing := domain.FileEntry{ name: "", path: "", kind: "", size: 0, mtime: 0, mode: 0, uid: 0 }
    existed := side_stat_into(dst_remote, sftp, local, target, mut existing).len() == 0
    if existed {
        if existing.is_dir() {
            return error(coded(ERR_EXISTS, "{target}{side_name(req, dst_remote)} is a folder; a file cannot replace it"))
        }
        if !req.force {
            return error(coded(ERR_EXISTS, "{target}{side_name(req, dst_remote)} already exists; pass --force to replace it"))
        }
    }
    part := part_path(target)
    // A part file a cut copy left (a dropped channel, a killed CLI) goes first.
    mut stale_part := domain.FileEntry{ name: "", path: "", kind: "", size: 0, mtime: 0, mode: 0, uid: 0 }
    if side_stat_into(dst_remote, sftp, local, part, mut stale_part).len() == 0 {
        stale := side_remove(dst_remote, mut sftp, mut local, part)
        if stale.len() > 0 {
            return error(stale)
        }
    }
    try side_open(src_remote, mut sftp, mut local, src, false)
    side_open(dst_remote, mut sftp, mut local, part, true) or err {
        _ = side_close(src_remote, mut sftp, mut local)
        return error("{err.message()}")
    }
    prog.file = target
    prog.file_bytes = 0
    prog.file_size = size
    sink.transfer_progress(prog)
    mut failure := ""
    for failure.len() == 0 {
        if sink.transfer_cancelled() {
            failure = copy_cancelled()
            break
        }
        chunk := side_read(src_remote, mut sftp, mut local) or err {
            failure = "{err.message()}"
            break
        }
        data := chunk
        if data.len() == 0 {
            break
        }
        side_write(dst_remote, mut sftp, mut local, data) or err {
            failure = "{err.message()}"
            break
        }
        prog.file_bytes += i64(data.len())
        prog.bytes_done += i64(data.len())
        sink.transfer_progress(prog)
    }
    _ = side_close(src_remote, mut sftp, mut local)
    side_close(dst_remote, mut sftp, mut local) or err {
        if failure.len() == 0 {
            failure = "{err.message()}"
        }
    }
    if failure.len() == 0 {
        mut move_failure := ""
        side_rename(dst_remote, mut sftp, mut local, part, target) or err {
            move_failure = "{err.message()}"
        }
        if move_failure.len() > 0 && existed {
            // A server that will not rename over a file: remove it, then rename.
            _ = side_remove(dst_remote, mut sftp, mut local, target)
            side_rename(dst_remote, mut sftp, mut local, part, target) or err {
                failure = "{err.message()}"
            }
        } else if move_failure.len() > 0 {
            failure = move_failure
        }
    }
    if failure.len() > 0 {
        left := side_remove(dst_remote, mut sftp, mut local, part)
        if left.len() > 0 && error_code_of(left) != ERR_NOT_FOUND {
            // The channel that would remove it is gone: say where it is.
            return error("{failure} ({remote_base(part)} may be left in {remote_dir(part)}{side_name(req, dst_remote)}; the next copy of this file removes it)")
        }
        return error(failure)
    }
    prog.files_done += 1
    sink.transfer_progress(prog)
    mut copied := domain.CopiedFile{ source: src, target: target, bytes: prog.file_bytes }
    res.files.push(copied)
    res.bytes += prog.file_bytes
}

// Copies folder `src` to `target` (created when missing, merged when it is there),
// then everything in it. Links to files are copied as files; links to folders and
// special files are skipped and reported.
fn copy_tree[T: ports.SftpTransport, L: ports.LocalFiles, K: ports.TransferSink](upload: bool, mut sftp: T, mut local: L, mut sink: K, req: CopyRequest, src: str, target: str, mut res: domain.CopyResult, mut prog: domain.TransferProgress, depth: i64) -> void! {
    if depth > 64 {
        return error(coded(ERR_INVALID, "{src} is nested more than 64 folders deep"))
    }
    dst_remote := upload
    src_remote := !upload
    mut existing := domain.FileEntry{ name: "", path: "", kind: "", size: 0, mtime: 0, mode: 0, uid: 0 }
    msg := side_stat_into(dst_remote, sftp, local, target, mut existing)
    if msg.len() == 0 {
        if !existing.is_dir() {
            return error(coded(ERR_NOT_DIR, "{target}{side_name(req, dst_remote)} is a file, not a folder"))
        }
    } else {
        if error_code_of(msg) != ERR_NOT_FOUND {
            return error(msg)
        }
        try side_mkdir(dst_remote, mut sftp, mut local, target)
        res.folders += 1
    }
    for e in try side_list(src_remote, sftp, local, src) {
        if sink.transfer_cancelled() {
            return error(copy_cancelled())
        }
        if e.name.ends_with(PART_SUFFIX) {
            continue
        }
        child_target := remote_join(target, e.name)
        mut entry := e
        if e.kind == FILE_KIND_LINK {
            mut followed := domain.FileEntry{ name: "", path: "", kind: "", size: 0, mtime: 0, mode: 0, uid: 0 }
            if side_stat_into(src_remote, sftp, local, e.path, mut followed).len() == 0 && followed.is_file() {
                entry = followed
            }
        }
        if entry.is_dir() {
            try copy_tree(upload, mut sftp, mut local, mut sink, req, e.path, child_target, mut res, mut prog, depth + 1)
        } else if entry.is_file() {
            try copy_one(upload, mut sftp, mut local, mut sink, req, e.path, entry.size, child_target, mut res, mut prog)
        } else {
            res.skipped.push(e.path)
        }
    }
}

// Copies `req.local` to `req.remote` (upload) or back (download) over an open SFTP
// channel. A folder needs `recursive`; an existing file needs `force`.
fn copy_files[T: ports.SftpTransport, L: ports.LocalFiles, K: ports.TransferSink, C: ports.Clock](mut sftp: T, mut local: L, mut sink: K, mut clock: C, req: CopyRequest) -> domain.CopyResult! {
    if req.direction != COPY_UPLOAD && req.direction != COPY_DOWNLOAD && req.direction != COPY_RELAY {
        return error(coded(ERR_INTERNAL, "copy: unknown direction '{req.direction}'"))
    }
    start := clock.clock_now_ms()
    // A relay copy runs as a download whose "local" side is the destination host.
    upload := req.direction == COPY_UPLOAD
    mut src := req.remote
    mut dst := req.local
    if upload {
        src = req.local
        dst = req.remote
    }
    src_remote := !upload
    mut name := remote_base(src)
    if name == "/" || name == "." || name == ".." {
        if !src_remote {
            return error(coded(ERR_INVALID, "name the folder to copy, not '{src}'"))
        }
        // The host's login folder (`web:`) or its parent: copied under its own name.
        src = try sftp.sftp_realpath(src)
        name = remote_base(src)
        if name == "/" {
            return error(coded(ERR_INVALID, "the host's root folder cannot be copied whole"))
        }
    }
    entry := try side_stat(src_remote, sftp, local, src)
    if !entry.is_dir() && !entry.is_file() {
        return error(coded(ERR_INVALID, "{src}{side_name(req, src_remote)} is not a regular file or a folder"))
    }
    if entry.is_dir() && !req.recursive {
        return error(coded(ERR_INVALID, "{src}{side_name(req, src_remote)} is a folder; pass -r to copy it"))
    }
    target := try copy_target(upload, sftp, local, dst, name, entry.is_dir(), side_name(req, upload))
    mut res := domain.CopyResult{ host: req.alias, to_host: req.to_alias, direction: req.direction, files: [], folders: 0, bytes: 0, skipped: [], duration_ms: 0 }
    mut prog := domain.TransferProgress{ id: req.id, file: "", file_bytes: 0, file_size: 0, files_done: 0, bytes_done: 0 }
    if entry.is_dir() {
        try copy_tree(upload, mut sftp, mut local, mut sink, req, src, target, mut res, mut prog, 0)
    } else {
        try copy_one(upload, mut sftp, mut local, mut sink, req, src, entry.size, target, mut res, mut prog)
    }
    res.duration_ms = clock.clock_now_ms() - start
    return res
}

fn open_sftp[T: ports.SftpTransport](mut sftp: T) -> void! {
    try sftp.sftp_open()
}

// The Files view's transfers (milestone 17): a copy over a session that is already
// logged in (a tab's), on an SFTP channel of its own.
fn transfer_files[T: ports.SftpTransport, L: ports.LocalFiles, K: ports.TransferSink, C: ports.Clock](mut sftp: T, mut local: L, mut sink: K, mut clock: C, req: CopyRequest) -> domain.CopyResult! {
    try sftp.sftp_open()
    return try copy_files(mut sftp, mut local, mut sink, mut clock, req)
}

// `flint cp`: connects to `req.alias` (verifying and logging in as `exec` does),
// opens SFTP on that session, copies, and hangs up. `link` serves both
// `SshTransport` and `SftpTransport`, both named in its bound (CF-100).
fn copy_with_host[C: ports.Crypto, S: ports.VaultStore, T: ports.SshTransport + ports.SftpTransport, P: ports.Prompter, L: ports.LocalFiles, K: ports.TransferSink, M: ports.Clock](crypto: C, mut store: S, session: VaultSession, mut link: T, prompter: P, mut local: L, mut sink: K, mut clock: M, req: CopyRequest, opts: ConnectOptions) -> domain.CopyResult! {
    try require_ssh_alias(store, req.alias, "copying files")
    target := try open_link(crypto, mut store, session, mut link, prompter, req.alias, opts)
    open_sftp(mut link) or err {
        link.link_hangup()
        return error("{err.message()}")
    }
    mut r := req
    r.alias = target.alias
    defer link.link_hangup()
    return try copy_files(mut link, mut local, mut sink, mut clock, r)
}

fn label_sftp[T: ports.SftpTransport](mut sftp: T, name: str) {
    sftp.sftp_label(name)
}

// `flint cp a:/path b:/path` (milestone 18): connects to both hosts (each verified
// and logged in as `exec` does, with its own jump hosts), opens SFTP on each, and
// streams the copy from `req.alias` to `req.to_alias` through this process; nothing
// is written to this machine's disk and no credential reaches either host. Both
// links are hung up whatever happens. `to` serves `LocalFiles` over its own SFTP
// channel (adapters/ssh/sftp_far.cf), so its bound names all three ports (CF-100).
fn relay_with_hosts[C: ports.Crypto, S: ports.VaultStore, T: ports.SshTransport + ports.SftpTransport + ports.LocalFiles, P: ports.Prompter, K: ports.TransferSink, M: ports.Clock](crypto: C, mut store: S, session: VaultSession, mut from: T, mut to: T, prompter: P, mut sink: K, mut clock: M, req: CopyRequest, opts: ConnectOptions) -> domain.CopyResult! {
    if req.direction != COPY_RELAY {
        return error(coded(ERR_INTERNAL, "relay: not a copy between two hosts"))
    }
    try require_ssh_alias(store, req.alias, "copying files")
    try require_ssh_alias(store, req.to_alias, "copying files")
    source := try open_link(crypto, mut store, session, mut from, prompter, req.alias, opts)
    open_sftp(mut from) or err {
        from.link_hangup()
        return error("{err.message()}")
    }
    label_sftp(mut from, source.alias)
    dest := open_link(crypto, mut store, session, mut to, prompter, req.to_alias, opts) or err {
        from.link_hangup()
        return error("{err.message()}")
    }
    open_sftp(mut to) or err {
        from.link_hangup()
        to.link_hangup()
        return error("{err.message()}")
    }
    label_sftp(mut to, dest.alias)
    mut r := req
    r.alias = source.alias
    r.to_alias = dest.alias
    defer {
        from.link_hangup()
        to.link_hangup()
    }
    return try copy_files(mut from, mut to, mut sink, mut clock, r)
}

// The Files view's copy between two servers (milestone 19, D-059): both sessions
// are already logged in (a tab's, or a pane's session with no terminal), each lent
// with no channel; each gets an SFTP channel of its own, and the bytes stream from
// `from` to `to` through this process as `flint cp a:/x b:/y` does (D-057), with
// nothing on this machine's disk. `to` serves `LocalFiles` over its channel
// (adapters/ssh/sftp_far.cf), named in its bound (CF-100). Not logged (D-055).
fn relay_between_sessions[T: ports.SftpTransport + ports.LocalFiles, K: ports.TransferSink, C: ports.Clock](mut from: T, mut to: T, mut sink: K, mut clock: C, req: CopyRequest) -> domain.CopyResult! {
    if req.direction != COPY_RELAY {
        return error(coded(ERR_INTERNAL, "relay: not a copy between two hosts"))
    }
    try open_sftp(mut from)
    try open_sftp(mut to)
    label_sftp(mut from, req.alias)
    label_sftp(mut to, req.to_alias)
    return try copy_files(mut from, mut to, mut sink, mut clock, req)
}

// ---- Files dropped from the OS (milestone 17) ----------------------------------------

// Appends a chunk of dropped file `rel` to drop `drop_id`, and returns where the
// drop's top element (`rel`'s first part) is on this machine: what the upload
// then copies.
fn stage_dropped[D: ports.DropStage](mut stage: D, drop_id: str, rel: str, data: str) -> str! {
    if !valid_drop_id(drop_id) {
        return error(coded(ERR_INVALID, "'{drop_id}' is not a drop id"))
    }
    if !valid_drop_path(rel) {
        return error(coded(ERR_INVALID, "'{rel}' is not a path inside a drop"))
    }
    try stage.stage_append(drop_id, rel, data)
    top := rel.split("/")[0]
    return remote_join(stage.stage_folder(drop_id), top)
}

fn discard_dropped[D: ports.DropStage](mut stage: D, drop_id: str) {
    if valid_drop_id(drop_id) {
        stage.stage_discard(drop_id)
    }
}
