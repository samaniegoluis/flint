package application

// The update notice (milestone 52, spec v13, D-106, D-116): fetch the latest
// release's manifest and its signature, verify the signature before reading a byte of
// the manifest (Principle 15), and say what this copy of Flint can do about a newer
// version. Nothing is downloaded or applied here (milestone 53); the check sends
// nothing about this machine. What's new reads the CHANGELOG.md the package carries.

import "core:encoding/base64"
import "core:json"
import "../domain"
import "../ports"

// Where the manifest is, and the key its signature must verify against. The app
// passes UPDATE_FEED_URL and UPDATE_PUBLIC_KEY_HEX's bytes; only a build from source
// may point elsewhere, for its tests (drivers/gui/update.cf).
pub type UpdateSource struct {
    manifest_url: str
    public_key:   []byte
}

UPDATE_SIGNATURE_MAX_BYTES: i64 = 4096
ED25519_SIGNATURE_LEN: usize = 64
ED25519_PUBLIC_KEY_LEN: usize = 32

fn update_signature_url(manifest_url: str) -> str {
    return manifest_url + ".sig"
}

fn not_verified() -> str {
    return domain.coded(domain.ERR_INVALID, "the update information did not pass verification and was ignored")
}

// The manifest, verified and checked. `manifest.json.sig` holds the Ed25519 signature
// of `manifest.json`'s exact bytes, in Base64.
fn fetch_update_manifest[F: ports.UpdateFeed, V: ports.UpdateVerifier](feed: F, verifier: V, src: UpdateSource) -> domain.UpdateManifest! {
    signed := try fetch_signed_manifest(feed, verifier, src)
    return signed.manifest
}

// A manifest as fetched, with the exact bytes and the signature it verified against:
// a Linux package update keeps both beside the package, for root to verify again
// (milestone 54, Principle 17).
type SignedManifest struct {
    body:      []byte
    signature: str
    manifest:  domain.UpdateManifest
}

// `manifest.json`'s bytes and `manifest.json.sig`'s text, verified against `public_key`
// and only then read and checked (Principle 15; root's check, Principle 17).
fn verify_signed_manifest[V: ports.UpdateVerifier](verifier: V, body: []byte, sig_text: str, public_key: []byte, download_prefix: str) -> domain.UpdateManifest! {
    if public_key.len() != ED25519_PUBLIC_KEY_LEN {
        return error(domain.coded(domain.ERR_INTERNAL, "this build of Flint has no key to verify updates with"))
    }
    sig := base64.decode(sig_text.trim()) or {
        return error(not_verified())
    }
    if sig.len() != ED25519_SIGNATURE_LEN || !verifier.update_verify(body, sig, public_key) {
        return error(not_verified())
    }
    // Read only once verified.
    m := json.parse[domain.UpdateManifest](payload: str(body)) or {
        return error(domain.coded(domain.ERR_INVALID, "the update information could not be read"))
    }
    try domain.check_update_manifest_from(m, download_prefix)
    return m
}

fn fetch_signed_manifest[F: ports.UpdateFeed, V: ports.UpdateVerifier](feed: F, verifier: V, src: UpdateSource) -> SignedManifest! {
    if src.public_key.len() != ED25519_PUBLIC_KEY_LEN {
        return error(domain.coded(domain.ERR_INTERNAL, "this build of Flint has no key to verify updates with"))
    }
    body := try feed.update_get(src.manifest_url, domain.UPDATE_MANIFEST_MAX_BYTES)
    sig_file := try feed.update_get(update_signature_url(src.manifest_url), UPDATE_SIGNATURE_MAX_BYTES)
    sig_text := "{str(sig_file).trim()}"
    m := try verify_signed_manifest(verifier, body, sig_text, src.public_key, domain.update_download_prefix(src.manifest_url))
    return SignedManifest{ body: body, signature: sig_text, manifest: m }
}

// One check: its outcome for the page, never an error. A newer version found for the
// first time asks for the toast and records that it was shown (D-116: once per
// version; the status bar keeps saying it).
pub fn check_for_update[F: ports.UpdateFeed, V: ports.UpdateVerifier, S: ports.SettingsStore](feed: F, verifier: V, mut settings: S, src: UpdateSource, here: domain.UpdateHere, now_ms: i64) -> domain.UpdateStatus {
    stored := load_settings(settings) or domain.default_settings()
    m := fetch_update_manifest(feed, verifier, src) or err {
        msg := "{err.message()}"
        mut failed := domain.update_status_idle(here.version, stored.update_check, now_ms)
        failed.state = domain.UPDATE_FAILED
        failed.code = domain.error_code_of(msg)
        failed.message = msg
        return failed
    }
    mut s := domain.update_offer(m, here, stored.update_check, now_ms)
    if s.state == domain.UPDATE_AVAILABLE && stored.update_toast_version != s.version {
        s.toast = true
        mut next := stored
        next.update_toast_version = s.version
        settings.settings_save(next) or {}
    }
    return s
}

// What's new once per version (D-106 (7)): at launch, the versions since the one What's
// new last showed for, newest first, and this version recorded as seen. Nothing on
// the first launch on this machine (it is only recorded) or with no changelog.
pub fn whats_new_at_launch[S: ports.SettingsStore](mut settings: S, changelog: str, current: str) -> []domain.ChangeVersion! {
    mut s := try load_settings(settings)
    shown := domain.whats_new_since(domain.parse_changelog(changelog), s.last_seen_version, current)
    if s.last_seen_version.len() == 0 || domain.version_is_newer(current, s.last_seen_version) {
        s.last_seen_version = current
        try settings.settings_save(s)
    }
    return shown
}

// What's new in this version, asked for (About, the palette, the status bar): the
// newest version in the changelog that is not newer than this one.
pub fn whats_new_here(changelog: str, current: str) -> []domain.ChangeVersion {
    mut out: []domain.ChangeVersion = []
    for c in domain.parse_changelog(changelog) {
        if !domain.version_is_newer(c.version, current) {
            out.push(c)
            return out
        }
    }
    return out
}
