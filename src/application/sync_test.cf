test "after a command, a connected vault with changes syncs; one with none does not call the server" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut a := try machine_a(crypto)
    remote := new_fake_remote()
    _ := try connect_remote(crypto, mut a.store, a.links, remote, a.kc, a.kc, mut a.session, SERVER, "tok", STRONG_PW, "", 1000)
    gets := remote.state().gets
    assert(!(try sync_if_pending(crypto, mut a.store, a.links, remote, a.kc, a.kc, a.session.path, a.session.name, 3000)))
    assert_eq(remote.state().gets, gets)
    try add_stamped(crypto, mut a, "api", 300)
    assert(try sync_if_pending(crypto, mut a.store, a.links, remote, a.kc, a.kc, a.session.path, a.session.name, 3000))
    assert_eq(remote.state().version, 2)
}

test "a connected vault changes its master password in step with its server, never offline" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut a := try machine_a(crypto)
    remote := new_fake_remote()
    _ := try connect_remote(crypto, mut a.store, a.links, remote, a.kc, a.kc, mut a.session, SERVER, "tok", STRONG_PW, "", 1000)
    mut b := try machine_b(crypto, remote, a)
    try add_stamped(crypto, mut b, "db", 400)
    _ := try sync_of(crypto, mut b, remote, "")
    remote.set_offline(true)
    mut msg := ""
    change_master_password_synced(crypto, mut a.store, a.kc, a.links, remote, a.kc, a.session, STRONG_PW, NEW_PW, 3000) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_NETWORK)
    assert(try verify_master_password(crypto, a.store, a.session, STRONG_PW))
    remote.set_offline(false)
    next := try change_master_password_synced(crypto, mut a.store, a.kc, a.links, remote, a.kc, a.session, STRONG_PW, NEW_PW, 3000)
    assert(has_alias(a.store, "db"), "B's change came in under the old password first")
    // The re-keyed vault went up: B is asked for the new password, then has it.
    msg = ""
    sync_of(crypto, mut b, remote, "") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_WRONG_PASSWORD)
    got := try sync_of(crypto, mut b, remote, NEW_PW)
    assert(got.rekeyed)
    assert_eq(next.id, a.session.id)
}

test "a probe tells what the server holds, without a password, and keeps nothing" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut a := try machine_a(crypto)
    remote := new_fake_remote()
    empty := try probe_remote(remote, SERVER + "/", " tok\n")
    assert_eq(empty.vaults.len(), usize(0))
    assert_eq(empty.url, SERVER)
    _ := try connect_remote(crypto, mut a.store, a.links, remote, a.kc, a.kc, mut a.session, SERVER, "tok", STRONG_PW, "", 1000)
    gets := remote.state().gets
    got := try probe_remote(remote, SERVER + "/v1/vaults", "tok")
    assert_eq(got.vaults.len(), usize(1))
    assert_eq(got.vaults[0].id, a.session.id)
    assert_eq(got.vaults[0].version, remote.state().version)
    assert(got.vaults[0].size > 0)
    // The list alone: no vault was downloaded.
    assert_eq(remote.state().gets, gets)
    mut msg := ""
    probe_remote(remote, "http://vault.example.com", "tok") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_INVALID)
    msg = ""
    probe_remote(remote, SERVER, "bad") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_AUTH)
    msg = ""
    probe_remote(remote, SERVER, "  ") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_USAGE)
}

