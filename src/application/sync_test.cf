test "a new token replaces the old one only once the server takes it" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut a := try machine_a(crypto)
    remote := new_fake_remote()
    _ := try connect_remote(crypto, mut a.store, a.links, remote, a.kc, a.kc, mut a.session, SERVER, "tok", STRONG_PW, "", 1000)
    account := remote_token_account(a.session.id)
    mut msg := ""
    replace_remote_token(a.links, remote, a.kc, a.session.path, "bad") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_AUTH)
    assert_eq(str(try a.kc.keychain_load(account)), "tok")
    try a.kc.keychain_save(account, []byte("old"))
    link := try replace_remote_token(a.links, remote, a.kc, a.session.path, " tok\n")
    assert_eq(link.url, SERVER)
    assert_eq(str(try a.kc.keychain_load(account)), "tok")
    msg = ""
    replace_remote_token(a.links, remote, a.kc, "/nowhere.flint", "tok") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_NOT_FOUND)
}

test "the connected vaults are listed by path and server, nothing more" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut a := try machine_a(crypto)
    remote := new_fake_remote()
    assert_eq((try remote_link_views(a.links)).len(), usize(0))
    _ := try connect_remote(crypto, mut a.store, a.links, remote, a.kc, a.kc, mut a.session, SERVER, "tok", STRONG_PW, "", 1000)
    views := try remote_link_views(a.links)
    assert_eq(views.len(), usize(1))
    assert_eq(views[0].path, a.session.path)
    assert_eq(views[0].url, SERVER)
}

// A server whose GET returns only after this machine disconnected the vault (the app's
// Disconnect while a Sync now is on the network).
type DisconnectingRemote struct {
    inner: FakeRemote
    links: FakeLinks
    kc: FakeKeychain
    path: str
}

fn (self: DisconnectingRemote) remote_get(url: str, token: str, known_version: i64) -> RemoteVault! {
    got := try self.inner.remote_get(url, token, known_version)
    _ := try disconnect_remote(self.links, self.kc, self.path)
    return got
}

fn (self: DisconnectingRemote) remote_put(url: str, token: str, vault_id: str, base_version: i64, data: []byte) -> RemoteStored! {
    return self.inner.remote_put(url, token, vault_id, base_version, data)
}

fn (self: DisconnectingRemote) remote_list(url: str, token: str) -> []ServerVault! {
    return self.inner.remote_list(url, token)
}

fn (self: DisconnectingRemote) remote_set_label(url: str, token: str, label: str) -> void! {
    return self.inner.remote_set_label(url, token, label)
}

test "a vault disconnected while its sync is on the network stays disconnected" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut a := try machine_a(crypto)
    remote := new_fake_remote()
    _ := try connect_remote(crypto, mut a.store, a.links, remote, a.kc, a.kc, mut a.session, SERVER, "tok", STRONG_PW, "", 1000)
    try add_stamped(crypto, mut a, "api", 3000)
    slow := DisconnectingRemote{ inner: remote, links: a.links, kc: a.kc, path: a.session.path }
    _ := try sync_vault(crypto, mut a.store, a.links, slow, a.kc, a.kc, mut a.session, "", 4000)
    assert(!remote_connected(a.links, a.session.path), "the sync's end does not put the link back")
    // A sync that fails after the disconnect does not either (an empty server this
    // time, so connecting again uploads instead of merging).
    other := new_fake_remote()
    _ := try connect_remote(crypto, mut a.store, a.links, other, a.kc, a.kc, mut a.session, SERVER, "tok", STRONG_PW, "", 5000)
    try add_stamped(crypto, mut a, "db", 6000)
    _ := sync_vault(crypto, mut a.store, a.links, FailingAfterDisconnect{ links: a.links, kc: a.kc, path: a.session.path }, a.kc, a.kc, mut a.session, "", 7000)
    assert(!remote_connected(a.links, a.session.path), "a failed sync's error is not saved into a link that is gone")
}

// A server that cannot be reached, found only after the vault was disconnected.
type FailingAfterDisconnect struct {
    links: FakeLinks
    kc: FakeKeychain
    path: str
}

fn (self: FailingAfterDisconnect) remote_get(url: str, token: str, known_version: i64) -> RemoteVault! {
    _ := try disconnect_remote(self.links, self.kc, self.path)
    return error(coded(ERR_NETWORK, "cannot reach the server"))
}

fn (self: FailingAfterDisconnect) remote_put(url: str, token: str, vault_id: str, base_version: i64, data: []byte) -> RemoteStored! {
    return error(coded(ERR_NETWORK, "cannot reach the server"))
}

fn (self: FailingAfterDisconnect) remote_list(url: str, token: str) -> []ServerVault! {
    return error(coded(ERR_NETWORK, "cannot reach the server"))
}

fn (self: FailingAfterDisconnect) remote_set_label(url: str, token: str, label: str) -> void! {
    return error(coded(ERR_NETWORK, "cannot reach the server"))
}

// A server whose GET returns only after this machine disconnected the vault and
// connected its path to another server (stood for by the link saved directly).
type ReconnectingRemote struct {
    inner: FakeRemote
    links: FakeLinks
    kc: FakeKeychain
    path: str
    vault_id: str
}

fn (self: ReconnectingRemote) remote_get(url: str, token: str, known_version: i64) -> RemoteVault! {
    got := try self.inner.remote_get(url, token, known_version)
    _ := try disconnect_remote(self.links, self.kc, self.path)
    try save_link(self.links, RemoteLink{ path: self.path, vault_id: self.vault_id, url: OTHER_SERVER, version: 0, synced_hash: "", last_sync: 0, last_attempt: 0, last_error: "" })
    return got
}

fn (self: ReconnectingRemote) remote_put(url: str, token: str, vault_id: str, base_version: i64, data: []byte) -> RemoteStored! {
    return self.inner.remote_put(url, token, vault_id, base_version, data)
}

fn (self: ReconnectingRemote) remote_list(url: str, token: str) -> []ServerVault! {
    return self.inner.remote_list(url, token)
}

fn (self: ReconnectingRemote) remote_set_label(url: str, token: str, label: str) -> void! {
    return self.inner.remote_set_label(url, token, label)
}

OTHER_SERVER: str = "https://other.example.com"

test "a sync's end leaves alone a link connected again while it was on the network" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut a := try machine_a(crypto)
    remote := new_fake_remote()
    _ := try connect_remote(crypto, mut a.store, a.links, remote, a.kc, a.kc, mut a.session, SERVER, "tok", STRONG_PW, "", 1000)
    try add_stamped(crypto, mut a, "api", 3000)
    moved := ReconnectingRemote{ inner: remote, links: a.links, kc: a.kc, path: a.session.path, vault_id: a.session.id }
    _ := try sync_vault(crypto, mut a.store, a.links, moved, a.kc, a.kc, mut a.session, "", 4000)
    l := try load_link(a.links, a.session.path)
    assert_eq(l.url, OTHER_SERVER)
    assert_eq(l.version, i64(0))
    assert_eq(l.last_sync, i64(0))
}

test "a token replaced while its vault is disconnected is not kept" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut a := try machine_a(crypto)
    remote := new_fake_remote()
    _ := try connect_remote(crypto, mut a.store, a.links, remote, a.kc, a.kc, mut a.session, SERVER, "tok", STRONG_PW, "", 1000)
    slow := DisconnectingRemote{ inner: remote, links: a.links, kc: a.kc, path: a.session.path }
    mut msg := ""
    replace_remote_token(a.links, slow, a.kc, a.session.path, "tok") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_NOT_FOUND)
    assert_eq((try a.kc.keychain_load(remote_token_account(a.session.id))).len(), usize(0))
}

test "a write made while a sync finds nothing new is left to upload" {
    crypto := FakeCrypto{ derive_calls: 0 }
    mut a := try machine_a(crypto)
    remote := new_fake_remote()
    _ := try connect_remote(crypto, mut a.store, a.links, remote, a.kc, a.kc, mut a.session, SERVER, "tok", STRONG_PW, "", 1000)
    // Another process writes right after this sync's first read of the file.
    mut bank := a.store.bank
    if true {
        (*bank).reads = 0
    }
    if true {
        (*bank).late_after = 1
    }
    got := try sync_vault(crypto, mut a.store, a.links, remote, a.kc, a.kc, mut a.session, "", 2000)
    assert_eq(got.result, SYNC_IN_STEP)
    assert(remote_pending(crypto, a.store, a.links, a.session.path), "the write waits for the next sync")
}
