package application

import "../domain"

test "settings are validated on save and repaired field by field on load" {
    mut store := FakeSettingsStore{ saved: default_settings() }
    mut s := default_settings()
    s.theme = "dark"
    s.term_font_size = 15
    saved := try save_settings(mut store, s)
    assert_eq(saved.theme, "dark")
    assert_eq((try load_settings(store)).term_font_size, i64(15))

    s.accent = "neon"
    mut refused := false
    save_settings(mut store, s) or {
        refused = true
    }
    assert(refused)
    assert_eq(store.saved.accent, "ember")

    // A hand-edited file with one bad field keeps the good ones.
    mut edited := default_settings()
    edited.theme = "light"
    edited.term_line_height = 999
    edited.reopen_last_vault = false
    edited.term_theme = "aura"
    store.saved = edited
    fixed := try load_settings(store)
    assert_eq(fixed.theme, "light")
    assert_eq(fixed.term_line_height, i64(100))
    assert(!fixed.reopen_last_vault)
    assert_eq(fixed.term_theme, "aura")

    // An empty theme (a hand-edited file) is repaired to the default.
    mut old := default_settings()
    old.accent = "iris"
    old.term_theme = ""
    store.saved = old
    repaired := try load_settings(store)
    assert_eq(repaired.term_theme, "default")
    assert_eq(repaired.accent, "iris")

    // And one from before auto-lock (milestone 11b) locks after an hour, the default.
    mut pre_lock := default_settings()
    pre_lock.lock_after = ""
    pre_lock.term_theme = "nord"
    store.saved = pre_lock
    relocked := try load_settings(store)
    assert_eq(relocked.lock_after, "1h")
    assert_eq(relocked.term_theme, "nord")

    // A paste limit that is not one of the sizes (a file from before milestone 25
    // reads 0, a hand edit 7) falls back to 20 MB and keeps the rest.
    mut odd := default_settings()
    odd.paste_limit_mb = 7
    odd.term_theme = "aura"
    store.saved = odd
    limited := try load_settings(store)
    assert_eq(limited.paste_limit_mb, PASTE_LIMIT_DEFAULT_MB)
    assert_eq(limited.term_theme, "aura")
    odd.paste_limit_mb = 100
    store.saved = odd
    assert_eq((try load_settings(store)).paste_limit_mb, 100)
}

test "installed mono fonts are deduplicated and sorted" {
    fonts := FakeFonts{ names: ["SF Mono", "JetBrains Mono", "", "SF Mono", "Fira Mono"] }
    list := try list_mono_fonts(fonts)
    assert_eq(list.len(), usize(3))
    assert_eq(list[0], "Fira Mono")
    assert_eq(list[2], "SF Mono")
}
