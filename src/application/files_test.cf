package application

// copy_files over two in-memory trees: the host's (FakeSftp) and this machine's
// (FakeLocal), both a FakeTree.

import "../domain"

type FakeNode struct {
    path: str
    kind: str
    data: str
}

// A file system in memory. `fail_write_after` > 0 fails the write that would pass
// that many bytes (a full disk); `no_overwrite_rename` refuses a rename onto a file.
type FakeTree struct {
    nodes: []FakeNode
    open_path: str
    open_write: bool
    read_pos: usize
    chunk: usize
    written: i64
    fail_write_after: i64
    no_overwrite_rename: bool
    // Removing anything fails, as over a channel that died (milestone 18).
    remove_dead: bool
}

fn fake_tree(nodes: []FakeNode) -> FakeTree {
    mut all: []FakeNode = [FakeNode{ path: "/", kind: FILE_KIND_DIR, data: "" }]
    for n in nodes {
        all.push(n)
    }
    return FakeTree{ nodes: all, open_path: "", open_write: false, read_pos: 0, chunk: 4, written: 0, fail_write_after: 0, no_overwrite_rename: false, remove_dead: false }
}

fn fdir(path: str) -> FakeNode {
    return FakeNode{ path: path, kind: FILE_KIND_DIR, data: "" }
}

fn ffile(path: str, data: str) -> FakeNode {
    return FakeNode{ path: path, kind: FILE_KIND_FILE, data: data }
}

fn norm(p: str) -> str {
    return trim_slashes(p)
}

fn (self: FakeTree) find(path: str) -> i64 {
    for i, n in self.nodes {
        if n.path == norm(path) {
            return i64(i)
        }
    }
    return -1
}

fn (self: FakeTree) data_of(path: str) -> str {
    i := self.find(path)
    if i < 0 {
        return "<missing>"
    }
    return self.nodes[usize(i)].data
}

fn (self: FakeTree) has(path: str) -> bool {
    return self.find(path) >= 0
}

fn (self: FakeTree) t_stat(path: str) -> FileEntry! {
    i := self.find(path)
    if i < 0 {
        return error(coded(ERR_NOT_FOUND, "{path}: no such file"))
    }
    n := self.nodes[usize(i)]
    return FileEntry{ name: remote_base(n.path), path: n.path, kind: n.kind, size: i64(n.data.len()), mtime: 0, mode: 420 }
}

fn (self: FakeTree) t_list(path: str) -> []FileEntry! {
    st := try self.t_stat(path)
    if !st.is_dir() {
        return error(coded(ERR_NOT_DIR, "{path}: not a folder"))
    }
    mut entries: []FileEntry = []
    for n in self.nodes {
        if n.path != "/" && remote_dir(n.path) == norm(path) {
            entries.push(FileEntry{ name: remote_base(n.path), path: n.path, kind: n.kind, size: i64(n.data.len()), mtime: 0, mode: 420 })
        }
    }
    return entries
}

fn (mut self: FakeTree) t_open(path: str, write: bool) -> void! {
    if self.open_path.len() > 0 {
        return error(coded(ERR_INTERNAL, "already open"))
    }
    if write {
        parent := self.find(remote_dir(path))
        if parent < 0 {
            return error(coded(ERR_NOT_FOUND, "{path}: no such folder"))
        }
        i := self.find(path)
        if i >= 0 {
            self.nodes[usize(i)].data = ""
        } else {
            self.nodes.push(FakeNode{ path: norm(path), kind: FILE_KIND_FILE, data: "" })
        }
    } else {
        st := try self.t_stat(path)
        if !st.is_file() {
            return error(coded(ERR_INVALID, "{path} is a folder"))
        }
    }
    self.open_path = norm(path)
    self.open_write = write
    self.read_pos = 0
}

fn (mut self: FakeTree) t_read() -> str! {
    data := self.data_of(self.open_path)
    if self.read_pos >= data.len() {
        return ""
    }
    mut n := self.chunk
    if self.read_pos + n > data.len() {
        n = data.len() - self.read_pos
    }
    piece := data.substr(self.read_pos, n)
    self.read_pos += n
    return piece
}

fn (mut self: FakeTree) t_write(data: str) -> void! {
    if self.fail_write_after > 0 && self.written + i64(data.len()) > self.fail_write_after {
        return error(coded(ERR_IO, "no space left"))
    }
    i := self.find(self.open_path)
    self.nodes[usize(i)].data = self.nodes[usize(i)].data + data
    self.written += i64(data.len())
}

fn (mut self: FakeTree) t_close() -> void! {
    self.open_path = ""
}

fn (mut self: FakeTree) t_rename(from: str, to: str) -> void! {
    i := self.find(from)
    if i < 0 {
        return error(coded(ERR_NOT_FOUND, "{from}"))
    }
    j := self.find(to)
    if j >= 0 {
        if self.no_overwrite_rename {
            return error(coded(ERR_IO, "the host refused to rename {from}"))
        }
        try self.t_remove(to)
    }
    k := self.find(from)
    self.nodes[usize(k)].path = norm(to)
}

fn (mut self: FakeTree) t_remove(path: str) -> void! {
    if self.remove_dead {
        return error(coded(ERR_NETWORK, "the SFTP connection was lost while trying to remove {path}"))
    }
    mut kept: []FakeNode = []
    mut found := false
    for n in self.nodes {
        if n.path == norm(path) {
            found = true
        } else {
            kept.push(n)
        }
    }
    if !found {
        return error(coded(ERR_NOT_FOUND, "{path}"))
    }
    self.nodes = kept
}

fn (mut self: FakeTree) t_mkdir(path: str) -> void! {
    if self.has(path) {
        return error(coded(ERR_EXISTS, "{path}"))
    }
    if !self.has(remote_dir(path)) {
        return error(coded(ERR_NOT_FOUND, "{path}"))
    }
    self.nodes.push(fdir(norm(path)))
}

type FakeSftp struct {
    tree: FakeTree
}

fn (mut self: FakeSftp) sftp_open() -> void! {
}
fn (self: FakeSftp) sftp_stat(path: str) -> FileEntry! {
    return self.tree.t_stat(path)
}
fn (self: FakeSftp) sftp_list(path: str) -> []FileEntry! {
    return self.tree.t_list(path)
}
fn (mut self: FakeSftp) sftp_file_open(path: str, write: bool, exclusive: bool) -> void! {
    try self.tree.t_open(path, write)
}
fn (mut self: FakeSftp) sftp_file_read() -> str! {
    return self.tree.t_read()
}
fn (mut self: FakeSftp) sftp_file_write(data: str) -> void! {
    try self.tree.t_write(data)
}
fn (mut self: FakeSftp) sftp_file_close() -> void! {
    try self.tree.t_close()
}
fn (mut self: FakeSftp) sftp_rename(from: str, to: str) -> void! {
    try self.tree.t_rename(from, to)
}
fn (mut self: FakeSftp) sftp_remove(path: str, folder: bool) -> void! {
    try self.tree.t_remove(path)
}
fn (mut self: FakeSftp) sftp_mkdir(path: str) -> void! {
    try self.tree.t_mkdir(path)
}
fn (self: FakeSftp) sftp_realpath(path: str) -> str! {
    if path == "." {
        return "/home/me"
    }
    return path
}
fn (mut self: FakeSftp) sftp_label(name: str) {
}

fn (mut self: FakeSftp) sftp_close() {
}

type FakeLocal struct {
    tree: FakeTree
}

fn (self: FakeLocal) local_stat(path: str) -> FileEntry! {
    return self.tree.t_stat(path)
}
fn (self: FakeLocal) local_list(path: str) -> []FileEntry! {
    return self.tree.t_list(path)
}
fn (mut self: FakeLocal) local_file_open(path: str, write: bool, exclusive: bool) -> void! {
    try self.tree.t_open(path, write)
}
fn (mut self: FakeLocal) local_file_read() -> str! {
    return self.tree.t_read()
}
fn (mut self: FakeLocal) local_file_write(data: str) -> void! {
    try self.tree.t_write(data)
}
fn (mut self: FakeLocal) local_file_close() -> void! {
    try self.tree.t_close()
}
fn (mut self: FakeLocal) local_rename(from: str, to: str) -> void! {
    try self.tree.t_rename(from, to)
}
fn (mut self: FakeLocal) local_remove(path: str) -> void! {
    try self.tree.t_remove(path)
}
fn (mut self: FakeLocal) local_mkdir(path: str) -> void! {
    try self.tree.t_mkdir(path)
}

// Records progress; cancels once `cancel_after` progress reports were made (0: never).
type FakeTransferSink struct {
    reports: i64
    last: TransferProgress
    cancel_after: i64
}

fn (mut self: FakeTransferSink) transfer_progress(p: TransferProgress) {
    self.reports += 1
    self.last = p
}

fn (self: FakeTransferSink) transfer_cancelled() -> bool {
    return self.cancel_after > 0 && self.reports >= self.cancel_after
}

fn quiet_sink() -> FakeTransferSink {
    return FakeTransferSink{ reports: 0, last: TransferProgress{ id: "", file: "", file_bytes: 0, file_size: 0, files_done: 0, bytes_done: 0 }, cancel_after: 0 }
}

fn copy_req(direction: str, local: str, remote: str, recursive: bool, force: bool) -> CopyRequest {
    return CopyRequest{ id: "t1", alias: "web", direction: direction, local: local, remote: remote, recursive: recursive, force: force }
}

fn code_of[T](r: T!) -> str {
    if r.has_value() {
        return "ok"
    }
    return error_code_of("{r.error().message()}")
}

test "an upload into a folder keeps the file's name and reports progress" {
    mut host := FakeSftp{ tree: fake_tree([fdir("/etc"), fdir("/etc/app")]) }
    mut here := FakeLocal{ tree: fake_tree([fdir("/w"), ffile("/w/app.conf", "port=8080\n")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 5 }
    res := try copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/w/app.conf", "/etc/app/", false, false))
    assert_eq(host.tree.data_of("/etc/app/app.conf"), "port=8080\n")
    assert(!host.tree.has("/etc/app/.app.conf.flint-part"))
    assert_eq(res.files.len(), 1)
    assert_eq(res.bytes, 10)
    assert_eq(res.files[0].target, "/etc/app/app.conf")
    assert_eq(res.direction, "upload")
    assert(sink.reports >= 3)
    assert_eq(sink.last.files_done, 1)
    assert_eq(sink.last.bytes_done, 10)
}

test "a download to a new name, and an existing file needs --force" {
    mut host := FakeSftp{ tree: fake_tree([fdir("/var"), fdir("/var/log"), ffile("/var/log/app.log", "line 1\nline 2\n")]) }
    mut here := FakeLocal{ tree: fake_tree([fdir("/w"), ffile("/w/old.log", "old")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    _ := try copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_DOWNLOAD, "/w/new.log", "/var/log/app.log", false, false))
    assert_eq(here.tree.data_of("/w/new.log"), "line 1\nline 2\n")
    refused := copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_DOWNLOAD, "/w/old.log", "/var/log/app.log", false, false))
    assert_eq(code_of(refused), ERR_EXISTS)
    assert_eq(here.tree.data_of("/w/old.log"), "old")
    _ := try copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_DOWNLOAD, "/w/old.log", "/var/log/app.log", false, true))
    assert_eq(here.tree.data_of("/w/old.log"), "line 1\nline 2\n")
}

test "a server that will not rename over a file gets the old one removed first" {
    mut host := FakeSftp{ tree: fake_tree([fdir("/etc"), ffile("/etc/a", "old")]) }
    host.tree.no_overwrite_rename = true
    mut here := FakeLocal{ tree: fake_tree([ffile("/a", "new!")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    _ := try copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/a", "/etc/a", false, true))
    assert_eq(host.tree.data_of("/etc/a"), "new!")
}

test "stable errors: not found, a folder without -r, a missing folder, not a directory" {
    mut host := FakeSftp{ tree: fake_tree([fdir("/etc"), ffile("/etc/hosts", "x")]) }
    mut here := FakeLocal{ tree: fake_tree([fdir("/w"), fdir("/w/site"), ffile("/w/site/index.html", "hi"), ffile("/w/a", "a")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    assert_eq(code_of(copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/w/nope", "/etc/", false, false))), ERR_NOT_FOUND)
    assert_eq(code_of(copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/w/site", "/etc/", false, false))), ERR_INVALID)
    assert_eq(code_of(copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/w/a", "/srv/a", false, false))), ERR_NOT_FOUND)
    assert_eq(code_of(copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/w/a", "/etc/hosts/a", false, false))), ERR_NOT_DIR)
    assert_eq(code_of(copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/w/site", "/etc/hosts", true, false))), ERR_NOT_DIR)
    assert_eq(code_of(copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/w/a", "/nodir/", false, false))), ERR_NOT_FOUND)
    assert_eq(code_of(copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_DOWNLOAD, "/w/", "/etc", false, false))), ERR_INVALID)
}

test "a recursive upload creates the tree and merges into an existing folder" {
    mut host := FakeSftp{ tree: fake_tree([fdir("/srv"), fdir("/srv/site"), ffile("/srv/site/keep.txt", "k")]) }
    mut here := FakeLocal{ tree: fake_tree([fdir("/w"), fdir("/w/site"), ffile("/w/site/index.html", "<h1>"), fdir("/w/site/css"), ffile("/w/site/css/a.css", "body{}"), ffile("/w/site/.x.flint-part", "partial")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    res := try copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/w/site", "/srv/", true, false))
    assert_eq(host.tree.data_of("/srv/site/index.html"), "<h1>")
    assert_eq(host.tree.data_of("/srv/site/css/a.css"), "body{}")
    assert_eq(host.tree.data_of("/srv/site/keep.txt"), "k")
    assert(!host.tree.has("/srv/site/.x.flint-part"))
    assert_eq(res.files.len(), 2)
    assert_eq(res.folders, 1)
    assert_eq(res.bytes, 10)
}

test "a recursive download of a host folder to a new local folder" {
    mut host := FakeSftp{ tree: fake_tree([fdir("/var"), fdir("/var/log"), ffile("/var/log/a.log", "aa"), fdir("/var/log/old"), ffile("/var/log/old/b.log", "bbb")]) }
    mut here := FakeLocal{ tree: fake_tree([fdir("/w")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    res := try copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_DOWNLOAD, "/w/logs", "/var/log", true, false))
    assert_eq(here.tree.data_of("/w/logs/a.log"), "aa")
    assert_eq(here.tree.data_of("/w/logs/old/b.log"), "bbb")
    assert_eq(res.folders, 2)
}

test "a cancelled copy and a failed write leave no partial file" {
    mut host := FakeSftp{ tree: fake_tree([fdir("/etc")]) }
    mut here := FakeLocal{ tree: fake_tree([ffile("/big", "0123456789abcdef")]) }
    mut sink := quiet_sink()
    sink.cancel_after = 2
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    cancelled := copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/big", "/etc/", false, false))
    assert_eq(code_of(cancelled), ERR_IO)
    assert(!host.tree.has("/etc/big"))
    assert(!host.tree.has("/etc/.big.flint-part"))
    mut full := FakeSftp{ tree: fake_tree([fdir("/etc")]) }
    full.tree.fail_write_after = 6
    mut sink2 := quiet_sink()
    failed := copy_files(mut full, mut here, mut sink2, mut clock, copy_req(COPY_UPLOAD, "/big", "/etc/", false, false))
    assert_eq(code_of(failed), ERR_IO)
    assert(!full.tree.has("/etc/.big.flint-part"))
    assert(!full.tree.has("/etc/big"))
}

test "downloading the login folder names it from the host" {
    mut host := FakeSftp{ tree: fake_tree([fdir("/home"), fdir("/home/me"), ffile("/home/me/.bashrc", "x")]) }
    mut here := FakeLocal{ tree: fake_tree([fdir("/w")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    _ := try copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_DOWNLOAD, "/w", ".", true, false))
    assert(here.tree.has("/w/me"))
}

test "remove_remote removes a folder with everything in it; rename refuses a taken name" {
    mut host := FakeSftp{ tree: fake_tree([fdir("/d"), ffile("/d/a", "a"), fdir("/d/e"), ffile("/d/e/b", "b"), ffile("/x", "x")]) }
    try remove_remote(mut host, "/d")
    assert(!host.tree.has("/d") && !host.tree.has("/d/e/b"))
    try make_dir(mut host, "/n")
    assert_eq(code_of(rename_path(mut host, "/n", "/x")), ERR_EXISTS)
    try rename_path(mut host, "/n", "/m")
    assert(host.tree.has("/m"))
}

test "a Files view transfer opens its SFTP channel, then copies" {
    mut host := FakeSftp{ tree: fake_tree([fdir("/srv")]) }
    mut here := FakeLocal{ tree: fake_tree([fdir("/w"), ffile("/w/a.txt", "abc")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    res := try transfer_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/w/a.txt", "/srv/", false, false))
    assert_eq(res.bytes, 3)
    assert_eq(host.tree.data_of("/srv/a.txt"), "abc")
    assert_eq(try real_path(host, "/srv"), "/srv")
}

type FakeDropStage struct {
    appended: []str
    discarded: []str
}

fn (self: FakeDropStage) stage_folder(drop_id: str) -> str {
    return "/cfg/drops/" + drop_id
}

fn (mut self: FakeDropStage) stage_append(drop_id: str, rel: str, data: str) -> void! {
    self.appended.push(drop_id + ":" + rel + "=" + data)
}

fn (mut self: FakeDropStage) stage_discard(drop_id: str) {
    self.discarded.push(drop_id)
}

test "a dropped file is staged inside its drop, and its top element is what uploads" {
    mut stage := FakeDropStage{ appended: [], discarded: [] }
    assert_eq(try stage_dropped(mut stage, "d1", "site/css/app.css", "body{}"), "/cfg/drops/d1/site")
    assert_eq(try stage_dropped(mut stage, "d1", "notes.txt", "hi"), "/cfg/drops/d1/notes.txt")
    assert_eq(code_of(stage_dropped(mut stage, "d1", "../../.ssh/x", "")), ERR_INVALID)
    assert_eq(code_of(stage_dropped(mut stage, "../d", "a", "")), ERR_INVALID)
    assert_eq(stage.appended.len(), 2)
    discard_dropped(mut stage, "d1")
    discard_dropped(mut stage, "../x")
    assert_eq(stage.discarded.len(), 1)
}

// ---- Copies between two hosts (milestone 18) -----------------------------------------

fn relay_req(from_path: str, to_path: str, recursive: bool, force: bool) -> CopyRequest {
    return CopyRequest{ id: "t1", alias: "db1", direction: COPY_RELAY, local: to_path, remote: from_path, recursive: recursive, force: force, to_alias: "nas" }
}

test "a copy between two hosts reads one and writes the other" {
    mut db1 := FakeSftp{ tree: fake_tree([fdir("/var"), fdir("/var/backups"), ffile("/var/backups/db.sql", "CREATE TABLE t;\n")]) }
    mut nas := FakeLocal{ tree: fake_tree([fdir("/srv"), fdir("/srv/backups")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 3 }
    res := try copy_files(mut db1, mut nas, mut sink, mut clock, relay_req("/var/backups/db.sql", "/srv/backups/", false, false))
    assert_eq(nas.tree.data_of("/srv/backups/db.sql"), "CREATE TABLE t;\n")
    assert(!nas.tree.has("/srv/backups/.db.sql.flint-part"))
    assert_eq(db1.tree.data_of("/var/backups/db.sql"), "CREATE TABLE t;\n")
    assert_eq(res.direction, COPY_RELAY)
    assert_eq(res.host, "db1")
    assert_eq(res.to_host, "nas")
    assert_eq(res.bytes, 16)
    assert_eq(res.files[0].source, "/var/backups/db.sql")
    assert_eq(res.files[0].target, "/srv/backups/db.sql")
    assert_eq(sink.last.bytes_done, 16)
}

test "a copy between two hosts names each host in its errors" {
    mut db1 := FakeSftp{ tree: fake_tree([fdir("/d"), ffile("/d/a", "a"), fdir("/d/site")]) }
    mut nas := FakeLocal{ tree: fake_tree([fdir("/srv"), ffile("/srv/a", "old")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    exists := copy_files(mut db1, mut nas, mut sink, mut clock, relay_req("/d/a", "/srv/", false, false))
    assert_eq(code_of(exists), ERR_EXISTS)
    assert("{exists.error().message()}".contains("/srv/a on nas already exists"))
    folder := copy_files(mut db1, mut nas, mut sink, mut clock, relay_req("/d/site", "/srv/", false, false))
    assert("{folder.error().message()}".contains("/d/site on db1 is a folder"))
    missing := copy_files(mut db1, mut nas, mut sink, mut clock, relay_req("/d/a", "/nowhere/x", false, false))
    assert_eq(code_of(missing), ERR_NOT_FOUND)
    assert("{missing.error().message()}".contains("on nas"))
    _ := try copy_files(mut db1, mut nas, mut sink, mut clock, relay_req("/d/a", "/srv/", false, true))
    assert_eq(nas.tree.data_of("/srv/a"), "a")
}

test "a folder copied between two hosts, with -r" {
    mut db1 := FakeSftp{ tree: fake_tree([fdir("/etc"), fdir("/etc/app"), ffile("/etc/app/a.conf", "a=1"), fdir("/etc/app/d"), ffile("/etc/app/d/b.conf", "b=2")]) }
    mut nas := FakeLocal{ tree: fake_tree([fdir("/bk")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    res := try copy_files(mut db1, mut nas, mut sink, mut clock, relay_req("/etc/app", "/bk", true, false))
    assert_eq(nas.tree.data_of("/bk/app/a.conf"), "a=1")
    assert_eq(nas.tree.data_of("/bk/app/d/b.conf"), "b=2")
    assert_eq(res.folders, 2)
}

test "a part file a cut copy left is removed before the next copy of that file" {
    mut host := FakeSftp{ tree: fake_tree([fdir("/etc"), ffile("/etc/.app.conf.flint-part", "half a fi")]) }
    mut here := FakeLocal{ tree: fake_tree([ffile("/app.conf", "whole")]) }
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    _ := try copy_files(mut host, mut here, mut sink, mut clock, copy_req(COPY_UPLOAD, "/app.conf", "/etc/", false, false))
    assert_eq(host.tree.data_of("/etc/app.conf"), "whole")
    assert(!host.tree.has("/etc/.app.conf.flint-part"))
}

test "a copy whose channel died says where its part file may be left" {
    mut db1 := FakeSftp{ tree: fake_tree([ffile("/big", "0123456789abcdef")]) }
    mut nas := FakeLocal{ tree: fake_tree([fdir("/srv")]) }
    nas.tree.fail_write_after = 6
    nas.tree.remove_dead = true
    mut sink := quiet_sink()
    mut clock := FakeClock{ now_ms: 0, step_ms: 1 }
    failed := copy_files(mut db1, mut nas, mut sink, mut clock, relay_req("/big", "/srv/", false, false))
    assert_eq(code_of(failed), ERR_IO)
    assert("{failed.error().message()}".contains(".big.flint-part may be left in /srv on nas"))
}
