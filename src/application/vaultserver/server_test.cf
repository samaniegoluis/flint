package vaultserver

// The server's use cases over a store in memory (milestone 42, D-097).

import "core:encoding/hex"
import "core:json"
import "../../domain"
import "../../ports"

// Not a real hash or a constant-time compare: the tests need only distinct digests.
type TestCrypto struct {
    seed: u8
}

fn (self: TestCrypto) random_bytes(n: usize) -> []byte {
    mut b := make([]byte, n)
    for i in 0..n {
        b[i] = byte(u8(i) * 7 + self.seed)
    }
    return b
}

fn (self: TestCrypto) derive_key(password: str, salt: []byte, ops: u64, mem_bytes: usize) -> []byte! {
    return error("unused")
}

fn (self: TestCrypto) derive_subkey(master: []byte, id: u64, kdf_context: str) -> []byte! {
    return error("unused")
}

fn (self: TestCrypto) seal(key: []byte, plaintext: []byte, aad: []byte) -> []byte! {
    return error("unused")
}

fn (self: TestCrypto) unseal(key: []byte, sealed: []byte, aad: []byte) -> []byte! {
    return error("unused")
}

fn (self: TestCrypto) digest(data: []byte, out_len: usize) -> []byte! {
    mut res := make([]byte, out_len)
    for i, b in data {
        j := i % out_len
        res[j] = byte(u8(u8(res[j]) * 31 + u8(b) + u8(i)))
    }
    return res
}

fn (self: TestCrypto) equal(a: []byte, b: []byte) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

fn (self: TestCrypto) wipe(buf: []byte) {
}

fn (self: TestCrypto) wipe_text(text: str) {
}

// Versions in memory, every vault's in one list; `race` makes the next write find
// another writer first.
type MemStore struct {
    versions: []BlobVersion
    datas:    []str
    labels:   []LabelBody
    label_of: []str
    race:     bool
    fail:     bool
}

fn (self: MemStore) blob_vaults() -> []ServerVault! {
    if self.fail {
        return error(coded(ERR_IO, "disk gone"))
    }
    mut ids: []str = []
    for v in self.versions {
        mut seen := false
        for id in ids {
            if id == v.vault_id {
                seen = true
            }
        }
        if !seen {
            ids.push(v.vault_id)
        }
    }
    mut found: []ServerVault = []
    for id in ids {
        head := try self.blob_head(id)
        mut label := ""
        for i in 0..self.label_of.len() {
            if self.label_of[i] == id {
                label = self.labels[i].label
            }
        }
        found.push(ServerVault{ id: id, label: label, version: head.version, size: head.size, updated_at: head.stored_at })
    }
    return found
}

fn (self: MemStore) blob_head(vault_id: str) -> BlobVersion! {
    if self.fail {
        return error(coded(ERR_IO, "disk gone"))
    }
    mut head := BlobVersion{ version: 0, vault_id: vault_id, size: 0, stored_at: 0 }
    for v in self.versions {
        if v.vault_id == vault_id {
            head = v
        }
    }
    return head
}

fn (self: MemStore) blob_read(vault_id: str, version: i64) -> str! {
    for i in 0..self.versions.len() {
        if self.versions[i].vault_id == vault_id && self.versions[i].version == version {
            return self.datas[i]
        }
    }
    return error(coded(ERR_NOT_FOUND, "no version {version}"))
}

fn (mut self: MemStore) blob_write(vault_id: str, version: i64, data: str, now_ms: i64) -> void! {
    if self.race {
        self.race = false
        self.versions.push(BlobVersion{ version: version, vault_id: vault_id, size: 1, stored_at: now_ms })
        self.datas.push("other")
        return error(coded(ERR_CONFLICT, "another writer"))
    }
    self.versions.push(BlobVersion{ version: version, vault_id: vault_id, size: i64(data.len()), stored_at: now_ms })
    self.datas.push(data)
}

fn (self: MemStore) blob_versions(vault_id: str) -> []BlobVersion! {
    mut newest: []BlobVersion = []
    for k in 0..self.versions.len() {
        v := self.versions[self.versions.len() - 1 - k]
        if v.vault_id == vault_id {
            newest.push(v)
        }
    }
    return newest
}

fn (mut self: MemStore) blob_set_label(vault_id: str, label: str) -> void! {
    head := try self.blob_head(vault_id)
    if head.version == 0 {
        return error(coded(ERR_NOT_FOUND, "no vault {vault_id}"))
    }
    for i in 0..self.label_of.len() {
        if self.label_of[i] == vault_id {
            self.labels[i] = LabelBody{ label: label }
            return
        }
    }
    self.label_of.push(vault_id)
    self.labels.push(LabelBody{ label: label })
}

fn new_mem_store() -> MemStore {
    return MemStore{ versions: [], datas: [], labels: [], label_of: [], race: false, fail: false }
}

TOKEN: str = "0123456789abcdef0123456789abcdef0123456789abcdef"
VID: str = "00112233445566778899aabbccddeeff"
VID2: str = "ffeeddccbbaa99887766554433221100"

fn test_config() -> ServerConfig {
    crypto := TestCrypto{ seed: 1 }
    return server_config_from(crypto, TOKEN, "", 1000) or err {
        assert(false)
        return ServerConfig{ token_hash: [], max_body: 0 }
    }
}

fn rq(method: str, if_match: str, body: str) -> ServerRequest {
    return ServerRequest{ method: method, path: SERVER_VAULT_PATH, client: "10.0.0.1", authorization: "Bearer " + TOKEN, if_match: if_match, if_none_match: "", vault_id: VID, body: body }
}

fn first_upload(body: str) -> ServerRequest {
    mut r := rq("PUT", "", body)
    r.if_none_match = "*"
    return r
}

test "the token or only its hash configures the server, never both and never a short one" {
    crypto := TestCrypto{ seed: 1 }
    from_token := try server_config_from(crypto, TOKEN, "", 10)
    h := try server_token_hash(crypto, TOKEN)
    from_hash := try server_config_from(crypto, "", hex.encode(h), 10)
    assert(crypto.equal(from_token.token_hash, from_hash.token_hash))
    mut codes: []str = []
    server_config_from(crypto, TOKEN, hex.encode(h), 10) or err {
        codes.push(error_code_of(err.message()))
    }
    server_config_from(crypto, "", "", 10) or err {
        codes.push(error_code_of(err.message()))
    }
    server_config_from(crypto, "too-short", "", 10) or err {
        codes.push(error_code_of(err.message()))
    }
    server_config_from(crypto, "", "ABCD", 10) or err {
        codes.push(error_code_of(err.message()))
    }
    server_config_from(crypto, "", hex.encode(h).to_upper(), 10) or err {
        codes.push(error_code_of(err.message()))
    }
    assert_eq(codes.len(), usize(5))
    assert_eq(codes[0], ERR_USAGE)
    assert_eq(codes[1], ERR_USAGE)
    assert_eq(codes[2], ERR_INVALID)
    assert_eq(codes[3], ERR_INVALID)
}

test "a new token is 64 hex characters and its hash configures the server" {
    crypto := TestCrypto{ seed: 3 }
    pair := try new_server_token(crypto)
    assert_eq(pair.token.len(), usize(64))
    assert_eq(pair.hash.len(), usize(64))
    cfg := try server_config_from(crypto, "", pair.hash, 10)
    assert(token_matches(crypto, cfg, "Bearer " + pair.token))
}

test "no token, a wrong token or another scheme gets 401, and nothing is read" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    store.fail = true
    mut gate := new_server_gate()
    auths: []str = ["", "Bearer ", "Bearer wrong", "Basic " + TOKEN, TOKEN, "bearer " + TOKEN]
    for auth in auths {
        mut r := rq("GET", "", "")
        r.authorization = auth
        reply := serve_vault_request(crypto, mut store, mut gate, cfg, r, 1000, 1000)
        assert_eq(reply.status, i32(401))
        assert(!reply.body.contains(TOKEN))
    }
}

test "repeated bad tokens lock the client out, even with the right token after" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    mut gate := new_server_gate()
    for i in 0..GATE_BAD_MAX {
        mut r := rq("GET", "", "")
        r.authorization = "Bearer nope"
        _ = serve_vault_request(crypto, mut store, mut gate, cfg, r, 1000, 1000)
    }
    reply := serve_vault_request(crypto, mut store, mut gate, cfg, rq("GET", "", ""), 2000, 2000)
    assert_eq(reply.status, i32(429))
    assert_eq(reply.retry_after_s, (GATE_LOCKOUT_MS - 1000 + 999) / 1000)
    mut other := rq("GET", "", "")
    other.client = "10.0.0.2"
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, other, 2000, 2000).status, i32(404))
}

test "an empty server answers 404, then the first upload is version 1" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    mut gate := new_server_gate()
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, rq("GET", "", ""), 1, 1).status, i32(404))
    up := serve_vault_request(crypto, mut store, mut gate, cfg, first_upload("blob-1"), 2, 2)
    assert_eq(up.status, i32(200))
    assert_eq(up.version, i64(1))
    assert_eq(up.body, json.stringify(VersionBody{ version: 1 }))
    got := serve_vault_request(crypto, mut store, mut gate, cfg, rq("GET", "", ""), 3, 3)
    assert_eq(got.status, i32(200))
    assert_eq(got.body, "blob-1")
    assert_eq(got.version, i64(1))
    assert_eq(got.vault_id, VID)
    assert_eq(got.content_type, "application/octet-stream")
}

test "an upload over a version not merged gets 409 with the newest version" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    mut gate := new_server_gate()
    _ = serve_vault_request(crypto, mut store, mut gate, cfg, first_upload("a"), 1, 1)
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, rq("PUT", "\"1\"", "b"), 2, 2).version, i64(2))
    // The second machine still saw version 1.
    late := serve_vault_request(crypto, mut store, mut gate, cfg, rq("PUT", "\"1\"", "c"), 3, 3)
    assert_eq(late.status, i32(409))
    assert_eq(late.version, i64(2))
    // A first upload where a vault already is conflicts too.
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, first_upload("d"), 4, 4).status, i32(409))
    // Nothing was stored by either.
    assert_eq(store.versions.len(), usize(2))
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, rq("GET", "", ""), 5, 5).body, "b")
}

test "a GET naming the newest version gets 304 with no body; an older one gets the file" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    mut gate := new_server_gate()
    _ = serve_vault_request(crypto, mut store, mut gate, cfg, first_upload("a"), 1, 1)
    _ = serve_vault_request(crypto, mut store, mut gate, cfg, rq("PUT", "\"1\"", "b"), 2, 2)
    mut same := rq("GET", "", "")
    same.if_none_match = "\"2\""
    r := serve_vault_request(crypto, mut store, mut gate, cfg, same, 3, 3)
    assert_eq(r.status, i32(304))
    assert_eq(r.body, "")
    assert_eq(r.version, i64(2))
    mut old := rq("GET", "", "")
    old.if_none_match = "\"1\""
    o := serve_vault_request(crypto, mut store, mut gate, cfg, old, 4, 4)
    assert_eq(o.status, i32(200))
    assert_eq(o.body, "b")
    // Still behind the token.
    mut bad := same
    bad.authorization = "Bearer nope"
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, bad, 5, 5).status, i32(401))
}

test "an upload of another vault is refused with 412" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    mut gate := new_server_gate()
    _ = serve_vault_request(crypto, mut store, mut gate, cfg, first_upload("a"), 1, 1)
    mut r := rq("PUT", "\"1\"", "x")
    r.vault_id = VID2
    reply := serve_vault_request(crypto, mut store, mut gate, cfg, r, 2, 2)
    assert_eq(reply.status, i32(412))
    assert_eq(reply.vault_id, VID)
    assert_eq(store.versions.len(), usize(1))
}

test "an upload without a precondition, a vault id or a body is refused" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    mut gate := new_server_gate()
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, rq("PUT", "", "a"), 1, 1).status, i32(428))
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, rq("PUT", "\"x\"", "a"), 1, 1).status, i32(400))
    mut no_id := first_upload("a")
    no_id.vault_id = ""
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, no_id, 1, 1).status, i32(400))
    mut upper := first_upload("a")
    upper.vault_id = "00112233445566778899AABBCCDDEEFF"
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, upper, 1, 1).status, i32(400))
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, first_upload(""), 1, 1).status, i32(400))
    mut big := ""
    for i in 0..1001 {
        big += "x"
    }
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, first_upload(big), 1, 1).status, i32(413))
    assert_eq(store.versions.len(), usize(0))
}

test "another path gets 404 and another method 405, after the token" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    mut gate := new_server_gate()
    mut p := rq("GET", "", "")
    p.path = "/v2/vault"
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, p, 1, 1).status, i32(404))
    mut q := rq("GET", "", "")
    q.path = "/v1/vaults/not-an-id"
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, q, 1, 1).status, i32(404))
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, rq("DELETE", "", ""), 1, 1).status, i32(405))
    mut anon := rq("DELETE", "", "")
    anon.authorization = ""
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, anon, 1, 1).status, i32(401))
}

test "a version stored first by another writer turns into 409" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    mut gate := new_server_gate()
    _ = serve_vault_request(crypto, mut store, mut gate, cfg, first_upload("a"), 1, 1)
    store.race = true
    reply := serve_vault_request(crypto, mut store, mut gate, cfg, rq("PUT", "\"1\"", "b"), 2, 2)
    assert_eq(reply.status, i32(409))
    assert_eq(reply.version, i64(2))
}

test "a store that fails answers 500 without its reason" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    store.fail = true
    mut gate := new_server_gate()
    reply := serve_vault_request(crypto, mut store, mut gate, cfg, rq("GET", "", ""), 1, 1)
    assert_eq(reply.status, i32(500))
    assert(!reply.body.contains("disk gone"))
}

test "restore makes a kept version the newest as a new version" {
    mut store := new_mem_store()
    try store.blob_write(VID, 1, "one", 10)
    try store.blob_write(VID, 2, "two", 20)
    try store.blob_write(VID, 3, "three", 30)
    try store.blob_write(VID2, 1, "other", 35)
    v := try restore_vault_version(mut store, VID, 1, 40)
    assert_eq(v.version, i64(4))
    assert_eq(try store.blob_read(VID, 4), "one")
    assert_eq((try store.blob_head(VID)).vault_id, VID)
    assert_eq((try store.blob_head(VID2)).version, i64(1))
    mut codes: []str = []
    restore_vault_version(mut store, VID, 4, 50) or err {
        codes.push(error_code_of(err.message()))
    }
    restore_vault_version(mut store, VID, 9, 50) or err {
        codes.push(error_code_of(err.message()))
    }
    mut empty := new_mem_store()
    restore_vault_version(mut empty, VID, 1, 50) or err {
        codes.push(error_code_of(err.message()))
    }
    assert_eq(codes.len(), usize(3))
    assert_eq(codes[0], ERR_INVALID)
    assert_eq(codes[1], ERR_NOT_FOUND)
    assert_eq(codes[2], ERR_NOT_FOUND)
}

// A request to the vault `id` under `/v1/vaults/<id>`.
fn vq(id: str, method: str, if_match: str, body: str) -> ServerRequest {
    mut r := rq(method, if_match, body)
    r.path = SERVER_VAULTS_PATH + "/" + id
    r.vault_id = id
    return r
}

fn vq_first(id: str, body: str) -> ServerRequest {
    mut r := vq(id, "PUT", "", body)
    r.if_none_match = "*"
    return r
}

fn list_req() -> ServerRequest {
    mut r := rq("GET", "", "")
    r.path = SERVER_VAULTS_PATH
    r.vault_id = ""
    return r
}

test "one server keeps several vaults, each with its own versions" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    mut gate := new_server_gate()
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, vq(VID, "GET", "", ""), 1, 1).status, i32(404))
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, vq_first(VID, "a1"), 2, 2).version, i64(1))
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, vq_first(VID2, "b1"), 3, 3).version, i64(1))
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, vq(VID, "PUT", "\"1\"", "a2"), 4, 4).version, i64(2))
    // Each vault's versions are its own: VID2 is still at 1, and a stale upload of it conflicts at 1.
    b := serve_vault_request(crypto, mut store, mut gate, cfg, vq(VID2, "GET", "", ""), 5, 5)
    assert_eq(b.body, "b1")
    assert_eq(b.version, i64(1))
    assert_eq(b.vault_id, VID2)
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, vq(VID2, "PUT", "\"2\"", "x"), 6, 6).status, i32(409))
    mut nm := vq(VID, "GET", "", "")
    nm.if_none_match = "\"2\""
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, nm, 7, 7).status, i32(304))
    // The id in the header must be the one the path names.
    mut mixed := vq(VID, "PUT", "\"2\"", "y")
    mixed.vault_id = VID2
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, mixed, 8, 8).status, i32(400))
    // The list: ids, versions, sizes and times, no blob.
    l := serve_vault_request(crypto, mut store, mut gate, cfg, list_req(), 9, 9)
    assert_eq(l.status, i32(200))
    got := try json.parse[VaultsBody](l.body)
    assert_eq(got.vaults.len(), usize(2))
    assert_eq(got.vaults[0].id, VID)
    assert_eq(got.vaults[0].version, i64(2))
    assert_eq(got.vaults[0].updated_at, i64(4))
    assert(!l.body.contains("a2"))
    // Still behind the token.
    mut anon := list_req()
    anon.authorization = ""
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, anon, 10, 10).status, i32(401))
}

test "a label is set, listed, cleared and checked; a vault not stored has none" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    mut gate := new_server_gate()
    mut put := vq(VID, "PUT", "", "\{\"label\":\"Work\"\}")
    put.path = SERVER_VAULTS_PATH + "/" + VID + "/label"
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, put, 1, 1).status, i32(404))
    _ = serve_vault_request(crypto, mut store, mut gate, cfg, vq_first(VID, "a1"), 2, 2)
    r := serve_vault_request(crypto, mut store, mut gate, cfg, put, 3, 3)
    assert_eq(r.status, i32(200))
    assert_eq(r.note, "")
    l := try json.parse[VaultsBody](serve_vault_request(crypto, mut store, mut gate, cfg, list_req(), 4, 4).body)
    assert_eq(l.vaults[0].label, "Work")
    mut bad := put
    bad.body = "\{\"label\":\" padded \"\}"
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, bad, 5, 5).status, i32(400))
    bad.body = "not json"
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, bad, 5, 5).status, i32(400))
    mut get := put
    get.method = "GET"
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, get, 5, 5).status, i32(405))
    mut clear := put
    clear.body = "\{\"label\":\"\"\}"
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, clear, 6, 6).status, i32(200))
    l2 := try json.parse[VaultsBody](serve_vault_request(crypto, mut store, mut gate, cfg, list_req(), 7, 7).body)
    assert_eq(l2.vaults[0].label, "")
}

test "the single-vault path serves the one vault, and asks to update when there are several" {
    crypto := TestCrypto{ seed: 1 }
    cfg := test_config()
    mut store := new_mem_store()
    mut gate := new_server_gate()
    // A vault connected through the new path is the old clients' one vault.
    _ = serve_vault_request(crypto, mut store, mut gate, cfg, vq_first(VID, "a1"), 1, 1)
    old := serve_vault_request(crypto, mut store, mut gate, cfg, rq("GET", "", ""), 2, 2)
    assert_eq(old.body, "a1")
    assert_eq(old.vault_id, VID)
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, rq("PUT", "\"1\"", "a2"), 3, 3).version, i64(2))
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, vq(VID, "GET", "", ""), 4, 4).body, "a2")
    // A second vault: the old path cannot tell which one, so it says to update.
    _ = serve_vault_request(crypto, mut store, mut gate, cfg, vq_first(VID2, "b1"), 5, 5)
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, rq("GET", "", ""), 6, 6).status, i32(410))
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, rq("PUT", "\"2\"", "a3"), 7, 7).status, i32(410))
}

test "a server keeping its most vaults refuses a new one, never an upload of one it keeps" {
    crypto := TestCrypto{ seed: 1 }
    mut cfg := test_config()
    cfg.max_vaults = 1
    mut store := new_mem_store()
    mut gate := new_server_gate()
    _ = serve_vault_request(crypto, mut store, mut gate, cfg, vq_first(VID, "a1"), 1, 1)
    full := serve_vault_request(crypto, mut store, mut gate, cfg, vq_first(VID2, "b1"), 2, 2)
    assert_eq(full.status, i32(507))
    assert_eq(serve_vault_request(crypto, mut store, mut gate, cfg, vq(VID, "PUT", "\"1\"", "a2"), 3, 3).status, i32(200))
}

test "a server command names a vault by id, a prefix, or none when there is one" {
    mut store := new_mem_store()
    mut codes: []str = []
    server_vault_named(mut store, "") or err {
        codes.push(error_code_of(err.message()))
    }
    try store.blob_write(VID, 1, "a", 1)
    assert_eq((try server_vault_named(mut store, "")).id, VID)
    try store.blob_write(VID2, 1, "b", 2)
    server_vault_named(mut store, "") or err {
        codes.push(error_code_of(err.message()))
    }
    assert_eq((try server_vault_named(mut store, "ffee")).id, VID2)
    assert_eq((try server_vault_named(mut store, VID)).id, VID)
    server_vault_named(mut store, "abcd") or err {
        codes.push(error_code_of(err.message()))
    }
    server_vault_named(mut store, "ff") or err {
        codes.push(error_code_of(err.message()))
    }
    assert_eq(codes.len(), usize(4))
    assert_eq(codes[0], ERR_NOT_FOUND)
    assert_eq(codes[1], ERR_USAGE)
    assert_eq(codes[2], ERR_NOT_FOUND)
    assert_eq(codes[3], ERR_USAGE)
    try set_server_vault_label(mut store, VID2, "Work")
    assert_eq((try store.blob_vaults())[1].label, "Work")
}
