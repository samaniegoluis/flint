package vaultserver

// The remote vault server's use cases (milestone 42, D-097): one request in, one reply
// out, and the server's own commands (`token`, `versions`, `restore`). A package of
// its own so `flint-vault-server` builds without the client's use cases.
//
// Principle 13: the server receives only the encrypted vault file, its version, the
// vault id and the bearer token. It never opens the file, keeps only a hash of the
// token, compares it in constant time through libsodium (the `Crypto` port), and no
// reply or note carries the token or the file's bytes beyond the GET that asks for them.

import "core:encoding/hex"
import "core:json"
import "../../domain"
import "../../ports"

// Protocol v1's resources (milestones 42 and 45, D-097, D-103): the vaults the server
// keeps, each under its id (`/v1/vaults/<id>`, its label at `/v1/vaults/<id>/label`),
// and the single vault of milestone 42's clients, served while the server keeps at
// most one.
SERVER_VAULT_PATH: str = "/v1/vault"
SERVER_VAULTS_PATH: str = "/v1/vaults"
// The default cap on an upload, in bytes. A vault with a few hundred hosts is well
// under a megabyte.
pub SERVER_MAX_BODY_DEFAULT: i64 = 33554432
// BLAKE2b-256 of the token, prefixed so the hash names this use alone.
SERVER_TOKEN_HASH_LEN: usize = 32
SERVER_TOKEN_CONTEXT: str = "flint/vault-server-token/v1:"
// `flint-vault-server token`: 32 random bytes, as hex.
SERVER_TOKEN_BYTES: usize = 32

// What the HTTP driver read from one request. Header values as they came.
pub type ServerRequest struct {
    method:        str
    path:          str
    // The client's address, for the gate and the log.
    client:        str
    authorization: str
    if_match:      str
    if_none_match: str
    vault_id:      str
    body:          str
}

// What the driver writes back.
pub type ServerReply struct {
    status:        i32
    // The vault file for a GET; a JSON object otherwise.
    body:          str
    // `application/octet-stream` for the file, `application/json` otherwise.
    content_type:  str
    // Sent as `ETag` when above 0.
    version:       i64
    // Sent as `X-Flint-Vault-Id` when not empty.
    vault_id:      str
    // Sent as `Retry-After` (seconds) when above 0.
    retry_after_s: i64
    // For the log: a short code, never a secret.
    note:          str
}

pub type ServerConfig struct {
    token_hash: []byte
    max_body:   i64
    // The most vaults the server keeps (`FLINT_VAULT_MAX_VAULTS`).
    max_vaults: i64
}

type LabelBody struct {
    label: str `json:"label"`
}

type ErrorBody struct {
    error:   str `json:"error"`
    message: str `json:"message"`
}

type VersionBody struct {
    version: i64 `json:"version"`
}

pub fn json_reply(status: i32, code: str, message: str) -> ServerReply {
    body := json.stringify(ErrorBody{ error: code, message: message })
    return ServerReply{ status: status, body: body, content_type: "application/json", version: 0, vault_id: "", retry_after_s: 0, note: code }
}

// A 500 whose note carries the store's error for the server's log (milestone 71): an
// I/O error naming a path under the data folder, never a token or a byte of a vault
// (Principle 13). The note never reaches the client.
fn io_failure(r: ServerReply, cause: str) -> ServerReply {
    mut failed := r
    failed.note = r.note + ": " + domain.error_text_of(cause)
    return failed
}

fn server_token_hash[C: ports.Crypto](crypto: C, token: str) -> []byte! {
    mut data := []byte(SERVER_TOKEN_CONTEXT)
    for b in token.bytes() {
        data.push(b)
    }
    h := try crypto.digest(data, SERVER_TOKEN_HASH_LEN)
    crypto.wipe(data)
    return h
}

// A new token and the hash to set on the server instead of it.
pub type NewServerToken struct {
    token: str
    hash:  str
}

pub fn new_server_token[C: ports.Crypto](crypto: C) -> NewServerToken! {
    raw := crypto.random_bytes(SERVER_TOKEN_BYTES)
    token := hex.encode(raw)
    crypto.wipe(raw)
    h := try server_token_hash(crypto, token)
    return NewServerToken{ token: token, hash: hex.encode(h) }
}

// The server's configuration from its environment: the token (`FLINT_VAULT_TOKEN`) or
// only its hash (`FLINT_VAULT_TOKEN_HASH`), never both; a short token refused.
pub fn server_config_from[C: ports.Crypto](crypto: C, token: str, token_hash_hex: str, max_body: i64) -> ServerConfig! {
    if token.len() > 0 && token_hash_hex.len() > 0 {
        return error(domain.coded(domain.ERR_USAGE, "set FLINT_VAULT_TOKEN or FLINT_VAULT_TOKEN_HASH, not both"))
    }
    if max_body < 1 {
        return error(domain.coded(domain.ERR_USAGE, "the upload cap must be at least one byte"))
    }
    if token.len() > 0 {
        try domain.check_server_token(token)
        h := try server_token_hash(crypto, token)
        return ServerConfig{ token_hash: h, max_body: max_body, max_vaults: domain.SERVER_VAULTS_MAX_DEFAULT }
    }
    if token_hash_hex.len() > 0 {
        t := token_hash_hex.trim()
        if t.len() != SERVER_TOKEN_HASH_LEN * 2 || !is_lower_hex(t) {
            return error(domain.coded(domain.ERR_INVALID, "FLINT_VAULT_TOKEN_HASH must be the 64 hex characters `flint-vault-server token` printed"))
        }
        h := hex.decode(t) or {
            return error(domain.coded(domain.ERR_INVALID, "FLINT_VAULT_TOKEN_HASH is not hex"))
        }
        return ServerConfig{ token_hash: h, max_body: max_body, max_vaults: domain.SERVER_VAULTS_MAX_DEFAULT }
    }
    return error(domain.coded(domain.ERR_USAGE, "set FLINT_VAULT_TOKEN (or FLINT_VAULT_TOKEN_HASH): make one with `flint-vault-server token`"))
}

fn is_lower_hex(s: str) -> bool {
    for b in s.bytes() {
        c := u8(b)
        if !domain.is_digit_byte(c) && !(c >= 97 && c <= 102) {
            return false
        }
    }
    return true
}

// Whether `authorization` carries the server's token, compared in constant time.
fn token_matches[C: ports.Crypto](crypto: C, cfg: ServerConfig, authorization: str) -> bool {
    if !authorization.starts_with("Bearer ") {
        return false
    }
    presented := authorization[7..].trim()
    if presented.len() == 0 {
        return false
    }
    h := server_token_hash(crypto, presented) or {
        return false
    }
    return crypto.equal(h, cfg.token_hash)
}

// One request: the gate, the token, then the route. `now_ms` is the monotonic clock
// (the gate's windows), `wall_ms` the Unix time a stored version is stamped with.
pub fn serve_vault_request[C: ports.Crypto, B: ports.BlobStore](crypto: C, mut store: B, mut gate: domain.ServerGate, cfg: ServerConfig, req: ServerRequest, now_ms: i64, wall_ms: i64) -> ServerReply {
    wait_ms := gate.gate_admit(req.client, now_ms)
    if wait_ms > 0 {
        mut r := json_reply(429, "too_many_requests", "wait before trying again")
        r.retry_after_s = (wait_ms + 999) / 1000
        return r
    }
    if !token_matches(crypto, cfg, req.authorization) {
        locked := gate.gate_bad_token(req.client, now_ms)
        mut r := json_reply(401, "unauthorized", "a valid bearer token is required")
        if locked {
            r.note = "unauthorized, client locked out"
        }
        return r
    }
    if req.path == SERVER_VAULT_PATH {
        return serve_single_vault(mut store, cfg, req, wall_ms)
    }
    if req.path == SERVER_VAULTS_PATH {
        if req.method != "GET" {
            return json_reply(405, "method_not_allowed", "use GET")
        }
        return list_vaults_reply(mut store)
    }
    if !req.path.starts_with(SERVER_VAULTS_PATH + "/") {
        return json_reply(404, "not_found", "no such resource")
    }
    mut rest := req.path[SERVER_VAULTS_PATH.len() + 1..]
    mut label := false
    if rest.ends_with("/label") {
        rest = rest[..rest.len() - 6]
        label = true
    }
    if !domain.valid_vault_id(rest) {
        return json_reply(404, "not_found", "no such resource")
    }
    if label {
        if req.method != "PUT" {
            return json_reply(405, "method_not_allowed", "use PUT")
        }
        return put_label(mut store, rest, req.body)
    }
    if req.method == "GET" {
        return get_vault(mut store, rest, req.if_none_match)
    }
    if req.method == "PUT" {
        if req.vault_id != rest {
            return json_reply(400, "bad_vault_id", "X-Flint-Vault-Id must be the vault id the path names")
        }
        return put_vault(mut store, cfg, req, wall_ms)
    }
    return json_reply(405, "method_not_allowed", "use GET or PUT")
}

// `/v1/vault`, for the clients of milestones 42-44: the server's one vault while it
// keeps at most one. A first upload there starts a vault under its id; a server
// keeping several asks the client to update (410), since it cannot tell which.
fn serve_single_vault[B: ports.BlobStore](mut store: B, cfg: ServerConfig, req: ServerRequest, wall_ms: i64) -> ServerReply {
    if req.method != "GET" && req.method != "PUT" {
        return json_reply(405, "method_not_allowed", "use GET or PUT")
    }
    vaults := store.blob_vaults() or err {
        return io_failure(json_reply(500, "io", "the server could not read its store"), err.message())
    }
    if vaults.len() > 1 {
        return json_reply(410, "several_vaults", "this server keeps several vaults: update Flint to 0.12 or later")
    }
    if vaults.len() == 0 {
        if req.method == "GET" {
            return json_reply(404, "empty", "the server holds no vault yet")
        }
        return put_vault(mut store, cfg, req, wall_ms)
    }
    only := vaults[0].id
    if req.method == "GET" {
        return get_vault(mut store, only, req.if_none_match)
    }
    if domain.valid_vault_id(req.vault_id) && req.vault_id != only {
        mut r := json_reply(412, "other_vault", "the server holds another vault")
        r.vault_id = only
        return r
    }
    return put_vault(mut store, cfg, req, wall_ms)
}

type VaultsBody struct {
    vaults: []domain.ServerVault `json:"vaults"`
}

// `GET /v1/vaults`: what a machine may download, before any master password. Only
// what the server holds in clear: ids, labels, versions, sizes and times.
fn list_vaults_reply[B: ports.BlobStore](mut store: B) -> ServerReply {
    vaults := store.blob_vaults() or err {
        return io_failure(json_reply(500, "io", "the server could not read its store"), err.message())
    }
    return ServerReply{ status: 200, body: json.stringify(VaultsBody{ vaults: vaults }), content_type: "application/json", version: 0, vault_id: "", retry_after_s: 0, note: "" }
}

// `PUT /v1/vaults/<id>/label` with `{"label": "..."}`; "" clears it. The label is
// never logged.
fn put_label[B: ports.BlobStore](mut store: B, vault_id: str, body: str) -> ServerReply {
    if body.len() > 1024 {
        return json_reply(413, "too_large", "a label is short")
    }
    // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
    parsed := json.parse[LabelBody](payload: body) or {
        return json_reply(400, "bad_label", "send a JSON object with a label")
    }
    domain.check_vault_label(parsed.label) or err {
        return json_reply(400, "bad_label", domain.error_text_of(err.message()))
    }
    store.blob_set_label(vault_id, parsed.label) or err {
        if domain.error_code_of(err.message()) == domain.ERR_NOT_FOUND {
            return json_reply(404, "empty", "the server holds no such vault")
        }
        return io_failure(json_reply(500, "io", "the server could not write its store"), err.message())
    }
    return ServerReply{ status: 200, body: json.stringify(LabelBody{ label: parsed.label }), content_type: "application/json", version: 0, vault_id: vault_id, retry_after_s: 0, note: "" }
}

// `If-None-Match: "<n>"` naming the newest version answers `304` with no body
// (milestone 43): a client checking for changes downloads the file only when there
// is a new one.
fn get_vault[B: ports.BlobStore](mut store: B, vault_id: str, if_none_match: str) -> ServerReply {
    head := store.blob_head(vault_id) or err {
        return io_failure(json_reply(500, "io", "the server could not read its store"), err.message())
    }
    if head.version == 0 {
        return json_reply(404, "empty", "the server holds no vault yet")
    }
    if if_none_match.len() > 0 && domain.parse_version_tag(if_none_match) == head.version {
        return ServerReply{ status: 304, body: "", content_type: "", version: head.version, vault_id: head.vault_id, retry_after_s: 0, note: "not modified" }
    }
    data := store.blob_read(vault_id, head.version) or err {
        return io_failure(json_reply(500, "io", "the server could not read its store"), err.message())
    }
    return ServerReply{ status: 200, body: data, content_type: "application/octet-stream", version: head.version, vault_id: head.vault_id, retry_after_s: 0, note: "" }
}

fn put_vault[B: ports.BlobStore](mut store: B, cfg: ServerConfig, req: ServerRequest, wall_ms: i64) -> ServerReply {
    if !domain.valid_vault_id(req.vault_id) {
        return json_reply(400, "bad_vault_id", "X-Flint-Vault-Id must be the vault's 32-character id")
    }
    if req.body.len() == 0 {
        return json_reply(400, "empty_body", "the upload is empty")
    }
    if i64(req.body.len()) > cfg.max_body {
        return json_reply(413, "too_large", "the upload is over the server's cap")
    }
    mut expected: i64 = -1
    if req.if_none_match.trim() == "*" {
        expected = 0
    } else if req.if_match.len() > 0 {
        expected = domain.parse_version_tag(req.if_match)
        if expected < 1 {
            return json_reply(400, "bad_if_match", "If-Match must name a version")
        }
    } else {
        return json_reply(428, "precondition_required", "send If-Match with the version you merged, or If-None-Match: * for the first upload")
    }
    head := store.blob_head(req.vault_id) or err {
        return io_failure(json_reply(500, "io", "the server could not read its store"), err.message())
    }
    if expected != head.version {
        return conflict_reply(head.version)
    }
    if head.version == 0 {
        // A new vault: the server keeps at most `max_vaults`.
        vaults := store.blob_vaults() or err {
            return io_failure(json_reply(500, "io", "the server could not read its store"), err.message())
        }
        if i64(vaults.len()) >= cfg.max_vaults {
            return json_reply(507, "too_many_vaults", "the server keeps {cfg.max_vaults} vaults already (FLINT_VAULT_MAX_VAULTS)")
        }
    }
    store.blob_write(req.vault_id, head.version + 1, req.body, wall_ms) or err {
        // Another writer (`flint-vault-server restore`) stored a version first.
        if domain.error_code_of(err.message()) == domain.ERR_CONFLICT {
            now_head := store.blob_head(req.vault_id) or err2 {
                return io_failure(json_reply(500, "io", "the server could not read its store"), err2.message())
            }
            return conflict_reply(now_head.version)
        }
        return io_failure(json_reply(500, "io", "the server could not write its store"), err.message())
    }
    n := head.version + 1
    return ServerReply{ status: 200, body: json.stringify(VersionBody{ version: n }), content_type: "application/json", version: n, vault_id: req.vault_id, retry_after_s: 0, note: "" }
}

fn conflict_reply(version: i64) -> ServerReply {
    mut r := json_reply(409, "conflict", "another machine uploaded first: download, merge and upload again")
    r.version = version
    return r
}

// `flint-vault-server vaults`: every vault the store keeps, by id.
pub fn list_server_vaults[B: ports.BlobStore](mut store: B) -> []domain.ServerVault! {
    return try store.blob_vaults()
}

// The vault a server command names: `wanted` (an id or a unique prefix of one), or
// the only vault when `wanted` is "" and the store keeps exactly one.
pub fn server_vault_named[B: ports.BlobStore](mut store: B, wanted: str) -> domain.ServerVault! {
    vaults := try store.blob_vaults()
    if vaults.len() == 0 {
        return error(domain.coded(domain.ERR_NOT_FOUND, "the server holds no vault yet"))
    }
    if wanted.len() == 0 {
        if vaults.len() > 1 {
            return error(domain.coded(domain.ERR_USAGE, "the server keeps {vaults.len()} vaults: name one by its id (`flint-vault-server vaults`)"))
        }
        return vaults[0]
    }
    return try domain.pick_server_vault(vaults, wanted)
}

// `flint-vault-server versions [<id>]`: what the store keeps of a vault, newest first.
pub fn list_vault_versions[B: ports.BlobStore](mut store: B, vault_id: str) -> []domain.BlobVersion! {
    return try store.blob_versions(vault_id)
}

// `flint-vault-server label <id> [<label>]`: sets or clears a vault's label.
pub fn set_server_vault_label[B: ports.BlobStore](mut store: B, vault_id: str, label: str) -> void! {
    try domain.check_vault_label(label)
    try store.blob_set_label(vault_id, label)
}

// `flint-vault-server delete [<id>]`: removes a vault and every version kept of it
// (milestone 71). The command asks first; a machine still connected to the vault
// uploads its copy again at its next sync.
pub fn delete_server_vault[B: ports.BlobStore](mut store: B, vault_id: str) -> void! {
    try store.blob_delete(vault_id)
}

// `flint-vault-server restore [<id>] <n>`: a kept version becomes the newest again, as
// a new version, so every machine downloads it and merges it into its own copy
// (D-097).
pub fn restore_vault_version[B: ports.BlobStore](mut store: B, vault_id: str, version: i64, now_ms: i64) -> domain.BlobVersion! {
    head := try store.blob_head(vault_id)
    if head.version == 0 {
        return error(domain.coded(domain.ERR_NOT_FOUND, "the server holds no vault {vault_id}"))
    }
    if version == head.version {
        return error(domain.coded(domain.ERR_INVALID, "version {version} is already the newest"))
    }
    kept := try store.blob_versions(vault_id)
    mut found := false
    for k in kept {
        if k.version == version {
            found = true
        }
    }
    if !found {
        return error(domain.coded(domain.ERR_NOT_FOUND, "version {version} is not kept: run `flint-vault-server versions`"))
    }
    data := try store.blob_read(vault_id, version)
    n := head.version + 1
    try store.blob_write(vault_id, n, data, now_ms)
    return domain.BlobVersion{ version: n, vault_id: vault_id, size: i64(data.len()), stored_at: now_ms }
}
