package domain

// Stable error codes. Every error the core returns starts with one of these codes and
// a colon ("not_found: host 'web'"). cfire errors carry only a message, so the code
// travels as a prefix; drivers map it to an exit code and a JSON `code` field
// (Principle 7). Messages never contain secret values (Principle 6).

ERR_USAGE: str = "usage"
ERR_INVALID: str = "invalid"
ERR_NOT_FOUND: str = "not_found"
ERR_CONFLICT: str = "conflict"
ERR_LOCKED: str = "locked"
ERR_WRONG_PASSWORD: str = "wrong_password"
ERR_UNSUPPORTED: str = "unsupported"
ERR_KEYCHAIN: str = "keychain"
ERR_IO: str = "io"
ERR_INTERNAL: str = "internal"
// SSH codes (D-019), appended after the vault codes so exit codes 1-10 never move.
ERR_HOST_KEY: str = "host_key"
ERR_AUTH: str = "auth"
ERR_NETWORK: str = "network"
ERR_TIMEOUT: str = "timeout"
// Caller approval codes (milestone 12), appended so earlier exit codes never move.
ERR_DENIED: str = "denied"
ERR_APPROVAL_TIMEOUT: str = "approval_timeout"
// `flint exec --sudo` codes (milestone 13), appended likewise.
ERR_NOT_SUDOER: str = "not_sudoer"
ERR_SUDO_PASSWORD: str = "sudo_password"
// File copy codes (milestone 16), appended so earlier exit codes never move.
ERR_PERMISSION: str = "permission_denied"
ERR_EXISTS: str = "exists"
ERR_NOT_DIR: str = "not_a_directory"
// Tunnel codes (milestone 22), appended likewise.
ERR_PORT_IN_USE: str = "port_in_use"
// Host type code (milestone 29): an RDP host given to a command that only SSH does.
ERR_HOST_TYPE: str = "wrong_host_type"
// Remote desktop code (milestone 30): the server answered and refused the connection
// (Remote Desktop off, no free session), apart from `network` (not reached at all).
ERR_REFUSED: str = "refused"

// Builds an error message carrying a stable code.
fn coded(code: str, msg: str) -> str {
    return code + ": " + msg
}

// Every code a driver may see, in exit-code order (exit code = index + 1, except
// that `internal` is 1).
fn known_error_codes() -> []str {
    return [ERR_INTERNAL, ERR_USAGE, ERR_NOT_FOUND, ERR_CONFLICT, ERR_LOCKED, ERR_WRONG_PASSWORD, ERR_INVALID, ERR_UNSUPPORTED, ERR_KEYCHAIN, ERR_IO, ERR_HOST_KEY, ERR_AUTH, ERR_NETWORK, ERR_TIMEOUT, ERR_DENIED, ERR_APPROVAL_TIMEOUT, ERR_NOT_SUDOER, ERR_SUDO_PASSWORD, ERR_PERMISSION, ERR_EXISTS, ERR_NOT_DIR, ERR_PORT_IN_USE, ERR_HOST_TYPE, ERR_REFUSED]
}

// The code an error message starts with, or `internal` when it carries none.
fn error_code_of(msg: str) -> str {
    for code in known_error_codes() {
        if msg.len() > code.len() + 1 && msg.starts_with(code + ": ") {
            return code
        }
    }
    return ERR_INTERNAL
}

// The message without its code prefix.
fn error_text_of(msg: str) -> str {
    code := error_code_of(msg)
    prefix := code + ": "
    if msg.starts_with(prefix) {
        return msg.substr(prefix.len())
    }
    return msg
}

// The process exit code for an error code. Stable: scripts rely on it.
fn exit_code_for(code: str) -> i32 {
    codes := known_error_codes()
    for i, c in codes {
        if c == code {
            return i32(i) + 1
        }
    }
    return 1
}

test "error codes round-trip through a message" {
    msg := coded(ERR_NOT_FOUND, "host 'web'")
    assert_eq(error_code_of(msg), "not_found")
    assert_eq(error_text_of(msg), "host 'web'")
    assert_eq(error_code_of("vault: something odd"), "internal")
    assert_eq(error_text_of("vault: something odd"), "vault: something odd")
}

test "exit codes are stable" {
    assert_eq(exit_code_for(ERR_INTERNAL), 1)
    assert_eq(exit_code_for(ERR_USAGE), 2)
    assert_eq(exit_code_for(ERR_NOT_FOUND), 3)
    assert_eq(exit_code_for(ERR_CONFLICT), 4)
    assert_eq(exit_code_for(ERR_LOCKED), 5)
    assert_eq(exit_code_for(ERR_WRONG_PASSWORD), 6)
    assert_eq(exit_code_for(ERR_INVALID), 7)
    assert_eq(exit_code_for(ERR_UNSUPPORTED), 8)
    assert_eq(exit_code_for(ERR_KEYCHAIN), 9)
    assert_eq(exit_code_for(ERR_IO), 10)
    assert_eq(exit_code_for(ERR_HOST_KEY), 11)
    assert_eq(exit_code_for(ERR_AUTH), 12)
    assert_eq(exit_code_for(ERR_NETWORK), 13)
    assert_eq(exit_code_for(ERR_TIMEOUT), 14)
    assert_eq(exit_code_for(ERR_DENIED), 15)
    assert_eq(exit_code_for(ERR_APPROVAL_TIMEOUT), 16)
    assert_eq(exit_code_for(ERR_NOT_SUDOER), 17)
    assert_eq(exit_code_for(ERR_SUDO_PASSWORD), 18)
    assert_eq(exit_code_for(ERR_PERMISSION), 19)
    assert_eq(exit_code_for(ERR_EXISTS), 20)
    assert_eq(exit_code_for(ERR_NOT_DIR), 21)
    assert_eq(exit_code_for(ERR_PORT_IN_USE), 22)
    assert_eq(exit_code_for(ERR_HOST_TYPE), 23)
    assert_eq(exit_code_for(ERR_REFUSED), 24)
}
