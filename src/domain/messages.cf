pub MSG_REMOTE_TOKEN_REFUSED: str = "remote.token_refused"
pub MSG_REMOTE_WAIT_SECONDS: str = "remote.wait_seconds"
pub MSG_REMOTE_WAIT_MINUTES: str = "remote.wait_minutes"
