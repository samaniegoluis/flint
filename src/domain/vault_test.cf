package domain

test "names accept the documented alphabet only" {
    mut refused := 0
    try check_name("alias", "web-01.prod_a")
    check_name("alias", "") or { refused += 1 }
    assert_eq(refused, 1)
    check_name("alias", "-x") or { refused += 1 }
    assert_eq(refused, 2)
    check_name("alias", ".x") or { refused += 1 }
    assert_eq(refused, 3)
    check_name("alias", "web 01") or { refused += 1 }
    assert_eq(refused, 4)
    check_name("alias", "a/b") or { refused += 1 }
    assert_eq(refused, 5)
    mut bad := ""
    check_name("alias", "a b") or err { bad = "{err.message()}" }
    assert_eq(error_code_of("{bad}"), "invalid")
}

test "group paths split and validate" {
    mut refused := 0
    parts := split_group_path("/homelab//proxmox/")
    assert_eq(parts.len(), 2)
    assert_eq(parts[0], "homelab")
    assert_eq(parts[1], "proxmox")
    assert_eq(split_group_path("").len(), 0)
    try check_group_name("Home Lab")
    check_group_name(" x") or { refused += 1 }
    assert_eq(refused, 1)
}

test "host rules" {
    mut refused := 0
    try check_host(sample_host())
    mut h := sample_host()
    h.port = 70000
    check_host(h) or { refused += 1 }
    assert_eq(refused, 1)
    h = sample_host()
    h.color = "#ff88"
    check_host(h) or { refused += 1 }
    assert_eq(refused, 2)
    h = sample_host()
    h.hostname = "bad host"
    check_host(h) or { refused += 1 }
    assert_eq(refused, 3)
    h = sample_host()
    h.label = "two\nlines"
    check_host(h) or { refused += 1 }
    assert_eq(refused, 4)
    h = sample_host()
    h.jump_host_id = h.id
    check_host(h) or { refused += 1 }
    assert_eq(refused, 5)
    h = sample_host()
    h.initial_command = "herdr"
    try check_host(h)
    h.initial_command = "tmux\nattach"
    check_host(h) or { refused += 1 }
    assert_eq(refused, 6)
}

test "tags are deduplicated in order" {
    t := dedup_tags(["b", "a", "b"])
    assert_eq(t.len(), 2)
    assert_eq(t[0], "b")
}
