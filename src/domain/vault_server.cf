package domain

// The remote vault server's pure rules (milestone 42, D-097): what a version and a
// vault id look like on the wire, the server token's minimum, and the gate that limits
// each client's rate and locks out a client after repeated bad tokens (Principle 13).

import "core:str"

// The versions the server keeps on disk; older ones are pruned after each upload.
SERVER_VERSIONS_KEPT: i64 = 10
// The shortest server token accepted at start (`flint-vault-server token` makes 64).
SERVER_TOKEN_MIN_LEN: usize = 32
// A vault id is 128 bits as lowercase hex (D-030, D-095).
VAULT_ID_HEX_LEN: usize = 32

// Requests one client may make in a window before it is told to wait.
GATE_RATE_WINDOW_MS: i64 = 60000
GATE_RATE_MAX: i64 = 120
// Bad tokens one client may present in a window before it is locked out.
GATE_BAD_WINDOW_MS: i64 = 600000
GATE_BAD_MAX: i64 = 10
GATE_LOCKOUT_MS: i64 = 900000
// Clients remembered at once; the one seen longest ago is forgotten first.
GATE_CLIENTS_MAX: i64 = 1024

// One stored version of the vault, as `flint-vault-server versions` lists it.
type BlobVersion struct {
    version:    i64 `json:"version"`
    vault_id:   str `json:"vault_id"`
    size:       i64 `json:"size"`
    // Unix milliseconds.
    stored_at:  i64 `json:"stored_at"`
}

// "7", "\"7\"" or "W/\"7\"" -> 7; -1 for anything else (a version is at least 1).
fn parse_version_tag(tag: str) -> i64 {
    mut t := str.trim(tag)
    if t.starts_with("W/") {
        t = t.substr(2)
    }
    if t.len() >= 2 && t.starts_with("\"") && t.ends_with("\"") {
        t = t.substr(1, t.len() - 2)
    }
    if t.len() == 0 || t.len() > 18 {
        return -1
    }
    mut n: i64 = 0
    for b in t.bytes() {
        c := u8(b)
        if !is_digit_byte(c) {
            return -1
        }
        n = n * 10 + i64(c - 48)
    }
    if n < 1 {
        return -1
    }
    return n
}

// The tag a version travels as, in `ETag` and `If-Match`.
fn version_tag(version: i64) -> str {
    return "\"{version}\""
}

fn valid_vault_id(id: str) -> bool {
    if id.len() != VAULT_ID_HEX_LEN {
        return false
    }
    for b in id.bytes() {
        c := u8(b)
        // 'a' to 'f'
        if !is_digit_byte(c) && !(c >= 97 && c <= 102) {
            return false
        }
    }
    return true
}

// Refuses a server token too short to stand against guessing.
fn check_server_token(token: str) -> void! {
    if token.len() < SERVER_TOKEN_MIN_LEN {
        return error(coded(ERR_INVALID, "the server token is shorter than {SERVER_TOKEN_MIN_LEN} characters: make one with `flint-vault-server token`"))
    }
    if str.trim(token) != token {
        return error(coded(ERR_INVALID, "the server token starts or ends with white space"))
    }
}

// What the gate remembers of one client.
type GateClient struct {
    client:       str
    last_seen:    i64
    window_start: i64
    count:        i64
    bad_start:    i64
    bad_count:    i64
    locked_until: i64
}

// Per-client rate limit and bad-token lockout. Not thread-safe: the server serves one
// request at a time (D-097).
type ServerGate struct {
    clients: []GateClient
}

fn new_server_gate() -> ServerGate {
    return ServerGate{ clients: [] }
}

fn (mut self: ServerGate) gate_index(client: str, now_ms: i64) -> usize {
    for i in 0..self.clients.len() {
        if self.clients[i].client == client {
            self.clients[i].last_seen = now_ms
            return i
        }
    }
    if i64(self.clients.len()) >= GATE_CLIENTS_MAX {
        // A locked-out client is forgotten only when every client is locked out, and
        // then the one whose lockout ends first.
        mut oldest: usize = 0
        mut found := false
        for i in 0..self.clients.len() {
            if self.clients[i].locked_until <= now_ms && (!found || self.clients[i].last_seen < self.clients[oldest].last_seen) {
                oldest = i
                found = true
            }
        }
        if !found {
            for i in 0..self.clients.len() {
                if self.clients[i].locked_until < self.clients[oldest].locked_until {
                    oldest = i
                }
            }
        }
        self.clients[oldest] = GateClient{ client: client, last_seen: now_ms, window_start: now_ms, count: 0, bad_start: now_ms, bad_count: 0, locked_until: 0 }
        return oldest
    }
    self.clients.push(GateClient{ client: client, last_seen: now_ms, window_start: now_ms, count: 0, bad_start: now_ms, bad_count: 0, locked_until: 0 })
    return self.clients.len() - 1
}

// 0 when the client may go on, or how many milliseconds it must wait: still locked
// out, or over its rate in this window. Counts the request.
fn (mut self: ServerGate) gate_admit(client: str, now_ms: i64) -> i64 {
    i := self.gate_index(client, now_ms)
    if self.clients[i].locked_until > now_ms {
        return self.clients[i].locked_until - now_ms
    }
    if now_ms - self.clients[i].window_start >= GATE_RATE_WINDOW_MS {
        self.clients[i].window_start = now_ms
        self.clients[i].count = 0
    }
    self.clients[i].count += 1
    if self.clients[i].count > GATE_RATE_MAX {
        return self.clients[i].window_start + GATE_RATE_WINDOW_MS - now_ms
    }
    return 0
}

// Records a bad or missing token; true when this one locked the client out.
fn (mut self: ServerGate) gate_bad_token(client: str, now_ms: i64) -> bool {
    i := self.gate_index(client, now_ms)
    if now_ms - self.clients[i].bad_start >= GATE_BAD_WINDOW_MS {
        self.clients[i].bad_start = now_ms
        self.clients[i].bad_count = 0
    }
    self.clients[i].bad_count += 1
    if self.clients[i].bad_count >= GATE_BAD_MAX {
        self.clients[i].locked_until = now_ms + GATE_LOCKOUT_MS
        self.clients[i].bad_count = 0
        self.clients[i].bad_start = now_ms
        return true
    }
    return false
}
