package domain

// Per-machine settings of the desktop app: appearance and terminal. They describe
// this computer's preferences, not a vault, so they live beside the recent-vaults
// list and never hold anything from inside a vault (Principle 5).

type Settings struct {
    theme:              str  `json:"theme"`
    accent:             str  `json:"accent"`
    density:            str  `json:"density"`
    follow_motion:      bool `json:"follow_motion"`
    reopen_last_vault:  bool `json:"reopen_last_vault"`
    term_font:          str  `json:"term_font"`
    term_font_size:     i64  `json:"term_font_size"`
    term_line_height:   i64  `json:"term_line_height"`
    term_cursor:        str  `json:"term_cursor"`
    term_cursor_blink:  bool `json:"term_cursor_blink"`
    // Milestone 07. A file written before it has none and reads the default.
    term_theme:         str  `json:"term_theme" default:"default"`
    // Milestone 11b: how long the vault stays unlocked with nobody using it
    // (LOCK_AFTER, "never" to turn it off). Older files read the default.
    lock_after:         str  `json:"lock_after" default:"1h"`
    // Milestone 14: the keys every earlier Flint cached on each unlock were removed
    // from this machine's keychain (D-048). Set once by the app, never by the page.
    keys_cleared:       bool `json:"keys_cleared" default:"false"`
    // Milestone 25: the largest image or file a paste into the terminal uploads, in
    // MB (PASTE_LIMITS_MB). Older files read the default.
    paste_limit_mb:     i64  `json:"paste_limit_mb" default:"20"`
    // Milestone 31 (D-074): what the modifier keys of a Mac keyboard send in an RDP
    // tab, a preset (RDP_MAC_KEYS); "custom" reads `rdp_mac_custom`, one target per
    // key ("MetaLeft=ctrl,AltLeft=alt,…", RDP_MAC_KEY_CODES to RDP_KEY_TARGETS); a key
    // it leaves out keeps the Mac preset's. macOS only; older files read the defaults.
    rdp_mac_keys:       str  `json:"rdp_mac_keys" default:"mac"`
    rdp_mac_custom:     str  `json:"rdp_mac_custom" default:""`
}

RDP_MAC_KEYS: []str = ["mac", "windows", "custom"]
// The six modifier keys of a Mac keyboard, by their W3C `code`.
RDP_MAC_KEY_CODES: []str = ["ControlLeft", "ControlRight", "AltLeft", "AltRight", "MetaLeft", "MetaRight"]
// What each can send: a PC keyboard's Ctrl, Alt, AltGr (right Alt), Windows key, or nothing.
RDP_KEY_TARGETS: []str = ["ctrl", "alt", "altgr", "win", "off"]

// Terminal colour themes (ui/src/lib/terminalThemes.ts holds the palettes).
TERM_THEMES: []str = ["default", "catppuccin", "tokyo-night", "aura", "dracula", "nord"]

// Auto-lock after this long idle (D-042). 1m is there to try it out.
LOCK_AFTER: []str = ["1m", "5m", "15m", "30m", "1h", "4h", "never"]
LOCK_AFTER_DEFAULT: str = "1h"

TERM_FONT_SIZE_MIN: i64 = 8
TERM_FONT_SIZE_MAX: i64 = 32
// Line height in hundredths: 150 is 1.50. The default is 100 (xterm.js and most
// terminals): taller rows cost TUIs rows and break box-drawing and powerline glyphs.
TERM_LINE_HEIGHT_MIN: i64 = 100
TERM_LINE_HEIGHT_MAX: i64 = 200

fn default_settings() -> Settings {
    return Settings{ theme: "system", accent: "ember", density: "default", follow_motion: true, reopen_last_vault: true, term_font: "", term_font_size: 13, term_line_height: 100, term_cursor: "block", term_cursor_blink: true, term_theme: "default", lock_after: LOCK_AFTER_DEFAULT, keys_cleared: false, paste_limit_mb: PASTE_LIMIT_DEFAULT_MB, rdp_mac_keys: "mac", rdp_mac_custom: "" }
}

fn one_of(value: str, allowed: []str) -> bool {
    for a in allowed {
        if a == value {
            return true
        }
    }
    return false
}

// Whether check_settings passes.
fn settings_valid(s: Settings) -> bool {
    check_settings(s) or {
        return false
    }
    return true
}

// Checks every field; the message names the first one that is wrong.
fn check_settings(s: Settings) -> void! {
    if !one_of(s.theme, ["system", "dark", "light"]) {
        return error(coded(ERR_INVALID, "theme must be system, dark or light"))
    }
    if !one_of(s.accent, ["ember", "sapphire", "moss", "iris"]) {
        return error(coded(ERR_INVALID, "accent must be ember, sapphire, moss or iris"))
    }
    if !one_of(s.density, ["compact", "default", "comfortable"]) {
        return error(coded(ERR_INVALID, "density must be compact, default or comfortable"))
    }
    if s.term_font_size < TERM_FONT_SIZE_MIN || s.term_font_size > TERM_FONT_SIZE_MAX {
        return error(coded(ERR_INVALID, "terminal font size must be {TERM_FONT_SIZE_MIN} to {TERM_FONT_SIZE_MAX}"))
    }
    if s.term_line_height < TERM_LINE_HEIGHT_MIN || s.term_line_height > TERM_LINE_HEIGHT_MAX {
        return error(coded(ERR_INVALID, "terminal line height must be 1.00 to 2.00"))
    }
    if !one_of(s.term_cursor, ["block", "bar", "underline"]) {
        return error(coded(ERR_INVALID, "cursor must be block, bar or underline"))
    }
    if !one_of(s.term_theme, TERM_THEMES) {
        return error(coded(ERR_INVALID, "terminal theme must be default, catppuccin, tokyo-night, aura, dracula or nord"))
    }
    if !one_of(s.lock_after, LOCK_AFTER) {
        return error(coded(ERR_INVALID, "lock after must be 1m, 5m, 15m, 30m, 1h, 4h or never"))
    }
    if !paste_limit_valid(s.paste_limit_mb) {
        return error(coded(ERR_INVALID, "largest file to paste must be 10, 20, 50 or 100 MB"))
    }
    if !one_of(s.rdp_mac_keys, RDP_MAC_KEYS) {
        return error(coded(ERR_INVALID, "remote desktop keys must be mac, windows or custom"))
    }
    try check_rdp_mac_custom(s.rdp_mac_custom)
    try check_text("terminal font", s.term_font, 128, false)
    // The name ends up in a CSS font-family list, quoted.
    for b in s.term_font.bytes() {
        c := u8(b)
        if c == 34 || c == 39 || c == 92 || c == 59 || c == 123 || c == 125 {
            return error(coded(ERR_INVALID, "terminal font must not contain quotes, backslashes, ';' or braces"))
        }
    }
}

test "default settings are valid and bad values are refused" {
    mut refused := 0
    try check_settings(default_settings())
    mut s := default_settings()
    s.theme = "neon"
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 1)
    s = default_settings()
    s.term_font_size = 99
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 2)
    s = default_settings()
    s.term_line_height = 90
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 3)
    s = default_settings()
    s.term_font = "JetBrainsMono Nerd Font"
    try check_settings(s)
    s.term_font = "x\"; color: red"
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 4)
    s = default_settings()
    s.term_theme = "aura"
    try check_settings(s)
    s.term_theme = "solarized"
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 5)
    s = default_settings()
    assert_eq(s.lock_after, "1h")
    s.lock_after = "1m"
    try check_settings(s)
    s.lock_after = "2m"
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 6)
}

// How long an idle vault stays unlocked, in milliseconds; 0 for never.
fn lock_after_ms(setting: str) -> i64 {
    if setting == "1m" {
        return 60000
    }
    if setting == "5m" {
        return 300000
    }
    if setting == "15m" {
        return 900000
    }
    if setting == "30m" {
        return 1800000
    }
    if setting == "1h" {
        return 3600000
    }
    if setting == "4h" {
        return 14400000
    }
    return 0
}

// Whether an unlocked vault last used at `last_ms` locks now.
fn idle_lock_due(now_ms: i64, last_ms: i64, setting: str) -> bool {
    limit := lock_after_ms(setting)
    return limit > 0 && now_ms - last_ms >= limit
}

test "idle lock follows the setting" {
    assert(!idle_lock_due(59999, 0, "1m"))
    assert(idle_lock_due(60000, 0, "1m"))
    assert(!idle_lock_due(3599999, 0, "1h"))
    assert(idle_lock_due(3600000, 0, "1h"))
    assert(!idle_lock_due(999999999, 0, "never"))
    assert_eq(lock_after_ms(""), 0)
}

// "" or comma-separated `code=target` pairs, each key at most once.
fn check_rdp_mac_custom(v: str) -> void! {
    if v.len() == 0 {
        return
    }
    if v.len() > 256 {
        return error(coded(ERR_INVALID, "custom remote desktop keys are too long"))
    }
    mut seen: []str = []
    for pair in str.split(v, ",") {
        parts := str.split(pair, "=")
        if parts.len() != 2 || !one_of(parts[0], RDP_MAC_KEY_CODES) || !one_of(parts[1], RDP_KEY_TARGETS) {
            return error(coded(ERR_INVALID, "custom remote desktop keys must be pairs such as MetaLeft=ctrl"))
        }
        if one_of(parts[0], seen) {
            return error(coded(ERR_INVALID, "custom remote desktop keys name {parts[0]} twice"))
        }
        seen.push(parts[0])
    }
}

test "remote desktop keys are a preset and an optional custom table" {
    mut s := default_settings()
    assert_eq(s.rdp_mac_keys, "mac")
    s.rdp_mac_keys = "windows"
    try check_settings(s)
    s.rdp_mac_keys = "custom"
    s.rdp_mac_custom = "ControlLeft=win,ControlRight=off,AltLeft=alt,AltRight=altgr,MetaLeft=ctrl,MetaRight=ctrl"
    try check_settings(s)
    mut refused := 0
    s.rdp_mac_keys = "linux"
    check_settings(s) or { refused += 1 }
    s.rdp_mac_keys = "custom"
    for bad in ["MetaLeft", "MetaLeft=hyper", "Fn=ctrl", "MetaLeft=ctrl,MetaLeft=alt", "MetaLeft=ctrl,", "=ctrl"] {
        s.rdp_mac_custom = bad
        check_settings(s) or { refused += 1 }
    }
    assert_eq(refused, 7)
}
