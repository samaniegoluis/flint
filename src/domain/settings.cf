package domain

// Per-machine settings of the desktop app: appearance and terminal. They describe
// this computer's preferences, not a vault, so they live beside the recent-vaults
// list and never hold anything from inside a vault (Principle 5).

pub type Settings struct {
    theme:              str  `json:"theme"`
    accent:             str  `json:"accent"`
    density:            str  `json:"density"`
    follow_motion:      bool `json:"follow_motion"`
    reopen_last_vault:  bool `json:"reopen_last_vault"`
    term_font:          str  `json:"term_font"`
    term_font_size:     i64  `json:"term_font_size"`
    term_line_height:   i64  `json:"term_line_height"`
    term_cursor:        str  `json:"term_cursor"`
    term_cursor_blink:  bool `json:"term_cursor_blink"`
    // Milestone 07. A file written before it has none and reads the default.
    term_theme:         str  `json:"term_theme" default:"default"`
    // Milestone 11b: how long the vault stays unlocked with nobody using it
    // (LOCK_AFTER, "never" to turn it off). Older files read the default.
    lock_after:         str  `json:"lock_after" default:"1h"`
    // Milestone 14: the keys every earlier Flint cached on each unlock were removed
    // from this machine's keychain (D-048). Set once by the app, never by the page.
    keys_cleared:       bool `json:"keys_cleared" default:"false"`
    // Milestone 64: what WebView2 had stored from the page's fields (autofill,
    // saved passwords) was removed from this machine. Set once by the app, never by
    // the page.
    webview_cleared:    bool `json:"webview_cleared" default:"false"`
    // Milestone 25: the largest image or file a paste into the terminal uploads, in
    // MB (PASTE_LIMITS_MB). Older files read the default.
    paste_limit_mb:     i64  `json:"paste_limit_mb" default:"20"`
    // Milestone 31 (D-074): what the modifier keys of a Mac keyboard send in an RDP
    // tab, a preset (RDP_MAC_KEYS); "custom" reads `rdp_mac_custom`, one target per
    // key ("MetaLeft=ctrl,AltLeft=alt,…", RDP_MAC_KEY_CODES to RDP_KEY_TARGETS); a key
    // it leaves out keeps the Mac preset's. macOS only; older files read the defaults.
    rdp_mac_keys:       str  `json:"rdp_mac_keys" default:"mac"`
    rdp_mac_custom:     str  `json:"rdp_mac_custom" default:""`
    // How a new RDP tab asks for its desktop (RDP_GRAPHICS): "pipeline" offers the
    // graphics pipeline (RDPGFX, milestone 34), "compatible" keeps the bitmap updates of
    // v8, "auto" picks one of them at connect by the link's round trip (milestone 35,
    // auto_rdp_graphics). Older files read the default.
    rdp_graphics:       str  `json:"rdp_graphics" default:"auto"`
    // Milestone 43 (D-098): seconds between the app's checks for another machine's
    // changes to a connected vault (SYNC_INTERVALS); 0 checks only at unlock, after a
    // change, when the window comes back and on demand. Older files read the default.
    sync_interval:      i64  `json:"sync_interval" default:"60"`
    // Milestone 46 (D-106 (3)): the window corner toasts appear in (TOAST_CORNERS).
    // Older files read the default.
    toast_corner:       str  `json:"toast_corner" default:"bottom-right"`
    // Milestone 48 (D-111 (2)): the first launch of a packaged app offered to put the
    // `flint` command on the PATH. Set by the app, never by the page.
    cli_offer_shown:    bool `json:"cli_offer_shown" default:"false"`
    // Milestone 52 (D-106 (4), D-116): check for a newer Flint at launch and every hour.
    update_check:       bool `json:"update_check" default:"true"`
    // Milestone 52: the newer version whose toast was shown (once per version, D-116),
    // and the version What's new last showed for (or the first that ran here). Set by
    // the app, never by the page.
    update_toast_version: str `json:"update_toast_version" default:""`
    last_seen_version:  str  `json:"last_seen_version" default:""`
    // Milestone 55 (design 25b1): the active tab's server resources in the status
    // bar, read over the tab's own session, and whether its values are coloured by
    // load. Older files read the defaults.
    server_stats:       bool `json:"server_stats" default:"true"`
    server_stats_colour: bool `json:"server_stats_colour" default:"true"`
    // Milestone 72 (D-150): the page dims the split panes without the focus, and every
    // pane while the window has none.
    dim_unfocused:      bool `json:"dim_unfocused" default:"true"`
    // Milestone 56 (D-117 (3), design 26d1): whether a new grant notifies each command
    // it allows; the approval window's checkbox starts from it. Older files read the
    // default.
    notify_grants:      bool `json:"notify_grants" default:"true"`
    // Milestone 57 (D-126 (4), designs 25e1/25e2): *Allow sudo for a while*. Off, the
    // root approval window offers each command only; turning it off ends every root
    // period. This machine's, like the grants it unlocks.
    sudo_periods:       bool `json:"sudo_periods" default:"false"`
    // Milestone 61 (D-134 (2)): how long every approval window, and a command waiting
    // for its vault's unlock, waits for the person, in minutes (APPROVAL_WAITS). This
    // machine's. Older files read the default.
    approval_wait:      i64  `json:"approval_wait" default:"2"`
    // Milestone 63 (D-134 (4), Principle 19): alerts on the person's phone through
    // ntfy, off by default; the server, and this machine's random topic. The topic is
    // made by the app (ntfy_topic_from), never taken from the page. Older files read
    // the defaults.
    ntfy_on:            bool `json:"ntfy_on" default:"false"`
    ntfy_server:        str  `json:"ntfy_server" default:"https://ntfy.sh"`
    ntfy_topic:         str  `json:"ntfy_topic" default:""`
    // Milestone 65 (D-138 (1)): which phone the QR of Settings → Notifications is for
    // (NTFY_PHONES): the iPhone's `https` link, or Android's `ntfy://` that subscribes
    // in one scan. Older files read the default.
    ntfy_phone:         str  `json:"ntfy_phone" default:"iphone"`
    // Milestone 65 (D-138 (3)): what ✕ does on a desktop with no tray (CLOSE_ACTIONS):
    // "" asks the first time, "quit" quits, "background" hides the window and keeps
    // serving as a tray would. A desktop with a tray always hides. Older files read
    // the default.
    close_action:       str  `json:"close_action" default:""`
    // Milestone 66 (D-140): the language of the desktop app (LANGUAGES). "system" follows
    // the OS's language, read at start (os_language); the page holds every translation
    // and the core stays English (Principle 21). Older files read the default.
    language:           str  `json:"language" default:"system"`
}

RDP_MAC_KEYS: []str = ["mac", "windows", "custom"]
pub RDP_GRAPHICS: []str = ["auto", "pipeline", "compatible"]
TOAST_CORNERS: []str = ["bottom-right", "bottom-left", "top-right", "top-left"]
pub NTFY_PHONES: []str = ["iphone", "android"]
pub CLOSE_ACTIONS: []str = ["", "quit", "background"]
pub LANGUAGES: []str = ["system", "en", "es"]
// The six modifier keys of a Mac keyboard, by their W3C `code`.
RDP_MAC_KEY_CODES: []str = ["ControlLeft", "ControlRight", "AltLeft", "AltRight", "MetaLeft", "MetaRight"]
// What each can send: a PC keyboard's Ctrl, Alt, AltGr (right Alt), Windows key, or nothing.
RDP_KEY_TARGETS: []str = ["ctrl", "alt", "altgr", "win", "off"]

// The approval wait's choices, in minutes (D-134 (2)).
APPROVAL_WAITS: []i64 = [2, 5, 10, 30]
APPROVAL_WAIT_DEFAULT: i64 = 2

// Terminal colour themes (ui/src/lib/terminalThemes.ts holds the palettes).
TERM_THEMES: []str = ["default", "catppuccin", "tokyo-night", "aura", "dracula", "nord"]

// Auto-lock after this long idle (D-042). 1m is there to try it out.
LOCK_AFTER: []str = ["1m", "5m", "15m", "30m", "1h", "4h", "never"]
LOCK_AFTER_DEFAULT: str = "1h"

TERM_FONT_SIZE_MIN: i64 = 8
TERM_FONT_SIZE_MAX: i64 = 32
// Line height in hundredths: 150 is 1.50. The default is 100 (xterm.js and most
// terminals): taller rows cost TUIs rows and break box-drawing and powerline glyphs.
TERM_LINE_HEIGHT_MIN: i64 = 100
TERM_LINE_HEIGHT_MAX: i64 = 200

pub fn default_settings() -> Settings {
    return Settings{ theme: "system", accent: "ember", density: "default", follow_motion: true, reopen_last_vault: true, term_font: "", term_font_size: 13, term_line_height: 100, term_cursor: "block", term_cursor_blink: true, term_theme: "default", lock_after: LOCK_AFTER_DEFAULT, keys_cleared: false, webview_cleared: false, paste_limit_mb: PASTE_LIMIT_DEFAULT_MB, rdp_mac_keys: "mac", rdp_mac_custom: "", rdp_graphics: "auto", sync_interval: SYNC_INTERVAL_DEFAULT, toast_corner: "bottom-right", cli_offer_shown: false, update_check: true, update_toast_version: "", last_seen_version: "", server_stats: true, server_stats_colour: true, dim_unfocused: true, notify_grants: true, sudo_periods: false, approval_wait: APPROVAL_WAIT_DEFAULT, ntfy_on: false, ntfy_server: NTFY_SERVER_DEFAULT, ntfy_topic: "", ntfy_phone: "iphone", close_action: "", language: "system" }
}

pub fn one_of(value: str, allowed: []str) -> bool {
    for a in allowed {
        if a == value {
            return true
        }
    }
    return false
}

// Whether check_settings passes.
pub fn settings_valid(s: Settings) -> bool {
    check_settings(s) or {
        return false
    }
    return true
}

// Checks every field; the message names the first one that is wrong.
pub fn check_settings(s: Settings) -> void! {
    if !one_of(s.theme, ["system", "dark", "light"]) {
        return error(coded(ERR_INVALID, "theme must be system, dark or light"))
    }
    if !one_of(s.accent, ["ember", "sapphire", "moss", "iris"]) {
        return error(coded(ERR_INVALID, "accent must be ember, sapphire, moss or iris"))
    }
    if !one_of(s.density, ["compact", "default", "comfortable"]) {
        return error(coded(ERR_INVALID, "density must be compact, default or comfortable"))
    }
    if s.term_font_size < TERM_FONT_SIZE_MIN || s.term_font_size > TERM_FONT_SIZE_MAX {
        return error(coded(ERR_INVALID, "terminal font size must be {TERM_FONT_SIZE_MIN} to {TERM_FONT_SIZE_MAX}"))
    }
    if s.term_line_height < TERM_LINE_HEIGHT_MIN || s.term_line_height > TERM_LINE_HEIGHT_MAX {
        return error(coded(ERR_INVALID, "terminal line height must be 1.00 to 2.00"))
    }
    if !one_of(s.term_cursor, ["block", "bar", "underline"]) {
        return error(coded(ERR_INVALID, "cursor must be block, bar or underline"))
    }
    if !one_of(s.term_theme, TERM_THEMES) {
        return error(coded(ERR_INVALID, "terminal theme must be default, catppuccin, tokyo-night, aura, dracula or nord"))
    }
    if !one_of(s.lock_after, LOCK_AFTER) {
        return error(coded(ERR_INVALID, "lock after must be 1m, 5m, 15m, 30m, 1h, 4h or never"))
    }
    if !paste_limit_valid(s.paste_limit_mb) {
        return error(coded(ERR_INVALID, "largest file to paste must be 10, 20, 50 or 100 MB"))
    }
    if !one_of(s.rdp_mac_keys, RDP_MAC_KEYS) {
        return error(coded(ERR_INVALID, "remote desktop keys must be mac, windows or custom"))
    }
    try check_rdp_mac_custom(s.rdp_mac_custom)
    if !valid_sync_interval(s.sync_interval) {
        return error(coded(ERR_INVALID, "sync interval must be 0 (off), 60, 300 or 900 seconds"))
    }
    if !one_of(s.rdp_graphics, RDP_GRAPHICS) {
        return error(coded(ERR_INVALID, "remote desktop graphics must be auto, pipeline or compatible"))
    }
    if !approval_wait_valid(s.approval_wait) {
        return error(coded(ERR_INVALID, "approval wait must be 2, 5, 10 or 30 minutes"))
    }
    if !one_of(s.toast_corner, TOAST_CORNERS) {
        return error(coded(ERR_INVALID, "notifications corner must be bottom-right, bottom-left, top-right or top-left"))
    }
    try check_ntfy_server(s.ntfy_server)
    if !one_of(s.ntfy_phone, NTFY_PHONES) {
        return error(coded(ERR_INVALID, "the phone must be iphone or android"))
    }
    if !one_of(s.close_action, CLOSE_ACTIONS) {
        return error(coded(ERR_INVALID, "closing the window must be ask (empty), quit or background"))
    }
    if !one_of(s.language, LANGUAGES) {
        return error(coded(ERR_INVALID, "language must be system, en or es"))
    }
    if s.ntfy_topic.len() > 0 && !ntfy_topic_valid(s.ntfy_topic) {
        return error(coded(ERR_INVALID, "the ntfy topic must be letters, digits, '-' or '_', at most {NTFY_TOPIC_MAX}"))
    }
    try check_text("terminal font", s.term_font, 128, false)
    // The name ends up in a CSS font-family list, quoted.
    for b in s.term_font.bytes() {
        c := u8(b)
        if c == 34 || c == 39 || c == 92 || c == 59 || c == 123 || c == 125 {
            return error(coded(ERR_INVALID, "terminal font must not contain quotes, backslashes, ';' or braces"))
        }
    }
}

// How long an idle vault stays unlocked, in milliseconds; 0 for never.
fn lock_after_ms(setting: str) -> i64 {
    if setting == "1m" {
        return 60000
    }
    if setting == "5m" {
        return 300000
    }
    if setting == "15m" {
        return 900000
    }
    if setting == "30m" {
        return 1800000
    }
    if setting == "1h" {
        return 3600000
    }
    if setting == "4h" {
        return 14400000
    }
    return 0
}

pub fn approval_wait_valid(minutes: i64) -> bool {
    for m in APPROVAL_WAITS {
        if m == minutes {
            return true
        }
    }
    return false
}

// How long an approval, or a command waiting for an unlock, waits for the person:
// the setting's minutes, or `override_ms` when it is shorter and above zero (the
// end-to-end runs' FLINT_APPROVAL_WAIT_MS, to see a timeout in seconds). A setting
// that is not one of APPROVAL_WAITS reads the default.
pub fn approval_wait_ms(minutes: i64, override_ms: i64) -> i64 {
    mut m := minutes
    if !approval_wait_valid(m) {
        m = APPROVAL_WAIT_DEFAULT
    }
    ms := m * 60000
    if override_ms > 0 && override_ms < ms {
        return override_ms
    }
    return ms
}

// Whether an unlocked vault last used at `last_ms` locks now.
pub fn idle_lock_due(now_ms: i64, last_ms: i64, setting: str) -> bool {
    limit := lock_after_ms(setting)
    return limit > 0 && now_ms - last_ms >= limit
}

// "" or comma-separated `code=target` pairs, each key at most once.
fn check_rdp_mac_custom(v: str) -> void! {
    if v.len() == 0 {
        return
    }
    if v.len() > 256 {
        return error(coded(ERR_INVALID, "custom remote desktop keys are too long"))
    }
    mut seen: []str = []
    for pair in v.split(",") {
        parts := pair.split("=")
        if parts.len() != 2 || !one_of(parts[0], RDP_MAC_KEY_CODES) || !one_of(parts[1], RDP_KEY_TARGETS) {
            return error(coded(ERR_INVALID, "custom remote desktop keys must be pairs such as MetaLeft=ctrl"))
        }
        if one_of(parts[0], seen) {
            return error(coded(ERR_INVALID, "custom remote desktop keys name {parts[0]} twice"))
        }
        seen.push(parts[0])
    }
}

// What ✕ does (milestone 65, D-138 (3)). With a tray (macOS, Windows, a Linux desktop
// whose tray shows cfire's icon) the window hides and Flint keeps serving, as since
// milestone 14. With none, the person's answer decides; with no answer yet, the page
// asks.
CLOSE_HIDE: str = "hide"
pub CLOSE_QUIT: str = "quit"
pub CLOSE_ASK: str = "ask"

pub fn close_decision(has_tray: bool, close_action: str) -> str {
    if has_tray || close_action == "background" {
        return CLOSE_HIDE
    }
    if close_action == "quit" {
        return CLOSE_QUIT
    }
    return CLOSE_ASK
}
