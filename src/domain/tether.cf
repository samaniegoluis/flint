package domain

import "core:encoding/base64"

// A Tether vault, as read for a one-shot import into Flint (milestone 08).
//
// Tether (the Go client Flint replaces) keeps a plain SQLite file: groups, hosts and
// the rest in clear, each secret column sealed on its own with XChaCha20-Poly1305
// (base64 of nonce || ciphertext || tag, no AAD) under a key derived from the master
// password with Argon2id (t=1, 64 MiB, 4 lanes; base64 salt in `settings`). A
// constant sealed the same way, `crypto.verifier`, tells a wrong password.
// The adapter hands these rows over with every secret still sealed (`*_enc`).

// Versions of Tether's schema (`PRAGMA user_version`) the import reads. 1 has
// groups and hosts; 2 adds stored keys, known hosts and host passwords; 3
// credentials; 4 the initial command; 5 tunnels and jump hosts.
var TETHER_FORMAT_MIN: i64 = 1
var TETHER_FORMAT_MAX: i64 = 5
var TETHER_VERIFIER: str = "tether-verify-v1"

type TetherGroup struct {
    id: str
    parent_id: str
    name: str
}

type TetherHost struct {
    id: str
    group_id: str
    label: str
    hostname: str
    port: i64
    username: str
    auth_type: str
    key_id: str
    key_path: str
    credential_id: str
    jump_host_id: str
    password_enc: str
    tags: []str
    color: str
    notes: str
    initial_command: str
}

type TetherKey struct {
    id: str
    name: str
    key_type: str
    fingerprint: str
    private_key_enc: str
    passphrase_enc: str
}

type TetherCredential struct {
    id: str
    name: str
    username: str
    auth_type: str
    key_id: str
    password_enc: str
}

type TetherKnownHost struct {
    addr: str
    key_type: str
    fingerprint: str
    host_id: str
    created_at: str
}

type TetherTunnel struct {
    host_id: str
    name: str
    local_port: i64
    remote_host: str
    remote_port: i64
}

// Declared after its element types (CF-033).
type TetherFile struct {
    format: i64
    salt_b64: str
    verifier_enc: str
    groups: []TetherGroup
    hosts: []TetherHost
    keys: []TetherKey
    creds: []TetherCredential
    known_hosts: []TetherKnownHost
    tunnels: []TetherTunnel
}

// Base64 text to `[]byte`. `base64.decode` returns cfire's other byte vector, which
// no `[]byte` parameter takes (CF-055), so the bytes are copied.
fn tether_b64(text: str) -> []byte! {
    raw := base64.decode(text) or err {
        return error(coded(ERR_INVALID, "a Tether value is not valid base64"))
    }
    mut bytes_out: []byte = []
    for b in raw {
        bytes_out.push(u8(b))
    }
    return bytes_out
}

// A known-host address as Tether records it ("host:port", "[v6]:port") in Flint's
// form: the bare host on port 22, "[host]:port" otherwise (known_host_addr). "" when
// it cannot be read.
fn tether_addr_to_flint(addr: str) -> str {
    bytes := addr.bytes()
    mut colon: i64 = -1
    for i in 0..bytes.len() {
        if u8(bytes[i]) == 58 {
            colon = i64(i)
        }
    }
    if colon <= 0 || colon == i64(bytes.len()) - 1 {
        return ""
    }
    // A slice is a string view and passes to no `str` parameter: copy it (CF-060).
    head := addr[0..usize(colon)]
    mut host := "{head}"
    port_text := addr[usize(colon) + 1..addr.len()]
    mut port: i64 = 0
    for b in port_text.bytes() {
        c := u8(b)
        if c < 48 || c > 57 || port > 65535 {
            return ""
        }
        port = port * 10 + i64(c - 48)
    }
    hb := host.bytes()
    if hb.len() >= 2 && u8(hb[0]) == 91 && u8(hb[hb.len() - 1]) == 93 {
        inner := host[1..host.len() - 1]
        host = "{inner}"
    }
    if host.len() == 0 || port < 1 || port > 65535 {
        return ""
    }
    return known_host_addr(host, port)
}

test "tether known-host addresses map to Flint's" {
    assert_eq(tether_addr_to_flint("codebox.lan:22"), "codebox.lan")
    assert_eq(tether_addr_to_flint("pve-01.lan:2222"), "[pve-01.lan]:2222")
    assert_eq(tether_addr_to_flint("[fe80::1]:22"), "fe80::1")
    assert_eq(tether_addr_to_flint("[fe80::1]:2200"), "[fe80::1]:2200")
    assert_eq(tether_addr_to_flint("CodeBox.LAN:22"), "codebox.lan")
    assert_eq(tether_addr_to_flint("no-port"), "")
    assert_eq(tether_addr_to_flint("host:"), "")
    assert_eq(tether_addr_to_flint("host:99999"), "")
    assert_eq(tether_addr_to_flint(":22"), "")
}

test "tether base64 values decode to bytes" {
    b := try tether_b64("AAEC/w==")
    assert_eq(b.len(), 4)
    assert_eq(u8(b[3]), 255)
    bad := tether_b64("!!")
    assert(!bad.has_value())
}
