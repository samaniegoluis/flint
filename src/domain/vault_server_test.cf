package domain

// The remote vault server's pure rules (milestone 42, D-097).

test "a version tag parses with or without quotes, and nothing else does" {
    assert_eq(parse_version_tag("7"), i64(7))
    assert_eq(parse_version_tag("\"7\""), i64(7))
    assert_eq(parse_version_tag(" \"12\" "), i64(12))
    assert_eq(parse_version_tag("W/\"3\""), i64(3))
    assert_eq(parse_version_tag(""), i64(-1))
    assert_eq(parse_version_tag("\"\""), i64(-1))
    assert_eq(parse_version_tag("0"), i64(-1))
    assert_eq(parse_version_tag("-1"), i64(-1))
    assert_eq(parse_version_tag("1a"), i64(-1))
    assert_eq(parse_version_tag("*"), i64(-1))
    assert_eq(parse_version_tag("9999999999999999999"), i64(-1))
    assert_eq(version_tag(42), "\"42\"")
    assert_eq(parse_version_tag(version_tag(42)), i64(42))
}

fuzz "a version tag never parses to zero or less" |s: str| {
    v := parse_version_tag(s)
    assert(v == -1 || v >= 1)
}

test "a vault id is 32 lowercase hex characters" {
    assert(valid_vault_id("0123456789abcdef0123456789abcdef"))
    assert(!valid_vault_id("0123456789ABCDEF0123456789abcdef"))
    assert(!valid_vault_id("0123456789abcdef0123456789abcde"))
    assert(!valid_vault_id("0123456789abcdef0123456789abcdeg"))
    assert(!valid_vault_id(""))
}

test "a short server token is refused" {
    check_server_token("0123456789abcdef0123456789abcdef") or err {
        assert(false)
    }
    mut refused := false
    check_server_token("short") or err {
        refused = error_code_of(err.message()) == ERR_INVALID
    }
    assert(refused)
    mut spaced := false
    check_server_token(" 0123456789abcdef0123456789abcdef") or err {
        spaced = true
    }
    assert(spaced)
}

test "the gate lets a client through up to its rate, then names the wait" {
    mut g := new_server_gate()
    for i in 0..GATE_RATE_MAX {
        assert_eq(g.gate_admit("a", 1000), i64(0))
    }
    assert_eq(g.gate_admit("a", 1500), GATE_RATE_WINDOW_MS - 500)
    // Another client is not held back by the first.
    assert_eq(g.gate_admit("b", 1500), i64(0))
    // A new window starts afresh.
    assert_eq(g.gate_admit("a", 1000 + GATE_RATE_WINDOW_MS), i64(0))
}

test "repeated bad tokens lock a client out, and the lockout ends" {
    mut g := new_server_gate()
    for i in 0..(GATE_BAD_MAX - 1) {
        assert(!g.gate_bad_token("x", 100))
    }
    assert(g.gate_bad_token("x", 200))
    assert_eq(g.gate_admit("x", 300), GATE_LOCKOUT_MS - 100)
    assert_eq(g.gate_admit("y", 300), i64(0))
    assert_eq(g.gate_admit("x", 200 + GATE_LOCKOUT_MS), i64(0))
}

test "bad tokens spread over more than the window never lock out" {
    mut g := new_server_gate()
    mut t: i64 = 0
    for i in 0..(GATE_BAD_MAX * 3) {
        assert(!g.gate_bad_token("x", t))
        t += GATE_BAD_WINDOW_MS / (GATE_BAD_MAX - 1) + 1
    }
}

test "the gate forgets the client seen longest ago, never a locked-out one" {
    mut g := new_server_gate()
    for i in 0..GATE_BAD_MAX {
        _ := g.gate_bad_token("locked", 0)
    }
    for i in 0..(GATE_CLIENTS_MAX + 10) {
        _ := g.gate_admit("c{i}", 10 + i)
    }
    assert_eq(i64(g.clients.len()), GATE_CLIENTS_MAX)
    assert(g.gate_admit("locked", 5000) > 0)
}
