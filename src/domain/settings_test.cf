package domain

test "default settings are valid and bad values are refused" {
    mut refused := 0
    try check_settings(default_settings())
    mut s := default_settings()
    s.theme = "neon"
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 1)
    s = default_settings()
    s.term_font_size = 99
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 2)
    s = default_settings()
    s.term_line_height = 90
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 3)
    s = default_settings()
    s.term_font = "JetBrainsMono Nerd Font"
    try check_settings(s)
    s.term_font = "x\"; color: red"
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 4)
    s = default_settings()
    s.term_theme = "aura"
    try check_settings(s)
    s.term_theme = "solarized"
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 5)
    s = default_settings()
    assert_eq(s.lock_after, "1h")
    s.lock_after = "1m"
    try check_settings(s)
    s.lock_after = "2m"
    check_settings(s) or { refused += 1 }
    assert_eq(refused, 6)
}

test "idle lock follows the setting" {
    assert(!idle_lock_due(59999, 0, "1m"))
    assert(idle_lock_due(60000, 0, "1m"))
    assert(!idle_lock_due(3599999, 0, "1h"))
    assert(idle_lock_due(3600000, 0, "1h"))
    assert(!idle_lock_due(999999999, 0, "never"))
    assert_eq(lock_after_ms(""), 0)
}

test "remote desktop keys are a preset and an optional custom table" {
    mut s := default_settings()
    assert_eq(s.rdp_mac_keys, "mac")
    s.rdp_mac_keys = "windows"
    try check_settings(s)
    s.rdp_mac_keys = "custom"
    s.rdp_mac_custom = "ControlLeft=win,ControlRight=off,AltLeft=alt,AltRight=altgr,MetaLeft=ctrl,MetaRight=ctrl"
    try check_settings(s)
    mut refused := 0
    s.rdp_mac_keys = "linux"
    check_settings(s) or { refused += 1 }
    s.rdp_mac_keys = "custom"
    for bad in ["MetaLeft", "MetaLeft=hyper", "Fn=ctrl", "MetaLeft=ctrl,MetaLeft=alt", "MetaLeft=ctrl,", "=ctrl"] {
        s.rdp_mac_custom = bad
        check_settings(s) or { refused += 1 }
    }
    assert_eq(refused, 7)
}

test "remote desktop graphics are auto or compatible" {
    mut s := default_settings()
    assert_eq(s.rdp_graphics, "auto")
    s.rdp_graphics = "compatible"
    try check_settings(s)
    mut refused := 0
    for bad in ["", "h264", "AUTO"] {
        s.rdp_graphics = bad
        check_settings(s) or { refused += 1 }
    }
    assert_eq(refused, 3)
}

test "toasts appear in one of four corners, bottom right by default" {
    mut s := default_settings()
    assert_eq(s.toast_corner, "bottom-right")
    for c in ["bottom-right", "bottom-left", "top-right", "top-left"] {
        s.toast_corner = c
        try check_settings(s)
    }
    mut refused := 0
    for bad in ["", "center", "Bottom-Right", "bottom"] {
        s.toast_corner = bad
        check_settings(s) or { refused += 1 }
    }
    assert_eq(refused, 4)
}

test "the approval wait is 2, 5, 10 or 30 minutes, 2 by default" {
    mut s := default_settings()
    assert_eq(s.approval_wait, 2)
    for m in [2, 5, 10, 30] {
        s.approval_wait = m
        try check_settings(s)
    }
    mut refused := 0
    for bad in [0, 1, 3, 15, 60, -2] {
        s.approval_wait = bad
        check_settings(s) or { refused += 1 }
    }
    assert_eq(refused, 6)
}

test "the approval wait in milliseconds, shortened only by a smaller override" {
    assert_eq(approval_wait_ms(2, 0), 120000)
    assert_eq(approval_wait_ms(5, 0), 300000)
    assert_eq(approval_wait_ms(10, 0), 600000)
    assert_eq(approval_wait_ms(30, 0), 1800000)
    // FLINT_APPROVAL_WAIT_MS: shorter wins, longer or nonsense is ignored.
    assert_eq(approval_wait_ms(30, 3000), 3000)
    assert_eq(approval_wait_ms(2, 600000), 120000)
    assert_eq(approval_wait_ms(5, -1), 300000)
    // A stored value that is not a choice reads the default.
    assert_eq(approval_wait_ms(7, 0), 120000)
}

test "the QR is for an iPhone by default, or an Android" {
    mut s := default_settings()
    assert_eq(s.ntfy_phone, "iphone")
    s.ntfy_phone = "android"
    assert(settings_valid(s))
    s.ntfy_phone = "windows-phone"
    assert(!settings_valid(s))
}

test "closing the window asks by default; quit and background are kept" {
    mut s := default_settings()
    assert_eq(s.close_action, "")
    for a in ["quit", "background"] {
        s.close_action = a
        assert(settings_valid(s))
    }
    s.close_action = "minimize"
    assert(!settings_valid(s))
}

test "with a tray ✕ always hides; with none the answer decides, or the page asks" {
    for a in ["", "quit", "background"] {
        assert_eq(close_decision(true, a), CLOSE_HIDE)
    }
    assert_eq(close_decision(false, ""), CLOSE_ASK)
    assert_eq(close_decision(false, "quit"), CLOSE_QUIT)
    assert_eq(close_decision(false, "background"), CLOSE_HIDE)
    // A value no Flint writes reads as no answer.
    assert_eq(close_decision(false, "minimize"), CLOSE_ASK)
}
