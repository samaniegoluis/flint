package domain

// The window's webview (milestone 64, Principle 20). A release build has no inspector
// and no engine menu (cfire `v0.12.2`, CFIRE_RELEASE_BUILD); FLINT_DEVTOOLS brings both
// back for whoever diagnoses a release. Autofill stays off either way.

// Whether FLINT_DEVTOOLS asks for the inspector: "1", "true", "yes" or "on".
fn devtools_requested(v: str) -> bool {
    t := v.trim().to_lower()
    return t == "1" || t == "true" || t == "yes" || t == "on"
}

// Whether a file of WebView2's profile holds what autofill or password autosave
// stored: Chromium's `Web Data` (form values) and `Login Data` (passwords), each
// with its SQLite journal (`-journal`, `-wal`, `-shm`) and `Login Data For Account`.
fn webview_autofill_file(name: str) -> bool {
    return name.starts_with("Web Data") || name.starts_with("Login Data")
}
