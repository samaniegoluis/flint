package domain

// The signed self-update (milestone 53, spec v13, D-111, D-118). A verified package is
// downloaded and unpacked into a staging folder beside the installed one (same volume:
// a rename is atomic), and `flint update-apply`, started from a copy of the new CLI,
// swaps the folders once the app quit, starts the new app, and puts the old one back
// when the new one does not report that it started. Everything here is pure: where
// things go, what a package holds, and what each step's outcome means.

// The page's states beyond the notice's (update.cf).
pub UPDATE_DOWNLOADING: str = "downloading"
pub UPDATE_READY: str = "ready"

// Beside the installed folder: `<parent>/.flint-update/`.
UPDATE_STAGE_NAME: str = ".flint-update"
// Bytes a package may exceed its manifest size by: none. The manifest names the size.
// How long update-apply waits for the app to quit, for every `flint` running from the
// folder, and for the new app to report it started.
// Long enough for any quit: the app cuts the CLI's running commands after 5 s
// (milestone 50, after a Relaunch that hung behind a long `flint exec`).
pub UPDATE_WAIT_QUIT_MS: i64 = 600000
pub UPDATE_WAIT_CLI_MS: i64 = 30000
pub UPDATE_WAIT_START_MS: i64 = 60000
pub UPDATE_POLL_MS: i64 = 200
// A rename that fails is tried again for this long (milestone 50): on Windows a file
// inside the folder held open for a moment (Defender scanning what was just unpacked,
// Explorer's preview) refuses the rename; held longer, the swap gives up and puts
// everything back.
pub UPDATE_RENAME_RETRY_MS: i64 = 10000

// Where an update's files go, from the installed folder (the .app on macOS, the
// `Flint` folder on Windows, the portable test layout's folder on Linux).
pub type UpdatePaths struct {
    installed: str
    // `<parent>/.flint-update`, removed once an update is applied or discarded.
    staging:   str
    // The downloaded zip, before it is checked.
    zip:       str
    // What the zip held: `staging/new/<package folder>`.
    new_dir:   str
    new_root:  str
    // The installed folder, moved aside during the swap.
    old_root:  str
    // The version unpacked and ready (`ready`), the new app's word that it started
    // (`started`), and what update-apply did when it could not apply (`outcome.json`).
    ready:     str
    started:   str
    outcome:   str
}

// The folder holding `path` ("/a/b/" -> "/a").
pub fn update_parent(path: str) -> str {
    p := trim_slashes(path)
    i := p.last_index_of("/") or {
        return "."
    }
    if i == 0 {
        return "/"
    }
    return "{p[0..i]}"
}

// The folder a package unpacks to, by system (scripts/package.sh).
fn update_package_folder(os: str) -> str {
    if os == "mac" {
        return "Flint.app"
    }
    return "Flint"
}

pub fn update_paths(installed: str, os: str) -> UpdatePaths {
    root := trim_slashes(installed)
    staging := update_parent(root) + "/" + UPDATE_STAGE_NAME
    new_dir := staging + "/new"
    return UpdatePaths{
        installed: root,
        staging: staging,
        zip: staging + "/package.zip",
        new_dir: new_dir,
        new_root: new_dir + "/" + update_package_folder(os),
        old_root: staging + "/old/" + path_base(root),
        ready: staging + "/ready",
        started: staging + "/started",
        outcome: staging + "/outcome.json",
    }
}

// The app's executable and the CLI inside an installed (or unpacked) folder.
pub fn update_app_exe(root: str, os: str) -> str {
    if os == "mac" {
        return root + "/Contents/MacOS/Flint"
    }
    if os == "windows" {
        return root + "/Flint.exe"
    }
    return root + "/Flint"
}

pub fn update_cli_exe(root: str, os: str) -> str {
    if os == "mac" {
        return root + "/Contents/Helpers/flint"
    }
    if os == "windows" {
        return root + "/bin/flint.exe"
    }
    return root + "/flint"
}

// A SHA-256 as printed (64 hex characters), compared without regard to case.
pub fn sha256_matches(expected: str, got: str) -> bool {
    return is_hex64(expected.to_lower()) && expected.to_lower() == got.to_lower()
}

// A bundle's code signature (milestone 79, D-158 (3)): the Team ID of a Developer ID
// signature ("" when ad hoc, unsigned, or on a system whose packages carry none), and
// whether the whole bundle verifies (`codesign --verify --deep --strict` on macOS).
pub type CodeSignature struct {
    team:  str
    valid: bool
}

// Whether a downloaded package may replace the installed Flint: it must verify, and
// over a Developer ID install it must carry the same Team ID. An ad-hoc or unsigned
// install (built from source, or a release before signing) takes either, so the first
// signed update reaches it.
pub fn update_signature_accepts(installed: CodeSignature, candidate: CodeSignature) -> bool {
    if !candidate.valid {
        return false
    }
    if installed.team.len() == 0 {
        return true
    }
    return candidate.team == installed.team
}

// What `flint update-apply` was asked to do.
pub type ApplyRequest struct {
    // The app's process, which must quit first (0: none to wait for).
    wait_pid: i64
    // The unpacked package's folder, and the installed one it replaces.
    from:     str
    to:       str
    os:       str
    // Where the app it starts writes its output ("" for nowhere; the e2e run's log).
    app_log:  str
    // Milestone 54 (D-124): a package root already installed. Nothing is swapped: wait
    // for the old app, start the new one from `to`, and wait for its word in `staging`
    // (the person's `~/.cache/flint/update`); no rollback.
    start_only: bool
    staging:    str
}

// What update-apply did: written to `outcome.json` when it could not apply (the app it
// starts reads it and says why), and printed by `--json`.
pub type ApplyOutcome struct {
    applied: bool `json:"applied"`
    // The step that stopped it (APPLY_STEP_*), "" when applied.
    step:    str  `json:"step"`
    code:    str  `json:"code"`
    message: str  `json:"message"`
    // The package was kept: Relaunch can try again (a `flint` still running).
    kept:    bool `json:"kept"`
}

// A program holding a file open in the installed folder (milestone 65): what a failed
// swap names, as the Restart Manager reports it.
pub type FolderHolder struct {
    name: str
    pid:  i64
}

// The adapter's "pid\tname" lines; a line that does not parse is left out.
pub fn parse_folder_holders(lines: str) -> []FolderHolder {
    mut out: []FolderHolder = []
    for line in lines.split("\n") {
        tab := line.index_of("\t") or {
            continue
        }
        if tab == 0 {
            continue
        }
        if pid := i64.parse(line[0..tab]) {
            mut name := line[tab + 1..line.len()].trim()
            if name.len() == 0 {
                name = "a program"
            }
            out.push(FolderHolder{ name: name, pid: pid })
        }
    }
    return out
}

// FOLDER_HOLDERS_SHOWN programs are named at most; the rest are counted.
FOLDER_HOLDERS_SHOWN: i64 = 3

// Why a rename failed, in words a person can act on: the programs that hold the
// folder when Windows could say, else that one does.
pub fn held_message(why: str, folder: str, holders: []FolderHolder) -> str {
    if holders.len() == 0 {
        return "a program has a file in {path_base(folder)} open, so it could not be replaced (close it and Relaunch again): {why}"
    }
    mut names := ""
    for i, h in holders {
        if i64(i) >= FOLDER_HOLDERS_SHOWN {
            break
        }
        if i > 0 {
            names = names + ", "
        }
        names = names + "{h.name} (pid {h.pid})"
    }
    rest := i64(holders.len()) - FOLDER_HOLDERS_SHOWN
    if rest > 0 {
        names = names + " and {rest} more"
    }
    mut verb := "it has a file"
    if holders.len() > 1 {
        verb = "they have files"
    }
    return "close {names} and Relaunch again: {verb} in {path_base(folder)} open, so it could not be replaced"
}

pub APPLY_STEP_ARGS: str = "args"
pub APPLY_STEP_QUIT: str = "quit"
pub APPLY_STEP_CLI: str = "cli"
pub APPLY_STEP_SWAP: str = "swap"
pub APPLY_STEP_START: str = "start"
// Milestone 54: a package root installed whose app did not say it started (no rollback).
pub APPLY_STEP_PACKAGE_START: str = "package_start"

pub fn apply_ok() -> ApplyOutcome {
    return ApplyOutcome{ applied: true, step: "", code: "", message: "", kept: false }
}

pub fn apply_failed(step: str, code: str, message: str, kept: bool) -> ApplyOutcome {
    return ApplyOutcome{ applied: false, step: step, code: code, message: message, kept: kept }
}

// Checks update-apply's request against the folders it may touch: `from` must be the
// staging folder of `to` (update_paths), so the command can never be pointed at
// another folder to move it.
pub fn check_apply_request(r: ApplyRequest) -> void! {
    if r.start_only {
        if r.to.len() == 0 || r.staging.len() == 0 || r.from.len() > 0 {
            return error(coded(ERR_USAGE, "update-apply --start needs --to and --staging, and no --from"))
        }
        if r.wait_pid < 0 {
            return error(coded(ERR_USAGE, "--wait takes a process id"))
        }
        return
    }
    if r.to.len() == 0 || r.from.len() == 0 {
        return error(coded(ERR_USAGE, "update-apply needs --from and --to"))
    }
    if r.wait_pid < 0 {
        return error(coded(ERR_USAGE, "--wait takes a process id"))
    }
    p := update_paths(r.to, r.os)
    if trim_slashes(r.from) != p.new_root {
        return error(coded(ERR_INVALID, "update-apply applies only the package unpacked beside the installed folder ({p.new_root})"))
    }
    return
}

// The page's text for an outcome that did not apply (the app shows it at launch).
pub fn apply_outcome_text(o: ApplyOutcome) -> str {
    if o.step == APPLY_STEP_CLI {
        return "The update was not applied: {o.message}. Close it and choose Relaunch again."
    }
    if o.step == APPLY_STEP_PACKAGE_START {
        return "The new version was installed but did not start: {o.message} Open Flint again."
    }
    if o.step == APPLY_STEP_START {
        return "The new version did not start, so this one was put back. {o.message}"
    }
    return "The update was not applied: {o.message}"
}
