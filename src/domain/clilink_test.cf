package domain

test "the CLI is found inside a bundle and nowhere else" {
    assert_eq(bundle_cli_path("/Applications/Flint.app/Contents/MacOS"), "/Applications/Flint.app/Contents/Helpers/flint")
    assert_eq(bundle_cli_path("/home/me/flint/build/gui"), "")
    assert_eq(bundle_of_cli("/Users/me/Apps/Flint.app/Contents/Helpers"), "/Users/me/Apps/Flint.app")
    assert_eq(bundle_of_cli("/usr/local/bin"), "")
    assert_eq(bundle_of_cli("/x/Contents/Helpers"), "")
}

test "each state of the place the command goes" {
    cli := "/Applications/Flint.app/Contents/Helpers/flint"
    assert_eq(cli_link_state(cli, LinkProbe{ exists: false, is_link: false, target: "", target_exists: false, dir_writable: true }), "missing")
    assert_eq(cli_link_state(cli, LinkProbe{ exists: true, is_link: true, target: cli, target_exists: true, dir_writable: true }), "installed")
    assert_eq(cli_link_state(cli, LinkProbe{ exists: true, is_link: true, target: "/Users/me/Downloads/Flint.app/Contents/Helpers/flint", target_exists: true, dir_writable: true }), "other-copy")
    // A dangling link does not "exist" to stat, but is still a link.
    assert_eq(cli_link_state(cli, LinkProbe{ exists: false, is_link: true, target: "/Volumes/Old/Flint.app/Contents/Helpers/flint", target_exists: false, dir_writable: true }), "broken")
    // scripts/install.sh copies a file; Homebrew links somewhere else: never touched.
    assert_eq(cli_link_state(cli, LinkProbe{ exists: true, is_link: false, target: "", target_exists: false, dir_writable: true }), "foreign")
    assert_eq(cli_link_state(cli, LinkProbe{ exists: true, is_link: true, target: "/opt/homebrew/bin/flint", target_exists: true, dir_writable: true }), "foreign")
}

test "the toast offers to install once and to fix every time" {
    missing := CliLinkSpot{ path: "/usr/local/bin/flint", state: "missing", target: "", admin: true }
    local := CliLinkSpot{ path: "/Users/me/.local/bin/flint", state: "missing", target: "", admin: false }
    assert_eq(cli_link_offer(true, [missing, local], false), "install")
    assert_eq(cli_link_offer(true, [missing, local], true), "")
    assert_eq(cli_link_offer(false, [missing, local], false), "")
    mut moved := local
    moved.state = "broken"
    assert_eq(cli_link_offer(true, [missing, moved], true), "fix")
    mut ok := missing
    ok.state = "installed"
    assert_eq(cli_link_offer(true, [ok, moved], true), "")
    mut foreign := local
    foreign.state = "foreign"
    assert_eq(cli_link_offer(true, [missing, foreign], false), "")
}

test "a Path entry is compared without case, slashes or a trailing separator" {
    assert_eq(path_entry_key(" C:/Users/Me/Flint/bin/ "), "c:\\users\\me\\flint\\bin")
    assert_eq(path_entry_key("\"C:\\Tools\""), "c:\\tools")
    assert_eq(path_entry_key("C:\\"), "c:\\")
    assert_eq(split_path_value("C:\\a;;C:\\b; ;"), ["C:\\a", "C:\\b"])
}

test "each state of the Windows PATH entry" {
    bin := "C:/Users/me/Apps/Flint/bin"
    here := PathEntryProbe{ entry: "c:\\users\\me\\apps\\flint\\bin\\", has_cli: true, has_app: true }
    other := PathEntryProbe{ entry: "C:\\Users\\me\\Downloads\\Flint-2\\bin", has_cli: true, has_app: true }
    gone := PathEntryProbe{ entry: "D:\\Old\\Flint\\bin", has_cli: false, has_app: false }
    tools := PathEntryProbe{ entry: "C:\\Tools\\bin", has_cli: false, has_app: false }
    // A flint.exe that is not beside a Flint.exe (install.ps1's old layout, a source
    // build): not ours.
    loose := PathEntryProbe{ entry: "C:\\Users\\me\\AppData\\Local\\Programs\\Flint", has_cli: true, has_app: false }
    assert_eq(path_entry_state(bin, here), "installed")
    assert_eq(path_entry_state(bin, other), "other-copy")
    assert_eq(path_entry_state(bin, gone), "broken")
    assert_eq(path_entry_state(bin, tools), "")
    assert_eq(path_entry_state(bin, loose), "")
    assert_eq(path_spot(bin, [tools, other, here]).state, "installed")
    assert_eq(path_spot(bin, [tools, gone, other]).state, "broken")
    assert_eq(path_spot(bin, [tools, gone, other]).target, "D:\\Old\\Flint\\bin")
    assert_eq(path_spot(bin, [tools, loose]).state, "missing")
    assert_eq(path_spot(bin, []).path, bin)
}

test "adding the folder puts it first and drops other copies; removing keeps the rest" {
    bin := "C:/F/Flint/bin"
    other := PathEntryProbe{ entry: "D:\\Flint\\bin", has_cli: true, has_app: true }
    tools := PathEntryProbe{ entry: "%USERPROFILE%\\tools", has_cli: false, has_app: false }
    here := PathEntryProbe{ entry: "C:\\F\\Flint\\bin", has_cli: true, has_app: true }
    assert_eq(path_with_cli(bin, [tools, other]), "C:\\F\\Flint\\bin;%USERPROFILE%\\tools")
    assert_eq(path_with_cli(bin, [here, tools]), "C:\\F\\Flint\\bin;%USERPROFILE%\\tools")
    assert_eq(path_without_cli(bin, [tools, here, other]), "%USERPROFILE%\\tools;D:\\Flint\\bin")
    assert_eq(path_without_cli(bin, []), "")
}
