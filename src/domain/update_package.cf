package domain

// The Linux self-update through the package manager (milestone 54, spec v13, D-124). A
// .deb or .rpm is not a folder the person owns: its files sit under /usr, recorded in
// dpkg's or rpm's database, so only the package manager, as root, may replace them.
// Flint downloads the package the verified manifest names into the person's own cache
// (`~/.cache/flint/update/`), keeping the manifest and its signature beside it; Relaunch
// runs `pkexec flint-update-root`, which copies the three files into a folder of root's,
// checks them again there (Principle 17) and hands the package to apt or dnf. Everything
// here is pure: where the package came from, where it is staged, what root accepts.

// Where an installed package came from: a file (`apt install ./flint_….deb`, every
// install today: there is no repository) or a repository the system's updater follows.
INSTALL_FROM_FILE: str = "file"
INSTALL_FROM_REPOSITORY: str = "repository"
// How to update, for a package from a repository: the system's updater.
UPDATE_HOW_REPOSITORY: str = "repository"

// The package's formats, as `install-kind` names them (`package:deb`, `package:rpm`).
PACKAGE_DEB: str = "deb"
PACKAGE_RPM: str = "rpm"

// The person's staging folder, under their home (never XDG_CACHE_HOME: root finds it
// from the caller's uid alone, D-124 (3)).
UPDATE_PACKAGE_STAGE: str = ".cache/flint/update"
UPDATE_MANIFEST_FILE: str = "manifest.json"
UPDATE_SIGNATURE_FILE: str = "manifest.json.sig"
// The helper's place in the package, beside the app.
UPDATE_ROOT_HELPER: str = "flint-update-root"

// The format of a package install-kind ("" when it is not one).
fn package_format(kind: str) -> str {
    if kind == "package:deb" {
        return PACKAGE_DEB
    }
    if kind == "package:rpm" {
        return PACKAGE_RPM
    }
    return ""
}

// The manifest's asset for a package format.
fn update_package_asset_key(format: str) -> str {
    if format == PACKAGE_RPM {
        return UPDATE_ASSET_RPM
    }
    return UPDATE_ASSET_DEB
}

// The staged package's file name: apt reads a .deb by its suffix.
fn update_package_file(format: str) -> str {
    return "package." + format
}

// The staging of a package update, as UpdatePaths (milestone 53's): `zip` is the
// package, `new_root` stays empty (nothing is unpacked), `installed` is the package's
// folder (/usr/lib/flint).
fn update_package_paths(home: str, format: str, installed: str) -> UpdatePaths {
    staging := trim_slashes(home) + "/" + UPDATE_PACKAGE_STAGE
    return UpdatePaths{
        installed: trim_slashes(installed),
        staging: staging,
        zip: staging + "/" + update_package_file(format),
        new_dir: "",
        new_root: "",
        old_root: "",
        ready: staging + "/ready",
        started: staging + "/started",
        outcome: staging + "/outcome.json",
    }
}

fn update_manifest_path(p: UpdatePaths) -> str {
    return p.staging + "/" + UPDATE_MANIFEST_FILE
}

fn update_signature_path(p: UpdatePaths) -> str {
    return p.staging + "/" + UPDATE_SIGNATURE_FILE
}

fn leading_spaces(line: str) -> usize {
    mut n: usize = 0
    for n < line.len() && line[n] == 32 {
        n += 1
    }
    return n
}

// `apt-cache policy flint`: the installed version's line (` *** 0.20.0 100`) is followed
// by its sources, indented further. Only `/var/lib/dpkg/status` there means it came
// from a file; any other source is a repository. Anything unreadable reads as a file
// (every install today, D-124 (1)).
fn apt_source_of(policy: str) -> str {
    mut on := false
    mut depth: usize = 0
    for raw in policy.lines() {
        line := raw.trim_end()
        if line.trim().len() == 0 {
            continue
        }
        if !on {
            if line.trim().starts_with("*** ") {
                on = true
                depth = leading_spaces(line)
            }
            continue
        }
        if leading_spaces(line) <= depth + 4 {
            break
        }
        if !line.trim().ends_with("/var/lib/dpkg/status") {
            return INSTALL_FROM_REPOSITORY
        }
    }
    return INSTALL_FROM_FILE
}

// `dnf info --installed flint`: `From repository : @commandline` (dnf5; `From repo` in
// dnf 4) for a file; any other repository name for a repository.
fn dnf_source_of(info: str) -> str {
    for raw in info.lines() {
        line := raw.trim()
        if !line.starts_with("From repo") {
            continue
        }
        i := line.index_of(":") or {
            continue
        }
        repo := "{line[i + 1..].trim()}"
        if repo.len() == 0 || repo == "@commandline" || repo == "<unknown>" || repo == "@System" {
            return INSTALL_FROM_FILE
        }
        return INSTALL_FROM_REPOSITORY
    }
    return INSTALL_FROM_FILE
}

// How the system's updater is named for a package from a repository (How to update).
fn package_update_command(format: str) -> str {
    if format == PACKAGE_RPM {
        return "sudo dnf upgrade flint"
    }
    return "sudo apt update && sudo apt install --only-upgrade flint"
}

// What root accepts (Principle 17), on its own copy of a manifest whose signature it
// verified: a release of Flint's (check_update_manifest_from), newer than the version
// installed (the helper's own: it ships in the package), with a package of the format
// installed. The package's size and SHA-256 are checked against that asset next.
fn root_update_asset(m: UpdateManifest, format: str, installed: str, download_prefix: str) -> UpdateAsset! {
    try check_update_manifest_from(m, download_prefix)
    if !version_is_newer(m.version, installed) {
        return error(coded(ERR_INVALID, "the update ({m.version}) is not newer than the installed Flint ({installed})"))
    }
    if format != PACKAGE_DEB && format != PACKAGE_RPM {
        return error(coded(ERR_INVALID, "this Flint was not installed from a .deb or .rpm package"))
    }
    key := update_package_asset_key(format)
    mut found := UpdateAsset{ key: "", name: "", url: "", size: 0, sha256: "" }
    for i in 0..m.assets.len() {
        if m.assets[i].key == key {
            found = m.assets[i]
        }
    }
    if found.key.len() == 0 {
        return error(coded(ERR_INVALID, "the update has no {format} package"))
    }
    return found
}

// The package root copied matches the asset: its size and its SHA-256.
fn root_package_matches(a: UpdateAsset, size: i64, sha256: str) -> void! {
    if size != a.size {
        return error(coded(ERR_INVALID, "the package is not the size the release names"))
    }
    if !sha256_matches(a.sha256, sha256) {
        return error(coded(ERR_INVALID, "the package did not match the release's SHA-256"))
    }
}

// What flint-update-root did, printed as JSON and told by its exit code.
type RootOutcome struct {
    installed: bool `json:"installed"`
    version:   str  `json:"version"`
    code:      str  `json:"code"`
    message:   str  `json:"message"`
    // The staged files are to be discarded (they failed a check); otherwise kept for
    // another Relaunch (apt or dnf failed: a lock held by another update).
    discard:   bool `json:"discard"`
}

// The helper's exit codes; pkexec's own are 126 (the dialog dismissed) and 127 (not
// authorized, or no polkit agent).
ROOT_EXIT_OK: i32 = 0
ROOT_EXIT_USAGE: i32 = 2
ROOT_EXIT_REFUSED: i32 = 3
ROOT_EXIT_INSTALL: i32 = 4
ROOT_EXIT_NOTHING: i32 = 5
PKEXEC_EXIT_DISMISSED: i32 = 126
PKEXEC_EXIT_DENIED: i32 = 127

fn root_exit_code(o: RootOutcome) -> i32 {
    if o.installed {
        return ROOT_EXIT_OK
    }
    if o.discard {
        return ROOT_EXIT_REFUSED
    }
    if o.code == ERR_NOT_FOUND {
        return ROOT_EXIT_NOTHING
    }
    if o.code == ERR_USAGE {
        return ROOT_EXIT_USAGE
    }
    return ROOT_EXIT_INSTALL
}

// `pkexec flint-update-root` once it ended: its exit code and what it printed.
type RootRun struct {
    exit_code: i32
    stdout:    str
}

// What a Relaunch's run of the helper means for the page: installed, kept for another
// try (with why), or discarded (with why).
type PackageRelaunch struct {
    installed: bool
    discard:   bool
    code:      str
    message:   str
}

fn package_relaunch_of(exit_code: i32, o: RootOutcome?) -> PackageRelaunch {
    if exit_code == ROOT_EXIT_OK {
        return PackageRelaunch{ installed: true, discard: false, code: "", message: "" }
    }
    if exit_code == PKEXEC_EXIT_DISMISSED || exit_code == PKEXEC_EXIT_DENIED {
        return PackageRelaunch{ installed: false, discard: false, code: ERR_DENIED, message: "Nothing was installed: the system password was not given" }
    }
    if out := o {
        if out.message.len() > 0 {
            return PackageRelaunch{ installed: false, discard: out.discard, code: out.code, message: out.message }
        }
    }
    return PackageRelaunch{ installed: false, discard: exit_code == ROOT_EXIT_REFUSED, code: ERR_INTERNAL, message: "the update helper stopped (exit {exit_code})" }
}
