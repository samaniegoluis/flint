package vaultremote

// The `UpdateFeed` port (milestone 52): one GET of a file of Flint's latest release,
// through the same libcurl as the vault server (native/flint_remote.hpp, CF-146). A
// deadline and a size cap on every request (Principle 8); no header but the
// User-Agent, nothing about this machine (Principle 15). HTTPS only, redirects too;
// plain `http://` only to this machine, for the tests' local feed.

// CFIRE-UPSTREAM: CF-146
import cpp "flint_remote.hpp"
import "../../domain"

UPDATE_CONNECT_MS: i64 = 10000
UPDATE_REQUEST_MS: i64 = 30000

type HttpUpdateFeed struct {
    connect_ms: i64
    request_ms: i64
}

fn new_http_update_feed() -> HttpUpdateFeed {
    return HttpUpdateFeed{ connect_ms: UPDATE_CONNECT_MS, request_ms: UPDATE_REQUEST_MS }
}

// https://, or http:// to localhost / 127.0.0.1 only.
fn update_url_allowed(url: str) -> bool {
    if url.starts_with("https://") {
        return true
    }
    return url.starts_with("http://localhost:") || url.starts_with("http://localhost/") || url.starts_with("http://127.0.0.1:") || url.starts_with("http://127.0.0.1/")
}

fn (self: HttpUpdateFeed) update_get(url: str, max_bytes: i64) -> []byte! {
    host := url_host(url)
    if !update_url_allowed(url) {
        return error(coded(ERR_INVALID, "updates are fetched over HTTPS only (not from {host})"))
    }
    mut rc: i32 = 0
    mut status: i64 = 0
    mut got: []byte = []
    mut reason := ""
    connect_ms := self.connect_ms
    request_ms := self.request_ms
    // CFIRE-UPSTREAM: CF-146
    cpp {
        rc = flint_remote::get_following(url, connect_ms, request_ms, max_bytes, status, got, reason);
    }
    if rc == 2 || rc == 4 {
        return error(coded(ERR_NETWORK, "cannot reach {host}: {reason}"))
    }
    if rc == 3 {
        return error(coded(ERR_TIMEOUT, "{host} did not answer in time"))
    }
    if rc == 5 {
        return error(coded(ERR_REFUSED, "{host} sent more than the update information may be"))
    }
    if rc != 0 {
        return error(coded(ERR_NETWORK, "the request to {host} failed: {reason}"))
    }
    if status == 404 {
        return error(coded(ERR_NOT_FOUND, "no published release has update information yet"))
    }
    if status != 200 {
        return error(coded(ERR_REFUSED, "{host} answered {status}"))
    }
    return got
}

// The `UpdateDownloader` port (milestone 53): the package streamed to a file, at most
// the size the verified manifest names. A connect deadline and a stall deadline
// (Principle 8): a download may take minutes, but 30 s with nothing received ends it.
UPDATE_STALL_MS: i64 = 30000

type HttpUpdateDownloader struct {
    connect_ms: i64
    stall_ms:   i64
}

fn new_http_update_downloader() -> HttpUpdateDownloader {
    return HttpUpdateDownloader{ connect_ms: UPDATE_CONNECT_MS, stall_ms: UPDATE_STALL_MS }
}

// Bytes the download running now has received (any thread may ask).
fn update_download_received() -> i64 {
    mut n: i64 = 0
    // CFIRE-UPSTREAM: CF-146
    cpp {
        n = flint_remote::download_received().load();
    }
    return n
}

fn (mut self: HttpUpdateDownloader) update_download(url: str, path: str, max_bytes: i64) -> void! {
    host := url_host(url)
    if !update_url_allowed(url) {
        return error(coded(ERR_INVALID, "updates are fetched over HTTPS only (not from {host})"))
    }
    mut rc: i32 = 0
    mut status: i64 = 0
    mut reason := ""
    connect_ms := self.connect_ms
    stall_ms := self.stall_ms
    // CFIRE-UPSTREAM: CF-146
    cpp {
        rc = flint_remote::download_to_file(url, connect_ms, stall_ms, max_bytes, path, status, reason);
    }
    if rc == 2 || rc == 4 {
        return error(coded(ERR_NETWORK, "the download from {host} failed: {reason}"))
    }
    if rc == 3 {
        return error(coded(ERR_TIMEOUT, "the download from {host} stalled"))
    }
    if rc == 5 {
        return error(coded(ERR_REFUSED, "{host} sent more than the release's package"))
    }
    if rc == 7 {
        return error(coded(ERR_IO, "{reason}"))
    }
    if rc != 0 {
        return error(coded(ERR_NETWORK, "the download from {host} failed: {reason}"))
    }
    if status == 404 {
        return error(coded(ERR_NOT_FOUND, "the release has no such package"))
    }
    if status != 200 {
        return error(coded(ERR_REFUSED, "{host} answered {status}"))
    }
}
