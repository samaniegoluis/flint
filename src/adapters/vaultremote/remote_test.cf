package vaultremote

// Against a real flint-vault-server on loopback, started by scripts/test.sh
// (FLINT_TEST_VAULT_URL, FLINT_TEST_VAULT_TOKEN, an empty data folder).

import "core:os"
import "core:net"
import "core:net/http"
import "../../domain"

VID_A: str = "00112233445566778899aabbccddeeff"
VID_B: str = "ffeeddccbbaa99887766554433221100"

fn base_url() -> str {
    base := os.getenv("FLINT_TEST_VAULT_URL")
    assert(base.len() > 0, "run through scripts/test.sh, which starts a vault server")
    return base
}

fn vault_url() -> str {
    return remote_vault_url(base_url(), VID_A)
}

fn token() -> str {
    return os.getenv("FLINT_TEST_VAULT_TOKEN")
}

fn bytes_of(s: str) -> []byte {
    return []byte(s)
}

test "GET, PUT, 304, 409, 412 and 401 over HTTP, with headers both ways" {
    r := new_http_vault_remote()
    url := vault_url()
    // Empty server: not found, no error.
    empty := try r.remote_get(url, token(), 0)
    assert(!empty.found)

    first := try r.remote_put(url, token(), VID_A, 0, bytes_of("blob-one\u{1}\u{2}"))
    assert(first.stored)
    assert_eq(first.version, i64(1))

    got := try r.remote_get(url, token(), 0)
    assert(got.found && got.changed)
    assert_eq(got.version, i64(1))
    assert_eq(got.vault_id, VID_A)
    assert_eq(str(got.data), "blob-one\u{1}\u{2}")

    same := try r.remote_get(url, token(), 1)
    assert(same.found)
    assert(!same.changed, "304 when the version is known")
    assert_eq(same.data.len(), usize(0))

    second := try r.remote_put(url, token(), VID_A, 1, bytes_of("blob-two"))
    assert_eq(second.version, i64(2))
    late := try r.remote_put(url, token(), VID_A, 1, bytes_of("blob-late"))
    assert(!late.stored)
    assert_eq(late.version, i64(2))

    // A second vault beside the first, with its own versions (milestone 45).
    b_url := remote_vault_url(base_url(), VID_B)
    assert(!(try r.remote_get(b_url, token(), 0)).found)
    b := try r.remote_put(b_url, token(), VID_B, 0, bytes_of("other"))
    assert_eq(b.version, i64(1))
    try r.remote_set_label(remote_label_url(base_url(), VID_B), token(), "Work")
    list := try r.remote_list(remote_vaults_url(base_url()), token())
    assert_eq(list.len(), usize(2))
    assert_eq(list[0].id, VID_A)
    assert_eq(list[0].version, i64(2))
    assert_eq(list[0].label, "")
    assert_eq(list[1].id, VID_B)
    assert_eq(list[1].label, "Work")
    assert_eq(list[1].size, i64(5))

    mut msg := ""
    r.remote_set_label(remote_label_url(base_url(), "abababababababababababababababab"), token(), "x") or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_NOT_FOUND)

    msg = ""
    r.remote_get(url, "wrong-token-wrong-token-wrong-token", 0) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_AUTH)
    assert(!msg.contains("wrong-token"), "the token is never in a message")
    // A 401 says the token was refused, nothing about a lockout (milestone 71).
    m := core_message_of(msg)
    assert_eq(m.id, MSG_REMOTE_TOKEN_REFUSED)
    assert(!msg.contains("15 minutes"))
}

fn answer_429(req: http.Request) -> http.Response {
    mut r := http.Response.json(429, "{\"error\":\"too_many_requests\",\"message\":\"wait before trying again\"}")
    if req.path.ends_with("/minutes") {
        r.headers["Retry-After"] = "840"
    } else if req.path.ends_with("/seconds") {
        r.headers["Retry-After"] = "42"
    }
    return r
}

test "a 429 says how long the server asks to wait, from its Retry-After" {
    mut srv := try make(http.Server, 0, host: "127.0.0.1")
    srv.serve_in_background(answer_429)
    defer srv.stop()
    r := new_http_vault_remote()
    base := "http://127.0.0.1:{srv.port()}"
    mut msg := ""
    r.remote_get(base + "/minutes", token(), 0) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_REFUSED)
    assert_eq(core_message_of(msg).id, MSG_REMOTE_WAIT_MINUTES)
    assert(msg.contains("wait 14 min"), msg)
    msg = ""
    r.remote_get(base + "/seconds", token(), 0) or err { msg = "{err.message()}" }
    assert_eq(core_message_of(msg).id, MSG_REMOTE_WAIT_SECONDS)
    assert(msg.contains("wait 42 s"), msg)
    msg = ""
    r.remote_get(base + "/none", token(), 0) or err { msg = "{err.message()}" }
    assert_eq(core_message_of(msg).id, MSG_REMOTE_SLOW_DOWN)
}

test "an unreachable server is network, a path that is not a vault server is not_found" {
    r := new_http_vault_remote()
    mut msg := ""
    r.remote_get("http://127.0.0.1:9/v1/vault", token(), 0) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_NETWORK)
    base := os.getenv("FLINT_TEST_VAULT_URL")
    msg = ""
    r.remote_get(base + "/nope", token(), 0) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_NOT_FOUND)
    assert(msg.contains("0.12 or later"))
    msg = ""
    r.remote_list(base + "/nope", token()) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_NOT_FOUND)
}

test "a server that stalls hits the deadline" {
    mut r := new_http_vault_remote()
    r.request_ms = 1500
    // A listener that never accepts: the kernel completes the handshake, nobody answers.
    l := try net.listen(0, "127.0.0.1")
    mut msg := ""
    r.remote_get("http://127.0.0.1:{l.port()}/v1/vault", token(), 0) or err { msg = "{err.message()}" }
    assert_eq(error_code_of(msg), ERR_TIMEOUT)
}
