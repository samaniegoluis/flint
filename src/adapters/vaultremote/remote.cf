package vaultremote

// The `VaultRemote` port over HTTP (milestones 43 and 45): protocol /v1 of
// flint-vault-server (D-097, D-103), through libcurl in native/flint_remote.hpp, since core:net/http gives
// cfire code no headers, no deadline and, on macOS, no response headers over TLS
// (CF-146). Every request carries a deadline (Principle 8), the bearer token in a
// header and nothing else of the vault but its id, a version and the encrypted file
// (Principle 13). No message names the token (Principle 6).

// CFIRE-UPSTREAM: CF-146, CF-031
import cpp "flint_remote.hpp"
import "core:json"
import "../../domain"

// Connecting, and a whole request: a vault of a few MB over a slow link fits.
REMOTE_CONNECT_MS: i64 = 10000
REMOTE_REQUEST_MS: i64 = 120000
// The most a download may be: the server's default cap (32 MiB) and room to spare.
REMOTE_MAX_BYTES: i64 = 67108864

pub type HttpVaultRemote struct {
    connect_ms: i64
    request_ms: i64
}

pub fn new_http_vault_remote() -> HttpVaultRemote {
    return HttpVaultRemote{ connect_ms: REMOTE_CONNECT_MS, request_ms: REMOTE_REQUEST_MS }
}

type RemoteReply struct {
    status:   i64
    etag:     str
    vault_id: str
    // A 429's `Retry-After`, in seconds as the server sent it ("" when absent).
    retry_after: str
    body:     []byte
}

type RemoteErrorBody struct {
    error:   str `json:"error"`
    message: str `json:"message"`
}

type RemoteVaultsBody struct {
    vaults: []domain.ServerVault `json:"vaults"`
}

type RemoteLabelBody struct {
    label: str `json:"label"`
}

// A 404 that is not the server's "empty": no server, or one from before milestone 45
// that knows only `/v1/vault`.
fn no_server(url: str) -> str {
    return domain.coded(domain.ERR_NOT_FOUND, "no Flint vault server of 0.12 or later at {url_host(url)}: check the URL, or update flint-vault-server")
}

fn (self: HttpVaultRemote) send(method: str, url: str, headers: str, body: []byte) -> RemoteReply! {
    mut rc: i32 = 0
    mut status: i64 = 0
    mut etag := ""
    mut vault_id := ""
    mut retry_after := ""
    mut got: []byte = []
    mut reason := ""
    connect_ms := self.connect_ms
    request_ms := self.request_ms
    max := REMOTE_MAX_BYTES
    // CFIRE-UPSTREAM: CF-146
    cpp {
        rc = flint_remote::request_full(method, url, headers, body, connect_ms, request_ms, max, status, etag, vault_id, retry_after, got, reason);
    }
    host := url_host(url)
    if rc == 2 {
        return error(domain.coded(domain.ERR_NETWORK, "cannot reach the vault's server at {host}: {reason}"))
    }
    if rc == 3 {
        return error(domain.coded(domain.ERR_TIMEOUT, "the vault's server at {host} did not answer in time"))
    }
    if rc == 4 {
        return error(domain.coded(domain.ERR_NETWORK, "TLS with the vault's server at {host} failed: {reason}"))
    }
    if rc == 5 {
        return error(domain.coded(domain.ERR_REFUSED, "the vault's server at {host} sent more than a vault may be"))
    }
    if rc != 0 {
        return error(domain.coded(domain.ERR_NETWORK, "the request to the vault's server at {host} failed: {reason}"))
    }
    return RemoteReply{ status: status, etag: etag, vault_id: vault_id, retry_after: retry_after, body: got }
}

// The host part of a URL, for messages (never a path or a query).
fn url_host(url: str) -> str {
    mut rest := url
    if i := rest.index_of("://") {
        rest = str(rest[i + 3..])
    }
    if j := rest.index_of("/") {
        rest = str(rest[..j])
    }
    return rest
}

fn auth_header(token: str) -> str {
    return "Authorization: Bearer " + token + "\n"
}

// A 429: the server's gate asks this address to wait (its rate limit, or a lockout
// after too many wrong tokens), for the seconds of its `Retry-After` when it sent one.
fn wait_refusal(host: str, retry_after: str) -> str {
    secs := domain.parse_version_tag(retry_after.trim())
    if secs < 1 {
        return domain.core_msg(domain.MSG_REMOTE_SLOW_DOWN, [host])
    }
    if secs < 60 {
        return domain.core_msg(domain.MSG_REMOTE_WAIT_SECONDS, [host, "{secs}"])
    }
    return domain.core_msg(domain.MSG_REMOTE_WAIT_MINUTES, [host, "{(secs + 59) / 60}"])
}

// The error a refusal maps to, with the server's own message when it sent one.
fn refusal(r: RemoteReply, host: str) -> str {
    mut why := ""
    // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
    parsed := json.parse[RemoteErrorBody](payload: str(r.body)) or RemoteErrorBody{ error: "", message: "" }
    if parsed.message.len() > 0 && parsed.message.len() < 200 {
        why = ": " + parsed.message
    }
    if r.status == 401 {
        return domain.core_msg(domain.MSG_REMOTE_TOKEN_REFUSED, [host])
    }
    if r.status == 412 {
        return domain.coded(domain.ERR_CONFLICT, "the vault's server at {host} holds another vault")
    }
    if r.status == 429 {
        return wait_refusal(host, r.retry_after)
    }
    if r.status == 413 {
        return domain.coded(domain.ERR_REFUSED, "the vault is over the server's size cap (FLINT_VAULT_MAX_BYTES at {host})")
    }
    return domain.coded(domain.ERR_REFUSED, "the vault's server at {host} answered {r.status}{why}")
}

fn (self: HttpVaultRemote) remote_get(url: str, token: str, known_version: i64) -> domain.RemoteVault! {
    mut headers := auth_header(token)
    if known_version > 0 {
        headers = headers + "If-None-Match: " + domain.version_tag(known_version) + "\n"
    }
    r := try self.send("GET", url, headers, [])
    host := url_host(url)
    if r.status == 304 {
        return domain.RemoteVault{ found: true, changed: false, version: known_version, vault_id: r.vault_id, data: [] }
    }
    if r.status == 404 {
        // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
        parsed := json.parse[RemoteErrorBody](payload: str(r.body)) or RemoteErrorBody{ error: "", message: "" }
        if parsed.error == "empty" {
            return domain.RemoteVault{ found: false, changed: true, version: 0, vault_id: "", data: [] }
        }
        return error(no_server(url))
    }
    if r.status != 200 {
        return error(refusal(r, host))
    }
    version := domain.parse_version_tag(r.etag)
    if version < 1 || !domain.valid_vault_id(r.vault_id) || r.body.len() == 0 {
        return error(domain.coded(domain.ERR_INVALID, "{host} did not answer as a Flint vault server"))
    }
    return domain.RemoteVault{ found: true, changed: true, version: version, vault_id: r.vault_id, data: r.body }
}

fn (self: HttpVaultRemote) remote_put(url: str, token: str, vault_id: str, base_version: i64, data: []byte) -> domain.RemoteStored! {
    mut headers := auth_header(token) + "Content-Type: application/octet-stream\nX-Flint-Vault-Id: " + vault_id + "\n"
    if base_version == 0 {
        headers = headers + "If-None-Match: *\n"
    } else {
        headers = headers + "If-Match: " + domain.version_tag(base_version) + "\n"
    }
    r := try self.send("PUT", url, headers, data)
    host := url_host(url)
    if r.status == 409 {
        return domain.RemoteStored{ stored: false, version: domain.parse_version_tag(r.etag) }
    }
    if r.status != 200 {
        return error(refusal(r, host))
    }
    version := domain.parse_version_tag(r.etag)
    if version < 1 {
        return error(domain.coded(domain.ERR_INVALID, "{host} did not answer as a Flint vault server"))
    }
    return domain.RemoteStored{ stored: true, version: version }
}

fn (self: HttpVaultRemote) remote_list(url: str, token: str) -> []domain.ServerVault! {
    r := try self.send("GET", url, auth_header(token), [])
    if r.status == 404 {
        return error(no_server(url))
    }
    if r.status != 200 {
        return error(refusal(r, url_host(url)))
    }
    // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
    got := json.parse[RemoteVaultsBody](payload: str(r.body)) or {
        return error(domain.coded(domain.ERR_INVALID, "{url_host(url)} did not answer as a Flint vault server"))
    }
    for v in got.vaults {
        if !domain.valid_vault_id(v.id) || v.version < 1 {
            return error(domain.coded(domain.ERR_INVALID, "{url_host(url)} did not answer as a Flint vault server"))
        }
    }
    return got.vaults
}

fn (self: HttpVaultRemote) remote_set_label(url: str, token: str, label: str) -> void! {
    headers := auth_header(token) + "Content-Type: application/json\n"
    r := try self.send("PUT", url, headers, []byte(json.stringify(RemoteLabelBody{ label: label })))
    if r.status == 404 {
        // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
        parsed := json.parse[RemoteErrorBody](payload: str(r.body)) or RemoteErrorBody{ error: "", message: "" }
        if parsed.error == "empty" {
            return error(domain.coded(domain.ERR_NOT_FOUND, "the server at {url_host(url)} holds no such vault"))
        }
        return error(no_server(url))
    }
    if r.status != 200 {
        return error(refusal(r, url_host(url)))
    }
}
