package vaultremote

// The ntfy notifier against a server of its own on loopback (milestone 63). The stub
// answers 200 only to a publish exactly as Flint must send it, so a success here
// proves the method, the path, the headers and the body.

import "core:net/http"
import "core:time"
import "../../domain"

fn publish_code(n: NtfyNotifier, server: str, topic: str, kind: str) -> str {
    n.alert_publish(server, topic, kind) or err {
        return domain.error_code_of("{err.message()}")
    }
    return "ok"
}

fn publish_text(n: NtfyNotifier, server: str, topic: str, kind: str) -> str {
    n.alert_publish(server, topic, kind) or err {
        return "{err.message()}"
    }
    return "ok"
}

fn stub_answer(req: http.Request, kind: str) -> http.Response {
    if req.method != "POST" || req.header("title") != "Flint" || req.header("priority") != domain.alert_priority(kind) {
        return http.Response.text(418, "headers")
    }
    if str(req.body) != domain.alert_text(kind) {
        return http.Response.text(417, "body")
    }
    return http.Response.json(200, "{\"id\":\"x\"}")
}

test "an alert is one POST of its fixed text, title and priority" {
    mut server := try make(http.Server, 0, host: "127.0.0.1")
    defer server.stop()
    mut router := make(http.Router)
    // One route per kind, each answering 200 only to that kind's exact publish.
    router.post("/flint-approval") |req| { return stub_answer(req, domain.ALERT_APPROVAL) }
    router.post("/flint-locked") |req| { return stub_answer(req, domain.ALERT_LOCKED) }
    router.post("/flint-test") |req| { return stub_answer(req, domain.ALERT_TEST) }
    router.post("/flint-denied") |_req| { return http.Response.text(403, "forbidden") }
    router.post("/flint-slow") |_req| {
        time.sleep_ms(1500)
        return http.Response.json(200, "{}")
    }
    server.serve_in_background(router)
    base := "http://127.0.0.1:{server.port()}"
    n := new_ntfy_notifier()
    assert_eq(publish_code(n, base, "flint-approval", domain.ALERT_APPROVAL), "ok")
    assert_eq(publish_code(n, base, "flint-locked", domain.ALERT_LOCKED), "ok")
    assert_eq(publish_code(n, base + "/", "flint-test", domain.ALERT_TEST), "ok")
    // The wrong kind's text or priority is refused by the stub.
    assert_eq(publish_code(n, base, "flint-locked", domain.ALERT_APPROVAL), domain.ERR_REFUSED)
    assert_eq(ntfy_headers(domain.ALERT_LOCKED), "Title: Flint\nPriority: high\nContent-Type: text/plain; charset=utf-8")
    assert_eq(publish_code(n, base, "flint-denied", domain.ALERT_APPROVAL), domain.ERR_REFUSED)
    assert_eq(publish_text(n, base, "flint-denied", domain.ALERT_APPROVAL), "refused: the server answered 403")
    // An error names the host, never the topic.
    assert(!publish_text(n, base, "flint-denied", domain.ALERT_APPROVAL).contains("flint-denied"))
    slow := NtfyNotifier{ connect_ms: 500, request_ms: 500 }
    assert_eq(publish_text(slow, base, "flint-slow", domain.ALERT_APPROVAL), "timeout: couldn't reach 127.0.0.1:{server.port()} (timed out)")
    // Nothing listens on port 1.
    assert_eq(publish_text(n, "http://127.0.0.1:1", "flint-topic", domain.ALERT_APPROVAL), "network: couldn't reach 127.0.0.1:1")
    // Refused before any request.
    assert_eq(publish_code(n, base, "a/b", domain.ALERT_APPROVAL), domain.ERR_INVALID)
    assert_eq(publish_code(n, base, "flint-topic", "prod-db"), domain.ERR_INVALID)
    assert_eq(publish_code(n, "ntfy.sh", "flint-topic", domain.ALERT_APPROVAL), domain.ERR_INVALID)
}
