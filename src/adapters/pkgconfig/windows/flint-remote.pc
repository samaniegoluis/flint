# CFIRE-UPSTREAM: CF-031, CF-146
# See ../linux/flint-remote.pc. Windows: MSYS2's mingw-w64-clang-x86_64-curl-winssl,
# TLS through Schannel and the Windows certificate store, linked static (cfire links
# every Windows target -static), so no curl DLL ships.
Name: flint-remote
Description: Native HTTP shim for Flint's remote vault client (Windows)
Version: 1
Requires: libcurl
Cflags: -I${pcfiledir}/../../vaultremote/native
