# CFIRE-UPSTREAM: CF-031, CF-146
# See ../linux/flint-remote.pc. Windows port (windows-port branch only): libcurl built
# static by windows/bin/curl.sh, HTTP and HTTPS only, TLS through Schannel and the
# Windows certificate store; its .pc carries -DCURL_STATICLIB and the system libraries.
Name: flint-remote
Description: Native HTTP shim for Flint's remote vault client (Windows)
Version: 1
Requires: libcurl
Cflags: -I${pcfiledir}/../../vaultremote/native
