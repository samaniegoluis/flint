# CFIRE-UPSTREAM: CF-031
# See ../darwin/flint-native.pc. Windows port (windows-port branch only): the keychain
# shim sits on Credential Manager (advapi32), sockets on Winsock, the font list on GDI.
# cfire 0.12 links every Windows target -static but asks pkg-config without --static,
# so MSYS2's libssh and libsodium headers would declare dllimport: Flint says static.
Name: flint-native
Description: Native shims for Flint's keychain and process adapters (Windows)
Version: 1
Requires: libssh libcrypto zlib
Cflags: -DLIBSSH_STATIC=1 -DSODIUM_STATIC=1 -I${pcfiledir}/../../keychain/native -I${pcfiledir}/../../process/native -I${pcfiledir}/../../ssh/native -I${pcfiledir}/../../uievents/native -I${pcfiledir}/../../vault/native -I${pcfiledir}/../../fonts/native -I${pcfiledir}/../../ipc/native -I${pcfiledir}/../../clilink/native
Libs: -ladvapi32 -lcrypt32 -lws2_32 -liphlpapi -lbcrypt -lgdi32 -luser32
