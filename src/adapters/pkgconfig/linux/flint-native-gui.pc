# CFIRE-UPSTREAM: CF-031
# The desktop app's own native shims (the clipboard, CF-053) on GTK 3, which WebKitGTK
# already pulls in. Kept apart from flint-native so the CLI never links GTK.
Name: flint-native-gui
Description: Native shims of Flint's desktop app (Linux)
Version: 1
Requires: gtk+-3.0
Cflags: -I${pcfiledir}/../../uievents/native
