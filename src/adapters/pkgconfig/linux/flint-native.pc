# CFIRE-UPSTREAM: CF-031
# See ../darwin/flint-native.pc. On Linux the keychain shim sits on libsecret.
Name: flint-native
Description: Native shims for Flint's keychain and process adapters (Linux)
Version: 1
Requires: libsecret-1 libssh
Cflags: -I${pcfiledir}/../../keychain/native -I${pcfiledir}/../../process/native -I${pcfiledir}/../../ssh/native
