# CFIRE-UPSTREAM: CF-031, CF-119
# The RDP adapter's native shim (libfreerdp 3 and its client channels, milestones 28 and 30). Kept apart from
# flint-native so the CLI never links FreeRDP: only the desktop app imports
# src/adapters/rdp.
Name: flint-rdp
Description: Native RDP shim of Flint's desktop app (darwin)
Version: 1
Requires: freerdp-client3 freerdp3 winpr3 libsodium
Cflags: -I${pcfiledir}/../../rdp/native
Libs: -framework Carbon
