package clilink

// The `CliLinks` port over the file system (native/flint_clilink.hpp, milestone 48).

import cpp "flint_clilink.hpp"
import "../../domain"

type OsCliLinks struct {
    enabled: bool
}

fn new_os_cli_links() -> OsCliLinks {
    return OsCliLinks{ enabled: true }
}

fn (self: OsCliLinks) cli_link_probe(path: str) -> LinkProbe {
    mut exists := false
    mut is_link := false
    mut target := ""
    mut target_exists := false
    mut writable := false
    // CFIRE-UPSTREAM: CF-171
    cpp {
        auto p = flint_clilink::probe(std::string(path));
        exists = p.exists;
        is_link = p.is_link;
        target = p.target;
        target_exists = p.target_exists;
        writable = p.dir_writable;
    }
    return LinkProbe{ exists: exists, is_link: is_link, target: target, target_exists: target_exists, dir_writable: writable }
}

fn (self: OsCliLinks) cli_link_exists(path: str) -> bool {
    mut ok := false
    // CFIRE-UPSTREAM: CF-171
    cpp {
        ok = flint_clilink::exists(std::string(path));
    }
    return ok
}

fn (mut self: OsCliLinks) cli_link_make(target: str, path: str, admin: bool) -> void! {
    mut why := ""
    // CFIRE-UPSTREAM: CF-171
    cpp {
        why = flint_clilink::make(std::string(target), std::string(path), admin);
    }
    return link_result(why, path)
}

fn (mut self: OsCliLinks) cli_link_remove(path: str, admin: bool) -> void! {
    mut why := ""
    // CFIRE-UPSTREAM: CF-171
    cpp {
        why = flint_clilink::remove(std::string(path), admin);
    }
    return link_result(why, path)
}

fn link_result(why: str, path: str) -> void! {
    if why.len() == 0 {
        return
    }
    if why == "cancelled" {
        return error(coded(ERR_DENIED, "no administrator password was given; {path} was left as it was"))
    }
    if why == "unsupported" {
        return error(coded(ERR_UNSUPPORTED, "linking the flint command is for macOS"))
    }
    return error(coded(ERR_IO, why))
}

// The `CliPath` port on Windows' registry (milestone 50): `key` is the HKCU subkey,
// "Environment" for the user's real Path; gui-e2e and the adapter test give one of
// their own (FLINT_CLI_PATH_KEY), so a run never touches the machine's Path.
CLI_PATH_KEY: str = "Environment"

type OsCliPath struct {
    key: str
}

fn new_os_cli_path(key: str) -> OsCliPath {
    return OsCliPath{ key: key }
}

fn (self: OsCliPath) cli_path_read() -> str! {
    mut value := ""
    mut why := ""
    mut ok := false
    // CFIRE-UPSTREAM: CF-178
    cpp {
        std::string v, e;
        ok = flint_clilink::path_read(std::string(self.key), v, e);
        value = v;
        why = e;
    }
    if !ok {
        return error(coded(ERR_IO, why))
    }
    return value
}

fn (mut self: OsCliPath) cli_path_write(value: str) -> void! {
    mut why := ""
    // CFIRE-UPSTREAM: CF-178
    cpp {
        why = flint_clilink::path_write(std::string(self.key), std::string(value));
    }
    if why == "unsupported" {
        return error(coded(ERR_UNSUPPORTED, "the PATH is offered on Windows"))
    }
    if why.len() > 0 {
        return error(coded(ERR_IO, why))
    }
}

fn (self: OsCliPath) cli_path_probe(entry: str) -> PathEntryProbe {
    mut has_cli := false
    mut has_app := false
    // CFIRE-UPSTREAM: CF-178
    cpp {
        flint_clilink::entry_probe(std::string(entry), has_cli, has_app);
    }
    return PathEntryProbe{ entry: entry, has_cli: has_cli, has_app: has_app }
}

fn (self: OsCliPath) cli_path_file_exists(path: str) -> bool {
    mut ok := false
    // CFIRE-UPSTREAM: CF-178
    cpp {
        ok = flint_clilink::file_exists(std::string(path));
    }
    return ok
}
