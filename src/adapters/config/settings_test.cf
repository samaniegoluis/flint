package config

import "core:fs"
import "core:crypto/sha256"
import "../../ports"
import "../../domain"

fn settings_port_check[T: SettingsStore](mut t: T) -> bool {
    s := t.settings_load() or err { return false }
    return s.theme == "system"
}

test "settings round-trip through settings.json and default when missing or damaged" {
    dir := "/tmp/flint-config-" + sha256.random_hex(8)
    mut store := new_json_settings_store(dir)
    assert(settings_port_check(mut store))
    mut s := default_settings()
    s.accent = "moss"
    s.term_font = "JetBrainsMono Nerd Font"
    try store.settings_save(s)
    back := try store.settings_load()
    assert_eq(back.accent, "moss")
    assert_eq(back.term_font, "JetBrainsMono Nerd Font")
    // A file from before terminal themes keeps its other choices.
    try fs.write_text(dir + "/settings.json", "{\"version\":1,\"settings\":{\"theme\":\"dark\",\"accent\":\"iris\",\"density\":\"default\",\"follow_motion\":true,\"reopen_last_vault\":true,\"term_font\":\"\",\"term_font_size\":14,\"term_line_height\":100,\"term_cursor\":\"bar\",\"term_cursor_blink\":false}}")
    old := try store.settings_load()
    assert_eq(old.accent, "iris")
    // ext:json ignores `default:` (CF-057): the field reads as "", and
    // application.load_settings repairs it to the default.
    assert_eq(old.term_theme, "")
    try fs.write_text(dir + "/settings.json", "{not json")
    again := try store.settings_load()
    assert_eq(again.accent, "ember")
}
