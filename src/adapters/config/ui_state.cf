package config

// The `UiStateStore` port: ui-state.json in the user's config folder, beside
// settings.json and vaults.json (D-030). It holds the sidebar state and, per vault
// id, the ids of collapsed groups: opaque ids only, no names (Principle 5).

import "core:fs"
import "core:json"
import "../../domain"

// File shape: local structs, as in recents.cf.
type UiVaultEntry struct {
    vault:     str   `json:"vault"`
    collapsed: []str `json:"collapsed"`
}

type UiStateFile struct {
    version:       i64            `json:"version"`
    sidebar_open:  bool           `json:"sidebar_open"`
    sidebar_width: i64            `json:"sidebar_width"`
    files_width:   i64            `json:"files_width" default:"340"`
    fullscreen_note_seen: bool    `json:"fullscreen_note_seen" default:"false"`
    vaults:        []UiVaultEntry `json:"vaults"`
    // Milestone 59: host row ids only (Principle 5).
    rdp_pipeline_hosts: []str     `json:"rdp_pipeline_hosts"`
}

pub type JsonUiStateStore struct {
    path: str
}

pub fn new_json_ui_state_store(dir: str) -> JsonUiStateStore {
    return JsonUiStateStore{ path: dir + "/ui-state.json" }
}

fn (self: JsonUiStateStore) ui_state_load() -> domain.UiState! {
    if !fs.exists(self.path) {
        return domain.default_ui_state()
    }
    text := fs.read_text(self.path) or {
        return domain.default_ui_state()
    }
    // A damaged file only costs the layout: start from the defaults (D-030).
    // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
    parsed := json.parse[UiStateFile](payload: text) or {
        return domain.default_ui_state()
    }
    mut s := domain.UiState{ sidebar_open: parsed.sidebar_open, sidebar_width: parsed.sidebar_width, files_width: parsed.files_width, fullscreen_note_seen: parsed.fullscreen_note_seen, vaults: [], rdp_pipeline_hosts: parsed.rdp_pipeline_hosts }
    for v in parsed.vaults {
        s.vaults.push(domain.VaultUiState{ vault: v.vault, collapsed: v.collapsed })
    }
    return s
}

fn (self: JsonUiStateStore) ui_state_save(s: domain.UiState) -> void! {
    mut file := UiStateFile{ version: 1, sidebar_open: s.sidebar_open, sidebar_width: s.sidebar_width, files_width: s.files_width, fullscreen_note_seen: s.fullscreen_note_seen, vaults: [], rdp_pipeline_hosts: s.rdp_pipeline_hosts }
    for v in s.vaults {
        file.vaults.push(UiVaultEntry{ vault: v.vault, collapsed: v.collapsed })
    }
    try write_file_atomic(self.path, json.stringify(file) + "\n")
}
