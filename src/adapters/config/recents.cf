package config

// The `RecentStore` port: a small JSON file in the user's config folder listing the
// vaults this machine has opened, most recent first. It holds file paths, vault
// names and vault ids (a hash of the salt, D-030) only, never anything from inside a
// vault (Principle 5).

import "core:fs"
import "core:os"
import "core:json"
import "../../domain"

// File shape: a local struct, so the file format does not follow the domain type.
// `id` (the vault id, D-030) came in milestone 07; in older files it reads as "".
type RecentEntry struct {
    path: str `json:"path"`
    name: str `json:"name"`
    id:   str `json:"id"`
}

type RecentFile struct {
    version: i64           `json:"version"`
    vaults:  []RecentEntry `json:"vaults"`
}

pub type JsonRecentStore struct {
    path: str
}

// Where Flint keeps per-machine settings: $FLINT_CONFIG_DIR when set, else
// ~/Library/Application Support/Flint on macOS, $XDG_CONFIG_HOME/flint
// (default ~/.config/flint) on Linux and %APPDATA%\Flint on Windows.
pub fn flint_config_dir() -> str {
    override := (os.getenv("FLINT_CONFIG_DIR") or "")
    if override.len() > 0 {
        return override
    }
    home: str = (os.getenv("HOME") or "")
    mut apple := false
    mut windows := false
    // cfire has no build-target query (CF-031).
    // CFIRE-UPSTREAM: CF-031
    cpp {
        #if defined(__APPLE__)
        apple = true;
        #elif defined(_WIN32)
        windows = true;
        #endif
    }
    if windows {
        return (os.getenv("APPDATA") or "") + "/Flint"
    }
    if apple {
        return home + "/Library/Application Support/Flint"
    }
    xdg: str = (os.getenv("XDG_CONFIG_HOME") or "")
    if xdg.len() > 0 {
        return xdg + "/flint"
    }
    return home + "/.config/flint"
}

pub fn new_json_recent_store(dir: str) -> JsonRecentStore {
    return JsonRecentStore{ path: dir + "/vaults.json" }
}

fn (self: JsonRecentStore) recents_load() -> []domain.RecentVault! {
    if !fs.exists(self.path) {
        return []
    }
    text := fs.read_text(self.path) or {
        return error(domain.coded(domain.ERR_IO, "cannot read {self.path}"))
    }
    // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
    parsed := json.parse[RecentFile](payload: text) or {
        return error(domain.coded(domain.ERR_IO, "{self.path} is not a valid vault list; fix or delete it"))
    }
    mut list: []domain.RecentVault = []
    for e in parsed.vaults {
        list.push(domain.RecentVault{ path: e.path, name: e.name, id: e.id })
    }
    return list
}

fn (self: JsonRecentStore) recents_save(list: []domain.RecentVault) -> void! {
    dir := fs.dirname(self.path)
    fs.mkdir_all(dir) or {
        return error(domain.coded(domain.ERR_IO, "cannot create {dir}"))
    }
    mut entries: []RecentEntry = []
    for v in list {
        entries.push(RecentEntry{ path: v.path, name: v.name, id: v.id })
    }
    body := json.stringify(RecentFile{ version: 1, vaults: entries })
    fs.write_text(self.path, body + "\n") or {
        return error(domain.coded(domain.ERR_IO, "cannot write {self.path}"))
    }
}
