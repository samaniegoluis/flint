package serverfs

// The `BlobStore` port as files in one folder, the server's volume (milestones 42 and
// 45, D-097, D-103), a folder per vault:
//
//   <dir>/vaults/<id>/head.json            the newest version: number, id, size, time
//   <dir>/vaults/<id>/versions/<n>.blob    each version's file, as uploaded (encrypted)
//   <dir>/vaults/<id>/versions/<n>.json    its number, vault id, size and time
//   <dir>/vaults/<id>/label.json           the label the person chose, if any
//   <dir>/vaults/<id>/.lock                a folder, held while a version is written
//
// A version is written to `.tmp` files flushed to disk, renamed into place, and only
// then named by `head.json`, so a crash or a copy taken meanwhile never sees half a
// version. The lock keeps `flint-vault-server restore` and the running server from
// writing the same number; a lock older than STORE_LOCK_STALE_MS is taken as left by
// a process that died.
//
// A store from before milestone 45 kept one vault at the top (`<dir>/head.json`,
// `<dir>/versions/`); opening it moves that vault into its folder, `versions/` first
// and `head.json` last, so a move cut short is finished at the next start.

// CFIRE-UPSTREAM: CF-099, CF-031
import cpp "flint_server.hpp"

import "core:fs"
import "core:json"
import "core:time"
import "../../domain"

STORE_LOCK_STALE_MS: i64 = 30000

type FileBlobStore struct {
    dir:   str
    // The id of a vault moved from a store from before milestone 45 when it opened;
    // "" otherwise. For the server's log.
    moved: str
}

type LabelFile struct {
    label: str `json:"label"`
}

// Opens (or starts) the store in `dir`, moving a store from before milestone 45 into
// the layout of one folder per vault.
fn new_file_blob_store(dir: str) -> FileBlobStore! {
    if dir.len() == 0 {
        return error(coded(ERR_USAGE, "the data folder is not set"))
    }
    fs.mkdir_all(dir + "/vaults") or err {
        return error(coded(ERR_IO, "cannot create {dir}/vaults"))
    }
    mut s := FileBlobStore{ dir: dir, moved: "" }
    s.moved = try s.move_single_vault()
    return s
}

// What `move_single_vault` found: "" (nothing to move) or the id moved.
fn (self: FileBlobStore) move_single_vault() -> str! {
    top_head := self.dir + "/head.json"
    top_versions := self.dir + "/versions"
    if !fs.exists(top_head) {
        // A store from before that never received a vault left an empty folder.
        if fs.exists(top_versions) {
            names := fs.list_dir(top_versions) or err {
                return ""
            }
            if names.len() == 0 {
                _ = fs.remove(top_versions)
            }
        }
        return ""
    }
    text := fs.read_text(top_head) or err {
        return error(coded(ERR_IO, "cannot read {top_head}"))
    }
    // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
    head := json.parse[BlobVersion](payload: text) or err {
        return error(coded(ERR_IO, "{top_head} is not a version record"))
    }
    if !valid_vault_id(head.vault_id) {
        return error(coded(ERR_IO, "{top_head} names no vault id"))
    }
    target := self.vault_dir(head.vault_id)
    fs.mkdir_all(target) or err {
        return error(coded(ERR_IO, "cannot create {target}"))
    }
    if fs.exists(top_versions) && !fs.exists(target + "/versions") {
        fs.rename(top_versions, target + "/versions") or err {
            return error(coded(ERR_IO, "cannot move {top_versions} to {target}"))
        }
    }
    try sync_folder(self.dir)
    fs.rename(top_head, target + "/head.json") or err {
        return error(coded(ERR_IO, "cannot move {top_head} to {target}"))
    }
    _ = fs.remove(self.dir + "/.lock")
    try sync_folder(target)
    try sync_folder(self.dir)
    return head.vault_id
}

fn (self: FileBlobStore) vault_dir(vault_id: str) -> str {
    return "{self.dir}/vaults/{vault_id}"
}

fn (self: FileBlobStore) version_path(vault_id: str, version: i64, ext: str) -> str {
    return "{self.dir}/vaults/{vault_id}/versions/{version}.{ext}"
}

fn check_id(vault_id: str) -> void! {
    if !valid_vault_id(vault_id) {
        return error(coded(ERR_INVALID, "not a vault id: {vault_id}"))
    }
}

// Writes `data` to `path` (created 0600; one left by a crash is replaced), flushed to
// disk before it is closed.
fn write_synced(path: str, data: str) -> void! {
    // An owned copy: a `str` parameter passed to `fs.remove` takes the coercion of
    // stdio.h's remove(3) (CF-158).
    // CFIRE-UPSTREAM: CF-158
    owned: str = path
    _ = fs.remove(owned)
    mut f := fs.create_new(owned) or err {
        return error(coded(ERR_IO, "cannot write {path}: {err.message()}"))
    }
    f.write_text(data) or err {
        f.close()
        return error(coded(ERR_IO, "cannot write {path}: {err.message()}"))
    }
    f.sync() or err {
        f.close()
        return error(coded(ERR_IO, "cannot write {path}: {err.message()}"))
    }
    f.close()
}

// Flushes a folder, so a rename into it is on disk.
fn sync_folder(path: str) -> void! {
    // CFIRE-UPSTREAM: CF-158
    owned: str = path
    mut d := fs.open(owned) or err {
        return error(coded(ERR_IO, "cannot flush {path}: {err.message()}"))
    }
    d.sync() or err {
        d.close()
        return error(coded(ERR_IO, "cannot flush {path}: {err.message()}"))
    }
    d.close()
}

// Writes `data` beside `path`, flushed, then renames it over `path`.
fn replace_synced(path: str, data: str) -> void! {
    tmp := path + ".tmp"
    write_synced(tmp, data) or err {
        _ = fs.remove(tmp)
        return error(err.message())
    }
    // str(): a view here lowers like the C function of that name (CFIRE-UPSTREAM: CF-158)
    fs.rename(tmp, str(path)) or err {
        _ = fs.remove(tmp)
        return error(coded(ERR_IO, "cannot replace {path}"))
    }
}

fn (self: FileBlobStore) blob_vaults() -> []ServerVault! {
    names := fs.list_dir(self.dir + "/vaults") or err {
        return error(coded(ERR_IO, "cannot list {self.dir}/vaults"))
    }
    mut found: []ServerVault = []
    for name in names {
        if !valid_vault_id(name) {
            continue
        }
        head := try self.blob_head(name)
        if head.version == 0 {
            continue
        }
        found.push(ServerVault{ id: name, label: self.label_of(name), version: head.version, size: head.size, updated_at: head.stored_at })
    }
    return found
}

fn (self: FileBlobStore) label_of(vault_id: str) -> str {
    path := self.vault_dir(vault_id) + "/label.json"
    if !fs.exists(path) {
        return ""
    }
    text := fs.read_text(path) or err {
        return ""
    }
    // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
    f := json.parse[LabelFile](payload: text) or err {
        return ""
    }
    return f.label
}

fn (self: FileBlobStore) blob_head(vault_id: str) -> BlobVersion! {
    try check_id(vault_id)
    path := self.vault_dir(vault_id) + "/head.json"
    if !fs.exists(path) {
        return BlobVersion{ version: 0, vault_id: vault_id, size: 0, stored_at: 0 }
    }
    text := fs.read_text(path) or err {
        return error(coded(ERR_IO, "cannot read {path}"))
    }
    // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
    return json.parse[BlobVersion](payload: text) or err {
        return error(coded(ERR_IO, "{path} is not a version record"))
    }
}

fn (self: FileBlobStore) blob_read(vault_id: str, version: i64) -> str! {
    try check_id(vault_id)
    path := self.version_path(vault_id, version, "blob")
    if !fs.exists(path) {
        return error(coded(ERR_NOT_FOUND, "version {version} is not kept"))
    }
    return fs.read_text(path) or err {
        return error(coded(ERR_IO, "cannot read {path}"))
    }
}

// Takes the vault's lock, or says another writer holds it.
fn (self: FileBlobStore) store_lock(vault_id: str) -> void! {
    lock := self.vault_dir(vault_id) + "/.lock"
    for attempt in 0..2 {
        mut rc: i32 = 0
        mut reason := ""
        // An exclusive mkdir: core:fs has only mkdir_all (CF-099).
        // CFIRE-UPSTREAM: CF-099
        cpp {
            rc = flint_server::make_dir_exclusive(lock, reason);
        }
        if rc == 0 {
            return
        }
        if rc != 3 {
            return error(coded(ERR_IO, "cannot create {lock}: {reason}"))
        }
        mut mtime: i64 = -1
        info := fs.stat(lock) or fs.FileInfo{ mtime_ms: -1 }
        mtime = info.mtime_ms
        if mtime < 0 || time.now().unix_millis() - mtime < STORE_LOCK_STALE_MS {
            return error(coded(ERR_CONFLICT, "another writer holds {lock}"))
        }
        _ = fs.remove(lock)
    }
    return error(coded(ERR_CONFLICT, "another writer holds {lock}"))
}

fn (self: FileBlobStore) store_unlock(vault_id: str) {
    _ = fs.remove(self.vault_dir(vault_id) + "/.lock")
}

fn (mut self: FileBlobStore) blob_write(vault_id: str, version: i64, data: str, now_ms: i64) -> void! {
    try check_id(vault_id)
    vdir := self.vault_dir(vault_id)
    fs.mkdir_all(vdir + "/versions") or err {
        return error(coded(ERR_IO, "cannot create {vdir}/versions"))
    }
    try self.store_lock(vault_id)
    defer {
        self.store_unlock(vault_id)
    }
    // Under the lock: the version must still follow the head.
    head := try self.blob_head(vault_id)
    if head.version != version - 1 {
        return error(coded(ERR_CONFLICT, "version {head.version} was stored meanwhile"))
    }
    rec := BlobVersion{ version: version, vault_id: vault_id, size: i64(data.len()), stored_at: now_ms }
    meta := json.stringify(rec)
    try replace_synced(self.version_path(vault_id, version, "blob"), data)
    try replace_synced(self.version_path(vault_id, version, "json"), meta)
    try sync_folder(vdir + "/versions")
    try replace_synced(vdir + "/head.json", meta)
    try sync_folder(vdir)
    if version == 1 {
        try sync_folder(self.dir + "/vaults")
    }
    self.prune(vault_id, version)
}

fn (mut self: FileBlobStore) blob_set_label(vault_id: str, label: str) -> void! {
    try check_id(vault_id)
    try check_vault_label(label)
    head := try self.blob_head(vault_id)
    if head.version == 0 {
        return error(coded(ERR_NOT_FOUND, "the server holds no vault {vault_id}"))
    }
    path := self.vault_dir(vault_id) + "/label.json"
    if label.len() == 0 {
        if fs.exists(path) {
            fs.remove(path) or err {
                return error(coded(ERR_IO, "cannot remove {path}"))
            }
        }
        return
    }
    try replace_synced(path, json.stringify(LabelFile{ label: label }))
}

// Removes the versions past the kept history, and `.tmp` files a crash left behind.
fn (self: FileBlobStore) prune(vault_id: str, head: i64) {
    vdir := self.vault_dir(vault_id) + "/versions"
    names := fs.list_dir(vdir) or err {
        return
    }
    for name in names {
        if name.ends_with(".tmp") {
            _ = fs.remove("{vdir}/{name}")
            continue
        }
        n := version_of_name(name)
        if n > 0 && n <= head - SERVER_VERSIONS_KEPT {
            _ = fs.remove("{vdir}/{name}")
        }
    }
}

// "12.blob" or "12.json" -> 12; -1 otherwise.
fn version_of_name(name: str) -> i64 {
    mut stem := ""
    if name.ends_with(".blob") || name.ends_with(".json") {
        stem = name[..name.len() - 5]
    }
    return parse_version_tag(stem)
}

fn (self: FileBlobStore) blob_versions(vault_id: str) -> []BlobVersion! {
    head := try self.blob_head(vault_id)
    if head.version == 0 {
        return []
    }
    vdir := self.vault_dir(vault_id) + "/versions"
    names := fs.list_dir(vdir) or err {
        return error(coded(ERR_IO, "cannot list {vdir}"))
    }
    mut found: []BlobVersion = []
    for name in names {
        if !name.ends_with(".json") {
            continue
        }
        n := version_of_name(name)
        // A version past the head was cut short by a crash before it was named.
        if n < 1 || n > head.version || !fs.exists(self.version_path(vault_id, n, "blob")) {
            continue
        }
        text := fs.read_text("{vdir}/{name}") or err {
            continue
        }
        // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
        v := json.parse[BlobVersion](payload: text) or err {
            continue
        }
        found.push(v)
    }
    // Newest first (list_dir sorts by name, so "10" comes before "9").
    mut newest: []BlobVersion = []
    for k in 0..found.len() {
        mut best: usize = 0
        for i in 0..found.len() {
            if found[i].version > found[best].version {
                best = i
            }
        }
        newest.push(found[best])
        found[best].version = -1
    }
    return newest
}
