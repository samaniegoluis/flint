package crypto

import "../../ports"
import "core:encoding/hex"

// Cross-checked against argon2-cffi (the reference C implementation):
// hash_secret_raw(b"flint", bytes(range(16)), time_cost=2, memory_cost=65536,
// parallelism=1, hash_len=32, type=ID).
ARGON2_VECTOR: str = "592d7ec75bb085ab5ba3ba0c81792c9aba96973ca244ed3442f8d12547212642"

fn hex_of(b: []byte) -> str {
    return hex.encode(b)
}

// Compiles only if Sodium satisfies the Crypto port.
fn port_roundtrip[C: Crypto](c: C) -> bool {
    key := c.random_bytes(32)
    msg: []byte = [byte(7), byte(7)]
    sealed := c.seal(key, msg, []) or err { return false }
    back := c.unseal(key, sealed, []) or err { return false }
    return back == msg
}

// libsodium's OPSLIMIT/MEMLIMIT_INTERACTIVE: fast enough for tests.
TEST_OPS: u64 = 2
TEST_MEM: usize = 67108864

fn test_salt() -> []byte {
    mut salt := make([]byte, SALT_LEN)
    for i in 0..SALT_LEN {
        salt[i] = byte(i)
    }
    return salt
}

test "argon2id derivation is deterministic and password-sensitive" {
    c := try new_sodium()
    a := try c.derive_key("correct horse", test_salt(), TEST_OPS, TEST_MEM)
    b := try c.derive_key("correct horse", test_salt(), TEST_OPS, TEST_MEM)
    d := try c.derive_key("correct horsf", test_salt(), TEST_OPS, TEST_MEM)
    assert_eq(a.len(), KEY_LEN)
    assert(a == b)
    assert(a != d)
}

test "derive_key rejects a short salt" {
    mut refused := 0
    c := try new_sodium()
    short_salt := make([]byte, 4)
    c.derive_key("pw", short_salt, TEST_OPS, TEST_MEM) or { refused += 1 }
    assert_eq(refused, 1)
}

test "seal/open round-trips and fresh nonces differ" {
    c := try new_sodium()
    key := c.random_bytes(KEY_LEN)
    msg: []byte = [byte(104), byte(111), byte(115), byte(116)]
    aad: []byte = [byte(1)]
    s1 := try c.seal(key, msg, aad)
    s2 := try c.seal(key, msg, aad)
    assert_eq(s1.len(), NONCE_LEN + msg.len() + TAG_LEN)
    assert(s1 != s2)
    back := try c.unseal(key, s1, aad)
    assert(back == msg)
}

test "open fails on tampered ciphertext, wrong key or wrong aad" {
    mut refused := 0
    c := try new_sodium()
    key := c.random_bytes(KEY_LEN)
    msg: []byte = [byte(1), byte(2), byte(3)]
    aad: []byte = [byte(9)]
    sealed := try c.seal(key, msg, aad)

    mut tampered := sealed
    tampered[NONCE_LEN] = tampered[NONCE_LEN] ^ byte(1)
    other: []byte = [byte(8)]
    c.unseal(key, tampered, aad) or { refused += 1 }
    assert_eq(refused, 1)
    c.unseal(c.random_bytes(KEY_LEN), sealed, aad) or { refused += 1 }
    assert_eq(refused, 2)
    c.unseal(key, sealed, other) or { refused += 1 }
    assert_eq(refused, 3)
    _ := try c.unseal(key, sealed, aad)
}

test "wipe zeroes the buffer" {
    mut k: []byte = [byte(1), byte(2), byte(3)]
    wipe(mut k)
    assert(k[0] == 0 && k[1] == 0 && k[2] == 0)
}

test "the port's wipe zeroes the caller's buffer and text in place" {
    c := try new_sodium()
    mut k: []byte = [byte(1), byte(2), byte(3)]
    c.wipe(k)
    assert(k[0] == 0 && k[1] == 0 && k[2] == 0)
    // Long enough to live on the heap, and short enough to sit inside the string.
    mut long := "a password long enough to be allocated on the heap"
    mut short := "pw"
    c.wipe_text(long)
    c.wipe_text(short)
    for b in long.bytes() {
        assert(u8(b) == 0)
    }
    for b in short.bytes() {
        assert(u8(b) == 0)
    }
    // Through a generic caller, as the use cases call it.
    mut t := "secret in a generic"
    assert(wipe_through_port(c, t))
    mut empty: []byte = []
    c.wipe(empty)
    c.wipe_text("")
}

fn wipe_through_port[C: Crypto](c: C, text: str) -> bool {
    c.wipe_text(text)
    for b in text.bytes() {
        if u8(b) != 0 {
            return false
        }
    }
    return true
}

test "Sodium satisfies the Crypto port" {
    c := try new_sodium()
    assert(port_roundtrip(c))
}

test "argon2id matches a fixed vector" {
    // Pins the algorithm and parameter handling: the same inputs must give the same
    // key on every libsodium version and platform, or existing vaults stop opening.
    c := try new_sodium()
    key := try c.derive_key("flint", test_salt(), TEST_OPS, TEST_MEM)
    other_cost := try c.derive_key("flint", test_salt(), 3, TEST_MEM)
    assert(key != other_cost, "ops must change the output")
    assert_eq(hex_of(key), ARGON2_VECTOR)
}

test "subkeys are independent and deterministic" {
    mut refused := 0
    c := try new_sodium()
    master := c.random_bytes(KEY_LEN)
    a := try c.derive_subkey(master, 1, "flintvlt")
    b := try c.derive_subkey(master, 2, "flintvlt")
    a2 := try c.derive_subkey(master, 1, "flintvlt")
    d := try c.derive_subkey(master, 1, "flintxxx")
    assert(a == a2)
    assert(a != b)
    assert(a != d)
    assert(a != master)
    c.derive_subkey(master, 1, "short") or { refused += 1 }
    assert_eq(refused, 1)
}

test "equal compares in constant time and by length" {
    c := try new_sodium()
    a := c.random_bytes(32)
    mut b := a
    assert(c.equal(a, b))
    b[31] = byte(u8(b[31]) ^ u8(1))
    assert(!c.equal(a, b))
    assert(!c.equal(a, c.random_bytes(16)))
}
