package crypto

// libsodium-backed implementation of the `Crypto` port: Argon2id key derivation and
// XChaCha20-Poly1305 AEAD. No primitive here is implemented by hand (Principle 4).

// CFIRE-UPSTREAM: CF-006
import cpp "sodium.h" @pkg("libsodium")

var KEY_LEN: usize = 32
var SALT_LEN: usize = 16
var NONCE_LEN: usize = 24
var TAG_LEN: usize = 16

// Argon2id cost parameters. `Interactive` is libsodium's OPSLIMIT/MEMLIMIT_INTERACTIVE
// (fast, for tests); `Moderate` is what a real vault uses.
type KdfCost enum { Interactive, Moderate }

type Sodium struct {
    cost: KdfCost
}

// libsodium is initialised once per process, at start-up. sodium_init() keeps the
// system RNG open for the life of the process, which is why this is a global and not
// a per-instance call (the `cfire test` fd-leak canary would flag it, CF-018).
fn init_sodium() -> bool {
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-006
    cpp {
        rc = sodium_init();
    }
    return rc >= 0
}

var SODIUM_READY: bool = init_sodium()

fn new_sodium(cost: KdfCost) -> Sodium! {
    if !SODIUM_READY {
        return error("crypto: libsodium failed to initialise")
    }
    return Sodium{ cost: cost }
}

fn (self: Sodium) random_bytes(n: usize) -> []byte {
    mut buf := make([]byte, n)
    // CFIRE-UPSTREAM: CF-006
    cpp {
        randombytes_buf(buf.data(), buf.size());
    }
    return buf
}

// Derives a KEY_LEN-byte key from a password with Argon2id.
fn (self: Sodium) derive_key(password: str, salt: []byte) -> []byte! {
    if salt.len() != SALT_LEN {
        return error("crypto: salt must be {SALT_LEN} bytes")
    }
    moderate := match self.cost {
        KdfCost::Interactive => false,
        KdfCost::Moderate => true,
    }
    mut key := make([]byte, KEY_LEN)
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-006
    cpp {
        unsigned long long ops = moderate ? crypto_pwhash_OPSLIMIT_MODERATE : crypto_pwhash_OPSLIMIT_INTERACTIVE;
        size_t mem = moderate ? crypto_pwhash_MEMLIMIT_MODERATE : crypto_pwhash_MEMLIMIT_INTERACTIVE;
        rc = crypto_pwhash(key.data(), key.size(), password.data(), password.size(),
                           salt.data(), ops, mem, crypto_pwhash_ALG_ARGON2ID13);
    }
    if rc != 0 {
        return error("crypto: key derivation failed (out of memory)")
    }
    return key
}

// Encrypts `plaintext` and returns nonce || ciphertext || tag.
fn (self: Sodium) seal(key: []byte, plaintext: []byte, aad: []byte) -> []byte! {
    if key.len() != KEY_LEN {
        return error("crypto: key must be {KEY_LEN} bytes")
    }
    mut sealed := make([]byte, NONCE_LEN + plaintext.len() + TAG_LEN)
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-006
    cpp {
        randombytes_buf(sealed.data(), crypto_aead_xchacha20poly1305_ietf_NPUBBYTES);
        unsigned long long clen = 0;
        rc = crypto_aead_xchacha20poly1305_ietf_encrypt(
            sealed.data() + crypto_aead_xchacha20poly1305_ietf_NPUBBYTES, &clen,
            plaintext.data(), plaintext.size(), aad.data(), aad.size(),
            nullptr, sealed.data(), key.data());
    }
    if rc != 0 {
        return error("crypto: encryption failed")
    }
    return sealed
}

// Decrypts the output of `seal`. Fails if the key, the AAD or any byte is wrong.
fn (self: Sodium) open(key: []byte, sealed: []byte, aad: []byte) -> []byte! {
    if key.len() != KEY_LEN {
        return error("crypto: key must be {KEY_LEN} bytes")
    }
    if sealed.len() < NONCE_LEN + TAG_LEN {
        return error("crypto: ciphertext too short")
    }
    mut plain := make([]byte, sealed.len() - NONCE_LEN - TAG_LEN)
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-006
    cpp {
        unsigned long long mlen = 0;
        rc = crypto_aead_xchacha20poly1305_ietf_decrypt(
            plain.data(), &mlen, nullptr,
            sealed.data() + crypto_aead_xchacha20poly1305_ietf_NPUBBYTES,
            sealed.size() - crypto_aead_xchacha20poly1305_ietf_NPUBBYTES,
            aad.data(), aad.size(), sealed.data(), key.data());
    }
    if rc != 0 {
        return error("crypto: decryption failed (wrong key or tampered data)")
    }
    return plain
}

// Overwrites a buffer that held key material.
fn wipe(mut buf: []byte) {
    // CFIRE-UPSTREAM: CF-006
    cpp {
        sodium_memzero(buf.data(), buf.size());
    }
}

fn sodium_version() -> str {
    mut v := ""
    // CFIRE-UPSTREAM: CF-006
    cpp {
        v = sodium_version_string();
    }
    return v
}
