package crypto

// libsodium-backed implementation of the `Crypto` port: Argon2id key derivation and
// XChaCha20-Poly1305 AEAD. No primitive here is implemented by hand (Principle 4).

// CFIRE-UPSTREAM: CF-006
import cpp "sodium.h" @pkg("libsodium")

KEY_LEN: usize = 32
SALT_LEN: usize = 16
NONCE_LEN: usize = 24
TAG_LEN: usize = 16

// Stateless: the KDF cost is chosen by the caller (the vault format pins it, D-017).
type Sodium struct {
    ready: bool
}

// libsodium is initialised once per process, at start-up. sodium_init() keeps the
// system RNG open for the life of the process, which is why this is a global and not
// a per-instance call (the `cfire test` fd-leak canary would flag it, CF-018).
fn init_sodium() -> bool {
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-006
    cpp {
        rc = sodium_init();
    }
    return rc >= 0
}

SODIUM_READY: bool = init_sodium()

fn new_sodium() -> Sodium! {
    if !SODIUM_READY {
        return error("internal: libsodium failed to initialise")
    }
    return Sodium{ ready: true }
}

fn (self: Sodium) random_bytes(n: usize) -> []byte {
    mut buf := make([]byte, n)
    // CFIRE-UPSTREAM: CF-006
    cpp {
        randombytes_buf(cfire::c_arg(buf.data()), buf.size());
    }
    return buf
}

// Derives a KEY_LEN-byte key from a password with Argon2id (v1.3), at the given
// cost. `mem_bytes` is the memory limit in bytes.
fn (self: Sodium) derive_key(password: str, salt: []byte, ops: u64, mem_bytes: usize) -> []byte! {
    if salt.len() != SALT_LEN {
        return error("internal: salt must be {SALT_LEN} bytes")
    }
    mut key := make([]byte, KEY_LEN)
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-006
    cpp {
        rc = crypto_pwhash(cfire::c_arg(key.data()), key.size(), password.data(), password.size(),
            cfire::c_arg(salt.data()), static_cast<unsigned long long>(ops), static_cast<size_t>(mem_bytes),
            crypto_pwhash_ALG_ARGON2ID13);
    }
    if rc != 0 {
        return error("internal: key derivation failed (out of memory)")
    }
    return key
}

// Derives subkey number `id` of `master` for an 8-byte `kdf_context`, with libsodium
// crypto_kdf (BLAKE2b). Different ids or contexts give independent keys.
fn (self: Sodium) derive_subkey(master: []byte, id: u64, kdf_context: str) -> []byte! {
    if master.len() != KEY_LEN {
        return error("internal: master key must be {KEY_LEN} bytes")
    }
    if kdf_context.len() != 8 {
        return error("internal: kdf context must be 8 bytes")
    }
    mut sub := make([]byte, KEY_LEN)
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-006
    cpp {
        static_assert(crypto_kdf_KEYBYTES == 32 && crypto_kdf_CONTEXTBYTES == 8);
        rc = crypto_kdf_derive_from_key(cfire::c_arg(sub.data()), sub.size(), static_cast<uint64_t>(id),
            kdf_context.data(), cfire::c_arg(master.data()));
    }
    if rc != 0 {
        return error("internal: subkey derivation failed")
    }
    return sub
}

// A BLAKE2b digest (libsodium crypto_generichash) of `data`, `out_len` bytes long
// (16 to 64). Not a key derivation: it names things, such as a vault by its salt.
fn (self: Sodium) digest(data: []byte, out_len: usize) -> []byte! {
    if out_len < 16 || out_len > 64 {
        return error("internal: digest length must be 16 to 64 bytes")
    }
    mut res := make([]byte, out_len)
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-006
    cpp {
        rc = crypto_generichash(cfire::c_arg(res.data()), res.size(), cfire::c_arg(data.data()), data.size(), nullptr, 0);
    }
    if rc != 0 {
        return error("internal: digest failed")
    }
    return res
}

// Compares in constant time (sodium_memcmp); false when the lengths differ.
fn (self: Sodium) equal(a: []byte, b: []byte) -> bool {
    if a.len() != b.len() {
        return false
    }
    if a.len() == 0 {
        return true
    }
    mut rc: i32 = -1
    // CFIRE-UPSTREAM: CF-006
    cpp {
        rc = sodium_memcmp(cfire::c_arg(a.data()), cfire::c_arg(b.data()), a.size());
    }
    return rc == 0
}

// Encrypts `plaintext` and returns nonce || ciphertext || tag.
fn (self: Sodium) seal(key: []byte, plaintext: []byte, aad: []byte) -> []byte! {
    if key.len() != KEY_LEN {
        return error("internal: key must be {KEY_LEN} bytes")
    }
    mut sealed := make([]byte, NONCE_LEN + plaintext.len() + TAG_LEN)
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-006
    cpp {
        randombytes_buf(cfire::c_arg(sealed.data()), crypto_aead_xchacha20poly1305_ietf_NPUBBYTES);
        unsigned long long clen = 0;
        rc = crypto_aead_xchacha20poly1305_ietf_encrypt(
            cfire::c_arg(sealed.data()) + crypto_aead_xchacha20poly1305_ietf_NPUBBYTES, &clen,
            cfire::c_arg(plaintext.data()), plaintext.size(), cfire::c_arg(aad.data()), aad.size(),
            nullptr, cfire::c_arg(sealed.data()), cfire::c_arg(key.data()));
    }
    if rc != 0 {
        return error("internal: encryption failed")
    }
    return sealed
}

// Decrypts the output of `seal`. Fails if the key, the AAD or any byte is wrong.
fn (self: Sodium) unseal(key: []byte, sealed: []byte, aad: []byte) -> []byte! {
    if key.len() != KEY_LEN {
        return error("internal: key must be {KEY_LEN} bytes")
    }
    if sealed.len() < NONCE_LEN + TAG_LEN {
        return error("invalid: sealed value is too short")
    }
    mut plain := make([]byte, sealed.len() - NONCE_LEN - TAG_LEN)
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-006
    cpp {
        unsigned long long mlen = 0;
        rc = crypto_aead_xchacha20poly1305_ietf_decrypt(
            cfire::c_arg(plain.data()), &mlen, nullptr,
            cfire::c_arg(sealed.data()) + crypto_aead_xchacha20poly1305_ietf_NPUBBYTES,
            sealed.size() - crypto_aead_xchacha20poly1305_ietf_NPUBBYTES,
            cfire::c_arg(aad.data()), aad.size(), cfire::c_arg(sealed.data()), cfire::c_arg(key.data()));
    }
    if rc != 0 {
        return error("invalid: a sealed value failed to open (wrong key or tampered data)")
    }
    return plain
}

// Overwrites a buffer that held key material.
fn wipe(mut buf: []byte) {
    // CFIRE-UPSTREAM: CF-006
    cpp {
        sodium_memzero(cfire::c_arg(buf.data()), buf.size());
    }
}

fn sodium_version() -> str {
    mut v := ""
    // CFIRE-UPSTREAM: CF-006
    cpp {
        v = sodium_version_string();
    }
    return v
}
