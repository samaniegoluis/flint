package process

// The self-update's files and processes on this machine (milestone 53), in a folder of
// the test's own.

import "core:fs"
import "core:os"
import "core:time"
import "../../domain"

fn update_tmp(name: str) -> str {
    return "{temp_base()}/flint-update-{name}-{time.now_ms()}"
}

fn system32() -> str {
    mut root := os.getenv("SystemRoot")
    if root.len() == 0 {
        root = "C:/Windows"
    }
    return local_slashes(root) + "/System32"
}

test "a zip unpacks with the system's tool, and folders move and go by rename" {
    dir := update_tmp("files")
    mut files := new_os_update_files()
    defer { files.upd_remove(dir) or {} }
    try files.upd_mkdir(dir + "/src/Flint.app/Contents/MacOS")
    try files.upd_write(dir + "/src/Flint.app/Contents/MacOS/Flint", "#!/bin/sh\necho flint\n")
    try files.upd_copy_exe(dir + "/src/Flint.app/Contents/MacOS/Flint", dir + "/flint-copy")
    if os_name() != "windows" {
        st := try fs.stat(dir + "/flint-copy")
        assert((st.mode & 0o111) != 0)
    }
    // The zip, as scripts/package.sh makes it (ditto on macOS, zip -r elsewhere; on
    // Windows its own bsdtar writes one, as the package's Python zipfile does).
    mut made := false
    if os_name() == "windows" {
        r := try os.command(system32() + "/tar.exe", ["-a", "-c", "-f", dir + "/p.zip", "-C", dir + "/src", "Flint.app"])
        made = r.exit_code == 0
    } else if os_name() == "mac" {
        r := try os.command("ditto", ["-c", "-k", "--keepParent", dir + "/src/Flint.app", dir + "/p.zip"])
        made = r.exit_code == 0
    } else {
        r := os.command("sh", ["-c", "cd \"$1\" && zip -qr \"$2\" Flint.app", "sh", dir + "/src", dir + "/p.zip"]) or {
            println("SKIP: no zip on this machine")
            return
        }
        made = r.exit_code == 0
    }
    if !made {
        println("SKIP: could not make a zip here")
        return
    }
    try files.upd_unzip(dir + "/p.zip", dir + "/new")
    assert(files.upd_exists(dir + "/new/Flint.app/Contents/MacOS/Flint"))
    assert_eq(try files.upd_read(dir + "/new/Flint.app/Contents/MacOS/Flint"), "#!/bin/sh\necho flint\n")
    try files.upd_rename(dir + "/new/Flint.app", dir + "/Flint.app")
    assert(files.upd_exists(dir + "/Flint.app/Contents/MacOS/Flint"))
    assert(!files.upd_exists(dir + "/new/Flint.app"))
    mut r := ""
    files.upd_unzip(dir + "/none.zip", dir + "/x") or err { r = "{err.message()}" }
    assert(r.starts_with("io:"))
    try files.upd_remove(dir + "/Flint.app")
    assert(!files.upd_exists(dir + "/Flint.app"))
    // A file goes as a folder does (nftw alone refuses a file on macOS).
    try files.upd_write(dir + "/ready", "0.18.0")
    try files.upd_remove(dir + "/ready")
    assert(!files.upd_exists(dir + "/ready"))
    // Removing what is not there is quiet.
    try files.upd_remove(dir + "/Flint.app")
}

test "a detached process is started, seen inside its folder, and stopped" {
    dir := update_tmp("procs")
    mut files := new_os_update_files()
    defer { files.upd_remove(dir) or {} }
    try files.upd_mkdir(dir + "/bin")
    // A copy of sleep inside the folder: what update-apply waits for (Windows: ping,
    // which waits a second between echoes).
    mut pid: i64 = 0
    mut procs := new_os_update_processes()
    if os_name() == "windows" {
        try files.upd_copy_exe(system32() + "/PING.EXE", dir + "/bin/ping.exe")
        pid = try procs.proc_spawn(dir + "/bin/ping.exe", ["-n", "30", "127.0.0.1"], dir + "/log.txt")
    } else {
        try files.upd_copy_exe("/bin/sleep", dir + "/bin/sleep")
        pid = try procs.proc_spawn(dir + "/bin/sleep", ["30"], dir + "/log.txt")
    }
    assert(pid > 0)
    assert(procs.proc_alive(pid))
    mut seen: []i64 = []
    for _ in 0..50 {
        seen = procs.proc_running_under(dir)
        if seen.len() > 0 {
            break
        }
        procs.proc_sleep(100)
    }
    assert_eq(seen.len(), 1)
    assert_eq(seen[0], pid)
    assert_eq(procs.proc_running_under(dir + "/bin/other").len(), 0)
    procs.proc_stop(pid)
    assert(!procs.proc_alive(pid))
    assert_eq(procs.proc_running_under(dir).len(), 0)
    bad := procs.proc_spawn(dir + "/none", [], "") or -1
    assert_eq(bad, -1)
    assert(current_pid() > 0)
}

// Windows (milestone 50, D-118 (5)): what holds a folder there. A file open without
// FILE_SHARE_DELETE inside it refuses the rename; let go, the rename goes through. A
// program running from it does not. update-apply never writes over a file in use.
test "Windows: a folder with a file held open, or a program running from it, cannot be renamed until let go" {
    if os_name() != "windows" {
        return
    }
    dir := update_tmp("held")
    mut files := new_os_update_files()
    defer { files.upd_remove(dir) or {} }
    try files.upd_mkdir(dir + "/Flint/bin")
    try files.upd_write(dir + "/Flint/ui.txt", "page")
    held := dir + "/Flint/ui.txt"
    mut handle: i64 = 0
    // CFIRE-UPSTREAM: CF-175
    cpp {
        #if defined(_WIN32)
        HANDLE h = ::CreateFileW(flint_update::upd_widen(held).c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr,
                                 OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
        handle = h == INVALID_HANDLE_VALUE ? 0 : reinterpret_cast<std::int64_t>(h);
        #endif
    }
    assert(handle != 0)
    mut why := ""
    files.upd_rename(dir + "/Flint", dir + "/Flint-old") or err { why = "{err.message()}" }
    assert(why.starts_with("io:"))
    assert(files.upd_exists(dir + "/Flint/ui.txt"))
    // CFIRE-UPSTREAM: CF-175
    cpp {
        #if defined(_WIN32)
        ::CloseHandle(reinterpret_cast<HANDLE>(handle));
        #endif
    }
    try files.upd_rename(dir + "/Flint", dir + "/Flint-old")
    try files.upd_rename(dir + "/Flint-old", dir + "/Flint")
    // A program started from the folder holds it while it runs: Windows 11 would let the
    // folder of a running image be renamed (milestone 50), but proc_spawn starts it with
    // its own folder as its current directory (v0.30.1, CF-187), and that folder cannot
    // be renamed. update-apply waits for every `flint` from the folder
    // (proc_running_under) before it renames anything, so this never stops a swap.
    try files.upd_copy_exe(system32() + "/PING.EXE", dir + "/Flint/bin/flint.exe")
    mut procs := new_os_update_processes()
    pid := try procs.proc_spawn(dir + "/Flint/bin/flint.exe", ["-n", "30", "127.0.0.1"], "")
    mut seen: []i64 = []
    for _ in 0..50 {
        seen = procs.proc_running_under(dir + "/Flint")
        if seen.len() > 0 {
            break
        }
        procs.proc_sleep(100)
    }
    assert_eq(seen.len(), 1)
    assert_eq(seen[0], pid)
    mut held_why := ""
    files.upd_rename(dir + "/Flint", dir + "/Flint-old") or err { held_why = err.message() }
    assert(held_why.starts_with("io:"))
    procs.proc_stop(pid)
    assert(!procs.proc_alive(pid))
    // Let go once it ends; Windows may take a moment to close the process's handles.
    mut moved := false
    for _ in 0..50 {
        files.upd_rename(dir + "/Flint", dir + "/Flint-old") or {
            procs.proc_sleep(100)
            continue
        }
        moved = true
        break
    }
    assert(moved)
    assert(files.upd_exists(dir + "/Flint-old/bin/flint.exe"))
}

test "Windows: arguments reach a detached program as given, and its output the log" {
    if os_name() != "windows" {
        return
    }
    dir := update_tmp("args")
    mut files := new_os_update_files()
    defer { files.upd_remove(dir) or {} }
    try files.upd_mkdir(dir + "/a b")
    mut procs := new_os_update_processes()
    log := dir + "/a b/log.txt"
    // cmd's own parser differs from the C runtime's; findstr reads its arguments the
    // C runtime's way: a pattern with a space and a quote, found in a file whose path
    // has a space.
    try files.upd_write(dir + "/a b/in.txt", "one\nsay \"hi there\"\nthree\n")
    pid := try procs.proc_spawn(system32() + "/findstr.exe", ["/C:say \"hi there\"", dir + "/a b/in.txt"], log)
    for _ in 0..50 {
        if !procs.proc_alive(pid) {
            break
        }
        procs.proc_sleep(100)
    }
    assert(!procs.proc_alive(pid))
    out := try files.upd_read(log)
    assert(out.contains("say \"hi there\""))
    assert(!out.contains("three"))
}

// Windows (milestone 65, CF-190): the Restart Manager names who holds a file in the
// folder: a PowerShell that keeps one open, by its pid. Elsewhere nobody is named.
test "the programs that hold a file in the folder are named on Windows, nobody elsewhere" {
    dir := update_tmp("holders")
    mut files := new_os_update_files()
    defer { files.upd_remove(dir) or {} }
    try files.upd_mkdir(dir + "/Flint")
    try files.upd_write(dir + "/Flint/ui.txt", "page")
    mut procs := new_os_update_processes()
    if os_name() != "windows" {
        assert_eq(procs.proc_holders(dir + "/Flint").len(), 0)
        return
    }
    assert_eq(procs.proc_holders(dir + "/Flint").len(), 0)
    held := (dir + "/Flint/ui.txt").replace("/", "\\")
    ps := system32() + "/WindowsPowerShell/v1.0/powershell.exe"
    pid := try procs.proc_spawn(ps, ["-NoProfile", "-Command", "$f = [IO.File]::Open('{held}', 'Open', 'Read', 'Read'); Start-Sleep 30"], "")
    defer { procs.proc_stop(pid) }
    mut seen: []FolderHolder = []
    for _ in 0..100 {
        seen = procs.proc_holders(dir + "/Flint")
        if seen.len() > 0 {
            break
        }
        procs.proc_sleep(100)
    }
    assert_eq(seen.len(), 1)
    assert_eq(seen[0].pid, pid)
    assert(seen[0].name.len() > 0)
    write_stderr("holders: {seen[0].name} (pid {seen[0].pid})\n")
}
