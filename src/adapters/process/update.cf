package process

// The self-update's files and processes on this machine (milestone 53): the
// `UpdateFiles` and `UpdateProcesses` ports. Files through core:fs, a zip through the
// system's own tool (macOS `ditto`, which keeps the bundle's links, modes and ad-hoc
// signature; `unzip` on Linux; `tar` on Windows, milestone 50), and the processes in
// native/flint_update.hpp (CF-175).

// CFIRE-UPSTREAM: CF-175, CF-187
import cpp "flint_update.hpp"

import "core:fs"
import "core:os"
import "core:time"
import "../../domain"

type OsUpdateFiles struct {
    ready: bool
}

fn new_os_update_files() -> OsUpdateFiles {
    return OsUpdateFiles{ ready: true }
}

fn (self: OsUpdateFiles) upd_exists(path: str) -> bool {
    return fs.exists(path)
}

fn (self: OsUpdateFiles) upd_read(path: str) -> str! {
    return fs.read_text(path) or err {
        return error(coded(ERR_IO, "cannot read {path}: {err.message()}"))
    }
}

fn (mut self: OsUpdateFiles) upd_mkdir(path: str) -> void! {
    fs.mkdir_all(path) or err {
        return error(coded(ERR_IO, "cannot create {path}: {err.message()}"))
    }
}

fn (mut self: OsUpdateFiles) upd_remove(path: str) -> void! {
    if !fs.exists(path) {
        return
    }
    mut ok := false
    mut why := ""
    // CFIRE-UPSTREAM: CF-158
    cpp {
        ok = flint_update::upd_remove_tree(path, why);
    }
    if !ok {
        return error(coded(ERR_IO, "cannot remove {path}: {why}"))
    }
}

fn (mut self: OsUpdateFiles) upd_rename(from: str, to: str) -> void! {
    mut ok := false
    mut why := ""
    // CFIRE-UPSTREAM: CF-158
    cpp {
        ok = flint_update::upd_rename_path(from, to, why);
    }
    if !ok {
        return error(coded(ERR_IO, "cannot move {from} to {to}: {why}"))
    }
}

fn (mut self: OsUpdateFiles) upd_write(path: str, text: str) -> void! {
    fs.write_text(path, text) or err {
        return error(coded(ERR_IO, "cannot write {path}: {err.message()}"))
    }
}

fn (mut self: OsUpdateFiles) upd_unzip(zip: str, dest: str) -> void! {
    fs.mkdir_all(dest) or err {
        return error(coded(ERR_IO, "cannot create {dest}: {err.message()}"))
    }
    mut cmd := "unzip"
    mut args: []str = ["-q", "-o", zip, "-d", dest]
    if os_name() == "mac" {
        cmd = "ditto"
        args = ["-x", "-k", zip, dest]
    } else if os_name() == "windows" {
        // Windows' own bsdtar, which reads a zip; an MSYS2 or Git tar earlier on the
        // PATH is GNU tar, which does not (milestone 50).
        mut root := (os.getenv("SystemRoot") or "")
        if root.len() == 0 {
            root = "C:/Windows"
        }
        cmd = local_slashes(root) + "/System32/tar.exe"
        args = ["-x", "-f", zip, "-C", dest]
    }
    r := os.command(cmd, args) or err {
        return error(coded(ERR_IO, "cannot unpack the update ({cmd}): {err.message()}"))
    }
    if r.exit_code != 0 {
        return error(coded(ERR_IO, "cannot unpack the update ({cmd} exited {r.exit_code}: {r.stderr.trim()})"))
    }
}

fn (mut self: OsUpdateFiles) upd_copy_exe(from: str, to: str) -> void! {
    fs.copy_file(from, to) or err {
        return error(coded(ERR_IO, "cannot copy {from}: {err.message()}"))
    }
    mut ok := false
    // CFIRE-UPSTREAM: CF-175
    cpp {
        ok = flint_update::upd_make_executable(to);
    }
    if !ok {
        return error(coded(ERR_IO, "cannot make {to} executable"))
    }
}

// The `UpdateSigner` port (milestone 79, D-158 (3)): a bundle's code signature through
// macOS's own `codesign`, arguments one by one, never a shell. `-dv` names the Team ID
// (`TeamIdentifier=not set` when ad hoc); `--verify --deep --strict` says whether every
// file still matches it. Linux and Windows packages carry no signature Flint checks
// (Windows signing waits, D-157): every folder reads as valid and unsigned there.
type OsUpdateSigner struct {
    ready: bool
}

fn new_os_update_signer() -> OsUpdateSigner {
    return OsUpdateSigner{ ready: true }
}

fn (self: OsUpdateSigner) upd_signer(root: str) -> domain.CodeSignature {
    if os_name() != "mac" {
        return domain.CodeSignature{ team: "", valid: true }
    }
    mut team := ""
    shown := os.command("/usr/bin/codesign", ["-dv", "--verbose=2", root]) or {
        return domain.CodeSignature{ team: "", valid: false }
    }
    for line in "{shown.stderr}\n{shown.stdout}".split("\n") {
        l := line.trim()
        if l.starts_with("TeamIdentifier=") {
            v := "{l[15..]}"
            if v != "not set" {
                team = v
            }
        }
    }
    checked := os.command("/usr/bin/codesign", ["--verify", "--deep", "--strict", root]) or {
        return domain.CodeSignature{ team: team, valid: false }
    }
    return domain.CodeSignature{ team: team, valid: shown.exit_code == 0 && checked.exit_code == 0 }
}

// Leaves whatever folder this process started in for `dir` (its own). update-apply
// inherits the app's current directory, which on Windows is the installed folder when
// the app was opened from its Start menu shortcut, and Windows does not rename a folder
// that is a process's current directory (error 32).
fn set_working_dir(dir: str) -> void! {
    mut ok := false
    // CFIRE-UPSTREAM: CF-187
    cpp {
        ok = flint_update::upd_set_cwd(dir);
    }
    if !ok {
        return error(coded(ERR_IO, "cannot change the current directory to {dir}"))
    }
}

type OsUpdateProcesses struct {
    ready: bool
}

fn new_os_update_processes() -> OsUpdateProcesses {
    return OsUpdateProcesses{ ready: true }
}

fn (self: OsUpdateProcesses) proc_alive(pid: i64) -> bool {
    mut on := false
    // CFIRE-UPSTREAM: CF-175
    cpp {
        on = flint_update::upd_alive(pid);
    }
    return on
}

// The folder is compared as its real path: the processes report theirs.
fn (self: OsUpdateProcesses) proc_running_under(dir: str) -> []i64 {
    mut joined := ""
    // CFIRE-UPSTREAM: CF-158, CF-175
    cpp {
        for (auto p : flint_update::upd_running_under(flint_update::upd_real_path(dir))) {
            joined += std::to_string(p);
            joined += ",";
        }
    }
    mut out: []i64 = []
    for part in joined.split(",") {
        if n := i64.parse(part) {
            out.push(n)
        }
    }
    return out
}

// Who holds a file open in `dir` (milestone 65, Windows' Restart Manager, CF-190);
// none on macOS and Linux, and none when the query fails.
fn (self: OsUpdateProcesses) proc_holders(dir: str) -> []domain.FolderHolder {
    mut lines := ""
    // CFIRE-UPSTREAM: CF-190
    cpp {
        lines = flint_update::upd_holders(dir);
    }
    return parse_folder_holders(lines)
}

// Why the last proc_holders named nobody (Windows; for a test's diagnosis).
fn holders_diag() -> str {
    mut d := ""
    // CFIRE-UPSTREAM: CF-190
    cpp {
        d = flint_update::upd_holders_diag();
    }
    return d
}

// Arguments go one by one, never through a shell.
fn (mut self: OsUpdateProcesses) proc_spawn(exe: str, args: []str, log: str) -> i64! {
    mut packed := ""
    for a in args {
        packed = packed + a + "\u{1f}"
    }
    mut pid: i64 = 0
    // CFIRE-UPSTREAM: CF-175
    cpp {
        std::vector<std::string> argv;
        std::string cur;
        for (char ch : packed) {
            if (ch == '\x1f') { argv.push_back(cur); cur.clear(); } else { cur += ch; }
        }
        pid = flint_update::upd_spawn_detached(exe, argv, log);
    }
    if pid <= 0 {
        return error(coded(ERR_IO, "cannot start {exe} (error {-pid})"))
    }
    return pid
}

fn (mut self: OsUpdateProcesses) proc_stop(pid: i64) {
    // CFIRE-UPSTREAM: CF-175
    cpp {
        flint_update::upd_stop(pid);
    }
}

fn (mut self: OsUpdateProcesses) proc_sleep(ms: i64) {
    time.sleep_ms(ms)
}

fn (self: OsUpdateProcesses) proc_now_ms() -> i64 {
    return time.now_ms()
}

// This process's id: update-apply waits for it to quit.
fn current_pid() -> i64 {
    mut pid: i64 = 0
    // CFIRE-UPSTREAM: CF-175
    cpp {
        #if defined(_WIN32)
        pid = static_cast<std::int64_t>(::GetCurrentProcessId());
        #else
        pid = static_cast<std::int64_t>(::getpid());
        #endif
    }
    return pid
}

// A temporary folder of this machine's (TMPDIR, TEMP, or /tmp).
fn temp_base() -> str {
    for name in ["TMPDIR", "TEMP", "TMP"] {
        v := (os.getenv(name) or "")
        if v.len() > 0 {
            return local_slashes("{v.trim_end()}").replace_all("//", "/")
        }
    }
    return "/tmp"
}

// ---- The Linux package update (milestone 54, D-124) -------------------------------

// The app's side: `pkexec <helper>` (the `RootRunner` port) and the package manager
// asked where Flint came from (`PackageSourceProbe`). Absolute paths: nothing here is
// found through PATH.
PKEXEC_PATH: str = "/usr/bin/pkexec"
// How long asking apt or dnf where Flint came from may take, at launch.
PACKAGE_SOURCE_TIMEOUT_S: str = "15"

type OsRootRunner struct {
    pkexec: str
}

fn new_os_root_runner() -> OsRootRunner {
    return OsRootRunner{ pkexec: PKEXEC_PATH }
}

// Waits for the person's answer in polkit's dialog and for apt or dnf: no deadline of
// its own (the helper bounds the package manager, Principle 8).
fn (mut self: OsRootRunner) run_root_helper(helper: str) -> domain.RootRun! {
    if !fs.exists(self.pkexec) {
        return error(coded(ERR_UNSUPPORTED, "pkexec is not installed, so Flint cannot ask for the system password: install the update with your package manager"))
    }
    res := os.command(self.pkexec, [helper]) or err {
        return error(coded(ERR_IO, "pkexec could not be started: {err.message()}"))
    }
    if res.stderr.trim().len() > 0 {
        write_stderr("flint-gui: {helper}: {res.stderr.trim()}\n")
    }
    return domain.RootRun{ exit_code: res.exit_code, stdout: res.stdout }
}

type OsPackageSourceProbe struct {
    ready: bool
}

fn new_os_package_source_probe() -> OsPackageSourceProbe {
    return OsPackageSourceProbe{ ready: true }
}

fn (self: OsPackageSourceProbe) package_source_text(format: str) -> str {
    mut args: []str = [PACKAGE_SOURCE_TIMEOUT_S, "/usr/bin/apt-cache", "policy", "flint"]
    if format == PACKAGE_RPM {
        // -C: from the cache only, never a metadata download at launch.
        args = [PACKAGE_SOURCE_TIMEOUT_S, "/usr/bin/dnf", "-C", "-q", "info", "--installed", "flint"]
    }
    if !fs.exists("/usr/bin/timeout") || !fs.exists(args[1]) {
        return ""
    }
    res := os.command("/usr/bin/timeout", args) or {
        return ""
    }
    return res.stdout
}
