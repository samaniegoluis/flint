package process

// Process plumbing for the CLI driver: argv, stdout/stderr, exit codes, terminal
// prompts, and the local side of an SSH session (raw mode, resizes, byte I/O). What
// core:os covers is used directly; the rest is in native/flint_process.hpp (CF-024).

// CFIRE-UPSTREAM: CF-024, CF-031
import cpp "flint_process.hpp" @pkg("flint-native")

import "core:os"
import "core:str"
import "core:time"
import "../../domain"

// Command-line arguments after the program name.
fn process_args() -> []str {
    all := os.args()
    mut list: []str = []
    for i in 1..all.len() {
        list.push(all[i])
    }
    return list
}

// Writes `s` to stderr as is (no newline added).
// The folder of the running executable ("" when unknown): the GUI finds its page
// next to it, or in the app bundle's Resources.
fn executable_dir() -> str {
    mut dir := ""
    // CFIRE-UPSTREAM: CF-024
    cpp {
        dir = flint_proc::executable_dir();
    }
    return dir
}

// "mac" or "linux": the keyboard map and window chrome differ (CF-031).
fn os_name() -> str {
    mut name := ""
    // CFIRE-UPSTREAM: CF-031
    cpp {
        name = flint_proc::os_name();
    }
    return name
}

fn write_stderr(s: str) {
    // CFIRE-UPSTREAM: CF-024
    cpp {
        flint_proc::write_err(s);
    }
}

// Writes `s` to stdout as is (no newline added).
fn write_stdout(s: str) {
    // CFIRE-UPSTREAM: CF-024
    cpp {
        flint_proc::write_out(s);
    }
}

// From here until capture_end, this thread's stdout and stderr writes are kept, it
// has no terminal and an empty stdin, and `current_dir()` is `cwd`: the app runs a
// CLI command for a client on its socket this way (D-038).
fn capture_begin(cwd: str) {
    // CFIRE-UPSTREAM: CF-024
    cpp {
        flint_proc::capture_begin(cwd);
    }
}

// Ends this thread's capture and returns (stdout, stderr).
fn capture_end() -> (str, str) {
    mut o := ""
    mut e := ""
    // CFIRE-UPSTREAM: CF-024
    cpp {
        flint_proc::capture_end(o, e);
    }
    return (o, e)
}

// The working directory: the client's during a capture, else the process's.
fn current_dir() -> str {
    mut dir := ""
    mut captured := false
    // CFIRE-UPSTREAM: CF-024
    cpp {
        if (auto* c = flint_proc::capture_slot()) {
            dir = c->cwd;
            captured = true;
        }
    }
    if captured {
        return dir
    }
    here: str = os.cwd()
    if os_name() == "windows" {
        // One form for local paths on Windows: `/` separators (windows-port).
        return str.replace(here, "\\", "/")
    }
    return here
}

// Flushes stdout and stderr and ends the process with `code`.
fn exit_process(code: i32) {
    os.exit(code)
}

fn stdin_is_terminal() -> bool {
    mut captured := false
    // CFIRE-UPSTREAM: CF-024
    cpp {
        captured = flint_proc::capturing();
    }
    if captured {
        return false
    }
    return os.is_tty()
}

// True when the process has a controlling terminal to prompt on.
fn has_terminal() -> bool {
    mut tty := false
    // CFIRE-UPSTREAM: CF-024
    cpp {
        tty = flint_proc::has_tty();
    }
    return tty
}

fn read_stdin_text() -> str {
    mut data := ""
    // CFIRE-UPSTREAM: CF-024
    cpp {
        data = flint_proc::read_stdin_all();
    }
    return data
}

// Prompts on the terminal and reads one line with echo off.
fn read_secret_line(prompt: str) -> str! {
    mut line := ""
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-024
    cpp {
        rc = flint_proc::read_secret_tty(prompt, line);
    }
    if rc != 0 {
        return error("usage: no terminal to prompt on; pass the secret on stdin")
    }
    return line
}

// Prompts on the terminal and reads one line with echo on.
fn read_tty_line(prompt: str) -> str! {
    mut line := ""
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-024
    cpp {
        rc = flint_proc::read_line_tty(prompt, line);
    }
    if rc != 0 {
        return error("usage: no terminal to prompt on")
    }
    return line
}

// ---- Ports for SSH sessions ----------------------------------------------------

// The `Prompter` port on /dev/tty.
type TtyPrompter struct {
    enabled: bool
}

fn new_tty_prompter() -> TtyPrompter {
    return TtyPrompter{ enabled: has_terminal() }
}

fn (self: TtyPrompter) prompt_available() -> bool {
    return self.enabled
}

// Only "yes" or "y" (any case) confirms.
fn (self: TtyPrompter) prompt_host_key(q: HostKeyQuestion) -> bool! {
    if !self.enabled {
        return error(coded(ERR_USAGE, "no terminal to confirm on"))
    }
    answer := try read_tty_line("The host '{q.alias}' ({q.addr}) is not known yet.\n{q.key_type} key fingerprint is {q.fingerprint}.\nTrust this key and continue connecting (yes/no)? ")
    a := str_trim_spaces(answer)
    return a == "yes" || a == "y" || a == "YES" || a == "Yes" || a == "Y"
}

// The CLI reports a changed key through the error that follows.
fn (self: TtyPrompter) host_key_changed(q: HostKeyQuestion) {
}

fn (self: TtyPrompter) prompt_password(user: str, alias: str) -> str! {
    if !self.enabled {
        return error(coded(ERR_USAGE, "no terminal to prompt on"))
    }
    return read_secret_line("{user}@{alias}'s password: ")
}

// The `Terminal` port on stdin/stdout.
type StdioTerminal struct {
    ready: bool
}

fn new_stdio_terminal() -> StdioTerminal {
    return StdioTerminal{ ready: true }
}

fn (self: StdioTerminal) term_size() -> TerminalSize {
    mut cols: i32 = 0
    mut rows: i32 = 0
    // CFIRE-UPSTREAM: CF-042
    cpp {
        int c = 0, r = 0;
        flint_proc::window_size(c, r);
        cols = c;
        rows = r;
    }
    return TerminalSize{ cols: cols, rows: rows }
}

fn (mut self: StdioTerminal) term_raw_enter() -> void! {
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-042
    cpp {
        rc = flint_proc::raw_enter();
    }
    if rc != 0 {
        return error(coded(ERR_IO, "cannot put the terminal in raw mode"))
    }
}

fn (mut self: StdioTerminal) term_raw_leave() {
    // CFIRE-UPSTREAM: CF-042
    cpp {
        flint_proc::raw_restore();
    }
}

fn (mut self: StdioTerminal) term_input(timeout_ms: i32) -> str! {
    mut data := ""
    mut open_input := true
    // CFIRE-UPSTREAM: CF-042
    cpp {
        open_input = flint_proc::read_input(timeout_ms, data);
    }
    if !open_input {
        return error(coded(ERR_IO, "end of input"))
    }
    return data
}

fn (mut self: StdioTerminal) term_output(data: str) {
    // CFIRE-UPSTREAM: CF-042
    cpp {
        flint_proc::write_fd(STDOUT_FILENO, data);
    }
}

fn (mut self: StdioTerminal) term_take_resize() -> bool {
    mut changed := false
    // CFIRE-UPSTREAM: CF-042
    cpp {
        changed = flint_proc::take_winch();
    }
    return changed
}

// The `ExecSink` port: remote stdout to stdout, remote stderr to stderr, as is.
type StdioExecSink struct {
    ready: bool
}

fn new_stdio_exec_sink() -> StdioExecSink {
    return StdioExecSink{ ready: true }
}

fn (mut self: StdioExecSink) exec_stdout(data: str) {
    // CFIRE-UPSTREAM: CF-042
    cpp {
        flint_proc::write_fd(STDOUT_FILENO, data);
    }
}

fn (mut self: StdioExecSink) exec_stderr(data: str) {
    // CFIRE-UPSTREAM: CF-042
    cpp {
        flint_proc::write_fd(STDERR_FILENO, data);
    }
}

// The `Clock` port.
type SystemClock struct {
    ready: bool
}

fn new_system_clock() -> SystemClock {
    return SystemClock{ ready: true }
}

fn (mut self: SystemClock) clock_now_ms() -> i64 {
    return time.now_ms()
}

// Whether stderr is a terminal (progress is drawn only there). False while a served
// command's output is captured.
fn stderr_is_terminal() -> bool {
    mut tty := false
    // CFIRE-UPSTREAM: CF-024
    cpp {
        tty = !flint_proc::capturing() && isatty(STDERR_FILENO) == 1;
    }
    return tty
}

// Draws a copy's progress on stderr (milestone 16): one line per file, redrawn in
// place at most ten times a second and ended once the file is complete. Silent when
// stderr is not a terminal, or with --json.
type StderrTransferSink struct {
    on: bool
    last_ms: i64
    files_done: i64
}

fn new_stderr_transfer_sink(as_json: bool) -> StderrTransferSink {
    return StderrTransferSink{ on: !as_json && stderr_is_terminal(), last_ms: 0, files_done: 0 }
}

fn (mut self: StderrTransferSink) transfer_progress(p: TransferProgress) {
    if !self.on {
        return
    }
    now := time.now_ms()
    finished := p.files_done > self.files_done
    if !finished && p.file_bytes > 0 && p.file_bytes < p.file_size && now - self.last_ms < 100 {
        return
    }
    self.last_ms = now
    mut line := "\r" + progress_line(p) + "\x1b[K"
    if finished {
        self.files_done = p.files_done
        line = line + "\n"
    }
    write_stderr(line)
}

fn (self: StderrTransferSink) transfer_cancelled() -> bool {
    return false
}
