package process

import "../../ports"

test "argv is readable outside main" {
    // The test runner is started with no extra arguments, or with the suite path.
    args := process_args()
    assert(args.len() < 16)
}

test "stdin terminal detection does not crash" {
    _ = stdin_is_terminal()
    _ = has_terminal()
}

fn accepts_session_ports[P: ports.Prompter, M: ports.Terminal, O: ports.ExecSink, K: ports.Clock](_p: P, mut _m: M, mut _o: O, mut _k: K) -> bool {
    return true
}

test "the session adapters satisfy their ports" {
    mut term := new_stdio_terminal()
    mut sink := new_stdio_exec_sink()
    mut clock := new_system_clock()
    assert(accepts_session_ports(new_tty_prompter(), mut term, mut sink, mut clock))
}

test "the clock moves forward" {
    mut clock := new_system_clock()
    a := clock.clock_now_ms()
    b := clock.clock_now_ms()
    assert(b >= a)
    assert(a > 0)
}

test "a fresh terminal reports no pending resize" {
    mut term := new_stdio_terminal()
    assert(!term.term_take_resize())
}

test "the executable folder and OS name are known" {
    os := os_name()
    assert(os == "mac" || os == "linux" || os == "windows")
    // "C:/..." on Windows (windows-port).
    assert(executable_dir().starts_with("/") || (os == "windows" && domain.is_absolute_path(executable_dir())))
}

// Every `\` becomes `/` on Windows, not only the first (CF-151: 0.12's `.replace` is
// first-match): the file dialogs gave `C:/flint-work\tmp\...`, and the unlock screen
// named the vault after the whole path.
test "local paths on Windows take / at every separator" {
    if os_name() == "windows" {
        assert_eq(local_slashes("C:\\a\\b c\\v.flint"), "C:/a/b c/v.flint")
    } else {
        assert_eq(local_slashes("/a/b\\c"), "/a/b\\c")
    }
}
