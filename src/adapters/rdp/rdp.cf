package rdp

// The RemoteDesktop port over libfreerdp 3 (milestone 30, D-070), through a native
// shim (native/flint_rdp.hpp, CF-119). One tab per page id; frames reach the page
// through the tab's local frame channel (D-071).
//
// Connecting is bounded by an explicit timeout (Principle 8). Errors carry FreeRDP's
// error name, never the password (Principle 6). Only the desktop app imports this
// package, so the CLI never links FreeRDP.

// CFIRE-UPSTREAM: CF-119
import cpp "flint_rdp.hpp" @pkg("flint-rdp")
import "../../domain"
import "core:str"

// The engine. Stateless: the tabs live in the shim's registry.
type FreeRdpDesktop struct {
    unused: i64
}

fn new_freerdp_desktop() -> FreeRdpDesktop {
    return FreeRdpDesktop{ unused: 0 }
}

// The shim's result codes as the core's stable error codes.
fn rdp_error(code: i64, detail: str) -> str {
    if code == 1 {
        return coded(ERR_AUTH, "the server refused the user or password ({detail})")
    }
    if code == 2 {
        return coded(ERR_NETWORK, "could not reach the server ({detail})")
    }
    if code == 3 {
        return coded(ERR_TIMEOUT, "the server did not answer in time")
    }
    if code == 4 {
        return coded(ERR_REFUSED, "the server refused the connection ({detail})")
    }
    if code == 5 {
        return coded(ERR_NETWORK, "the secure connection failed ({detail})")
    }
    if code == 7 {
        return coded(ERR_NETWORK, "the session is closed")
    }
    if code == 8 {
        return coded(ERR_HOST_KEY, "the server's certificate is not the trusted one")
    }
    if code == 9 {
        return coded(ERR_REFUSED, "nothing answers on the Remote Desktop port: Remote Desktop may be off, or a firewall blocks it")
    }
    if code == 10 {
        return coded(ERR_NETWORK, "the connection was lost ({detail})")
    }
    if code == 11 {
        return coded(ERR_REFUSED, "the server ended the session: {detail}")
    }
    if code == 12 {
        return coded(ERR_INVALID, "unknown key '{detail}'")
    }
    if code == 13 {
        return coded(ERR_REFUSED, "the server offers only Standard RDP Security, where no certificate protects the password; Flint refuses it. Set the server to require SSL (TLS) or Network Level Authentication")
    }
    return coded(ERR_INTERNAL, "RDP failed ({detail})")
}

fn (self: FreeRdpDesktop) rd_open(tab: str, t: RdpTarget, timeout_ms: i64) -> RdpDesktop! {
    if t.hostname.len() == 0 || t.user.len() == 0 {
        return error(coded(ERR_INVALID, "an RDP host needs an address and a user"))
    }
    mut rc: i32 = 0
    mut detail := ""
    mut w: i32 = 0
    mut h: i32 = 0
    mut port: i32 = 0
    mut token := ""
    host := t.hostname
    user := t.user
    dom := t.domain
    trusted := t.trusted_fingerprint
    graphics := t.graphics
    rport := i32(t.port)
    rw := i32(t.width)
    rh := i32(t.height)
    layout := layout_text(t.monitors)
    // The password goes to the shim straight from the target, never through a local
    // copy here (milestone 36): the caller wipes the target's once this returns.
    // CFIRE-UPSTREAM: CF-119
    cpp {
        rc = flint_rdp::open(tab, host, rport, user, dom, t.password, rw, rh, trusted, graphics, layout, timeout_ms, w, h, port, token, detail);
    }
    if rc != 0 {
        return error(rdp_error(i64(rc), detail))
    }
    return RdpDesktop{ width: i64(w), height: i64(h), frame_port: i64(port), frame_token: token, graphics: graphics, rtt_ms: t.rtt_ms }
}

fn (self: FreeRdpDesktop) rd_presented_cert(tab: str) -> RdpCert {
    mut subject := ""
    mut issuer := ""
    mut fp := ""
    mut from := ""
    mut to := ""
    // CFIRE-UPSTREAM: CF-119
    cpp {
        flint_rdp::presented_cert(tab, subject, issuer, fp, from, to);
    }
    return RdpCert{ subject: subject, issuer: issuer, fingerprint: fp, valid_from: from, valid_to: to }
}

fn (self: FreeRdpDesktop) rd_resize(tab: str, width: i64, height: i64) -> void! {
    mut rc: i32 = 0
    w := i32(width)
    h := i32(height)
    // CFIRE-UPSTREAM: CF-119
    cpp {
        rc = flint_rdp::resize(tab, w, h);
    }
    if rc != 0 {
        return error(rdp_error(i64(rc), "resize"))
    }
}

// A layout as the shim reads it (milestone 38): "x,y,w,h,p;..." with the primary first.
fn layout_text(ms: []RdpMonitor) -> str {
    mut s := ""
    for i, m in ms {
        if i > 0 {
            s = s + ";"
        }
        mut p := "0"
        if m.primary {
            p = "1"
        }
        s = s + "{m.x},{m.y},{m.width},{m.height},{p}"
    }
    return s
}

// The shim's layout text back as monitors; the local ids are not the shim's, so they
// are left empty (the core keeps them where it needs them).
fn parse_layout_text(s: str) -> []RdpMonitor {
    mut res: []RdpMonitor = []
    if s.len() == 0 {
        return res
    }
    for part in str.split(s, ";") {
        f := str.split(part, ",")
        if f.len() != 5 {
            return []
        }
        x := str.parse_i64(f[0]) or { return [] }
        y := str.parse_i64(f[1]) or { return [] }
        w := str.parse_i64(f[2]) or { return [] }
        h := str.parse_i64(f[3]) or { return [] }
        res.push(RdpMonitor{ local_id: "", x: x, y: y, width: w, height: h, primary: f[4] == "1" })
    }
    return res
}

fn (self: FreeRdpDesktop) rd_set_layout(tab: str, monitors: []RdpMonitor) -> void! {
    try check_rdp_layout(monitors)
    mut rc: i32 = 0
    layout := layout_text(monitors)
    // CFIRE-UPSTREAM: CF-119
    cpp {
        rc = flint_rdp::set_layout(tab, layout);
    }
    if rc != 0 {
        return error(rdp_error(i64(rc), "layout"))
    }
}

fn (self: FreeRdpDesktop) rd_wait(tab: str, wait_ms: i64) -> RdpEvent {
    mut kind: i32 = 0
    mut code: i32 = 0
    mut detail := ""
    mut w: i32 = 0
    mut h: i32 = 0
    mut layout := ""
    // CFIRE-UPSTREAM: CF-119
    cpp {
        kind = flint_rdp::wait(tab, wait_ms, code, detail, w, h, layout);
    }
    if kind == 1 {
        mut msg := ""
        if code != 0 {
            msg = rdp_error(i64(code), detail)
        }
        return RdpEvent{ kind: RDP_EVENT_ENDED, message: msg, width: 0, height: 0 }
    }
    if kind == 2 {
        return RdpEvent{ kind: RDP_EVENT_RESIZE, message: "", width: i64(w), height: i64(h), monitors: parse_layout_text(layout) }
    }
    if kind == 3 {
        return RdpEvent{ kind: RDP_EVENT_CLIP_TEXT, message: detail, width: 0, height: 0 }
    }
    if kind == 4 {
        return RdpEvent{ kind: RDP_EVENT_CLIP_REQUEST, message: "", width: 0, height: 0 }
    }
    if kind == 5 {
        return RdpEvent{ kind: RDP_EVENT_GRAPHICS, message: detail, width: i64(w), height: i64(h), monitors: parse_layout_text(layout) }
    }
    return RdpEvent{ kind: RDP_EVENT_RUNNING, message: "", width: 0, height: 0 }
}

fn (self: FreeRdpDesktop) rd_clip_announce(tab: str, has_text: bool) -> void! {
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-119
    cpp {
        rc = flint_rdp::clip_announce(tab, has_text);
    }
    if rc != 0 {
        return error(rdp_error(i64(rc), "clipboard"))
    }
}

