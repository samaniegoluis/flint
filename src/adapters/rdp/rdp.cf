fn (self: FreeRdpDesktop) rd_key(tab: str, code: str, down: bool) -> void! {
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-119
    cpp {
        rc = flint_rdp::key(tab, code, down);
    }
    if rc != 0 {
        return error(rdp_error(i64(rc), code))
    }
}

fn pointer_kind(kind: str) -> i32 {
    if kind == "down" {
        return 1
    }
    if kind == "up" {
        return 2
    }
    if kind == "wheel" {
        return 3
    }
    if kind == "hwheel" {
        return 4
    }
    return 0
}

fn (self: FreeRdpDesktop) rd_pointer(tab: str, p: RdpPointer) -> void! {
    mut rc: i32 = 0
    kind := pointer_kind(p.kind)
    button := i32(p.button)
    x := i32(p.x)
    y := i32(p.y)
    delta := i32(p.delta)
    // CFIRE-UPSTREAM: CF-119
    cpp {
        rc = flint_rdp::pointer(tab, kind, button, x, y, delta);
    }
    if rc != 0 {
        return error(rdp_error(i64(rc), "pointer"))
    }
}

fn (self: FreeRdpDesktop) rd_stats(tab: str) -> RdpStats! {
    mut rc: i32 = 0
    mut updates: i64 = 0
    mut bytes_in: i64 = 0
    mut commands: i64 = 0
    mut decode_us: i64 = 0
    mut frames_read: i64 = 0
    mut pipeline := ""
    mut codec := ""
    mut h264 := false
    mut rereads: i64 = 0
    mut stale_px: i64 = 0
    mut link_kbps: i64 = 0
    mut link_rtt_ms: i64 = 0
    mut mode := ""
    // CFIRE-UPSTREAM: CF-119
    cpp {
        rc = flint_rdp::stats(tab, updates, bytes_in, commands, decode_us, frames_read, pipeline, codec, h264, rereads, stale_px, link_kbps, link_rtt_ms, mode);
    }
    if rc != 0 {
        return error(rdp_error(i64(rc), "stats"))
    }
    return RdpStats{ updates: updates, bytes_in: bytes_in, commands: commands, decode_us: decode_us, frames_read: frames_read, pipeline: pipeline, codec: codec, h264: h264, rereads: rereads, stale_px: stale_px, link_kbps: link_kbps, link_rtt_ms: link_rtt_ms, mode: mode }
}

fn (self: FreeRdpDesktop) rd_probe_rtt(host: str, port: i64, timeout_ms: i64) -> i64 {
    mut ms: i64 = -1
    p := i32(port)
    // CFIRE-UPSTREAM: CF-119
    cpp {
        ms = flint_rdp::dial_rtt_ms(host, p, timeout_ms, 3);
    }
    return ms
}

fn (self: FreeRdpDesktop) rd_set_graphics(tab: str, graphics: str) -> void! {
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-119
    cpp {
        rc = flint_rdp::set_graphics(tab, graphics);
    }
    if rc != 0 {
        return error(rdp_error(i64(rc), "graphics"))
    }
}

fn (self: FreeRdpDesktop) rd_close(tab: str) {
    // CFIRE-UPSTREAM: CF-119
    cpp {
        flint_rdp::close(tab);
    }
}

// The tab's pending frame, waiting up to `wait_ms` (tests; the page reads the frame
// channel): a 16-byte header and RGBA rows, "" when nothing changed.
fn next_frame(tab: str, wait_ms: i64) -> str! {
    mut rc: i32 = 0
    mut frame := ""
    // CFIRE-UPSTREAM: CF-119
    cpp {
        rc = flint_rdp::next_frame(tab, wait_ms, frame);
    }
    if rc != 0 {
        return error(rdp_error(i64(rc), ""))
    }
    return frame
}

// View `view`'s pending frame (milestone 38), as next_frame.
fn next_frame_view(tab: str, view: i64, wait_ms: i64) -> str! {
    mut rc: i32 = 0
    mut frame := ""
    v := i32(view)
    // CFIRE-UPSTREAM: CF-119
    cpp {
        rc = flint_rdp::next_frame_view(tab, v, wait_ms, frame);
    }
    if rc != 0 {
        return error(rdp_error(i64(rc), "view"))
    }
    return frame
}

// The frame channel's view for a request's head (-1: unreadable).
fn frame_view(head: str) -> i64 {
    mut v: i32 = 0
    // CFIRE-UPSTREAM: CF-119
    cpp {
        v = flint_rdp::frame_view_of(head);
    }
    return i64(v)
}

// Ends every tab: the app is quitting.
fn close_all_desktops() {
    // CFIRE-UPSTREAM: CF-119
    cpp {
        flint_rdp::close_all();
    }
}

// FreeRDP's version, for Settings → About (milestone 32).
fn freerdp_version() -> str {
    mut v := ""
    // CFIRE-UPSTREAM: CF-119
    cpp {
        v = freerdp_get_version_string();
    }
    return v
}

// ---- For the tests (milestone 36) ---------------------------------------------------

// Whether tab `tab`'s last open also wiped FreeRDP's backup of the password.
fn creds_wiped(tab: str) -> bool {
    mut ok := false
    // CFIRE-UPSTREAM: CF-119
    cpp {
        ok = flint_rdp::creds_wiped(tab);
    }
    return ok
}

// A server on loopback that answers by choosing standard RDP security (a downgrade);
// returns its port, 0 when it could not start.
fn downgrade_server_start() -> i64 {
    mut port: i32 = 0
    // CFIRE-UPSTREAM: CF-119
    cpp {
        port = flint_rdp::downgrade_server_start();
    }
    return i64(port)
}

// What the downgrade server's client sent after the answer (-1: it never got there).
fn downgrade_server_result() -> i64 {
    mut n: i64 = 0
    // CFIRE-UPSTREAM: CF-119
    cpp {
        n = flint_rdp::downgrade_server_result();
    }
    return n
}

// The frame channel's verdict on a request's head: 0 authorised, 1 wrong or missing
// token, 2 wrong Host.
fn check_frame_request(head: str, token: str, port: i64) -> i64 {
    mut rc: i32 = 0
    p := i32(port)
    // CFIRE-UPSTREAM: CF-119
    cpp {
        rc = flint_rdp::check_frame_request(head, token, p);
    }
    return i64(rc)
}

// The CORS header the frame channel answers a request's head with ("" for none).
fn frame_cors(head: str) -> str {
    mut h := ""
    // CFIRE-UPSTREAM: CF-119
    cpp {
        h = flint_rdp::cors_for(head);
    }
    return h
}
