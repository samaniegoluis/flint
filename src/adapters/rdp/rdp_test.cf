package rdp

import "core:os"
import "core:str"
import "core:time"

// Two servers, each optional (a test passes without connecting when its server is not
// given):
// - FreeRDP's sample server on this machine, FLINT_RDP_SAMPLE_PORT (scripts/test.sh
//   starts one with a throwaway certificate): any user, no NLA, a test picture.
// - A real Windows host, FLINT_RDP_TEST_HOST, _USER and _PASSWORD (Infisical,
//   /ai-agents). Input sent there stays harmless: the person's own session may be on
//   the other side (ROADMAP).

fn sample_target(trusted: str) -> RdpTarget {
    port := os.getenv("FLINT_RDP_SAMPLE_PORT")
    mut p: i64 = 0
    if port.len() > 0 {
        p = str.parse_i64(port) or 0
    }
    return RdpTarget{ hostname: "127.0.0.1", port: p, user: "flint", domain: "", password: "sample", width: 1024, height: 768, trusted_fingerprint: trusted, graphics: "auto", rtt_ms: -1 }
}

fn live_target(trusted: str) -> RdpTarget {
    return RdpTarget{ hostname: os.getenv("FLINT_RDP_TEST_HOST"), port: 3389, user: os.getenv("FLINT_RDP_TEST_USER"), domain: "", password: os.getenv("FLINT_RDP_TEST_PASSWORD"), width: 1024, height: 768, trusted_fingerprint: trusted, graphics: "auto", rtt_ms: -1 }
}

// Connects once with nothing trusted, which stops at the certificate, and returns
// the certificate's fingerprint.
fn first_fingerprint(rd: FreeRdpDesktop, tab: str, t: RdpTarget) -> str {
    mut msg := ""
    rd.rd_open(tab, t, 15000) or err { msg = "{err.message()}" }
    assert(msg.starts_with("host_key:"), msg)
    return rd.rd_presented_cert(tab).fingerprint
}

fn wait_frame(tab: str) -> str {
    for i in 0..50 {
        frame := next_frame(tab, 200) or ""
        if frame.len() > 16 {
            return frame
        }
    }
    return ""
}

fn upper_hex(s: str) -> str {
    mut res := ""
    for b in s.bytes() {
        c := u8(b)
        if c >= 97 && c <= 102 {
            res = res + byte_to_str(c - 32)
        } else {
            res = res + byte_to_str(c)
        }
    }
    return res
}

fn le16(s: str, at: usize) -> i64 {
    b := s.bytes()
    return i64(u8(b[at])) + i64(u8(b[at + 1])) * 256
}

test "an address that never answers fails within the timeout" {
    rd := new_freerdp_desktop()
    // TEST-NET-1 (RFC 5737): routed nowhere, so the dial hangs until the timeout.
    t := RdpTarget{ hostname: "192.0.2.1", port: 3389, user: "nobody", domain: "", password: "never-sent", width: 800, height: 600, trusted_fingerprint: "", graphics: "auto", rtt_ms: -1 }
    started := time.now_ms()
    mut msg := ""
    rd.rd_open("t-dial", t, 1500) or err { msg = "{err.message()}" }
    rd.rd_close("t-dial")
    elapsed := time.now_ms() - started
    assert(msg.len() > 0, "the dial must fail")
    assert(elapsed < 6000, "took {elapsed} ms")
    assert(msg.starts_with("timeout:") || msg.starts_with("network:"), msg)
    assert(!msg.contains("never-sent"))
}

test "a closed port is told apart from an unreachable host" {
    rd := new_freerdp_desktop()
    // Port 9 (discard) is closed on loopback, so the dial is refused at once.
    t := RdpTarget{ hostname: "127.0.0.1", port: 9, user: "nobody", domain: "", password: "x", width: 800, height: 600, trusted_fingerprint: "", graphics: "auto", rtt_ms: -1 }
    mut msg := ""
    rd.rd_open("t-closed", t, 5000) or err { msg = "{err.message()}" }
    rd.rd_close("t-closed")
    assert(msg.starts_with("refused:"), msg)
}

test "an RDP target needs an address and a user" {
    rd := new_freerdp_desktop()
    mut msg := ""
    rd.rd_open("t-bad", RdpTarget{ hostname: "", port: 3389, user: "x", domain: "", password: "", width: 800, height: 600, trusted_fingerprint: "", graphics: "auto", rtt_ms: -1 }, 1000) or err { msg = "{err.message()}" }
    assert(msg.starts_with("invalid:"), msg)
}

test "the sample server's certificate is refused until trusted, then frames and a reconnect at a new size follow" {
    t := sample_target("")
    if t.port == 0 {
        return
    }
    rd := new_freerdp_desktop()
    fp := first_fingerprint(rd, "t-sample", t)
    assert_eq(fp.len(), 95)
    cert := rd.rd_presented_cert("t-sample")
    assert(cert.subject.contains("flint-test"), cert.subject)
    // Upper case is the same fingerprint.
    d := try rd.rd_open("t-sample", sample_target(upper_hex(fp)), 15000)
    defer rd.rd_close("t-sample")
    assert(d.frame_port > 0)
    assert_eq(d.frame_token.len(), 64)
    frame := wait_frame("t-sample")
    assert(frame.len() > 16, "no frame in 10 s")
    assert_eq(le16(frame, 12), d.width)
    assert_eq(le16(frame, 14), d.height)

    // The frame channel wants its token.
    bad := try os.command("curl", ["-s", "-o", "/dev/null", "-D", "-", "http://127.0.0.1:{d.frame_port}/next?t=nope"])
    assert(bad.stdout.starts_with("HTTP/1.1 403"), bad.stdout)
    good := try os.command("curl", ["-s", "-o", "/dev/null", "-D", "-", "-H", "Origin: app://localhost", "http://127.0.0.1:{d.frame_port}/next?t={d.frame_token}"])
    assert(good.stdout.starts_with("HTTP/1.1 200"), good.stdout)
    assert(good.stdout.contains("Access-Control-Allow-Origin: app://localhost"), good.stdout)
    // Milestone 36: a name rebound to 127.0.0.1 is refused even with the token, and
    // another web page gets no CORS header to read the answer with.
    rebound := try os.command("curl", ["-s", "-o", "/dev/null", "-D", "-", "-H", "Host: evil.example:{d.frame_port}", "http://127.0.0.1:{d.frame_port}/next?t={d.frame_token}"])
    assert(rebound.stdout.starts_with("HTTP/1.1 403"), rebound.stdout)
    foreign := try os.command("curl", ["-s", "-o", "/dev/null", "-D", "-", "-H", "Origin: https://evil.example", "http://127.0.0.1:{d.frame_port}/next?t={d.frame_token}"])
    assert(foreign.stdout.starts_with("HTTP/1.1 200"), foreign.stdout)
    assert(!foreign.stdout.contains("Access-Control-Allow-Origin"), foreign.stdout)

    // No Display Control here: the size is kept and reported for a reconnect, which
    // keeps the frame channel.
    try rd.rd_resize("t-sample", 800, 600)
    ev := rd.rd_wait("t-sample", 2000)
    assert_eq(ev.kind, "resize")
    assert_eq(ev.width, 800)
    d2 := try rd.rd_open("t-sample", sample_target(fp), 15000)
    assert_eq(d2.frame_port, d.frame_port)
    assert_eq(d2.frame_token, d.frame_token)
    // FreeRDP's backup of the settings lost the password too (milestone 36).
    assert(creds_wiped("t-sample"))
    assert_eq(rd.rd_wait("t-sample", 200).kind, "running")
    try rd.rd_pointer("t-sample", RdpPointer{ kind: "move", button: 0, x: 10, y: 10, delta: 0 })
    try rd.rd_key("t-sample", "ShiftLeft", true)
    try rd.rd_key("t-sample", "ShiftLeft", false)
    mut msg := ""
    rd.rd_key("t-sample", "NoSuchKey", true) or err { msg = "{err.message()}" }
    assert(msg.starts_with("invalid:"), msg)
}

test "a server that answers with standard RDP security is refused before any credential" {
    port := downgrade_server_start()
    assert(port > 0)
    rd := new_freerdp_desktop()
    t := RdpTarget{ hostname: "127.0.0.1", port: port, user: "nobody", domain: "", password: "downgrade-secret-4711", width: 800, height: 600, trusted_fingerprint: "", graphics: "auto", rtt_ms: -1 }
    mut msg := ""
    rd.rd_open("t-downgrade", t, 10000) or err { msg = "{err.message()}" }
    rd.rd_close("t-downgrade")
    assert(msg.len() > 0, "the connection must fail")
    assert(!msg.contains("downgrade-secret-4711"), msg)
    // Nothing follows the answer: no MCS connect, so no auto-logon password.
    assert_eq(downgrade_server_result(), 0)
}

test "the frame channel reads its token only from the request line and wants its own Host" {
    tok := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    ok := "GET /next?t={tok} HTTP/1.1\r\nHost: 127.0.0.1:5000\r\nOrigin: app://localhost"
    assert_eq(check_frame_request(ok, tok, 5000), 0)
    // Wrong port in Host, a rebound name, no Host.
    assert_eq(check_frame_request("GET /next?t={tok} HTTP/1.1\r\nHost: 127.0.0.1:5001", tok, 5000), 2)
    assert_eq(check_frame_request("GET /next?t={tok} HTTP/1.1\r\nHost: evil.example:5000", tok, 5000), 2)
    assert_eq(check_frame_request("GET /next?t={tok} HTTP/1.1", tok, 5000), 2)
    // The token in a header, not the request line.
    assert_eq(check_frame_request("GET /next HTTP/1.1\r\nHost: 127.0.0.1:5000\r\nX-A: t={tok}", tok, 5000), 1)
    // A prefix of the token, a longer one, another path, an empty channel token.
    assert_eq(check_frame_request("GET /next?t=abcd HTTP/1.1\r\nHost: 127.0.0.1:5000", tok, 5000), 1)
    assert_eq(check_frame_request("GET /next?t={tok}00 HTTP/1.1\r\nHost: 127.0.0.1:5000", tok, 5000), 1)
    assert_eq(check_frame_request("GET /other?t={tok} HTTP/1.1\r\nHost: 127.0.0.1:5000", tok, 5000), 1)
    assert_eq(check_frame_request("GET /next?t= HTTP/1.1\r\nHost: 127.0.0.1:5000", "", 5000), 1)
    // Header names in any case.
    assert_eq(check_frame_request("GET /next?t={tok} HTTP/1.1\r\nhost:127.0.0.1:5000", tok, 5000), 0)
}

test "the frame channel answers CORS only to pages on this machine" {
    assert_eq(frame_cors("GET / HTTP/1.1\r\nOrigin: app://localhost"), "Access-Control-Allow-Origin: app://localhost\r\nVary: Origin\r\n")
    assert(frame_cors("GET / HTTP/1.1\r\nOrigin: http://localhost:5173").len() > 0)
    assert(frame_cors("GET / HTTP/1.1\r\nOrigin: https://app.localhost").len() > 0)
    assert(frame_cors("GET / HTTP/1.1\r\nOrigin: http://127.0.0.1:8080").len() > 0)
    assert_eq(frame_cors("GET / HTTP/1.1\r\nOrigin: https://evil.example"), "")
    assert_eq(frame_cors("GET / HTTP/1.1\r\nOrigin: https://localhost.evil.example"), "")
    assert_eq(frame_cors("GET / HTTP/1.1\r\nOrigin: null"), "")
    assert_eq(frame_cors("GET / HTTP/1.1"), "")
}

test "a closed tab ends its wait and refuses input" {
    t := sample_target("")
    if t.port == 0 {
        return
    }
    rd := new_freerdp_desktop()
    fp := first_fingerprint(rd, "t-close", t)
    _ := try rd.rd_open("t-close", sample_target(fp), 15000)
    rd.rd_close("t-close")
    ev := rd.rd_wait("t-close", 200)
    assert_eq(ev.kind, "ended")
    assert_eq(ev.message, "")
    mut msg := ""
    rd.rd_key("t-close", "KeyA", true) or err { msg = "{err.message()}" }
    assert(msg.starts_with("network:"), msg)
}

test "a wrong password on a real Windows host is an auth error that does not name it" {
    mut t := live_target("")
    if t.hostname.len() == 0 {
        return
    }
    rd := new_freerdp_desktop()
    fp := first_fingerprint(rd, "t-live-auth", t)
    t.trusted_fingerprint = fp
    t.password = "wrong-on-purpose-4711"
    mut msg := ""
    rd.rd_open("t-live-auth", t, 20000) or err { msg = "{err.message()}" }
    rd.rd_close("t-live-auth")
    assert(msg.starts_with("auth:"), msg)
    assert(!msg.contains("wrong-on-purpose-4711"))
}

test "a real Windows host resizes in place through Display Control" {
    t := live_target("")
    if t.hostname.len() == 0 {
        return
    }
    rd := new_freerdp_desktop()
    fp := first_fingerprint(rd, "t-live", t)
    d := try rd.rd_open("t-live", live_target(fp), 20000)
    defer rd.rd_close("t-live")
    assert_eq(d.width, 1024)
    assert(wait_frame("t-live").len() > 16, "no frame in 10 s")
    // The channel opens a moment after the desktop.
    time.sleep_ms(3000)
    try rd.rd_resize("t-live", 1280, 720)
    mut resized := false
    for i in 0..50 {
        frame := next_frame("t-live", 200) or ""
        if frame.len() > 16 && le16(frame, 12) == 1280 && le16(frame, 14) == 720 {
            resized = true
            break
        }
    }
    assert(resized, "the desktop did not become 1280x720")
    assert_eq(rd.rd_wait("t-live", 100).kind, "running")
}

// Milestone 35: after a quiet second the whole desktop is read again, once, and the
// re-read compares it with what was handed out; a switch of graphics mode is reported
// to the core by rd_wait, at the desktop's current size.
test "a quiet second re-reads the whole desktop once, and a graphics switch reaches rd_wait" {
    t := sample_target("")
    if t.port == 0 {
        return
    }
    rd := new_freerdp_desktop()
    fp := first_fingerprint(rd, "t-quiet", t)
    d := try rd.rd_open("t-quiet", sample_target(fp), 15000)
    defer rd.rd_close("t-quiet")
    assert(wait_frame("t-quiet").len() > 16, "no frame in 10 s")
    // Drain until the server goes quiet, then the re-read: the whole desktop.
    mut whole := ""
    for i in 0..40 {
        frame := next_frame("t-quiet", 300) or ""
        if frame.len() > 16 && le16(frame, 8) == d.width && le16(frame, 10) == d.height {
            st := try rd.rd_stats("t-quiet")
            if st.rereads > 0 {
                whole = frame
                break
            }
        }
    }
    assert(whole.len() > 16, "no re-read of the whole desktop")
    assert_eq(le16(whole, 4), 0)
    assert_eq(le16(whole, 6), 0)
    st := try rd.rd_stats("t-quiet")
    assert(st.rereads >= 1)
    // Every pixel the sample server drew was reported: nothing stale.
    assert_eq(st.stale_px, 0)
    assert_eq(st.mode, "pipeline")
    // The dial's round trip on loopback: a local network.
    rtt := rd.rd_probe_rtt("127.0.0.1", t.port, 1500)
    assert(rtt >= 0 && rtt <= 5, "loopback round trip {rtt} ms")
    assert_eq(rd.rd_probe_rtt("127.0.0.1", 9, 1500), -1)
    // Once per quiet spell: nothing more while the server stays quiet.
    again := next_frame("t-quiet", 1500) or ""
    assert_eq(again.len(), 0)

    try rd.rd_set_graphics("t-quiet", "compatible")
    ev := rd.rd_wait("t-quiet", 2000)
    assert_eq(ev.kind, "graphics")
    assert_eq(ev.message, "compatible")
    assert_eq(ev.width, d.width)
    assert_eq(ev.height, d.height)
    assert_eq(rd.rd_wait("t-quiet", 100).kind, "running")
    mut msg := ""
    rd.rd_set_graphics("t-none", "compatible") or err { msg = "{err.message()}" }
    assert(msg.starts_with("network:"), msg)
}

// Milestone 34: Windows offers the graphics pipeline, which "auto" takes; "compatible"
// keeps the bitmap updates. The codec is the server's choice among those offered.
test "a real Windows host draws through the graphics pipeline, or bitmaps when asked" {
    t := live_target("")
    if t.hostname.len() == 0 {
        return
    }
    rd := new_freerdp_desktop()
    fp := first_fingerprint(rd, "t-gfx", t)
    _ := try rd.rd_open("t-gfx", live_target(fp), 20000)
    assert(wait_frame("t-gfx").len() > 16, "no frame in 10 s")
    // The pipeline's channel opens a moment after the desktop, as Display Control's.
    mut st := try rd.rd_stats("t-gfx")
    for i in 0..50 {
        if st.pipeline == "gfx" && st.commands > 0 {
            break
        }
        time.sleep_ms(200)
        st = try rd.rd_stats("t-gfx")
    }
    assert_eq(st.pipeline, "gfx")
    assert(st.commands > 0, "no surface command")
    assert(st.bytes_in > 0)
    assert(st.codec.len() > 0)
    println("graphics pipeline: codec {st.codec}, h264 {st.h264}, {st.commands} commands, {st.bytes_in} bytes")
    // Milestone 35: the link as Windows measured it (auto-detect), once it has.
    for i in 0..25 {
        if st.link_kbps > 0 || st.link_rtt_ms > 0 {
            break
        }
        time.sleep_ms(200)
        st = try rd.rd_stats("t-gfx")
    }
    println("link: {st.link_kbps} kbit/s, rtt {st.link_rtt_ms} ms; re-reads {st.rereads}, stale px {st.stale_px}")
    rd.rd_close("t-gfx")

    mut old := live_target(fp)
    old.graphics = "compatible"
    _ := try rd.rd_open("t-bitmap", old, 20000)
    defer rd.rd_close("t-bitmap")
    assert(wait_frame("t-bitmap").len() > 16, "no frame in 10 s")
    // Long enough for a pipeline that would open to have opened.
    time.sleep_ms(3000)
    st2 := try rd.rd_stats("t-bitmap")
    assert_eq(st2.pipeline, "bitmap")
    assert_eq(st2.commands, 0)
    assert(st2.bytes_in > 0)
}

// ---- Flint's own test server (milestone 31): FLINT_RDP_CLIP_PORT, its control port
// FLINT_RDP_CLIP_CONTROL (scripts/test.sh starts it; native/testserver).

fn clip_target(trusted: str) -> RdpTarget {
    port := os.getenv("FLINT_RDP_CLIP_PORT")
    mut p: i64 = 0
    if port.len() > 0 {
        p = str.parse_i64(port) or 0
    }
    return RdpTarget{ hostname: "127.0.0.1", port: p, user: "flint", domain: "", password: "x", width: 640, height: 480, trusted_fingerprint: trusted, graphics: "auto", rtt_ms: -1 }
}

// One command to the test server's control port, its one-line answer.
fn ctl(cmd: str) -> str {
    port := os.getenv("FLINT_RDP_CLIP_CONTROL")
    script := "exec 3<>/dev/tcp/127.0.0.1/{port}; printf '%s\\n' \"$1\" >&3; IFS= read -r line <&3; printf '%s' \"$line\""
    r := os.command("bash", ["-c", script, "ctl", cmd]) or {
        return "error"
    }
    return r.stdout
}

fn to_hex(s: str) -> str {
    digits := "0123456789abcdef"
    d := digits.bytes()
    mut res := ""
    for b in s.bytes() {
        c := u8(b)
        res = res + byte_to_str(u8(d[usize(c / 16)])) + byte_to_str(u8(d[usize(c % 16)]))
    }
    return res
}

// Waits for an event of `kind` on the tab, skipping `running`.
fn wait_kind(rd: FreeRdpDesktop, tab: str, kind: str) -> RdpEvent {
    for i in 0..50 {
        ev := rd.rd_wait(tab, 200)
        if ev.kind == kind || ev.kind == "ended" {
            return ev
        }
    }
    return RdpEvent{ kind: "none", message: "", width: 0, height: 0 }
}

// Polls the control port until `cmd` answers `want` (the clipboard channel is a few
// round trips behind the desktop).
fn ctl_until(cmd: str, want: str) -> str {
    mut got := ""
    for i in 0..50 {
        got = ctl(cmd)
        if got == want {
            return got
        }
        time.sleep_ms(100)
    }
    return got
}

fn open_clip(rd: FreeRdpDesktop, tab: str) -> RdpDesktop! {
    fp := first_fingerprint(rd, tab, clip_target(""))
    d := try rd.rd_open(tab, clip_target(fp), 15000)
    // The clipboard channel announces itself once the desktop is up.
    _ := ctl_until("formats", "-")
    time.sleep_ms(300)
    return d
}

test "text copied on the remote arrives here, CRLF as LF" {
    if clip_target("").port == 0 {
        return
    }
    rd := new_freerdp_desktop()
    _ := try open_clip(rd, "t-clip-in")
    defer rd.rd_close("t-clip-in")
    assert_eq(ctl("copy {to_hex("héllo\r\nwörld ✓")}"), "ok")
    ev := wait_kind(rd, "t-clip-in", "clip_text")
    assert_eq(ev.kind, "clip_text")
    assert_eq(ev.message, "héllo\nwörld ✓")
}

test "text here is only announced, and sent when the remote pastes" {
    if clip_target("").port == 0 {
        return
    }
    rd := new_freerdp_desktop()
    _ := try open_clip(rd, "t-clip-out")
    defer rd.rd_close("t-clip-out")
    assert_eq(ctl("clear"), "ok")
    try rd.rd_clip_announce("t-clip-out", true)
    assert_eq(ctl_until("formats", "13"), "13")
    // Nothing was sent yet: the server has no text until it asks.
    assert_eq(ctl("pasted"), "-")
    assert_eq(ctl("paste"), "ok")
    assert_eq(wait_kind(rd, "t-clip-out", "clip_request").kind, "clip_request")
    try rd.rd_clip_answer("t-clip-out", true, "a\nb ✓")
    assert_eq(ctl_until("pasted", to_hex("a\r\nb ✓")), to_hex("a\r\nb ✓"))

    // Refused by the core (a locked window): the server gets a failure.
    assert_eq(ctl("paste"), "ok")
    assert_eq(wait_kind(rd, "t-clip-out", "clip_request").kind, "clip_request")
    try rd.rd_clip_answer("t-clip-out", false, "")
    assert_eq(ctl_until("pasted", "fail"), "fail")

    // Nothing announced: the adapter refuses on its own, the core is not asked.
    // FreeRDP before 3.16 or so drops an empty format list after the first one, so the
    // server may still think there is text (Debian's 3.15); the paste fails either way.
    try rd.rd_clip_announce("t-clip-out", false)
    formats := ctl_until("formats", "-")
    assert(formats == "-" || formats == "13", formats)
    assert_eq(ctl("paste"), "ok")
    assert_eq(ctl_until("pasted", "fail"), "fail")
    assert_eq(rd.rd_wait("t-clip-out", 300).kind, "running")
}

test "keys reach the server by scancode" {
    if clip_target("").port == 0 {
        return
    }
    rd := new_freerdp_desktop()
    _ := try open_clip(rd, "t-clip-keys")
    defer rd.rd_close("t-clip-keys")
    assert_eq(ctl("clear"), "ok")
    try rd.rd_key("t-clip-keys", "MetaLeft", true)
    try rd.rd_key("t-clip-keys", "MetaLeft", false)
    try rd.rd_key("t-clip-keys", "AltRight", true)
    try rd.rd_key("t-clip-keys", "AltRight", false)
    assert_eq(ctl_until("keys", "d:0x15b u:0x15b d:0x138 u:0x138"), "d:0x15b u:0x15b d:0x138 u:0x138")
}

test "a connection the server drops ends as lost, at once" {
    if clip_target("").port == 0 {
        return
    }
    rd := new_freerdp_desktop()
    _ := try open_clip(rd, "t-clip-drop")
    defer rd.rd_close("t-clip-drop")
    started := time.now_ms()
    assert_eq(ctl("drop"), "ok")
    ev := wait_kind(rd, "t-clip-drop", "ended")
    elapsed := time.now_ms() - started
    assert_eq(ev.kind, "ended")
    assert(ev.message.starts_with("network: the connection was lost"), ev.message)
    assert(elapsed < 5000, "took {elapsed} ms")
}

// Blocks (`on`) or unblocks (`off`) every packet to and from the test server, as a
// network that goes away without a word. Only where FLINT_RDP_BLACKHOLE=1: the Linux
// image run with NET_ADMIN (scripts/linux-check.sh), iptables through sudo.
fn blackhole(on: bool) -> str {
    port := os.getenv("FLINT_RDP_CLIP_PORT")
    mut op := "-D"
    if on {
        op = "-I"
    }
    script := "pw=\"$FLINT_TEST_LOGIN_PW\"; for d in --sport --dport; do printf '%s\\n' \"$pw\" | sudo -S -p '' iptables {op} INPUT -i lo -p tcp $d {port} -j DROP || exit 1; done"
    r := os.command("bash", ["-c", script]) or {
        return "error"
    }
    return "{r.exit_code}:{r.stderr}"
}

test "a network that goes quiet ends the session within 20 s, idle or sending" {
    if clip_target("").port == 0 || os.getenv("FLINT_RDP_BLACKHOLE") != "1" {
        return
    }
    rd := new_freerdp_desktop()
    for round in 0..2 {
        tab := "t-quiet-{round}"
        _ := try open_clip(rd, tab)
        assert_eq(blackhole(true), "0:")
        started := time.now_ms()
        mut ev := RdpEvent{ kind: "none", message: "", width: 0, height: 0 }
        for i in 0..300 {
            if round == 1 {
                // Data in flight: a key every 100 ms that nothing acknowledges.
                rd.rd_key(tab, "ShiftLeft", true) or {}
                rd.rd_key(tab, "ShiftLeft", false) or {}
            }
            ev = rd.rd_wait(tab, 100)
            if ev.kind == "ended" {
                break
            }
        }
        elapsed := time.now_ms() - started
        blackhole(false)
        rd.rd_close(tab)
        println("quiet network, round {round} (1 = sending): ended after {elapsed} ms: {ev.message}")
        assert_eq(ev.kind, "ended")
        assert(ev.message.starts_with("network:"), ev.message)
        assert(elapsed < 20000, "took {elapsed} ms")
    }
}


