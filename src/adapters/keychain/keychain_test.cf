package keychain

import "core:crypto/sha256"
import "core:os"
import "core:rand"
import "../../ports"

fn keychain_port_check[K: Keychain](k: K) -> bool {
    got := k.keychain_load("flint-test-absent-" + sha256.random_hex(8)) or err { return true }
    return got.len() == 0
}

fn random_key_bytes() -> []byte {
    return rand.bytes(32)
}

// On Linux, glib and libsecret keep their D-Bus connection open for the life of the
// process, which the `cfire test` fd-leak canary reports as a leak (CF-018). One
// lookup at start-up, before any test runs, opens it up front. macOS needs no
// warm-up, and calling Security.framework from a static initialiser kills the test
// binary silently there.
fn warm_up_keychain() -> bool {
    mut apple := false
    // CFIRE-UPSTREAM: CF-018, CF-031
    cpp {
        #if defined(__APPLE__)
        apple = true;
        #endif
    }
    if apple || os.getenv("FLINT_TEST_KEYCHAIN") == "off" {
        return false
    }
    _ := new_os_keychain(true).keychain_load("flint-test-warm-up")
    return true
}

KEYCHAIN_WARM: bool = warm_up_keychain()

// Talks to the real OS keychain. FLINT_TEST_KEYCHAIN=off skips it on a machine
// without one (a headless Linux box with no Secret Service).
test "save, load, overwrite and forget a vault key in the OS keychain" {
    if os.getenv("FLINT_TEST_KEYCHAIN") == "off" {
        println("skipped: FLINT_TEST_KEYCHAIN=off")
        return
    }
    kc := new_os_keychain(true)
    account := "flint-test-" + sha256.random_hex(8)
    secret := random_key_bytes()
    try kc.keychain_save(account, secret)
    got := try kc.keychain_load(account)
    assert(got == secret)
    other := random_key_bytes()
    try kc.keychain_save(account, other)
    assert((try kc.keychain_load(account)) == other)
    try kc.keychain_forget(account)
    assert_eq((try kc.keychain_load(account)).len(), 0)
    try kc.keychain_forget(account)
}

test "a disabled keychain stores nothing and finds nothing" {
    kc := new_os_keychain(false)
    assert(!kc.keychain_save("x", [byte(1)]).has_value())
    assert_eq((try kc.keychain_load("x")).len(), 0)
    assert(kc.keychain_forget("x").has_value())
}

test "OsKeychain satisfies the Keychain port" {
    assert(keychain_port_check(new_os_keychain(false)))
}
