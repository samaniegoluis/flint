package keychain

// The `Keychain` port over the OS keychain: macOS Keychain Services or the Linux
// Secret Service (libsecret). The native code is in native/flint_keychain.hpp.

// CFIRE-UPSTREAM: CF-008, CF-031
import cpp "flint_keychain.hpp"
import "core:os"
import "../../domain"

// A function, not a global: a global initialiser elsewhere (the test warm-up) may run
// before a global str is constructed. FLINT_KEYCHAIN_SERVICE is a seam for the e2e
// runs only (milestone 45): two "machines" on one Mac share its keychain, and on
// macOS an item one binary saved asks before another reads it (D-099), so a run that
// stands for another machine keeps its items under another service. Not documented
// for people: a vault remembered under it is not found by a Flint without it.
fn keychain_service() -> str {
    s := (os.getenv("FLINT_KEYCHAIN_SERVICE") or "")
    if s.len() > 0 {
        return s
    }
    return "Flint"
}

// `enabled: false` turns the keychain off (FLINT_KEYCHAIN=off): nothing is cached,
// every unlock asks for the password.
type OsKeychain struct {
    enabled: bool
}

fn new_os_keychain(enabled: bool) -> OsKeychain {
    return OsKeychain{ enabled: enabled }
}

// `unavailable` and `refused` are the message ids for the action (store, read,
// remove the vault key).
fn keychain_status_error(rc: i32, unavailable: str, refused: str) -> str {
    if rc == 2 {
        return core_msg(unavailable, [])
    }
    return core_msg(refused, [])
}

fn (self: OsKeychain) keychain_save(account: str, secret: []byte) -> void! {
    if !self.enabled {
        return error(core_msg(MSG_KEYCHAIN_OFF, []))
    }
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-008
    cpp {
        rc = flint_kc::save(keychain_service(), account, secret);
    }
    if rc != 0 {
        return error(keychain_status_error(rc, MSG_KEYCHAIN_UNAVAILABLE_STORE, MSG_KEYCHAIN_REFUSED_STORE))
    }
}

fn (self: OsKeychain) keychain_load(account: str) -> []byte! {
    if !self.enabled {
        return []
    }
    mut rc: i32 = 0
    mut found: []byte = []
    // CFIRE-UPSTREAM: CF-008
    cpp {
        rc = flint_kc::load(keychain_service(), account, found);
    }
    if rc == 1 {
        return []
    }
    if rc != 0 {
        return error(keychain_status_error(rc, MSG_KEYCHAIN_UNAVAILABLE_READ, MSG_KEYCHAIN_REFUSED_READ))
    }
    return found
}

fn (self: OsKeychain) keychain_forget(account: str) -> void! {
    if !self.enabled {
        return
    }
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-008
    cpp {
        rc = flint_kc::forget(keychain_service(), account);
    }
    // 1: no entry. 2: no keychain to reach, so no cached key Flint could use either
    // (unlock treats an unreachable keychain the same way).
    if rc != 0 && rc != 1 && rc != 2 {
        return error(keychain_status_error(rc, MSG_KEYCHAIN_UNAVAILABLE_REMOVE, MSG_KEYCHAIN_REFUSED_REMOVE))
    }
}
