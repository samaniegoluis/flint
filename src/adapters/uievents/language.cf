package uievents

// The OS's language, as the app language it stands for (milestone 66, D-140): "es"
// or "en". Read once at start for Settings.language == "system". macOS and Windows
// ask the OS through a native shim (native/flint_language.hpp, CF-191); Linux reads
// LANGUAGE, LC_ALL, LC_MESSAGES and LANG.

import "core:os"
import "../../domain"

// CFIRE-UPSTREAM: CF-191
import cpp "flint_language.hpp"

pub fn os_language() -> str {
    return domain.language_of_locale(os_language_tag())
}

// The OS's own language tag or locale, as read ("es-MX", "es_MX.UTF-8"), for the
// line the GUI logs at start (milestone 68).
pub fn os_language_tag() -> str {
    mut tag := ""
    // CFIRE-UPSTREAM: CF-191
    cpp {
        tag = flint_language::preferred();
    }
    if tag.len() == 0 {
        tag = domain.locale_of_env((os.getenv("LANGUAGE") or ""), (os.getenv("LC_ALL") or ""), (os.getenv("LC_MESSAGES") or ""), (os.getenv("LANG") or ""))
    }
    return tag
}
