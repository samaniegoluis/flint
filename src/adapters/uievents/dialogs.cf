package uievents

// Open and save file dialogs where ext:webui has none: on Linux, a GTK file chooser
// (native/flint_dialog.hpp, CF-077). On macOS the GUI driver keeps webui's own panels.

import cpp "flint_dialog.hpp" @pkg("flint-native-gui")

// True when this platform's dialogs come from here rather than from ext:webui.
fn native_file_dialogs() -> bool {
    mut yes := false
    // CFIRE-UPSTREAM: CF-077
    cpp {
        yes = flint_dialog::native();
    }
    return yes
}

// Asks for a file to open; "" when cancelled.
fn choose_file_to_open(title: str) -> str {
    mut path := ""
    // CFIRE-UPSTREAM: CF-077
    cpp {
        path = flint_dialog::choose(false, title, "");
    }
    return path
}

// Asks where to save a new file, `default_name` filled in; "" when cancelled.
fn choose_file_to_save(title: str, default_name: str) -> str {
    mut path := ""
    // CFIRE-UPSTREAM: CF-077
    cpp {
        path = flint_dialog::choose(true, title, default_name);
    }
    return path
}
