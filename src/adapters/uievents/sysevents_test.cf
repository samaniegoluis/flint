package uievents

test "lock and sleep events are taken once, sleep first" {
    _ = system_events_take()
    assert_eq(system_events_take(), "")
    system_events_inject("screen")
    system_events_inject("screen")
    assert_eq(system_events_take(), "screen")
    assert_eq(system_events_take(), "")
    system_events_inject("screen")
    system_events_inject("sleep")
    assert_eq(system_events_take(), "sleep")
    assert_eq(system_events_take(), "")
}

// The D-Bus path (a screensaver's ActiveChanged on a private session bus) is checked
// against the running app in scripts/serve-e2e.sh on Linux: GLib keeps its bus
// connections for the life of the process, which a test here reports as leaked
// descriptors (CF-080).

test "FLINT_PRESENCE=password picks the master password and never skips the check" {
    mut refused := 0
    mut p := new_os_presence()
    p.force_password = true
    assert_eq(p.presence_method(), PRESENCE_PASSWORD)
    p.presence_confirm(window_open_reason("x")) or { refused += 1 }
    assert_eq(refused, 1)
}

// Milestone 68: the reason the OS dialog shows follows the window's language; the
// English is the core's sentence, unchanged.
test "a presence reason reads in the window's language" {
    r := sudo_period_reason("claude", "db1", "5")
    assert_eq(presence_text("en", r), r.text)
    assert_eq(presence_text("es", r), "permitir que \"claude\" ejecute comandos como root en db1 durante 5 minutos")
    assert_eq(presence_text("es", window_open_reason("Work")), "abrir la ventana de Flint de la bóveda Work")
    assert_eq(presence_text("es", rdp_type_password_reason("win1")), "escribir la contraseña de win1 en su escritorio remoto")
    // An id the table lacks, or params it does not expect, read English.
    assert_eq(presence_text("es", PresenceReason{ id: "x", params: [], text: "do x" }), "do x")
    p := new_os_presence()
    q := p
    p.set_language("es")
    assert_eq(q.lang.get(), "es")
}
