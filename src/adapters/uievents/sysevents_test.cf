package uievents

import "core:os"

test "lock and sleep events are taken once, sleep first" {
    _ := system_events_take()
    assert_eq(system_events_take(), "")
    system_events_inject("screen")
    system_events_inject("screen")
    assert_eq(system_events_take(), "screen")
    assert_eq(system_events_take(), "")
    system_events_inject("screen")
    system_events_inject("sleep")
    assert_eq(system_events_take(), "sleep")
    assert_eq(system_events_take(), "")
}

// Linux, on a private session bus (scripts/linux/inside.sh runs the suites under
// dbus-run-session): a screensaver turning on is a screen lock. Never on a desktop's
// real bus, where other programs would hear the signal too.
test "a screensaver ActiveChanged(true) on D-Bus counts as a screen lock" {
    bus: str = os.getenv("FLINT_TEST_PRIVATE_DBUS")
    if bus != "1" {
        return
    }
    _ := system_events_take()
    got := system_events_start()
    assert(got.contains("screensaver"))
    system_events_pump(200)
    r := os.command("dbus-send", ["--session", "--type=signal", "/org/freedesktop/ScreenSaver", "org.freedesktop.ScreenSaver.ActiveChanged", "boolean:false"]) or {
        assert(false)
        return
    }
    assert_eq(r.exit_code, 0)
    system_events_pump(500)
    assert_eq(system_events_take(), "")
    r2 := os.command("dbus-send", ["--session", "--type=signal", "/org/gnome/ScreenSaver", "org.gnome.ScreenSaver.ActiveChanged", "boolean:true"]) or {
        assert(false)
        return
    }
    assert_eq(r2.exit_code, 0)
    system_events_pump(500)
    assert_eq(system_events_take(), "screen")
}
