package uievents

// Windows: the page gets the keyboard back when the window returns to the front
// (Alt+Tab, the taskbar), through a native shim (native/flint_focus.hpp, W-16): cfire's
// window never hands WebView2 the focus back. Nothing on macOS and Linux.

// CFIRE-UPSTREAM: W-16
import cpp "flint_focus.hpp"

// Starts handing the focus back to the page. Call once, on the UI thread, before the
// window runs.
fn window_focus_install() {
    // CFIRE-UPSTREAM: W-16
    cpp {
        flint_focus::install();
    }
}
