package ssh

// SFTP over libssh against the throwaway sshd of scripts/test.sh (milestone 16's
// spike). The last tests settle the spec's open question for the Files view: an
// SFTP channel shares the session of a running PTY, in turn and from two threads.

import "core:os"
import "core:fs"
import "core:time"
import "core:str"
import "core:sync"
import "../../ports"

fn accepts_sftp[T: SftpTransport](t: T) -> bool {
    return true
}

test "SshLink satisfies the SftpTransport port" {
    link := new_ssh_link()
    assert(accepts_sftp(link))
}

test "sftp calls before sftp_open fail as internal" {
    link := new_ssh_link()
    r := link.sftp_stat("/")
    assert(!r.has_value())
    assert_eq(error_code_of("{r.error().message()}"), "internal")
}

fn sftp_link() -> SshLink! {
    (port, key_path) := test_target()
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    try link.link_auth_key(try fs.read_text(key_path), "")
    try link.sftp_open()
    return link
}

fn scratch_dir(tag: str) -> str {
    d := os.getenv("TMPDIR") + "/flint-sftp-" + tag + "-{time.now_ms()}"
    return str.replace(d, "//", "/")
}

test "sftp writes, stats, lists, reads, renames and removes" {
    (port, _) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    mut link := try sftp_link()
    defer link.link_hangup()
    home := try link.sftp_realpath(".")
    assert(home.starts_with("/"))
    dir := scratch_dir("basic")
    try link.sftp_mkdir(dir)
    again := link.sftp_mkdir(dir)
    assert(!again.has_value())

    path := dir + "/a.txt"
    mut big := ""
    for i in 0..20000 {
        big = big + "line {i}\n"
    }
    try link.sftp_file_open(path, true, true)
    try link.sftp_file_write(big)
    try link.sftp_file_close()
    // Exclusive refuses an existing file.
    excl := link.sftp_file_open(path, true, true)
    assert(!excl.has_value())
    assert_eq(error_code_of("{excl.error().message()}"), "exists")

    st := try link.sftp_stat(path)
    assert(st.is_file())
    assert_eq(st.size, i64(big.len()))
    assert_eq(st.name, "a.txt")

    try link.sftp_file_open(path, false, false)
    mut back := ""
    for true {
        chunk := try link.sftp_file_read()
        if chunk.len() == 0 {
            break
        }
        back = back + chunk
    }
    try link.sftp_file_close()
    assert(back == big, "what was read back must be what was written")

    try link.sftp_mkdir(dir + "/sub")
    list := try link.sftp_list(dir)
    assert_eq(list.len(), 2)
    mut kinds := ""
    for e in list {
        kinds = kinds + e.name + "=" + e.kind + ";"
    }
    assert(kinds.contains("a.txt=file;") && kinds.contains("sub=dir;"), kinds)

    // Listing a file is not_a_directory, a missing path not_found.
    as_dir := link.sftp_list(path)
    assert_eq(error_code_of("{as_dir.error().message()}"), "not_a_directory")
    missing := link.sftp_stat(dir + "/nope")
    assert_eq(error_code_of("{missing.error().message()}"), "not_found")

    // Rename onto a name that is free, then onto one that is taken.
    try link.sftp_rename(path, dir + "/b.txt")
    try link.sftp_file_open(dir + "/c.txt", true, false)
    try link.sftp_file_write("c")
    try link.sftp_file_close()
    over := link.sftp_rename(dir + "/c.txt", dir + "/b.txt")
    println("spike: rename onto an existing file: {over.has_value()}")
    if over.has_value() {
        // posix-rename@openssh.com: the server replaced it.
        assert_eq((try link.sftp_stat(dir + "/b.txt")).size, 1)
    } else {
        try link.sftp_remove(dir + "/c.txt", false)
    }

    try link.sftp_remove(dir + "/b.txt", false)
    try link.sftp_remove(dir + "/sub", true)
    try link.sftp_remove(dir, true)
    gone := link.sftp_stat(dir)
    assert_eq(error_code_of("{gone.error().message()}"), "not_found")
}

test "sftp shares a session with a running PTY, in turn" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    mut link := new_ssh_link()
    defer link.link_hangup()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    try link.link_auth_key(try fs.read_text(key_path), "")
    // A plain sh on the PTY: a login shell's line editor and prompt take seconds.
    try link.link_shell_open("xterm-256color", 80, 24, "/bin/sh")
    try link.sftp_open()
    dir := scratch_dir("pty")
    try link.link_channel_write("mkdir -p {dir} && echo made-$((6*7))\n")
    mut seen := ""
    for _ in 0..100 {
        seen = seen + (try link.link_channel_read(300)).stdout
        if seen.contains("made-42") {
            break
        }
    }
    assert(seen.contains("made-42"))
    // The shell made the folder; SFTP sees it and writes into it, then the shell
    // sees the file SFTP wrote.
    assert((try link.sftp_stat(dir)).is_dir())
    try link.sftp_file_open(dir + "/from-sftp", true, true)
    try link.sftp_file_write("sftp-was-here")
    try link.sftp_file_close()
    try link.link_channel_write("cat {dir}/from-sftp; echo; rm -r {dir}; echo done-$((1+1))\n")
    seen = ""
    for _ in 0..100 {
        seen = seen + (try link.link_channel_read(300)).stdout
        if seen.contains("done-2") {
            break
        }
    }
    assert(seen.contains("sftp-was-here"), "the shell must read the file SFTP wrote")
}

test "sftp shares a session with a PTY read on another thread" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    mut link := new_ssh_link()
    defer link.link_hangup()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    try link.link_auth_key(try fs.read_text(key_path), "")
    // A plain sh on the PTY: a login shell's line editor and prompt take seconds.
    try link.link_shell_open("xterm-256color", 80, 24, "/bin/sh")
    try link.sftp_open()
    // The shell prints a counter for ~3 s while this thread lists and stats.
    try link.link_channel_write("for i in $(seq 1 30); do echo tick-$i; sleep 0.1; done; echo ticks-$((40+2))\n")
    reader := link
    mut stats: i64 = 0
    // A task's captures are copies: what it heard comes back on a channel (CF-098).
    heard_ch := sync.make_channel[str]()
    async.scope(workers: 2) |scope| {
        scope.spawn || {
            mut r := reader
            mut got := ""
            for _ in 0..400 {
                chunk := r.link_channel_read(50)
                if !chunk.has_value() {
                    break
                }
                got = got + chunk.value().stdout
                if got.contains("ticks-42") {
                    break
                }
            }
            heard_ch.send(got)
        }
        for _ in 0..40 {
            st := link.sftp_stat(".")
            if !st.has_value() {
                break
            }
            if st.value().is_dir() {
                stats += 1
            }
            _ := link.sftp_list(".") or []
        }
    }
    heard := heard_ch.recv_timeout(10000) or ""
    println("spike: {stats} SFTP stats while the PTY was read on another thread")
    assert_eq(stats, 40)
    assert(heard.contains("tick-30") && heard.contains("ticks-42"), "the PTY reader must see every tick")
}

// Principle 8 for SFTP: a request to a server that stops answering fails within the
// dial timeout. Needs a forwarder that freezes once FLINT_TEST_STALL_FILE exists
// (milestone 16's spike); skipped otherwise.
test "an sftp request to a stalled server fails within the timeout" {
    (port, key_path) := test_target()
    stall_port := os.getenv("FLINT_TEST_STALL_PORT")
    stall_file := os.getenv("FLINT_TEST_STALL_FILE")
    if port == 0 || stall_port.len() == 0 {
        println("SKIP: FLINT_TEST_STALL_PORT not set")
        return
    }
    mut link := new_ssh_link()
    defer link.link_hangup()
    try link.link_dial("127.0.0.1", i64(stall_port.parse_i64() or 0), os.getenv("USER"), 3, "")
    try link.link_auth_key(try fs.read_text(key_path), "")
    try link.sftp_open()
    try fs.write_text(stall_file, "stall")
    start := time.now_ms()
    r := link.sftp_stat(".")
    took := time.now_ms() - start
    fs.remove(stall_file) or {}
    println("spike: stalled stat -> ok={r.has_value()} in {took} ms")
    assert(!r.has_value())
    assert(took < 6000, "the stalled request must end within the 3 s timeout (and a margin)")
}
