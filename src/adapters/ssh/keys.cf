package ssh

// The `KeyInspector` port over libssh: validates a private key given by content and
// reads its public half. The private key and passphrase never appear in an error.

import "../../domain"

type LibsshKeyInspector struct {
    ready: bool
}

fn new_libssh_key_inspector() -> LibsshKeyInspector {
    return LibsshKeyInspector{ ready: true }
}

fn (self: LibsshKeyInspector) inspect_private_key(private_key: str, passphrase: str) -> KeyInfo! {
    if private_key.len() == 0 {
        return error(coded(ERR_INVALID, "the private key is empty"))
    }
    if private_key.len() > 65536 {
        return error(coded(ERR_INVALID, "the private key is larger than 64 KiB"))
    }
    mut rc: i32 = 0
    mut key_type := ""
    mut public_key := ""
    mut fingerprint := ""
    // CFIRE-UPSTREAM: CF-005
    cpp {
        ssh_key key = nullptr;
        ssh_key pub = nullptr;
        const char* pass = passphrase.empty() ? nullptr : passphrase.c_str();
        rc = ssh_pki_import_privkey_base64(private_key.c_str(), pass, nullptr, nullptr, &key);
        if (rc == SSH_OK && !ssh_key_is_private(key)) rc = -3;
        if (rc == SSH_OK) {
            const char* t = ssh_key_type_to_char(ssh_key_type(key));
            if (t) key_type = t;
            rc = ssh_pki_export_privkey_to_pubkey(key, &pub);
        }
        if (rc == SSH_OK) {
            char* b64 = nullptr;
            rc = ssh_pki_export_pubkey_base64(pub, &b64);
            if (rc == SSH_OK && b64) {
                public_key = key_type + " " + b64;
                ssh_string_free_char(b64);
            }
        }
        if (rc == SSH_OK) {
            unsigned char* hash = nullptr;
            size_t hlen = 0;
            rc = ssh_get_publickey_hash(pub, SSH_PUBLICKEY_HASH_SHA256, &hash, &hlen);
            if (rc == SSH_OK) {
                char* txt = ssh_get_fingerprint_hash(SSH_PUBLICKEY_HASH_SHA256, hash, hlen);
                if (txt) { fingerprint = txt; ssh_string_free_char(txt); }
                ssh_clean_pubkey_hash(&hash);
            }
        }
        if (pub) ssh_key_free(pub);
        if (key) ssh_key_free(key);
    }
    if rc == -3 {
        return error(coded(ERR_INVALID, "that is a public key; paste or import the private key"))
    }
    if rc != 0 || fingerprint.len() == 0 {
        if passphrase.len() == 0 {
            return error(coded(ERR_INVALID, "the private key could not be read: it is not an SSH private key, or it is encrypted and needs its passphrase"))
        }
        return error(coded(ERR_INVALID, "the private key could not be read: wrong passphrase or not an SSH private key"))
    }
    return KeyInfo{ key_type: key_type, public_key: public_key, fingerprint: fingerprint }
}
