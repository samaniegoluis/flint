package ssh

import "core:os"
import "core:fs"
import "../../domain"
import "../../ports"

// Compiles only if SshLink satisfies the SshTransport port.
fn accepts_transport[T: SshTransport](mut t: T) -> bool {
    return true
}

// The second sshd started by scripts/test.sh, dialled through the first.
fn inner_port() -> i64 {
    port := os.getenv("FLINT_TEST_SSH_PORT2")
    mut p: i64 = 0
    // CFIRE-UPSTREAM: CF-022
    cpp {
        p = port.empty() ? 0 : std::atoll(port.c_str());
    }
    return p
}

fn read_all(mut link: SshLink) -> ExecChunk! {
    mut acc := ExecChunk{ stdout: "", stderr: "", done: false, exit_code: 0, signal: "" }
    for _ in 0..300 {
        c := try link.link_channel_read(100)
        acc.stdout = acc.stdout + c.stdout
        acc.stderr = acc.stderr + c.stderr
        if c.done {
            acc.done = true
            acc.exit_code = c.exit_code
            acc.signal = c.signal
            return acc
        }
    }
    return acc
}

test "SshLink satisfies the SshTransport port" {
    mut link := new_ssh_link()
    assert(accepts_transport(mut link))
}

test "a link to a closed port fails with network" {
    mut link := new_ssh_link()
    r := link.link_dial("127.0.0.1", 1, "nobody", 2)
    assert_eq(error_code_of("{r.error().message()}"), "network")
    link.link_hangup()
}

test "exec over a link returns stdout, stderr and the exit code" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    key_text := try fs.read_text(key_path)
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5)
    sk := try link.link_server_key()
    assert_eq(sk.key_type, "ssh-ed25519")
    assert(sk.fingerprint.starts_with("SHA256:"))
    bad := link.link_auth_password("not-the-password")
    assert_eq(error_code_of("{bad.error().message()}"), "auth")
    try link.link_auth_key(key_text, "")
    try link.link_exec_start("echo out-$((6*7)); echo err-line >&2; cat; exit 7")
    res := try read_all(mut link)
    link.link_hangup()
    assert(res.done)
    assert_eq(res.stdout, "out-42\n")
    assert_eq(res.stderr, "err-line\n")
    assert_eq(res.exit_code, 7)
}

test "a signal is reported instead of an exit code" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5)
    try link.link_auth_key(try fs.read_text(key_path), "")
    try link.link_exec_start("kill -TERM $$")
    res := try read_all(mut link)
    link.link_hangup()
    assert_eq(res.exit_code, -1)
    assert_eq(res.signal, "TERM")
}

test "a second hop is reached through a tunnel over the first" {
    (port, key_path) := test_target()
    port2 := inner_port()
    if port == 0 || port2 == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT2 not set")
        return
    }
    key_text := try fs.read_text(key_path)
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5)
    try link.link_auth_key(key_text, "")
    try link.link_dial("127.0.0.1", port2, os.getenv("USER"), 5)
    outer_fp := try link.hops[0].host_key_sha256()
    inner := try link.link_server_key()
    assert(inner.fingerprint != outer_fp, "the second hop must present its own host key")
    try link.link_auth_key(key_text, "")
    try link.link_exec_start("echo via-jump; head -c 200000 /dev/zero | wc -c")
    res := try read_all(mut link)
    link.link_hangup()
    assert_eq(res.exit_code, 0)
    assert(res.stdout.contains("via-jump"))
    assert(res.stdout.contains("200000"))
}

test "a jump to an unreachable port fails with network and cleans up" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5)
    try link.link_auth_key(try fs.read_text(key_path), "")
    r := link.link_dial("127.0.0.1", 1, os.getenv("USER"), 5)
    assert_eq(error_code_of("{r.error().message()}"), "network")
    link.link_hangup()
}

test "the agent authenticates when SSH_AUTH_SOCK holds the key" {
    (port, _) := test_target()
    if port == 0 || os.getenv("FLINT_TEST_AGENT").len() == 0 {
        println("SKIP: FLINT_TEST_AGENT not set")
        return
    }
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5)
    try link.link_auth_agent()
    try link.link_exec_start("true")
    res := try read_all(mut link)
    link.link_hangup()
    assert_eq(res.exit_code, 0)
}

test "a PTY shell over a link follows a resize" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5)
    try link.link_auth_key(try fs.read_text(key_path), "")
    try link.link_shell_open("xterm-256color", 80, 24)
    try link.link_channel_resize(132, 43)
    try link.link_channel_write("stty size; exit 5\n")
    res := try read_all(mut link)
    link.link_hangup()
    assert(res.stdout.contains("43 132"))
    assert_eq(res.exit_code, 5)
}
