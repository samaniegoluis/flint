package ssh

import "core:os"
import "core:str"
import "core:fs"
import "../../domain"
import "../../ports"

// Compiles only if SshLink satisfies the SshTransport port.
fn accepts_transport[T: SshTransport](mut t: T) -> bool {
    return true
}

// The second sshd started by scripts/test.sh, dialled through the first.
fn inner_port() -> i64 {
    port := os.getenv("FLINT_TEST_SSH_PORT2")
    return str.parse_i64(port) or 0
}

fn read_all(mut link: SshLink) -> ExecChunk! {
    mut acc := ExecChunk{ stdout: "", stderr: "", done: false, exit_code: 0, signal: "" }
    for _ in 0..300 {
        c := try link.link_channel_read(100)
        acc.stdout = acc.stdout + c.stdout
        acc.stderr = acc.stderr + c.stderr
        if c.done {
            acc.done = true
            acc.exit_code = c.exit_code
            acc.signal = c.signal
            return acc
        }
    }
    return acc
}

test "SshLink satisfies the SshTransport port" {
    mut link := new_ssh_link()
    assert(accepts_transport(mut link))
}

test "a link to a closed port fails with network" {
    mut link := new_ssh_link()
    r := link.link_dial("127.0.0.1", 1, "nobody", 2, "")
    assert_eq(error_code_of("{r.error().message()}"), "network")
    link.link_hangup()
}

test "exec over a link returns stdout, stderr and the exit code" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    key_text := try fs.read_text(key_path)
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    sk := try link.link_server_key()
    assert_eq(sk.key_type, "ssh-ed25519")
    assert(sk.fingerprint.starts_with("SHA256:"))
    bad := link.link_auth_password("not-the-password")
    assert_eq(error_code_of("{bad.error().message()}"), "auth")
    try link.link_auth_key(key_text, "")
    try link.link_exec_start("echo out-$((6*7)); echo err-line >&2; cat; exit 7")
    res := try read_all(mut link)
    link.link_hangup()
    assert(res.done)
    assert_eq(res.stdout, "out-42\n")
    assert_eq(res.stderr, "err-line\n")
    assert_eq(res.exit_code, 7)
}

test "a signal is reported instead of an exit code" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    try link.link_auth_key(try fs.read_text(key_path), "")
    try link.link_exec_start("kill -TERM $$")
    res := try read_all(mut link)
    link.link_hangup()
    assert_eq(res.exit_code, -1)
    // libssh 0.10 reports no signal name with the exit state (flint_ssh.hpp).
    if libssh_version().starts_with("0.10") {
        assert_eq(res.signal, "")
    } else {
        assert_eq(res.signal, "TERM")
    }
}

test "a second hop is reached through a tunnel over the first" {
    (port, key_path) := test_target()
    port2 := inner_port()
    if port == 0 || port2 == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT2 not set")
        return
    }
    key_text := try fs.read_text(key_path)
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    try link.link_auth_key(key_text, "")
    try link.link_dial("127.0.0.1", port2, os.getenv("USER"), 5, "")
    outer_fp := try link.hops[0].host_key_sha256()
    inner := try link.link_server_key()
    assert(inner.fingerprint != outer_fp, "the second hop must present its own host key")
    try link.link_auth_key(key_text, "")
    try link.link_exec_start("echo via-jump; head -c 200000 /dev/zero | wc -c")
    res := try read_all(mut link)
    link.link_hangup()
    assert_eq(res.exit_code, 0)
    assert(res.stdout.contains("via-jump"))
    assert(res.stdout.contains("200000"))
}

test "a jump to an unreachable port fails with network and cleans up" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    try link.link_auth_key(try fs.read_text(key_path), "")
    r := link.link_dial("127.0.0.1", 1, os.getenv("USER"), 5, "")
    assert_eq(error_code_of("{r.error().message()}"), "network")
    link.link_hangup()
}

test "the agent authenticates when SSH_AUTH_SOCK holds the key" {
    (port, _) := test_target()
    if port == 0 || os.getenv("FLINT_TEST_AGENT").len() == 0 {
        println("SKIP: FLINT_TEST_AGENT not set")
        return
    }
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    try link.link_auth_agent()
    try link.link_exec_start("true")
    res := try read_all(mut link)
    link.link_hangup()
    assert_eq(res.exit_code, 0)
}

test "a PTY shell over a link follows a resize" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    try link.link_auth_key(try fs.read_text(key_path), "")
    try link.link_shell_open("xterm-256color", 80, 24, "")
    try link.link_channel_resize(132, 43)
    try link.link_channel_write("stty size; exit 5\n")
    res := try read_all(mut link)
    link.link_hangup()
    assert(res.stdout.contains("43 132"))
    assert_eq(res.exit_code, 5)
}

test "a PTY session runs an initial command, then ends or keeps a login shell" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    // The command lines domain.initial_command_line builds (D-031, D-032).
    mut once := new_ssh_link()
    try once.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    try once.link_auth_key(try fs.read_text(key_path), "")
    try once.link_shell_open("xterm-256color", 80, 24, "exec \"$SHELL\" -ilc 'echo started-$((40+2)); [ -t 0 ] && echo on-a-tty; exit 3'")
    ran := try read_all(mut once)
    once.link_hangup()
    assert(ran.stdout.contains("started-42"))
    assert(ran.stdout.contains("on-a-tty"))
    assert_eq(ran.exit_code, 3)

    mut kept := new_ssh_link()
    try kept.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    try kept.link_auth_key(try fs.read_text(key_path), "")
    try kept.link_shell_open("xterm-256color", 80, 24, "\"$SHELL\" -ilc 'echo first-done'; exec \"$SHELL\" -l")
    try kept.link_channel_write("echo then-$((6*7)); exit 5\n")
    rest := try read_all(mut kept)
    kept.link_hangup()
    assert(rest.stdout.contains("first-done"))
    assert(rest.stdout.contains("then-42"))
    assert_eq(rest.exit_code, 5)
}

test "a recorded key type is negotiated first, and only when the server has it" {
    (port, _) := test_target()
    port2 := inner_port()
    if port == 0 || port2 == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT2 not set")
        return
    }
    // The first test sshd has an ed25519 and an ECDSA host key; libssh prefers
    // ed25519 by default.
    mut plain := new_ssh_link()
    try plain.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    assert_eq((try plain.link_server_key()).key_type, "ssh-ed25519")
    plain.link_hangup()
    known: []KnownHost = [KnownHost{ addr: "[127.0.0.1]:{port}", key_type: "ecdsa-sha2-nistp256", fingerprint: "", host_id: "", added_at: "" }]
    algos := preferred_host_key_algos(known, known_host_addr("127.0.0.1", i64(port)))
    mut pinned := new_ssh_link()
    try pinned.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, algos)
    assert_eq((try pinned.link_server_key()).key_type, "ecdsa-sha2-nistp256")
    pinned.link_hangup()
    // The second sshd has only ed25519: the preference is not a requirement, so the
    // handshake still completes and the domain check reports the key as changed.
    mut fallback := new_ssh_link()
    try fallback.link_dial("127.0.0.1", port2, os.getenv("USER"), 5, algos)
    assert_eq((try fallback.link_server_key()).key_type, "ssh-ed25519")
    fallback.link_hangup()
}

test "OpenSSH's known_hosts files are not read" {
    (port, _) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT not set")
        return
    }
    // libssh reorders host key algorithms by those files, which would override the
    // vault's preferred key type (a false "host key changed" on a host whose
    // ~/.ssh/known_hosts lists another type).
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    session := link.hops[0].session
    mut user_file := ""
    mut global_file := ""
    // CFIRE-UPSTREAM: CF-005
    cpp {
        char* v = nullptr;
        if (ssh_options_get(session, SSH_OPTIONS_KNOWNHOSTS, &v) == SSH_OK && v) { user_file = v; ssh_string_free_char(v); }
        v = nullptr;
        if (ssh_options_get(session, SSH_OPTIONS_GLOBAL_KNOWNHOSTS, &v) == SSH_OK && v) { global_file = v; ssh_string_free_char(v); }
    }
    link.link_hangup()
    assert_eq(user_file, "/dev/null")
    assert_eq(global_file, "/dev/null")
}

test "a keepalive goes out mid-session and the channel keeps working" {
    (port, key_path) := test_target()
    if port == 0 {
        println("SKIP: FLINT_TEST_SSH_PORT / FLINT_TEST_SSH_KEY not set")
        return
    }
    mut link := new_ssh_link()
    try link.link_dial("127.0.0.1", i64(port), os.getenv("USER"), 5, "")
    try link.link_auth_key(try fs.read_text(key_path), "")
    try link.link_exec_start("sleep 1; echo still-here")
    try link.link_keepalive()
    _ := try link.link_channel_read(300)
    try link.link_keepalive()
    res := try read_all(mut link)
    link.link_hangup()
    assert(res.done)
    assert_eq(res.stdout, "still-here\n")
    assert_eq(res.exit_code, 0)
}

test "a keepalive on a link with no hop fails with network" {
    mut link := new_ssh_link()
    r := link.link_keepalive()
    assert(!r.has_value())
}
