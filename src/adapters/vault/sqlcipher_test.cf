test "a vault at schema 1 upgrades to the latest and keeps its rows" {
    path := temp_vault_path("v.flint")
    // Build a schema-1 vault the way milestone 02 wrote it.
    mut db := try open_cipher_db(path, test_key(7), test_salt_bytes(), true)
    try db.exec("CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    try db.apply_migration(vault_migrations()[0])
    try db.exec("INSERT INTO hosts (id, alias, label, hostname, port, username, color, notes) VALUES ('h1', 'web', '', 'web.example.org', 22, 'u', '', '');")
    db.close_db()
    mut store := new_sql_vault_store()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    assert_eq(try store.conn().query_text("SELECT max(version) FROM schema_migrations;"), "{vault_migrations().len()}")
    assert_eq((try store.hosts_all()).len(), 1)
    assert_eq((try store.known_hosts_all()).len(), 0)
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "known hosts round-trip, replace by address and survive host removal" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    try store.host_put(marker_host())
    try store.known_host_put(KnownHost{ addr: "[db01.internal.example.org]:2201", key_type: "ssh-ed25519", fingerprint: "SHA256:one", host_id: "h1", added_at: "" })
    try store.known_host_put(KnownHost{ addr: "[DB01.internal.example.org]:2201", key_type: "ssh-ed25519", fingerprint: "SHA256:two", host_id: "h1", added_at: "" })
    list := try store.known_hosts_all()
    assert_eq(list.len(), 1)
    assert_eq(list[0].fingerprint, "SHA256:two")
    assert_eq(list[0].host_id, "h1")
    assert(list[0].added_at.ends_with("Z"))
    try store.host_drop("h1")
    after := try store.known_hosts_all()
    assert_eq(after.len(), 1)
    assert_eq(after[0].host_id, "")
    try store.known_host_drop(after[0].addr)
    assert_eq((try store.known_hosts_all()).len(), 0)
    store.vault_detach()
    raw := try fs.read_text(path)
    assert(!raw.contains("db01.internal"), "known host addresses must not leak")
    try fs.remove(fs.dirname(path))
}

// Negative control: the same write without a key must leak, or the scans above prove
// nothing.
test "control: an unkeyed sqlite file does expose the hostname" {
    path := temp_vault_path("plain.db")
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-007
    cpp {
        sqlite3* db = nullptr;
        rc = sqlite3_open(path.c_str(), &db);
        if (rc == SQLITE_OK) rc = sqlite3_exec(db, "CREATE TABLE hosts (hostname TEXT); INSERT INTO hosts VALUES ('db01.internal.example.org');", nullptr, nullptr, nullptr);
        sqlite3_close(db);
    }
    assert_eq(rc, 0)
    raw := try fs.read_text(path)
    assert(raw.contains("SQLite format 3"))
    assert(raw.contains("db01.internal.example.org"))
    try fs.remove(fs.dirname(path))
}

fn marker_token(id: str, name: str, revoked_at: i64) -> Token {
    return Token{ id: id, name: name, hash: "ab" + id, scope: AccessScope{ all: false, groups: ["g1", "g2"], hosts: ["h1"] }, read: true, exec: true, write: false, created_at: 100, expires_at: 200, revoked_at: revoked_at }
}

fn marker_entry(n: i64) -> ActivityEntry {
    return ActivityEntry{ id: 0, at: 1000 + n, caller: "flint-caller-marker", via: ACTIVITY_VIA_GRANT, token: "", action: ACCESS_EXEC, host: "flint-activity-host-marker", command: "flint exec web -- flint-activity-command-marker {n}", outcome: ACTIVITY_ALLOWED, cut: 0 }
}

test "tokens and activity round-trip, stay encrypted, and the log keeps by age" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    try store.token_put(marker_token("t1", "flint-token-name-marker", 0))
    try store.token_put(marker_token("t2", "other", 0))
    try store.token_put(marker_token("t1", "flint-token-name-marker", 150))
    try attach_test_activity(mut store, path, 8)
    tokens := try store.tokens_all()
    assert_eq(tokens.len(), 2)
    assert_eq(tokens[0].id, "t1")
    assert_eq(tokens[0].revoked_at, 150)
    assert_eq(tokens[0].scope.groups.len(), 2)
    assert_eq(tokens[0].scope.groups[1], "g2")
    assert_eq(tokens[0].scope.hosts[0], "h1")
    assert(!tokens[0].scope.all)
    assert(tokens[0].read && tokens[0].exec && !tokens[0].write)
    assert_eq(tokens[0].expires_at, 200)
    assert_eq(tokens[0].hash, "abt1")

    // Kept from 1002 on: the two oldest go as the later ones arrive.
    for n in 0..5 {
        try store.activity_add(marker_entry(n), ActivityKeep{ since_at: 1002, max_bytes: ACTIVITY_MAX_BYTES })
    }
    page := try store.activity_page(0, 10)
    assert_eq(page.len(), 3)
    assert_eq(page[0].at, 1004)
    assert_eq(page[2].at, 1002)
    assert_eq(page[0].host, "flint-activity-host-marker")
    assert_eq(page[0].outcome, ACTIVITY_ALLOWED)
    older := try store.activity_page(page[0].id, 1)
    assert_eq(older.len(), 1)
    assert_eq(older[0].at, 1003)
    store.vault_detach()

    raw := try fs.read_text(path)
    for needle in ["flint-token-name-marker", "flint-caller-marker", "flint-activity-host-marker", "flint-activity-command-marker", "CREATE TABLE tokens"] {
        assert(!raw.contains(needle), "leaked: {needle}")
    }
    // The log is in the activity file, encrypted too, and never in the vault.
    act_raw := try fs.read_text(activity_file(path))
    for needle in ["flint-caller-marker", "flint-activity-host-marker", "flint-activity-command-marker", "CREATE TABLE activity"] {
        assert(!act_raw.contains(needle), "leaked from the activity file: {needle}")
    }
    try fs.remove(fs.dirname(path))
}

test "a vault at schema 3 gains empty tokens and activity" {
    path := temp_vault_path("v.flint")
    mut db := try open_cipher_db(path, test_key(7), test_salt_bytes(), true)
    try db.exec("CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    try db.apply_migration(vault_migrations()[0])
    try db.apply_migration(vault_migrations()[1])
    try db.apply_migration(vault_migrations()[2])
    try db.exec("INSERT INTO hosts (id, alias, label, hostname, port, username, color, notes) VALUES ('h1', 'web', '', 'web.example.org', 22, 'u', '', '');")
    db.close_db()
    mut store := new_sql_vault_store()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    assert_eq(try store.conn().query_text("SELECT max(version) FROM schema_migrations;"), "{vault_migrations().len()}")
    assert_eq((try store.hosts_all()).len(), 1)
    assert_eq((try store.tokens_all()).len(), 0)
    try attach_test_activity(mut store, path, 8)
    assert_eq((try store.activity_page(0, 10)).len(), 0)
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "a vault at schema 4 gains an empty sudo password per host" {
    path := temp_vault_path("v.flint")
    mut db := try open_cipher_db(path, test_key(7), test_salt_bytes(), true)
    try db.exec("CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    for i in 0..4 {
        try db.apply_migration(vault_migrations()[i])
    }
    try db.exec("INSERT INTO hosts (id, alias, label, hostname, port, username, color, notes, password) VALUES ('h1', 'web', '', 'web.example.org', 22, 'u', '', '', x'010203');")
    db.close_db()
    mut store := new_sql_vault_store()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    assert_eq(try store.conn().query_text("SELECT max(version) FROM schema_migrations;"), "{vault_migrations().len()}")
    hosts := try store.hosts_all()
    assert_eq(hosts.len(), 1)
    assert_eq(hosts[0].sudo_password.len(), 0)
    assert_eq(hosts[0].password.len(), 3)
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "a host's sudo password round-trips and stays encrypted" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    mut h := marker_host()
    h.sudo_password = []byte("flint-sudo-marker")
    try store.host_put(h)
    got := try store.hosts_all()
    assert(got[0].sudo_password == []byte("flint-sudo-marker"))
    h.sudo_password = []
    try store.host_put(h)
    assert_eq((try store.hosts_all())[0].sudo_password.len(), 0)
    h.sudo_password = []byte("flint-sudo-marker")
    try store.host_put(h)
    store.vault_detach()
    raw := try fs.read_text(path)
    assert(!raw.contains("flint-sudo-marker"), "the sudo password must not leak")
    try fs.remove(fs.dirname(path))
}

test "a vault at schema 5 keeps its activity, whole and uncut" {
    path := temp_vault_path("v.flint")
    mut db := try open_cipher_db(path, test_key(7), test_salt_bytes(), true)
    try db.exec("CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    for i in 0..5 {
        try db.apply_migration(vault_migrations()[i])
    }
    try db.exec("INSERT INTO activity (at, caller, via, action, host, command, outcome) VALUES (5, 'c', 'grant', 'exec', 'web', 'flint exec web -- uptime', 'allowed');")
    db.close_db()
    mut store := new_sql_vault_store()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    assert_eq(try store.conn().query_text("SELECT max(version) FROM schema_migrations;"), "{vault_migrations().len()}")
    try attach_test_activity(mut store, path, 8)
    page := try store.activity_page(0, 10)
    assert_eq(page.len(), 1)
    assert_eq(page[0].command, "flint exec web -- uptime")
    assert_eq(page[0].cut, 0)
    assert_eq(try store.activity_retention(), -1)
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "the activity log keeps a cut, its retention, and stays under its size cap" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    try attach_test_activity(mut store, path, 8)
    mut e := marker_entry(0)
    e.cut = 42
    try store.activity_add(e, ActivityKeep{ since_at: 0, max_bytes: ACTIVITY_MAX_BYTES })
    assert_eq((try store.activity_page(0, 1))[0].cut, 42)

    try store.set_activity_retention(365)
    assert_eq(try store.activity_retention(), 365)
    try store.set_activity_retention(0)
    assert_eq(try store.activity_retention(), 0)

    // Each marker entry is about 160 bytes with its row cost: a cap of 500 keeps 3.
    for n in 1..10 {
        try store.activity_add(marker_entry(n), ActivityKeep{ since_at: 0, max_bytes: 500 })
    }
    kept := try store.activity_page(0, 20)
    assert(kept.len() >= 1 && kept.len() <= 3, "kept {kept.len()}")
    assert_eq(kept[0].at, 1009)
    // A single entry over the cap is still kept: the newest always stays.
    assert_eq(try store.activity_prune(ActivityKeep{ since_at: 0, max_bytes: 1 }), i64(kept.len()) - 1)
    assert_eq((try store.activity_page(0, 20)).len(), 1)

    assert_eq(try store.activity_count_before(2000), 1)
    assert_eq(try store.activity_count_before(1009), 0)
    // The newest stays even when it is older than the retention.
    assert_eq(try store.activity_prune(ActivityKeep{ since_at: 5000, max_bytes: 0 }), 0)
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "a vault at schema 6 gains tunnels that round-trip, stay encrypted and go with their host" {
    path := temp_vault_path("v.flint")
    mut db := try open_cipher_db(path, test_key(7), test_salt_bytes(), true)
    try db.exec("CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    for i in 0..6 {
        try db.apply_migration(vault_migrations()[i])
    }
    db.close_db()
    mut store := new_sql_vault_store()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    assert_eq(try store.conn().query_text("SELECT max(version) FROM schema_migrations;"), "{vault_migrations().len()}")
    assert_eq((try store.tunnels_all()).len(), 0)
    h := marker_host()
    try store.host_put(h)
    t := Tunnel{ id: "t1", host_id: h.id, name: "flint-tunnel-marker", local_port: 15432, dest_host: "flint-dest-marker.internal", dest_port: 5432, open_on_connect: true }
    try store.tunnel_put(t)
    mut moved := t
    moved.local_port = 15433
    moved.open_on_connect = false
    try store.tunnel_put(moved)
    got := try store.tunnels_all()
    assert_eq(got.len(), 1)
    assert_eq(got[0].local_port, 15433)
    assert(!got[0].open_on_connect)
    assert_eq(got[0].dest_host, "flint-dest-marker.internal")
    // A name is unique in its host, whatever its case.
    mut r := ""
    store.tunnel_put(Tunnel{ id: "t2", host_id: h.id, name: "FLINT-TUNNEL-MARKER", local_port: 1, dest_host: "x", dest_port: 1, open_on_connect: false }) or err { r = "{err.message()}" }
    assert(r.len() > 0)
    // A tunnel needs its host.
    r = ""
    store.tunnel_put(Tunnel{ id: "t3", host_id: "nobody", name: "x", local_port: 1, dest_host: "x", dest_port: 1, open_on_connect: false }) or err { r = "{err.message()}" }
    assert(r.len() > 0)
    store.vault_detach()
    raw := try fs.read_text(path)
    for needle in ["flint-tunnel-marker", "flint-dest-marker"] {
        assert(!raw.contains(needle), "leaked: {needle}")
    }
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    try store.host_drop(h.id)
    assert_eq((try store.tunnels_all()).len(), 0)
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

// Builds a vault at schema 8 (before milestone 39) holding `n` activity rows and a
// retention of 365 days.
fn vault_at_schema_8(path: str, n: i64) -> void! {
    mut db := try open_cipher_db(path, test_key(7), test_salt_bytes(), true)
    try db.exec("CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    for i in 0..8 {
        try db.apply_migration(vault_migrations()[i])
    }
    for k in 0..n {
        try db.run_sql("INSERT INTO activity (at, caller, via, action, host, command, outcome, command_cut) VALUES (?1, 'flint-old-caller-marker', 'grant', 'exec', 'web', ?2, 'allowed', ?3);", [sql_int(100 + k), sql_text("flint exec web -- flint-old-command-marker {k}"), sql_int(k)])
    }
    try db.exec("INSERT INTO meta (key, value) VALUES ('activity_retention_days', '365');")
    db.close_db()
}

fn has_table(store: SqlVaultStore, name: str) -> bool! {
    res := try store.conn().query_cells("SELECT count(*) FROM sqlite_master WHERE type = 'table' AND name = ?1;", [sql_text(name)])
    return cell_i64(res[0][0]) > 0
}

test "an older vault's activity moves to the machine's file, whole, and leaves the vault" {
    path := temp_vault_path("v.flint")
    try vault_at_schema_8(path, 3)
    mut store := new_sql_vault_store()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    // Until the activity file is open the rows wait in the vault, renamed.
    assert(try has_table(store, "activity_moving"))
    assert(!(try has_table(store, "activity")))
    try attach_test_activity(mut store, path, 8)
    page := try store.activity_page(0, 10)
    assert_eq(page.len(), 3)
    assert_eq(page[0].at, 102)
    assert_eq(page[0].cut, 2)
    assert_eq(page[2].command, "flint exec web -- flint-old-command-marker 0")
    assert_eq(try store.activity_retention(), 365)
    // Gone from the vault: the table and the retention.
    assert(!(try has_table(store, "activity_moving")))
    assert_eq(try store.vault_get_meta("activity_retention_days"), "")
    // New entries follow the moved ones.
    try store.activity_add(marker_entry(9), ActivityKeep{ since_at: 0, max_bytes: ACTIVITY_MAX_BYTES })
    assert_eq((try store.activity_page(0, 10)).len(), 4)
    store.vault_detach()
    raw := try fs.read_text(path)
    assert(!raw.contains("flint-old-command-marker"), "the moved rows must not stay readable in the vault")
    // A second unlock moves nothing again.
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    try attach_test_activity(mut store, path, 8)
    assert_eq((try store.activity_page(0, 10)).len(), 4)
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "a move cut short is finished at the next attach, without a duplicate" {
    path := temp_vault_path("v.flint")
    try vault_at_schema_8(path, 2)
    mut store := new_sql_vault_store()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    try attach_test_activity(mut store, path, 8)
    store.vault_detach()
    // As if the vault's drop never happened: the rows are back in `activity_moving`.
    mut db := try open_cipher_db(path, test_key(7), test_salt_bytes(), false)
    try db.exec("CREATE TABLE activity_moving (id INTEGER PRIMARY KEY AUTOINCREMENT, at INTEGER NOT NULL, caller TEXT NOT NULL, via TEXT NOT NULL, token_id TEXT NOT NULL DEFAULT '', action TEXT NOT NULL, host TEXT NOT NULL DEFAULT '', command TEXT NOT NULL, outcome TEXT NOT NULL, command_cut INTEGER NOT NULL DEFAULT 0);")
    try db.exec("INSERT INTO activity_moving (id, at, caller, via, action, host, command, outcome) VALUES (1, 100, 'c', 'grant', 'exec', 'web', 'one', 'allowed'), (2, 101, 'c', 'grant', 'exec', 'web', 'two', 'allowed');")
    db.close_db()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    try attach_test_activity(mut store, path, 8)
    assert_eq((try store.activity_page(0, 10)).len(), 2)
    assert(!(try has_table(store, "activity_moving")))
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "the activity file is private, closes with the vault, and a key it refuses starts a new one" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    mut missing := ""
    store.activity_attach(TEST_VAULT_ID, test_key(8), test_salt_bytes()) or err { missing = "{err.message()}" }
    assert(missing.contains("no activity folder"), missing)
    store.act_dir = fs.dirname(path) + "/activity"
    mut bad := ""
    store.activity_attach("../escape", test_key(8), test_salt_bytes()) or err { bad = "{err.message()}" }
    assert(bad.contains("bad vault id"), bad)
    try store.activity_attach(TEST_VAULT_ID, test_key(8), test_salt_bytes())
    try store.activity_add(marker_entry(1), ActivityKeep{ since_at: 0, max_bytes: ACTIVITY_MAX_BYTES })
    mut mode: i64 = 0
    mut dir_mode: i64 = 0
    file := activity_file(path)
    folder := fs.dirname(file)
    // CFIRE-UPSTREAM: CF-099
    cpp {
        struct stat st{};
        if (::stat(file.c_str(), &st) == 0) mode = st.st_mode & 0777;
        if (::stat(folder.c_str(), &st) == 0) dir_mode = st.st_mode & 0777;
    }
    assert_eq(mode, i64(384))
    assert_eq(dir_mode, i64(448))
    store.vault_detach()
    mut closed := ""
    store.activity_page(0, 1) or err { closed = "{err.message()}" }
    assert_eq(error_code_of(closed), ERR_LOCKED)
    // Another key: the old file is kept aside and a new, empty log begins.
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    try store.activity_attach(TEST_VAULT_ID, test_key(9), test_salt_bytes())
    assert_eq((try store.activity_page(0, 10)).len(), 0)
    assert(fs.exists(file + ".unreadable"))
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "an activity backup is the encrypted file, opened only with its key" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    try attach_test_activity(mut store, path, 8)
    try store.activity_add(marker_entry(1), ActivityKeep{ since_at: 0, max_bytes: ACTIVITY_MAX_BYTES })
    dest := fs.dirname(path) + "/backup.db"
    try store.activity_backup(dest)
    mut inside := ""
    store.activity_backup(activity_file(path)) or err { inside = "{err.message()}" }
    assert_eq(error_code_of(inside), ERR_INVALID)
    store.vault_detach()
    raw := try fs.read_text(dest)
    assert(!raw.contains("flint-activity-command-marker"), "a backup stays encrypted")
    mut db := try open_cipher_db(dest, test_key(8), test_salt_bytes(), false)
    assert_eq(try db.query_text("SELECT count(*) FROM activity;"), "1")
    db.close_db()
    mut wrong := ""
    open_cipher_db(dest, test_key(9), test_salt_bytes(), false) or err { wrong = "{err.message()}" }
    assert_eq(error_code_of(wrong), ERR_WRONG_PASSWORD)
    try fs.remove(fs.dirname(path))
}
