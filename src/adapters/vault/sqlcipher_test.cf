package vault

import "core:fs"
import "core:encoding/hex"
import "core:crypto/sha256"
import "../../ports"
import "../../domain"

// Migration 001 as shipped. An applied migration must never change (Principle 10);
// if this test fails, revert the edit and append a new migration instead.
MIGRATION_001_SHA256: str = "9ed7d684e513f15455c31c2680407da618820c08eddb64d23796129919be5afd"
MIGRATION_002_SHA256: str = "9973529e84f0c738288de9b0187a5b48810ced2b269bda6d248571e1442beeb7"
MIGRATION_003_SHA256: str = "d68639a62a93d26076581b02403eb1f9f3b4df0c6f9807842988940fb5b64b9c"
MIGRATION_004_SHA256: str = "05c65140fa57a387055c58982a185aa12b1a4d28871ac9499a36201dc5ef33da"

fn temp_vault_path(name: str) -> str {
    dir := "/tmp/flint-test-" + hex.encode(sha256.random_bytes(8))
    _ := fs.mkdir_all(dir)
    return dir + "/" + name
}

fn test_key(seed: u8) -> []byte {
    mut k := make([]byte, 32)
    for i in 0..32 {
        k[i] = byte(seed)
    }
    return k
}

fn test_salt_bytes() -> []byte {
    mut s := make([]byte, 16)
    for i in 0..16 {
        s[i] = byte(160 + i)
    }
    return s
}

fn marker_host() -> Host {
    return Host{ id: "h1", alias: "flint-alias-marker", label: "flint-label-marker", hostname: "db01.internal.example.org", port: 2201, username: "flint-user-marker", group_id: "", tags: ["flint-tag-marker", "prod"], color: "#112233", notes: "flint-notes-marker", jump_host_id: "", credential_id: "", key_id: "", password: [byte(1), byte(2), byte(3)], initial_command: "flint-command-marker", keep_shell: false }
}

// Compiles only if SqlVaultStore satisfies the VaultStore port.
fn store_port_check[S: VaultStore](mut s: S) -> bool {
    hosts := s.hosts_all() or err { return false }
    return hosts.len() >= 0
}

test "a v1 vault keeps its salt in the header and leaks no plaintext" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    try store.group_put(Group{ id: "g1", parent_id: "", name: "flint-group-marker" })
    mut h := marker_host()
    h.group_id = "g1"
    try store.host_put(h)
    try store.vault_set_meta("name", "flint-vaultname-marker")
    store.vault_detach()

    salt := try store.vault_read_salt(path)
    assert(salt == test_salt_bytes(), "the salt must be the file's first 16 bytes")

    raw := try fs.read_text(path)
    assert(raw.len() >= 4096)
    for needle in ["SQLite format 3", "CREATE TABLE", "db01.internal.example.org", "flint-alias-marker", "flint-label-marker", "flint-user-marker", "flint-tag-marker", "flint-notes-marker", "flint-command-marker", "flint-group-marker", "flint-vaultname-marker", "argon2id13"] {
        assert(!raw.contains(needle), "leaked: {needle}")
    }
    try fs.remove(fs.dirname(path))
}

test "rows round-trip and migrations are idempotent" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    try store.host_put(marker_host())
    store.vault_detach()

    try store.vault_attach(path, test_key(7), test_salt_bytes())
    assert_eq(try store.vault_format(), 1)
    hosts := try store.hosts_all()
    assert_eq(hosts.len(), 1)
    assert_eq(hosts[0].hostname, "db01.internal.example.org")
    assert_eq(hosts[0].port, 2201)
    assert_eq(hosts[0].tags.len(), 2)
    assert_eq(hosts[0].tags[0], "flint-tag-marker")
    assert(hosts[0].password == marker_host().password)
    assert_eq(hosts[0].group_id, "")
    assert_eq(hosts[0].initial_command, "flint-command-marker")
    assert(!hosts[0].keep_shell)
    applied := try store.conn().query_text("SELECT count(*) FROM schema_migrations;")
    assert_eq(applied, "{vault_migrations().len()}")

    // Update in place keeps one row and replaces the tags.
    mut h := hosts[0]
    h.tags = ["only"]
    h.password = []
    try store.host_put(h)
    again := try store.hosts_all()
    assert_eq(again.len(), 1)
    assert_eq(again[0].tags.len(), 1)
    assert_eq(again[0].password.len(), 0)

    // Credentials round-trip too, insert and update (the host columns of migration
    // 003 are not theirs).
    try store.cred_put(Credential{ id: "c1", name: "ops", username: "deploy", key_id: "", password: [byte(4), byte(5)] })
    try store.cred_put(Credential{ id: "c1", name: "ops", username: "deploy2", key_id: "", password: [] })
    creds := try store.creds_all()
    assert_eq(creds.len(), 1)
    assert_eq(creds[0].username, "deploy2")

    try store.host_drop(h.id)
    assert_eq((try store.hosts_all()).len(), 0)
    assert_eq(try store.conn().query_text("SELECT count(*) FROM host_tags;"), "0")
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "the pinned SQLCipher parameters are in force and recorded" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    assert_eq(try store.conn().query_text("PRAGMA cipher_page_size;"), CIPHER_PAGE_SIZE)
    assert_eq(try store.conn().query_text("PRAGMA cipher_hmac_algorithm;"), CIPHER_HMAC_ALGORITHM)
    assert_eq(try store.conn().query_text("PRAGMA cipher_kdf_algorithm;"), CIPHER_KDF_ALGORITHM)
    assert_eq(try store.vault_get_meta("cipher_compatibility"), CIPHER_COMPATIBILITY)
    assert_eq(try store.vault_get_meta("cipher_page_size"), CIPHER_PAGE_SIZE)
    assert_eq(try store.vault_get_meta("kdf_ops"), "{VAULT_ARGON2_OPS}")
    assert_eq(try store.vault_get_meta("kdf_mem_bytes"), "{VAULT_ARGON2_MEM}")
    assert_eq(try store.conn().query_text("PRAGMA foreign_keys;"), "1")
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "a wrong key or salt is reported as wrong_password" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    store.vault_detach()
    bad := store.vault_attach(path, test_key(8), test_salt_bytes())
    assert(!bad.has_value())
    assert_eq(error_code_of("{bad.error().message()}"), "wrong_password")
    mut other_salt := test_salt_bytes()
    other_salt[0] = byte(1)
    assert(!store.vault_attach(path, test_key(7), other_salt).has_value())
    try fs.remove(fs.dirname(path))
}

test "create refuses an existing file and attach a missing one" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    store.vault_detach()
    dup := store.vault_create(path, test_key(7), test_salt_bytes())
    assert_eq(error_code_of("{dup.error().message()}"), "conflict")
    missing := store.vault_attach(path + ".nope", test_key(7), test_salt_bytes())
    assert_eq(error_code_of("{missing.error().message()}"), "not_found")
    try fs.remove(fs.dirname(path))
}

test "foreign keys and unique names are enforced" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    mut h := marker_host()
    h.group_id = "missing"
    dangling := store.host_put(h)
    assert_eq(error_code_of("{dangling.error().message()}"), "conflict")
    try store.host_put(marker_host())
    mut twin := marker_host()
    twin.id = "h2"
    twin.alias = "FLINT-ALIAS-MARKER"
    clash := store.host_put(twin)
    assert_eq(error_code_of("{clash.error().message()}"), "conflict")
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "operations on a detached store report locked" {
    store := new_sql_vault_store()
    r := store.hosts_all()
    assert_eq(error_code_of("{r.error().message()}"), "locked")
}

test "SqlVaultStore satisfies the VaultStore port" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    assert(store_port_check(mut store))
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "migration 001 is frozen" {
    assert_eq(sha256.hash_hex(vault_migrations()[0].sql.bytes()), MIGRATION_001_SHA256)
}

test "migration 002 is frozen" {
    assert_eq(sha256.hash_hex(vault_migrations()[1].sql.bytes()), MIGRATION_002_SHA256)
}

test "migration 004 is frozen" {
    assert_eq(sha256.hash_hex(vault_migrations()[3].sql.bytes()), MIGRATION_004_SHA256)
}

test "migration 003 is frozen" {
    assert_eq(sha256.hash_hex(vault_migrations()[2].sql.bytes()), MIGRATION_003_SHA256)
}

test "a vault at schema 2 gains an empty initial command that keeps the shell" {
    path := temp_vault_path("v.flint")
    // A schema-2 vault as milestones 03-05 wrote it.
    mut db := try open_cipher_db(path, test_key(7), test_salt_bytes(), true)
    try db.exec("CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    try db.apply_migration(vault_migrations()[0])
    try db.apply_migration(vault_migrations()[1])
    try db.exec("INSERT INTO hosts (id, alias, label, hostname, port, username, color, notes) VALUES ('h1', 'web', '', 'web.example.org', 22, 'u', '', '');")
    db.close_db()
    mut store := new_sql_vault_store()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    assert_eq(try store.conn().query_text("SELECT max(version) FROM schema_migrations;"), "{vault_migrations().len()}")
    hosts := try store.hosts_all()
    assert_eq(hosts.len(), 1)
    assert_eq(hosts[0].initial_command, "")
    assert(hosts[0].keep_shell)
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "a vault at schema 1 upgrades to the latest and keeps its rows" {
    path := temp_vault_path("v.flint")
    // Build a schema-1 vault the way milestone 02 wrote it.
    mut db := try open_cipher_db(path, test_key(7), test_salt_bytes(), true)
    try db.exec("CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    try db.apply_migration(vault_migrations()[0])
    try db.exec("INSERT INTO hosts (id, alias, label, hostname, port, username, color, notes) VALUES ('h1', 'web', '', 'web.example.org', 22, 'u', '', '');")
    db.close_db()
    mut store := new_sql_vault_store()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    assert_eq(try store.conn().query_text("SELECT max(version) FROM schema_migrations;"), "{vault_migrations().len()}")
    assert_eq((try store.hosts_all()).len(), 1)
    assert_eq((try store.known_hosts_all()).len(), 0)
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "known hosts round-trip, replace by address and survive host removal" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    try store.host_put(marker_host())
    try store.known_host_put(KnownHost{ addr: "[db01.internal.example.org]:2201", key_type: "ssh-ed25519", fingerprint: "SHA256:one", host_id: "h1", added_at: "" })
    try store.known_host_put(KnownHost{ addr: "[DB01.internal.example.org]:2201", key_type: "ssh-ed25519", fingerprint: "SHA256:two", host_id: "h1", added_at: "" })
    list := try store.known_hosts_all()
    assert_eq(list.len(), 1)
    assert_eq(list[0].fingerprint, "SHA256:two")
    assert_eq(list[0].host_id, "h1")
    assert(list[0].added_at.ends_with("Z"))
    try store.host_drop("h1")
    after := try store.known_hosts_all()
    assert_eq(after.len(), 1)
    assert_eq(after[0].host_id, "")
    try store.known_host_drop(after[0].addr)
    assert_eq((try store.known_hosts_all()).len(), 0)
    store.vault_detach()
    raw := try fs.read_text(path)
    assert(!raw.contains("db01.internal"), "known host addresses must not leak")
    try fs.remove(fs.dirname(path))
}

// Negative control: the same write without a key must leak, or the scans above prove
// nothing.
test "control: an unkeyed sqlite file does expose the hostname" {
    path := temp_vault_path("plain.db")
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-007
    cpp {
        sqlite3* db = nullptr;
        rc = sqlite3_open(path.c_str(), &db);
        if (rc == SQLITE_OK) rc = sqlite3_exec(db, "CREATE TABLE hosts (hostname TEXT); INSERT INTO hosts VALUES ('db01.internal.example.org');", nullptr, nullptr, nullptr);
        sqlite3_close(db);
    }
    assert_eq(rc, 0)
    raw := try fs.read_text(path)
    assert(raw.contains("SQLite format 3"))
    assert(raw.contains("db01.internal.example.org"))
    try fs.remove(fs.dirname(path))
}

fn marker_token(id: str, name: str, revoked_at: i64) -> Token {
    return Token{ id: id, name: name, hash: "ab" + id, scope: AccessScope{ all: false, groups: ["g1", "g2"], hosts: ["h1"] }, read: true, exec: true, write: false, created_at: 100, expires_at: 200, revoked_at: revoked_at }
}

fn marker_entry(n: i64) -> ActivityEntry {
    return ActivityEntry{ id: 0, at: 1000 + n, caller: "flint-caller-marker", via: ACTIVITY_VIA_GRANT, token: "", action: ACCESS_EXEC, host: "flint-activity-host-marker", command: "flint exec web -- flint-activity-command-marker {n}", outcome: ACTIVITY_ALLOWED }
}

test "tokens and activity round-trip, stay encrypted, and the log keeps the newest" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    try store.token_put(marker_token("t1", "flint-token-name-marker", 0))
    try store.token_put(marker_token("t2", "other", 0))
    try store.token_put(marker_token("t1", "flint-token-name-marker", 150))
    tokens := try store.tokens_all()
    assert_eq(tokens.len(), 2)
    assert_eq(tokens[0].id, "t1")
    assert_eq(tokens[0].revoked_at, 150)
    assert_eq(tokens[0].scope.groups.len(), 2)
    assert_eq(tokens[0].scope.groups[1], "g2")
    assert_eq(tokens[0].scope.hosts[0], "h1")
    assert(!tokens[0].scope.all)
    assert(tokens[0].read && tokens[0].exec && !tokens[0].write)
    assert_eq(tokens[0].expires_at, 200)
    assert_eq(tokens[0].hash, "abt1")

    for n in 0..5 {
        try store.activity_add(marker_entry(n), 3)
    }
    page := try store.activity_page(0, 10)
    assert_eq(page.len(), 3)
    assert_eq(page[0].at, 1004)
    assert_eq(page[2].at, 1002)
    assert_eq(page[0].host, "flint-activity-host-marker")
    assert_eq(page[0].outcome, ACTIVITY_ALLOWED)
    older := try store.activity_page(page[0].id, 1)
    assert_eq(older.len(), 1)
    assert_eq(older[0].at, 1003)
    store.vault_detach()

    raw := try fs.read_text(path)
    for needle in ["flint-token-name-marker", "flint-caller-marker", "flint-activity-host-marker", "flint-activity-command-marker", "CREATE TABLE tokens"] {
        assert(!raw.contains(needle), "leaked: {needle}")
    }
    try fs.remove(fs.dirname(path))
}

test "a vault at schema 3 gains empty tokens and activity" {
    path := temp_vault_path("v.flint")
    mut db := try open_cipher_db(path, test_key(7), test_salt_bytes(), true)
    try db.exec("CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    try db.apply_migration(vault_migrations()[0])
    try db.apply_migration(vault_migrations()[1])
    try db.apply_migration(vault_migrations()[2])
    try db.exec("INSERT INTO hosts (id, alias, label, hostname, port, username, color, notes) VALUES ('h1', 'web', '', 'web.example.org', 22, 'u', '', '');")
    db.close_db()
    mut store := new_sql_vault_store()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    assert_eq(try store.conn().query_text("SELECT max(version) FROM schema_migrations;"), "4")
    assert_eq((try store.hosts_all()).len(), 1)
    assert_eq((try store.tokens_all()).len(), 0)
    assert_eq((try store.activity_page(0, 10)).len(), 0)
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}
