test "an RDP host round-trips its type and domain, which never leak" {
    path := temp_vault_path("v.flint")
    mut store := new_sql_vault_store()
    try store.vault_create(path, test_key(7), test_salt_bytes())
    mut h := marker_host()
    h.host_type = "rdp"
    h.port = 3389
    h.initial_command = ""
    h.domain = "flint-domain-marker"
    try store.host_put(h)
    try store.known_host_put(KnownHost{ addr: "rdp://db01.internal.example.org:3389", key_type: "x509", fingerprint: "AB:CD", host_id: "h1", added_at: "" })
    hosts := try store.hosts_all()
    assert_eq(hosts[0].host_type, "rdp")
    assert_eq(hosts[0].domain, "flint-domain-marker")
    assert_eq((try store.known_hosts_all())[0].key_type, "x509")
    store.vault_detach()
    raw := try fs.read_text(path)
    assert(!raw.contains("flint-domain-marker"), "the domain must not leak")
    assert(!raw.contains("rdp://"), "certificate addresses must not leak")
    try fs.remove(fs.dirname(path))
}

test "a vault at schema 7 gains the type ssh for every host" {
    path := temp_vault_path("v.flint")
    // A schema-7 vault as v6 and v7 wrote it.
    mut db := try open_cipher_db(path, test_key(7), test_salt_bytes(), true)
    try db.exec("CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    for i in 0..7 {
        try db.apply_migration(vault_migrations()[i])
    }
    try db.exec("INSERT INTO hosts (id, alias, label, hostname, port, username, color, notes) VALUES ('h1', 'web', '', 'web.example.org', 22, 'u', '', '');")
    db.close_db()
    mut store := new_sql_vault_store()
    try store.vault_attach(path, test_key(7), test_salt_bytes())
    assert_eq(try store.conn().query_text("SELECT max(version) FROM schema_migrations;"), "{vault_migrations().len()}")
    hosts := try store.hosts_all()
    assert_eq(hosts.len(), 1)
    assert_eq(hosts[0].host_type, "ssh")
    assert_eq(hosts[0].domain, "")
    store.vault_detach()
    try fs.remove(fs.dirname(path))
}

test "migration 003 is frozen" {
    assert_eq(sha256.hash_hex(vault_migrations()[2].sql.bytes()), MIGRATION_003_SHA256)
}

