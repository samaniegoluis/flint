package vault

// SQLCipher connection: the whole vault file (header, schema, rows, journal) is
// encrypted on disk (Principle 5). The page key is a raw 32-byte subkey derived by
// the core with libsodium; SQLCipher's own PBKDF2 is bypassed (D-014, D-017).

// CFIRE-UPSTREAM: CF-007
import cpp "sqlite3.h" @pkg("sqlcipher")
import "core:encoding/hex"

// ---- Format v1 SQLCipher parameters (D-016, D-017) ----------------------------
//
// Applied on every open, before the first page is read, so a SQLCipher upgrade that
// changes its defaults cannot change how a v1 vault is read. Migration 001 records
// the same values in the `meta` table.
var CIPHER_COMPATIBILITY: str = "4"
var CIPHER_PAGE_SIZE: str = "4096"
var CIPHER_HMAC_ALGORITHM: str = "HMAC_SHA512"
var CIPHER_KDF_ALGORITHM: str = "PBKDF2_HMAC_SHA512"
var CIPHER_KDF_ITER: str = "256000"

// SQLite result codes this file branches on.
var SQLITE_NOTADB_CODE: i32 = 26
var SQLITE_CONSTRAINT_CODE: i32 = 19

// A bound parameter or a result column. `kind`: 0 null, 1 integer, 2 text, 3 blob.
type SqlCell struct {
    kind: i32
    int_val: i64
    text_val: str
    blob_val: []byte
}

fn sql_null() -> SqlCell {
    return SqlCell{ kind: 0, int_val: 0, text_val: "", blob_val: [] }
}

fn sql_int(v: i64) -> SqlCell {
    return SqlCell{ kind: 1, int_val: v, text_val: "", blob_val: [] }
}

fn sql_text(v: str) -> SqlCell {
    return SqlCell{ kind: 2, int_val: 0, text_val: v, blob_val: [] }
}

// Text that maps "" to NULL, for optional foreign keys.
fn sql_ref(v: str) -> SqlCell {
    if v.len() == 0 {
        return sql_null()
    }
    return sql_text(v)
}

// A blob that maps an empty slice to NULL, for optional sealed secrets.
fn sql_blob(v: []byte) -> SqlCell {
    if v.len() == 0 {
        return sql_null()
    }
    return SqlCell{ kind: 3, int_val: 0, text_val: "", blob_val: v }
}

// Result rows. A struct, because `[][]SqlCell!` lowers to a matrix of
// `expected<SqlCell>` instead of `expected<matrix>` (CF-032).
type SqlRows struct {
    rows: [][]SqlCell
}

type CipherDb struct {
    // Owned by this value; closed by close_db().
    handle: *mut cpp::sqlite3
}

// Helpers are methods rather than functions taking the pointer: a `*mut T`
// parameter lowers to `const T*&` and the C API rejects it (CF-019).
fn (self: CipherDb) last_error() -> str {
    mut msg := ""
    // CFIRE-UPSTREAM: CF-007
    cpp {
        msg = self.handle ? sqlite3_errmsg(self.handle) : "out of memory";
    }
    return msg
}

fn (self: CipherDb) is_open() -> bool {
    mut open_now := false
    // CFIRE-UPSTREAM: CF-019
    cpp {
        open_now = self.handle != nullptr;
    }
    return open_now
}

// Opens an encrypted database at `path` with a raw 32-byte key and its 16-byte salt.
// With `create`, the file must not exist and SQLCipher writes `salt` into its first
// 16 bytes; without it, the file must exist. A wrong key fails with
// `wrong_password`.
fn open_cipher_db(path: str, key: []byte, salt: []byte, create: bool) -> CipherDb! {
    if key.len() != 32 || salt.len() != 16 {
        return error("internal: vault key must be 32 bytes and salt 16 bytes")
    }
    // SQLCipher raw key-and-salt form: x'<64 hex key><32 hex salt>' skips its PBKDF2
    // step and uses this salt instead of reading (or generating) one.
    mut key_sql := "PRAGMA key = \"x'" + hex.encode(key) + hex.encode(salt) + "'\";"
    pinned := "PRAGMA cipher_compatibility = " + CIPHER_COMPATIBILITY + "; " +
    "PRAGMA cipher_page_size = " + CIPHER_PAGE_SIZE + "; " +
    "PRAGMA cipher_hmac_algorithm = " + CIPHER_HMAC_ALGORITHM + "; " +
    "PRAGMA cipher_kdf_algorithm = " + CIPHER_KDF_ALGORITHM + "; " +
    "PRAGMA kdf_iter = " + CIPHER_KDF_ITER + ";"
    mut handle: *mut cpp::sqlite3
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-007
    cpp {
        int flags = SQLITE_OPEN_READWRITE | SQLITE_OPEN_FULLMUTEX;
        if (create) flags |= SQLITE_OPEN_CREATE;
        rc = sqlite3_open_v2(path.c_str(), &handle, flags, nullptr);
        if (rc == SQLITE_OK) {
            // SQLCipher logs decryption failures to stderr; keep vault errors in our
            // own messages only.
            sqlite3_exec(handle, "PRAGMA cipher_log_level = NONE;", nullptr, nullptr, nullptr);
            rc = sqlite3_exec(handle, key_sql.c_str(), nullptr, nullptr, nullptr);
        }
        // Overwrite the hex key text before the string is freed.
        std::fill(key_sql.begin(), key_sql.end(), '\0');
        if (rc == SQLITE_OK) rc = sqlite3_exec(handle, pinned.c_str(), nullptr, nullptr, nullptr);
        if (rc == SQLITE_OK) {
            // Touch the schema: this is the first read that needs the key, so a wrong
            // key surfaces here as SQLITE_NOTADB.
            rc = sqlite3_exec(handle, "SELECT count(*) FROM sqlite_master;", nullptr, nullptr, nullptr);
        }
        if (rc == SQLITE_OK) {
            // No plaintext temp files, foreign keys enforced, freed pages zeroed.
            rc = sqlite3_exec(handle, "PRAGMA temp_store = MEMORY; PRAGMA foreign_keys = ON; PRAGMA secure_delete = ON;", nullptr, nullptr, nullptr);
        }
    }
    mut db := CipherDb{ handle: handle }
    if rc != 0 {
        msg := db.last_error()
        db.close_db()
        if rc == SQLITE_NOTADB_CODE {
            return error("wrong_password: the password is wrong or the file is not a Flint vault")
        }
        return error("io: cannot open the vault file: " + msg)
    }
    return db
}

// Not named `close`: packages share one C++ namespace, so a user method called
// `close` captures every stdlib `.close()` call in the program (CF-017).
fn (mut self: CipherDb) close_db() {
    // CFIRE-UPSTREAM: CF-007
    cpp {
        if (self.handle) sqlite3_close_v2(self.handle);
    }
    // Assigning `none` to a raw pointer lowers to std::nullopt (CF-019).
    // CFIRE-UPSTREAM: CF-019
    cpp {
        self.handle = nullptr;
    }
}

// Runs one or more statements that take no parameters and return no rows.
fn (self: CipherDb) exec(sql: str) -> void! {
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-007
    cpp {
        rc = sqlite3_exec(self.handle, sql.c_str(), nullptr, nullptr, nullptr);
    }
    if rc != 0 {
        return error(self.statement_error(rc))
    }
}

fn (self: CipherDb) statement_error(rc: i32) -> str {
    if rc == SQLITE_CONSTRAINT_CODE {
        return "conflict: the change breaks a vault constraint (" + self.last_error() + ")"
    }
    return "io: vault statement failed: " + self.last_error()
}

// Runs one statement with bound parameters (?1, ?2, ...) and returns its rows. Use it
// for writes too: they return no rows.
fn (self: CipherDb) query_cells(sql: str, args: []SqlCell) -> SqlRows! {
    mut rc: i32 = 0
    mut result: [][]SqlCell = []
    // CFIRE-UPSTREAM: CF-007
    cpp {
        sqlite3_stmt* st = nullptr;
        rc = sqlite3_prepare_v2(self.handle, sql.c_str(), -1, &st, nullptr);
        for (size_t i = 0; rc == SQLITE_OK && i < args.size(); i++) {
            const auto& a = args[i];
            int idx = static_cast<int>(i) + 1;
            switch (a.kind) {
                case 1: rc = sqlite3_bind_int64(st, idx, a.int_val); break;
                case 2: rc = sqlite3_bind_text(st, idx, a.text_val.data(), static_cast<int>(a.text_val.size()), SQLITE_TRANSIENT); break;
                case 3: rc = sqlite3_bind_blob(st, idx, a.blob_val.data(), static_cast<int>(a.blob_val.size()), SQLITE_TRANSIENT); break;
                default: rc = sqlite3_bind_null(st, idx); break;
            }
        }
        while (rc == SQLITE_OK) {
            int step = sqlite3_step(st);
            if (step == SQLITE_DONE) break;
            if (step != SQLITE_ROW) { rc = step; break; }
            int n = sqlite3_column_count(st);
            std::vector<SqlCell> row;
            row.reserve(n);
            for (int c = 0; c < n; c++) {
                SqlCell cell{};
                switch (sqlite3_column_type(st, c)) {
                    case SQLITE_INTEGER:
                    cell.kind = 1;
                    cell.int_val = sqlite3_column_int64(st, c);
                    break;
                    case SQLITE_TEXT: {
                        cell.kind = 2;
                        const unsigned char* t = sqlite3_column_text(st, c);
                        cell.text_val.assign(reinterpret_cast<const char*>(t), static_cast<size_t>(sqlite3_column_bytes(st, c)));
                        break;
                    }
                    case SQLITE_BLOB: {
                        cell.kind = 3;
                        const auto* b = static_cast<const std::byte*>(sqlite3_column_blob(st, c));
                        int len = sqlite3_column_bytes(st, c);
                        cell.blob_val.assign(b, b + len);
                        break;
                    }
                    default:
                    cell.kind = 0;
                    break;
                }
                row.push_back(std::move(cell));
            }
            result.push_back(std::move(row));
        }
        sqlite3_finalize(st);
    }
    if rc != 0 {
        return error(self.statement_error(rc))
    }
    return SqlRows{ rows: result }
}

// Runs one parameterised statement that returns no rows.
fn (self: CipherDb) run_sql(sql: str, args: []SqlCell) -> void! {
    _ := try self.query_cells(sql, args)
}

// The first column of the first row as text, or "" when there is no row.
fn (self: CipherDb) query_text(sql: str) -> str! {
    res := try self.query_cells(sql, [])
    if res.rows.len() == 0 || res.rows[0].len() == 0 {
        return ""
    }
    return cell_str(res.rows[0][0])
}

fn cell_str(c: SqlCell) -> str {
    if c.kind == 2 {
        return c.text_val
    }
    if c.kind == 1 {
        return "{c.int_val}"
    }
    return ""
}

fn cell_i64(c: SqlCell) -> i64 {
    if c.kind == 1 {
        return c.int_val
    }
    return 0
}

fn cell_bytes(c: SqlCell) -> []byte {
    if c.kind == 3 {
        return c.blob_val
    }
    return []
}

// The SQLCipher version string, e.g. "4.6.1 community".
fn (self: CipherDb) cipher_version() -> str! {
    return self.query_text("PRAGMA cipher_version;")
}

// "<sqlite version> (SQLCipher <cipher version>)", read from an in-memory database.
fn sqlcipher_version() -> str {
    mut v := ""
    // CFIRE-UPSTREAM: CF-007
    cpp {
        sqlite3* db = nullptr;
        std::string cipher = "unknown";
        if (sqlite3_open(":memory:", &db) == SQLITE_OK) {
            sqlite3_stmt* st = nullptr;
            if (sqlite3_prepare_v2(db, "PRAGMA cipher_version;", -1, &st, nullptr) == SQLITE_OK &&
                sqlite3_step(st) == SQLITE_ROW) {
                const unsigned char* t = sqlite3_column_text(st, 0);
                if (t) cipher = reinterpret_cast<const char*>(t);
            }
            sqlite3_finalize(st);
        }
        sqlite3_close(db);
        v = std::string(sqlite3_libversion()) + " (SQLCipher " + cipher + ")";
    }
    return v
}
