package vault

// The `TetherSource` port: reads a Tether vault for the one-shot import (milestone
// 08). The file is plain SQLite, opened read-only through the same SQLCipher build
// as Flint's vault (no key: SQLCipher reads an unencrypted file as SQLite does, and
// Flint links one sqlite3, CF-007). Secrets leave this file still sealed; the core
// opens them with libsodium (Crypto.unseal).
//
// Tether derives its key with Argon2id over 4 lanes. libsodium's crypto_pwhash fixes
// parallelism at 1, which gives another key, so this one derivation goes through the
// reference implementation, libargon2 (D-034). Flint's own vault never uses it.

// CFIRE-UPSTREAM: CF-007
import cpp "sqlite3.h" @pkg("sqlcipher")
// CFIRE-UPSTREAM: CF-006
import cpp "argon2.h" @pkg("libargon2")
import "core:fs"
import "ext:json"
import "../../domain"

// Tether's Argon2id parameters (internal/keystore/crypto.go), pinned by its format.
var TETHER_ARGON2_T: u32 = 1
var TETHER_ARGON2_M_KIB: u32 = 65536
var TETHER_ARGON2_LANES: u32 = 4
var TETHER_KEY_LEN: usize = 32

// The largest key file a Tether host may point to (an RSA-16384 PEM is ~13 KB).
var TETHER_KEY_FILE_MAX: i64 = 65536

type TetherReader struct {
    unused: bool
}

fn new_tether_reader() -> TetherReader {
    return TetherReader{ unused: false }
}

fn open_tether_db(path: str) -> CipherDb! {
    if !fs.exists(path) {
        return error(coded(ERR_NOT_FOUND, "no file at {path}"))
    }
    mut handle: *mut cpp::sqlite3
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-007
    cpp {
        rc = sqlite3_open_v2(path.c_str(), &handle, SQLITE_OPEN_READONLY | SQLITE_OPEN_FULLMUTEX, nullptr);
        if (rc == SQLITE_OK) {
            sqlite3_exec(handle, "PRAGMA cipher_log_level = NONE;", nullptr, nullptr, nullptr);
            rc = sqlite3_exec(handle, "SELECT count(*) FROM sqlite_master;", nullptr, nullptr, nullptr);
        }
    }
    mut db := CipherDb{ handle: handle }
    if rc != 0 {
        db.close_db()
        return error(coded(ERR_INVALID, "{path} is not a Tether vault (not an SQLite file)"))
    }
    return db
}

fn (self: CipherDb) has_table(name: str) -> bool {
    res := self.query_cells("SELECT count(*) FROM sqlite_master WHERE type = 'table' AND name = ?1;", [sql_text(name)]) or err {
        return false
    }
    return res.rows.len() == 1 && cell_i64(res.rows[0][0]) == 1
}

fn (self: CipherDb) tether_setting(key: str) -> str! {
    res := try self.query_cells("SELECT value FROM settings WHERE key = ?1;", [sql_text(key)])
    if res.rows.len() == 0 {
        return ""
    }
    return cell_str(res.rows[0][0])
}

// Tether keeps tags as a JSON array of strings; anything else reads as no tags.
fn tether_tags(text: str) -> []str {
    if text.len() == 0 {
        return []
    }
    tags := json.parse[[]str](text) or err {
        return []
    }
    return tags
}

fn (self: TetherReader) tether_read(path: str) -> TetherFile! {
    mut db := try open_tether_db(path)
    defer db.close_db()
    if !db.has_table("hosts") || !db.has_table("groups") || !db.has_table("settings") {
        return error(coded(ERR_INVALID, "{path} is not a Tether vault (no hosts, groups or settings table)"))
    }
    format := cell_i64((try db.query_cells("PRAGMA user_version;", [])).rows[0][0])
    if format < TETHER_FORMAT_MIN || format > TETHER_FORMAT_MAX {
        return error(coded(ERR_UNSUPPORTED, "this Tether vault has schema version {format}; Flint reads versions {TETHER_FORMAT_MIN} to {TETHER_FORMAT_MAX}"))
    }
    mut f := TetherFile{ format: format, salt_b64: try db.tether_setting("crypto.salt"), verifier_enc: try db.tether_setting("crypto.verifier"), groups: [], hosts: [], keys: [], creds: [], known_hosts: [], tunnels: [] }
    if f.salt_b64.len() == 0 || f.verifier_enc.len() == 0 {
        return error(coded(ERR_UNSUPPORTED, "this Tether vault has no master password set"))
    }

    for r in (try db.query_cells("SELECT id, ifnull(parent_id, ''), name FROM groups ORDER BY \"order\", name;", [])).rows {
        f.groups.push(TetherGroup{ id: cell_str(r[0]), parent_id: cell_str(r[1]), name: cell_str(r[2]) })
    }

    // Columns appear with the schema versions (domain/tether.cf).
    mut cols := "id, ifnull(group_id, ''), label, hostname, port, username, auth_type, tags, color, notes"
    if format >= 2 {
        cols = cols + ", ifnull(key_id, ''), key_path, password_enc"
    } else {
        cols = cols + ", '', '', ''"
    }
    if format >= 3 {
        cols = cols + ", ifnull(credential_id, '')"
    } else {
        cols = cols + ", ''"
    }
    if format >= 4 {
        cols = cols + ", initial_command"
    } else {
        cols = cols + ", ''"
    }
    if format >= 5 {
        cols = cols + ", ifnull(jump_host_id, '')"
    } else {
        cols = cols + ", ''"
    }
    for r in (try db.query_cells("SELECT " + cols + " FROM hosts ORDER BY rowid;", [])).rows {
        f.hosts.push(TetherHost{
                id: cell_str(r[0]),
                group_id: cell_str(r[1]),
                label: cell_str(r[2]),
                hostname: cell_str(r[3]),
                port: cell_i64(r[4]),
                username: cell_str(r[5]),
                auth_type: cell_str(r[6]),
                key_id: cell_str(r[10]),
                key_path: cell_str(r[11]),
                credential_id: cell_str(r[13]),
                jump_host_id: cell_str(r[15]),
                password_enc: cell_str(r[12]),
                tags: tether_tags(cell_str(r[7])),
                color: cell_str(r[8]),
                notes: cell_str(r[9]),
                initial_command: cell_str(r[14]),
        })
    }
    if format >= 2 {
        for r in (try db.query_cells("SELECT id, name, type, fingerprint, private_key_enc, passphrase_enc FROM ssh_keys ORDER BY rowid;", [])).rows {
            f.keys.push(TetherKey{ id: cell_str(r[0]), name: cell_str(r[1]), key_type: cell_str(r[2]), fingerprint: cell_str(r[3]), private_key_enc: cell_str(r[4]), passphrase_enc: cell_str(r[5]) })
        }
        for r in (try db.query_cells("SELECT addr, key_type, fingerprint, ifnull(host_id, ''), created_at FROM known_hosts ORDER BY rowid;", [])).rows {
            f.known_hosts.push(TetherKnownHost{ addr: cell_str(r[0]), key_type: cell_str(r[1]), fingerprint: cell_str(r[2]), host_id: cell_str(r[3]), created_at: cell_str(r[4]) })
        }
    }
    if format >= 3 {
        for r in (try db.query_cells("SELECT id, name, username, auth_type, ifnull(key_id, ''), password_enc FROM credentials ORDER BY rowid;", [])).rows {
            f.creds.push(TetherCredential{ id: cell_str(r[0]), name: cell_str(r[1]), username: cell_str(r[2]), auth_type: cell_str(r[3]), key_id: cell_str(r[4]), password_enc: cell_str(r[5]) })
        }
    }
    if format >= 5 {
        for r in (try db.query_cells("SELECT host_id, name, local_port, remote_host, remote_port FROM tunnels ORDER BY \"order\", rowid;", [])).rows {
            f.tunnels.push(TetherTunnel{ host_id: cell_str(r[0]), name: cell_str(r[1]), local_port: cell_i64(r[2]), remote_host: cell_str(r[3]), remote_port: cell_i64(r[4]) })
        }
    }
    return f
}

// Argon2id(t=1, 64 MiB, 4 lanes) over the password and Tether's 16-byte salt.
fn (self: TetherReader) tether_derive_key(password: str, salt: []byte) -> []byte! {
    if salt.len() < 8 {
        return error(coded(ERR_INVALID, "the Tether vault's salt is damaged"))
    }
    mut key := make([]byte, TETHER_KEY_LEN)
    t := TETHER_ARGON2_T
    m := TETHER_ARGON2_M_KIB
    p := TETHER_ARGON2_LANES
    mut rc: i32 = 0
    // CFIRE-UPSTREAM: CF-006
    cpp {
        rc = argon2id_hash_raw(t, m, p, password.data(), password.size(), salt.data(), salt.size(), key.data(), key.size());
    }
    if rc != 0 {
        return error(coded(ERR_INTERNAL, "Argon2id failed (libargon2 code {rc})"))
    }
    return key
}

fn (self: TetherReader) tether_read_key_file(path: str) -> str! {
    if !fs.exists(path) {
        return error(coded(ERR_NOT_FOUND, "no key file at {path}"))
    }
    size := fs.file_size(path) or err {
        return error(coded(ERR_IO, "cannot read the key file {path}"))
    }
    if size > TETHER_KEY_FILE_MAX {
        return error(coded(ERR_INVALID, "{path} is too large to be a private key"))
    }
    return fs.read_text(path) or err {
        return error(coded(ERR_IO, "cannot read the key file {path}"))
    }
}
