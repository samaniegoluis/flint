package vault

// SessionHolder: which vault a program with several threads has unlocked, and its
// secrets key, shared by every copy (native/flint_vault_lock.hpp). The GUI keeps its
// state here so that unlock and create can run on a worker and the socket server can
// serve the same vault (D-038). Fields go in and out one by one; the driver puts them
// back together as a VaultSession.
//
// `hold()` / `release()` take the holder's operation lock (recursive) for a whole
// operation: an unlock, a vault switch, a command served over the socket. Getters
// and setters take a separate short lock, so a reader never sees half of a write and
// the UI thread never waits for an unlock to finish.

import cpp "flint_vault_lock.hpp"

import "core:json"
import "../../domain"

type SessionHolder struct {
    cell: shared[cpp.flint_vault::SessionCell]
}

type HeldSession struct {
    unlocked:    bool
    path:        str
    name:        str
    id:          str
    secrets_key: []byte
    cached:      bool
}

fn new_session_holder() -> SessionHolder {
    mut h := SessionHolder{}
    // CFIRE-UPSTREAM: CF-026
    cpp {
        h.cell = std::make_shared<flint_vault::SessionCell>();
    }
    return h
}

fn (self: SessionHolder) hold() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        self.cell->op.lock();
    }
}

fn (self: SessionHolder) release() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        self.cell->op.unlock();
    }
}

fn (self: SessionHolder) held() -> HeldSession {
    mut s := HeldSession{ unlocked: false, path: "", name: "", id: "", secrets_key: [], cached: false }
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        s.unlocked = self.cell->unlocked;
        s.path = self.cell->path;
        s.name = self.cell->name;
        s.id = self.cell->id;
        s.secrets_key = self.cell->secrets_key;
        s.cached = self.cell->cached;
    }
    return s
}

fn (self: SessionHolder) put(s: HeldSession) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->wipe();
        self.cell->unlocked = s.unlocked;
        self.cell->path = s.path;
        self.cell->name = s.name;
        self.cell->id = s.id;
        self.cell->secrets_key = s.secrets_key;
        self.cell->cached = s.cached;
    }
}

// Forgets the vault and overwrites its secrets key in the holder.
fn (self: SessionHolder) wipe() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->wipe();
    }
}

// ---- Access state (D-042) --------------------------------------------------------

// Someone used the app or its vault now: the page, a terminal tab, a CLI command.
fn (self: SessionHolder) touch(now_ms: i64) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->last_activity_ms = now_ms;
    }
}

fn (self: SessionHolder) last_activity() -> i64 {
    mut t: i64 = 0
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        t = self.cell->last_activity_ms;
    }
    return t
}

// A CLI asked to unlock `path`; `caller` is the command, as the unlock screen names it.
fn (self: SessionHolder) set_ask(path: str, caller: str) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->ask_path = path;
        self.cell->ask_caller = caller;
    }
}

// The pending unlock request: (path, caller), ("", "") for none.
fn (self: SessionHolder) ask() -> (str, str) {
    mut path := ""
    mut caller := ""
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        path = self.cell->ask_path;
        caller = self.cell->ask_caller;
    }
    return (path, caller)
}

// `path` was locked in this run: it opens again with the master password only.
fn (self: SessionHolder) mark_relocked(path: str) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        auto& v = self.cell->relocked;
        if (std::find(v.begin(), v.end(), path) == v.end()) v.push_back(path);
    }
}

fn (self: SessionHolder) relocked(path: str) -> bool {
    mut found := false
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        auto& v = self.cell->relocked;
        found = std::find(v.begin(), v.end(), path) != v.end();
    }
    return found
}

fn (self: SessionHolder) clear_relocked(path: str) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        auto& v = self.cell->relocked;
        v.erase(std::remove(v.begin(), v.end(), path), v.end());
    }
}

// The auto-lock setting the lock timer follows (LOCK_AFTER), set at start and on save.
fn (self: SessionHolder) set_lock_after(setting: str) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->lock_after = setting;
    }
}

// Settings' *Notify me of commands run under a grant* (milestone 56): what a grant
// the unlock screen gives starts with. Set at start and on save.
fn (self: SessionHolder) set_notify_grants(on: bool) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->notify_grants = on;
    }
}

// Settings' *Allow sudo for a while* (milestone 57): whether the root window may give
// a period and a live one still covers. Set at start and on save.
fn (self: SessionHolder) set_sudo_periods(on: bool) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->sudo_periods = on;
    }
}

fn (self: SessionHolder) sudo_periods() -> bool {
    mut on := false
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        on = self.cell->sudo_periods;
    }
    return on
}

fn (self: SessionHolder) notify_grants() -> bool {
    mut on := true
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        on = self.cell->notify_grants;
    }
    return on
}

fn (self: SessionHolder) lock_after() -> str {
    mut s := ""
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        s = self.cell->lock_after;
    }
    return s
}

// Settings' approval wait (milestone 61), in milliseconds as approval_wait_ms gives
// it. Set at start and on save.
fn (self: SessionHolder) set_approval_wait(ms: i64) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->approval_wait_ms = ms;
    }
}

fn (self: SessionHolder) approval_wait() -> i64 {
    mut ms: i64 = 0
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        ms = self.cell->approval_wait_ms;
    }
    return ms
}

// Why the vault is locked (milestone 61): a domain LOCK_REASON_*, kept until the
// next lock or a failed unlock says otherwise.
fn (self: SessionHolder) set_lock_reason(reason: str) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->lock_reason = reason;
    }
}

fn (self: SessionHolder) lock_reason() -> str {
    mut r := ""
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        r = self.cell->lock_reason;
    }
    return r
}

// The window closed: background loops end.
fn (self: SessionHolder) set_quitting() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->quitting = true;
    }
}

fn (self: SessionHolder) quitting() -> bool {
    mut q := false
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        q = self.cell->quitting;
    }
    return q
}

// ---- Caller approval (milestone 12) -------------------------------------------------

// Takes the access lock for a read-modify-write of the book. Recursive; pair every
// hold with a release.
fn (self: SessionHolder) access_hold() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        self.cell->access_op.lock();
    }
}

fn (self: SessionHolder) access_release() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        self.cell->access_op.unlock();
    }
}

// The grants and waiting approvals. Empty before the first write and after a clear.
fn (self: SessionHolder) access_book() -> AccessBook {
    mut text := ""
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::recursive_mutex> g(self.cell->access_op);
        text = self.cell->access_json;
    }
    if text.len() == 0 {
        return empty_access_book()
    }
    // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
    return json.parse[AccessBook](payload: text) or empty_access_book()
}

fn (self: SessionHolder) put_access_book(book: AccessBook) {
    text := json.stringify(book)
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::recursive_mutex> g(self.cell->access_op);
        self.cell->access_json = text;
    }
}

// Ends every grant and refuses every waiting approval: the vault locked or another
// one was opened.
fn (self: SessionHolder) access_clear() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::recursive_mutex> g(self.cell->access_op);
        self.cell->access_json.clear();
    }
}

// ---- Window lock and Remember (milestone 14) ----------------------------------------

// The window is locked: closed to the tray, it shows only its lock screen until the
// master password or a presence check. The vault and its grants are untouched.
fn (self: SessionHolder) set_window_locked(locked: bool) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->window_locked = locked;
    }
}

fn (self: SessionHolder) window_locked() -> bool {
    mut l := false
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        l = self.cell->window_locked;
    }
    return l
}

// Whether this run knows the key of `path` is remembered on this computer: it
// opened from the keychain, or was unlocked with Remember ticked. The unlock screen
// ticks the box for it, so unlocking it again after a lock keeps it remembered.
fn (self: SessionHolder) set_remembered(path: str, on: bool) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        auto& v = self.cell->remembered;
        v.erase(std::remove(v.begin(), v.end(), path), v.end());
        if (on) v.push_back(path);
    }
}

fn (self: SessionHolder) remembered(path: str) -> bool {
    mut found := false
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        auto& v = self.cell->remembered;
        found = std::find(v.begin(), v.end(), path) != v.end();
    }
    return found
}

// Phone alerts (milestone 63): where they go, from Settings, set at start and on save.
fn (self: SessionHolder) set_alerts(t: AlertTarget) {
    on := t.on
    server := t.server
    topic := t.topic
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->alerts_on = on;
        self.cell->alerts_server = std::string(server);
        self.cell->alerts_topic = std::string(topic);
    }
}

fn (self: SessionHolder) alerts() -> AlertTarget {
    mut on := false
    mut server := ""
    mut topic := ""
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        on = self.cell->alerts_on;
        server = self.cell->alerts_server;
        topic = self.cell->alerts_topic;
    }
    return AlertTarget{ on: on, server: server, topic: topic }
}

// What the page tells about the window (D-136): its focus, and a key or the mouse.
// The focus alone is never input: Flint brings its own window to the front for an
// approval, and that must not make the next one look attended.
fn (self: SessionHolder) set_window_focus(focused: bool, now_ms: i64) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->window_focused = focused;
    }
}

fn (self: SessionHolder) note_input(now_ms: i64) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->last_input_ms = now_ms;
    }
}

// Whether the person is at the window now (domain window_attended).
fn (self: SessionHolder) attended(now_ms: i64) -> bool {
    mut focused := false
    mut last: i64 = 0
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        focused = self.cell->window_focused;
        last = self.cell->last_input_ms;
    }
    return window_attended(focused, last, now_ms)
}

fn (self: SessionHolder) set_alert_status(st: AlertStatus) {
    text := json.stringify(st)
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->alert_status_json = std::string(text);
    }
}

fn (self: SessionHolder) alert_status() -> AlertStatus {
    mut text := ""
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        text = self.cell->alert_status_json;
    }
    if text.len() == 0 {
        return no_alert_status()
    }
    // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
    return json.parse[AlertStatus](payload: text) or no_alert_status()
}
