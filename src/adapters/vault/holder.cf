package vault

// SessionHolder: which vault a program with several threads has unlocked, and its
// secrets key, shared by every copy (native/flint_vault_lock.hpp). The GUI keeps its
// state here so that unlock and create can run on a worker and the socket server can
// serve the same vault (D-038). Fields go in and out one by one; the driver puts them
// back together as a VaultSession.
//
// `hold()` / `release()` take the holder's operation lock (recursive) for a whole
// operation: an unlock, a vault switch, a command served over the socket. Getters
// and setters take a separate short lock, so a reader never sees half of a write and
// the UI thread never waits for an unlock to finish.

import cpp "flint_vault_lock.hpp" @pkg("flint-native")

import "ext:json"
import "../../domain"

type SessionHolder struct {
    cell: shared[cpp::flint_vault::SessionCell]
}

type HeldSession struct {
    unlocked:    bool
    path:        str
    name:        str
    id:          str
    secrets_key: []byte
    cached:      bool
}

fn new_session_holder() -> SessionHolder {
    mut h := SessionHolder{}
    // CFIRE-UPSTREAM: CF-026
    cpp {
        h.cell = std::make_shared<flint_vault::SessionCell>();
    }
    return h
}

fn (self: SessionHolder) hold() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        self.cell->op.lock();
    }
}

fn (self: SessionHolder) release() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        self.cell->op.unlock();
    }
}

fn (self: SessionHolder) held() -> HeldSession {
    mut s := HeldSession{ unlocked: false, path: "", name: "", id: "", secrets_key: [], cached: false }
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        s.unlocked = self.cell->unlocked;
        s.path = self.cell->path;
        s.name = self.cell->name;
        s.id = self.cell->id;
        s.secrets_key = self.cell->secrets_key;
        s.cached = self.cell->cached;
    }
    return s
}

fn (self: SessionHolder) put(s: HeldSession) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->wipe();
        self.cell->unlocked = s.unlocked;
        self.cell->path = s.path;
        self.cell->name = s.name;
        self.cell->id = s.id;
        self.cell->secrets_key = s.secrets_key;
        self.cell->cached = s.cached;
    }
}

// Forgets the vault and overwrites its secrets key in the holder.
fn (self: SessionHolder) wipe() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->wipe();
    }
}

// ---- Access state (D-042) --------------------------------------------------------

// Someone used the app or its vault now: the page, a terminal tab, a CLI command.
fn (self: SessionHolder) touch(now_ms: i64) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->last_activity_ms = now_ms;
    }
}

fn (self: SessionHolder) last_activity() -> i64 {
    mut t: i64 = 0
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        t = self.cell->last_activity_ms;
    }
    return t
}

// A CLI asked to unlock `path`; `caller` is the command, as the unlock screen names it.
fn (self: SessionHolder) set_ask(path: str, caller: str) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->ask_path = path;
        self.cell->ask_caller = caller;
    }
}

// The pending unlock request: (path, caller), ("", "") for none.
fn (self: SessionHolder) ask() -> (str, str) {
    mut path := ""
    mut caller := ""
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        path = self.cell->ask_path;
        caller = self.cell->ask_caller;
    }
    return (path, caller)
}

// `path` was locked in this run: it opens again with the master password only.
fn (self: SessionHolder) mark_relocked(path: str) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        auto& v = self.cell->relocked;
        if (std::find(v.begin(), v.end(), path) == v.end()) v.push_back(path);
    }
}

fn (self: SessionHolder) relocked(path: str) -> bool {
    mut found := false
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        auto& v = self.cell->relocked;
        found = std::find(v.begin(), v.end(), path) != v.end();
    }
    return found
}

fn (self: SessionHolder) clear_relocked(path: str) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        auto& v = self.cell->relocked;
        v.erase(std::remove(v.begin(), v.end(), path), v.end());
    }
}

// The auto-lock setting the lock timer follows (LOCK_AFTER), set at start and on save.
fn (self: SessionHolder) set_lock_after(setting: str) {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->lock_after = setting;
    }
}

fn (self: SessionHolder) lock_after() -> str {
    mut s := ""
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        s = self.cell->lock_after;
    }
    return s
}

// The window closed: background loops end.
fn (self: SessionHolder) set_quitting() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        self.cell->quitting = true;
    }
}

fn (self: SessionHolder) quitting() -> bool {
    mut q := false
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::mutex> g(self.cell->mtx);
        q = self.cell->quitting;
    }
    return q
}

// ---- Caller approval (milestone 12) -------------------------------------------------

// Takes the access lock for a read-modify-write of the book. Recursive; pair every
// hold with a release.
fn (self: SessionHolder) access_hold() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        self.cell->access_op.lock();
    }
}

fn (self: SessionHolder) access_release() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        self.cell->access_op.unlock();
    }
}

// The grants and waiting approvals. Empty before the first write and after a clear.
fn (self: SessionHolder) access_book() -> AccessBook {
    mut text := ""
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::recursive_mutex> g(self.cell->access_op);
        text = self.cell->access_json;
    }
    if text.len() == 0 {
        return empty_access_book()
    }
    return json.parse[AccessBook](text) or empty_access_book()
}

fn (self: SessionHolder) put_access_book(book: AccessBook) {
    text := json.stringify(book)
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::recursive_mutex> g(self.cell->access_op);
        self.cell->access_json = text;
    }
}

// Ends every grant and refuses every waiting approval: the vault locked or another
// one was opened.
fn (self: SessionHolder) access_clear() {
    // CFIRE-UPSTREAM: CF-026
    cpp {
        std::lock_guard<std::recursive_mutex> g(self.cell->access_op);
        self.cell->access_json.clear();
    }
}
