fn (mut self: LockedVaultStore) activity_attach(vault_id: str, key: []byte, new_salt: []byte) -> void! {
    mut inner := self.enter()
    defer self.leave_with(inner)
    return inner.activity_attach(vault_id, key, new_salt)
}

// Holds the mutex for the copy, so no write lands in the middle of it.
fn (self: LockedVaultStore) activity_backup(dest: str) -> void! {
    inner := self.enter()
    defer self.leave()
    return inner.activity_backup(dest)
}
