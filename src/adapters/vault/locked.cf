// The app and the CLI merge a copy through a `new_copy_vault_store`, never through
// the shared connection.
fn (mut self: LockedVaultStore) vault_attach_copy(path: str, page_key: []byte, salt: []byte) -> void! {
    return error(coded(ERR_INTERNAL, "a conflict copy opens in a store of its own"))
}

// Milestone 43: read under the mutex, so never in the middle of a transaction.
fn (self: LockedVaultStore) vault_file_bytes(path: str) -> []byte! {
    inner := self.enter()
    defer self.leave()
    return try inner.vault_file_bytes(path)
}

// Opens its own connection to a private file; holds the mutex only to read the key.
fn (self: LockedVaultStore) vault_blob_records(data: []byte, page_key: []byte, salt: []byte) -> domain.BlobRecords! {
    inner := self.enter()
    self.leave()
    return try inner.vault_blob_records(data, page_key, salt)
}

