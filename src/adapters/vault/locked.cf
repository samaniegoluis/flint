// Holds the mutex for the copy, so no write lands in the middle of it.
fn (self: LockedVaultStore) activity_backup(dest: str) -> void! {
    inner := self.enter()
    defer self.leave()
    try inner.activity_backup(dest)
    return
}

// Milestone 40: a new master password (rekey.cf). Each step holds the mutex; a write
// between prepare and commit makes the commit fail `conflict`.
fn (mut self: LockedVaultStore) vault_rekey_prepare(path: str, page_key: []byte, salt: []byte, secrets: domain.VaultSecrets) -> void! {
    mut inner := self.enter()
    defer self.leave_with(inner)
    try inner.vault_rekey_prepare(path, page_key, salt, secrets)
    return
}

fn (mut self: LockedVaultStore) activity_rekey_prepare(key: []byte, new_salt: []byte) -> void! {
    mut inner := self.enter()
    defer self.leave_with(inner)
    try inner.activity_rekey_prepare(key, new_salt)
    return
}

