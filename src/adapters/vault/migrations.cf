package vault

// Vault schema and file-format migrations. APPEND ONLY (Principles 5 and 10): an
// applied migration is never edited, reordered or removed. A change is a new entry
// at the end with the next version number.

type Migration struct {
    version: i64
    name: str
    sql: str
}

fn vault_migrations() -> []Migration {
    mut list: []Migration = []

    // 001: vault file format v1. Records the pinned crypto and SQLCipher parameters
    // (D-016, D-017) and creates the first schema.
    list.push(Migration{ version: 1, name: "format v1 and base schema", sql: `
CREATE TABLE meta (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);
INSERT INTO meta (key, value) VALUES
    ('format', '1'),
    ('salt', 'file bytes 0-15'),
    ('kdf', 'argon2id13'),
    ('kdf_ops', '3'),
    ('kdf_mem_bytes', '268435456'),
    ('subkeys', 'crypto_kdf context flintvlt: 1 page key, 2 secrets key'),
    ('secret_aead', 'xchacha20poly1305_ietf'),
    ('cipher_compatibility', '4'),
    ('cipher_page_size', '4096'),
    ('cipher_hmac_algorithm', 'HMAC_SHA512'),
    ('cipher_kdf_algorithm', 'PBKDF2_HMAC_SHA512'),
    ('kdf_iter', '256000');

CREATE TABLE groups (
    id TEXT PRIMARY KEY,
    parent_id TEXT REFERENCES groups(id),
    name TEXT NOT NULL
);
CREATE UNIQUE INDEX groups_unique_name ON groups (ifnull(parent_id, ''), name COLLATE NOCASE);

CREATE TABLE ssh_keys (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    key_type TEXT NOT NULL,
    public_key TEXT NOT NULL,
    fingerprint TEXT NOT NULL,
    private_key BLOB NOT NULL,
    passphrase BLOB
);

CREATE TABLE credentials (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    username TEXT NOT NULL,
    key_id TEXT REFERENCES ssh_keys(id),
    password BLOB
);

CREATE TABLE hosts (
    id TEXT PRIMARY KEY,
    alias TEXT NOT NULL UNIQUE COLLATE NOCASE,
    label TEXT NOT NULL,
    hostname TEXT NOT NULL,
    port INTEGER NOT NULL,
    username TEXT NOT NULL,
    group_id TEXT REFERENCES groups(id),
    color TEXT NOT NULL,
    notes TEXT NOT NULL,
    jump_host_id TEXT REFERENCES hosts(id),
    credential_id TEXT REFERENCES credentials(id),
    key_id TEXT REFERENCES ssh_keys(id),
    password BLOB
);

CREATE TABLE host_tags (
    host_id TEXT NOT NULL REFERENCES hosts(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (host_id, position)
);
` })

    // 002: known hosts. One host key per address ("host" for port 22, "[host]:port"
    // otherwise), recorded on first use and checked on every connect (milestone 03).
    list.push(Migration{ version: 2, name: "known hosts", sql: `
CREATE TABLE known_hosts (
    addr TEXT PRIMARY KEY COLLATE NOCASE,
    key_type TEXT NOT NULL,
    fingerprint TEXT NOT NULL,
    host_id TEXT REFERENCES hosts(id) ON DELETE SET NULL,
    added_at TEXT NOT NULL
);
` })

    // 003: an initial command per host, run on the PTY instead of a bare login
    // shell, and whether a login shell follows when it exits (milestone 06, D-031).
    list.push(Migration{ version: 3, name: "host initial command", sql: `
ALTER TABLE hosts ADD COLUMN initial_command TEXT NOT NULL DEFAULT '';
ALTER TABLE hosts ADD COLUMN keep_shell INTEGER NOT NULL DEFAULT 1;
` })

    // 004: tokens and the activity log (milestone 12b, D-040, D-046). A token is a
    // grant handed to a program: only the hash of its secret is kept, and it is
    // revoked, never deleted, so the log can still name it. Scopes are comma lists of
    // group and host ids. Times are Unix seconds. The log holds what callers were
    // allowed to run or refused (never reads), the newest ACTIVITY_KEEP entries.
    list.push(Migration{ version: 4, name: "tokens and activity log", sql: `
CREATE TABLE tokens (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    hash TEXT NOT NULL,
    scope_all INTEGER NOT NULL,
    scope_groups TEXT NOT NULL DEFAULT '',
    scope_hosts TEXT NOT NULL DEFAULT '',
    allow_read INTEGER NOT NULL,
    allow_exec INTEGER NOT NULL,
    allow_write INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL,
    revoked_at INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE activity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    at INTEGER NOT NULL,
    caller TEXT NOT NULL,
    via TEXT NOT NULL,
    token_id TEXT NOT NULL DEFAULT '',
    action TEXT NOT NULL,
    host TEXT NOT NULL DEFAULT '',
    command TEXT NOT NULL,
    outcome TEXT NOT NULL
);
` })

    // 005: a sudo password per host (milestone 13, D-039), sealed with the secrets key
    // like `password`. NULL: Flint types the host's login password when sudo asks.
    list.push(Migration{ version: 5, name: "host sudo password", sql: `
ALTER TABLE hosts ADD COLUMN sudo_password BLOB;
` })

    // 006: whole commands in the activity log (milestone 15, D-049). How many bytes
    // of a command past 16 KB were cut; entries from before were cut at 160 and say
    // 0. The retention in days is a row of `meta` (`activity_retention_days`).
    list.push(Migration{ version: 6, name: "activity command cut", sql: `
ALTER TABLE activity ADD COLUMN command_cut INTEGER NOT NULL DEFAULT 0;
` })

    // 007: local port forwards saved in a host (milestone 22, D-062). A tunnel goes
    // with its host; its name is unique in that host, whatever its case. The
    // destination is as the server sees it (`localhost` is the server itself).
    list.push(Migration{ version: 7, name: "tunnels", sql: `
CREATE TABLE tunnels (
    id TEXT PRIMARY KEY,
    host_id TEXT NOT NULL REFERENCES hosts(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    local_port INTEGER NOT NULL,
    dest_host TEXT NOT NULL,
    dest_port INTEGER NOT NULL,
    open_on_connect INTEGER NOT NULL DEFAULT 0
);
CREATE UNIQUE INDEX tunnels_unique_name ON tunnels (host_id, name COLLATE NOCASE);
` })

    // 008: a host type and an RDP host's domain (milestone 29, D-070). Every host
    // saved before is an SSH host. An RDP server's certificate goes in `known_hosts`
    // under `rdp://<name>:<port>`, so it needs no table of its own.
    list.push(Migration{ version: 8, name: "host type", sql: `
ALTER TABLE hosts ADD COLUMN type TEXT NOT NULL DEFAULT 'ssh';
ALTER TABLE hosts ADD COLUMN domain TEXT NOT NULL DEFAULT '';
` })

    // 009: the activity log leaves the vault (milestone 39, D-094) for this machine's
    // activity file (activity.cf). Renamed, not dropped, so no row is lost before it
    // is copied: `activity_attach` moves the rows and the retention, then drops the
    // table.
    list.push(Migration{ version: 9, name: "activity log moves out", sql: `
ALTER TABLE activity RENAME TO activity_moving;
` })

    return list
}

// Brings the open vault up to the latest migration, one transaction per step.
fn (self: CipherDb) migrate() -> void! {
    return self.migrate_list(vault_migrations(), "vault")
}

// Brings the open database up to the last of `list` (the vault's, or the activity
// file's, milestone 39); `what` names it in the error for a newer schema.
fn (self: CipherDb) migrate_list(list: []Migration, what: str) -> void! {
    // Bootstrap: the ledger itself is not a migration.
    try self.exec("CREATE TABLE IF NOT EXISTS schema_migrations (version INTEGER PRIMARY KEY, name TEXT NOT NULL);")
    current := try self.schema_version()
    if current > list[list.len() - 1].version {
        return error("unsupported: this {what} was written by a newer Flint (schema {current})")
    }
    for m in list {
        if m.version > current {
            try self.exec("BEGIN IMMEDIATE;")
            // Read again under the write lock: another Flint process opening the same
            // vault may have applied this step while this one waited for the lock.
            now := self.schema_version() or err {
                _ := self.exec("ROLLBACK;")
                return error("io: migration {m.version} failed: {err.message()}")
            }
            if now >= m.version {
                try self.exec("COMMIT;")
                continue
            }
            self.apply_migration(m) or err {
                _ := self.exec("ROLLBACK;")
                return error("io: migration {m.version} failed: {err.message()}")
            }
            try self.exec("COMMIT;")
        }
    }
}

// The highest migration applied to the open vault (0 for a new file).
fn (self: CipherDb) schema_version() -> i64! {
    res := try self.query_cells("SELECT ifnull(max(version), 0) FROM schema_migrations;", [])
    return cell_i64(res[0][0])
}

fn (self: CipherDb) apply_migration(m: Migration) -> void! {
    try self.exec(m.sql)
    try self.run_sql("INSERT INTO schema_migrations (version, name) VALUES (?1, ?2);", [sql_int(m.version), sql_text(m.name)])
}

test "migrations are numbered 1..n with no gaps" {
    list := vault_migrations()
    for i, m in list {
        assert_eq(m.version, i64(i) + 1)
        assert(m.name.len() > 0)
    }
}
