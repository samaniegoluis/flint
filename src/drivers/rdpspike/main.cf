package main

// Milestone 28's spike: a bare webui window that opens one RDP session through
// src/adapters/rdp and draws it on a canvas, to measure how frames best reach the
// page. Not part of Flint: milestone 30 replaces it with the RDP tab behind the
// RemoteDesktop port. Built by scripts/rdp-spike.sh.
//
// The target comes from the environment (FLINT_RDP_TEST_HOST, _USER, _PASSWORD;
// Infisical /ai-agents); the password never reaches the page. FLINT_RDP_SPIKE_MODE is
// `events` (option A: webui events, base64) or `channel` (option B: the local frame
// channel); FLINT_RDP_SPIKE_AUTO=1 runs the measurement, prints it and quits.

import "ext:webui"
import "core:os"
import "core:fs"
import "core:encoding/base64"
import "../../adapters/rdp"

type OpenReq struct {
    width: i32
    height: i32
}

type OpenReply struct {
    mode: str
    width: i32
    height: i32
    port: i32
    token: str
}

type MouseReq struct {
    flags: i32
    x: i32
    y: i32
}

type KeyReq struct {
    code: i32
    down: bool
}

type ReportReq struct {
    text: str
}

type ConfigReply struct {
    mode: str
    auto_run: bool
}

type SnapshotReq struct {
    name: str
    png: str
}

type StatsReply struct {
    drawn: i64
}

fn current(app: webui.App) -> rdp.RdpConn! {
    id := app.get_state("rdp_id")
    if id.len() == 0 {
        return error("not connected")
    }
    n := id.parse_i64() or {
        return error("not connected")
    }
    return rdp.RdpConn{ id: n }
}

// Option A: a worker takes each dirty region and emits it as a webui byte event.
fn pump_events(conn: rdp.RdpConn, mut app: webui.App) {
    for {
        frame := conn.next_frame(250) or {
            return
        }
        if frame.len() > 0 {
            app.emit_bytes("rdp:frame", frame.bytes())
        }
    }
}

fn main() {
    mode := os.getenv("FLINT_RDP_SPIKE_MODE", "events")
    auto_run := os.getenv("FLINT_RDP_SPIKE_AUTO") == "1"
    mut app := webui.new_app("Flint RDP spike", 1400, 900)
    defer app.close()
    // Frames are megabytes: keep no history of them (CF-003's ring buffer).
    app.set_max_history(1)
    page_dir := os.getenv("FLINT_RDP_SPIKE_PAGE", "src/drivers/rdpspike/page")
    app.serve_dir(page_dir)

    async.scope(workers: 8) |scope| {
        app.bind_action("spike_config") || {
            return ConfigReply{ mode: mode, auto_run: auto_run }
        }
        app.bind_async[OpenReq]("spike_open") |req| {
            t := rdp.RdpTarget{
                host: os.getenv("FLINT_RDP_TEST_HOST"),
                user: os.getenv("FLINT_RDP_TEST_USER"),
                password: os.getenv("FLINT_RDP_TEST_PASSWORD"),
                width: req.width,
                height: req.height,
            }
            conn := try rdp.rdp_open(t, 15000)
            mut a := app
            a.set_state("rdp_id", "{conn.id}")
            sz := try conn.size()
            mut reply := OpenReply{ mode: mode, width: sz.width, height: sz.height, port: 0, token: "" }
            if mode == "channel" {
                ch := try conn.frame_channel()
                reply.port = ch.port
                reply.token = ch.token
            } else {
                pump_app := app
                scope.spawn || {
                    mut pa := pump_app
                    pump_events(conn, mut pa)
                }
            }
            return reply
        }
        app.bind[MouseReq]("spike_mouse") |req| {
            conn := try current(app)
            try conn.mouse(req.flags, req.x, req.y)
            return true
        }
        app.bind[KeyReq]("spike_key") |req| {
            conn := try current(app)
            try conn.key(req.code, req.down)
            return true
        }
        app.bind[KeyReq]("spike_unicode") |req| {
            conn := try current(app)
            try conn.unicode(req.code, req.down)
            return true
        }
        app.bind_action("spike_stats") || {
            conn := try current(app)
            return StatsReply{ drawn: conn.frames_drawn() }
        }
        // Saves the canvas as PNG in $FLINT_RDP_SPIKE_SNAPSHOTS, to check what was drawn.
        app.bind_async[SnapshotReq]("spike_snapshot") |req| {
            dir := os.getenv("FLINT_RDP_SPIKE_SNAPSHOTS")
            if dir.len() == 0 {
                return false
            }
            data := try base64.decode_str(req.png)
            try fs.write_text(dir + "/" + req.name + ".png", data)
            return true
        }
        app.bind[ReportReq]("spike_report") |req| {
            println(req.text)
            return true
        }
        app.bind_action("spike_quit") || {
            conn := current(app) or rdp.RdpConn{ id: 0 }
            if conn.id > 0 {
                conn.close()
            }
            mut a := app
            a.quit()
            return true
        }
        app.run()
    }
    conn := current(app) or rdp.RdpConn{ id: 0 }
    if conn.id > 0 {
        conn.close()
    }
}
