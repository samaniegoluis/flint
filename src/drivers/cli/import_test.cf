package main

// The Tether import with every real adapter: the fixture Tether's own code wrote
// (scripts/make-tether-fixture.sh), libargon2 for its key, libsodium to open each
// secret and seal it again, SQLCipher for the Flint vault, libssh to read the keys.

import "core:fs"
import "core:rand"
import "core:encoding/hex"

fn fixture_path() -> str {
    for p in ["src/adapters/vault/testdata/tether-v5.tether", "../../adapters/vault/testdata/tether-v5.tether"] {
        if fs.exists(p) {
            return p
        }
    }
    return "src/adapters/vault/testdata/tether-v5.tether"
}

test "a real Tether vault is imported and its secrets open under the Flint vault's key" {
    // A random tag, not the pid: cfire has no os.getpid (CF-064).
    tag := hex.encode(rand.bytes(4))
    dir := "/tmp/flint-import-test-{tag}"
    try fs.mkdir_all(dir)
    defer { _ = fs.remove(dir) }
    // The legacy host's key file, where the fixture says it is.
    try fs.mkdir_all("/tmp/flint-tether-fixture")
    legacy := try fs.read_text(str_replace_suffix(fixture_path(), "tether-v5.tether", "tether-legacy-ed25519"))
    try fs.write_text("/tmp/flint-tether-fixture/id_legacy", legacy)

    c := try new_sodium()
    mut store := new_sql_vault_store()
    kc := new_os_keychain(false)
    recents := new_json_recent_store(dir + "/cfg")
    s := try create_vault(c, mut store, kc, recents, dir + "/t.flint", "Import test", "mpw-import-test")
    r := try import_tether(c, mut store, new_libssh_key_inspector(), new_tether_reader(), s, fixture_path(), "tether-fixture-pw", false)
    assert_eq(r.added.hosts, 8)
    assert_eq(r.added.keys, 2)

    cat := try load_catalog(store)
    code := try require_host(cat.hosts, "code-box")
    assert_eq(try open_secret(c, s, "hosts", code.id, "password", code.password), "pw-codebox")
    ops := try require_cred(cat.creds, "ops")
    assert_eq(try open_secret(c, s, "credentials", ops.id, "password", ops.password), "pw-ops-cred")
    k := try require_key(cat.keys, "homelab-ed25519")
    assert_eq(try open_secret(c, s, "ssh_keys", k.id, "passphrase", k.passphrase), "kp-fixture")
    pem := try open_secret(c, s, "ssh_keys", k.id, "private_key", k.private_key)
    assert(pem.starts_with("-----BEGIN OPENSSH PRIVATE KEY-----"))
    store.vault_detach()

    wrong := import_tether(c, mut store, new_libssh_key_inspector(), new_tether_reader(), s, fixture_path(), "not it", false)
    assert_eq(error_code_of("{wrong.error().message()}"), "wrong_password")
}

fn str_replace_suffix(s: str, suffix: str, with: str) -> str {
    if !s.ends_with(suffix) {
        return s
    }
    return s.substr(0, s.len() - suffix.len()) + with
}
