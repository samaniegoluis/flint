package main

// Reading secret input. Secrets come from the terminal with echo off, or from stdin
// when a `--*-stdin` flag says so; never from argv or the environment (D-018).
//
// Several `--*-stdin` flags share stdin, read in a fixed order: the master password
// line, then the password line, then the passphrase line, then the private key,
// which takes everything that is left.

import "core:str"
import "../../adapters/process"
import "../../domain"

type SecretInput struct {
    master: str
    has_master: bool
    password: str
    has_password: bool
    passphrase: str
    has_passphrase: bool
    key_text: str
    has_key: bool
}

fn strip_cr(s: str) -> str {
    if s.ends_with("\r") {
        return s.substr(0, s.len() - 1)
    }
    return s
}

// Splits off the first line of `text`; returns (line, rest).
fn take_line(text: str) -> (str, str) {
    nl := str.index_of(text, "\n")
    if nl < 0 {
        return (strip_cr(text), "")
    }
    return (strip_cr(text.substr(0, usize(nl))), text.substr(usize(nl) + 1))
}

fn read_stdin_secrets(p: ParsedArgs) -> SecretInput! {
    mut sec := SecretInput{ master: "", has_master: false, password: "", has_password: false, passphrase: "", has_passphrase: false, key_text: "", has_key: false }
    wants := p.has_flag("--master-stdin") || p.has_flag("--password-stdin") || p.has_flag("--passphrase-stdin") || p.has_flag("--key-stdin")
    if !wants {
        return sec
    }
    if stdin_is_terminal() {
        return error(coded(ERR_USAGE, "a --*-stdin flag was given but stdin is a terminal; pipe the secret in, or drop the flag to be prompted"))
    }
    mut rest := read_stdin_text()
    if p.has_flag("--master-stdin") {
        (line, after) := take_line(rest)
        sec.master = line
        sec.has_master = true
        rest = after
    }
    if p.has_flag("--password-stdin") {
        (line, after) := take_line(rest)
        sec.password = line
        sec.has_password = true
        rest = after
    }
    if p.has_flag("--passphrase-stdin") {
        (line, after) := take_line(rest)
        sec.passphrase = line
        sec.has_passphrase = true
        rest = after
    }
    if p.has_flag("--key-stdin") {
        sec.key_text = rest
        sec.has_key = true
    }
    return sec
}

fn prompt_secret(label: str) -> str! {
    if !has_terminal() {
        return error(coded(ERR_USAGE, "no terminal to ask for the {label}; pass it on stdin"))
    }
    return read_secret_line(label + ": ")
}

// A new secret, typed twice on a terminal.
fn prompt_new_secret(label: str) -> str! {
    first := try prompt_secret(label)
    second := try prompt_secret("Repeat the " + label)
    if first != second {
        return error(coded(ERR_INVALID, "the two entries do not match"))
    }
    return first
}

// The master password for an unlock: stdin when --master-stdin was given, else a
// prompt; with neither, the vault stays locked.
fn master_password_for(sec: SecretInput, vault_name: str) -> str! {
    if sec.has_master {
        return sec.master
    }
    if !has_terminal() {
        return error(coded(ERR_LOCKED, "vault '{vault_name}' is locked; run `flint vault unlock`, or pass --master-stdin"))
    }
    return read_secret_line("Master password for '{vault_name}': ")
}
