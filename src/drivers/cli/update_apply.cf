package main

// `flint update-apply --wait <pid> --from <new> --to <installed> [--json]` (milestone
// 53, D-111 (3)): run by the app at Relaunch, from a copy of the new CLI outside the
// folder it replaces. `flint update-apply --wait <pid> --start --to <folder> --staging
// <folder>` (milestone 54, D-124): a .deb or .rpm root already installed; the new CLI
// only waits for the old app and starts the new one from its own folder. Parses its flags, runs the use case, prints what it did. Not a
// command a person types; documented under Updates.

import "core:json"
import "core:os"
import "../../adapters/process"
import "../../application"
import "../../domain"
import "../clicmd"

fn update_apply_usage() -> str {
    return coded(ERR_USAGE, "usage: flint update-apply --wait <pid> (--from <folder> | --start --staging <folder>) --to <folder> [--json]")
}

fn parse_apply_request(args: []str) -> domain.ApplyRequest! {
    // The end-to-end run keeps the started app's output (scripts/gui-e2e.sh, selfupdate).
    mut r := domain.ApplyRequest{ wait_pid: 0, from: "", to: "", os: os_name(), app_log: (os.getenv("FLINT_UPDATE_APP_LOG") or ""), start_only: false, staging: "" }
    mut i: usize = 1
    for i < args.len() {
        a := args[i]
        if a == "--json" {
            i += 1
            continue
        }
        if a == "--start" {
            r.start_only = true
            i += 1
            continue
        }
        if i + 1 >= args.len() {
            return error(update_apply_usage())
        }
        v := "{args[i + 1]}"
        if a == "--wait" {
            r.wait_pid = i64.parse(v) or {
                return error(update_apply_usage())
            }
        } else if a == "--from" {
            r.from = local_slashes(v)
        } else if a == "--to" {
            r.to = local_slashes(v)
        } else if a == "--staging" {
            r.staging = local_slashes(v)
        } else {
            return error(update_apply_usage())
        }
        i += 2
    }
    return r
}

// Whether every folder of the request is an absolute path (`/…`, `C:/…`, `C:\…`,
// `\\server\…`), so leaving the current directory changes nothing it names.
fn apply_paths_absolute(r: domain.ApplyRequest) -> bool {
    for p in [r.from, r.to, r.staging] {
        if p.len() > 0 && !is_absolute_path(p) {
            return false
        }
    }
    return true
}

fn is_absolute_path(p: str) -> bool {
    if p.starts_with("/") || p.starts_with("\\") {
        return true
    }
    return p.len() >= 3 && p[1..2] == ":" && (p[2..3] == "/" || p[2..3] == "\\")
}

test "a request of absolute folders lets update-apply leave its current directory" {
    r := domain.ApplyRequest{ wait_pid: 1, from: "C:/A/.flint-update/new/Flint", to: "C:/A/Flint", os: "windows", app_log: "", start_only: false, staging: "" }
    assert(apply_paths_absolute(r))
    assert(apply_paths_absolute(domain.ApplyRequest{ wait_pid: 1, from: "/a/.flint-update/new/Flint", to: "/a/Flint", os: "linux", app_log: "", start_only: false, staging: "" }))
    assert(is_absolute_path("D:\\Programas\\Flint"))
    assert(is_absolute_path("\\\\server\\share"))
    assert(!apply_paths_absolute(domain.ApplyRequest{ wait_pid: 1, from: "x/.flint-update/new/Flint", to: "x/Flint", os: "linux", app_log: "", start_only: false, staging: "" }))
    assert(!is_absolute_path("Flint"))
    assert(!is_absolute_path("C:Flint"))
}

fn run_update_apply(args: []str, as_json: bool) -> i32 {
    r := parse_apply_request(args) or err {
        return report_error("{err.message()}", as_json)
    }
    // Out of the folder it inherited as its current directory, which may be the very
    // folder it renames: the app opened from its Start menu shortcut starts in it, and
    // Windows renames no folder that is a process's current directory (error 32). The
    // app passes absolute paths, so moving does not change what they name.
    here := executable_dir()
    if here.len() > 0 && apply_paths_absolute(r) {
        set_working_dir(here) or err {
            write_stderr("flint update-apply: {err.message()}; staying in {os.cwd()}\n")
        }
    }
    mut files := new_os_update_files()
    mut procs := new_os_update_processes()
    mut o := apply_ok()
    if r.start_only {
        // Only the folder this CLI runs from: --start never starts another program.
        if trim_slashes(r.to) != trim_slashes(executable_dir()) {
            return report_error(coded(ERR_INVALID, "update-apply --start starts only the Flint beside this flint ({executable_dir()})"), as_json)
        }
        write_stderr("flint update-apply: starting {r.to} once process {r.wait_pid} quits\n")
        o = apply_package_start(mut files, mut procs, r)
    } else {
        write_stderr("flint update-apply: {r.from} -> {r.to} once process {r.wait_pid} quits\n")
        o = apply_update(mut files, mut procs, r)
    }
    if o.applied {
        write_stderr("flint update-apply: applied; the new Flint started\n")
        if as_json {
            say(json.stringify(o))
        } else {
            say("Flint was updated.")
        }
        return 0
    }
    write_stderr("flint update-apply: not applied at step {o.step}: {o.message}\n")
    if as_json {
        say(json.stringify(o))
    }
    return report_error(coded(o.code, o.message), as_json)
}
