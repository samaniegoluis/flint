package main

// The `flint` CLI's entry point and composition root. The command handlers live in
// src/drivers/clicmd, shared with the app, which runs them for a command the CLI
// sends it over the local socket (D-038).

import "ext:json"
import "../../adapters/crypto"
import "../../adapters/process"
import "../../adapters/ssh"
import "../../adapters/vault"
import "../clicmd"

FLINT_VERSION: str = "0.0.0-dev"

type VersionInfo struct {
    flint:     str `json:"flint"`
    libssh:    str `json:"libssh"`
    libsodium: str `json:"libsodium"`
    sqlite:    str `json:"sqlite"`
}

fn print_version(as_json: bool) {
    info := VersionInfo{
        flint: FLINT_VERSION,
        libssh: libssh_version(),
        libsodium: sodium_version(),
        sqlite: sqlcipher_version(),
    }
    if as_json {
        say(json.stringify(info))
        return
    }
    say("flint {info.flint}")
    say("  libssh     {info.libssh}")
    say("  libsodium  {info.libsodium}")
    say("  sqlite     {info.sqlite}")
}

fn main() {
    args := process_args()
    // Decide the error format before parsing, so a parse error honours --json.
    // Stop at `--`: what follows is a remote command, not Flint's flags.
    mut as_json := false
    mut in_rest := false
    for a in args {
        if a == "--" {
            in_rest = true
        }
        if a == "--json" && !in_rest {
            as_json = true
        }
    }
    parsed := parse_cli_args(args)
    if !parsed.has_value() {
        fail_with("{parsed.error().message()}", as_json)
        return
    }
    p := parsed.value()
    if p.has_flag("--version") || p.has_flag("-V") {
        print_version(as_json)
        return
    }
    done := run_cli(p, args, as_json)
    if !done.has_value() {
        fail_with("{done.error().message()}", as_json)
        return
    }
    if done.value() != 0 {
        exit_process(done.value())
    }
}
