package main

// The `flint` CLI's entry point and composition root. The command handlers live in
// src/drivers/clicmd, shared with the app, which runs them for a command the CLI
// sends it over the local socket (D-038).

import "core:json"
import "../../adapters/crypto" as flint_crypto
import "../../adapters/process"
import "../../adapters/ssh" as flint_ssh
import "../../adapters/vault"
import "../clicmd"
import "../version"

type VersionInfo struct {
    flint:     str `json:"flint"`
    libssh:    str `json:"libssh"`
    libsodium: str `json:"libsodium"`
    sqlite:    str `json:"sqlite"`
}

fn print_version(as_json: bool) {
    info := VersionInfo{
        flint: version.FLINT_VERSION,
        libssh: flint_ssh.libssh_version(),
        libsodium: flint_crypto.sodium_version(),
        sqlite: vault.sqlcipher_version(),
    }
    if as_json {
        clicmd.say(json.stringify(info))
        return
    }
    clicmd.say("flint {info.flint}")
    clicmd.say("  libssh     {info.libssh}")
    clicmd.say("  libsodium  {info.libsodium}")
    clicmd.say("  sqlite     {info.sqlite}")
}

fn main() {
    args := process.process_args()
    // Decide the error format before parsing, so a parse error honours --json.
    // Stop at `--`: what follows is a remote command, not Flint's flags.
    mut as_json := false
    mut in_rest := false
    for a in args {
        if a == "--" {
            in_rest = true
        }
        if a == "--json" && !in_rest {
            as_json = true
        }
    }
    // The self-update's swap (update_apply.cf): its own flags, no vault, no socket.
    if args.len() > 0 && args[0] == "update-apply" {
        process.exit_process(run_update_apply(args, as_json))
        return
    }
    parsed := clicmd.parse_cli_args(args) or err {
        clicmd.fail_with("{err.message()}", as_json)
        return
    }
    p := parsed
    if p.has_flag("--version") || p.has_flag("-V") {
        print_version(as_json)
        return
    }
    done := clicmd.run_cli(p, args, as_json) or err {
        clicmd.fail_with("{err.message()}", as_json)
        return
    }
    if done != 0 {
        process.exit_process(done)
    }
}
