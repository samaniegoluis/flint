package main

// RPC handlers of the desktop app. Each one parses its request, calls one use case
// and returns the result as JSON (Principle 2); an error rejects the page's promise
// with the core's "code: message" text.
//
// Each is a named function, bound in main.cf by a one-line closure, so a handler
// reads like any use case call and can be tested on its own.

import "ext:webui"
import "core:json"
import "core:encoding/hex"
import "core:encoding/base64"
import "core:fs"
import "core:os"
import "core:time"
import "../../adapters/config"
import "../../adapters/crypto"
import "../../adapters/fonts"
import "../../adapters/keychain"
import "../../adapters/process"
import "../../adapters/ssh"
import "../../adapters/uievents"
import "../../adapters/vault"
import "../../application"
import "../../domain"

FLINT_VERSION: str = "0.0.0-dev"

// The most sessions open at once; each one holds a worker thread.
MAX_SESSIONS: i64 = 48

// How long the headless end-to-end run (FLINT_GUI_E2E) may take on macOS.
E2E_TIMEOUT_MS: i32 = 240000

// The run's cap: FLINT_GUI_E2E_TIMEOUT_MS when set (gui-e2e.sh gives its short vim run
// 60 s, so a freeze there costs a minute, not four), else E2E_TIMEOUT_MS.
fn e2e_timeout_ms() -> i32 {
    ms := os.getenv("FLINT_GUI_E2E_TIMEOUT_MS").parse_i64() or 0
    if ms <= 0 || ms > 3600000 {
        return E2E_TIMEOUT_MS
    }
    return i32(ms)
}

// Whether the end-to-end run on macOS opens the real window (FLINT_GUI_E2E_VISIBLE=1,
// milestone 27) instead of cfire's offscreen one. The offscreen window sits off every
// screen and WebKit suspends its page at times (ROADMAP, the gui-e2e freezes); the real
// one runs the app's own event loop, as on Linux, and a person sees the run.
fn e2e_visible() -> bool {
    return os.getenv("FLINT_GUI_E2E_VISIBLE") == "1"
}

// How often the visible run's cap checks the clock and whether the app is quitting.
E2E_CAP_TICK_MS: i64 = 200

// The visible run's cap: the offscreen run stops itself at e2e_timeout_ms; app.run()
// does not, so this worker quits the app then, and the page's missing verdict is named
// as usual (main.cf). Ends early when the app quits.
fn run_e2e_cap(st: GuiState, mut app: webui.App) {
    deadline := time.now_ms() + i64(e2e_timeout_ms())
    for !st.holder.quitting() {
        if time.now_ms() >= deadline {
            write_stderr("flint-gui: the e2e run hit its cap\n")
            app.quit()
            return
        }
        time.sleep_ms(E2E_CAP_TICK_MS)
    }
}

// ---- Requests ---------------------------------------------------------------------

type PathReq struct {
    path: str `json:"path"`
}

type UnlockReq struct {
    path:     str  `json:"path"`
    password: str  `json:"password"`
    // Allow the CLI caller that asked for this unlock, as the window proposes
    // (milestone 12). The typed master password is the presence check.
    allow:    bool `json:"allow"`
    // Remember on this computer (D-048): cache the key so Flint reopens the vault
    // without the master password. Unticked on a vault that was remembered, its key
    // is removed.
    remember: bool `json:"remember"`
}

type CreateReq struct {
    path:     str  `json:"path"`
    name:     str  `json:"name"`
    password: str  `json:"password"`
    remember: bool `json:"remember"`
}

// Opens the window after it was closed to the tray: the master password, or ""
// for the OS's presence check.
type WindowUnlockReq struct {
    password: str `json:"password"`
}

type DialogReq struct {
    title:        str `json:"title"`
    default_name: str `json:"default_name"`
}

type NameReq struct {
    name: str `json:"name"`
}

// The page's layout state, with the vault it was read for: a write that arrives
// after the page switched vaults must not land on the new one.
type UiStateReq struct {
    vault:         str   `json:"vault"`
    sidebar_open:  bool  `json:"sidebar_open"`
    sidebar_width: i64   `json:"sidebar_width"`
    files_width:   i64   `json:"files_width" default:"340"`
    collapsed:     []str `json:"collapsed"`
}

type RenameReq struct {
    name:     str `json:"name"`
    new_name: str `json:"new_name"`
}

// host_edit and cred_edit send the patch's fields plus `target`, the alias or name
// being edited, at the top level; the request is parsed once as each.
type TargetReq struct {
    target: str `json:"target"`
}

type KeyAddReq struct {
    name:        str `json:"name"`
    private_key: str `json:"private_key"`
    file:        str `json:"file"`
    passphrase:  str `json:"passphrase"`
}

type SessionOpenReq struct {
    session:             str  `json:"session"`
    alias:               str  `json:"alias"`
    cols:                i32  `json:"cols"`
    rows:                i32  `json:"rows"`
    accept_new_host_key: bool `json:"accept_new_host_key"`
    // Skip the host's initial command (the palette's "Connect … without …").
    no_command:          bool `json:"no_command"`
    // A session with no terminal for the Files view's second pane (milestone 19).
    files_only:          bool `json:"files_only"`
}

type SessionInputReq struct {
    session: str `json:"session"`
    data:    str `json:"data"`
}

type SessionResizeReq struct {
    session: str `json:"session"`
    cols:    i32 `json:"cols"`
    rows:    i32 `json:"rows"`
}

type SessionAnswerReq struct {
    session: str  `json:"session"`
    prompt:  str  `json:"prompt"`
    ok:      bool `json:"ok"`
    value:   str  `json:"value"`
}

type SessionReq struct {
    session: str `json:"session"`
}

// host_test sends the editor's patch fields plus these; parsed apart like TargetReq.
type HostTestReq struct {
    session:             str  `json:"session"`
    target:              str  `json:"target"`
    accept_new_host_key: bool `json:"accept_new_host_key"`
}

// A saved password, by owner: `kind` is "host" or "credential".
type SecretReq struct {
    kind: str `json:"kind"`
    name: str `json:"name"`
}

type DarkReq struct {
    dark: bool `json:"dark"`
}

type E2eReport struct {
    ok:     bool `json:"ok"`
    detail: str  `json:"detail"`
}

// ---- Replies ----------------------------------------------------------------------

type AppInfo struct {
    version:   str  `json:"version"`
    os:        str  `json:"os"`
    libssh:    str  `json:"libssh"`
    libsodium: str  `json:"libsodium"`
    sqlite:    str  `json:"sqlite"`
    e2e:       bool `json:"e2e"`
}

type Ok struct {
    ok: bool `json:"ok"`
}

type PathReply struct {
    path: str `json:"path"`
}

type RememberedReply struct {
    remembered: bool `json:"remembered"`
}

// The window's lock (milestone 14), for the page: whether it is locked, the vault
// it holds, the presence method that opens it, and how many callers wait for an
// answer (who they are shows only once the window is open).
type WindowState struct {
    locked:   bool `json:"locked"`
    vault:    str  `json:"vault"`
    presence: str  `json:"presence"`
    waiting:  i64  `json:"waiting"`
}

type FontList struct {
    fonts: []str `json:"fonts"`
}

// The one RPC reply that carries a secret value (D-029).
type RevealReply struct {
    value: str `json:"value"`
}

// The end of a host test, emitted as "host:test". `code` is "" on success.
type HostTestEvent struct {
    session:     str `json:"session"`
    code:        str `json:"code"`
    message:     str `json:"message"`
    host:        str `json:"host"`
    target:      str `json:"target"`
    hops:        i64 `json:"hops"`
    duration_ms: i64 `json:"duration_ms"`
}

// ---- State ------------------------------------------------------------------------

// The unlocked vault, in a holder every copy shares (D-038): page handlers run on
// the UI thread, unlock and create on a worker, and commands from the CLI on the
// socket server's workers. A session worker gets a copy of the session when it starts.
type GuiState struct {
    holder: SessionHolder
}

fn no_vault_session() -> VaultSession {
    return VaultSession{ path: "", name: "", id: "", secrets_key: [], cached: false }
}

fn new_gui_state() -> GuiState {
    return GuiState{ holder: new_session_holder() }
}

fn (self: GuiState) unlocked() -> bool {
    return self.holder.held().unlocked
}

fn (self: GuiState) vault_session() -> VaultSession {
    h := self.holder.held()
    if !h.unlocked {
        return no_vault_session()
    }
    return VaultSession{ path: h.path, name: h.name, id: h.id, secrets_key: h.secrets_key, cached: h.cached }
}

fn (self: GuiState) adopt(s: VaultSession) {
    self.holder.put(HeldSession{ unlocked: true, path: s.path, name: s.name, id: s.id, secrets_key: s.secrets_key, cached: s.cached })
    self.holder.touch(time.now_ms())
}

fn (self: GuiState) forget() {
    self.holder.wipe()
    // A lock or another vault ends every grant and refuses every waiting approval.
    self.holder.access_clear()
}

// Holds the vault still for a whole operation: an unlock or switch, or a command
// served over the socket. Recursive; pair every hold with a release.
fn (self: GuiState) hold() {
    self.holder.hold()
}

fn (self: GuiState) release() {
    self.holder.release()
}

// What every page handler that reads or changes the vault checks first. A window
// closed to the tray is locked (milestone 14): until it is opened again its page
// gets nothing from the vault, though the vault keeps serving its grants.
fn (self: GuiState) require_unlocked() -> void! {
    if !self.unlocked() {
        return error(coded(ERR_LOCKED, "no vault is unlocked"))
    }
    try self.require_open_window()
}

// The vault alone, whatever the window: opening a locked window needs it unlocked.
fn (self: GuiState) require_unlocked_vault() -> void! {
    if !self.unlocked() {
        return error(coded(ERR_LOCKED, "no vault is unlocked"))
    }
}

// For page handlers that hold no vault data but act for the person at the window
// (typing into a session, answering its prompts).
fn (self: GuiState) require_open_window() -> void! {
    if self.holder.window_locked() {
        return error(coded(ERR_LOCKED, "the window is locked; open it with the master password"))
    }
}

fn parse_req[T](params: str) -> T! {
    return json.parse[T](params) or err {
        return error(coded(ERR_INVALID, "malformed request"))
    }
}

fn ok_json() -> str {
    return json.stringify(Ok{ ok: true })
}

// Ends every session and closes the vault before another one is opened. The state
// says "locked" before the store detaches, so a reader on another thread gets
// `locked`, never a half-closed vault. Callers hold the state (`st.hold()`).
fn close_current(mut store: LockedVaultStore, mut st: GuiState) {
    if st.unlocked() {
        gui_session_close_all()
        st.forget()
        close_vault(mut store)
    }
}

// ---- App and window -------------------------------------------------------------------

fn rpc_app_info(e2e: bool) -> str! {
    return json.stringify(AppInfo{ version: FLINT_VERSION, os: os_name(), libssh: libssh_version(), libsodium: sodium_version(), sqlite: sqlcipher_version(), e2e: e2e })
}

fn rpc_window_theme(params: str, mut app: webui.App) -> str! {
    req := try parse_req[DarkReq](params)
    app.set_dark_mode(req.dark)
    return ok_json()
}

fn rpc_dialog_open(params: str, app: webui.App) -> str! {
    req := try parse_req[DialogReq](params)
    if native_file_dialogs() {
        return json.stringify(PathReply{ path: choose_file_to_open(req.title) })
    }
    return json.stringify(PathReply{ path: app.open_file_dialog(req.title) })
}

fn rpc_dialog_save(params: str, app: webui.App) -> str! {
    req := try parse_req[DialogReq](params)
    if native_file_dialogs() {
        return json.stringify(PathReply{ path: choose_file_to_save(req.title, req.default_name) })
    }
    return json.stringify(PathReply{ path: app.save_file_dialog(req.title, req.default_name) })
}

fn rpc_settings_get(store: JsonSettingsStore) -> str! {
    return json.stringify(try load_settings(store))
}

fn rpc_settings_set(params: str, mut store: JsonSettingsStore, st: GuiState) -> str! {
    try st.require_open_window()
    req := try parse_req[Settings](params)
    saved := try save_settings(mut store, req)
    st.holder.set_lock_after(saved.lock_after)
    return json.stringify(saved)
}

// The sidebar and the open vault's collapsed groups (D-030). With no vault unlocked,
// only the sidebar part is read or written.
// Collapsed groups travel as paths; the core stores their ids.
fn rpc_ui_state_get(ui: JsonUiStateStore, store: LockedVaultStore, st: GuiState) -> str! {
    mut vault := ""
    if st.unlocked() {
        vault = st.vault_session().id
    }
    return json.stringify(try ui_state_paths(ui, store, vault))
}

fn rpc_ui_state_set(params: str, mut ui: JsonUiStateStore, store: LockedVaultStore, st: GuiState) -> str! {
    req := try parse_req[UiStateReq](params)
    mut view := UiStateView{ sidebar_open: req.sidebar_open, sidebar_width: req.sidebar_width, files_width: req.files_width, collapsed: req.collapsed }
    mut vault := ""
    held := st.vault_session()
    if st.unlocked() && req.vault == held.path {
        vault = held.id
    } else {
        view.collapsed = []
    }
    return json.stringify(try save_ui_state_paths(mut ui, store, vault, view))
}

fn rpc_fonts_mono(catalog: OsFontCatalog) -> str! {
    return json.stringify(FontList{ fonts: try list_mono_fonts(catalog) })
}

// ---- Vaults -------------------------------------------------------------------------

fn rpc_vault_recents(store: LockedVaultStore, recents: JsonRecentStore) -> str! {
    return json.stringify(try recent_vault_views(store, recents))
}

// An empty password tries the keychain; the error code `locked` means it has no key.
// A vault locked in this run never opens from the keychain: only its master password
// unlocks it again (D-042). Unlock and create run on a worker (`bind_async`):
// Argon2id takes about a second, and the window keeps responding meanwhile. Each
// holds the state for its whole run, so a command served over the socket never sees
// the vault switch under it.
fn rpc_vault_unlock(req: UnlockReq, c: Sodium, mut store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore, mut st: GuiState) -> VaultInfo! {
    if req.password.len() == 0 {
        // A locked window opens with the master password or presence, never with the
        // keychain's key behind it (milestone 14).
        try st.require_open_window()
    }
    if req.password.len() == 0 && st.holder.relocked(req.path) {
        return error(coded(ERR_LOCKED, "the vault was locked; its master password is needed"))
    }
    st.hold()
    defer st.release()
    (asked, caller) := st.holder.ask()
    asking := st.holder.access_book().asking
    close_current(mut store, mut st)
    s := try unlock_vault(c, mut store, kc, recents, req.path, req.password, req.remember)
    if req.password.len() > 0 && !req.remember && st.holder.remembered(s.path) {
        // Unticked: this computer no longer remembers it.
        _ := forget_vault_key(store, kc, s.path)
    }
    st.holder.set_remembered(s.path, s.cached)
    st.adopt(s)
    st.holder.clear_relocked(s.path)
    // What aged out of the activity log while the vault was closed (milestone 15). A
    // failure is reported by its code only (Principle 5) and does not stop the unlock.
    mut ts := store
    prune_activity(mut ts, time.unix_seconds()) or err {
        write_stderr("flint-gui: the activity log was not pruned ({error_code_of("{err.message()}")})\n")
    }
    if req.password.len() > 0 {
        // The master password just typed opens the window too.
        st.holder.set_window_locked(false)
    }
    if asked == s.path {
        st.holder.set_ask("", "")
        // `token create` and `exec --sudo` are never allowed here: only the approval
        // window allows them.
        if req.allow && req.password.len() > 0 && asking.len() > 0 && allowed_at_unlock(asking[0].need) {
            allow_on_unlock(asking[0], c, store, st, s.id)
        }
    }
    return session_info(s)
}

// The unlock screen's "Allow" for the caller that asked: the grant the approval
// window would propose, confirmed by the master password just typed.
fn allow_on_unlock(asked: Approval, c: Sodium, store: LockedVaultStore, st: GuiState, vault_id: str) {
    cat := load_catalog(store) or Catalog{ groups: [], hosts: [], keys: [], creds: [] }
    mut ap := asked
    ap.vault_id = vault_id
    g := proposed_grant(ap, cat, hex.encode(c.random_bytes(8)), time.now_ms()) or {
        return
    }
    st.holder.access_hold()
    mut book := st.holder.access_book()
    book.grants.push(g)
    st.holder.put_access_book(book)
    st.holder.access_release()
    write_stderr("flint-gui: allowed {g.label} ({g.duration}) at unlock\n")
}

// Locks the vault now (the Lock button, the palette, ⌘L).
fn rpc_vault_lock(mut store: LockedVaultStore, st: GuiState, mut app: webui.App) -> str! {
    _ := lock_now(mut store, st, mut app, "manual")
    return ok_json()
}

// The page reports that someone is using the window (throttled there), which keeps
// the vault from locking for idleness.
fn rpc_activity(st: GuiState) -> str! {
    st.holder.touch(time.now_ms())
    return ok_json()
}

// The unlock a CLI asked for and is still waiting on, for a page that loads after
// the request: the path is "" when there is none.
fn rpc_unlock_request(st: GuiState, recents: JsonRecentStore) -> str! {
    (path, caller) := st.holder.ask()
    if path.len() == 0 || st.unlocked() {
        return json.stringify(UnlockRequest{ path: "", name: "", caller: "", label: "", command: CommandText{ text: "", cut: 0 } })
    }
    asking := st.holder.access_book().asking
    mut label := ""
    mut command := CommandText{ text: caller, cut: 0 }
    if asking.len() > 0 {
        command = asking[0].command
        if allowed_at_unlock(asking[0].need) {
            label = asking[0].label
        }
    }
    return json.stringify(UnlockRequest{ path: path, name: recent_name(recents, path), caller: caller, label: label, command: command })
}

// The person turned down the CLI's request on the unlock screen.
fn rpc_unlock_request_dismiss(st: GuiState) -> str! {
    st.holder.set_ask("", "")
    return ok_json()
}

fn rpc_vault_create(req: CreateReq, c: Sodium, mut store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore, mut st: GuiState) -> VaultInfo! {
    try st.require_open_window()
    st.hold()
    defer st.release()
    close_current(mut store, mut st)
    s := try create_vault(c, mut store, kc, recents, req.path, req.name, req.password, req.remember)
    st.holder.set_remembered(s.path, s.cached)
    st.adopt(s)
    return session_info(s)
}

// Closes the vault in this window: every session ends and its keys leave memory.
// The keychain cache stays, so the vault reopens without a prompt.
fn rpc_vault_close(mut store: LockedVaultStore, mut st: GuiState) -> str! {
    try st.require_open_window()
    st.hold()
    defer st.release()
    gui_session_close_all()
    st.forget()
    close_vault(mut store)
    return ok_json()
}

// Forgets the cached key on this machine (`flint vault lock`).
fn rpc_vault_forget_key(params: str, mut store: LockedVaultStore, kc: OsKeychain, mut st: GuiState) -> str! {
    req := try parse_req[PathReq](params)
    st.hold()
    defer st.release()
    if st.unlocked() && req.path == st.vault_session().path {
        gui_session_close_all()
        st.forget()
    }
    try lock_vault(mut store, kc, req.path)
    st.holder.set_remembered(req.path, false)
    return ok_json()
}

// Whether the unlock screen ticks Remember on this computer for `path`: this run
// knows its key is remembered (it opened from the keychain, or was ticked).
fn rpc_vault_remembered(params: str, st: GuiState) -> str! {
    req := try parse_req[PathReq](params)
    return json.stringify(RememberedReply{ remembered: st.holder.remembered(req.path) })
}

// Drops a vault from the recent list (`flint vault forget`).
fn rpc_vault_forget(params: str, mut store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore, mut st: GuiState) -> str! {
    req := try parse_req[PathReq](params)
    st.hold()
    defer st.release()
    if st.unlocked() && req.path == st.vault_session().path {
        gui_session_close_all()
        st.forget()
    }
    st.holder.set_remembered(req.path, false)
    return json.stringify(try forget_recent(mut store, kc, recents, req.path))
}

// Renames the vault open in this window; another vault must be opened first.
fn rpc_vault_rename(params: str, mut store: LockedVaultStore, recents: JsonRecentStore, mut st: GuiState) -> str! {
    req := try parse_req[NameReq](params)
    st.hold()
    defer st.release()
    try st.require_unlocked()
    s := try rename_vault(mut store, recents, st.vault_session(), req.name)
    st.adopt(s)
    return json.stringify(session_info(s))
}

fn rpc_vault_status(mut store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    return json.stringify(try open_vault_status(store, store, st.vault_session()))
}

// ---- Catalog ------------------------------------------------------------------------

fn rpc_catalog(store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    return json.stringify(try catalog_view(store))
}

fn rpc_group_add(params: str, c: Sodium, mut store: LockedVaultStore, st: GuiState) -> str! {
