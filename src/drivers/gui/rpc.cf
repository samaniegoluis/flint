    req := try parse_req[RenameReq](params)
    return json.stringify(try rename_group(mut store, req.name, req.new_name))
}

fn rpc_group_rm(params: str, mut store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    req := try parse_req[PathReq](params)
    return json.stringify(try remove_group(mut store, req.path))
}

fn rpc_host_add(params: str, c: Sodium, mut store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    req := try parse_req[HostPatch](params)
    return json.stringify(try add_host(c, mut store, st.vault_session(), req))
}

fn rpc_host_edit(params: str, c: Sodium, mut store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    target := try parse_req[TargetReq](params)
    patch := try parse_req[HostPatch](params)
    return json.stringify(try edit_host(c, mut store, st.vault_session(), target.target, patch))
}

fn rpc_host_rm(params: str, mut store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    req := try parse_req[NameReq](params)
    return json.stringify(try remove_host(mut store, req.name))
}

// The key comes pasted (`private_key`) or from a file the person picked (`file`).
fn rpc_key_add(params: str, c: Sodium, mut store: LockedVaultStore, inspector: LibsshKeyInspector, st: GuiState) -> str! {
    try st.require_unlocked()
    req := try parse_req[KeyAddReq](params)
    mut content := req.private_key
    if req.file.len() > 0 {
        content = fs.read_text(req.file) or err {
            return error(coded(ERR_NOT_FOUND, "cannot read the key file {req.file}"))
        }
    }
    return json.stringify(try add_key(c, mut store, inspector, st.vault_session(), req.name, content, req.passphrase))
}

fn rpc_key_rename(params: str, mut store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    req := try parse_req[RenameReq](params)
    return json.stringify(try rename_key(mut store, req.name, req.new_name))
}

fn rpc_key_rm(params: str, mut store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    req := try parse_req[NameReq](params)
    return json.stringify(try remove_key(mut store, req.name))
}

fn rpc_cred_add(params: str, c: Sodium, mut store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    req := try parse_req[CredPatch](params)
    return json.stringify(try add_cred(c, mut store, st.vault_session(), req))
}

fn rpc_cred_edit(params: str, c: Sodium, mut store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    target := try parse_req[TargetReq](params)
    patch := try parse_req[CredPatch](params)
    return json.stringify(try edit_cred(c, mut store, st.vault_session(), target.target, patch))
}

fn rpc_cred_rm(params: str, mut store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    req := try parse_req[NameReq](params)
    return json.stringify(try remove_cred(mut store, req.name))
}

// ---- Reveal and copy (D-029) ---------------------------------------------------------

// The single exception to Principle 6: the page asked to see one saved password. The
// value goes back to the page only, never to a log or an error.
fn rpc_secret_reveal(params: str, c: Sodium, store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    req := try parse_req[SecretReq](params)
    return json.stringify(RevealReply{ value: try reveal_password(c, store, st.vault_session(), req.kind, req.name) })
}

// Copies a saved password; the value never crosses RPC.
fn rpc_secret_copy(params: str, c: Sodium, store: LockedVaultStore, mut clip: OsClipboard, st: GuiState) -> str! {
    try st.require_unlocked()
    req := try parse_req[SecretReq](params)
    try copy_password(c, store, st.vault_session(), mut clip, req.kind, req.name)
    return ok_json()
}

// A remote program asked to set the clipboard (OSC 52). xterm.js hands the page the
// sequence's payload; the core parses it and writes it, since the webview's own
// clipboard API refuses a write no click started (Tether 57f8c51).
fn rpc_terminal_clipboard(params: str, mut clip: OsClipboard) -> str! {
    req := try parse_req[NameReq](params)
    return json.stringify(try osc52_copy(mut clip, req.name))
}

// Forgets a host's key: the explicit step before reconnecting to a host whose key
// changed (D-019). The core never replaces a key by itself.
fn rpc_known_host_rm(params: str, mut store: LockedVaultStore, st: GuiState) -> str! {
    try st.require_unlocked()
    req := try parse_req[NameReq](params)
    return json.stringify(try remove_known_host(mut store, req.name))
}

// ---- Sessions ---------------------------------------------------------------------------

// Checks a session request and opens its mailbox. The caller spawns the worker.
fn session_open_check(params: str, st: GuiState) -> SessionOpenReq! {
    try st.require_unlocked()
    req := try parse_req[SessionOpenReq](params)
    if req.session.len() == 0 || req.alias.len() == 0 {
        return error(coded(ERR_INVALID, "a session needs an id and a host alias"))
    }
    if gui_session_count() >= MAX_SESSIONS {
        return error(coded(ERR_CONFLICT, "{MAX_SESSIONS} sessions are open; close one first"))
    }
    if !gui_session_open(req.session, req.cols, req.rows) {
        return error(coded(ERR_CONFLICT, "session '{req.session}' already exists"))
    }
    return req
}

// The connection itself, on a worker thread. It ends with a "session:state" event:
// the shell's exit status, or an error code.
fn run_gui_session(mut app: webui.App, c: Sodium, mut store: LockedVaultStore, vs: VaultSession, req: SessionOpenReq) {
    mut opts := default_connect_options()
    opts.accept_new_host_key = req.accept_new_host_key
    opts.run_initial_command = !req.no_command
    // Lends the session to the Files view once its shell is open (D-053).
    mut link := new_shared_link(req.session)
    mut term := new_gui_terminal(app, req.session)
    prompter := new_gui_prompter(app, req.session)
    mut clock := new_system_clock()
    mut result: i64! = 0
    if req.files_only {
        // The second Files pane on a host with no open tab: no PTY (D-056).
        result = hold_files_session(c, mut store, vs, mut link, prompter, mut term, mut clock, req.alias, opts)
    } else {
        result = connect_host(c, mut store, vs, mut link, prompter, mut term, mut clock, req.alias, "xterm-256color", opts)
    }
    link.link_hangup()
    if result.has_value() {
        emit_session_state(mut app, req.session, "ended", "", "", result.value())
    } else {
        msg := "{result.error().message()}"
        emit_session_state(mut app, req.session, "ended", error_code_of(msg), error_text_of(msg), -1)
    }
    gui_session_drop(req.session)
}

// ---- Testing a host ------------------------------------------------------------------

// Checks a host test request and opens its mailbox, through which the host key
// prompt is answered. The caller spawns the worker.
fn host_test_check(params: str, st: GuiState) -> HostTestReq! {
    try st.require_unlocked()
    req := try parse_req[HostTestReq](params)
    _ := try parse_req[HostPatch](params)
    if req.session.len() == 0 {
        return error(coded(ERR_INVALID, "a host test needs an id"))
    }
    if gui_session_count() >= MAX_SESSIONS {
        return error(coded(ERR_CONFLICT, "{MAX_SESSIONS} sessions are open; close one first"))
    }
    if !gui_session_open(req.session, 80, 24) {
        return error(coded(ERR_CONFLICT, "session '{req.session}' already exists"))
    }
    return req
}

// The test itself, on a worker thread: the editor's unsaved form (`target` "" for a
// new host). It ends with a "host:test" event.
fn run_gui_host_test(mut app: webui.App, c: Sodium, mut store: LockedVaultStore, vs: VaultSession, req: HostTestReq, patch: HostPatch) {
    mut opts := default_connect_options()
    opts.accept_new_host_key = req.accept_new_host_key
    mut link := new_ssh_link()
    mut clock := new_system_clock()
    prompter := new_gui_prompter(app, req.session)
    r := test_host_draft(c, mut store, vs, mut link, prompter, mut clock, req.target, patch, opts) or err {
        link.link_hangup()
        msg := "{err.message()}"
        app.emit("host:test", HostTestEvent{ session: req.session, code: error_code_of(msg), message: error_text_of(msg), host: "", target: "", hops: 0, duration_ms: 0 })
        gui_session_drop(req.session)
        return
    }
    link.link_hangup()
    app.emit("host:test", HostTestEvent{ session: req.session, code: "", message: "", host: r.host, target: r.target, hops: r.hops, duration_ms: r.duration_ms })
    gui_session_drop(req.session)
}

// Typing, answering a prompt and closing a tab are refused while the window is
// locked: the sessions keep running behind its lock screen (D-043), out of reach.
fn rpc_session_input(params: str, st: GuiState) -> str! {
    try st.require_open_window()
    req := try parse_req[SessionInputReq](params)
    try gui_session_input(req.session, req.data)
    return ok_json()
}

fn rpc_session_resize(params: str) -> str! {
    req := try parse_req[SessionResizeReq](params)
    try gui_session_resize(req.session, req.cols, req.rows)
    return ok_json()
}

fn rpc_session_answer(params: str, st: GuiState) -> str! {
    try st.require_open_window()
    req := try parse_req[SessionAnswerReq](params)
    try gui_session_answer(req.session, req.prompt, req.ok, req.value)
    return ok_json()
}

fn rpc_session_close(params: str, st: GuiState) -> str! {
    try st.require_open_window()
    req := try parse_req[SessionReq](params)
    _ := gui_session_close(req.session)
    return ok_json()
}

// ---- Headless end-to-end run (scripts/gui-e2e.sh) ---------------------------------------

fn rpc_e2e_report(params: str, mut app: webui.App) -> str! {
    req := try parse_req[E2eReport](params)
    mut verdict := "fail: " + req.detail
    if req.ok {
        verdict = "pass"
    }
    app.set_state("e2e", verdict)
    return ok_json()
}

// The headless run's private clipboard, to check an OSC 52 copy. Bound only in that run.
fn rpc_e2e_clipboard(clip: OsClipboard) -> str! {
    return json.stringify(NameReq{ name: clipboard_read_text(clip.board) })
}

// Puts a PNG (base64 in `name`) alone on the run's clipboard, as a screenshot tool
// does, for the paste whose event arrives empty (milestone 25 on Linux).
fn rpc_e2e_clipboard_png(params: str, clip: OsClipboard) -> str! {
    req := try parse_req[NameReq](params)
    png := base64.decode_str(req.name) or err {
        return error(coded(ERR_INVALID, "not base64"))
    }
    if clipboard_copy_png(clip.board, png) != 0 {
        return error(coded(ERR_IO, "the clipboard refused the image"))
    }
    return ok_json()
}

fn rpc_e2e_log(params: str, mut app: webui.App) -> str! {
    req := try parse_req[NameReq](params)
    write_stderr("[page] {req.name}\n")
    // The last line, for the verdict when the page never reports (main.cf).
    app.set_state("e2e_last", req.name)
    return ok_json()
}
