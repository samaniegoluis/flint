package main

// The app keeps a connected vault in step with its server (milestone 43, D-098): a
// loop on its own thread that wakes every SYNC_TICK_MS, or at once when the page says
// the window came back or the person asked, and syncs when domain's `sync_due` says
// so. It never runs while the vault is locked (no key to merge with: the changes
// wait for the next unlock). What happened goes to the page as `vault:sync`, and a
// merge that changed the vault as `vault:changed`, so the lists show it. The page
// shows the sync's state (milestone 44, remote.cf and design 23c).

import "ext:webui"
import "core:json"
import "core:sync"
import "core:time"
import "core:os"
import "../../adapters/config"
import "../../adapters/crypto"
import "../../adapters/keychain" as flint_keychain
import "../../adapters/vault"
import "../../adapters/vaultremote"
import "../../application"
import "../../domain"

SYNC_TICK_MS: i64 = 2000

// What a Sync now or a new token tells the loop about a vault, as `<hint>:<path>`
// (milestone 71, D-146): a Sync now that worked (`resume`: the pause ends), one the
// server refused (`refused`: paused), a token replaced (`token`: the pause ends and
// the loop syncs at once, so the status reads the new token's outcome).
SYNC_HINT_RESUME: str = "resume"
SYNC_HINT_REFUSED: str = "refused"
SYNC_HINT_TOKEN: str = "token"

// Applies a `<hint>:<path>` to the clock and returns the hint the tick goes on with
// (`now` after a new token, "" after the others); any other hint comes back as it is.
fn apply_sync_hint(mut clock: domain.SyncClock, hint: str) -> str {
    colon := hint.index_of(":") or { return hint }
    what := str(hint[..colon])
    about := str(hint[colon + 1..])
    if what == SYNC_HINT_REFUSED {
        sync_pause(mut clock, about)
    } else if what == SYNC_HINT_RESUME {
        sync_resume(mut clock, about)
    } else if what == SYNC_HINT_TOKEN {
        sync_resume(mut clock, about)
        return SYNC_HINT_NOW
    }
    return ""
}

// Tells the loop what the person's own action learned about the vault at `path`.
fn tell_sync_loop(st: GuiState, hint: str, path: str) {
    st.sync_hints.send(hint + ":" + path)
}

// What the page hears as a sync starts; it shows Syncing only if it lasts.
SYNC_STATE_SYNCING: str = "syncing"

// What the page hears after each sync the app runs.
type SyncEvent struct {
    path:    str         `json:"path"`
    // SYNC_STATE_SYNCING, SYNC_IN_STEP, SYNC_UPLOADED, SYNC_MERGED, or "error".
    state:   str         `json:"state"`
    version: i64         `json:"version"`
    report:  domain.MergeReport `json:"report"`
    // The error's code and message when `state` is "error" (never a secret).
    code:    str         `json:"code"`
    message: str         `json:"message"`
}

type SyncHintReq struct {
    reason: str `json:"reason"`
}

// The page tells the loop to look (`focus` when the window came back, `now`).
// The `<what>:<path>` hints below come from the core itself, never from the page.
fn rpc_vault_sync_hint(params: str, st: GuiState) -> str! {
    req := try parse_req[SyncHintReq](params)
    if req.reason == SYNC_HINT_FOCUS || req.reason == SYNC_HINT_NOW {
        st.sync_hints.send(req.reason)
    }
    return ok_json()
}

fn run_sync_loop(c: crypto.Sodium, mut store: vault.LockedVaultStore, kc: flint_keychain.OsKeychain, settings_store: config.JsonSettingsStore, st: GuiState, mut app: webui.App) {
    links := new_json_remote_link_store(flint_config_dir())
    remote := new_http_vault_remote()
    mut clock := new_sync_clock()
    // FLINT_SYNC_DIAG=1: one stderr line per tick with what the loop saw (paths are
    // the vault's file path, already in the recents list; nothing from inside it).
    diag := (os.getenv("FLINT_SYNC_DIAG") or "") == "1"
    for !st.holder.quitting() {
        received := st.sync_hints.recv_timeout(SYNC_TICK_MS) or ""
        hint := apply_sync_hint(mut clock, received)
        if !st.unlocked() {
            clock.path = ""
            continue
        }
        session := st.vault_session()
        connected := remote_connected(links, session.path)
        if !connected {
            if diag {
                write_stderr("flint-gui: diag: sync tick at {time.now_ms()}: {session.path} not connected\n")
            }
            continue
        }
        interval := (load_settings(settings_store) or default_settings()).sync_interval
        pending := remote_pending(c, store, links, session.path)
        now := time.now_ms()
        due := sync_due(mut clock, session.path, now, pending, interval, hint)
        if diag {
            write_stderr("flint-gui: diag: sync tick at {now}: pending {pending} hint '{hint}' refused {sync_refused(clock, session.path)} due {due}\n")
        }
        if !due {
            continue
        }
        app.emit("vault:sync", SyncEvent{ path: session.path, state: SYNC_STATE_SYNCING, version: 0, report: empty_merge_report(), code: "", message: "" })
        mut s := session
        got := sync_vault(c, mut store, links, remote, kc, kc, mut s, "", time.unix_seconds() * 1000) or err {
            msg := "{err.message()}"
            code := error_code_of(msg)
            sync_checked(mut clock, session.path, time.now_ms(), code)
            if code == ERR_AUTH {
                write_stderr("flint-gui: sync failed (auth): paused until Sync now, a new token or a restart\n")
            } else {
                write_stderr("flint-gui: sync failed ({code})\n")
            }
            app.emit("vault:sync", SyncEvent{ path: session.path, state: "error", version: 0, report: empty_merge_report(), code: error_code_of(msg), message: msg })
            continue
        }
        sync_checked(mut clock, session.path, time.now_ms(), "")
        if got.result != SYNC_IN_STEP {
            write_stderr("flint-gui: synced ({got.result}, version {got.version})\n")
        }
        emit_sync_outcome(mut app, session.path, session.name, got)
    }
}
