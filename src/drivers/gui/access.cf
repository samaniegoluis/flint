package main

// The approval window's side of caller approval (milestone 12, Principle 12): the
// requests waiting for the owner, the live grants, and the owner's answer. The
// socket server waits on the book (serve.cf, `gate`); these handlers change it.

import "core:encoding/hex"
import "core:str"
import "core:time"
import "ext:json"
import "ext:webui"
import "../../adapters/crypto"
import "../../adapters/uievents"
import "../../adapters/vault"
import "../../application"
import "../../domain"

type AccessState struct {
    // How Allow is confirmed: touchid, device, polkit or password.
    presence: str        `json:"presence"`
    // The core's clock (monotonic, not the wall clock): the page turns deadlines and
    // expiries into its own time with it.
    now_ms:   i64        `json:"now_ms"`
    pending:  []Approval `json:"pending"`
    grants:   []GrantView `json:"grants"`
}

type AccessAnswer struct {
    id:       str         `json:"id"`
    allow:    bool        `json:"allow"`
    scope:    ScopeByName `json:"scope"`
    read:     bool        `json:"read"`
    exec:     bool        `json:"exec"`
    write:    bool        `json:"write"`
    duration: str         `json:"duration"`
    // The master password, only when the presence method is "password".
    password: str         `json:"password"`
    // `exec --sudo` (milestone 13): a sudo password typed for this command, and
    // whether to keep it as the host's.
    sudo_password:      str  `json:"sudo_password"`
    save_sudo_password: bool `json:"save_sudo_password"`
}

type GrantsChanged struct {
    count: i64 `json:"count"`
}

fn access_state(st: GuiState, store: LockedVaultStore, presence: OsPresence) -> AccessState {
    now := time.now_ms()
    if st.holder.window_locked() {
        // A locked window shows none of it: the lock screen counts who waits.
        return AccessState{ presence: presence.presence_method(), now_ms: now, pending: [], grants: [] }
    }
    book := st.holder.access_book()
    cat := held_catalog(st, store)
    return AccessState{ presence: presence.presence_method(), now_ms: now, pending: waiting_approvals(book, now), grants: grant_views(live_grants(book.grants, now), cat) }
}

// The open vault's catalog, or an empty one when it is locked.
fn held_catalog(st: GuiState, store: LockedVaultStore) -> Catalog {
    empty := Catalog{ groups: [], hosts: [], keys: [], creds: [] }
    st.hold()
    defer st.release()
    if !st.unlocked() {
        return empty
    }
    return load_catalog(store) or empty
}

// What the window shows: run on the UI thread, it never asks the OS.
fn rpc_access_state(st: GuiState, store: LockedVaultStore, presence: OsPresence) -> str! {
    return json.stringify(access_state(st, store, presence))
}

// The owner answers approval `id`. Allow first proves presence (the OS's check, or
// the master password checked against the key held), then becomes a grant. Runs on
// a worker: Touch ID and polkit block until the person answers.
fn rpc_access_answer(req: AccessAnswer, c: Sodium, store: LockedVaultStore, presence: OsPresence, st: GuiState, mut app: webui.App) -> AccessState! {
    try st.require_unlocked()
    ap := find_approval(st.holder.access_book(), req.id) or {
        return error(coded(ERR_NOT_FOUND, "this request is no longer waiting"))
    }
    if ap.state != APPROVAL_PENDING {
        return error(coded(ERR_NOT_FOUND, "this request is no longer waiting"))
    }
    if !req.allow {
        st.holder.access_hold()
        mut book := st.holder.access_book()
        _ := set_approval_state(mut book, req.id, APPROVAL_DENIED)
        st.holder.put_access_book(book)
        st.holder.access_release()
        return access_state(st, store, presence)
    }
    if ap.sudo.host.len() > 0 {
        // `exec --sudo`: allowed for this one command, never as a grant.
        try confirm_presence(c, store, presence, st.vault_session(), req.password, "run \"{str.join(ap.sudo.argv, " ")}\" as root on {ap.sudo.host}")
        if req.save_sudo_password && req.sudo_password.len() > 0 {
            st.hold()
            mut ts := store
            saved := set_host_sudo_password(c, mut ts, st.vault_session(), ap.sudo.host, req.sudo_password)
            st.release()
            if !saved.has_value() {
                return error("{saved.error().message()}")
            }
            app.emit("vault:changed", VaultChanged{ path: st.vault_session().path, name: st.vault_session().name })
        }
        st.holder.access_hold()
        mut sbook := st.holder.access_book()
        if !set_approval_state(mut sbook, req.id, APPROVAL_ALLOWED) {
            st.holder.access_release()
            return error(coded(ERR_NOT_FOUND, "this request stopped waiting before it was allowed"))
        }
        if req.sudo_password.len() > 0 {
            put_sudo_typed(mut sbook, req.id, req.sudo_password)
        }
        st.holder.put_access_book(sbook)
        st.holder.access_release()
        // No host here: the log never names what is inside the vault (Principle 5).
        write_stderr("flint-gui: allowed {ap.label} to run one command as root\n")
        return access_state(st, store, presence)
    }
    if ap.token.name.len() > 0 {
        // `token create`: allowed for this one request, never as a grant.
        try confirm_presence(c, store, presence, st.vault_session(), req.password, "create the token \"{ap.token.name}\" in the vault {st.vault_session().name}")
        st.holder.access_hold()
        mut tbook := st.holder.access_book()
        if !set_approval_state(mut tbook, req.id, APPROVAL_ALLOWED) {
            st.holder.access_release()
            return error(coded(ERR_NOT_FOUND, "this request stopped waiting before it was allowed"))
        }
        st.holder.put_access_book(tbook)
        st.holder.access_release()
        write_stderr("flint-gui: allowed {ap.label} to create a token\n")
        return access_state(st, store, presence)
    }
    // Checked before presence, so a bad form never shows the OS dialog.
    scope := try access_scope_from_names(held_catalog(st, store), req.scope)
    _ := try grant_from_approval(ap, "check", scope, req.read, req.exec, req.write, req.duration, time.now_ms())
    try confirm_presence(c, store, presence, st.vault_session(), req.password, "let \"{ap.label}\" use the vault {st.vault_session().name}")
    st.holder.access_hold()
    mut book := st.holder.access_book()
    still := find_approval(book, req.id) or ap
    if still.state != APPROVAL_PENDING || !find_approval(book, req.id).has_value() {
        st.holder.access_release()
        return error(coded(ERR_NOT_FOUND, "this request stopped waiting before it was allowed"))
    }
    g := grant_from_approval(ap, hex.encode(c.random_bytes(8)), scope, req.read, req.exec, req.write, req.duration, time.now_ms()) or err {
        st.holder.access_release()
        return error("{err.message()}")
    }
    book.grants.push(g)
    _ := set_approval_state(mut book, req.id, APPROVAL_ALLOWED)
    st.holder.put_access_book(book)
    st.holder.access_release()
    write_stderr("flint-gui: allowed {ap.label} ({g.duration})\n")
    app.emit("access:changed", GrantsChanged{ count: i64(book.grants.len()) })
    return access_state(st, store, presence)
}

// Ends grant `id`, or every grant when `id` is "".
fn rpc_access_revoke(params: str, st: GuiState, store: LockedVaultStore, presence: OsPresence, mut app: webui.App) -> str! {
    try st.require_open_window()
    req := try parse_req[NameReq](params)
    st.holder.access_hold()
    mut book := st.holder.access_book()
    if req.name.len() == 0 {
        book.grants = []
    } else if !revoke_grant(mut book, req.name) {
        st.holder.access_release()
        return error(coded(ERR_NOT_FOUND, "no such grant"))
    }
    st.holder.put_access_book(book)
    st.holder.access_release()
    app.emit("access:changed", GrantsChanged{ count: i64(book.grants.len()) })
    return json.stringify(access_state(st, store, presence))
}

// ---- Tokens and the activity log (milestone 12b) ------------------------------------

type TokensState struct {
    now_s:  i64         `json:"now_s"`
    tokens: []TokenView `json:"tokens"`
}

type ActivityReq struct {
    before: i64 `json:"before"`
    limit:  i64 `json:"limit"`
}

type ActivityPage struct {
    entries: []ActivityEntry `json:"entries"`
}

fn rpc_tokens_list(st: GuiState, store: LockedVaultStore) -> str! {
    st.hold()
    defer st.release()
    try st.require_unlocked()
    now := time.unix_seconds()
    return json.stringify(TokensState{ now_s: now, tokens: try list_tokens(store, store, now) })
}

// The owner revokes a token from Settings → Access. Narrowing access needs no presence.
fn rpc_token_revoke(params: str, st: GuiState, store: LockedVaultStore, mut app: webui.App) -> str! {
    req := try parse_req[NameReq](params)
    st.hold()
    defer st.release()
    try st.require_unlocked()
    now := time.unix_seconds()
    mut ts := store
    _ := try revoke_token(store, mut ts, req.name, now)
    app.emit("access:changed", GrantsChanged{ count: i64(st.holder.access_book().grants.len()) })
    return json.stringify(TokensState{ now_s: now, tokens: try list_tokens(store, store, now) })
}

fn rpc_activity_log(params: str, st: GuiState, store: LockedVaultStore) -> str! {
    req := try parse_req[ActivityReq](params)
    st.hold()
    defer st.release()
    try st.require_unlocked()
    return json.stringify(ActivityPage{ entries: try list_activity(store, req.before, req.limit) })
}
