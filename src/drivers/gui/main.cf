package main

// The Flint desktop app: composition root. It builds the adapters, opens the webui
// window with the React page (ui/), and binds every RPC to its handler (rpc.cf).
//
// RPC handlers run on the UI thread, so a session runs on a worker:
// `session_open` checks the request, spawns the connection and returns at once;
// bytes, prompts and state changes come back as events (src/adapters/uievents). The
// page mints the session id and subscribes before it asks.

import "ext:webui"
import "core:fs"
import "core:os"
import "../../adapters/config"
import "../../adapters/crypto"
import "../../adapters/fonts"
import "../../adapters/keychain"
import "../../adapters/process"
import "../../adapters/rdp"
import "../../adapters/ssh"
import "../../adapters/uievents"
import "../../adapters/vault"
import "../../application"
import "../clicmd"

// Where the built page is: $FLINT_UI_DIR, then the app bundle's Resources/ui, then
// ui/ next to the executable, then ui/dist in a source checkout.
fn find_ui_dir() -> str {
    override := os.getenv("FLINT_UI_DIR")
    if override.len() > 0 {
        return override
    }
    exe := executable_dir()
    dirs: []str = [exe + "/../Resources/ui", exe + "/ui", exe + "/../../ui/dist", "ui/dist"]
    for dir in dirs {
        if fs.exists(dir + "/index.html") {
            return dir
        }
    }
    return "ui/dist"
}

// Once per machine, the keys earlier Flints cached on every unlock go (D-048); says
// on stderr what happened.
fn report_forget_cached_keys(mut settings_store: JsonSettingsStore, store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore) {
    removed := forget_cached_keys_once(mut settings_store, store, kc, recents) or err {
        write_stderr("flint-gui: cached vault keys left in place: {err.message()}\n")
        return
    }
    if removed > 0 {
        write_stderr("flint-gui: removed {removed} vault keys an earlier Flint cached; Remember on this computer brings one back\n")
    }
}

fn main() {
    ui_dir := find_ui_dir()
    e2e_script: str = os.getenv("FLINT_GUI_E2E")
    e2e := e2e_script.len() > 0

    // One Flint per config folder: a second launch shows the running one's window
    // (closed to the tray, it comes back locked) and exits.
    if !e2e && show_running_app() {
        write_stderr("flint-gui: Flint is already running; showed its window\n")
        return
    }

    mut app := webui.new_app("Flint", 1280, 800)
    defer app.close()
    app.set_min_size(900, 600)
    if !fs.exists(ui_dir + "/index.html") {
        write_stderr("flint-gui: no page at {ui_dir}/index.html; build it with scripts/build-gui.sh\n")
        exit_process(1)
        return
    }
    app.serve_dir(ui_dir)
    if e2e {
        script := fs.read_text(e2e_script) or ""
        app.embed_asset("/e2e.js", script, "text/javascript")
    }

    sodium_ok := new_sodium() or err {
        write_stderr("flint-gui: libsodium failed to start\n")
        exit_process(1)
        return
    }
    c := sodium_ok
    config_dir := flint_config_dir()
    mut store := new_locked_vault_store(config_dir + "/activity")
    kc := new_os_keychain(os.getenv("FLINT_KEYCHAIN") != "off")
    recents := new_json_recent_store(config_dir)
    mut settings_store := new_json_settings_store(config_dir)
    mut ui_state_store := new_json_ui_state_store(config_dir)
    inspector := new_libssh_key_inspector()
    font_catalog := new_os_font_catalog()
    mut clipboard := new_os_clipboard()
    if e2e {
        // The headless run copies a marker password: keep it off the real clipboard
        // (macOS; on Linux the run has its own X display).
        clipboard.board = "net.flint.gui-e2e"
    }
    mut st := new_gui_state()
    st.holder.set_lock_after((load_settings(settings_store) or default_settings()).lock_after)
    // Once per machine: the keys earlier Flints cached on every unlock go (D-048).
    if os.getenv("FLINT_KEYCHAIN") != "off" {
        report_forget_cached_keys(mut settings_store, store, kc, recents)
    }

    app.bind_raw("app_info") |params| { return rpc_app_info(e2e) }
    app.bind_raw("rdp_key") |params| { return rpc_rdp_key(params, st) }
    app.bind_raw("rdp_pointer") |params| { return rpc_rdp_pointer(params, st) }
    app.bind_raw("rdp_resize") |params| { return rpc_rdp_resize(params) }
    // Milestone 38: a desktop across monitors (design 22f).
    app.bind_raw("rdp_span") |params| { return rpc_rdp_span(params, mut ui_state_store, st) }
    app.bind_raw("monitors_list") |params| { return rpc_monitors_list(ui_state_store) }
    app.bind_raw("monitors_open") |params| { return rpc_monitors_open(params, st) }
    app.bind_raw("monitors_close") |params| { return rpc_monitors_close() }
    app.bind_raw("monitors_send") |params| { return rpc_monitors_send(params) }
    app.bind_raw("rdp_close") |params| { return rpc_rdp_close(params, st) }
    app.bind_raw("rdp_stats") |params| { return rpc_rdp_stats(params) }
    app.bind_raw("rdp_graphics") |params| { return rpc_rdp_graphics(params, st) }
    app.bind_raw("rdp_clipboard_announce") |params| { return rpc_rdp_clipboard_announce(params, mut clipboard, st) }
    app.bind_raw("window_theme") |params| { return rpc_window_theme(params, mut app) }
    app.bind_raw("dialog_open") |params| { return rpc_dialog_open(params, app) }
    app.bind_raw("dialog_save") |params| { return rpc_dialog_save(params, app) }
    app.bind_raw("settings_get") |params| { return rpc_settings_get(settings_store) }
    app.bind_raw("settings_set") |params| { return rpc_settings_set(params, mut settings_store, st) }
    app.bind_raw("fonts_mono") |params| { return rpc_fonts_mono(font_catalog) }
    app.bind_raw("ui_state_get") |params| { return rpc_ui_state_get(ui_state_store, store, st) }
    app.bind_raw("ui_state_set") |params| { return rpc_ui_state_set(params, mut ui_state_store, store, st) }

    app.bind_raw("vault_recents") |params| { return rpc_vault_recents(store, recents) }
    // On a worker: captures are read-only there, and the copies share the store's
    // connection and the state's holder.
    app.bind_async[UnlockReq]("vault_unlock") |req| {
        mut s := store
        mut g := st
        return rpc_vault_unlock(req, c, mut s, kc, recents, mut g)
    }
    app.bind_async[CreateReq]("vault_create") |req| {
        mut s := store
        mut g := st
        return rpc_vault_create(req, c, mut s, kc, recents, mut g)
    }
    app.bind_async[PasswdReq]("vault_passwd") |req| {
        mut s := store
        mut g := st
        return rpc_vault_passwd(req, c, mut s, kc, mut g)
    }
    app.bind_raw("password_strength") |params| { return rpc_password_strength(params, st) }
    app.bind_raw("vault_close") |params| { return rpc_vault_close(mut store, mut st) }
    app.bind_raw("vault_lock") |params| { return rpc_vault_lock(mut store, st, mut app) }
    app.bind_raw("activity") |params| { return rpc_activity(st) }
    app.bind_raw("unlock_request") |params| { return rpc_unlock_request(st, recents) }
    app.bind_raw("unlock_request_dismiss") |params| { return rpc_unlock_request_dismiss(st) }
    presence := new_os_presence()
    app.bind_raw("access_state") |params| { return rpc_access_state(st, store, presence) }
    app.bind_raw("access_revoke") |params| { return rpc_access_revoke(params, st, store, presence, mut app) }
    app.bind_raw("tokens_list") |params| { return rpc_tokens_list(st, store) }
    app.bind_raw("token_revoke") |params| { return rpc_token_revoke(params, st, store, mut app) }
    app.bind_raw("activity_log") |params| { return rpc_activity_log(params, st, store) }
    app.bind_raw("activity_retention") |params| { return rpc_activity_retention(st, store) }
    app.bind_raw("activity_retention_preview") |params| { return rpc_activity_retention_preview(params, st, store) }
    app.bind_raw("activity_retention_set") |params| { return rpc_activity_retention_set(params, st, store, mut app) }
    app.bind_raw("activity_backup") |params| { return rpc_activity_backup(params, st, store) }
    // On a worker: Touch ID and polkit block until the person answers.
    app.bind_async[AccessAnswer]("access_answer") |req| {
        mut a := app
        return rpc_access_answer(req, c, store, presence, st, mut a)
    }
    app.bind_raw("vault_remembered") |params| { return rpc_vault_remembered(params, st) }
    app.bind_raw("window_state") |params| { return rpc_window_state(st, presence) }
    // On a worker: Touch ID and polkit block until the person answers.
    app.bind_async[WindowUnlockReq]("window_unlock") |req| {
        mut a := app
        return rpc_window_unlock(req, c, store, presence, st, mut a)
    }
    app.bind_raw("window_fullscreen") |params| { return rpc_window_fullscreen(params, e2e) }
    app.bind_raw("app_quit") |params| {
        mut a := app
        return rpc_app_quit(mut a)
    }
    app.bind_raw("vault_forget_key") |params| { return rpc_vault_forget_key(params, mut store, kc, mut st) }
    app.bind_raw("vault_forget") |params| { return rpc_vault_forget(params, mut store, kc, recents, mut st) }
    app.bind_raw("vault_status") |params| { return rpc_vault_status(mut store, st) }
    app.bind_raw("vault_rename") |params| { return rpc_vault_rename(params, mut store, recents, mut st) }

    app.bind_raw("catalog") |params| { return rpc_catalog(store, st) }
    app.bind_raw("group_add") |params| { return rpc_group_add(params, c, mut store, st) }
    app.bind_raw("group_rename") |params| { return rpc_group_rename(params, mut store, st) }
    app.bind_raw("group_rm") |params| { return rpc_group_rm(params, mut store, st) }
    app.bind_raw("host_add") |params| { return rpc_host_add(params, c, mut store, st) }
    app.bind_raw("host_edit") |params| { return rpc_host_edit(params, c, mut store, st) }
    app.bind_raw("host_rm") |params| { return rpc_host_rm(params, mut store, st) }
    app.bind_raw("key_add") |params| { return rpc_key_add(params, c, mut store, inspector, st) }
    app.bind_raw("key_rename") |params| { return rpc_key_rename(params, mut store, st) }
    app.bind_raw("key_rm") |params| { return rpc_key_rm(params, mut store, st) }
    app.bind_raw("cred_add") |params| { return rpc_cred_add(params, c, mut store, st) }
    app.bind_raw("cred_edit") |params| { return rpc_cred_edit(params, c, mut store, st) }
    app.bind_raw("cred_rm") |params| { return rpc_cred_rm(params, mut store, st) }
    app.bind_raw("known_host_rm") |params| { return rpc_known_host_rm(params, mut store, st) }
    // Tunnels (milestone 23, tunnels.cf).
    app.bind_raw("tunnels_list") |params| { return rpc_tunnels_list(store, st) }
    app.bind_raw("tunnel_save") |params| {
        mut a := app
        return rpc_tunnel_save(params, c, store, st, mut a)
    }
    app.bind_raw("tunnel_rm") |params| {
        mut a := app
        return rpc_tunnel_rm(params, store, st, mut a)
    }
    app.bind_raw("tunnel_stop") |params| {
        mut a := app
        return rpc_tunnel_stop(params, store, st, mut a)
    }
    app.bind_raw("secret_reveal") |params| { return rpc_secret_reveal(params, c, store, st) }
    app.bind_raw("secret_copy") |params| { return rpc_secret_copy(params, c, store, mut clipboard, st) }

    app.bind_raw("terminal_clipboard") |params| { return rpc_terminal_clipboard(params, mut clipboard) }
    app.bind_raw("session_input") |params| { return rpc_session_input(params, st) }
    app.bind_raw("session_resize") |params| { return rpc_session_resize(params) }
    app.bind_raw("session_answer") |params| { return rpc_session_answer(params, st) }
    app.bind_raw("session_close") |params| { return rpc_session_close(params, st) }
    // The Files view (files.cf): each request on its own worker thread.
    app.bind_async[FilesPathReq]("files_home") |req| { return rpc_files_home(req, st) }
    app.bind_async[FilesPathReq]("files_list") |req| { return rpc_files_list(req, st) }
    app.bind_async[FilesRenameReq]("files_rename") |req| { return rpc_files_rename(req, st) }
    app.bind_async[FilesPathReq]("files_remove") |req| { return rpc_files_remove(req, st) }
    app.bind_async[FilesPathReq]("files_mkdir") |req| { return rpc_files_mkdir(req, st) }
    app.bind_async[FilesTransferReq]("files_transfer") |req| { return rpc_files_transfer(req, app, st) }
    app.bind_async[FilesRelayReq]("files_relay") |req| { return rpc_files_relay(req, app, st) }
    mut drops := new_fs_drop_stage(config_dir)
    drops.stage_clear_all()
    // The page awaits each chunk before it sends the next, so a drop is appended in order.
    app.bind_async[FilesStageReq]("files_stage") |req| {
        mut d := drops
        return rpc_files_stage(req, mut d, st)
    }
    // Paste into the terminal (paste.cf, milestone 25).
    app.bind_async[TerminalPasteReq]("terminal_paste") |req| {
        mut d := drops
        return rpc_terminal_paste(req, mut d, settings_store, st)
    }
    app.bind_raw("terminal_clipboard_read") |params| {
        mut d := drops
        return rpc_terminal_clipboard_read(params, mut clipboard, mut d, st)
    }
    app.bind_raw("files_stage_discard") |params| {
        req := try parse_req[FilesIdReq](params)
        mut d := drops
        return rpc_files_stage_discard(req, mut d)
    }
    app.bind_raw("files_cancel") |params| {
        req := try parse_req[FilesIdReq](params)
        return rpc_files_cancel(req)
    }
    app.bind_raw("e2e_report") |params| { return rpc_e2e_report(params, mut app) }
    app.bind_raw("e2e_log") |params| { return rpc_e2e_log(params, mut app) }
    if e2e {
        app.bind_raw("e2e_clipboard") |params| { return rpc_e2e_clipboard(clipboard) }
        app.bind_raw("e2e_clipboard_png") |params| { return rpc_e2e_clipboard_png(params, clipboard) }
        app.bind_raw("e2e_clipboard_set") |params| { return rpc_e2e_clipboard_set(params, clipboard) }
        // Stands in for the window's close button with the tray (milestone 14).
        app.bind_raw("e2e_close_window") |params| {
            mut a := app
            lock_window(st, mut a)
            return ok_json()
        }
        // Stands in for the OS entering or leaving full screen by its own means (the
        // green button, the system's own keys), milestone 37.
        app.bind_raw("e2e_window_fullscreen") |params| {
            req := try parse_req[FullscreenReq](params)
            // With the real full screen, the window itself moves, as the green button does.
            if e2e_native_fullscreen() {
                window_fullscreen_set(req.on)
            } else {
                window_fullscreen_inject(req.on)
            }
            return ok_json()
        }
        // Stands in for the OS's screen lock and sleep (D-042).
        app.bind_raw("e2e_system_event") |params| {
            req := try parse_req[NameReq](params)
            system_events_inject(req.name)
            return ok_json()
        }
    }

    async.scope(workers: 64) |scope| {
        app.bind_raw("session_open") |params| {
            r := session_open_check(params, st) or err {
                return error("{err.message()}")
            }
            worker_app := app
            worker_store := store
            vs := st.vault_session()
            emit_session_state(mut app, r.session, "connecting", "", "", 0)
            scope.spawn || {
                // Captures are read-only inside the task: take mutable copies.
                mut a := worker_app
                mut s := worker_store
                run_gui_session(mut a, c, mut s, vs, r)
            }
            return ok_json()
        }
        // The RDP tab (rdp.cf, milestone 30).
        app.bind_raw("rdp_open") |params| {
            r := rdp_open_check(params, st) or err {
                return error("{err.message()}")
            }
            worker_app := app
            worker_store := store
            vs := st.vault_session()
            holder := st.holder
            // The system clipboard (the run's private board under gui-e2e).
            board := clipboard
            emit_rdp_state(mut app, r.tab, "connecting", "", "")
            scope.spawn || {
                mut a := worker_app
                mut s := worker_store
                run_gui_rdp(mut a, c, mut s, vs, holder, board, r)
            }
            return ok_json()
        }
        app.bind_raw("host_test") |params| {
            req := host_test_check(params, st) or err {
                return error("{err.message()}")
            }
            patch := parse_req[HostPatch](params) or empty_host_patch()
            worker_app := app
            worker_store := store
            vs := st.vault_session()
            r := req
            scope.spawn || {
                // Captures are read-only inside the task: take mutable copies.
                mut a := worker_app
                mut s := worker_store
                run_gui_host_test(mut a, c, mut s, vs, r, patch)
            }
            return ok_json()
        }
        app.bind_raw("tunnel_start") |params| {
            r := tunnel_start_check(params, st) or err {
                return error("{err.message()}")
            }
            worker_app := app
            worker_store := store
            vs := st.vault_session()
            scope.spawn || {
                mut a := worker_app
                mut s := worker_store
                run_tunnel_start(mut a, c, mut s, vs, r)
            }
            return ok_json()
        }
        // Tells the page when running tunnels change (tunnels.cf).
        watch_app := app
        watch_st := st
        scope.spawn || {
            mut a := watch_app
            run_tunnel_watch(watch_st, mut a)
        }
        // The CLI's way into the vault unlocked here (serve.cf, D-038, D-042): several
        // accept loops on one listener, since a `flint connect` keeps its connection.
        mut listener := start_serving(config_dir)
        if listener.open {
            for i in 0..SERVE_ACCEPTORS {
                loop_listener := listener
                loop_store := store
                loop_app := app
                loop_st := st
                scope.spawn || {
                    mut s := loop_store
                    mut a := loop_app
                    run_accept_loop(loop_listener, c, mut s, kc, recents, loop_st, mut a)
                }
            }
        }
        // Auto-lock: idle time, screen lock and sleep.
        write_stderr("flint-gui: locks on idle, {system_events_start()}\n")
        timer_store := store
        timer_app := app
        timer_st := st
        scope.spawn || {
            mut s := timer_store
            mut a := timer_app
            run_lock_timer(mut s, timer_st, mut a)
        }
        install_app_menu("Flint")
        // Full screen (milestone 37): the page hears every change as `window:fullscreen`.
        window_fullscreen_install(app)
        // The extra monitors' windows (milestone 38) load the same page folder.
        monitors_install(app, ui_dir)
        // The tray (milestone 14): closing the window keeps Flint serving, with the
        // window locked. The headless end-to-end run keeps the old close.
        if !e2e {
            install_tray(mut app, ui_dir)
        }
        app.on("window:close_requested") |data| {
            mut a := app
            lock_window(st, mut a)
        }
        app.on(TRAY_OPEN) |data| {
            mut a := app
            show_window(mut a)
        }
        app.on(TRAY_LOCK) |data| {
            mut s := store
            mut a := app
            _ := lock_now(mut s, st, mut a, "manual")
        }
        app.on(TRAY_QUIT) |data| {
            mut a := app
            quit_app(mut a)
        }
        // On Linux the end-to-end run opens the real window under xvfb-run
        // (scripts/linux), and the page quits when done. On macOS it runs in cfire's
        // offscreen window, or in the real one when asked (milestone 27), with a
        // worker that keeps the run's cap.
        visible_e2e := e2e && os_name() == "mac" && e2e_visible()
        if visible_e2e {
            cap_app := app
            cap_st := st
            scope.spawn || {
                mut a := cap_app
                run_e2e_cap(cap_st, mut a)
            }
        }
        if e2e && os_name() == "mac" && !visible_e2e {
            _ := app.run_webview_test(e2e_timeout_ms()) or false
        } else {
            app.run()
        }
        st.holder.set_quitting()
        gui_session_close_all()
        // Remote desktops too (milestone 30).
        close_all_desktops()
        // Tunnels run in this process only: quitting closes them (D-062).
        release_all_tunnels()
        listener.close()
    }
    // Waits for an unlock or create still running on a worker, then closes.
    st.hold()
    st.forget()
    close_vault(mut store)
    st.release()

    if e2e {
        mut verdict := app.get_state("e2e")
        // No verdict: the page never reported (it froze, or the run hit its cap).
        // Name the last thing it logged, so the failure says where it stopped.
        if verdict.len() == 0 {
            verdict = "fail: no verdict in {e2e_timeout_ms() / 1000} s; last page line: {app.get_state("e2e_last")}"
        }
        write_stdout("e2e: {verdict}\n")
        if verdict != "pass" {
            exit_process(1)
        }
    }
}
