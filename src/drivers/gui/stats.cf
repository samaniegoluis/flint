package main

// Live server resources (milestone 55, designs 25a, 25b). The page starts a watch
// for each terminal tab whose shell is open while *Show server resources* is on,
// and stops it when the setting turns off; closing the tab, or its session ending,
// stops it in the core (adapters/ssh/stats.cf). Each watch runs on a worker of its
// own and emits `stats:sample` (domain.ServerSample) for the page.

import "ext:webui"
import "../../adapters/process"
import "../../adapters/ssh"
import "../../application"
import "../../domain"

type StatsWatchReq struct {
    // The tab's session id, and the page's id for this watch (letters, digits, '-').
    session: str `json:"session"`
    watch:   str `json:"watch"`
}

type GuiStatsSink struct {
    app: webui.App
}

fn (mut self: GuiStatsSink) stats_emit(sample: ServerSample) {
    self.app.emit("stats:sample", sample)
}

fn stats_watch_check(params: str, st: GuiState) -> StatsWatchReq! {
    try st.require_unlocked()
    req := try parse_req[StatsWatchReq](params)
    if req.session.len() == 0 || !valid_drop_id(req.watch) {
        return error(coded(ERR_INVALID, "a watch needs a session and an id"))
    }
    return StatsWatchReq{ session: req.session, watch: req.watch }
}

// The watch itself, on a worker thread, until it ends.
fn run_gui_stats(mut app: webui.App, req: StatsWatchReq) {
    mut sink := GuiStatsSink{ app: app }
    mut ch := borrow_stats(req.session, req.watch) or {
        // The tab's shell is not open (or is closing): nothing to show.
        sink.stats_emit(ServerSample{ session: req.session, os: "", interfaces: [] })
        return
    }
    mut clock := new_system_clock()
    watch_server_stats(mut ch, mut sink, mut clock, req.session)
    ch.stats_release()
}

fn rpc_stats_stop(params: str) -> str! {
    req := try parse_req[StatsWatchReq](params)
    if !valid_drop_id(req.watch) {
        return error(coded(ERR_INVALID, "a watch needs its id"))
    }
    stats_cancel(req.watch)
    return ok_json()
}
