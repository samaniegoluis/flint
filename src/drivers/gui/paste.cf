package main

// Paste into the terminal (milestone 25, D-066): the page has staged an image from
// the clipboard on this machine (`files_stage`, as a drop); this writes it on the
// pane's host over the pane's own session and returns the path the page pastes.
// Like typing, refused while the window is locked (D-043). Not in the activity log,
// as the window's own copies (D-055).

import "core:json"
import "../../adapters/config"
import "../../adapters/process"
import "../../adapters/ssh" as flint_ssh
import "../../adapters/uievents"
import "../../application"
import "../../domain"

type TerminalPasteReq struct {
    session: str `json:"session"`
    // The staging drop and the file's path inside it (what `files_stage` was sent).
    drop:    str `json:"drop"`
    rel:     str `json:"rel"`
    // The name on the clipboard and its MIME type.
    name:    str `json:"name"`
    kind:    str `json:"kind"`
}

fn rpc_terminal_paste(req: TerminalPasteReq, mut stage: process.FsDropStage, settings: config.JsonSettingsStore, st: GuiState) -> application.PasteResult! {
    try st.require_open_window()
    if !domain.valid_drop_id(req.drop) || !domain.valid_drop_path(req.rel) {
        return error(domain.coded(domain.ERR_INVALID, "a paste needs its staged file"))
    }
    defer application.discard_dropped(mut stage, req.drop)
    mut link := try flint_ssh.borrow_transfer(req.session, req.drop)
    defer flint_ssh.give_back_transfer(req.session, req.drop, mut link)
    mut local := process.new_local_fs()
    paste := application.PasteRequest{ id: req.drop, local: domain.remote_join(stage.stage_folder(req.drop), req.rel), name: req.name, kind: req.kind, limit_mb: 0 }
    return try application.paste_over_session(mut link, mut local, settings, paste)
}

type ClipboardPasteReq struct {
    drop: str `json:"drop"`
    rel:  str `json:"rel"`
}

// The page's paste event arrived empty (WebKitGTK): the core reads the clipboard and
// stages an image in the drop the page named, for `terminal_paste` to write. Bound
// synchronously: GTK's clipboard is read on the UI thread.
fn rpc_terminal_clipboard_read(params: str, mut clip: uievents.OsClipboard, mut stage: process.FsDropStage, st: GuiState) -> str! {
    try st.require_open_window()
    req := try parse_req[ClipboardPasteReq](params)
    return json.stringify(try application.stage_clipboard(mut clip, mut stage, req.drop, req.rel))
}

// The field menu (milestone 64): Paste and Copy in a text field, through the core,
// since a release build has no engine menu and the webview's clipboard API asks for a
// permission. Bound synchronously, like `terminal_clipboard_read` (GTK's clipboard is
// read on the UI thread). The lock screen's master password field pastes too: the
// clipboard is not the vault, and Flint's own secret is refused either way.
fn rpc_field_clipboard_read(mut clip: uievents.OsClipboard) -> str! {
    return json.stringify(try application.field_paste_text(mut clip))
}

fn rpc_field_clipboard_copy(params: str, mut clip: uievents.OsClipboard) -> str! {
    req := try parse_req[NameReq](params)
    try application.field_copy_text(mut clip, req.name)
    return ok_json()
}
