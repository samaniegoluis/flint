package main

// The update notice (milestone 52, D-106, D-116): a loop on its own thread checks the
// latest release's signed manifest at launch and every hour while the automatic check
// is on, or at once when the page asks (Check now). Each outcome goes to the page as
// `update:status`; the page asks for the last one with the hint `status`. Opening a
// release page and What's new are RPCs. Milestone 53: Download (the hint `download`)
// fetches, checks and unpacks the package on this thread while another one emits
// `update:progress`; Relaunch (`relaunch`) starts update-apply and quits. At launch a
// package already unpacked is offered as Ready, and why the last update was not
// applied is said once.

import "ext:webui"
import "core:encoding/hex"
import "core:fs"
import "core:json"
import "core:os"
import "core:sync"
import "core:time"
import "../../adapters/config"
import "../../adapters/crypto"
import "../../adapters/process"
import "../../adapters/vaultremote"
import "../../application"
import "../../domain"
import "../version"

UPDATE_TICK_MS: i64 = 1000
// The first automatic check waits for the page to listen.
UPDATE_FIRST_CHECK_MS: i64 = 3000
UPDATE_HINT_NOW: str = "now"
UPDATE_HINT_STATUS: str = "status"
// The page showed the toast: the loop stops asking for it. Until then every outcome it
// repeats asks for it, so a page that starts after the check (a slow first load, a
// reload) still shows it once.
UPDATE_HINT_TOAST_SHOWN: str = "toast_shown"
// Milestone 53: Download, Relaunch, and the page has shown the outcome.
UPDATE_HINT_DOWNLOAD: str = "download"
UPDATE_HINT_RELAUNCH: str = "relaunch"
UPDATE_HINT_OUTCOME_SHOWN: str = "outcome_shown"
UPDATE_PROGRESS_MS: i64 = 250

type UpdateProgress struct {
    received: i64 `json:"received"`
}

type UpdateHintReq struct {
    reason: str `json:"reason"`
}

type WhatsNewReq struct {
    // At launch: the versions since the last one seen, once. Otherwise this version's.
    launch: bool `json:"launch"`
}

type WhatsNewReply struct {
    current:  str             `json:"current"`
    since:    str             `json:"since"`
    versions: []ChangeVersion `json:"versions"`
}

type OpenUrlReq struct {
    url: str `json:"url"`
}

// The app's own folder: the .app bundle on macOS, the executable's folder elsewhere.
// CFIRE-UPSTREAM: CF-173 (a literal's `.len()` fails in clang)
BUNDLE_EXE_TAIL: str = "/Contents/MacOS"

fn install_root() -> str {
    exe := executable_dir()
    if exe.ends_with(".app" + BUNDLE_EXE_TAIL) {
        return "{exe[0..exe.len() - BUNDLE_EXE_TAIL.len()]}"
    }
    return exe
}

fn install_kind_file() -> str {
    exe := executable_dir()
    if exe.ends_with(".app/Contents/MacOS") {
        return exe + "/../Resources/install-kind"
    }
    return exe + "/install-kind"
}

// The install-kind file as it is (INSTALL_SOURCE when there is none).
fn real_install_kind() -> str {
    return install_kind_of(fs.read_text(install_kind_file()) or "")
}

fn update_here() -> UpdateHere {
    kind := real_install_kind()
    root := install_root()
    writable := folder_writable(root) && folder_writable(fs.dirname(root))
    mut here := UpdateHere{ version: version.FLINT_VERSION, os: os_name(), arch: cpu_arch(), kind: kind, writable: writable }
    // A build from source, under test, may pretend to be a package (FLINT_UPDATE_TEST_KIND).
    test_kind := os.getenv("FLINT_UPDATE_TEST_KIND")
    if test_kind.len() > 0 && update_override_allowed(kind, os.getenv("FLINT_UPDATE_FEED")) {
        here.kind = install_kind_of(test_kind)
        here.writable = true
    }
    return here
}

// The feed and key: always Flint's, except for a build from source checking a local
// feed with a test key (domain's update_override_allowed, D-116).
fn update_source(kind: str) -> UpdateSource {
    key := hex.decode(UPDATE_PUBLIC_KEY_HEX) or []
    feed := os.getenv("FLINT_UPDATE_FEED")
    if feed.len() > 0 && update_override_allowed(kind, feed) {
        test_key := hex.decode(os.getenv("FLINT_UPDATE_TEST_KEY")) or []
        write_stderr("flint-gui: update check against the test feed {feed}\n")
        return UpdateSource{ manifest_url: feed, public_key: test_key }
    }
    if feed.len() > 0 {
        write_stderr("flint-gui: FLINT_UPDATE_FEED ignored: only a build from source checks a local feed\n")
    }
    return UpdateSource{ manifest_url: UPDATE_FEED_URL, public_key: key }
}

fn rpc_update_hint(params: str, st: GuiState) -> str! {
    req := try parse_req[UpdateHintReq](params)
    if req.reason == UPDATE_HINT_NOW || req.reason == UPDATE_HINT_STATUS || req.reason == UPDATE_HINT_TOAST_SHOWN || req.reason == UPDATE_HINT_DOWNLOAD || req.reason == UPDATE_HINT_RELAUNCH || req.reason == UPDATE_HINT_OUTCOME_SHOWN {
        st.update_hints.send(req.reason)
    }
    return ok_json()
}

// CHANGELOG.md: inside the package, or the checkout's for a build from source.
fn find_changelog() -> str {
    exe := executable_dir()
    candidates: []str = [exe + "/../Resources/CHANGELOG.md", exe + "/CHANGELOG.md", exe + "/../../../../../CHANGELOG.md", exe + "/../../CHANGELOG.md", exe + "/../CHANGELOG.md"]
    for path in candidates {
        if fs.exists(path) {
            return fs.read_text(path) or ""
        }
    }
    return ""
}

fn rpc_whats_new(params: str, mut settings: JsonSettingsStore) -> str! {
    req := try parse_req[WhatsNewReq](params)
    changes := find_changelog()
    if req.launch {
        since := (load_settings(settings) or default_settings()).last_seen_version
        return json.stringify(WhatsNewReply{ current: version.FLINT_VERSION, since: since, versions: try whats_new_at_launch(mut settings, changes, version.FLINT_VERSION) })
    }
    return json.stringify(WhatsNewReply{ current: version.FLINT_VERSION, since: "", versions: whats_new_here(changes, version.FLINT_VERSION) })
}

fn rpc_open_url(params: str, e2e: bool) -> str! {
    req := try parse_req[OpenUrlReq](params)
    if !url_open_allowed(req.url) {
        return error(coded(ERR_INVALID, "Flint opens only its own pages in the browser"))
    }
    // The end-to-end run names the page instead of opening a browser on the machine.
    if e2e {
        write_stderr("flint-gui: e2e: would open {req.url}\n")
        return ok_json()
    }
    try open_in_browser(req.url)
    return ok_json()
}

// A check's outcome with what is on disk: the version found already unpacked is Ready;
// a newer one than the unpacked replaces it (the staging folder goes).
fn with_staged(s: UpdateStatus, staged: str, mut files: OsUpdateFiles, root: str) -> (UpdateStatus, str) {
    if staged.len() == 0 {
        return (s, staged)
    }
    mut out := s
    if s.state == UPDATE_AVAILABLE && s.version != staged {
        files.upd_remove(update_paths(root, os_name()).staging) or {}
        return (out, "")
    }
    if s.state == UPDATE_AVAILABLE || s.state == UPDATE_FAILED || s.state == UPDATE_UP_TO_DATE || s.state == UPDATE_IDLE {
        out.state = UPDATE_READY
        out.version = staged
        out.toast = false
    }
    return (out, staged)
}

// The package's bytes so far go to the page whenever they change: a download shorter
// than a tick still reports its last count (100 %) before the check and the unpacking,
// which take seconds.
fn run_update_progress(st: GuiState, mut app: webui.App) {
    mut sent: i64 = -1
    for !st.holder.quitting() {
        time.sleep_ms(UPDATE_PROGRESS_MS)
        got := update_download_received()
        if got != sent {
            app.emit("update:progress", UpdateProgress{ received: got })
            sent = got
        }
    }
}

fn run_update_loop(c: Sodium, settings_store: JsonSettingsStore, st: GuiState, mut app: webui.App) {
    feed := new_http_update_feed()
    mut dl := new_http_update_downloader()
    mut files := new_os_update_files()
    mut procs := new_os_update_processes()
    here := update_here()
    root := install_root()
    // The real kind decides whether a test feed is allowed, never the one a test pretends.
    src := update_source(real_install_kind())
    mut settings := settings_store
    first := load_settings(settings) or default_settings()
    mut last := update_status_idle(here.version, first.update_check, 0)
    // What the last update-apply could not do, said once; a package already unpacked.
    if o := take_apply_outcome(mut files, root, os_name()) {
        last.outcome = apply_outcome_text(o)
        write_stderr("flint-gui: the last update was not applied ({o.step}: {o.message})\n")
    }
    mut staged := ""
    if here.kind == INSTALL_PORTABLE {
        staged = staged_update(mut files, root, os_name(), here.version)
    }
    if staged.len() > 0 {
        last.state = UPDATE_READY
        last.version = staged
        last.action = UPDATE_ACTION_DOWNLOAD
        write_stderr("flint-gui: Flint {staged} is downloaded and ready\n")
    }
    mut said_started := false
    mut next_auto := time.now_ms() + UPDATE_FIRST_CHECK_MS
    // An end-to-end run never checks GitHub on its own: only its own feed, or Check now.
    quiet := os.getenv("FLINT_GUI_E2E").len() > 0 && os.getenv("FLINT_UPDATE_FEED").len() == 0
    write_stderr("flint-gui: updates: {here.kind} on {here.os}-{here.arch}, automatic check {first.update_check}\n")
    for !st.holder.quitting() {
        hint := st.update_hints.recv_timeout(UPDATE_TICK_MS) or ""
        auto := (load_settings(settings) or default_settings()).update_check
        if hint == UPDATE_HINT_TOAST_SHOWN {
            last.toast = false
            continue
        }
        if hint == UPDATE_HINT_OUTCOME_SHOWN {
            last.outcome = ""
            continue
        }
        if hint == UPDATE_HINT_STATUS && !said_started {
            // The page is up: an update-apply waiting for this app hears it started.
            mark_update_started(mut files, root, os_name())
            said_started = true
        }
        if hint == UPDATE_HINT_STATUS || auto != last.auto {
            last.auto = auto
            app.emit("update:status", last)
            continue
        }
        if hint == UPDATE_HINT_DOWNLOAD {
            if last.state != UPDATE_AVAILABLE || last.action != UPDATE_ACTION_DOWNLOAD {
                continue
            }
            mut going := last
            going.state = UPDATE_DOWNLOADING
            going.toast = false
            going.code = ""
            going.message = ""
            going.received = 0
            app.emit("update:status", going)
            write_stderr("flint-gui: downloading Flint {last.version}\n")
            download_update(mut dl, c, mut files, last, root, os_name()) or err {
                msg := "{err.message()}"
                last.code = error_code_of(msg)
                last.message = error_text_of(msg)
                last.toast = false
                write_stderr("flint-gui: the download failed ({last.code}): {last.message}\n")
                app.emit("update:status", last)
                continue
            }
            staged = last.version
            last.state = UPDATE_READY
            last.toast = false
            last.code = ""
            last.message = ""
            last.received = last.asset_size
            write_stderr("flint-gui: Flint {last.version} is downloaded and ready\n")
            app.emit("update:status", last)
            continue
        }
        if hint == UPDATE_HINT_RELAUNCH {
            if last.state != UPDATE_READY {
                continue
            }
            temp := "{temp_base()}/flint-update-{current_pid()}"
            relaunch_update(mut files, mut procs, root, os_name(), here.version, temp, current_pid()) or err {
                msg := "{err.message()}"
                last.code = error_code_of(msg)
                last.message = error_text_of(msg)
                write_stderr("flint-gui: Relaunch failed ({last.code}): {last.message}\n")
                app.emit("update:status", last)
                continue
            }
            write_stderr("flint-gui: relaunching into Flint {last.version} (log: {temp}/update-apply.log)\n")
            quit_app(mut app)
            return
        }
        now := time.now_ms()
        if hint != UPDATE_HINT_NOW && !(auto && !quiet && now >= next_auto) {
            continue
        }
        mut checking := last
        checking.state = UPDATE_CHECKING
        checking.toast = false
        app.emit("update:status", checking)
        pending := last.toast
        outcome := last.outcome
        last = check_for_update(feed, c, mut settings, src, here, time.unix_seconds() * 1000)
        last.outcome = outcome
        // A toast the page has not shown yet stays asked for while the same version waits.
        if pending && last.state == UPDATE_AVAILABLE {
            last.toast = true
        }
        (last, staged) = with_staged(last, staged, mut files, root)
        next_auto = time.now_ms() + UPDATE_CHECK_EVERY_MS
        if last.state == UPDATE_FAILED {
            write_stderr("flint-gui: update check failed ({last.code})\n")
        } else if last.state == UPDATE_AVAILABLE {
            write_stderr("flint-gui: Flint {last.version} is available ({last.action})\n")
        }
        app.emit("update:status", last)
    }
}
