package main

// The `flint` command from a packaged app (milestone 48, D-111 (2)): its state for the
// first launch's toast and About, and linking it on the person's request.

import "core:fs"
import "core:json"
import "core:os"
import "../../adapters/clilink"
import "../../adapters/config"
import "../../adapters/process"
import "../../application"
import "../../domain"

type CliFirstReq struct {
    first: bool `json:"first"`
}

// This copy's CLI: inside its own bundle. FLINT_CLI and FLINT_CLI_HOME stand in for the
// bundle and the home folder in gui-e2e, which runs a build with no CLI inside.
fn self_cli() -> str {
    o := (os.getenv("FLINT_CLI") or "")
    if o.len() > 0 && (os.getenv("FLINT_GUI_E2E") or "").len() > 0 {
        return o
    }
    if process.os_name() == "windows" {
        return domain.windows_cli_dir(process.executable_dir()) + "/flint.exe"
    }
    return domain.bundle_cli_path(process.executable_dir())
}

// Windows (milestone 50, D-121): the package's bin folder, offered for the user's Path.
// FLINT_CLI_PATH_KEY stands in for HKCU\Environment in gui-e2e.
fn cli_bin_dir() -> str {
    return fs.dirname(self_cli())
}

fn cli_path_env() -> clilink.OsCliPath {
    o := (os.getenv("FLINT_CLI_PATH_KEY") or "")
    if o.len() > 0 && (os.getenv("FLINT_GUI_E2E") or "").len() > 0 {
        return clilink.new_os_cli_path(o)
    }
    return clilink.new_os_cli_path(clilink.CLI_PATH_KEY)
}

// FLINT_CLI_SYSTEM_DIR stands in for /usr/local/bin in gui-e2e, so a run never sees the
// machine's own link there (milestone 52: the clilink run failed on a Mac whose
// /usr/local/bin/flint pointed at an installed Flint.app).
fn cli_system_dir() -> str {
    o := (os.getenv("FLINT_CLI_SYSTEM_DIR") or "")
    if o.len() > 0 && (os.getenv("FLINT_GUI_E2E") or "").len() > 0 {
        return o
    }
    return application.CLI_SYSTEM_DIR
}

fn cli_home() -> str {
    o := (os.getenv("FLINT_CLI_HOME") or "")
    if o.len() > 0 && (os.getenv("FLINT_GUI_E2E") or "").len() > 0 {
        return o
    }
    return (os.getenv("HOME") or "")
}

fn rpc_cli_status(params: str, mut store: config.JsonSettingsStore) -> str! {
    req := try parse_req[CliFirstReq](params)
    if process.os_name() == "windows" {
        env := cli_path_env()
        if req.first {
            return json.stringify(try application.cli_path_first_launch(env, mut store, self_cli(), cli_bin_dir()))
        }
        return json.stringify(application.cli_path_status(env, self_cli(), cli_bin_dir(), true))
    }
    links := clilink.new_os_cli_links()
    if req.first {
        return json.stringify(try application.cli_link_first_launch(links, mut store, self_cli(), cli_system_dir(), cli_home()))
    }
    return json.stringify(application.cli_link_status(links, self_cli(), cli_system_dir(), cli_home(), true))
}

fn rpc_cli_install(params: str) -> str! {
    req := try parse_req[PathReq](params)
    if process.os_name() == "windows" {
        mut env := cli_path_env()
        return json.stringify(try application.install_cli_path(mut env, self_cli(), cli_bin_dir(), req.path))
    }
    mut links := clilink.new_os_cli_links()
    return json.stringify(try application.install_cli_link(mut links, self_cli(), cli_system_dir(), cli_home(), req.path))
}

fn rpc_cli_remove(params: str) -> str! {
    req := try parse_req[PathReq](params)
    if process.os_name() == "windows" {
        mut env := cli_path_env()
        return json.stringify(try application.remove_cli_path(mut env, self_cli(), cli_bin_dir(), req.path))
    }
    mut links := clilink.new_os_cli_links()
    return json.stringify(try application.remove_cli_link(mut links, self_cli(), cli_system_dir(), cli_home(), req.path))
}
