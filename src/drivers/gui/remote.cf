package main

// Connect remote vault in the app (milestone 44, design 23*): the page's side of the
// sync the core and the CLI gained in milestone 43. Each handler parses its request,
// calls one use case (application/sync.cf) and formats the result (Principle 2).
//
// The server's token comes in a request and goes to the keychain; it never comes back
// in a reply or an event (Principle 6): the page only learns that one is saved.

import "ext:webui"
import "core:json"
import "core:time"
import "../../adapters/config"
import "../../adapters/crypto" as flint_crypto
import "../../adapters/keychain" as flint_keychain
import "../../adapters/vault"
import "../../adapters/vaultremote"
import "../../application"
import "../../domain"

type RemoteServerReq struct {
    url:   str `json:"url"`
    token: str `json:"token"`
}

type RemoteConnectReq struct {
    url:      str `json:"url"`
    token:    str `json:"token"`
    password: str `json:"password"`
    // Optional; shown in the server's list, in clear (D-103).
    label:    str `json:"label"`
}

type RemoteDownloadReq struct {
    url:      str  `json:"url"`
    token:    str  `json:"token"`
    // The vault chosen from the probe's list.
    vault_id: str  `json:"vault_id"`
    password: str  `json:"password"`
    path:     str  `json:"path"`
    remember: bool `json:"remember"`
}

type RemoteTokenReq struct {
    token: str `json:"token"`
}

type SyncNowReq struct {
    // The master password set on another machine (design 23f); empty for a plain sync.
    new_password: str `json:"new_password"`
}

type RemoteGone struct {
    path: str `json:"path"`
    url:  str `json:"url"`
}

type RemoteLinkList struct {
    links: []application.RemoteLinkView `json:"links"`
}

fn gui_remote_links() -> config.JsonRemoteLinkStore {
    return new_json_remote_link_store(flint_config_dir())
}

fn sync_wall_ms() -> i64 {
    return time.unix_seconds() * 1000
}

// Where the vault at `path` stands with its server: no key and no network, so it
// answers for a locked vault too (the unlock screen's line, design 23g).
fn rpc_vault_remote_status(params: str, c: flint_crypto.Sodium, store: vault.LockedVaultStore) -> str! {
    req := try parse_req[PathReq](params)
    return json.stringify(try remote_status(c, store, gui_remote_links(), req.path))
}

// The vaults connected on this machine, for the cloud mark on recents (design 23d).
fn rpc_vault_remotes() -> str! {
    return json.stringify(RemoteLinkList{ links: try remote_link_views(gui_remote_links()) })
}

// Connect remote vault, step 1 (design 23a1-23a3): the vaults the server keeps.
fn rpc_vault_remote_probe(req: RemoteServerReq, c: flint_crypto.Sodium) -> application.RemoteProbe! {
    defer c.wipe_text(req.token)
    return try probe_remote(new_http_vault_remote(), req.url, req.token)
}

// Connect remote vault, step 2 (design 23a3-23a4): the server's vault downloaded to a
// new file, opened and made the vault in this window, as Create vault does.
fn rpc_vault_remote_download(req: RemoteDownloadReq, c: flint_crypto.Sodium, mut store: vault.LockedVaultStore, kc: flint_keychain.OsKeychain, recents: config.JsonRecentStore, mut st: GuiState) -> application.VaultInfo! {
    defer c.wipe_text(req.token)
    defer c.wipe_text(req.password)
    try st.require_open_window()
    st.hold()
    defer st.release()
    close_current(mut store, mut st)
    s := try download_remote(c, mut store, gui_remote_links(), new_http_vault_remote(), kc, kc, recents, req.url, req.token, req.vault_id, req.password, req.path, req.remember, sync_wall_ms())
    st.holder.set_remembered(s.path, s.cached)
    st.adopt(s)
    return session_info(s)
}

// Settings → Vault → Connect to a server (design 23b2): the open vault goes to the
// server, or is merged with the copy it already holds.
fn rpc_vault_remote_connect(req: RemoteConnectReq, c: flint_crypto.Sodium, mut store: vault.LockedVaultStore, kc: flint_keychain.OsKeychain, st: GuiState, mut app: webui.App) -> application.SyncOutcome! {
    defer c.wipe_text(req.token)
    defer c.wipe_text(req.password)
    try st.require_unlocked()
    st.hold()
    defer st.release()
    mut session := st.vault_session()
    got := try connect_remote(c, mut store, gui_remote_links(), new_http_vault_remote(), kc, kc, mut session, req.url, req.token, req.password, req.label, sync_wall_ms())
    emit_sync_outcome(mut app, session.path, session.name, got)
    return got
}

// Sync now, from the status bar, Settings or the palette; with the master password
// set on another machine when the page asked for it (design 23f).
fn rpc_vault_sync_now(req: SyncNowReq, c: flint_crypto.Sodium, mut store: vault.LockedVaultStore, kc: flint_keychain.OsKeychain, mut st: GuiState, mut app: webui.App) -> application.SyncOutcome! {
    defer c.wipe_text(req.new_password)
    try st.require_unlocked()
    st.hold()
    defer st.release()
    mut session := st.vault_session()
    app.emit("vault:sync", SyncEvent{ path: session.path, state: SYNC_STATE_SYNCING, version: 0, report: empty_merge_report(), code: "", message: "" })
    got := sync_vault(c, mut store, gui_remote_links(), new_http_vault_remote(), kc, kc, mut session, req.new_password, sync_wall_ms()) or err {
        msg := "{err.message()}"
        if error_code_of(msg) == ERR_AUTH {
            tell_sync_loop(st, SYNC_HINT_REFUSED, session.path)
        }
        app.emit("vault:sync", SyncEvent{ path: session.path, state: "error", version: 0, report: empty_merge_report(), code: error_code_of(msg), message: msg })
        return error(msg)
    }
    tell_sync_loop(st, SYNC_HINT_RESUME, session.path)
    if got.rekeyed {
        // The vault now opens with the new master password: the session holds its keys.
        st.adopt(session)
    }
    emit_sync_outcome(mut app, session.path, session.name, got)
    return got
}

// Settings → Vault → Replace token (design 23b4).
fn rpc_vault_remote_token(req: RemoteTokenReq, c: flint_crypto.Sodium, st: GuiState, kc: flint_keychain.OsKeychain) -> RemoteGone! {
    defer c.wipe_text(req.token)
    try st.require_unlocked()
    path := st.vault_session().path
    link := try replace_remote_token(gui_remote_links(), new_http_vault_remote(), kc, path, req.token)
    // A refused vault resumes with the new token, and syncs at once (milestone 71).
    tell_sync_loop(st, SYNC_HINT_TOKEN, path)
    return RemoteGone{ path: path, url: link.url }
}

// Settings → Vault → Disconnect (design 23b3): the vault file and the server's copy stay.
fn rpc_vault_remote_disconnect(c: flint_crypto.Sodium, st: GuiState, kc: flint_keychain.OsKeychain) -> str! {
    try st.require_unlocked()
    path := st.vault_session().path
    gone := try disconnect_remote(gui_remote_links(), kc, path)
    return json.stringify(RemoteGone{ path: path, url: gone.url })
}

// What the page hears after a sync it asked for, as after the loop's own.
fn emit_sync_outcome(mut app: webui.App, path: str, name: str, got: application.SyncOutcome) {
    app.emit("vault:sync", SyncEvent{ path: path, state: got.result, version: got.version, report: got.report, code: "", message: "" })
    r := got.report
    if r.added + r.updated + r.removed > 0 || r.notes.len() > 0 {
        app.emit("vault:changed", VaultChanged{ path: path, name: name })
    }
}
