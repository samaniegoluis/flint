package main

// The tray and the window's own lock (milestone 14, D-038, D-048). Closing the
// window hides it: Flint stays in the menu bar or system tray, the socket keeps
// serving approved grants, and the window is locked until the master password or
// the OS's presence check (Touch ID, polkit) opens it again. The vault's own lock
// (idle, screen lock, sleep, Lock) is unchanged and stronger: it wipes the key.

import "ext:webui"
import "core:json"
import "core:time"
import "core:os"
import "../../adapters/config"
import "../../adapters/crypto"
import "../../adapters/ipc"
import "../../adapters/process"
import "../../adapters/uievents"
import "../../adapters/vault"
import "../../application"
import "../../domain"

TRAY_OPEN: str = "tray:open"
TRAY_LOCK: str = "tray:lock"
TRAY_QUIT: str = "tray:quit"

type WindowLocked struct {
    vault: str `json:"vault"`
}

// The tray icon and its menu. macOS takes a template image the system tints; the
// Linux tray gets a light glyph for its dark panel; Windows, whose taskbar is light or
// dark and tints nothing, the app icon in colour (owner, 2026-11-19).
fn install_tray(mut app: webui.App, ui_dir: str) {
    mut icon := ui_dir + "/tray.png"
    if os_name() == "mac" {
        icon = ui_dir + "/tray-template.png"
    } else if os_name() == "windows" {
        icon = ui_dir + "/tray-color.png"
    }
    app.set_tray(icon, "Flint")
    app.add_tray_item("Open Flint", TRAY_OPEN)
    app.add_tray_item("Lock Vault", TRAY_LOCK)
    app.add_tray_item("-", "")
    app.add_tray_item("Quit Flint", TRAY_QUIT)
    app.set_hide_on_close(true)
}

// The webview is never a browser in a release (milestone 64, Principle 20). A release
// build has no inspector and no engine menu (cfire `v0.12.2`); FLINT_DEVTOOLS=1 brings
// both back to diagnose one. Autofill and password autosave are off in every build.
fn setup_webview(mut app: webui.App) {
    app.set_autofill(false)
    if devtools_requested(os.getenv("FLINT_DEVTOOLS")) {
        app.set_devtools(true)
        app.set_context_menu(true)
        write_stderr("flint-gui: FLINT_DEVTOOLS is set: the web inspector and the browser menu are on\n")
    }
}

// What WebView2 stored from the page's fields before milestone 64 goes, once per
// machine, before the window opens and holds its profile (Windows only).
fn clear_webview_autofill(config_dir: str) {
    mut settings := new_json_settings_store(config_dir)
    mut web := new_os_webview_data()
    n := clear_webview_autofill_once(mut settings, mut web) or err {
        write_stderr("flint-gui: the webview's stored form values were left in place: {err.message()}\n")
        return
    }
    if n > 0 {
        write_stderr("flint-gui: removed {n} files of form values and passwords the webview had stored\n")
    }
}

// Is there a tray showing Flint's icon? The headless runs stand in for a desktop with
// none with FLINT_E2E_NO_TRAY=1 (milestone 65).
fn window_has_tray(e2e: bool) -> bool {
    if e2e {
        return os.getenv("FLINT_E2E_NO_TRAY") != "1"
    }
    return has_system_tray()
}

type E2eTrayReq struct {
    tray: bool `json:"tray"`
}

type CloseAsk struct {
    ask: bool `json:"ask"`
}

// ✕ (milestone 65, D-138 (3)). With a tray, or kept running by the person's answer,
// the window hides locked, as since milestone 14. Answered Quit, Flint quits. With no
// answer yet, the window comes back and the page asks *Keep Flint running in the
// background?*; its answer is saved and `window_close` comes here again. cfire hid the
// window already (`set_hide_on_close`), which is what intercepts ✕ at all.
fn on_window_close(settings_store: JsonSettingsStore, st: GuiState, mut app: webui.App, e2e: bool) {
    tray := window_has_tray(e2e)
    action := window_close_action(settings_store, tray)
    write_stderr("flint-gui: window closed (tray: {tray}): {action}\n")
    if action == CLOSE_QUIT {
        quit_app(mut app)
        return
    }
    if action == CLOSE_ASK {
        if !e2e {
            show_window(mut app)
        }
        app.emit("window:close_ask", CloseAsk{ ask: true })
        return
    }
    if !e2e && !app.is_window_hidden() {
        app.hide_window()
    }
    lock_window(st, mut app)
}

// The window was closed to the tray: lock it if it shows a vault.
fn lock_window(st: GuiState, mut app: webui.App) {
    if !st.unlocked() || st.holder.window_locked() {
        return
    }
    st.holder.set_window_locked(true)
    // A desktop across monitors (milestone 38) leaves nothing on the other screens.
    monitor_windows_close()
    write_stderr("flint-gui: window closed to the tray, locked\n")
    app.emit("window:locked", WindowLocked{ vault: st.vault_session().name })
}

// Shows the window, deminiaturised and in front: the tray, a second launch of Flint,
// or a CLI that needs the person (an unlock, an approval).
fn show_window(mut app: webui.App) {
    app.show_window()
    bring_window_to_front()
}

// Quits Flint: the tray's Quit, ⌘Q, or the palette.
// How long quitting waits for the CLI's running commands before it cuts them.
QUIT_SERVED_GRACE_MS: i64 = 5000

type CliRunning struct {
    count: i64 `json:"count"`
}

fn rpc_cli_running() -> str {
    return json.stringify(CliRunning{ count: ipc_served_count() })
}

fn end_served_commands() {
    deadline := time.now_ms() + QUIT_SERVED_GRACE_MS
    for ipc_served_count() > 0 && time.now_ms() < deadline {
        time.sleep_ms(100)
    }
    n := ipc_served_count()
    if n > 0 {
        write_stderr("flint-gui: quitting: {n} running flint command(s) cut\n")
        ipc_served_shutdown_all()
    }
}

fn quit_app(mut app: webui.App) {
    write_stderr("flint-gui: quit\n")
    app.quit()
}

fn window_state(st: GuiState, presence: OsPresence) -> WindowState {
    if !st.holder.window_locked() || !st.unlocked() {
        return WindowState{ locked: false, vault: "", presence: "", waiting: 0 }
    }
    book := st.holder.access_book()
    waiting := waiting_approvals(book, time.now_ms())
    return WindowState{ locked: true, vault: st.vault_session().name, presence: presence.presence_method(), waiting: i64(waiting.len()) }
}

fn rpc_window_state(st: GuiState, presence: OsPresence) -> str! {
    return json.stringify(window_state(st, presence))
}

// Opens the locked window: the master password, or the presence check when the
// request carries none. Runs on a worker: Touch ID and polkit block until answered.
fn rpc_window_unlock(req: WindowUnlockReq, c: Sodium, store: LockedVaultStore, presence: OsPresence, st: GuiState, mut app: webui.App) -> WindowState! {
    if !st.holder.window_locked() {
        return window_state(st, presence)
    }
    try st.require_unlocked_vault()
    try confirm_window_unlock(c, store, presence, st.vault_session(), req.password)
    st.holder.set_window_locked(false)
    st.holder.touch(time.now_ms())
    write_stderr("flint-gui: window opened\n")
    // The approval window shows the callers that waited behind the lock.
    app.emit("access:changed", GrantsChanged{ count: i64(st.holder.access_book().grants.len()) })
    return window_state(st, presence)
}

fn rpc_app_quit(mut app: webui.App) -> str! {
    quit_app(mut app)
    return ok_json()
}

// Full screen (milestone 37): asks the window to enter or leave it and returns the state
// last heard from the OS. The change itself arrives as `window:fullscreen` once the
// window has moved (macOS animates into its own Space).
fn rpc_window_fullscreen(params: str, e2e: bool) -> str! {
    req := try parse_req[FullscreenReq](params)
    // The headless run's window is hidden and cannot go full screen (CF-111).
    if e2e && !e2e_native_fullscreen() {
        window_fullscreen_inject(req.on)
    } else {
        window_fullscreen_set(req.on)
    }
    return json.stringify(FullscreenState{ on: window_fullscreen_on() })
}
