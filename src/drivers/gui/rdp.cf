package main

// The RDP tab (milestone 30, design 22): each handler parses its request, calls one
// use case (application/rdp.cf) and returns (Principle 2).
//
// `rdp_open` connects on a worker, like an SSH tab: the certificate and password
// prompts travel as "session:prompt" events through the mailbox the page minted
// (the tab's id), "rdp:ready" says the desktop is up and where its frames are, and
// "rdp:state" ends it with the reason. Input, resizes, closing and the clipboard's
// announcement (milestone 31) come back as RPCs.
// A locked window refuses input and closing, as for SSH tabs (D-043); a locked vault
// leaves the session running (D-072).

import "ext:webui"
import "core:json"
import "../../adapters/rdp"
import "../../adapters/uievents"
import "../../adapters/vault"
import "../../application"
import "../../domain"

type RdpOpenReq struct {
    tab:    str `json:"tab"`
    alias:  str `json:"alias"`
    width:  i64 `json:"width"`
    height: i64 `json:"height"`
    // Settings → Remote desktop → Graphics (milestone 34); older pages send none.
    graphics: str `json:"graphics" default:"auto"`
}

type RdpKeyReq struct {
    tab:  str  `json:"tab"`
    code: str  `json:"code"`
    down: bool `json:"down"`
}

type RdpPointerReq struct {
    tab:    str `json:"tab"`
    kind:   str `json:"kind"`
    button: i64 `json:"button"`
    x:      i64 `json:"x"`
    y:      i64 `json:"y"`
    delta:  i64 `json:"delta"`
}

type RdpResizeReq struct {
    tab:    str `json:"tab"`
    width:  i64 `json:"width"`
    height: i64 `json:"height"`
}

type RdpGraphicsReq struct {
    tab:      str `json:"tab"`
    graphics: str `json:"graphics"`
}

type RdpTabReq struct {
    tab: str `json:"tab"`
}

// Milestone 58: this machine's lock keys (RDP_LOCK_* flags) for the remote.
type RdpLocksReq struct {
    tab:   str `json:"tab"`
    flags: i64 `json:"flags"`
}

// The Type menu (design 25c): `what` is "clipboard" or "password" (`alias`'s saved
// password, typed by the core).
type RdpTypeReq struct {
    tab:   str `json:"tab"`
    alias: str `json:"alias"`
    what:  str `json:"what"`
    // The vault's master password, with "password" where the OS has no presence check.
    password: str `json:"password" default:""`
}

// The Type menu's facts (RdpTypeInfo) and how Type password confirms the person
// (the presence method: touchid, device, polkit or password).
type RdpTypeMenu struct {
    clipboard_chars: i64  `json:"clipboard_chars"`
    has_password:    bool `json:"has_password"`
    presence:        str  `json:"presence"`
}

// A Type's outcome: `count` characters typed, or `code` and `message` when it failed.
type RdpTyped struct {
    tab:     str `json:"tab"`
    what:    str `json:"what"`
    count:   i64 `json:"count"`
    code:    str `json:"code"`
    message: str `json:"message"`
}

type RdpState struct {
    tab:     str `json:"tab"`
    state:   str `json:"state"`
    code:    str `json:"code"`
    message: str `json:"message"`
    // The core's message id and params when the core names it (milestone 69).
    id:      str   `json:"id"`
    params:  []str `json:"params"`
}

fn emit_rdp_state(mut app: webui.App, tab: str, state: str, code: str, message: str) {
    m := event_message(code, message)
    app.emit("rdp:state", RdpState{ tab: tab, state: state, code: code, message: message, id: m.id, params: m.params })
}

// Checks a request and opens the tab's mailbox. The caller spawns the worker.
fn rdp_open_check(params: str, st: GuiState) -> RdpOpenReq! {
    try st.require_unlocked()
    // parse_req's own body: a value from `try parse_req[T]` keeps the type `T` and
    // cannot be returned (CFIRE-UPSTREAM: CF-162).
    // CFIRE-UPSTREAM: CF-164 (a labeled argument keeps libstdc++'s chrono::parse out)
    req := json.parse[RdpOpenReq](payload: params) or {
        return error(coded(ERR_INVALID, "malformed request"))
    }
    if req.tab.len() == 0 || req.alias.len() == 0 {
        return error(coded(ERR_INVALID, "a remote desktop needs a tab id and a host alias"))
    }
    if gui_session_count() >= MAX_SESSIONS {
        return error(coded(ERR_CONFLICT, "{MAX_SESSIONS} sessions are open; close one first"))
    }
    if !gui_session_open(req.tab, 0, 0) {
        return error(coded(ERR_CONFLICT, "tab '{req.tab}' already exists"))
    }
    return req
}

// The page's events for the tab, and whether the window is open to act through
// (a locked window answers no clipboard request, milestone 31).
type RdpTabSink struct {
    events: uievents.GuiDesktopSink
    holder: vault.SessionHolder
}

fn (mut self: RdpTabSink) desktop_ready(tab: str, d: domain.RdpDesktop) {
    self.events.desktop_ready(tab, d)
}

fn (self: RdpTabSink) desktop_window_open() -> bool {
    return !self.holder.window_locked()
}

fn (mut self: RdpTabSink) desktop_graphics(tab: str, graphics: str, sw: domain.RdpModeSwitch) {
    self.events.desktop_graphics(tab, graphics, sw)
}

fn (mut self: RdpTabSink) desktop_cursor(tab: str, c: domain.RdpCursor) {
    self.events.desktop_cursor(tab, c)
}

// The connection, on a worker, until the tab ends.
fn run_gui_rdp(mut app: webui.App, c: crypto.Sodium, mut store: vault.LockedVaultStore, vs: application.VaultSession, holder: vault.SessionHolder, board: uievents.OsClipboard, ui_store: config.JsonUiStateStore, req: RdpOpenReq) {
    mut rd := new_freerdp_desktop()
    prompter := new_gui_prompter(app, req.tab)
    mut sink := RdpTabSink{ events: new_gui_desktop_sink(app), holder: holder }
    mut clip := board
    mut ui := ui_store
    open := application.RdpOpenRequest{ tab: req.tab, alias: req.alias, width: req.width, height: req.height, timeout_ms: RDP_CONNECT_TIMEOUT_MS, graphics: req.graphics }
    run_remote_desktop(c, mut store, vs, mut rd, prompter, mut sink, mut clip, mut ui, open) or err {
        msg := "{err.message()}"
        emit_rdp_state(mut app, req.tab, "ended", error_code_of(msg), error_text_of(msg))
        gui_session_drop(req.tab)
        return
    }
    emit_rdp_state(mut app, req.tab, "ended", "", "")
    gui_session_drop(req.tab)
}

fn rpc_rdp_key(params: str, st: GuiState) -> str! {
    try st.require_open_window()
    req := try parse_req[RdpKeyReq](params)
    mut rd := new_freerdp_desktop()
    try send_desktop_key(mut rd, req.tab, req.code, req.down)
    return ok_json()
}

fn rpc_rdp_pointer(params: str, st: GuiState) -> str! {
    try st.require_open_window()
    req := try parse_req[RdpPointerReq](params)
    mut rd := new_freerdp_desktop()
    try send_desktop_pointer(mut rd, req.tab, domain.RdpPointer{ kind: req.kind, button: req.button, x: req.x, y: req.y, delta: req.delta })
    return ok_json()
}

fn rpc_rdp_resize(params: str) -> str! {
    req := try parse_req[RdpResizeReq](params)
    mut rd := new_freerdp_desktop()
    try resize_remote_desktop(mut rd, req.tab, req.width, req.height)
    return ok_json()
}

// Closing also cancels a prompt the tab is waiting on, and a connection in progress.
fn rpc_rdp_close(params: str, st: GuiState) -> str! {
    try st.require_open_window()
    req := try parse_req[RdpTabReq](params)
    mut rd := new_freerdp_desktop()
    close_remote_desktop(mut rd, req.tab)
    _ = gui_session_close(req.tab)
    return ok_json()
}

// The tab in another graphics mode (milestone 35): the session reconnects with the
// password read again from the vault, so the window and the vault must be open; the
// result arrives as "rdp:graphics".
fn rpc_rdp_graphics(params: str, st: GuiState) -> str! {
    try st.require_open_window()
    try st.require_unlocked()
    req := try parse_req[RdpGraphicsReq](params)
    mut rd := new_freerdp_desktop()
    try switch_desktop_graphics(mut rd, req.tab, req.graphics)
    return ok_json()
}

// The tab's counters (milestone 34): the statistics overlay and the benchmark.
fn rpc_rdp_stats(params: str) -> str! {
    req := try parse_req[RdpTabReq](params)
    rd := new_freerdp_desktop()
    return json.stringify(try remote_desktop_stats(rd, req.tab))
}

// The tab took the focus: the server learns whether this machine's clipboard holds
// text (never the text itself, D-074).
fn rpc_rdp_clipboard_announce(params: str, mut clip: uievents.OsClipboard, st: GuiState) -> str! {
    try st.require_open_window()
    req := try parse_req[RdpTabReq](params)
    mut rd := new_freerdp_desktop()
    try announce_desktop_clipboard(mut rd, mut clip, req.tab)
    return ok_json()
}

// The lock keys (milestone 58): sent when the tab connects, takes the focus or sees a
// lock key change.
fn rpc_rdp_locks(params: str, st: GuiState) -> str! {
    try st.require_open_window()
    req := try parse_req[RdpLocksReq](params)
    mut rd := new_freerdp_desktop()
    try sync_desktop_locks(mut rd, req.tab, req.flags)
    return ok_json()
}

// A character from no key of the keyboard (a Stream Deck's Text action): typed as
// Unicode, or by its key where the session's layout has one. A few at most.
type RdpTextReq struct {
    tab:  str `json:"tab"`
    text: str `json:"text"`
}

fn rpc_rdp_text(params: str, st: GuiState) -> str! {
    try st.require_open_window()
    req := try parse_req[RdpTextReq](params)
    if rdp_type_count(req.text) > 8 {
        return error(coded(ERR_INVALID, "a key event carries a character or two, not text"))
    }
    mut rd := new_freerdp_desktop()
    _ = try type_into_desktop(mut rd, req.tab, req.text)
    return ok_json()
}

// What the Type menu shows: the clipboard's character count and whether the host has
// a saved password; neither value itself.
fn rpc_rdp_type_info(params: str, store: vault.LockedVaultStore, mut clip: uievents.OsClipboard, presence: uievents.OsPresence, st: GuiState) -> str! {
    try st.require_open_window()
    try st.require_unlocked()
    req := try parse_req[RdpTypeReq](params)
    i := try desktop_type_info(store, mut clip, req.alias)
    return json.stringify(RdpTypeMenu{ clipboard_chars: i.clipboard_chars, has_password: i.has_password, presence: presence.presence_method() })
}

// Checks a Type request; the caller types it on a worker (it takes a second or more).
fn rdp_type_check(params: str, st: GuiState) -> RdpTypeReq! {
    try st.require_open_window()
    // parse_req's own body (CFIRE-UPSTREAM: CF-162, CF-164), as rdp_open_check.
    req := json.parse[RdpTypeReq](payload: params) or {
        return error(coded(ERR_INVALID, "malformed request"))
    }
    if req.tab.len() == 0 {
        return error(coded(ERR_INVALID, "Type needs a tab"))
    }
    if req.what == "password" {
        try st.require_unlocked()
        if req.alias.len() == 0 {
            return error(coded(ERR_INVALID, "Type password needs the host"))
        }
    } else if req.what != "clipboard" {
        return error(coded(ERR_INVALID, "Type takes the clipboard or the host's password"))
    }
    return req
}

// Types, then tells the page how many characters went ("rdp:typed").
// Type password waits here for the person's presence check (Touch ID, polkit): a worker.
fn run_gui_rdp_type(mut app: webui.App, c: crypto.Sodium, store: vault.LockedVaultStore, vs: application.VaultSession, board: uievents.OsClipboard, presence: uievents.OsPresence, req: RdpTypeReq) {
    mut rd := new_freerdp_desktop()
    mut clip := board
    mut out := RdpTyped{ tab: req.tab, what: req.what, count: 0, code: "", message: "" }
    if req.what == "password" {
        out.count = type_host_password_into_desktop(c, store, vs, mut rd, presence, req.password, req.tab, req.alias) or err {
            msg := "{err.message()}"
            out.code = error_code_of(msg)
            out.message = error_text_of(msg)
            app.emit("rdp:typed", out)
            return
        }
    } else {
        out.count = type_clipboard_into_desktop(mut rd, mut clip, req.tab) or err {
            msg := "{err.message()}"
            out.code = error_code_of(msg)
            out.message = error_text_of(msg)
            app.emit("rdp:typed", out)
            return
        }
    }
    app.emit("rdp:typed", out)
}
