package main

// The app's socket server (D-038, D-042): it lets the `flint` CLI use the vault
// unlocked in this window instead of opening the file itself, and ask this window to
// unlock or lock it. adapters/ipc owns the socket (mode 0600, a peer of another uid
// is closed unread, Principle 11); clicmd owns the protocol and runs the command
// (serve.cf there). This file wires them to the app's state: whether this vault is
// the one held, holding it still while a command runs, and locking it.

import "core:encoding/hex"
import "core:fs"
import "core:os"
import "core:time"
import "ext:webui"
import "../../adapters/config"
import "../../adapters/crypto"
import "../../adapters/ipc"
import "../../adapters/keychain"
import "../../adapters/process"
import "../../adapters/uievents"
import "../../adapters/vault"
import "../../application"
import "../../domain"
import "../clicmd"

// How often an accept loop looks at its stop flag.
SERVE_ACCEPT_WAIT_MS: i32 = 250
// Accept loops on the one listener: that many clients at once, a `connect` holding
// one for as long as it lasts (CF-083).
SERVE_ACCEPTORS: i64 = 8
// How often a request waiting for approval looks for the owner's answer, and how
// often it tells a session's client it is still waiting.
APPROVAL_POLL_MS: i64 = 200
APPROVAL_NOTICE_MS: i64 = 15000
// How often the lock timer looks at the idle time and the OS's lock and sleep events.
LOCK_TICK_MS: i64 = 1000

type VaultChanged struct {
    path: str `json:"path"`
    name: str `json:"name"`
}

// The vault locked: `reason` is "manual", "idle", "screen", "sleep" or "cli".
type VaultLocked struct {
    path:   str `json:"path"`
    name:   str `json:"name"`
    reason: str `json:"reason"`
}

// A CLI asked this window to unlock `path`; `caller` is the command.
type UnlockRequest struct {
    path:   str `json:"path"`
    name:   str `json:"name"`
    caller: str `json:"caller"`
}

// An approval left the window: answered, timed out, or its caller went away.
type ApprovalResolved struct {
    id:    str `json:"id"`
    state: str `json:"state"`
}

// Listens on the config folder's socket. With another Flint already serving it, or
// a socket that cannot be made, the app runs without serving: the CLI then asks for
// the master password. Returns a listener with `open` false in that case.
fn start_serving(config_dir: str) -> IpcListener {
    path := ipc_socket_path(config_dir)
    // On a first launch nothing has written to the config folder yet.
    fs.mkdir_all(config_dir) or err {
        write_stderr("flint-gui: not serving the CLI: cannot create {config_dir}\n")
        return IpcListener{ fd: 0, open: false, path: path, allowed_uid: -1 }
    }
    l := ipc_listen(path) or err {
        write_stderr("flint-gui: not serving the CLI: {err.message()}\n")
        return IpcListener{ fd: 0, open: false, path: path, allowed_uid: -1 }
    }
    return l
}

// Locks the vault this window holds: the key is overwritten, the store closed, and
// the vault opens again only with its master password in this run (never from the
// keychain). Open sessions keep running: they hold no key (D-042). The page shows
// its lock screen on "vault:locked". Returns whether a vault was unlocked.
fn lock_now(mut store: LockedVaultStore, st: GuiState, mut app: webui.App, reason: str) -> bool {
    st.hold()
    if !st.unlocked() {
        st.release()
        return false
    }
    s := st.vault_session()
    st.holder.mark_relocked(s.path)
    st.forget()
    close_vault(mut store)
    st.release()
    write_stderr("flint-gui: vault locked ({reason})\n")
    app.emit("vault:locked", VaultLocked{ path: s.path, name: s.name, reason: reason })
    return true
}

// The lock timer: once a second, the OS's screen lock and sleep events, then the
// idle time against the setting. Ends when the window closes.
fn run_lock_timer(mut store: LockedVaultStore, st: GuiState, mut app: webui.App) {
    for !st.holder.quitting() {
        time.sleep_ms(LOCK_TICK_MS)
        event := system_events_take()
        if event.len() > 0 {
            _ := lock_now(mut store, st, mut app, event)
        } else if st.unlocked() && idle_lock_due(time.now_ms(), st.holder.last_activity(), st.holder.lock_after()) {
            _ := lock_now(mut store, st, mut app, "idle")
        }
    }
}

// One accept loop. Several run on the same listener (SERVE_ACCEPTORS).
fn run_accept_loop(listener: IpcListener, c: Sodium, mut store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore, st: GuiState, mut app: webui.App) {
    for !listener.stopped() {
        got := listener.accept_wait(SERVE_ACCEPT_WAIT_MS)
        if !got.has_value() {
            break
        }
        conn := got.value()
        if conn.open {
            mut cn := conn
            serve_client(mut cn, c, mut store, kc, recents, st, mut app)
        }
    }
}

// Where the app stands for `path`: unlocked here, being asked for, another vault
// unlocked, or locked.
fn app_state_for(st: GuiState, path: str) -> AppState {
    if st.unlocked() {
        s := st.vault_session()
        if s.path == path {
            return AppState{ state: APP_UNLOCKED, name: s.name }
        }
        return AppState{ state: APP_OTHER, name: s.name }
    }
    (asked, caller) := st.holder.ask()
    if asked == path {
        return AppState{ state: APP_ASKING, name: "" }
    }
    return AppState{ state: APP_LOCKED, name: "" }
}

// Answers one client's request.
fn serve_client(mut conn: IpcConn, c: Sodium, mut store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore, st: GuiState, mut app: webui.App) {
    defer conn.close()
    text := conn.recv(SERVE_SEND_MS) or {
        return
    }
    req := parse_serve_request(text) or {
        return
    }
    // A command from the CLI is someone using the vault.
    st.holder.touch(time.now_ms())
    if req.kind == "run" {
        serve_run(mut conn, req, c, mut store, kc, recents, st, mut app)
    } else if req.kind == "session" {
        serve_session(mut conn, req, c, mut store, kc, recents, st, mut app)
    } else if req.kind == "status" {
        now := app_state_for(st, req.vault)
        _ := conn.send(app_state_json(now.state, now.name), SERVE_SEND_MS) or {}
    } else if req.kind == "unlock" {
        now := app_state_for(st, req.vault)
        if now.state == APP_LOCKED || now.state == APP_ASKING {
            name := recent_name(recents, req.vault)
            st.holder.set_ask(req.vault, req.caller)
            app.emit("vault:unlock-request", UnlockRequest{ path: req.vault, name: name, caller: req.caller })
            bring_window_to_front()
            _ := conn.send(app_state_json(APP_ASKING, ""), SERVE_SEND_MS) or {}
        } else {
            _ := conn.send(app_state_json(now.state, now.name), SERVE_SEND_MS) or {}
        }
    } else if req.kind == "lock" {
        now := app_state_for(st, req.vault)
        mut locked := false
        if now.state == APP_UNLOCKED {
            locked = lock_now(mut store, st, mut app, "cli")
        }
        mut answer := APP_LOCKED
        if locked {
            answer = APP_UNLOCKED
        }
        _ := conn.send(app_state_json(answer, ""), SERVE_SEND_MS) or {}
    }
}

// The name the recent list gives `path`, or the file's name.
fn recent_name(recents: JsonRecentStore, path: str) -> str {
    list := list_recents(recents) or []
    for r in list {
        if r.path == path {
            return r.name
        }
    }
    return vault_name_from_path(path)
}

// ---- Caller approval (milestone 12, Principle 12) -----------------------------------

// The check every run and session request passes before its command runs: a live
// grant of this caller's anchor that covers what the command needs, or the owner's
// answer in the window. Returns "" to go ahead, an error message to refuse with, or
// "gone" when the client left while waiting (nothing to answer then).
//
// The vault is held only to read it; the wait for the owner holds nothing, so the
// window, the lock timer and other clients carry on meanwhile. A lock while waiting
// ends the approval (the book is cleared) and refuses with `locked`.
fn gate(conn: IpcConn, req: ServeRequest, c: Sodium, store: LockedVaultStore, st: GuiState, mut app: webui.App, session_kind: bool) -> str {
    parsed := parse_cli_args(req.argv) or {
        return ""
    }
    need := access_need(parsed)
    caller := ipc_caller(conn.peer)
    st.hold()
    session := st.vault_session()
    if !st.unlocked() || session.path != req.vault {
        st.release()
        return coded(ERR_LOCKED, "the vault locked before the command ran")
    }
    cat := load_catalog(store) or Catalog{ groups: [], hosts: [], keys: [], creds: [] }
    st.release()
    now := time.now_ms()
    if find_grant(st.holder.access_book().grants, caller, session.id, need, cat, now).has_value() {
        return ""
    }
    id := hex.encode(c.random_bytes(8))
    mut ap := new_approval(id, session.id, caller, req.caller, need, now)
    ap.deadline_ms = now + approval_wait_ms()
    st.holder.access_hold()
    mut book := st.holder.access_book()
    book.pending.push(ap)
    st.holder.put_access_book(book)
    st.holder.access_release()
    write_stderr("flint-gui: asking the owner to approve {ap.label}\n")
    app.emit("access:request", ap)
    bring_window_to_front()
    notice := "Waiting for approval in Flint ({ap.label})…"
    send_wait(conn, notice, session_kind)
    mut last_notice := now
    for true {
        time.sleep_ms(APPROVAL_POLL_MS)
        t := time.now_ms()
        cur := find_approval(st.holder.access_book(), id) or {
            app.emit("access:resolved", ApprovalResolved{ id: id, state: APPROVAL_DENIED })
            return coded(ERR_LOCKED, "the vault locked while Flint was asking for approval")
        }
        state := cur.state
        if state != APPROVAL_PENDING {
            forget_approval(st, id)
            app.emit("access:resolved", ApprovalResolved{ id: id, state: state })
            if state == APPROVAL_DENIED {
                return coded(ERR_DENIED, "the owner denied this request in Flint")
            }
            if find_grant(st.holder.access_book().grants, caller, session.id, need, cat, t).has_value() {
                return ""
            }
            return coded(ERR_DENIED, "the access allowed in Flint does not cover this request")
        }
        if t >= ap.deadline_ms {
            forget_approval(st, id)
            app.emit("access:resolved", ApprovalResolved{ id: id, state: "expired" })
            return coded(ERR_APPROVAL_TIMEOUT, "nobody answered in Flint within {approval_wait_ms() / 1000}s; run the command again and allow it there")
        }
        // A client that hung up is not waiting any more. Before a session's raw mode
        // the client sends nothing, so anything readable is its close.
        if conn.readable(0) {
            forget_approval(st, id)
            app.emit("access:resolved", ApprovalResolved{ id: id, state: "gone" })
            return "gone"
        }
        if session_kind && t - last_notice >= APPROVAL_NOTICE_MS {
            send_wait(conn, notice, session_kind)
            last_notice = t
        }
    }
    return ""
}

// How long a caller waits for the owner. The headless end-to-end run (and only it)
// may shorten it with FLINT_APPROVAL_WAIT_MS, to check a timeout in seconds.
fn approval_wait_ms() -> i64 {
    if os.getenv("FLINT_GUI_E2E").len() > 0 {
        ms := os.getenv("FLINT_APPROVAL_WAIT_MS").parse_i64() or APPROVAL_WAIT_MS
        if ms > 0 && ms < APPROVAL_WAIT_MS {
            return ms
        }
    }
    return APPROVAL_WAIT_MS
}

fn send_wait(conn: IpcConn, notice: str, session_kind: bool) {
    if session_kind {
        _ := conn.send(relay_frame(TAG_WAIT, notice), SERVE_SEND_MS) or {}
    } else {
        _ := conn.send(wait_notice_json(notice), SERVE_SEND_MS) or {}
    }
}

fn forget_approval(st: GuiState, id: str) {
    st.holder.access_hold()
    mut book := st.holder.access_book()
    drop_approval(mut book, id)
    st.holder.put_access_book(book)
    st.holder.access_release()
}

// Whether this app runs a client's one-exchange request: its vault is the one held
// unlocked, and the command is one it serves. Otherwise the client runs it itself.
fn run_servable_here(req: ServeRequest, st: GuiState) -> bool {
    st.hold()
    defer st.release()
    return st.unlocked() && st.vault_session().path == req.vault && run_request_servable(req)
}

fn serve_run(mut conn: IpcConn, req: ServeRequest, c: Sodium, mut store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore, st: GuiState, mut app: webui.App) {
    if !run_servable_here(req, st) {
        _ := conn.send(json_not_served(), SERVE_SEND_MS) or {}
        return
    }
    refusal := gate(conn, req, c, store, st, mut app, false)
    if refusal == "gone" {
        return
    }
    if refusal.len() > 0 {
        _ := conn.send(serve_reply_json(refused_reply(refusal, req)), SERVE_SEND_MS) or {}
        return
    }
    st.hold()
    defer st.release()
    session := st.vault_session()
    if !st.unlocked() || session.path != req.vault {
        _ := conn.send(serve_reply_json(refused_reply(coded(ERR_LOCKED, "the vault locked before the command ran"), req)), SERVE_SEND_MS) or {}
        return
    }
    reply := run_served(req, c, mut store, kc, recents, session)
    if reply.served {
        // `vault rename` changes the name inside the file: keep the window's in step.
        name := store.vault_get_meta("name") or session.name
        if name.len() > 0 && name != session.name {
            mut renamed := session
            renamed.name = name
            st.adopt(renamed)
        }
        if served_changes_vault(req) {
            app.emit("vault:changed", VaultChanged{ path: session.path, name: st.vault_session().name })
        }
    }
    _ := conn.send(serve_reply_json(reply), SERVE_SEND_MS) or {}
}

// `connect`, `exec` and `host test`: the vault is checked and copied under the hold,
// then the session runs without it, as a window tab does.
fn serve_session(mut conn: IpcConn, req: ServeRequest, c: Sodium, mut store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore, st: GuiState, mut app: webui.App) {
    st.hold()
    ok := st.unlocked() && st.vault_session().path == req.vault && session_servable(req)
    st.release()
    if !ok {
        _ := conn.send(session_not_served_frame(), SERVE_SEND_MS) or {}
        return
    }
    refusal := gate(conn, req, c, store, st, mut app, true)
    if refusal == "gone" {
        return
    }
    if refusal.len() > 0 {
        _ := conn.send(refused_session_frame(refusal, req), SERVE_SEND_MS) or {}
        return
    }
    st.hold()
    session := st.vault_session()
    still := st.unlocked() && session.path == req.vault
    st.release()
    if !still {
        _ := conn.send(refused_session_frame(coded(ERR_LOCKED, "the vault locked before the command ran"), req), SERVE_SEND_MS) or {}
        return
    }
    run_served_session(conn, req, c, mut store, kc, recents, session)
}
