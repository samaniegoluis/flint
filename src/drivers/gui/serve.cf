package main

// The app's socket server (D-038, D-042): it lets the `flint` CLI use the vault
// unlocked in this window instead of opening the file itself, and ask this window to
// unlock or lock it. adapters/ipc owns the socket (mode 0600, a peer of another uid
// is closed unread, Principle 11); clicmd owns the protocol and runs the command
// (serve.cf there). This file wires them to the app's state: whether this vault is
// the one held, holding it still while a command runs, and locking it.

import "core:encoding/hex"
import "core:fs"
import "core:os"
import "core:str"
import "core:time"
import "ext:webui"
import "../../adapters/config"
import "../../adapters/crypto"
import "../../adapters/ipc"
import "../../adapters/keychain"
import "../../adapters/process"
import "../../adapters/uievents"
import "../../adapters/vault"
import "../../application"
import "../../domain"
import "../clicmd"

// How often an accept loop looks at its stop flag.
SERVE_ACCEPT_WAIT_MS: i32 = 250
// Accept loops on the one listener: that many clients at once, a `connect` holding
// one for as long as it lasts (CF-083).
SERVE_ACCEPTORS: i64 = 8
// How often a request waiting for approval looks for the owner's answer, and how
// often it tells a session's client it is still waiting.
APPROVAL_POLL_MS: i64 = 200
APPROVAL_NOTICE_MS: i64 = 15000
// How often the lock timer looks at the idle time and the OS's lock and sleep events.
LOCK_TICK_MS: i64 = 1000

type VaultChanged struct {
    path: str `json:"path"`
    name: str `json:"name"`
}

// The vault locked: `reason` is "manual", "idle", "screen", "sleep" or "cli".
type VaultLocked struct {
    path:   str `json:"path"`
    name:   str `json:"name"`
    reason: str `json:"reason"`
}

// A CLI asked this window to unlock `path`; `caller` is the command, `label` who
// runs it ("flint, started by Claude Code"), which the unlock screen can allow.
type UnlockRequest struct {
    path:   str `json:"path"`
    name:   str `json:"name"`
    caller: str `json:"caller"`
    label:  str `json:"label"`
    // The whole command `caller` sums up (milestone 15).
    command: CommandText `json:"command"`
}

// An approval left the window: answered, timed out, or its caller went away.
type ApprovalResolved struct {
    id:    str `json:"id"`
    state: str `json:"state"`
}

// Listens on the config folder's socket. With another Flint already serving it, or
// a socket that cannot be made, the app runs without serving: the CLI then asks for
// the master password. Returns a listener with `open` false in that case.
fn start_serving(config_dir: str) -> IpcListener {
    path := ipc_socket_path(config_dir)
    // On a first launch nothing has written to the config folder yet.
    fs.mkdir_all(config_dir) or err {
        write_stderr("flint-gui: not serving the CLI: cannot create {config_dir}\n")
        return IpcListener{ fd: 0, open: false, path: path, allowed_uid: -1 }
    }
    l := ipc_listen(path) or err {
        write_stderr("flint-gui: not serving the CLI: {err.message()}\n")
        return IpcListener{ fd: 0, open: false, path: path, allowed_uid: -1 }
    }
    return l
}

// Locks the vault this window holds: the key is overwritten, the store closed, and
// the vault opens again only with its master password in this run (never from the
// keychain). Open sessions keep running: they hold no key (D-042). The page shows
// its lock screen on "vault:locked". Returns whether a vault was unlocked.
fn lock_now(mut store: LockedVaultStore, st: GuiState, mut app: webui.App, reason: str) -> bool {
    st.hold()
    if !st.unlocked() {
        st.release()
        return false
    }
    s := st.vault_session()
    st.holder.mark_relocked(s.path)
    // The vault's lock screen replaces the window's.
    st.holder.set_window_locked(false)
    st.forget()
    close_vault(mut store)
    st.release()
    write_stderr("flint-gui: vault locked ({reason})\n")
    app.emit("vault:locked", VaultLocked{ path: s.path, name: s.name, reason: reason })
    return true
}

// The lock timer: once a second, the OS's screen lock and sleep events, then the
// idle time against the setting. Ends when the window closes.
fn run_lock_timer(mut store: LockedVaultStore, st: GuiState, mut app: webui.App) {
    for !st.holder.quitting() {
        time.sleep_ms(LOCK_TICK_MS)
        event := system_events_take()
        if event.len() > 0 {
            _ := lock_now(mut store, st, mut app, event)
        } else if st.unlocked() && idle_lock_due(time.now_ms(), st.holder.last_activity(), st.holder.lock_after()) {
            _ := lock_now(mut store, st, mut app, "idle")
        }
    }
}

// One accept loop. Several run on the same listener (SERVE_ACCEPTORS).
fn run_accept_loop(listener: IpcListener, c: Sodium, mut store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore, st: GuiState, mut app: webui.App) {
    for !listener.stopped() {
        got := listener.accept_wait(SERVE_ACCEPT_WAIT_MS) or err {
            break
        }
        conn := got
        if conn.open {
            mut cn := conn
            serve_client(mut cn, c, mut store, kc, recents, st, mut app)
        }
    }
}

// Where the app stands for `path`: unlocked here, being asked for, another vault
// unlocked, or locked.
fn app_state_for(st: GuiState, path: str) -> AppState {
    if st.unlocked() {
        s := st.vault_session()
        if s.path == path {
            return AppState{ state: APP_UNLOCKED, name: s.name }
        }
        return AppState{ state: APP_OTHER, name: s.name }
    }
    (asked, caller) := st.holder.ask()
    if asked == path {
        return AppState{ state: APP_ASKING, name: "" }
    }
    return AppState{ state: APP_LOCKED, name: "" }
}

// Answers one client's request.
fn serve_client(mut conn: IpcConn, c: Sodium, mut store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore, st: GuiState, mut app: webui.App) {
    defer conn.close()
    text := conn.recv(SERVE_SEND_MS) or {
        return
    }
    req := parse_serve_request(text) or {
        return
    }
    // A command from the CLI is someone using the vault.
    st.holder.touch(time.now_ms())
    if req.kind == "run" {
        serve_run(mut conn, req, c, mut store, kc, recents, st, mut app)
    } else if req.kind == "session" {
        serve_session(mut conn, req, c, mut store, kc, recents, st, mut app)
    } else if req.kind == "status" {
        now := app_state_for(st, req.vault)
        _ := conn.send(app_state_json(now.state, now.name), SERVE_SEND_MS) or {}
    } else if req.kind == "unlock" {
        now := app_state_for(st, req.vault)
        if now.state == APP_LOCKED || now.state == APP_ASKING {
            name := recent_name(recents, req.vault)
            st.holder.set_ask(req.vault, req.caller)
            // Who asks, kept until the unlock: the unlock screen may allow it at once.
            caller := ipc_caller(conn.peer)
            mut ap := new_approval(hex.encode(c.random_bytes(8)), "", caller, req.caller, req.need, time.now_ms())
            if req.command.len() > 0 {
                ap.command = whole_command(req.command)
            }
            st.holder.access_hold()
            mut book := st.holder.access_book()
            book.asking = [ap]
            st.holder.put_access_book(book)
            st.holder.access_release()
            app.emit("vault:unlock-request", UnlockRequest{ path: req.vault, name: name, caller: req.caller, label: ap.label, command: ap.command })
            show_window(mut app)
            _ := conn.send(app_state_json(APP_ASKING, ""), SERVE_SEND_MS) or {}
        } else {
            _ := conn.send(app_state_json(now.state, now.name), SERVE_SEND_MS) or {}
        }
    } else if req.kind == "show" {
        // A second launch of Flint (milestone 14): this one shows its window, locked
        // if it was closed to the tray, and the new one exits. Nothing of the vault
        // travels, so no grant is checked (as for status, unlock and lock).
        show_window(mut app)
        _ := conn.send(app_state_json(app_state_for(st, req.vault).state, ""), SERVE_SEND_MS) or {}
    } else if req.kind == "lock" {
        now := app_state_for(st, req.vault)
        mut locked := false
        if now.state == APP_UNLOCKED {
            locked = lock_now(mut store, st, mut app, "cli")
        }
        mut answer := APP_LOCKED
        if locked {
            answer = APP_UNLOCKED
        }
        _ := conn.send(app_state_json(answer, ""), SERVE_SEND_MS) or {}
    }
}

// The name the recent list gives `path`, or the file's name.
fn recent_name(recents: JsonRecentStore, path: str) -> str {
    list := list_recents(recents) or []
    for r in list {
        if r.path == path {
            return r.name
        }
    }
    return vault_name_from_path(path)
}

// ---- Caller approval (milestone 12, Principle 12) -----------------------------------

// The check every run and session request passes before its command runs.
//
// - With FLINT_TOKEN (milestone 12b), the token alone decides: live, its secret's
//   hash matching, and its scope covering the request; otherwise `denied` at once,
//   with no window (a program with a token has nobody to ask).
// - `token create` is asked in the window every time, one by one, with presence: no
//   grant and no token covers it, so an agent cannot mint a token that outlives its
//   grant. So is `exec --sudo` (milestone 13, D-039): the window shows the host, the
//   login user and the exact argv, and may take a sudo password for it.
// - Anything else: a live grant of this caller's anchor that covers what the command
//   needs, or the owner's answer in the window.
//
// Returns `refusal` "" to go ahead, an error message to refuse with, or "gone" when
// the client left while waiting (nothing to answer then); and, for an allowed `exec
// --sudo`, the sudo password the owner typed in the window ("" for none). The activity log gets every refusal
// and every allowed request but a read (D-046: an allowed read would rewrite a synced
// vault on every `host list`; a refusal is rare and worth seeing).
//
// The vault is held only to read it; the wait for the owner holds nothing, so the
// window, the lock timer and other clients carry on meanwhile. A lock while waiting
// ends the approval (the book is cleared) and refuses with `locked`.
type GateOutcome struct {
    refusal:    str
    sudo_typed: str
}

// Names in the log entry the token `secret` still matches, when it is revoked or
// expired.
fn name_known_token(c: Sodium, tokens: []Token, secret: str, mut entry: ActivityEntry) {
    known := match_token(c, tokens, secret) or {
        return
    }
    entry.token = known.id
    entry.caller = "{entry.caller} (token {known.name})"
}

// What the approval window shows for a `cp` request: for a copy between two hosts,
// which of them the caller's own grants already reach (design 16g3).
fn copy_ask_for(parsed: ParsedArgs, st: GuiState, caller: Caller, vault_id: str, cat: Catalog, now: i64, cwd: str) -> CopyAsk! {
    r := try copy_request_from_args(parsed)
    if r.direction == COPY_RELAY {
        grants := st.holder.access_book().grants
        (from_ok, from_until) := exec_allowed_until(grants, caller, vault_id, r.alias, cat, now)
        (to_ok, to_until) := exec_allowed_until(grants, caller, vault_id, r.to_alias, cat, now)
        return CopyAsk{ direction: r.direction, host: r.alias, local: "", remote: r.remote, to_host: r.to_alias, to_path: r.local, recursive: r.recursive, force: r.force, host_allowed: from_ok, host_allowed_until: from_until, to_allowed: to_ok, to_allowed_until: to_until }
    }
    return CopyAsk{ direction: r.direction, host: r.alias, local: absolute_from(cwd, r.local), remote: r.remote, recursive: r.recursive, force: r.force, host_allowed: false, host_allowed_until: 0, to_allowed: false, to_allowed_until: 0 }
}

fn refuse(msg: str) -> GateOutcome {
    return GateOutcome{ refusal: msg, sudo_typed: "" }
}

fn gate(conn: IpcConn, req: ServeRequest, c: Sodium, store: LockedVaultStore, st: GuiState, mut app: webui.App, session_kind: bool) -> GateOutcome {
    parsed := parse_cli_args(req.argv) or {
        return refuse("")
    }
    need := access_need(parsed)
    caller := ipc_caller(conn.peer)
    mut ask := no_token_ask()
    mut sudo := no_sudo_ask()
    if need.action == ACCESS_TOKEN && req.token.len() == 0 {
        // A request the command would refuse never reaches the owner.
        treq := token_request_from_flags(parsed) or err {
            return refuse("{err.message()}")
        }
        ask = TokenAsk{ name: str.trim(treq.name), allows: token_allows_text(treq.read, treq.exec, treq.write), reaches: token_reach_text(treq.scope.all, treq.scope.groups, treq.scope.hosts), ttl: treq.ttl }
        st.hold()
        check_token_request(store, treq) or err {
            st.release()
            return refuse("{err.message()}")
        }
        st.release()
        if ask.reaches.len() == 0 {
            ask.reaches = "whole vault"
        }
    }
    if need.action == ACCESS_SUDO && req.token.len() == 0 {
        // Checked before the window: an unknown host or no command never reaches it.
        st.hold()
        sudo = sudo_ask_for(store, need.host, parsed.rest) or err {
            st.release()
            return refuse("{err.message()}")
        }
        st.release()
    }
    mut tunnel := no_tunnel_ask()
    if parsed.positional(0) == "tunnel" && need.action == ACCESS_EXEC && req.token.len() == 0 {
        // Checked before the window: an unknown host or tunnel never reaches it.
        (alias, tname) := split_tunnel_ref(parsed.positional(2)) or err {
            return refuse("{err.message()}")
        }
        st.hold()
        tunnel = tunnel_ask(store, store, parsed.positional(1), alias, tname) or err {
            st.release()
            return refuse("{err.message()}")
        }
        st.release()
    }
    st.hold()
    session := st.vault_session()
    if !st.unlocked() || session.path != req.vault {
        st.release()
        return refuse(coded(ERR_LOCKED, "the vault locked before the command ran"))
    }
    cat := load_catalog(store) or Catalog{ groups: [], hosts: [], keys: [], creds: [] }
    mut tokens: []Token = []
    if req.token.len() > 0 {
        tokens = store.tokens_all() or []
    }
    st.release()
    now := time.now_ms()
    logged := whole_command(activity_command(parsed, ask, sudo))
    mut entry := ActivityEntry{ id: 0, at: time.unix_seconds(), caller: caller_label(caller), via: ACTIVITY_VIA_GRANT, token: "", action: need.action, host: need_hosts(need), command: logged.text, outcome: ACTIVITY_ALLOWED, cut: logged.cut }

    if req.token.len() > 0 {
        entry.via = ACTIVITY_VIA_TOKEN
        if need.action == ACCESS_TOKEN {
            entry.outcome = ACTIVITY_DENIED
            log_activity(st, store, session, entry, mut app)
            return refuse(coded(ERR_DENIED, "a token cannot create tokens: run `flint token create` from your terminal, without FLINT_TOKEN, and approve it in Flint"))
        }
        if need.action == ACCESS_SUDO {
            entry.outcome = ACTIVITY_DENIED
            log_activity(st, store, session, entry, mut app)
            return refuse(coded(ERR_DENIED, "a token cannot run commands as root: `exec --sudo` is approved one by one in Flint's window"))
        }
        t := check_token_in(c, tokens, req.token, time.unix_seconds()) or err {
            entry.outcome = ACTIVITY_DENIED
            // A revoked or expired token is still named in the log.
            name_known_token(c, tokens, req.token, mut entry)
            log_activity(st, store, session, entry, mut app)
            return refuse("{err.message()}")
        }
        entry.token = t.id
        entry.caller = "{entry.caller} (token {t.name})"
        if !token_covers(t, session.id, need, cat, time.unix_seconds()) {
            entry.outcome = ACTIVITY_DENIED
            log_activity(st, store, session, entry, mut app)
            return refuse(coded(ERR_DENIED, "the token '{t.name}' does not allow this; see `flint token list`"))
        }
        if activity_logged(need) {
            log_activity(st, store, session, entry, mut app)
        }
        return refuse("")
    }

    if !asked_every_time(need) && find_grant(st.holder.access_book().grants, caller, session.id, need, cat, now).has_value() {
        if activity_logged(need) {
            log_activity(st, store, session, entry, mut app)
        }
        return refuse("")
    }
    entry.via = ACTIVITY_VIA_WINDOW
    id := hex.encode(c.random_bytes(8))
    // What the window shows is read from the argv that runs, never from the client's
    // own words (`req.caller`), which a client could set to anything (milestone 15).
    mut ap := new_approval(id, session.id, caller, caller_summary(parsed), need, now)
    ap.command = whole_command(caller_command(parsed))
    ap.deadline_ms = now + approval_wait_ms()
    ap.token = ask
    ap.sudo = sudo
    ap.tunnel = tunnel
    if parsed.positional(0) == "cp" {
        // An argv that does not parse as a copy leaves the window's copy card empty.
        ap.copy = copy_ask_for(parsed, st, caller, session.id, cat, now, req.cwd) or ap.copy
    }
    st.holder.access_hold()
    mut book := st.holder.access_book()
    book.pending.push(ap)
    st.holder.put_access_book(book)
    st.holder.access_release()
    write_stderr("flint-gui: asking the owner to approve {ap.label}\n")
    app.emit("access:request", ap)
    show_window(mut app)
    notice := "Waiting for approval in Flint ({ap.label})…"
    send_wait(conn, notice, session_kind)
    mut last_notice := now
    for true {
        time.sleep_ms(APPROVAL_POLL_MS)
        t := time.now_ms()
        cur := find_approval(st.holder.access_book(), id) or {
            app.emit("access:resolved", ApprovalResolved{ id: id, state: APPROVAL_DENIED })
            return refuse(coded(ERR_LOCKED, "the vault locked while Flint was asking for approval"))
        }
        state := cur.state
        if state != APPROVAL_PENDING {
            typed := forget_approval(st, id)
            app.emit("access:resolved", ApprovalResolved{ id: id, state: state })
            if state == APPROVAL_DENIED {
                entry.outcome = ACTIVITY_DENIED
                log_activity(st, store, session, entry, mut app)
                return refuse(coded(ERR_DENIED, "the owner denied this request in Flint"))
            }
            // A token or a sudo command is allowed for this one request; nothing else is.
            if asked_every_time(need) || find_grant(st.holder.access_book().grants, caller, session.id, need, cat, t).has_value() {
                if activity_logged(need) {
                    log_activity(st, store, session, entry, mut app)
                }
                return GateOutcome{ refusal: "", sudo_typed: typed }
            }
            return refuse(coded(ERR_DENIED, "the access allowed in Flint does not cover this request"))
        }
        if t >= ap.deadline_ms {
            _ := forget_approval(st, id)
            app.emit("access:resolved", ApprovalResolved{ id: id, state: "expired" })
            entry.outcome = ACTIVITY_TIMEOUT
            log_activity(st, store, session, entry, mut app)
            return refuse(coded(ERR_APPROVAL_TIMEOUT, "nobody answered in Flint within {approval_wait_ms() / 1000}s; run the command again and allow it there"))
        }
        // A client that hung up is not waiting any more. Before a session's raw mode
        // the client sends nothing, so anything readable is its close.
        if conn.readable(0) {
            _ := forget_approval(st, id)
            app.emit("access:resolved", ApprovalResolved{ id: id, state: "gone" })
            return refuse("gone")
        }
        if session_kind && t - last_notice >= APPROVAL_NOTICE_MS {
            send_wait(conn, notice, session_kind)
            last_notice = t
        }
    }
    return refuse("")
}

// The command as the activity log keeps it, whole up to 16 KB (milestone 15): the
// words before any flag and, for `exec`, the remote command (caller_command, D-018);
// for `token create` the token's name, what it allows and where; for `exec --sudo`
// the full argv, each argument quoted. Never a flag's value otherwise.
fn activity_command(p: ParsedArgs, ask: TokenAsk, sudo: SudoAsk) -> str {
    s := caller_command(p)
    if sudo.host.len() > 0 {
        // The whole command, as approved: what ran as root (milestone 13).
        return "flint exec {sudo.host} --sudo -- {str.join(quoted_argv(sudo.argv), " ")}"
    }
    if ask.name.len() > 0 {
        return "{s} '{ask.name}' ({ask.allows} on {ask.reaches}, {ask.ttl})"
    }
    return s
}

// Appends `e` to the open vault's log, if `session` is still the vault held. A
// failure is reported by its code only: a message could name a host (Principle 5).
fn log_activity(st: GuiState, store: LockedVaultStore, session: VaultSession, e: ActivityEntry, mut app: webui.App) {
    st.hold()
    still := st.unlocked() && st.vault_session().path == session.path
    mut ok := true
    if still {
        mut ts := store
        record_activity(mut ts, e, time.unix_seconds()) or err {
            ok = false
            write_stderr("flint-gui: the activity log was not written ({error_code_of("{err.message()}")})\n")
        }
    }
    st.release()
    if still && ok {
        app.emit("activity:added", ActivityAdded{ outcome: e.outcome })
    }
}

type ActivityAdded struct {
    outcome: str `json:"outcome"`
}

// How long a caller waits for the owner. The headless end-to-end run (and only it)
// may shorten it with FLINT_APPROVAL_WAIT_MS, to check a timeout in seconds.
fn approval_wait_ms() -> i64 {
    if os.getenv("FLINT_GUI_E2E").len() > 0 {
        ms := os.getenv("FLINT_APPROVAL_WAIT_MS").parse_i64() or APPROVAL_WAIT_MS
        if ms > 0 && ms < APPROVAL_WAIT_MS {
            return ms
        }
    }
    return APPROVAL_WAIT_MS
}

fn send_wait(conn: IpcConn, notice: str, session_kind: bool) {
    if session_kind {
        _ := conn.send(relay_frame(TAG_WAIT, notice), SERVE_SEND_MS) or {}
    } else {
        _ := conn.send(wait_notice_json(notice), SERVE_SEND_MS) or {}
    }
}

// Drops approval `id` from the book, with any sudo password typed for it, which it
// returns ("" for none).
fn forget_approval(st: GuiState, id: str) -> str {
    st.holder.access_hold()
    mut book := st.holder.access_book()
    drop_approval(mut book, id)
    typed := take_sudo_typed(mut book, id)
    st.holder.put_access_book(book)
    st.holder.access_release()
    return typed
}

// Each argument as the shell word Flint sends: a reader sees where one ends.
fn quoted_argv(argv: []str) -> []str {
    mut q: []str = []
    for a in argv {
        q.push(shell_single_quote(a))
    }
    return q
}

// Whether this app runs a client's one-exchange request: its vault is the one held
// unlocked, and the command is one it serves. Otherwise the client runs it itself.
fn run_servable_here(req: ServeRequest, st: GuiState) -> bool {
    st.hold()
    defer st.release()
    return st.unlocked() && st.vault_session().path == req.vault && run_request_servable(req)
}

fn serve_run(mut conn: IpcConn, req: ServeRequest, c: Sodium, mut store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore, st: GuiState, mut app: webui.App) {
    if !run_servable_here(req, st) {
        _ := conn.send(json_not_served(), SERVE_SEND_MS) or {}
        return
    }
    refusal := gate(conn, req, c, store, st, mut app, false).refusal
    if refusal == "gone" {
        return
    }
    if refusal.len() > 0 {
        _ := conn.send(serve_reply_json(refused_reply(refusal, req)), SERVE_SEND_MS) or {}
        return
    }
    st.hold()
    defer st.release()
    session := st.vault_session()
    if !st.unlocked() || session.path != req.vault {
        _ := conn.send(serve_reply_json(refused_reply(coded(ERR_LOCKED, "the vault locked before the command ran"), req)), SERVE_SEND_MS) or {}
        return
    }
    reply := run_served(req, c, mut store, kc, recents, session)
    if reply.served {
        // `vault rename` changes the name inside the file: keep the window's in step.
        name := store.vault_get_meta("name") or session.name
        if name.len() > 0 && name != session.name {
            mut renamed := session
            renamed.name = name
            st.adopt(renamed)
        }
        if served_changes_vault(req) {
            app.emit("vault:changed", VaultChanged{ path: session.path, name: st.vault_session().name })
        }
        if served_changes_tokens(req) {
            app.emit("access:changed", GrantsChanged{ count: i64(st.holder.access_book().grants.len()) })
        }
    }
    _ := conn.send(serve_reply_json(reply), SERVE_SEND_MS) or {}
}

// `connect`, `exec` and `host test`: the vault is checked and copied under the hold,
// then the session runs without it, as a window tab does.
fn serve_session(mut conn: IpcConn, req: ServeRequest, c: Sodium, mut store: LockedVaultStore, kc: OsKeychain, recents: JsonRecentStore, st: GuiState, mut app: webui.App) {
    st.hold()
    ok := st.unlocked() && st.vault_session().path == req.vault && session_servable(req)
    st.release()
    if !ok {
        _ := conn.send(session_not_served_frame(), SERVE_SEND_MS) or {}
        return
    }
    outcome := gate(conn, req, c, store, st, mut app, true)
    refusal := outcome.refusal
    if refusal == "gone" {
        return
    }
    if refusal.len() > 0 {
        _ := conn.send(refused_session_frame(refusal, req), SERVE_SEND_MS) or {}
        return
    }
    st.hold()
    session := st.vault_session()
    still := st.unlocked() && session.path == req.vault
    st.release()
    if !still {
        _ := conn.send(refused_session_frame(coded(ERR_LOCKED, "the vault locked before the command ran"), req), SERVE_SEND_MS) or {}
        return
    }
    run_served_session(conn, req, c, mut store, kc, recents, session, outcome.sudo_typed)
}
