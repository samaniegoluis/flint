package main

// flint-vault-server on cfire's HTTP server (milestones 42 and 78, D-097, D-156): an
// event loop reads every request whole under a deadline for its headers and one for its
// body, its body capped (413), so a slow or hostile client holds no worker; a pool of
// workers runs the handler, which maps one request to one call of the use case and back.
// Requests run at once, so the store and the gate are behind one lock: a vault's version
// check and its write stay one step (Principle 14), and the rate limits are shared.

import "core:net/http"
import "core:sync"
import "core:time"
import "../../domain"
import "../../ports"
import "../../application/vaultserver"
import "../../adapters/serverfs"

// The header and body deadlines add up to the whole request's 60 s of milestone 42
// (Principle 8). The body's is one deadline from the end of the headers, not per read.
HEADER_TIMEOUT_MS: i32 = 10000
BODY_TIMEOUT_MS: i32 = 50000
// Requests waiting for a worker, and connections open at once; past either a client
// gets 503. An idle connection closes after KEEPALIVE_MS.
MAX_PENDING: usize = 64
MAX_CONNECTIONS: usize = 256
KEEPALIVE_MS: i32 = 5000
REQUESTS_PER_CONNECTION: usize = 100

// The server's limits, explicit: `workers` 0 is cfire's pool (twice the cores, at least
// 4); no WebSocket route, so none is accepted.
fn server_limits(max_body: i64) -> http.ServerLimits {
    return http.ServerLimits{ header_timeout_ms: HEADER_TIMEOUT_MS, body_timeout_ms: BODY_TIMEOUT_MS, max_body_bytes: usize(max_body), workers: 0, max_pending: MAX_PENDING, keepalive_timeout_ms: KEEPALIVE_MS, max_requests_per_conn: REQUESTS_PER_CONNECTION, max_websockets: 0, max_connections: MAX_CONNECTIONS }
}

// The client the gate and the log know: the socket's peer, or, behind a reverse proxy
// the person trusts, the address that proxy appended last to X-Forwarded-For.
fn client_of(peer: str, req: http.Request, trust_proxy: bool) -> str {
    if trust_proxy {
        fwd := req.header("x-forwarded-for")
        if fwd.len() > 0 {
            parts := fwd.split(",")
            last := parts[parts.len() - 1].trim()
            if last.len() > 0 && last.len() <= 64 {
                return str(last)
            }
        }
    }
    if peer.len() == 0 {
        return "unknown"
    }
    return peer
}

fn to_server_request(req: http.Request, client: str) -> vaultserver.ServerRequest {
    return vaultserver.ServerRequest{ method: req.method, path: req.path, client: client, authorization: req.header("authorization"), if_match: req.header("if-match"), if_none_match: req.header("if-none-match"), vault_id: req.header("x-flint-vault-id"), body: req.body }
}

// Reason phrases core:net/http does not know (it sends "Error" for them, CF-209).
fn reason_phrase(status: i32) -> str {
    if status == 304 {
        return "Not Modified"
    } else if status == 408 {
        return "Request Timeout"
    } else if status == 411 {
        return "Length Required"
    } else if status == 412 {
        return "Precondition Failed"
    } else if status == 413 {
        return "Content Too Large"
    } else if status == 428 {
        return "Precondition Required"
    } else if status == 429 {
        return "Too Many Requests"
    } else if status == 431 {
        return "Request Header Fields Too Large"
    }
    return ""
}

fn to_http_response(r: vaultserver.ServerReply) -> http.Response {
    mut resp := http.Response.text(r.status, r.body)
    reason := reason_phrase(r.status)
    if reason.len() > 0 {
        resp.status_text = reason
    }
    if r.content_type.len() > 0 {
        resp.set_header("Content-Type", r.content_type)
    }
    resp.set_header("Cache-Control", "no-store")
    if r.version > 0 {
        resp.set_header("ETag", domain.version_tag(r.version))
    }
    if r.vault_id.len() > 0 {
        resp.set_header("X-Flint-Vault-Id", r.vault_id)
    }
    if r.retry_after_s > 0 {
        resp.set_header("Retry-After", "{r.retry_after_s}")
    }
    if r.status == 401 {
        resp.set_header("WWW-Authenticate", "Bearer")
    }
    if r.status == 405 {
        resp.set_header("Allow", "GET, PUT")
    }
    return resp
}

// A reply for a request refused before it reached the use case.
fn early_reply(status: i32, note: str) -> vaultserver.ServerReply {
    mut message := "the request was refused"
    if status == 411 {
        message = "send the upload with Content-Length"
    }
    return vaultserver.json_reply(status, note, message)
}

// A path as the log shows it: printable ASCII, at most 80 characters.
fn loggable(s: str) -> str {
    mut b: []byte = []
    for c in s.bytes() {
        v := u8(c)
        if v >= 32 && v < 127 && b.len() < 80 {
            b.push(c)
        }
    }
    return str(b)
}

type ServeOptions struct {
    host:        str
    port:        u16
    data_dir:    str
    trust_proxy: bool
    // HEADER_TIMEOUT_MS and BODY_TIMEOUT_MS when serving; tests shorten them.
    header_ms:   i32
    body_ms:     i32
}

// What every request shares, behind one lock.
type ServerState struct {
    store: serverfs.FileBlobStore
    gate:  domain.ServerGate
}

// One request, on a worker: the use case under the lock, then one line on stderr: never
// a header's value, a token or a body (Principle 13). The loop answers what it refuses
// itself (400, 408, 413, 431, 503) with no line here (CF-211).
fn handle_request[C: ports.Crypto](crypto: C, cfg: vaultserver.ServerConfig, trust_proxy: bool, state: sync.Mutex[ServerState], req: http.Request) -> http.Response {
    started := time.now_ms()
    client := client_of(req.remote_addr, req, trust_proxy)
    mut reply := early_reply(411, "length_required")
    // A PUT with no Content-Length and no chunk: there is no upload to store.
    if req.method != "PUT" || req.header("content-length").len() > 0 || req.body.len() > 0 {
        sreq := to_server_request(req, client)
        reply = state.with_lock(|mut st: ServerState| -> vaultserver.ServerReply {
            return vaultserver.serve_vault_request(crypto, mut st.store, mut st.gate, cfg, sreq, time.now_ms(), time.now().unix_millis())
        })
    }
    mut tail := ""
    if reply.note.len() > 0 {
        tail = " " + reply.note
    }
    log_line("{client} {loggable(req.method)} {loggable(req.path)} {reply.status} {time.now_ms() - started}ms{tail}")
    return to_http_response(reply)
}

// Binds the server and serves while `body(port)` runs, then stops it. The handler's
// captures live in this frame: cfire captures them by reference even in a closure the
// server's threads keep (CF-212), so the server never outlives this call.
fn serve_while[C: ports.Crypto](crypto: C, cfg: vaultserver.ServerConfig, opts: ServeOptions, body: fn(u16) -> void!) -> void! {
    store := try serverfs.new_file_blob_store(opts.data_dir)
    if opts.port > 0 {
        refused := serverfs.listen_refusal(opts.host, opts.port)
        if refused.len() > 0 {
            return error(domain.coded(domain.ERR_PORT_IN_USE, "cannot listen on {opts.host}:{opts.port}: {refused}"))
        }
    }
    mut srv := make(http.Server, opts.port, host: opts.host) or {
        return error(domain.coded(domain.ERR_PORT_IN_USE, "cannot listen on {opts.host}:{opts.port}"))
    }
    mut limits := server_limits(cfg.max_body)
    limits.header_timeout_ms = opts.header_ms
    limits.body_timeout_ms = opts.body_ms
    srv.set_limits(limits)
    if store.moved.len() > 0 {
        log_line("moved the vault {store.moved} into {opts.data_dir}/vaults/{store.moved} (one folder per vault since 0.12)")
    }
    vaults := try store.blob_vaults()
    state := make(sync.Mutex[ServerState], ServerState{ store: store, gate: domain.new_server_gate() })
    trust := opts.trust_proxy
    srv.serve_in_background(|req: http.Request| -> http.Response {
        return handle_request(crypto, cfg, trust, state, req)
    })
    log_line("listening on {opts.host}:{srv.port()}, data in {opts.data_dir}, {vaults.len()} vaults (at most {cfg.max_vaults})")
    body(srv.port()) or err {
        srv.stop()
        return error(err.message())
    }
    srv.stop()
}

fn forever(_port: u16) -> void! {
    for {
        time.sleep_ms(60000)
    }
}

// Serves until the process ends (a signal: main's on_stop).
fn serve_forever[C: ports.Crypto](crypto: C, cfg: vaultserver.ServerConfig, opts: ServeOptions) -> void! {
    try serve_while(crypto, cfg, opts, forever)
}
