package main

// flint-vault-server (milestones 42 and 45, D-092, D-097, D-103): keeps one person's
// vault files, as they are (encrypted in full), each under its id with its versions,
// for the machines that sync them. It never holds a key and never opens a file
// (Principle 13).
//
//   flint-vault-server [serve]                   serve, configured by the environment
//   flint-vault-server token [--json]            a new token, and the hash to set instead
//   flint-vault-server vaults [--json]           the vaults kept, by id
//   flint-vault-server versions [<id>] [--json]  a vault's kept versions, newest first
//   flint-vault-server restore [<id>] <n> [--json]  make a kept version the newest again
//   flint-vault-server label <id> [<label>]      set a vault's label, or clear it
//   flint-vault-server delete [<id>] [--yes]     remove a vault and every version kept
//   flint-vault-server --version
//
// <id> is a vault's id or a unique prefix of it (4 characters or more), and may be left
// out while the server keeps one vault.
//
// Environment: FLINT_VAULT_TOKEN or FLINT_VAULT_TOKEN_HASH, FLINT_VAULT_DATA (the data
// folder), FLINT_VAULT_LISTEN (host:port), FLINT_VAULT_MAX_BYTES, FLINT_VAULT_MAX_VAULTS,
// FLINT_VAULT_TRUST_PROXY.

import "core:json"
import "core:os"
import "core:time"
import "../../domain"
import "../../application/vaultserver"
import "../../adapters/crypto"
import "../../adapters/serverfs"
import "../version"

DEFAULT_LISTEN: str = "0.0.0.0:8787"
DEFAULT_DATA: str = "./flint-vault-data"

USAGE: str = "usage: flint-vault-server [serve | token [--json] | vaults [--json] | versions [<id>] [--json] | restore [<id>] <version> [--json] | label <id> [<label>] | delete [<id>] [--yes] | --version]"

fn log_line(s: str) {
    eprintln("flint-vault-server: {s}")
}

fn fail(msg: str) {
    eprintln("flint-vault-server: {error_text_of(msg)}")
    os.exit(exit_code_for(error_code_of(msg)))
}

fn on_stop(sig: i32) {
    log_line("stopping (signal {sig})")
    os.exit(0)
}

type TokenOut struct {
    token: str `json:"token"`
    hash:  str `json:"hash"`
}

fn listen_parts(spec: str) -> ServeOptions! {
    colon := spec.last_index_of(":") or 0
    if colon == 0 {
        return error(coded(ERR_USAGE, "FLINT_VAULT_LISTEN must be host:port, such as 0.0.0.0:8787"))
    }
    mut host := spec[..colon]
    if host.starts_with("[") && host.ends_with("]") {
        host = str(host[1..host.len() - 1])
    }
    port := parse_version_tag(spec[colon + 1..])
    if port < 1 || port > 65535 {
        return error(coded(ERR_USAGE, "FLINT_VAULT_LISTEN has no valid port"))
    }
    return ServeOptions{ host: host, port: u16(port), data_dir: "", trust_proxy: false }
}

fn cmd_serve() -> void! {
    sodium := try new_sodium()
    mut max_body := SERVER_MAX_BODY_DEFAULT
    max_text := os.getenv("FLINT_VAULT_MAX_BYTES")
    if max_text.len() > 0 {
        max_body = parse_version_tag(max_text)
        if max_body < 1 {
            return error(coded(ERR_USAGE, "FLINT_VAULT_MAX_BYTES must be a number of bytes"))
        }
    }
    mut cfg := try server_config_from(sodium, os.getenv("FLINT_VAULT_TOKEN"), os.getenv("FLINT_VAULT_TOKEN_HASH"), max_body)
    max_vaults_text := os.getenv("FLINT_VAULT_MAX_VAULTS")
    if max_vaults_text.len() > 0 {
        cfg.max_vaults = parse_version_tag(max_vaults_text)
        if cfg.max_vaults < 1 {
            return error(coded(ERR_USAGE, "FLINT_VAULT_MAX_VAULTS must be a number of vaults"))
        }
    }
    mut opts := try listen_parts(os.getenv("FLINT_VAULT_LISTEN", DEFAULT_LISTEN))
    opts.data_dir = os.getenv("FLINT_VAULT_DATA", DEFAULT_DATA)
    trust := os.getenv("FLINT_VAULT_TRUST_PROXY")
    opts.trust_proxy = trust == "1" || trust == "true"
    os.on_signal(15, on_stop)
    os.on_signal(2, on_stop)
    try serve_forever(sodium, cfg, opts)
}

fn cmd_token(as_json: bool) -> void! {
    sodium := try new_sodium()
    t := try new_server_token(sodium)
    if as_json {
        println(json.stringify(TokenOut{ token: t.token, hash: t.hash }))
        return
    }
    println("token  {t.token}")
    println("hash   {t.hash}")
    eprintln("")
    eprintln("Give the token to Flint when it connects (shown this once). On the server, set")
    eprintln("FLINT_VAULT_TOKEN to the token, or FLINT_VAULT_TOKEN_HASH to the hash to keep only")
    eprintln("the hash there.")
}

fn data_store() -> FileBlobStore! {
    return try new_file_blob_store(os.getenv("FLINT_VAULT_DATA", DEFAULT_DATA))
}

fn pad_left(s: str, width: usize) -> str {
    mut out_s := s
    for out_s.len() < width {
        out_s = " " + out_s
    }
    return out_s
}

fn cmd_vaults(as_json: bool) -> void! {
    mut store := try data_store()
    vaults := try list_server_vaults(mut store)
    if as_json {
        println(json.stringify(vaults))
        return
    }
    if vaults.len() == 0 {
        eprintln("no vault stored yet")
        return
    }
    println("VAULT                             VERSION  UPDATED (UTC)             SIZE      LABEL")
    for v in vaults {
        updated := time.unix(v.updated_at / 1000).format_rfc3339()
        println(v.id + "  " + pad_left("{v.version}", 7) + "  " + updated + "    " + pad_left("{v.size}", 8) + "  " + v.label)
    }
}

fn cmd_versions(wanted: str, as_json: bool) -> void! {
    mut store := try data_store()
    v := try server_vault_named(mut store, wanted)
    kept := try list_vault_versions(mut store, v.id)
    if as_json {
        println(json.stringify(kept))
        return
    }
    println("VERSION  STORED (UTC)              SIZE      VAULT")
    for k in kept {
        stored := time.unix(k.stored_at / 1000).format_rfc3339()
        println(pad_left("{k.version}", 7) + "  " + stored + "    " + pad_left("{k.size}", 8) + "  " + k.vault_id)
    }
}

fn cmd_restore(wanted: str, arg: str, as_json: bool) -> void! {
    n := parse_version_tag(arg)
    if n < 1 {
        return error(coded(ERR_USAGE, "restore takes a version number from `flint-vault-server versions`"))
    }
    mut store := try data_store()
    target := try server_vault_named(mut store, wanted)
    v := try restore_vault_version(mut store, target.id, n, time.now().unix_millis())
    if as_json {
        println(json.stringify(v))
        return
    }
    println("version {n} of vault {target.id} is now version {v.version}, the newest: every machine merges it at its next sync")
}

fn cmd_label(wanted: str, label: str) -> void! {
    mut store := try data_store()
    target := try server_vault_named(mut store, wanted)
    try set_server_vault_label(mut store, target.id, label)
    if label.len() == 0 {
        println("vault {target.id} has no label now")
        return
    }
    println("vault {target.id} is labelled '{label}'")
}

// Asks on the terminal (or reads a line piped in) whether to go on; only y or yes does.
fn confirmed(question: str) -> bool {
    eprint("{question} [y/N] ")
    mut input := os.stdin()
    line := input.read_line() or ""
    answer := line.trim().to_lower()
    return answer == "y" || answer == "yes"
}

// `delete [<id>]` (milestone 71): names the vault and what goes with it, asks, then
// removes its folder. `--yes` skips the question, for scripts.
fn cmd_delete(wanted: str, yes: bool, as_json: bool) -> void! {
    mut store := try data_store()
    target := try server_vault_named(mut store, wanted)
    kept := try list_vault_versions(mut store, target.id)
    if !yes {
        mut named := target.id
        if target.label.len() > 0 {
            named = "{target.id} ('{target.label}')"
        }
        eprintln("vault {named}: version {target.version}, {kept.len()} versions kept, {target.size} bytes")
        eprintln("A machine still connected to it uploads its copy again at its next sync: disconnect them first.")
        if !confirmed("Delete it and every version kept?") {
            return error(coded(ERR_DENIED, "nothing was deleted"))
        }
    }
    try delete_server_vault(mut store, target.id)
    if as_json {
        println(json.stringify(target))
        return
    }
    println("vault {target.id} deleted, with its {kept.len()} versions kept")
}

fn main() {
    all := os.args()
    mut args: []str = []
    for i in 1..all.len() {
        args.push(all[i])
    }
    mut as_json := false
    mut yes := false
    mut words: []str = []
    for a in args {
        if a == "--json" {
            as_json = true
        } else if a == "--yes" || a == "-y" {
            yes = true
        } else {
            words.push(a)
        }
    }
    if words.len() > 0 && (words[0] == "--version" || words[0] == "-V" || words[0] == "version") {
        println("flint-vault-server {FLINT_VERSION}")
        return
    }
    if words.len() > 0 && (words[0] == "--help" || words[0] == "-h" || words[0] == "help") {
        println(USAGE)
        return
    }
    mut cmd := "serve"
    if words.len() > 0 {
        cmd = words[0]
    }
    if cmd == "serve" && words.len() <= 1 {
        cmd_serve() or err {
            fail(err.message())
        }
        return
    }
    if cmd == "token" && words.len() == 1 {
        cmd_token(as_json) or err {
            fail(err.message())
        }
        return
    }
    if cmd == "vaults" && words.len() == 1 {
        cmd_vaults(as_json) or err {
            fail(err.message())
        }
        return
    }
    if cmd == "versions" && words.len() <= 2 {
        mut wanted := ""
        if words.len() == 2 {
            wanted = words[1]
        }
        cmd_versions(wanted, as_json) or err {
            fail(err.message())
        }
        return
    }
    if cmd == "restore" && (words.len() == 2 || words.len() == 3) {
        mut wanted := ""
        mut n := words[1]
        if words.len() == 3 {
            wanted = words[1]
            n = words[2]
        }
        cmd_restore(wanted, n, as_json) or err {
            fail(err.message())
        }
        return
    }
    if cmd == "label" && (words.len() == 2 || words.len() == 3) {
        mut label := ""
        if words.len() == 3 {
            label = words[2]
        }
        cmd_label(words[1], label) or err {
            fail(err.message())
        }
        return
    }
    if cmd == "delete" && words.len() <= 2 {
        mut wanted := ""
        if words.len() == 2 {
            wanted = words[1]
        }
        cmd_delete(wanted, yes, as_json) or err {
            fail(err.message())
        }
        return
    }
    fail(coded(ERR_USAGE, USAGE))
}
