package clicmd

// `flint tunnel` (milestone 22, D-062): local port forwards saved in a host.
//
//   add|edit|rm|ls      the saved tunnels, as `flint host` edits hosts
//   up|down|status      running ones: only through Flint, which keeps them running
//
// Each handler parses its flags, calls one use case and formats the result
// (Principle 2).

import "core:json"
import "../../adapters/config"
import "../../adapters/crypto"
import "../../adapters/ssh"
import "../../adapters/vault"
import "../../application"
import "../../domain"

fn tunnel_usage() -> str {
    return coded(ERR_USAGE, `usage: flint tunnel add <host> <name> --local <port> [--to <host:port>] [--open-on-connect]
       flint tunnel edit <host>:<name> [--name <name>] [--local <port>] [--to <host:port>] [--open-on-connect | --no-open-on-connect]
       flint tunnel rm <host>:<name> | flint tunnel ls [<host>]
       flint tunnel up|down <host>:<name> | flint tunnel status [<host>:<name>]`)
}

// `up`, `down` and `status` act on what runs in Flint: they are session commands, so
// the app relays the host's prompts to this terminal.
fn is_tunnel_session(p: ParsedArgs) -> bool {
    verb := p.positional(1)
    return p.positional(0) == "tunnel" && (verb == "up" || verb == "down" || verb == "status")
}

fn tunnel_patch_from_flags(p: ParsedArgs) -> TunnelPatch! {
    mut patch := empty_tunnel_patch()
    if p.has_flag("--name") {
        patch.set_name = true
        patch.name = p.flag_value("--name")
    }
    if p.has_flag("--local") {
        patch.set_local_port = true
        patch.local_port = try parse_port_text(p.flag_value("--local"), "local port")
    }
    if p.has_flag("--to") {
        (h, port) := try parse_tunnel_destination(p.flag_value("--to"))
        patch.set_dest = true
        patch.dest_host = h
        patch.dest_port = port
    }
    if p.has_flag("--open-on-connect") && p.has_flag("--no-open-on-connect") {
        return error(coded(ERR_USAGE, "pass --open-on-connect or --no-open-on-connect, not both"))
    }
    if p.has_flag("--open-on-connect") {
        patch.set_open = true
        patch.open_on_connect = true
    }
    if p.has_flag("--no-open-on-connect") {
        patch.set_open = true
        patch.open_on_connect = false
    }
    return patch
}

fn tunnel_ref_text(v: TunnelView) -> str {
    return "{v.host}:{v.name}"
}

fn tunnel_state_text(v: TunnelView) -> str {
    if v.state.len() == 0 {
        return "-"
    }
    if v.state == TUNNEL_LISTENING {
        return "listening · {plural(v.connections, "connection", "connections")}"
    }
    return v.state
}

fn print_tunnel_list(list: []TunnelView) {
    if list.len() == 0 {
        say("No tunnels.")
        return
    }
    mut rows: [][]str = []
    for v in list {
        mut on := "-"
        if v.open_on_connect {
            on = "yes"
        }
        rows.push([tunnel_ref_text(v), "127.0.0.1:{v.local_port}", v.destination, on, tunnel_state_text(v)])
    }
    print_table(["TUNNEL", "LOCAL", "DESTINATION", "ON CONNECT", "STATE"], rows)
}

fn print_tunnel(v: TunnelView) {
    print_fields(["tunnel", "local", "destination", "on connect", "state", "error"],
        [tunnel_ref_text(v), "127.0.0.1:{v.local_port}", v.destination, yes_no(v.open_on_connect), tunnel_state_text(v), dash_if_empty(v.error)])
}

// The saved tunnels: run by the app or in this process.
fn cmd_tunnel(p: ParsedArgs, sec: SecretInput, as_json: bool, c: Sodium, mut store: LockedVaultStore, src: VaultSource, recents: JsonRecentStore) -> void! {
    verb := p.positional(1)
    mut tun := store
    mut runner := new_native_tunnels()
    if verb == "add" {
        try p.allow_flags("tunnel add", ["--local", "--to", "--open-on-connect"])
        try p.expect_args("tunnel add", 2, "<host> <name> --local <port> [--to <host:port>] [--open-on-connect]")
        if p.has_flag("--name") {
            return error(tunnel_usage())
        }
        mut patch := try tunnel_patch_from_flags(p)
        patch.set_name = true
        patch.name = p.positional(3)
        _ := try open_target(p, sec, c, mut store, src, recents)
        v := try add_tunnel(c, store, mut tun, runner, p.positional(2), patch)
        if as_json {
            say(json.stringify(v))
        } else {
            say("Added tunnel '{tunnel_ref_text(v)}': 127.0.0.1:{v.local_port} to {v.destination} as {v.host} sees it.")
        }
        return
    }
    if verb == "edit" {
        try p.allow_flags("tunnel edit", ["--name", "--local", "--to", "--open-on-connect", "--no-open-on-connect"])
        try p.expect_args("tunnel edit", 1, "<host>:<name> [--name <name>] [--local <port>] [--to <host:port>] [--open-on-connect | --no-open-on-connect]")
        (alias, name) := try split_tunnel_ref(p.positional(2))
        patch := try tunnel_patch_from_flags(p)
        _ := try open_target(p, sec, c, mut store, src, recents)
        v := try edit_tunnel(store, mut tun, runner, alias, name, patch)
        if as_json {
            say(json.stringify(v))
        } else if v.state == TUNNEL_LISTENING {
            say("Updated tunnel '{tunnel_ref_text(v)}'. It keeps running as it was until it is started again.")
        } else {
            say("Updated tunnel '{tunnel_ref_text(v)}'.")
        }
        return
    }
    if verb == "rm" {
        try p.allow_flags("tunnel rm", [])
        try p.expect_args("tunnel rm", 1, "<host>:<name>")
        (alias, name) := try split_tunnel_ref(p.positional(2))
        _ := try open_target(p, sec, c, mut store, src, recents)
        v := try remove_tunnel(store, mut tun, mut runner, alias, name)
        if as_json {
            say(json.stringify(RemovedNote{ removed: "tunnel", name: tunnel_ref_text(v) }))
        } else {
            say("Removed tunnel '{tunnel_ref_text(v)}'.")
        }
        return
    }
    if verb == "ls" || verb == "list" {
        try p.allow_flags("tunnel ls", [])
        if p.positionals.len() > 3 {
            return error(coded(ERR_USAGE, "usage: flint tunnel ls [<host>]"))
        }
        _ := try open_target(p, sec, c, mut store, src, recents)
        mut list := try list_tunnels(store, tun, mut runner, p.positional(2))
        if !sec.in_app {
            // Tunnels run in Flint: this process cannot see them.
            for i in 0..list.len() {
                list[i].state = ""
            }
        }
        if as_json {
            say(json.stringify(list))
        } else {
            print_tunnel_list(list)
        }
        return
    }
    return error(coded(ERR_USAGE, "unknown command `flint tunnel {verb}`; see `flint help`"))
}

fn tunnels_need_flint(verb: str) -> str {
    return coded(ERR_LOCKED, "`flint tunnel {verb}` runs only through Flint, which keeps tunnels running: open Flint, unlock this vault there, and run it again")
}

// `up`, `down` and `status`, run by the app for the CLI.
fn cmd_tunnel_session[P: Prompter](p: ParsedArgs, sec: SecretInput, as_json: bool, c: Sodium, mut store: LockedVaultStore, src: VaultSource, recents: JsonRecentStore, prompter: P) -> void! {
    verb := p.positional(1)
    if verb == "up" {
        try p.allow_flags("tunnel up", ["--timeout", "--accept-new-host-key"])
        try p.expect_args("tunnel up", 1, "<host>:<name> [--timeout <secs>] [--accept-new-host-key]")
    } else if verb == "down" {
        try p.allow_flags("tunnel down", [])
        try p.expect_args("tunnel down", 1, "<host>:<name>")
    } else {
        try p.allow_flags("tunnel status", [])
        if p.positionals.len() > 3 {
            return error(coded(ERR_USAGE, "usage: flint tunnel status [<host>:<name>]"))
        }
    }
    mut alias := ""
    mut name := ""
    if p.positional(2).len() > 0 {
        (a, n) := try split_tunnel_ref(p.positional(2))
        alias = a
        name = n
    }
    // Checked before any master password is asked: a tunnel needs the app (D-062).
    if !sec.in_app {
        return error(tunnels_need_flint(verb))
    }
    opts := try connect_options(p)
    s := try open_target(p, sec, c, mut store, src, recents)
    tun := store
    mut runner := new_native_tunnels()
    if verb == "status" && alias.len() == 0 {
        list := try running_tunnels(store, tun, mut runner)
        if as_json {
            say(json.stringify(list))
        } else if list.len() == 0 {
            say("No tunnels running.")
        } else {
            print_tunnel_list(list)
        }
        return
    }
    mut v := TunnelView{ host: "", name: "", local_port: 0, destination: "", open_on_connect: false, state: "", listen: "", connections: 0, error: "" }
    if verb == "up" {
        mut link := new_ssh_link()
        v = try start_tunnel(c, mut store, tun, s, mut link, prompter, mut runner, alias, name, opts)
    } else if verb == "down" {
        v = try stop_tunnel(store, tun, mut runner, alias, name)
    } else {
        v = try tunnel_status(store, tun, mut runner, alias, name)
    }
    if as_json {
        say(json.stringify(v))
        return
    }
    if verb == "up" {
        say("Tunnel '{tunnel_ref_text(v)}' is listening on {v.listen}, to {v.destination} as {v.host} sees it. It runs in Flint until `flint tunnel down {tunnel_ref_text(v)}`.")
    } else if verb == "down" {
        say("Tunnel '{tunnel_ref_text(v)}' is stopped.")
    } else {
        print_tunnel(v)
    }
}
