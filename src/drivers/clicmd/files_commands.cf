package clicmd

// `flint cp` (milestones 16, 18): copies between this machine and one host, by alias,
// in either direction, or from one host to another through Flint. The handler parses
// the two paths and the flags, calls one use case and formats the result (Principle 2).

import "core:json"
import "../../application"
import "../../domain"

fn cp_usage() -> str {
    return coded(ERR_USAGE, "usage: flint cp [-r] [--force] <src> <dst>, where one or both name a host as <alias>:<path>")
}

// The copy `flint cp <src> <dst>` asks for: one side names a host, or both (a copy
// between two hosts, which reads `remote` on `alias` and writes `local` on `to_alias`).
fn copy_request_from_args(p: ParsedArgs) -> CopyRequest! {
    if p.positionals.len() != 3 || p.has_rest {
        return error(cp_usage())
    }
    src := p.positional(1)
    dst := p.positional(2)
    src_remote := is_cp_remote_arg(src)
    dst_remote := is_cp_remote_arg(dst)
    if !src_remote && !dst_remote {
        return error(coded(ERR_USAGE, "neither path names a host; write one as <alias>:<path>, e.g. web:/etc/app.conf"))
    }
    recursive := p.has_flag("-r") || p.has_flag("--recursive")
    force := p.has_flag("--force")
    if src_remote && dst_remote {
        a := try parse_remote_arg(src)
        b := try parse_remote_arg(dst)
        return CopyRequest{ id: "cp", alias: a.alias, direction: COPY_RELAY, local: b.path, remote: a.path, recursive: recursive, force: force, to_alias: b.alias }
    }
    if src_remote {
        r := try parse_remote_arg(src)
        return CopyRequest{ id: "cp", alias: r.alias, direction: COPY_DOWNLOAD, local: local_slashes(dst), remote: r.path, recursive: recursive, force: force }
    }
    r := try parse_remote_arg(dst)
    return CopyRequest{ id: "cp", alias: r.alias, direction: COPY_UPLOAD, local: local_slashes(src), remote: r.path, recursive: recursive, force: force }
}

// Whether a `flint cp` path names a host. On Windows, `C:\...` and `C:/...` are
// local paths, not host `C` (scp on Windows reads them the same way). windows-port.
fn is_cp_remote_arg(arg: str) -> bool {
    if os_name() == "windows" && is_drive_path(local_slashes(arg)) {
        return false
    }
    return is_remote_arg(arg)
}

// The host alias a `flint cp` line copies to or from ("" when it names none).
fn cp_alias(p: ParsedArgs) -> str {
    for i in 1..3 {
        a := p.positional(i)
        if is_cp_remote_arg(a) {
            r := parse_remote_arg(a) or RemotePath{ alias: "", path: "" }
            return r.alias
        }
    }
    return ""
}

// The destination host of a copy between two hosts ("" for any other copy).
fn cp_second_alias(p: ParsedArgs) -> str {
    if !is_cp_remote_arg(p.positional(1)) || !is_cp_remote_arg(p.positional(2)) {
        return ""
    }
    r := parse_remote_arg(p.positional(2)) or RemotePath{ alias: "", path: "" }
    return r.alias
}

fn duration_text(ms: i64) -> str {
    if ms < 1000 {
        return "{ms} ms"
    }
    tenths := ms / 100
    return "{tenths / 10}.{tenths % 10} s"
}

fn copy_summary(r: CopyResult, req: CopyRequest) -> str {
    mut where := "to {r.host}:{req.remote}"
    if r.direction == COPY_RELAY {
        where = "from {r.host}:{req.remote} to {r.to_host}:{req.local}"
        if r.files.len() == 1 && r.folders == 0 {
            where = "from {r.host}:{r.files[0].source} to {r.to_host}:{r.files[0].target}"
        }
    }
    if r.direction == COPY_DOWNLOAD {
        where = "from {r.host}:{req.remote} to {req.local}"
    }
    if r.files.len() == 1 && r.folders == 0 && r.direction != COPY_RELAY {
        f := r.files[0]
        if r.direction == COPY_UPLOAD {
            where = "to {r.host}:{f.target}"
        } else {
            where = "from {r.host}:{f.source} to {f.target}"
        }
    }
    mut folders := ""
    if r.folders > 0 {
        folders = ", " + plural(r.folders, "folder", "folders") + " created"
    }
    return "Copied {plural(i64(r.files.len()), "file", "files")} ({human_bytes(r.bytes)}{folders}) {where} in {duration_text(r.duration_ms)}."
}

fn cmd_cp[P: Prompter, L: LocalFiles, K: TransferSink](p: ParsedArgs, sec: SecretInput, as_json: bool, c: Sodium, mut store: LockedVaultStore, src: VaultSource, recents: JsonRecentStore, prompter: P, mut local: L, mut sink: K) -> i32! {
    try p.allow_flags("cp", ["-r", "--recursive", "--force", "--timeout", "--accept-new-host-key"])
    req := try copy_request_from_args(p)
    opts := try connect_options(p)
    s := try open_target(p, sec, c, mut store, src, recents)
    mut link := new_ssh_link()
    mut clock := new_system_clock()
    mut res := CopyResult{}
    if req.direction == COPY_RELAY {
        mut to := new_ssh_link()
        res = try relay_with_hosts(c, mut store, s, mut link, mut to, prompter, mut sink, mut clock, req, opts)
    } else {
        res = try copy_with_host(c, mut store, s, mut link, prompter, mut local, mut sink, mut clock, req, opts)
    }
    if as_json {
        say(json.stringify(res))
        return 0
    }
    say(copy_summary(res, req))
    if res.skipped.len() > 0 {
        mut list := ""
        for i, sk in res.skipped {
            if i > 0 {
                list = list + ", "
            }
            list = list + sk
        }
        write_stderr("flint: skipped {plural(i64(res.skipped.len()), "link or special file", "links or special files")}: {list}\n")
    }
    return 0
}
