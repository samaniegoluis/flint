package clicmd

import "ext:json"
import "../../domain"

fn parsed(args: []str) -> ParsedArgs {
    r := parse_cli_args(args)
    assert(r.has_value())
    return r.value()
}

test "the app serves vault commands that open no SSH session" {
    assert(servable(parsed(["host", "list"])))
    assert(servable(parsed(["--json", "host", "add", "web", "--hostname", "h"])))
    assert(servable(parsed(["group", "rm", "a"])))
    assert(servable(parsed(["key", "show", "k"])))
    assert(servable(parsed(["cred", "list"])))
    assert(servable(parsed(["known-host", "rm", "web"])))
    assert(servable(parsed(["import", "tether", "f"])))
    assert(servable(parsed(["vault", "status"])))
    assert(servable(parsed(["vault", "rename", "x"])))
    assert(!servable(parsed(["host", "test", "web"])))
    assert(!servable(parsed(["connect", "web"])))
    assert(!servable(parsed(["exec", "web", "--", "id"])))
    for verb in ["create", "open", "unlock", "lock", "list", "use", "forget"] {
        assert(!servable(parsed(["vault", verb])))
    }
}

test "only writes make the window reload" {
    run := ServeRequest{ kind: "run", version: SERVE_PROTOCOL, vault: "/v", argv: [], cwd: "/", as_json: false, secrets: no_wire_secrets() }
    mut r := run
    r.argv = ["host", "add", "web", "--hostname", "h"]
    assert(served_changes_vault(r))
    r.argv = ["host", "list"]
    assert(!served_changes_vault(r))
    r.argv = ["import", "tether", "f", "--dry-run"]
    assert(!served_changes_vault(r))
    r.argv = ["import", "tether", "f"]
    assert(served_changes_vault(r))
    r.argv = ["vault", "rename", "n"]
    assert(served_changes_vault(r))
}

test "a request from another protocol version is refused" {
    req := ServeRequest{ kind: "run", version: SERVE_PROTOCOL + 1, vault: "/v", argv: ["host", "list"], cwd: "/", as_json: false, secrets: no_wire_secrets() }
    bad := parse_serve_request(json.stringify(req))
    assert(!bad.has_value())
    assert_eq(error_code_of("{bad.error().message()}"), ERR_UNSUPPORTED)
    junk := parse_serve_request("{not json")
    assert_eq(error_code_of("{junk.error().message()}"), ERR_INVALID)
}

test "a reply never names a secret field" {
    text := json_not_served()
    assert(!text.contains("password"))
    assert(!text.contains("passphrase"))
    assert(!text.contains("key_text"))
}

test "session commands are streamed, not run in one exchange" {
    assert(is_session_command(parsed(["host", "test", "web"])))
    assert(is_session_command(parsed(["connect", "web"])))
    assert(is_session_command(parsed(["exec", "web", "--", "id"])))
    assert(!is_session_command(parsed(["host", "list"])))
    sess := ServeRequest{ kind: "session", version: SERVE_PROTOCOL, vault: "/v", argv: ["exec", "web", "--", "id"], cwd: "/", as_json: false, secrets: no_wire_secrets() }
    assert(session_servable(sess))
    mut bad := sess
    bad.argv = ["host", "list"]
    assert(!session_servable(bad))
    bad.argv = ["exec"]
    assert(!session_servable(bad))
}

test "commands that need the key ask Flint to unlock; the rest do not" {
    // Typed: a literal of literals is not inferred (CF-091).
    need: [][]str = [["host", "list"], ["connect", "web"], ["exec", "web", "--", "id"], ["vault", "rename", "x"], ["import", "tether", "f"]]
    for args in need {
        assert(needs_unlocked_vault(parsed(args)))
    }
    free: [][]str = [["vault", "status"], ["vault", "list"], ["vault", "lock"], ["vault", "create", "/v"]]
    for args in free {
        assert(!needs_unlocked_vault(parsed(args)))
    }
}

test "the unlock screen names the command, never a flag's value" {
    assert_eq(caller_summary(parsed(["--json", "exec", "web", "--timeout", "9", "--", "uptime", "-p"])), "flint exec web -- uptime -p")
    assert_eq(caller_summary(parsed(["host", "add", "db", "--hostname", "10.0.0.1"])), "flint host add db")
    long := caller_summary(parsed(["exec", "web", "--", "echo", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]))
    assert_eq(long.len(), 160)
    assert(long.ends_with("..."))
}

test "relay frames carry a tag and raw bytes" {
    f := relay_frame(TAG_STDOUT, "\x1b[1mhi\x00")
    assert_eq(relay_tag(f), "o")
    assert_eq(relay_payload(f), "\x1b[1mhi\x00")
    assert_eq(relay_tag(""), "")
    assert_eq(relay_payload("k"), "")
    assert_eq(relay_tag(session_not_served_frame()), TAG_NOT_SERVED)
}

test "a session waits longer for a slow exec than for a login" {
    assert_eq(session_wait_ms(parsed(["connect", "web"])), (15 * 8 + 60) * 1000)
    assert_eq(session_wait_ms(parsed(["exec", "web", "--exec-timeout", "30", "--", "id"])), (15 * 8 + 30 + 60) * 1000)
    assert_eq(session_wait_ms(parsed(["host", "test", "web", "--timeout", "5"])), (5 * 8 + 60) * 1000)
}

test "a locked error says what to do" {
    t := RecentVault{ path: "/v.flint", name: "Home", id: "" }
    assert(locked_error(t, AppState{ state: APP_ASKING, name: "" }).contains("Flint is asking"))
    assert(locked_error(t, AppState{ state: APP_OTHER, name: "Work" }).contains("'Work'"))
    assert(locked_error(t, AppState{ state: APP_LOCKED, name: "" }).contains("could not be started"))
    assert_eq(error_code_of(locked_error(t, AppState{ state: APP_LOCKED, name: "" })), ERR_LOCKED)
}
