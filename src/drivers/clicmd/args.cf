package clicmd

// Command-line parsing for `flint`. core:cli has no positional arguments or
// subcommands and ignores unknown flags (CF-024), so this is a small parser of its
// own: `flint [global flags] <noun> <verb> [args] [flags]`, with flags anywhere.

import "core:str"
import "../../domain"

type ParsedArgs struct {
    positionals: []str
    flag_names: []str
    flag_values: []str
    // Everything after a bare `--`, untouched (the remote command of `exec`).
    rest: []str
    has_rest: bool
}

// Flags that take a value. `--flag value` and `--flag=value` both work.
fn value_flags() -> []str {
    return ["--vault", "--name", "--hostname", "--label", "--port", "--user", "--group", "--tag", "--color", "--notes", "--jump", "--cred", "--key", "--file", "--alias", "--timeout", "--exec-timeout", "--command", "--hosts", "--allow", "--ttl"]
}

// Flags that take no value.
fn bool_flags() -> []str {
    return ["--json", "--help", "-h", "--version", "-V", "--master-stdin", "--password", "--password-stdin", "--no-password", "--passphrase", "--passphrase-stdin", "--key-stdin", "--no-tags", "--accept-new-host-key", "--keep-shell", "--no-keep-shell", "--no-command", "--dry-run", "--all", "--sudo", "--sudo-password", "--sudo-password-stdin", "--no-sudo-password", "-r", "--recursive", "--force"]
}

fn list_has(list: []str, item: str) -> bool {
    for x in list {
        if x == item {
            return true
        }
    }
    return false
}

fn parse_cli_args(args: []str) -> ParsedArgs! {
    mut parsed := ParsedArgs{ positionals: [], flag_names: [], flag_values: [], rest: [], has_rest: false }
    values := value_flags()
    bools := bool_flags()
    mut i: usize = 0
    for i < args.len() {
        a := args[i]
        i += 1
        if a == "--" {
            parsed.has_rest = true
            for i < args.len() {
                parsed.rest.push(args[i])
                i += 1
            }
        } else if a.len() > 1 && a.starts_with("-") {
            mut name := a
            mut value := ""
            mut inline_value := false
            eq := str.index_of(a, "=")
            if a.starts_with("--") && eq > 0 {
                name = a.substr(0, usize(eq))
                value = a.substr(usize(eq) + 1)
                inline_value = true
            }
            if list_has(values, name) {
                if !inline_value {
                    if i >= args.len() {
                        return error(coded(ERR_USAGE, "{name} needs a value"))
                    }
                    value = args[i]
                    i += 1
                }
            } else if list_has(bools, name) {
                if inline_value {
                    return error(coded(ERR_USAGE, "{name} takes no value"))
                }
            } else {
                return error(coded(ERR_USAGE, "unknown flag {name}"))
            }
            parsed.flag_names.push(name)
            parsed.flag_values.push(value)
        } else {
            parsed.positionals.push(a)
        }
    }
    return parsed
}

fn (self: ParsedArgs) has_flag(name: str) -> bool {
    return list_has(self.flag_names, name)
}

// The last value given for `name`, or "" when absent.
fn (self: ParsedArgs) flag_value(name: str) -> str {
    mut v := ""
    for i, n in self.flag_names {
        if n == name {
            v = self.flag_values[i]
        }
    }
    return v
}

// Every value given for a repeatable flag, in order.
fn (self: ParsedArgs) flag_values_of(name: str) -> []str {
    mut vs: []str = []
    for i, n in self.flag_names {
        if n == name {
            vs.push(self.flag_values[i])
        }
    }
    return vs
}

fn (self: ParsedArgs) positional(i: usize) -> str {
    if i < self.positionals.len() {
        return self.positionals[i]
    }
    return ""
}

// Fails on a flag the command does not take. Global flags are always allowed.
fn (self: ParsedArgs) allow_flags(command: str, allowed: []str) -> void! {
    globals: []str = ["--json", "--vault", "--help", "-h", "--master-stdin"]
    for n in self.flag_names {
        if !list_has(allowed, n) && !list_has(globals, n) {
            return error(coded(ERR_USAGE, "`flint {command}` does not take {n}"))
        }
    }
}

// Fails unless exactly `n` positionals follow the noun and verb.
fn (self: ParsedArgs) expect_args(command: str, n: usize, shape: str) -> void! {
    if self.positionals.len() != n + 2 {
        return error(coded(ERR_USAGE, "usage: flint {command} {shape}"))
    }
}

// "22" -> 22.
fn parse_port_flag(text: str) -> i64! {
    n := str.parse_i64(text) or {
        return error(coded(ERR_INVALID, "port must be a number 1-65535"))
    }
    if n < 1 || n > 65535 {
        return error(coded(ERR_INVALID, "port must be a number 1-65535"))
    }
    return n
}

test "flags parse anywhere, with values inline or separate" {
    p := try parse_cli_args(["host", "add", "web", "--hostname", "10.0.0.5", "--json", "--tag=a", "--tag", "b", "--group="])
    assert_eq(p.positionals.len(), 3)
    assert_eq(p.positional(2), "web")
    assert_eq(p.flag_value("--hostname"), "10.0.0.5")
    assert(p.has_flag("--json"))
    assert_eq(p.flag_values_of("--tag").len(), 2)
    assert(p.has_flag("--group"))
    assert_eq(p.flag_value("--group"), "")
}

test "unknown flags and missing values are usage errors" {
    bad := parse_cli_args(["host", "list", "--nope"])
    assert_eq(error_code_of("{bad.error().message()}"), "usage")
    missing := parse_cli_args(["host", "add", "--hostname"])
    assert_eq(error_code_of("{missing.error().message()}"), "usage")
    valued := parse_cli_args(["--json=1"])
    assert_eq(error_code_of("{valued.error().message()}"), "usage")
}

// "30" -> 30 seconds, 1-86400.
fn parse_seconds_flag(name: str, text: str) -> i64! {
    n := str.parse_i64(text) or {
        return error(coded(ERR_INVALID, "{name} must be a number of seconds, 1-86400"))
    }
    if n < 1 || n > 86400 {
        return error(coded(ERR_INVALID, "{name} must be a number of seconds, 1-86400"))
    }
    return n
}

test "everything after -- is kept apart, flags included" {
    p := try parse_cli_args(["exec", "web", "--timeout", "5", "--", "ls", "--json", "-la", "--"])
    assert_eq(p.positionals.len(), 2)
    assert_eq(p.flag_value("--timeout"), "5")
    assert(!p.has_flag("--json"))
    assert(p.has_rest)
    assert_eq(p.rest.len(), 4)
    assert_eq(p.rest[1], "--json")
    assert_eq(p.rest[3], "--")
}

test "seconds parse within 1-86400" {
    assert_eq(try parse_seconds_flag("--timeout", "15"), 15)
    assert(!parse_seconds_flag("--timeout", "0").has_value())
    assert(!parse_seconds_flag("--timeout", "86401").has_value())
    assert(!parse_seconds_flag("--timeout", "1s").has_value())
}

test "ports parse strictly" {
    assert_eq(try parse_port_flag("2222"), 2222)
    assert(!parse_port_flag("22a").has_value())
    assert(!parse_port_flag("").has_value())
    assert(!parse_port_flag("-1").has_value())
}
