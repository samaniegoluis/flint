package clicmd

// `flint token create|list|revoke` (milestone 12b, D-046). A token lets a program
// that is not a child of an approved terminal (cron, launchd, a CI runner) use the
// vault the running Flint holds, within a scope, until it expires or is revoked. The
// program passes it in FLINT_TOKEN, never as an argument (it would show in `ps`).
//
// `create` runs only in Flint, which asks the owner to approve it, one by one and
// with presence, every time: a grant never covers it, and neither does a token. The
// token's text is printed once, alone on stdout, so `$(flint token create …)` holds
// it; everything else goes to stderr (Principle 7). `list` and `revoke` also work
// with the master password typed for one command.

import "core:str"
import "core:time"
import "ext:json"
import "../../adapters/config"
import "../../adapters/crypto"
import "../../adapters/keychain"
import "../../adapters/vault"
import "../../application"
import "../../domain"

// "--hosts codebox,@homelab": aliases, and group paths after '@'.
fn token_scope_from_flags(p: ParsedArgs) -> ScopeByName {
    mut s := ScopeByName{ all: p.has_flag("--all"), groups: [], hosts: [] }
    for v in p.flag_values_of("--hosts") {
        for part in str.split(v, ",") {
            item := str.trim(part)
            if item.starts_with("@") {
                if item.len() > 1 {
                    s.groups.push(item.substr(1))
                }
            } else if item.len() > 0 {
                s.hosts.push(item)
            }
        }
    }
    return s
}

fn token_request_from_flags(p: ParsedArgs) -> TokenRequest! {
    mut req := TokenRequest{ name: p.flag_value("--name"), scope: token_scope_from_flags(p), read: false, exec: false, write: false, ttl: TOKEN_DEFAULT_TTL }
    if p.has_flag("--ttl") {
        req.ttl = p.flag_value("--ttl")
    }
    if !p.has_flag("--allow") {
        return error(coded(ERR_USAGE, "say what the token allows: --allow read,exec,write"))
    }
    for v in p.flag_values_of("--allow") {
        for part in str.split(v, ",") {
            a := str.trim(part)
            if a == ACCESS_READ {
                req.read = true
            } else if a == ACCESS_EXEC {
                req.exec = true
            } else if a == ACCESS_WRITE {
                req.write = true
            } else if a.len() > 0 {
                return error(coded(ERR_USAGE, "--allow takes read, exec and write, not '{a}'"))
            }
        }
    }
    if req.scope.all && (req.scope.hosts.len() > 0 || req.scope.groups.len() > 0) {
        return error(coded(ERR_USAGE, "--all and --hosts do not go together"))
    }
    return req
}

// The words `token create` sends to the window's approval, without the name's value
// being anything but what the owner reads.
fn token_allows_text(read: bool, exec: bool, write: bool) -> str {
    mut parts: []str = []
    if read {
        parts.push(ACCESS_READ)
    }
    if exec {
        parts.push(ACCESS_EXEC)
    }
    if write {
        parts.push(ACCESS_WRITE)
    }
    return str.join(parts, ",")
}

fn token_reach_text(all: bool, groups: []str, hosts: []str) -> str {
    if all {
        return "whole vault"
    }
    mut parts: []str = []
    for h in hosts {
        parts.push(h)
    }
    for g in groups {
        parts.push("@" + g)
    }
    return str.join(parts, ", ")
}

fn two_digits(n: i64) -> str {
    if n < 10 {
        return "0{n}"
    }
    return "{n}"
}

// Unix seconds as "2026-11-08 10:00 UTC" (days to a civil date: H. Hinnant's
// algorithm; core:time has no formatter, CF-095).
fn utc_text(secs: i64) -> str {
    days := secs / 86400
    rem := secs - days * 86400
    z := days + 719468
    era := z / 146097
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    mut y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    mut m := mp + 3
    if mp >= 10 {
        m = mp - 9
    }
    if m <= 2 {
        y = y + 1
    }
    return "{y}-{two_digits(m)}-{two_digits(d)} {two_digits(rem / 3600)}:{two_digits((rem % 3600) / 60)} UTC"
}

fn print_token_list(list: []TokenView) {
    if list.len() == 0 {
        say("No tokens. Create one with `flint token create`.")
        return
    }
    mut rows: [][]str = []
    for t in list {
        mut when := utc_text(t.expires_at)
        if t.revoked_at > 0 {
            when = utc_text(t.revoked_at)
        }
        rows.push([t.id, t.name, token_allows_text(t.read, t.exec, t.write), token_reach_text(t.all, t.groups, t.hosts), t.status, when])
    }
    print_table(["ID", "NAME", "ALLOWS", "REACHES", "STATUS", "UNTIL"], rows)
}

fn cmd_token(p: ParsedArgs, sec: SecretInput, as_json: bool, c: Sodium, mut store: LockedVaultStore, src: VaultSource, recents: JsonRecentStore) -> void! {
    verb := p.positional(1)
    tokens := store
    if verb == "create" {
        try p.allow_flags("token create", ["--name", "--hosts", "--all", "--allow", "--ttl"])
        try p.expect_args("token create", 0, "")
        req := try token_request_from_flags(p)
        if !src.served {
            return error(coded(ERR_LOCKED, "`flint token create` runs in Flint, which asks you to approve it: open Flint, unlock this vault and run it again"))
        }
        _ := try open_target(p, sec, c, mut store, src, recents)
        mut ts := tokens
        made := try create_token(c, store, mut ts, req, time.unix_seconds())
        if as_json {
            say(json.stringify(made))
            return
        }
        t := made.token
        write_stderr("Created token '{t.name}' ({token_allows_text(t.read, t.exec, t.write)} on {token_reach_text(t.all, t.groups, t.hosts)}), until {utc_text(t.expires_at)}.\n")
        write_stderr("Flint shows it this once. Give it to the program as FLINT_TOKEN:\n")
        say(made.secret)
        return
    }
    if verb == "list" {
        try p.allow_flags("token list", [])
        try p.expect_args("token list", 0, "")
        _ := try open_target(p, sec, c, mut store, src, recents)
        list := try list_tokens(store, tokens, time.unix_seconds())
        if as_json {
            say(json.stringify(list))
        } else {
            print_token_list(list)
        }
        return
    }
    if verb == "revoke" {
        try p.allow_flags("token revoke", [])
        try p.expect_args("token revoke", 1, "<id|name>")
        _ := try open_target(p, sec, c, mut store, src, recents)
        mut ts := tokens
        t := try revoke_token(store, mut ts, p.positional(2), time.unix_seconds())
        if as_json {
            say(json.stringify(t))
        } else {
            say("Revoked token '{t.name}' ({t.id}). A program that uses it is refused from now on.")
        }
        return
    }
    return error(coded(ERR_USAGE, "unknown command `flint token {verb}`; see `flint help`"))
}

test "token scope flags" {
    p := try parse_cli_args(["token", "create", "--name", "n", "--hosts", "codebox, @homelab/pve", "--hosts", "web", "--allow", "exec,read"])
    s := token_scope_from_flags(p)
    assert_eq(s.hosts.len(), 2)
    assert_eq(s.hosts[1], "web")
    assert_eq(s.groups[0], "homelab/pve")
    req := try token_request_from_flags(p)
    assert(req.read && req.exec && !req.write)
    assert_eq(req.ttl, TOKEN_DEFAULT_TTL)
    bad := try parse_cli_args(["token", "create", "--name", "n", "--allow", "sudo"])
    assert(!token_request_from_flags(bad).has_value())
    both := try parse_cli_args(["token", "create", "--name", "n", "--all", "--hosts", "x", "--allow", "read"])
    assert(!token_request_from_flags(both).has_value())
}

test "utc dates" {
    assert_eq(utc_text(0), "1970-01-01 00:00 UTC")
    assert_eq(utc_text(951782400), "2000-02-29 00:00 UTC")
    assert_eq(utc_text(1794132000), "2026-11-08 10:00 UTC")
    assert_eq(utc_text(1798761599), "2026-12-31 23:59 UTC")
}
