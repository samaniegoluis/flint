package clicmd

// `flint connect`, `flint exec` and `flint known-host`. Each handler parses its
// flags, calls one use case and formats the result (Principle 2). `connect` and
// `exec` return the remote exit status, which becomes Flint's own (as with ssh).

import "core:os"
import "core:json"
import "../../adapters/config"
import "../../adapters/crypto"
import "../../adapters/keychain"
import "../../adapters/process"
import "../../adapters/ssh"
import "../../adapters/vault"
import "../../application"
import "../../domain"

type SessionEnd struct {
    host:      str `json:"host"`
    exit_code: i64 `json:"exit_code"`
}

type ForgottenKey struct {
    removed:     str `json:"removed"`
    addr:        str `json:"addr"`
    fingerprint: str `json:"fingerprint"`
}

fn connect_options(p: ParsedArgs) -> ConnectOptions! {
    mut opts := default_connect_options()
    if p.has_flag("--timeout") {
        opts.timeout_secs = try parse_seconds_flag("--timeout", p.flag_value("--timeout"))
    }
    opts.accept_new_host_key = p.has_flag("--accept-new-host-key")
    opts.run_initial_command = !p.has_flag("--no-command")
    return opts
}

// A remote exit status as a process exit code: 0-255 as is, a signal as 255.
fn process_exit_code(code: i64) -> i32 {
    if code < 0 || code > 255 {
        return 255
    }
    return i32(code)
}

// The remote command: the words after `--`, joined by spaces, as ssh does. The
// remote shell parses it.
fn remote_command(p: ParsedArgs) -> str {
    mut cmd := ""
    for i, w in p.rest {
        if i > 0 {
            cmd = cmd + " "
        }
        cmd = cmd + w
    }
    return cmd
}

// The terminal, prompter and output of a session command: the process's own stdio
// for the CLI on its own, the client's connection when the app runs it (D-042).
fn cmd_connect[M: Terminal, P: Prompter](p: ParsedArgs, sec: SecretInput, as_json: bool, c: Sodium, mut store: LockedVaultStore, src: VaultSource, recents: JsonRecentStore, mut term: M, prompter: P, term_name: str) -> i32! {
    try p.allow_flags("connect", ["--timeout", "--accept-new-host-key", "--no-command"])
    if p.positionals.len() != 2 || p.has_rest {
        return error(coded(ERR_USAGE, "usage: flint connect <alias> [--timeout <secs>] [--accept-new-host-key] [--no-command]"))
    }
    opts := try connect_options(p)
    alias := p.positional(1)
    s := try open_target(p, sec, c, mut store, src, recents)
    // Served by the app, an RDP host's connect opened its tab before this ran
    // (desktop_opened_frame); here no app serves the vault.
    if try opens_remote_desktop(store, alias) {
        return error(desktop_needs_app(alias))
    }
    mut link := new_ssh_link()
    mut clock := new_system_clock()
    code := try connect_host(c, mut store, s, mut link, prompter, mut term, mut clock, alias, term_name, opts)
    if as_json {
        say(json.stringify(SessionEnd{ host: alias, exit_code: code }))
    }
    return process_exit_code(code)
}

fn cmd_exec[P: Prompter, O: ExecSink](p: ParsedArgs, sec: SecretInput, as_json: bool, c: Sodium, mut store: LockedVaultStore, src: VaultSource, recents: JsonRecentStore, prompter: P, mut sink: O) -> i32! {
    try p.allow_flags("exec", ["--timeout", "--exec-timeout", "--accept-new-host-key", "--sudo"])
    if p.positionals.len() != 2 || !p.has_rest || p.rest.len() == 0 {
        return error(coded(ERR_USAGE, "usage: flint exec <alias> [--timeout <secs>] [--exec-timeout <secs>] [--sudo] -- <command>"))
    }
    // D-039: only the running Flint runs a command as root, after the owner allowed
    // it in its window; never on a typed master password.
    if p.has_flag("--sudo") && !sec.in_app {
        return error(coded(ERR_LOCKED, "`flint exec --sudo` runs only through Flint: open Flint, unlock this vault there, and run it again"))
    }
    opts := try connect_options(p)
    mut exec_timeout := SSH_EXEC_TIMEOUT_SECS
    if p.has_flag("--exec-timeout") {
        exec_timeout = try parse_seconds_flag("--exec-timeout", p.flag_value("--exec-timeout"))
    }
    s := try open_target(p, sec, c, mut store, src, recents)
    mut link := new_ssh_link()
    mut clock := new_system_clock()
    mut res := ExecResult{ host: "", exit_code: 0, signal: "", stdout: "", stderr: "", duration_ms: 0 }
    if p.has_flag("--sudo") {
        res = try exec_sudo_on_host(c, mut store, s, mut link, prompter, mut sink, mut clock, p.positional(1), p.rest, sec.sudo_typed, opts, exec_timeout, as_json)
    } else {
        res = try exec_on_host(c, mut store, s, mut link, prompter, mut sink, mut clock, p.positional(1), remote_command(p), opts, exec_timeout, as_json)
    }
    if as_json {
        say(json.stringify(res))
    }
    return process_exit_code(res.exit_code)
}

// `flint host test <alias>`: connect, verify, log in, hang up. Exits 0, or with the
// error's code (11-14 for host_key, auth, network, timeout).
fn cmd_host_test[P: Prompter](p: ParsedArgs, sec: SecretInput, as_json: bool, c: Sodium, mut store: LockedVaultStore, src: VaultSource, recents: JsonRecentStore, prompter: P) -> void! {
    try p.allow_flags("host test", ["--timeout", "--accept-new-host-key"])
    try p.expect_args("host test", 1, "<alias> [--timeout <secs>] [--accept-new-host-key]")
    if p.has_rest {
        return error(coded(ERR_USAGE, "`flint host test` runs no command; use `flint exec <alias> -- <command>`"))
    }
    opts := try connect_options(p)
    s := try open_target(p, sec, c, mut store, src, recents)
    mut link := new_ssh_link()
    mut clock := new_system_clock()
    r := try test_host(c, mut store, s, mut link, prompter, mut clock, p.positional(2), opts)
    if as_json {
        say(json.stringify(r))
        return
    }
    mut via := ""
    if r.hops == 2 {
        via = ", through 1 jump host"
    } else if r.hops > 2 {
        via = ", through {r.hops - 1} jump hosts"
    }
    say("Connection to '{r.host}' works: {r.target}, host key verified, logged in ({r.duration_ms} ms{via}).")
}

fn cmd_known_host(p: ParsedArgs, sec: SecretInput, as_json: bool, c: Sodium, mut store: LockedVaultStore, src: VaultSource, recents: JsonRecentStore) -> void! {
    verb := p.positional(1)
    if verb == "list" {
        try p.allow_flags("known-host list", [])
        try p.expect_args("known-host list", 0, "")
        _ := try open_target(p, sec, c, mut store, src, recents)
        list := try list_known_hosts(store)
        if as_json {
            say(json.stringify(list))
        } else {
            print_known_hosts(list)
        }
        return
    }
    if verb == "rm" {
        try p.allow_flags("known-host rm", [])
        try p.expect_args("known-host rm", 1, "<alias|address>")
        _ := try open_target(p, sec, c, mut store, src, recents)
        k := try remove_known_host(mut store, p.positional(2))
        if as_json {
            say(json.stringify(ForgottenKey{ removed: "known-host", addr: k.addr, fingerprint: k.fingerprint }))
        } else {
            say("Forgot the host key of {k.addr} ({k.key_type} {k.fingerprint}). The next connect will ask again.")
        }
        return
    }
    return error(coded(ERR_USAGE, "unknown command `flint known-host {verb}`; see `flint help`"))
}

// `flint connect <rdp-host>` served by the app (milestone 30): the app opened the
// host's remote desktop tab, and the CLI says so and exits 0.
type DesktopOpened struct {
    host:      str  `json:"host"`
    host_type: str  `json:"type"`
    opened:    bool `json:"opened"`
}

fn desktop_opened_text(alias: str, as_json: bool) -> str {
    if as_json {
        return json.stringify(DesktopOpened{ host: alias, host_type: HOST_TYPE_RDP, opened: true }) + "\n"
    }
    return "Opened {alias} in Flint (remote desktop).\n"
}
