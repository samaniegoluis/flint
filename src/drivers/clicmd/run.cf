package clicmd

// Dispatch of a `flint` command line to its handler, shared by the CLI (on its own,
// or as a client of the running app) and by the app, which runs the same handlers
// for a command the CLI sends over the socket (serve.cf). One code path, so a
// command prints the same and exits the same either way (Principle 7).

import "core:os"
import "../../adapters/config"
import "../../adapters/crypto"
import "../../adapters/keychain"
import "../../adapters/process"
import "../../adapters/ssh"
import "../../adapters/vault"
import "../../domain"
import "../../ports"

fn usage_text() -> str {
    return `flint - SSH client over one encrypted vault

Usage: flint [--json] [--vault <name|path>] <command> [args] [flags]

Vaults
  vault create <path> [--name <name>]   Create a vault (asks for a master password)
  vault open <path>                     Open an existing vault and make it current
  vault list                            Recent vaults; * marks the current one
  vault use <name|path>                 Make a recent vault the current one
  vault status                          Path, lock state and counts
  vault unlock                          Ask Flint to unlock the vault, and wait
  vault lock                            Lock the vault in Flint; remove any cached key
  vault rename <new-name>               Rename the vault (its file is not moved)
  vault forget <name|path>              Drop a vault from the recent list

Groups
  group add <path>                      Create a group, e.g. homelab/proxmox
  group list | group rename <path> <new-name> | group rm <path>

Hosts
  host add <alias> --hostname <host> [--port N] [--user U] [--label L]
           [--group <path>] [--tag T]... [--color #rrggbb] [--notes N]
           [--jump <alias>] [--cred <name>] [--key <name>]
           [--password | --password-stdin] [--command <cmd> [--no-keep-shell]]
           [--sudo-password | --sudo-password-stdin]
                                        --command runs on connect, then a login
                                        shell (--no-keep-shell: ends the session);
                                        the sudo password defaults to the login one
  host edit <alias> [same flags] [--alias <new>] [--no-tags] [--no-password]
           [--no-sudo-password] [--command ""] [--keep-shell]
  host list [--group <path>] [--tag <tag>] | host show <alias> | host rm <alias>
  host test <alias> [--timeout <secs>] [--accept-new-host-key]
                                        Connect, verify the host key, log in, hang up

Keys
  key add <name> (--file <path> | --key-stdin) [--passphrase | --passphrase-stdin]
  key list | key show <name> | key rename <name> <new-name> | key rm <name>

Credentials
  cred add <name> --user <user> [--key <name>] [--password | --password-stdin]
  cred edit <name> [--name N] [--user U] [--key K] [--password | --password-stdin | --no-password]
  cred list | cred show <name> | cred rm <name>

SSH
  connect <alias> [--timeout <secs>] [--accept-new-host-key] [--no-command]
                                        Interactive shell, through jump hosts; runs
                                        the host's --command unless --no-command
  exec <alias> [--timeout <secs>] [--exec-timeout <secs>] [--accept-new-host-key]
       -- <command>                     Run one command; exits with its status
  exec <alias> --sudo -- <command> [args]
                                        Run it as root: Flint asks you in its window
                                        for each one and types the sudo password
                                        itself (needs Flint open)
  known-host list | known-host rm <alias|address>

Files
  cp [-r] [--force] <local path> <alias>:<path>
                                        Copy to the host (into <path> when it is a
                                        folder); -r for a folder
  cp [-r] [--force] <alias>:<path> <local path>
                                        Copy from the host; an existing file needs
                                        --force. <alias>: alone is the login folder
  cp [-r] [--force] <alias>:<path> <alias>:<path>
                                        Copy from one host to another, through this
                                        machine (no key or password goes to a host)

Tunnels (local forwards saved in a host; they run in Flint)
  tunnel add <host> <name> --local <port> [--to <host:port>] [--open-on-connect]
                                        127.0.0.1:<port> here reaches <host:port> as
                                        the host sees it (default localhost:<port>)
  tunnel edit <host>:<name> [--name N] [--local P] [--to D]
              [--open-on-connect | --no-open-on-connect]
  tunnel ls [<host>] | tunnel rm <host>:<name>
  tunnel up <host>:<name> [--timeout <secs>] [--accept-new-host-key]
                                        Start it in Flint (needs Flint open); it
                                        keeps running after this command returns
  tunnel down <host>:<name> | tunnel status [<host>:<name>]

Tokens (for programs Flint cannot ask about: cron, launchd, CI on this machine)
  token create --name <name> --allow read,exec[,write] [--hosts <alias,@group,...> | --all]
               [--ttl 15m|1h|4h|1d|7d|30d|90d]
                                        Flint asks you to approve it; prints the
                                        token once (default --ttl 1d)
  token list | token revoke <id|name>

Import
  import tether <file> [--password-stdin] [--dry-run]
                                        Copy a Tether vault into this one (asks for
                                        Tether's master password); --dry-run reports only

Global flags
  --json            Write JSON to stdout (errors as JSON to stderr)
  --vault <v>       Use this vault instead of the current one
  --master-stdin    Read the master password from the first line of stdin
  --version, -V     Print the version and linked libraries

With Flint open and the vault unlocked there, commands run through it and need no
master password, once you allow the program that runs flint in Flint's window, or
it passes a token in FLINT_TOKEN.
Otherwise flint asks for it on the terminal (or --master-stdin), for that one
command; with no terminal, Flint is asked to unlock the vault.

Secrets are never taken from arguments: Flint prompts on the terminal, or reads
them from stdin with the --*-stdin flags.
`
}

// Checks the command line's shape: a known noun and a verb or alias after it.
fn check_command(p: ParsedArgs) -> void! {
    noun := p.positional(0)
    session_noun := noun == "connect" || noun == "exec" || noun == "cp"
    if !session_noun && noun != "vault" && noun != "group" && noun != "host" && noun != "key" && noun != "cred" && noun != "known-host" && noun != "import" && noun != "token" && noun != "tunnel" {
        return error(coded(ERR_USAGE, "unknown command '{noun}'; see `flint help`"))
    }
    if p.positional(1).len() == 0 {
        if noun == "cp" {
            return error(cp_usage())
        }
        if session_noun {
            return error(coded(ERR_USAGE, "`flint {noun}` needs a host alias; see `flint help`"))
        }
        return error(coded(ERR_USAGE, "`flint {noun}` needs a command; see `flint help`"))
    }
}

fn wants_help(p: ParsedArgs) -> bool {
    noun := p.positional(0)
    return noun.len() == 0 || noun == "help" || p.has_flag("--help") || p.has_flag("-h")
}

// The commands that open an SSH session: they need a terminal, a prompter and an
// output stream, which the app relays over the socket (D-042), and for `cp` this
// machine's files, which the CLI reads and writes for the app (milestone 16).
fn is_session_command(p: ParsedArgs) -> bool {
    noun := p.positional(0)
    return noun == "connect" || noun == "exec" || noun == "cp" || (noun == "host" && p.positional(1) == "test") || is_tunnel_session(p)
}

// Runs one checked session command against `src`'s vault, on the given terminal,
// prompter and output. Returns the process exit status: 0, or the remote status of
// `connect` and `exec`.
fn run_session_command[M: Terminal, P: Prompter, O: ExecSink, L: LocalFiles, K: TransferSink](p: ParsedArgs, sec: SecretInput, as_json: bool, c: Sodium, mut store: LockedVaultStore, src: VaultSource, recents: JsonRecentStore, mut term: M, prompter: P, mut sink: O, mut local: L, mut progress: K, term_name: str) -> i32! {
    noun := p.positional(0)
    if noun == "cp" {
        return cmd_cp(p, sec, as_json, c, mut store, src, recents, prompter, mut local, mut progress)
    }
    if noun == "tunnel" {
        try cmd_tunnel_session(p, sec, as_json, c, mut store, src, recents, prompter)
        return 0
    }
    if noun == "connect" {
        return cmd_connect(p, sec, as_json, c, mut store, src, recents, mut term, prompter, term_name)
    }
    if noun == "exec" {
        return cmd_exec(p, sec, as_json, c, mut store, src, recents, prompter, mut sink)
    }
    try cmd_host_test(p, sec, as_json, c, mut store, src, recents, prompter)
    return 0
}

// Runs one checked command that opens no SSH session against `src`'s vault.
// Returns the process exit status, 0.
fn run_command(p: ParsedArgs, sec: SecretInput, as_json: bool, c: Sodium, mut store: LockedVaultStore, src: VaultSource, recents: JsonRecentStore) -> i32! {
    noun := p.positional(0)
    if noun == "vault" {
        try cmd_vault(p, sec, as_json, c, mut store, src, recents)
    } else if noun == "group" {
        try cmd_group(p, sec, as_json, c, mut store, src, recents)
    } else if noun == "host" {
        try cmd_host(p, sec, as_json, c, mut store, src, recents)
    } else if noun == "key" {
        try cmd_key(p, sec, as_json, c, mut store, src, recents, new_libssh_key_inspector())
    } else if noun == "import" {
        try cmd_import(p, sec, as_json, c, mut store, src, recents, new_libssh_key_inspector())
    } else if noun == "known-host" {
        try cmd_known_host(p, sec, as_json, c, mut store, src, recents)
    } else if noun == "token" {
        try cmd_token(p, sec, as_json, c, mut store, src, recents)
    } else if noun == "tunnel" {
        try cmd_tunnel(p, sec, as_json, c, mut store, src, recents)
    } else {
        try cmd_cred(p, sec, as_json, c, mut store, src, recents)
    }
    return 0
}

// Runs a command in this process, on the vault file itself, with the master
// password typed for it (the terminal, or --master-stdin). The CLI never reads a key
// from the OS keychain (D-038, Principle 11): the keychain is reached only to remove
// a cached key (`vault lock`, `vault forget`).
fn run_local(p: ParsedArgs, sec: SecretInput, as_json: bool) -> i32! {
    c := try new_sodium()
    mut store := new_locked_vault_store()
    verb := p.positional(1)
    removes_key := p.positional(0) == "vault" && (verb == "lock" || verb == "forget")
    kc := new_os_keychain(removes_key && os.getenv("FLINT_KEYCHAIN") != "off")
    recents := new_json_recent_store(flint_config_dir())
    mut status: i32! = 0
    if is_session_command(p) {
        mut term_name := os.getenv("TERM")
        if term_name.len() == 0 {
            term_name = "xterm-256color"
        }
        mut term := new_stdio_terminal()
        mut sink := new_stdio_exec_sink()
        mut local := new_local_fs()
        mut progress := new_stderr_transfer_sink(as_json)
        status = run_session_command(p, sec, as_json, c, mut store, local_vault_source(kc), recents, mut term, new_tty_prompter(), mut sink, mut local, mut progress, term_name)
    } else {
        status = run_command(p, sec, as_json, c, mut store, local_vault_source(kc), recents)
    }
    store.vault_detach()
    return status
}

// The whole CLI: help, then the running app if it holds this command's vault
// unlocked (serve.cf), else the command in this process with a typed master
// password. With nobody to type it, Flint is asked to unlock and the command fails
// with `locked`.
fn run_cli(p: ParsedArgs, args: []str, as_json: bool) -> i32! {
    if wants_help(p) {
        write_stdout(usage_text())
        return 0
    }
    try check_command(p)
    noun := p.positional(0)
    verb := p.positional(1)
    if noun == "vault" && verb == "unlock" {
        try cmd_vault_unlock_app(p, as_json)
        return 0
    }
    mut sec := try read_stdin_secrets(p)
    if noun == "vault" && verb == "lock" {
        recents := new_json_recent_store(flint_config_dir())
        target := try resolve_vault(recents, vault_selector(p))
        _ := lock_in_app(target)
    }
    // Twice at most: a second time once Flint, asked to unlock, says it has.
    for attempt in 0..2 {
        if servable(p) {
            reply := try ask_app(p, args, as_json, mut sec)
            if reply.served {
                write_stdout(reply.stdout)
                write_stderr(reply.stderr)
                return i32(reply.exit)
            }
        } else if is_session_command(p) {
            reply := try ask_app_session(p, args, as_json, sec)
            if reply.served {
                write_stdout(reply.stdout)
                write_stderr(reply.stderr)
                return i32(reply.exit)
            }
        }
        // Usage errors and everything else come out of the command itself; only a
        // vault left locked with nobody to type its password turns to Flint.
        code := run_local(p, sec, as_json) or err {
            msg := "{err.message()}"
            if attempt == 1 || sec.has_master || has_terminal() || !needs_unlocked_vault(p) || error_code_of(msg) != ERR_LOCKED {
                return error(msg)
            }
            recents := new_json_recent_store(flint_config_dir())
            target := try resolve_vault(recents, vault_selector(p))
            st := request_unlock(target, p)
            if st.state != APP_UNLOCKED {
                return error(locked_error(target, st))
            }
            continue
        }
        return code
    }
    return run_local(p, sec, as_json)
}
