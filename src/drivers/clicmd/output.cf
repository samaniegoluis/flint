package clicmd

// Output formatting: data to stdout, diagnostics to stderr (Principle 7). Views come
// from the application layer and carry no secret values (Principle 6).

import "core:json"
import "../../adapters/process"
import "../../application"
import "../../domain"

type ErrorBody struct {
    code:    str `json:"code"`
    message: str `json:"message"`
}

type ErrorEnvelope struct {
    err_body: ErrorBody `json:"error"`
}

// A message the core names (milestone 69, D-084): its id and params beside the code
// and the English text the CLI prints.
type ErrorBodyWithId struct {
    code:    str   `json:"code"`
    message: str   `json:"message"`
    id:      str   `json:"id"`
    params:  []str `json:"params"`
}

type ErrorEnvelopeWithId struct {
    err_body: ErrorBodyWithId `json:"error"`
}

// The JSON for an error on stderr: `id` and `params` only when the core names it.
fn error_json(msg: str) -> str {
    m := core_message_of(msg)
    if m.id.len() == 0 {
        return json.stringify(ErrorEnvelope{ err_body: ErrorBody{ code: m.code, message: m.message } })
    }
    return json.stringify(ErrorEnvelopeWithId{ err_body: ErrorBodyWithId{ code: m.code, message: m.message, id: m.id, params: m.params } })
}

type RemovedNote struct {
    removed: str `json:"removed"`
    name:    str `json:"name"`
}

fn say(line: str) {
    write_stdout(line + "\n")
}

// Prints an error to stderr and returns its stable exit code.
fn report_error(msg: str, as_json: bool) -> i32 {
    code := error_code_of(msg)
    text := error_text_of(msg)
    if as_json {
        write_stderr(error_json(msg) + "\n")
    } else {
        write_stderr("flint: " + text + "\n")
    }
    return exit_code_for(code)
}

// Prints an error and ends the process with its stable exit code.
fn fail_with(msg: str, as_json: bool) {
    exit_process(report_error(msg, as_json))
}

fn pad_right(s: str, width: usize) -> str {
    mut res := s
    for res.len() < width {
        res = res + " "
    }
    return res
}

// Prints rows as left-aligned columns, two spaces apart.
fn print_table(headers: []str, rows: [][]str) {
    mut widths: []usize = []
    for h in headers {
        widths.push(h.len())
    }
    for r in rows {
        for i, cell in r {
            if cell.len() > widths[i] {
                widths[i] = cell.len()
            }
        }
    }
    mut head := ""
    for i, h in headers {
        if i + 1 == headers.len() {
            head = head + h
        } else {
            head = head + pad_right(h, widths[i] + 2)
        }
    }
    say(head)
    for r in rows {
        mut line := ""
        for i, cell in r {
            if i + 1 == r.len() {
                line = line + cell
            } else {
                line = line + pad_right(cell, widths[i] + 2)
            }
        }
        say(line)
    }
}

fn print_fields(names: []str, values: []str) {
    mut width: usize = 0
    for n in names {
        if n.len() > width {
            width = n.len()
        }
    }
    for i, n in names {
        say(pad_right(n, width + 2) + values[i])
    }
}

fn dash_if_empty(s: str) -> str {
    if s.len() == 0 {
        return "-"
    }
    return s
}

fn yes_no(b: bool) -> str {
    if b {
        return "yes"
    }
    return "no"
}

fn join_tags(tags: []str) -> str {
    mut s := ""
    for i, t in tags {
        if i > 0 {
            s = s + ", "
        }
        s = s + t
    }
    return s
}

// "host:port", or the user@host:port target M03 will connect to.
fn host_target(h: application.HostView) -> str {
    mut t := h.hostname
    mut user := h.user
    if h.domain.len() > 0 && user.len() > 0 {
        user = h.domain + "\\" + user
    }
    if user.len() > 0 {
        t = user + "@" + t
    }
    if h.port != default_port_for(h.host_type) {
        t = t + ":{h.port}"
    }
    return t
}

// "herdr (then a login shell)", "herdr (ends the session)" or "-".
fn command_text(h: application.HostView) -> str {
    if h.command.len() == 0 {
        return "-"
    }
    if h.keep_shell {
        return h.command + " (then a login shell)"
    }
    return h.command + " (ends the session)"
}

// An RDP host's audio in words (milestone 60).
fn audio_text(audio: str) -> str {
    if audio == RDP_AUDIO_REMOTE {
        return "on the remote computer"
    }
    if audio == RDP_AUDIO_OFF {
        return "off"
    }
    return "on this computer"
}

fn print_host(h: application.HostView) {
    mut pw := "not set"
    if h.has_password {
        pw = "set"
    }
    mut sudo_pw := "the login password"
    if h.has_sudo_password {
        sudo_pw = "set"
    }
    if h.host_type == HOST_TYPE_RDP {
        mut mic := "off"
        if h.microphone {
            mic = "on"
        }
        print_fields(["alias", "type", "label", "hostname", "port", "user", "domain", "group", "tags", "color", "credential", "password", "audio", "microphone", "notes"],
            [h.alias, h.host_type, dash_if_empty(h.label), h.hostname, "{h.port}", dash_if_empty(h.user), dash_if_empty(h.domain), dash_if_empty(h.group), dash_if_empty(join_tags(h.tags)), dash_if_empty(h.color), dash_if_empty(h.credential), pw, audio_text(h.audio), mic, dash_if_empty(h.notes)])
        return
    }
    print_fields(["alias", "type", "label", "hostname", "port", "user", "group", "tags", "color", "jump", "credential", "key", "password", "sudo password", "command", "notes"],
        [h.alias, h.host_type, dash_if_empty(h.label), h.hostname, "{h.port}", dash_if_empty(h.user), dash_if_empty(h.group), dash_if_empty(join_tags(h.tags)), dash_if_empty(h.color), dash_if_empty(h.jump), dash_if_empty(h.credential), dash_if_empty(h.key), pw, sudo_pw, command_text(h), dash_if_empty(h.notes)])
}

fn print_host_list(hosts: []application.HostView) {
    if hosts.len() == 0 {
        say("No hosts.")
        return
    }
    mut rows: [][]str = []
    for h in hosts {
        rows.push([h.alias, h.host_type, host_target(h), dash_if_empty(h.group), dash_if_empty(join_tags(h.tags))])
    }
    print_table(["ALIAS", "TYPE", "TARGET", "GROUP", "TAGS"], rows)
}

fn print_key(k: application.KeyView) {
    print_fields(["name", "type", "fingerprint", "passphrase", "public key"], [k.name, k.key_type, k.fingerprint, yes_no(k.has_passphrase), k.public_key])
}

fn print_key_list(keys: []application.KeyView) {
    if keys.len() == 0 {
        say("No keys.")
        return
    }
    mut rows: [][]str = []
    for k in keys {
        rows.push([k.name, k.key_type, k.fingerprint, yes_no(k.has_passphrase)])
    }
    print_table(["NAME", "TYPE", "FINGERPRINT", "PASSPHRASE"], rows)
}

fn print_cred(c: application.CredView) {
    mut pw := "not set"
    if c.has_password {
        pw = "set"
    }
    print_fields(["name", "user", "key", "password"], [c.name, c.user, dash_if_empty(c.key), pw])
}

fn print_cred_list(creds: []application.CredView) {
    if creds.len() == 0 {
        say("No credentials.")
        return
    }
    mut rows: [][]str = []
    for c in creds {
        rows.push([c.name, c.user, dash_if_empty(c.key), yes_no(c.has_password)])
    }
    print_table(["NAME", "USER", "KEY", "PASSWORD"], rows)
}

fn print_group_list(groups: []application.GroupView) {
    if groups.len() == 0 {
        say("No groups.")
        return
    }
    mut rows: [][]str = []
    for g in groups {
        rows.push([g.path, "{g.hosts}", "{g.subgroups}"])
    }
    print_table(["GROUP", "HOSTS", "SUBGROUPS"], rows)
}

fn print_vault_info(verb: str, v: application.VaultInfo) {
    say("{verb} vault '{v.name}' at {v.path}")
    say("Commands use it through Flint once it is unlocked there, or with --master-stdin.")
}

fn print_status(st: application.VaultStatus) {
    if !st.exists {
        print_fields(["vault", "path", "state"], [st.name, st.path, "missing (no file at this path)"])
        return
    }
    (rnames, rvalues) := remote_status_fields(st.remote)
    if !st.unlocked {
        mut lf: []str = ["vault", "path", "state"]
        mut state := "locked (unlock it in Flint, or pass --master-stdin)"
        if st.lock_detail.len() > 0 {
            state = "locked ({st.lock_detail}); unlock it in Flint, or pass --master-stdin"
        }
        mut lv: []str = [st.name, st.path, state]
        for i, n in rnames {
            lf.push(n)
            lv.push(rvalues[i])
        }
        print_fields(lf, lv)
        return
    }
    mut fields: []str = ["vault", "path", "state", "groups", "hosts", "keys", "credentials"]
    mut values: []str = [st.name, st.path, "unlocked in Flint", "{st.groups}", "{st.hosts}", "{st.keys}", "{st.credentials}"]
    if st.activity_days >= 0 {
        // Set in Flint's Settings → Access only (D-052).
        fields.push("activity")
        if st.activity_days == 0 {
            values.push("kept with no time limit")
        } else {
            values.push("kept {retention_label(st.activity_days)}")
        }
    }
    for i, n in rnames {
        fields.push(n)
        values.push(rvalues[i])
    }
    print_fields(fields, values)
}

fn print_recents(list: []application.RecentView) {
    if list.len() == 0 {
        say("No vaults yet. Create one with `flint vault create <path>`.")
        return
    }
    mut rows: [][]str = []
    for v in list {
        mut mark := " "
        if v.current {
            mark = "*"
        }
        mut path := v.path
        if !v.exists {
            path = path + " (missing)"
        }
        rows.push([mark, v.name, path])
    }
    print_table(["", "NAME", "PATH"], rows)
}

fn print_known_hosts(list: []application.KnownHostView) {
    if list.len() == 0 {
        say("No known hosts yet. A host's key is recorded the first time you connect.")
        return
    }
    mut rows: [][]str = []
    for k in list {
        rows.push([k.addr, dash_if_empty(k.host), k.key_type, k.fingerprint, k.added_at])
    }
    print_table(["ADDRESS", "HOST", "TYPE", "FINGERPRINT", "ADDED"], rows)
}

fn plural(n: i64, one: str, many: str) -> str {
    if n == 1 {
        return "1 " + one
    }
    return "{n} " + many
}

// The kind of a merged record, as `vault merge` names it.
fn merge_kind_label(kind: str) -> str {
    if kind == "known_host" {
        return "known host"
    }
    return kind
}

// What `vault merge` did, one line per record, the vault's rules last.
fn print_merge(got: application.MergeOutcome) {
    r := got.report
    if r.added + r.updated + r.removed == 0 && r.notes.len() == 0 {
        say("Nothing to merge: vault '{got.name}' already has every change in {got.copy}.")
        return
    }
    say("Merged {got.copy} into vault '{got.name}': {r.added} added, {r.updated} updated, {r.removed} removed.")
    mut rows: [][]str = []
    for ch in r.changes {
        rows.push([ch.change, merge_kind_label(ch.kind), ch.name])
    }
    for ch in r.notes {
        rows.push([ch.change, merge_kind_label(ch.kind), "{ch.name} ({ch.detail})"])
    }
    print_table(["CHANGE", "KIND", "NAME"], rows)
    say("The copy was not changed; delete it once the vault looks right.")
}
