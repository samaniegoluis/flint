package build

import "core:build"

// The version, from git, written to src/drivers/version/version.cf before every build
// (milestone 32, D-077). No Outputs: cfire runs a command without them every time, and
// the script rewrites the file only when the version changed.
// CFIRE-UPSTREAM: CF-123 (core:build documents build.Step; the manifest reads build.Command)
Version := build.Command("sh", {
    Args: ["scripts/version.sh", "--write"],
})

// Native libraries, per executable (cfire 0.12 retired `@pkg` on `import cpp`).
// flint-* are Flint's own pkg-config files, one folder per OS (src/adapters/pkgconfig/<os>,
// put on PKG_CONFIG_PATH by scripts/env.sh), because build.cf takes literals only and has
// no per-OS fields: Linux needs libsecret-1 and gtk+-3.0, the Mac its frameworks.
// `cfire test` links the union of all three lists.
// CFIRE-UPSTREAM: CF-031

// The `flint` CLI.
Flint := build.Executable("flint", {
    Entry:     "src/drivers/cli/main.cf",
    Subsystem: "console",
    OutDir:    "build",
    MacosMin:  "13.3",
    PkgConfig: ["flint-native", "flint-remote", "libsodium", "libssh", "sqlcipher"],
})

// The desktop app. scripts/build-gui.sh builds the page (ui/) and copies it into the
// app bundle; `cfire build` alone produces the executable only. A release build
// (scripts/package.sh) links it and the CLI with `--portable` against the libraries of
// scripts/deps-macos.sh, at the same minimum macOS (D-112). It gets its own
// folder: macOS file systems ignore case, so build/Flint would overwrite build/flint.
FlintGui := build.Executable("Flint", {
    Entry:     "src/drivers/gui/main.cf",
    Subsystem: "gui",
    OutDir:    "build/gui",
    Icon:      "assets/app-icon/Flint.icns",
    // Milestone 79 (D-158 (1)): the owner's domain, named by form (the mobile app is
    // engineer.samaniego.flint.mobile), moved with the first signed version, which asks
    // for macOS's permissions again anyway. macOS keeps permissions and WebKit data per
    // id, so it does not change again. The CLI in Helpers is signed as `<id>.cli`.
    BundleId:  "engineer.samaniego.flint.desktop",
    MacosMin:  "13.3",
    PkgConfig: ["flint-native", "flint-native-gui", "flint-rdp", "flint-remote", "libsodium", "libssh", "sqlcipher"],
})

// The remote vault server (milestone 42, D-092): a third binary that links libsodium
// alone, never libssh, FreeRDP or SQLCipher. scripts/server-image.sh builds its image.
FlintVaultServer := build.Executable("flint-vault-server", {
    Entry:     "src/drivers/vault-server/main.cf",
    Subsystem: "console",
    OutDir:    "build",
    PkgConfig: ["flint-server-native", "libsodium"],
})

// The Linux self-update's root helper (milestone 54, D-124, Principle 17): run by the
// app through `pkexec`, shipped in the .deb and the .rpm at /usr/lib/flint. It links
// libsodium (the manifest's signature, the package's SHA-256) and its own shim, never
// libssh, FreeRDP, SQLCipher or the vault.
FlintUpdateRoot := build.Executable("flint-update-root", {
    Entry:     "src/drivers/update-root/main.cf",
    Subsystem: "console",
    OutDir:    "build",
    PkgConfig: ["flint-root-native", "libsodium"],
})

