---
// The header's link to Flint's repository: the GitHub mark and "GitHub" in a bordered
// button the height of the width and theme buttons. Below 50rem only the mark shows,
// unless `label` keeps the word (the mobile menu, which has the room).
import { Icon } from '@astrojs/starlight/components';
import { repoUrl } from '../repo';

const { label = false } = Astro.props as { label?: boolean };
---

<a class="flint-github" href={repoUrl} title="Flint on GitHub" data-label={label ? '' : undefined}>
	<Icon name="github" />
	<span class="label">GitHub</span>
</a>

<style>
	.flint-github {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 2.25rem;
		min-width: 2.25rem;
		justify-content: center;
		padding: 0 0.6rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 6px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 120ms cubic-bezier(0.2, 0.8, 0.2, 1),
			color 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.flint-github:hover {
		background: var(--flint-surface-hover);
		color: var(--sl-color-white);
	}
	.flint-github:focus-visible {
		outline: none;
		box-shadow: var(--flint-focus);
	}
	.flint-github :global(svg) {
		font-size: 1.125rem;
	}
	@media (max-width: 49.99rem) {
		.flint-github:not([data-label]) {
			padding: 0;
		}
		.flint-github:not([data-label]) .label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.flint-github {
			transition: none;
		}
	}
</style>
