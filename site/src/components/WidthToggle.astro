---
// A header button that switches docs pages between the wide view, the default (content
// and prose fill the space between the two sidebars, up to 90rem), and the normal view
// (Starlight's layout, content capped at 45rem). Choosing the normal view stores
// `flint-width` = 'normal', applied by an inline script before the content below the
// header paints; going back to wide removes it. Without JavaScript the page is wide. The button
// shows only on pages with a sidebar, from 50rem up, where the two views differ.
---

<flint-width-toggle>
	<button type="button" class="flint-width-toggle" aria-pressed="true" aria-label="Normal view" title="Normal view">
		<svg class="mode wide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M3 5v14M21 5v14M7 12h10M10 9l-3 3 3 3M14 9l3 3-3 3" />
		</svg>
		<svg class="mode normal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M3 5v14M21 5v14M3 12h6M21 12h-6M6 9l3 3-3 3M18 9l-3 3 3 3" />
		</svg>
	</button>
</flint-width-toggle>

{/* Inline, so the stored view applies before the page content paints. */}
<script is:inline>
	(() => {
		let normal = false;
		try {
			normal = localStorage.getItem('flint-width') === 'normal';
		} catch {}
		if (normal) document.documentElement.dataset.width = 'normal';
	})();
</script>

<script>
	const storageKey = 'flint-width';

	const isWide = (): boolean => document.documentElement.dataset.width !== 'normal';

	function apply(wide: boolean): void {
		if (wide) delete document.documentElement.dataset.width;
		else document.documentElement.dataset.width = 'normal';
		const label = wide ? 'Normal view' : 'Wide view';
		document.querySelectorAll('flint-width-toggle button').forEach((button) => {
			button.setAttribute('aria-pressed', String(wide));
			button.setAttribute('aria-label', label);
			button.setAttribute('title', label);
		});
	}

	class FlintWidthToggle extends HTMLElement {
		constructor() {
			super();
			apply(isWide());
			this.querySelector('button')?.addEventListener('click', () => {
				const next = !isWide();
				try {
					if (next) localStorage.removeItem(storageKey);
					else localStorage.setItem(storageKey, 'normal');
				} catch {}
				apply(next);
			});
		}
	}
	customElements.define('flint-width-toggle', FlintWidthToggle);
</script>

<style>
	flint-width-toggle {
		display: none;
	}
	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) flint-width-toggle {
			display: inline-flex;
		}
	}
	.flint-width-toggle {
		display: inline-grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 6px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition: background-color 120ms cubic-bezier(0.2, 0.8, 0.2, 1),
			color 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.flint-width-toggle:hover {
		background: var(--flint-surface-hover);
		color: var(--sl-color-white);
	}
	.flint-width-toggle:focus-visible {
		outline: none;
		box-shadow: var(--flint-focus);
	}
	.flint-width-toggle svg {
		grid-area: 1 / 1;
		width: 1.125rem;
		height: 1.125rem;
	}
	/* The icon shows what a click does: arrows out to widen, arrows in to narrow. */
	.flint-width-toggle .mode {
		display: none;
	}
	:global(:root[data-width='normal']) .flint-width-toggle .wide,
	:global(:root:not([data-width='normal'])) .flint-width-toggle .normal {
		display: block;
	}
	@media (prefers-reduced-motion: reduce) {
		.flint-width-toggle {
			transition: none;
		}
	}
</style>
