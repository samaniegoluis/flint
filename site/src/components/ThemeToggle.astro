---
// Replaces Starlight's ThemeSelect (D-023, D-087): one button that shows the theme on
// screen, a moon for dark and a sun for light, and switches to the other. Until it is
// first clicked the page follows the system's theme (and keeps following it); a click
// stores the choice. It keeps Starlight's storage contract, so ThemeProvider's inline
// script still applies the stored theme before first paint: the `starlight-theme` key
// holds 'dark', 'light', or '' (nothing chosen: the system's).
import { Icon } from '@astrojs/starlight/components';
---

<flint-theme-toggle>
	<button type="button" class="flint-theme-toggle" aria-label="Switch to light theme" title="Switch to light theme">
		<Icon name="moon" class="mode dark" />
		<Icon name="sun" class="mode light" />
	</button>
</flint-theme-toggle>

{/* Inline, so the right icon shows before the module script runs. */}
<script is:inline>
	(() => {
		let stored = '';
		try {
			stored = localStorage.getItem('starlight-theme') || '';
		} catch {}
		const shown =
			stored === 'dark' || stored === 'light'
				? stored
				: matchMedia('(prefers-color-scheme: light)').matches
					? 'light'
					: 'dark';
		document.querySelectorAll('flint-theme-toggle').forEach((el) => el.setAttribute('data-mode', shown));
	})();
</script>

<script>
	type Theme = 'dark' | 'light';
	const storageKey = 'starlight-theme';

	function stored(): Theme | null {
		try {
			const v = localStorage.getItem(storageKey);
			return v === 'dark' || v === 'light' ? v : null;
		} catch {
			return null;
		}
	}

	function store(theme: Theme): void {
		try {
			localStorage.setItem(storageKey, theme);
		} catch {}
	}

	const systemScheme = (): Theme =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	const shown = (): Theme => stored() ?? systemScheme();

	function apply(theme: Theme): void {
		document.documentElement.dataset.theme = theme;
		const label = `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`;
		document.querySelectorAll('flint-theme-toggle').forEach((el) => {
			el.setAttribute('data-mode', theme);
			const button = el.querySelector('button');
			button?.setAttribute('aria-label', label);
			button?.setAttribute('title', label);
		});
	}

	// Nothing chosen yet: the page keeps following the system.
	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (!stored()) apply(systemScheme());
	});

	class FlintThemeToggle extends HTMLElement {
		constructor() {
			super();
			apply(shown());
			this.querySelector('button')?.addEventListener('click', () => {
				const next: Theme = shown() === 'dark' ? 'light' : 'dark';
				store(next);
				apply(next);
			});
		}
	}
	customElements.define('flint-theme-toggle', FlintThemeToggle);
</script>

<style>
	flint-theme-toggle {
		display: inline-flex;
	}
	.flint-theme-toggle {
		display: inline-grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 6px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition: background-color 120ms cubic-bezier(0.2, 0.8, 0.2, 1),
			color 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.flint-theme-toggle:hover {
		background: var(--flint-surface-hover);
		color: var(--sl-color-white);
	}
	.flint-theme-toggle:focus-visible {
		outline: none;
		box-shadow: var(--flint-focus);
	}
	.flint-theme-toggle :global(svg) {
		grid-area: 1 / 1;
		font-size: 1.125rem;
	}
	.flint-theme-toggle :global(.mode) {
		display: none;
	}
	/* Before any script runs (none at all without JavaScript): the dark default. */
	flint-theme-toggle:not([data-mode]) :global(.dark),
	flint-theme-toggle[data-mode='dark'] :global(.dark),
	flint-theme-toggle[data-mode='light'] :global(.light) {
		display: block;
	}
	@media (prefers-reduced-motion: reduce) {
		.flint-theme-toggle {
			transition: none;
		}
	}
</style>
