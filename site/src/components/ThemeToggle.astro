---
// Replaces Starlight's ThemeSelect (D-023): one button that cycles auto → dark → light.
// It keeps Starlight's storage contract, so ThemeProvider's inline script still applies
// the stored theme before first paint: the `starlight-theme` key holds 'dark', 'light',
// or '' for auto.
import { Icon } from '@astrojs/starlight/components';
---

<flint-theme-toggle>
	<button type="button" class="flint-theme-toggle" aria-label="Theme: auto. Switch to dark">
		<Icon name="laptop" class="mode auto" />
		<Icon name="moon" class="mode dark" />
		<Icon name="sun" class="mode light" />
	</button>
</flint-theme-toggle>

{/* Inline, so the right icon shows before the module script runs. */}
<script is:inline>
	(() => {
		let stored = '';
		try {
			stored = localStorage.getItem('starlight-theme') || '';
		} catch {}
		const mode = stored === 'dark' || stored === 'light' ? stored : 'auto';
		document.querySelectorAll('flint-theme-toggle').forEach((el) => el.setAttribute('data-mode', mode));
	})();
</script>

<script>
	type Mode = 'auto' | 'dark' | 'light';
	const storageKey = 'starlight-theme';
	const order: Mode[] = ['auto', 'dark', 'light'];
	const names: Record<Mode, string> = { auto: 'auto', dark: 'dark', light: 'light' };

	const parse = (v: unknown): Mode => (v === 'dark' || v === 'light' ? v : 'auto');

	function load(): Mode {
		try {
			return parse(localStorage.getItem(storageKey));
		} catch {
			return 'auto';
		}
	}

	function store(mode: Mode): void {
		try {
			localStorage.setItem(storageKey, mode === 'auto' ? '' : mode);
		} catch {}
	}

	const systemScheme = (): 'dark' | 'light' =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	function apply(mode: Mode): void {
		document.documentElement.dataset.theme = mode === 'auto' ? systemScheme() : mode;
		const next = order[(order.indexOf(mode) + 1) % order.length];
		document.querySelectorAll('flint-theme-toggle').forEach((el) => {
			el.setAttribute('data-mode', mode);
			el.querySelector('button')?.setAttribute(
				'aria-label',
				`Theme: ${names[mode]}. Switch to ${names[next]}`
			);
		});
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (load() === 'auto') apply('auto');
	});

	class FlintThemeToggle extends HTMLElement {
		constructor() {
			super();
			apply(load());
			this.querySelector('button')?.addEventListener('click', () => {
				const mode = order[(order.indexOf(load()) + 1) % order.length];
				store(mode);
				apply(mode);
			});
		}
	}
	customElements.define('flint-theme-toggle', FlintThemeToggle);
</script>

<style>
	flint-theme-toggle {
		display: inline-flex;
	}
	.flint-theme-toggle {
		display: inline-grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 6px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition: background-color 120ms cubic-bezier(0.2, 0.8, 0.2, 1),
			color 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.flint-theme-toggle:hover {
		background: var(--flint-surface-hover);
		color: var(--sl-color-white);
	}
	.flint-theme-toggle:focus-visible {
		outline: none;
		box-shadow: var(--flint-focus);
	}
	.flint-theme-toggle :global(svg) {
		grid-area: 1 / 1;
		font-size: 1.125rem;
	}
	.flint-theme-toggle :global(.mode) {
		display: none;
	}
	flint-theme-toggle:not([data-mode]) :global(.auto),
	flint-theme-toggle[data-mode='auto'] :global(.auto),
	flint-theme-toggle[data-mode='dark'] :global(.dark),
	flint-theme-toggle[data-mode='light'] :global(.light) {
		display: block;
	}
	@media (prefers-reduced-motion: reduce) {
		.flint-theme-toggle {
			transition: none;
		}
	}
</style>
