package main

// CF-217: a test file that does not parse (`struct Point {` is not cfire) is skipped by
// suite discovery: `cfire test .` prints "No test suites found" and exits 0. Fixed when
// the parse error is reported (its location below) and the run fails.
struct Point {
    x: i64
}

test "f" {
    assert_eq(i64(1), i64(1))
}
