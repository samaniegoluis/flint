package main

// CF-141: `make(http.Server, port, host:)` binds the address given; `Router.put` is
// documented and works. (The stdlib docs are checked by reading them.)

import "core:net"
import "core:net/http"

fn raw(port: u16, text: str) -> str {
    mut c := net.connect("127.0.0.1", port) or err {
        return "connect failed"
    }
    c.set_timeout_ms(3000)
    _ = c.write_text(text) or err {
        return "write failed"
    }
    mut got := ""
    for {
        chunk := c.read_text(65536) or err {
            break
        }
        if chunk.len() == 0 {
            break
        }
        got += chunk
    }
    return got
}

test "a server bound to 127.0.0.1 serves a PUT route" {
    mut srv := try make(http.Server, 0, host: "127.0.0.1")
    srv.set_limits(http.ServerLimits{ keepalive_timeout_ms: 0 })
    mut r := make(http.Router)
    r.put("/u", |req: http.Request| -> http.Response {
        return http.Response.text(200, "put {req.body}")
    })
    srv.serve_in_background(r)
    got := raw(srv.port(), "PUT /u HTTP/1.1\r\nHost: x\r\nContent-Length: 2\r\n\r\nok")
    assert(got.contains("put ok"))
    srv.stop()
}

test "an address that is no IP literal is refused" {
    mut refused := false
    _ = make(http.Server, 0, host: "not-an-address") or err {
        refused = true
        return
    }
    assert(refused)
}
