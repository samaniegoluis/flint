diff --git a/src/buildsys.hpp b/src/buildsys.hpp
index 9be19ad..f020f8b 100644
--- a/src/buildsys.hpp
+++ b/src/buildsys.hpp
@@ -740,6 +740,63 @@ namespace cfire::build {
     return "clang++";
 }
 
+// The resource compiler for a Windows target: $CFIRE_WINDRES, then `<triple>-windres` next
+// to $CFIRE_CXX (llvm-mingw keeps them side by side), then `<triple>-windres`,
+// `llvm-windres` and `windres` on PATH. "" when none runs.
+[[nodiscard]] inline auto resolve_windres(const std::string& target_triple) -> std::string {
+    if (const char* env = std::getenv("CFIRE_WINDRES"); env && *env) return env;
+    std::string triple = target_triple.empty() ? "x86_64-w64-mingw32" : target_triple;
+    std::vector<std::string> candidates;
+    if (const char* cxx = std::getenv("CFIRE_CXX"); cxx && *cxx) {
+        auto dir = std::filesystem::path(cxx).parent_path();
+        if (!dir.empty()) candidates.push_back((dir / (triple + "-windres")).string());
+    }
+    candidates.push_back(triple + "-windres");
+    candidates.push_back("llvm-windres");
+    candidates.push_back("windres");
+    for (const auto& c : candidates) {
+        int rc = 0;
+        (void)bridge::run_command_capture(std::format("\"{}\" --version 2>&1", c), rc);
+        if (rc == 0) return c;
+    }
+    return "";
+}
+
+// A Windows `.exe` shows the icon in its resources (Explorer, the taskbar, Alt+Tab). The
+// build file's Icon names one file for every platform, so for Windows the `.ico` beside it
+// (same name) is compiled as icon resource 1, which the webui window class loads.
+// Returns the object to link, or "" (no `.ico`, or no resource compiler: a warning).
+[[nodiscard]] inline auto compile_windows_icon(const std::filesystem::path& icon, const std::filesystem::path& out_bin,
+                                               const std::string& target_triple) -> std::string {
+    std::error_code ec;
+    auto ico = icon;
+    ico.replace_extension(".ico");
+    if (!std::filesystem::exists(ico, ec)) return "";
+    std::string windres = resolve_windres(target_triple);
+    if (windres.empty()) {
+        std::fprintf(stderr, "cfire: %s is not embedded: no resource compiler (set CFIRE_WINDRES)\n", ico.string().c_str());
+        return "";
+    }
+    auto dir = std::filesystem::temp_directory_path() / "cfire_win_res";
+    std::filesystem::create_directories(dir, ec);
+    auto stem = out_bin.stem().string();
+    auto rc = dir / (stem + ".rc");
+    auto obj = dir / (stem + ".res.o");
+    {
+        std::ofstream out(rc, std::ios::binary | std::ios::trunc);
+        std::string path = std::filesystem::absolute(ico, ec).generic_string();
+        out << "1 ICON \"" << path << "\"\n";
+    }
+    int code = 0;
+    std::string out = bridge::run_command_capture(
+        std::format("\"{}\" -i \"{}\" -o \"{}\" 2>&1", windres, rc.string(), obj.string()), code);
+    if (code != 0) {
+        std::fprintf(stderr, "cfire: %s is not embedded: %s\n", ico.string().c_str(), out.c_str());
+        return "";
+    }
+    return obj.string();
+}
+
 [[nodiscard]] inline auto prelude_pch_path(
     const std::filesystem::path& runtime_dir,
     bool sanitize
@@ -963,6 +1020,10 @@ namespace cfire::build {
 #endif
             if (is_windows) {
                 plan.ldflags.push_back("-mwindows");
