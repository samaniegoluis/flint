+                    if (!res_obj.empty()) plan.ldflags.push_back(std::format("\"{}\"", res_obj));
+                }
             } else {
 #if defined(__APPLE__)
                 if ((target_triple.empty() || target_triple.find("apple") != std::string::npos) && !test_mode) {
