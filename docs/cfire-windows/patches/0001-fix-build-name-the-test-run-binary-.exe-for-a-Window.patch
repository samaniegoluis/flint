From 67604663a8a7a06df530314bb3d5bb1c11bb0e58 Mon Sep 17 00:00:00 2001
From: Luis Samaniego <luis.samaniego86@gmail.com>
Date: Mon, 9 Nov 2026 09:15:30 -0600
Subject: [PATCH 1/8] fix(build): name the test/run binary .exe for a Windows
 target, not by host

cfire test and cfire run build into a temp path and then exec it. The .exe suffix
was chosen with #if defined(_WIN32), i.e. by the host. Cross-compiling for
x86_64-w64-mingw32 from Linux, the mingw linker appends .exe anyway, so cfire
then runs a path that does not exist (sh: not found, exit 127).

Add build::is_windows_target(triple) and use it for both temp names.
---
 src/build/package_loader.hpp | 14 ++++++++++++++
 src/main.cpp                 | 16 ++++++----------
 2 files changed, 20 insertions(+), 10 deletions(-)

diff --git a/src/build/package_loader.hpp b/src/build/package_loader.hpp
index 377dd43..1865c5f 100644
--- a/src/build/package_loader.hpp
+++ b/src/build/package_loader.hpp
@@ -479,6 +479,20 @@ namespace cfire::build {
            target.find("-apple-ios") != std::string_view::npos;
 }
 
+// True when the binary being built runs on Windows: an explicit Windows/mingw triple, or no
+// triple on a Windows host. Decides host-independent things such as the `.exe` suffix.
+[[nodiscard]] inline auto is_windows_target(std::string_view target) noexcept -> bool {
+    if (target.find("windows") != std::string_view::npos || target.find("win32") != std::string_view::npos ||
+        target.find("mingw") != std::string_view::npos) {
+        return true;
+    }
+#if defined(_WIN32)
+    return target.empty();
+#else
+    return false;
+#endif
+}
+
 [[nodiscard]] inline auto is_ios_simulator_target(std::string_view target) noexcept -> bool {
     return target == "ios-sim" || target == "ios-simulator" ||
            (target.find("-apple-ios") != std::string_view::npos && target.find("simulator") != std::string_view::npos);
diff --git a/src/main.cpp b/src/main.cpp
index c7daefa..cf4be81 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -868,11 +868,9 @@ auto main(int argc, char** argv) -> int {
                     if (!json_mode && suite_entries.size() > 1) {
                         std::println("==> Suite {}/{}: {}", idx + 1, suite_entries.size(), suite_file.string());
                     }
-#if defined(_WIN32)
-                    auto tmp_bin = std::filesystem::temp_directory_path() / std::format("cfire-test-{}-{}.exe", ::getpid(), idx);
-#else
-                    auto tmp_bin = std::filesystem::temp_directory_path() / std::format("cfire-test-{}-{}", ::getpid(), idx);
-#endif
+                    // The linker appends `.exe` for a Windows target whatever the host is, so name it that way.
+                    auto tmp_bin = std::filesystem::temp_directory_path() / std::format("cfire-test-{}-{}{}", ::getpid(), idx,
+                        cfire::build::is_windows_target(target_triple) ? ".exe" : "");
                     auto plan = cfire::build::build_native(suite_file, runtime_dir, tmp_bin, true, sanitize, target_triple, sysroot, extra_link_libs, extra_includes, web_profile, subsystem);
                     if (!plan) {
                         ++suite_failures;
@@ -1160,11 +1158,9 @@ auto main(int argc, char** argv) -> int {
             return *sim_res;
         }
 
-#if defined(_WIN32)
-        auto tmp_bin = std::filesystem::temp_directory_path() / std::format("cfire-{}-{}.exe", sub, ::getpid());
-#else
-        auto tmp_bin = std::filesystem::temp_directory_path() / std::format("cfire-{}-{}", sub, ::getpid());
-#endif
+        // The linker appends `.exe` for a Windows target whatever the host is, so name it that way.
+        auto tmp_bin = std::filesystem::temp_directory_path() / std::format("cfire-{}-{}{}", sub, ::getpid(),
+            cfire::build::is_windows_target(target_triple) ? ".exe" : "");
         auto plan = cfire::build::build_native(target, runtime_dir, tmp_bin, is_test, sanitize, target_triple, sysroot, extra_link_libs, extra_includes, web_profile, subsystem);
         if (!plan) {
             std::println(stderr, "{}", plan.error());
